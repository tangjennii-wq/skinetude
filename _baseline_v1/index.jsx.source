

const { useState, useEffect, useRef } = React;

// === ICON HELPER (uses lucide) ===
// Renders lucide icons declaratively from their descriptor tree instead of via
// imperative DOM mutation. Old approach used useEffect + ref to inject the SVG
// AFTER mount — that was racy on mobile (sometimes the effect didn't fire on
// the bottom nav, leaving labels with no icons). The descriptor format is
// ["svg", attrs, children[]] where children is also descriptor tuples — we
// just walk the tree with React.createElement.
const renderLucideNode = (node, key) => {
  if (!Array.isArray(node)) return null;
  const [tag, attrs, children] = node;
  // Lucide attrs use kebab-case (stroke-width, stroke-linecap). Convert to
  // React's camelCase props for the SVG attributes that need it.
  const reactAttrs = { key };
  for (const k in attrs) {
    if (k === 'stroke-width') reactAttrs.strokeWidth = attrs[k];
    else if (k === 'stroke-linecap') reactAttrs.strokeLinecap = attrs[k];
    else if (k === 'stroke-linejoin') reactAttrs.strokeLinejoin = attrs[k];
    else if (k === 'fill-rule') reactAttrs.fillRule = attrs[k];
    else if (k === 'clip-rule') reactAttrs.clipRule = attrs[k];
    else reactAttrs[k] = attrs[k];
  }
  const kids = Array.isArray(children) ? children.map((c, i) => renderLucideNode(c, i)) : null;
  return React.createElement(tag, reactAttrs, kids);
};
const Icon = ({ name, size = 16, className = '', style = {}, ...props }) => {
  const desc = (window.lucide && (window.lucide.icons[name] || window.lucide.icons.Circle)) || null;
  if (!desc) return <span className={`inline-flex ${className}`} style={{ width: size, height: size, ...style }} {...props} />;
  // Override the default 24x24 with the requested size.
  const [tag, attrs, children] = desc;
  const sized = [tag, { ...attrs, width: size, height: size }, children];
  return (
    <span className={`inline-flex ${className}`} style={{ width: size, height: size, ...style }} {...props}>
      {renderLucideNode(sized, 'icon')}
    </span>
  );
};

// === STABLE COMPONENTS (defined OUTSIDE App so they don't re-mount on every keystroke) ===
const inputCls = "w-full px-3 py-2.5 border rounded-md text-sm focus:outline-none transition font-light";
const primaryBtn = "w-full py-3 tracking-widest text-xs uppercase transition";

const Field = ({ label, children }) => (
  <div>
    <label className="block text-[10px] uppercase tracking-[0.15em] mb-2 font-medium" style={{color:'var(--ink-soft)'}}>{label}</label>
    {children}
  </div>
);

// Renders an image from either a Supabase Storage path (preferred) or a legacy base64
// data URL (during migration). Resolves signed URLs lazily and caches them. Falls back
// to the renderFallback function when there's no source.
const Photo = ({ item, src: srcProp, className = '', style, alt = '', onClick, renderFallback }) => {
  let path = null;
  let legacyDataUrl = null;
  if (typeof srcProp === 'string') {
    if (srcProp.startsWith('data:')) legacyDataUrl = srcProp;
    else path = srcProp;
  } else if (item) {
    const r = _resolvePhotoSource(item);
    path = r.path;
    legacyDataUrl = r.legacyDataUrl;
  }
  const [signedUrl, setSignedUrl] = useState(null);
  useEffect(() => {
    let cancelled = false;
    setSignedUrl(null);
    if (path) {
      getSignedPhotoUrl(path).then(url => { if (!cancelled) setSignedUrl(url); });
    }
    return () => { cancelled = true; };
  }, [path]);
  const displaySrc = legacyDataUrl || signedUrl;
  if (!displaySrc) return renderFallback ? renderFallback() : null;
  return <img src={displaySrc} alt={alt} className={className} style={style} onClick={onClick} />;
};

// Renders two photo entries as the left and right halves of a single image — a magazine-
// style before/after split. Photos are signed-URL fetched via the existing Photo wrapper;
// clip-path divides the frame at the midline. A small button between them swaps which side
// shows which entry.
// Full side-by-side compare — two photos in one row, no clip-path. Replaces the older half-face split.
const SplitHalfCompare = ({ before, after, onSwap, onClear }) => {
  if (!before || !after) return null;
  const fmt = (d) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  return (
    <div className="w-full">
      <div className="grid grid-cols-2 gap-2 md:gap-3">
        {/* BEFORE */}
        <div className="relative aspect-[3/4] overflow-hidden" style={{background:'var(--cream-deep)'}}>
          <Photo item={before} alt="" className="w-full h-full object-cover"
            renderFallback={() => <div className="w-full h-full flex items-center justify-center" style={{background:'var(--cream-deep)'}}><span className="font-serif italic text-5xl md:text-7xl" style={{color:'var(--ink-soft)'}}>{before.rating}</span></div>}
          />
          <div className="absolute top-2 left-2 text-[9px] tracking-[0.15em] uppercase px-2 py-0.5 rounded-sm font-medium" style={{background:'rgba(245,240,232,0.92)', color:'var(--ink)'}}>Before · {fmt(before.date)}</div>
          <div className="absolute bottom-2 left-2 font-serif italic text-base md:text-lg leading-none px-2 py-0.5 rounded-sm" style={{background:'rgba(245,240,232,0.92)', color:'var(--accent)'}}>{before.rating}<span className="text-[10px]" style={{color:'var(--ink-soft)'}}>/10</span></div>
        </div>
        {/* AFTER */}
        <div className="relative aspect-[3/4] overflow-hidden" style={{background:'var(--cream-deep)'}}>
          <Photo item={after} alt="" className="w-full h-full object-cover"
            renderFallback={() => <div className="w-full h-full flex items-center justify-center" style={{background:'var(--cream-deep)'}}><span className="font-serif italic text-5xl md:text-7xl" style={{color:'var(--ink-soft)'}}>{after.rating}</span></div>}
          />
          <div className="absolute top-2 left-2 text-[9px] tracking-[0.15em] uppercase px-2 py-0.5 rounded-sm font-medium" style={{background:'var(--ink)', color:'var(--cream)'}}>After · {fmt(after.date)}</div>
          <div className="absolute bottom-2 left-2 font-serif italic text-base md:text-lg leading-none px-2 py-0.5 rounded-sm" style={{background:'rgba(245,240,232,0.92)', color:'var(--accent)'}}>{after.rating}<span className="text-[10px]" style={{color:'var(--ink-soft)'}}>/10</span></div>
        </div>
      </div>
      {/* Swap + clear chrome below */}
      {(onSwap || onClear) && (
        <div className="flex items-center justify-end gap-3 mt-2">
          {onSwap && (
            <button onClick={onSwap} className="text-[10px] tracking-[0.15em] uppercase italic flex items-center gap-1" style={{color:'var(--ink)'}} title="Swap sides">
              <Icon name="ArrowLeftRight" size={11} /> Swap
            </button>
          )}
          {onClear && (
            <button onClick={onClear} className="text-[10px] tracking-[0.15em] uppercase italic flex items-center gap-1" style={{color:'var(--ink-soft)'}}>
              <Icon name="X" size={11} /> Clear
            </button>
          )}
        </div>
      )}
    </div>
  );
};

// === EDITORIAL PRIMITIVES ===
// Small set of reusable building blocks that encode the cover's editorial language
// (eyebrow → serif italic display → ink-soft body, terracotta accent links, cream-deep
// rounded-[20px] section cards). Used across Journal, Compare, Pearls, Counsel, and the
// modal layer so the design stays cohesive without copy-pasting Tailwind class strings.
//
// Why a small set: each primitive captures ONE pattern (typography label / page header /
// section card / italic action link). Composing them keeps page code readable.

// Tracked uppercase eyebrow label — used above titles, as section labels inside cards,
// and as group dividers in lists. Default ink-soft so it whispers, not shouts.
const Eyebrow = ({ children, className = '', style = {}, tone = 'soft', size = 'sm' }) => {
  const color = tone === 'accent' ? 'var(--accent)' : tone === 'ink' ? 'var(--ink)' : 'var(--ink-soft)';
  const sizing = size === 'lg' ? 'text-[11px] tracking-[0.32em]' : 'text-[10px] tracking-[0.3em]';
  return (
    <div className={`${sizing} uppercase ${className}`} style={{color, ...style}}>{children}</div>
  );
};

// Page-level editorial header — eyebrow on top, serif-italic display title, optional
// ink-soft body line, optional terracotta italic action link on the right (no heavy
// black pill — the cover language is a quiet italic CTA). Replaces SectionHeader for
// pages we want to feel editorial; SectionHeader stays available for deeper utility tabs.
const EditorialPageHeader = ({ eyebrow, title, body, action, actionLabel, actionIcon = 'ArrowRight' }) => (
  <header className="mb-6">
    {eyebrow && <Eyebrow size="lg" className="mb-1.5">{eyebrow}</Eyebrow>}
    <div className="flex items-end justify-between gap-3 flex-wrap">
      <h1 className="font-serif italic text-[28px] md:text-[36px] leading-[1.05] tracking-tight" style={{color:'var(--ink)'}}>
        {title}
      </h1>
      {action && actionLabel && (
        <button
          onClick={action}
          className="text-[10.5px] tracking-[0.18em] uppercase italic flex items-center gap-1 transition hover:opacity-70 pb-1.5"
          style={{color:'var(--accent)'}}
        >
          {actionLabel} <Icon name={actionIcon} size={11} />
        </button>
      )}
    </div>
    {body && (
      <p className="text-[12px] leading-relaxed mt-1.5" style={{color:'var(--ink-soft)'}}>{body}</p>
    )}
  </header>
);

// Editorial section card — rounded-[20px] cream-deep panel with line border. Optional
// eyebrow + title strip at the top so card-internal headings stay consistent. Pass
// `pad="tight"` for denser content (modals, compact lists) or `pad="none"` to take
// over padding entirely (e.g., a card whose body is its own custom layout).
const EditorialCard = ({ children, eyebrow, title, action, actionLabel, actionIcon = 'ArrowRight', pad = 'normal', className = '', style = {} }) => {
  const padCls = pad === 'tight' ? 'px-4 py-4 md:px-5 md:py-5' : pad === 'none' ? '' : 'px-5 py-5 md:px-6 md:py-6';
  return (
    <section
      className={`rounded-[20px] relative ${padCls} ${className}`}
      style={{background:'var(--cream-deep)', border:'1px solid var(--line)', ...style}}
    >
      {(eyebrow || title || actionLabel) && (
        <div className="flex items-center justify-between gap-3 mb-3">
          <div className="min-w-0">
            {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
            {title && (
              <h2 className="font-serif italic text-[20px] md:text-[24px] leading-[1.15] mt-0.5" style={{color:'var(--ink)'}}>
                {title}
              </h2>
            )}
          </div>
          {action && actionLabel && (
            <button
              onClick={action}
              className="text-[10px] tracking-[0.18em] uppercase italic flex items-center gap-1 transition hover:opacity-70 flex-shrink-0"
              style={{color:'var(--accent)'}}
            >
              {actionLabel} <Icon name={actionIcon} size={11} />
            </button>
          )}
        </div>
      )}
      {children}
    </section>
  );
};

// Italic uppercase action link — the terracotta editorial CTA pattern. Use everywhere
// an action wants to whisper rather than shout. For loud CTAs (primary submit, "Log
// ritual") keep using the cover's pill button pattern directly.
const AccentLink = ({ children, onClick, icon, iconAfter = 'ArrowRight', tone = 'accent', size = 'sm', className = '', ...rest }) => {
  const color = tone === 'soft' ? 'var(--ink-soft)' : tone === 'ink' ? 'var(--ink)' : 'var(--accent)';
  const sizing = size === 'lg' ? 'text-[11px] tracking-[0.2em]' : 'text-[10.5px] tracking-[0.18em]';
  return (
    <button
      onClick={onClick}
      className={`${sizing} uppercase italic flex items-center gap-1 transition hover:opacity-70 ${className}`}
      style={{color}}
      {...rest}
    >
      {icon && <Icon name={icon} size={11} />}
      {children}
      {iconAfter && <Icon name={iconAfter} size={11} />}
    </button>
  );
};

// Editorial pill button — the loud-CTA cousin of AccentLink. Two tones: 'accent'
// (terracotta on cream — primary), 'ghost' (cream + line border — subdued). Used for
// "Log ritual", "Same as yesterday", modal Save buttons, etc.
const EditorialPill = ({ children, onClick, icon, tone = 'accent', disabled = false, className = '', ...rest }) => {
  const styles = tone === 'ghost'
    ? {background:'var(--cream)', color:'var(--ink)', border:'1px solid var(--line)'}
    : tone === 'ink'
      ? {background:'var(--ink)', color:'var(--cream)'}
      : {background:'var(--accent)', color:'var(--cream)'};
  return (
    <button
      onClick={onClick}
      disabled={disabled}
      className={`rounded-full px-4 py-2 text-[10.5px] tracking-[0.18em] uppercase flex items-center gap-1.5 transition hover:opacity-90 disabled:opacity-50 ${className}`}
      style={styles}
      {...rest}
    >
      {icon && <Icon name={icon} size={11} />}
      {children}
    </button>
  );
};

// Editorial sub-tab toggle — replaces the bordered rectangle/Underline-style tab rows
// scattered around the app. Cream-deep track with rounded pill highlights. Pass `tabs`
// as [{id, label, icon?}] and the controlled value/onChange.
// EditorialSubTabs — pill-row sub-nav.
// Sizing rules tuned so the full label ALWAYS shows in one row on mobile,
// even at 4+ tabs (the most cramped case: e.g. Today/Shelf/Build/Occasions
// or Skin Reads/Timeline/Procedures/Select). To accomplish this:
//   - tracking, padding, font, and gap all step down when tabs.length >= 4
//   - icons hide on mobile when the row is crowded (>=4 tabs)
//   - whitespace-nowrap + no `truncate` so we never ellipsis a word
const EditorialSubTabs = ({ tabs, value, onChange, className = '' }) => {
  const crowded = tabs.length >= 4;
  // Two density tiers — generous (≤3 tabs) vs. compact (≥4 tabs).
  const fontCls = crowded ? 'text-[9.5px]' : 'text-[10.5px]';
  const trackCls = crowded ? 'tracking-[0.12em]' : 'tracking-[0.18em]';
  const padCls = crowded ? 'py-2 px-1.5' : 'py-2 px-3';
  const gapCls = crowded ? 'gap-1' : 'gap-1.5';
  return (
    <div className={`rounded-full flex p-1 gap-1 ${className}`} style={{background:'var(--cream-deep)', border:'1px solid var(--line)'}}>
      {tabs.map(t => {
        const active = value === t.id;
        return (
          <button
            key={t.id}
            type="button"
            onClick={() => onChange(t.id)}
            className={`flex-1 rounded-full ${padCls} flex items-center justify-center ${gapCls} transition min-w-0`}
            style={{
              background: active ? 'var(--cream)' : 'transparent',
              color: active ? 'var(--ink)' : 'var(--ink-soft)',
              boxShadow: active ? '0 1px 3px rgba(0,0,0,0.05)' : 'none',
            }}
          >
            {t.icon && (
              // Icon hides on mobile when crowded so the label keeps its room.
              <Icon
                name={t.icon}
                size={12}
                className={crowded ? 'hidden md:inline-block' : ''}
                style={{color: active ? 'var(--accent)' : 'var(--ink-soft)'}}
              />
            )}
            <span className={`${fontCls} ${trackCls} uppercase whitespace-nowrap`}>{t.label}</span>
          </button>
        );
      })}
    </div>
  );
};

// =====================================================================
// CompareMetricInfographic — shared metric quartet (redness, hydration,
// texture, breakouts) showing before→after deltas as arrows + % change,
// mirroring the Cover page's Skin Snapshot card. Used everywhere on the
// Compare tab so each tab's analysis surfaces the same visual language.
//
// Props:
//   before, after — log entries with optional `metricSnapshot` { redness,
//                   hydration, texture, breakouts } level words.
//   ratingDelta   — if provided, also shows a Rating tile on the left.
//
// Renders as a 4-tile grid (or 5-tile if ratingDelta present), each tile
// showing the LATER level word + arrow + % change. Falls back gracefully
// when one or both snapshots are missing.
// =====================================================================
const COMPARE_SCORE_MAP = {
  redness:    { Clear: 100, Low: 80, Mild: 55, Moderate: 30, High: 10 },
  hydration:  { Plump: 100, Good: 80, Balanced: 55, Dry: 30, Parched: 10 },
  texture:    { Smooth: 100, Even: 80, Uneven: 55, Rough: 30, Bumpy: 10 },
  breakouts:  { Clear: 100, Few: 75, Some: 50, Many: 25, Severe: 10 },
  // AI now scores these directly (was previously math-derived from redness × texture).
  barrier:    { Strong: 100, Steady: 80, Holding: 55, Compromised: 30, Stripped: 10 },
  sensitivity:{ Calm: 100, Settled: 80, Tender: 55, Reactive: 30, Inflamed: 10 },
};
const COMPARE_METRIC_KIND = { redness: 'neg', hydration: 'pos', texture: 'pos', breakouts: 'neg', barrier: 'pos', sensitivity: 'pos' };
const compareTitleCase = (w) => w ? w.charAt(0).toUpperCase() + w.slice(1).toLowerCase() : null;
const compareNormalizeWord = (key, raw) => {
  if (!raw) return null;
  const tc = compareTitleCase(String(raw).trim());
  return COMPARE_SCORE_MAP[key] && tc in COMPARE_SCORE_MAP[key] ? tc : null;
};
const CompareMetricInfographic = ({ before, after, ratingDelta = null, daysApart = null }) => {
  const beforeSnap = before?.metricSnapshot || null;
  const afterSnap = after?.metricSnapshot || null;
  const metricFor = (key) => {
    const word = compareNormalizeWord(key, afterSnap?.[key]);
    if (!word) return { label: key, level: null, dir: null, pct: null, color: 'var(--ink-soft)' };
    const priorWord = compareNormalizeWord(key, beforeSnap?.[key]);
    const score = COMPARE_SCORE_MAP[key][word];
    const priorScore = priorWord ? COMPARE_SCORE_MAP[key][priorWord] : null;
    const kind = COMPARE_METRIC_KIND[key];
    let pct = null, dir = null, color = 'var(--ink-soft)';
    if (priorScore != null && priorScore !== score) {
      const rawDelta = ((score - priorScore) / priorScore) * 100;
      pct = Math.min(99, Math.round(Math.abs(rawDelta)));
      const improving = score > priorScore;
      if (improving) {
        dir = kind === 'pos' ? 'up' : 'down';
        color = 'var(--sage)';
      } else {
        dir = kind === 'pos' ? 'down' : 'up';
        color = 'var(--rose)';
      }
    }
    return { level: word, dir, pct, color };
  };
  const metricSpec = [
    { key: 'redness',   label: 'Redness',   ...metricFor('redness') },
    { key: 'hydration', label: 'Hydration', ...metricFor('hydration') },
    { key: 'texture',   label: 'Texture',   ...metricFor('texture') },
    { key: 'breakouts', label: 'Breakouts', ...metricFor('breakouts') },
  ];
  // If neither snapshot exists, render a quiet placeholder so the layout still feels intentional.
  const hasAny = metricSpec.some(m => m.level);
  return (
    <div className="rounded-[16px] px-4 py-4 md:px-5 md:py-5" style={{background:'var(--cream-deep)', border:'1px solid var(--line)'}}>
      <div className="flex items-baseline justify-between mb-3 gap-3 flex-wrap">
        <div className="text-[10px] tracking-[0.3em] uppercase" style={{color:'var(--ink-soft)'}}>Skin shift</div>
        {(daysApart != null || ratingDelta != null) && (
          <div className="text-[10px] tracking-[0.18em] uppercase italic flex items-center gap-3" style={{color:'var(--ink-soft)'}}>
            {daysApart != null && <span>{daysApart} {daysApart === 1 ? 'day' : 'days'} apart</span>}
            {ratingDelta != null && (
              <span style={{color: ratingDelta > 0 ? 'var(--sage)' : ratingDelta < 0 ? 'var(--rose)' : 'var(--ink-soft)'}}>
                Rating {ratingDelta > 0 ? '+' : ''}{ratingDelta}
              </span>
            )}
          </div>
        )}
      </div>
      {hasAny ? (
        <div className="grid grid-cols-4 gap-2 md:gap-3">
          {metricSpec.map(m => (
            <div key={m.key} className="text-center">
              <div className="text-[9px] tracking-[0.2em] uppercase mb-1" style={{color:'var(--ink-soft)'}}>{m.label}</div>
              <div className="font-serif italic text-[18px] md:text-[20px] leading-tight" style={{color: m.level ? 'var(--ink)' : 'var(--ink-soft)'}}>
                {m.level || '—'}
              </div>
              <div className="text-[10px] tracking-[0.05em] mt-0.5 flex items-center justify-center gap-0.5" style={{color: m.color}}>
                {m.dir && <span>{m.dir === 'up' ? '↑' : '↓'}</span>}
                <span>{m.pct != null ? `${m.pct}%` : (m.level ? '—' : '·')}</span>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p className="text-[11px] italic text-center py-2" style={{color:'var(--ink-soft)'}}>
          No metric snapshots on these photos yet — Skin Reads will fill in once both photos have analyses.
        </p>
      )}
    </div>
  );
};

// Editorial Modal frame — replaces the old Modal. Same API (children/onClose/title/
// compact) plus optional `eyebrow` and `action`/`actionLabel` for a primary CTA in the
// sticky header. Body sits on cream; sticky header is cream too with a hairline rule
// for visual continuity. Title gets the cover's serif italic display treatment.
const Modal = ({ children, onClose, title, eyebrow, action, actionLabel, compact = false }) => (
  <div className="fixed inset-0 z-50 flex items-center justify-center p-3 md:p-4" style={{background:'rgba(28,25,23,0.5)', backdropFilter:'blur(4px)'}} onClick={onClose}>
    <div onClick={e => e.stopPropagation()} className="rounded-[20px] max-w-xl w-full max-h-[92vh] overflow-y-auto shadow-2xl" style={{background:'var(--cream)'}}>
      <div className={`sticky top-0 border-b ${compact ? 'px-4 py-2.5' : 'px-6 py-4'} flex items-center justify-between gap-3 z-10`} style={{background:'var(--cream)', borderColor:'var(--line)'}}>
        <div className="min-w-0">
          {eyebrow && <Eyebrow className="mb-0.5 truncate">{eyebrow}</Eyebrow>}
          <h2 className={`${compact ? 'text-[18px] md:text-[19px]' : 'text-[22px] md:text-[24px]'} font-serif italic leading-[1.1] tracking-tight truncate`} style={{color:'var(--ink)'}}>{title}</h2>
        </div>
        <div className="flex items-center gap-3 flex-shrink-0">
          {action && actionLabel && (
            <button
              onClick={action}
              className="text-[10.5px] tracking-[0.18em] uppercase italic flex items-center gap-1 transition hover:opacity-70"
              style={{color:'var(--accent)'}}
            >
              {actionLabel} <Icon name="Check" size={11} />
            </button>
          )}
          <button onClick={onClose} style={{color:'var(--ink-soft)'}} aria-label="Close">
            <span style={{display:'inline-block', width: compact ? 16 : 20, height: compact ? 16 : 20}} dangerouslySetInnerHTML={{__html: `<svg xmlns="http://www.w3.org/2000/svg" width="${compact ? 16 : 20}" height="${compact ? 16 : 20}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`}} />
          </button>
        </div>
      </div>
      <div className={compact ? 'px-4 py-3' : 'p-6'}>{children}</div>
    </div>
  </div>
);

// === LOCAL DATE HELPER (module scope) ===
// .toISOString().split('T')[0] returns the UTC date — drifts a calendar day
// off for users east of UTC after midnight local. Always use this helper
// when persisting/comparing user-facing dates so a 1am EDT photo doesn't get
// filed under yesterday's date in UTC, and an Asia-timezone user's morning
// photo doesn't get tagged with the previous day. Lifted to module scope so
// pre-App components (ProcedureCompareSlot, etc.) can use it too.
const localDateISO = (d = new Date()) => {
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  const dd = String(d.getDate()).padStart(2, '0');
  return `${yyyy}-${mm}-${dd}`;
};

// === SHARED MINI MONTH CALENDAR ===
// Compact navigable month grid used across the app (Compact Journal, Compare Time, etc.)
// to replace ad-hoc 30-day swipe strips. Mobile-first: cells are aspect-square, the entire
// component fits in a single mobile screenshot without scrolling.
//
// Props:
//   logs        — array of photo logs (will index by date, prefer full-face per day)
//   onDayClick  — (log, dateISO) => void; triggered when a day with a photo is tapped
//   showThumbs  — when true, render the photo as a thumbnail with the date overlay; when
//                 false (default), render the date number + a small rating beneath
//   procedures  — optional array; days with procedures get a rose marker dot
//   compact     — when true, cells render at min size (used in modals); default true
// === ProcedureCompareSlot ===
// One side of the Compare → Procedure custom upload pair. Tap to upload a photo, then
// surfaces inline date + note inputs. Borderless on the LEFT side; left-bordered on the
// RIGHT to match the existing two-column procedure card aesthetic.
const ProcedureCompareSlot = ({ slot, label, labelColor, value, onChange, fileToBase64, leftBorder = false }) => {
  const fileRef = useRef();
  const todayKey = localDateISO();
  const handlePick = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    try {
      const b64 = await fileToBase64(file);
      onChange({
        photo: b64,
        date: value?.date || todayKey,
        note: value?.note || '',
      });
    } catch (err) { console.error('[ProcedureCompareSlot] read failed', err); }
    if (fileRef.current) fileRef.current.value = '';
  };
  return (
    <div className={leftBorder ? 'border-l' : ''} style={{borderColor:'var(--line)'}}>
      <div className="text-[10px] tracking-[0.25em] uppercase px-3 pt-2.5 pb-1" style={{color: labelColor}}>{label}</div>
      <div className="aspect-square overflow-hidden relative" style={{background:'var(--cream-deep)'}}>
        {value?.photo ? (
          <>
            <img src={value.photo} alt={label} className="w-full h-full object-cover" />
            <button
              onClick={() => onChange(null)}
              className="absolute top-1.5 right-1.5 w-7 h-7 rounded-full flex items-center justify-center transition hover:opacity-90"
              style={{background:'rgba(250,250,246,0.85)', color:'var(--ink-soft)'}}
              title="Remove photo"
            >
              <Icon name="X" size={11} />
            </button>
          </>
        ) : (
          <button
            type="button"
            onClick={() => fileRef.current?.click()}
            className="w-full h-full flex flex-col items-center justify-center gap-1.5 transition hover:bg-[var(--cream)]"
            style={{color:'var(--ink-soft)'}}
          >
            <Icon name="Upload" size={20} />
            <span className="text-[9px] tracking-[0.25em] uppercase">Tap to upload</span>
          </button>
        )}
        <input ref={fileRef} type="file" accept="image/*" onChange={handlePick} className="hidden" />
      </div>
      {value?.photo && (
        <div className="px-3 py-2 space-y-1.5">
          <input
            type="date"
            value={value.date}
            max={todayKey}
            onChange={e => onChange({ ...value, date: e.target.value })}
            className="w-full px-1.5 py-0.5 text-[10px] border rounded-sm"
            style={{borderColor:'var(--line)', color:'var(--ink)', background:'var(--cream)'}}
          />
          <input autoCapitalize="off" autoCorrect="off" spellCheck={false}
            type="text"
            placeholder="Note (optional)"
            value={value.note || ''}
            onChange={e => onChange({ ...value, note: e.target.value })}
            className="w-full px-1.5 py-0.5 text-[10px] border rounded-sm"
            style={{borderColor:'var(--line)', color:'var(--ink)', background:'var(--cream)'}}
          />
        </div>
      )}
    </div>
  );
};

const MiniMonthCalendar = ({ logs = [], onDayClick, showThumbs = false, procedures = [] }) => {
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const [month, setMonth] = useState(new Date(today.getFullYear(), today.getMonth(), 1));
  const hasPhoto = (l) => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:'));
  // Index by date; prefer full-face photo per day for the cell representation.
  const photoByDate = {};
  (logs || []).forEach(l => {
    if (!hasPhoto(l)) return;
    const cur = photoByDate[l.date];
    if (!cur || (l.area === 'full-face' && cur.area !== 'full-face') || (l.area === cur.area && (l.id || 0) > (cur.id || 0))) {
      photoByDate[l.date] = l;
    }
  });
  const procByDate = {};
  (procedures || []).forEach(p => { if (!procByDate[p.date]) procByDate[p.date] = p; });

  const monthLabel = month.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  const firstWeekday = new Date(month.getFullYear(), month.getMonth(), 1).getDay();
  const daysInMonth = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
  const cells = [];
  for (let i = 0; i < firstWeekday; i++) cells.push(null);
  for (let d = 1; d <= daysInMonth; d++) cells.push(d);
  while (cells.length % 7 !== 0) cells.push(null);
  const todayKey = localDateISO(today);
  const isFutureMonth = month.getFullYear() > today.getFullYear()
    || (month.getFullYear() === today.getFullYear() && month.getMonth() >= today.getMonth());
  const prevMonth = () => setMonth(new Date(month.getFullYear(), month.getMonth() - 1, 1));
  const nextMonth = () => setMonth(new Date(month.getFullYear(), month.getMonth() + 1, 1));
  const goToday = () => setMonth(new Date(today.getFullYear(), today.getMonth(), 1));

  return (
    <div className="border" style={{borderColor:'var(--line)', background:'var(--cream)'}}>
      <div className="flex items-center justify-between px-3 py-2 border-b" style={{borderColor:'var(--line)'}}>
        <button onClick={prevMonth} className="p-1.5" style={{color:'var(--ink-soft)'}} aria-label="Previous month">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div className="flex items-baseline gap-2">
          <h3 className="font-serif italic text-sm md:text-base" style={{color:'var(--ink)'}}>{monthLabel}</h3>
          <button onClick={goToday} className="text-[9px] tracking-[0.2em] uppercase italic" style={{color:'var(--ink-soft)'}}>Today</button>
        </div>
        <button onClick={nextMonth} disabled={isFutureMonth} className="p-1.5 disabled:opacity-30" style={{color:'var(--ink-soft)'}} aria-label="Next month">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
      <div className="grid grid-cols-7 px-1.5 pt-1.5">
        {['S', 'M', 'T', 'W', 'T', 'F', 'S'].map((d, i) => (
          <div key={i} className="text-center text-[8px] tracking-[0.2em] uppercase py-0.5" style={{color:'var(--ink-soft)'}}>{d}</div>
        ))}
      </div>
      <div className="grid grid-cols-7 gap-0.5 px-1.5 pb-2">
        {cells.map((day, i) => {
          if (!day) return <div key={i} className="aspect-square" />;
          const dKey = `${month.getFullYear()}-${String(month.getMonth() + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
          const log = photoByDate[dKey];
          const proc = procByDate[dKey];
          const isToday = dKey === todayKey;
          const isFuture = new Date(dKey) > today;
          return (
            <button
              key={i}
              type="button"
              onClick={() => log && onDayClick && onDayClick(log, dKey)}
              disabled={!log || isFuture}
              className="aspect-square flex flex-col items-center justify-center transition relative disabled:cursor-default overflow-hidden"
              style={{
                background: isToday ? 'var(--accent-soft)' : (log && !showThumbs ? 'var(--cream-deep)' : 'transparent'),
                color: isFuture ? 'var(--line)' : (log ? 'var(--ink)' : 'var(--ink-soft)'),
                border: isToday ? '1px solid var(--accent)' : '1px solid transparent',
              }}
              title={log ? `${dKey} · ${log.rating}/10` : (proc ? `${dKey} · ${proc.name}` : dKey)}
            >
              {log && showThumbs && (
                <Photo item={log} alt="" className="absolute inset-0 w-full h-full object-cover" />
              )}
              <span
                className="text-[10px] font-light leading-none relative z-10"
                style={{
                  color: log && showThumbs ? '#fff' : undefined,
                  textShadow: log && showThumbs ? '0 1px 2px rgba(0,0,0,0.6)' : undefined,
                }}
              >{day}</span>
              {log && !showThumbs && (
                <span className="font-serif italic text-[10px] mt-0.5 leading-none" style={{color:'var(--accent)'}}>{log.rating}</span>
              )}
              {/* Marker dots — bottom of cell */}
              <span className="absolute bottom-0.5 left-0 right-0 flex justify-center gap-0.5 z-10">
                {proc && <span className="w-1 h-1 rounded-full" style={{background:'var(--rose)'}} />}
              </span>
            </button>
          );
        })}
      </div>
    </div>
  );
};

// === FACE-ID-STYLE CAMERA CAPTURE ===
// Live getUserMedia preview with an oval positioning guide. Captures a still frame at a fixed
// crop so every photo is the same size and framing — making before/after comparisons clean.
// Optional `angles` prop cycles the user through positions: front → left → right.
// Returns base64 data URL via onCapture(dataUrl).
const CameraCaptureModal = ({ onCapture, onClose, angles = ['front'], multi = false }) => {
  const videoRef = useRef();
  const canvasRef = useRef();
  const streamRef = useRef(null);
  const [error, setError] = useState('');
  const [angleIdx, setAngleIdx] = useState(0);
  // capturedShots accumulates either by angle (legacy multi-angle mode) or freely (`multi`).
  const [capturedShots, setCapturedShots] = useState([]);
  const angleLabels = {
    front: 'Look forward',
    left: 'Turn left — show your right cheek',
    right: 'Turn right — show your left cheek',
    up: 'Tilt up — show your jawline',
    down: 'Tilt down — show your forehead',
  };
  const currentAngle = angles[angleIdx] || 'front';

  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'user', width: { ideal: 1080 }, height: { ideal: 1080 } },
          audio: false,
        });
        if (cancelled) {
          stream.getTracks().forEach(t => t.stop());
          return;
        }
        streamRef.current = stream;
        if (videoRef.current) {
          videoRef.current.srcObject = stream;
          videoRef.current.play().catch(() => {});
        }
      } catch (e) {
        console.warn('Camera access failed:', e);
        setError('Camera permission denied. Use Upload instead, or enable camera in your browser settings.');
      }
    })();
    return () => {
      cancelled = true;
      if (streamRef.current) {
        streamRef.current.getTracks().forEach(t => t.stop());
        streamRef.current = null;
      }
    };
  }, []);

  // Capture a square frame from the video at native size. The oval guide is purely visual;
  // we crop a centered square so the saved image is consistent regardless of viewport.
  const snap = () => {
    const video = videoRef.current;
    const canvas = canvasRef.current;
    if (!video || !canvas) return null;
    const vw = video.videoWidth;
    const vh = video.videoHeight;
    if (!vw || !vh) return null;
    const size = Math.min(vw, vh);
    const sx = (vw - size) / 2;
    const sy = (vh - size) / 2;
    canvas.width = size;
    canvas.height = size;
    const ctx = canvas.getContext('2d');
    // Mirror horizontally for selfie cameras so the saved image matches what the user saw.
    ctx.translate(size, 0);
    ctx.scale(-1, 1);
    ctx.drawImage(video, sx, sy, size, size, 0, 0, size, size);
    return canvas.toDataURL('image/jpeg', 0.92);
  };

  const handleShoot = () => {
    const dataUrl = snap();
    if (!dataUrl) return;
    // === MULTI-SHOT MODE ===
    // Each tap collects a shot into the tray. User keeps tapping to add more,
    // then hits "Done" to return the full array. No auto-exit.
    if (multi) {
      setCapturedShots(prev => [...prev, { dataUrl }]);
      return;
    }
    if (angles.length > 1 && angleIdx < angles.length - 1) {
      // Multi-angle mode — collect and advance.
      setCapturedShots(prev => [...prev, { angle: currentAngle, dataUrl }]);
      setAngleIdx(angleIdx + 1);
    } else {
      // Single-angle or last shot — return to caller.
      const finalShots = angles.length > 1
        ? [...capturedShots, { angle: currentAngle, dataUrl }]
        : null;
      onCapture(dataUrl, finalShots);
      onClose && onClose();
    }
  };
  // Multi mode "Done" — return the accumulated shots.
  const handleMultiDone = () => {
    if (capturedShots.length === 0) { onClose && onClose(); return; }
    if (capturedShots.length === 1) {
      // Single result — keep the simple single-photo callback shape.
      onCapture(capturedShots[0].dataUrl, null);
    } else {
      // Multiple results — pass `null` for first arg (no single-photo shortcut)
      // and the array for finalShots.
      onCapture(null, capturedShots);
    }
    onClose && onClose();
  };
  const removeShot = (idx) => {
    setCapturedShots(prev => prev.filter((_, i) => i !== idx));
  };

  return (
    <div className="fixed inset-0 z-[60] flex flex-col" style={{background:'rgba(0,0,0,0.95)'}}>
      <canvas ref={canvasRef} style={{display:'none'}} />
      {/* Header */}
      <div className="flex items-center justify-between px-4 py-3 text-white">
        <button onClick={onClose} className="text-[10px] tracking-[0.2em] uppercase">Cancel</button>
        <div className="text-[10px] tracking-[0.3em] uppercase opacity-70">
          {multi ? `${capturedShots.length} captured` : (angles.length > 1 ? `${angleIdx + 1} / ${angles.length}` : 'Today')}
        </div>
        {multi ? (
          <button onClick={handleMultiDone} className="text-[10px] tracking-[0.2em] uppercase" style={{color: capturedShots.length > 0 ? '#fff' : 'rgba(255,255,255,0.4)'}}>
            {capturedShots.length === 0 ? 'Skip' : 'Done'}
          </button>
        ) : (
          <div className="w-12" />
        )}
      </div>

      {/* Live preview with oval overlay */}
      <div className="flex-1 relative overflow-hidden flex items-center justify-center">
        {error ? (
          <div className="text-white text-center px-6">
            <p className="font-serif italic text-base mb-3">{error}</p>
            <button onClick={onClose} className="text-[10px] tracking-[0.2em] uppercase border px-4 py-2" style={{borderColor:'rgba(255,255,255,0.5)'}}>Close</button>
          </div>
        ) : (
          <>
            <video
              ref={videoRef}
              playsInline
              muted
              autoPlay
              className="absolute inset-0 w-full h-full object-cover"
              style={{transform:'scaleX(-1)'}}
            />
            {/* Oval guide via SVG mask — punches a transparent oval in a dim overlay */}
            <svg className="absolute inset-0 w-full h-full pointer-events-none" preserveAspectRatio="none">
              <defs>
                <mask id="ovalMask">
                  <rect width="100%" height="100%" fill="white" />
                  <ellipse cx="50%" cy="50%" rx="35%" ry="42%" fill="black" />
                </mask>
              </defs>
              <rect width="100%" height="100%" fill="rgba(0,0,0,0.55)" mask="url(#ovalMask)" />
              <ellipse cx="50%" cy="50%" rx="35%" ry="42%" fill="none" stroke="rgba(255,255,255,0.85)" strokeWidth="2" strokeDasharray="6 4" />
            </svg>
            {/* Angle prompt — top */}
            <div className="absolute top-4 left-0 right-0 text-center pointer-events-none">
              <div className="font-serif italic text-white text-lg md:text-xl drop-shadow-md">
                {multi
                  ? (capturedShots.length === 0 ? 'Take your first shot' : `Tap shutter for another · or Done`)
                  : (angleLabels[currentAngle] || 'Look forward')}
              </div>
              <div className="text-[10px] tracking-[0.25em] uppercase text-white opacity-70 mt-1">
                {multi ? 'Categorize areas after — full face, T-zone, cheeks, etc.' : 'Align your face inside the oval'}
              </div>
            </div>
          </>
        )}
      </div>

      {/* Multi-mode thumbnail tray — shown above the shutter so user can review/remove shots. */}
      {multi && capturedShots.length > 0 && !error && (
        <div className="px-3 pt-2 pb-1 overflow-x-auto whitespace-nowrap">
          <div className="inline-flex gap-2">
            {capturedShots.map((s, i) => (
              <div key={i} className="relative inline-block flex-shrink-0">
                <img src={s.dataUrl} alt="" className="w-14 h-14 object-cover rounded-md border" style={{borderColor:'rgba(255,255,255,0.4)'}} />
                <button
                  onClick={() => removeShot(i)}
                  className="absolute -top-1 -right-1 w-4 h-4 rounded-full flex items-center justify-center text-[8px]"
                  style={{background:'rgba(0,0,0,0.85)', color:'#fff'}}
                  aria-label="Remove shot"
                >×</button>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Footer with shutter */}
      {!error && (
        <div className="flex items-center justify-center px-4 py-6 gap-6">
          <button
            onClick={handleShoot}
            className="w-16 h-16 rounded-full border-4 transition active:scale-95 flex items-center justify-center"
            style={{borderColor:'#fff', background:'rgba(255,255,255,0.1)'}}
            aria-label="Capture photo"
          >
            <span className="block w-12 h-12 rounded-full" style={{background:'#fff'}} />
          </button>
        </div>
      )}
    </div>
  );
};

// === LOCALSTORAGE HELPERS (replaces window.storage) ===
// Test localStorage availability up-front
let storageAvailable = false;
try {
  const t = '__lumiere_test__';
  localStorage.setItem(t, t);
  localStorage.removeItem(t);
  storageAvailable = true;
} catch (e) {
  console.error('localStorage is not available:', e);
}

const storage = {
  get: async (key) => {
    if (!storageAvailable) return null;
    try {
      const v = localStorage.getItem(`lumiere:${key}`);
      return v ? { value: v } : null;
    } catch (e) {
      console.error('storage.get failed for', key, e);
      return null;
    }
  },
  set: async (key, value) => {
    if (!storageAvailable) throw new Error('Storage unavailable');
    try {
      localStorage.setItem(`lumiere:${key}`, value);
      return { value };
    } catch (e) {
      console.error('storage.set failed for', key, e);
      throw e;
    }
  },
  delete: async (key) => {
    if (!storageAvailable) return { deleted: false };
    try {
      localStorage.removeItem(`lumiere:${key}`);
      return { deleted: true };
    } catch (e) {
      return { deleted: false };
    }
  }
};

// Debug: expose storage state for troubleshooting
window.__lumiereDebug = () => {
  const keys = Object.keys(localStorage).filter(k => k.startsWith('lumiere:'));
  console.log('Storage available:', storageAvailable);
  console.log('Lumiere keys in localStorage:', keys);
  keys.forEach(k => console.log(`  ${k}:`, localStorage.getItem(k)?.slice(0, 100)));
  return { available: storageAvailable, keys };
};

// === API KEY MANAGEMENT ===
const getApiKey = () => localStorage.getItem('lumiere:apiKey') || '';
const setApiKey = (k) => localStorage.setItem('lumiere:apiKey', k);

// === GEMINI API KEY / PROXY ===
// The Gemini key is no longer shipped in the client bundle. By default all
// Gemini calls go through a Supabase Edge Function (`gemini-proxy`) which
// holds the key as a server secret and enforces per-device daily caps
// (30 image gens, 100 text/vision calls). See supabase/functions/gemini-proxy/.
//
// Users can still bring their own Gemini key (Settings → API key) — when set,
// the app talks to Google directly and bypasses the proxy + caps.
const SUPABASE_PROXY_URL = 'https://vdtmflgetzilcgtcsogt.supabase.co/functions/v1/gemini-proxy';
// Retired keys — if any of these are still stuck in a user's localStorage from
// the old hardcoded-default era, drop them silently so we route through the proxy.
const RETIRED_GEMINI_KEYS = [
  'AIzaSyACBlFyOukgnhCf8FAz8ui466AL_iXP3tk',
  'AIzaSyDz4qNdG10ocEzGzGWz5Ofj__2wqhb3wJ8',
];
const getGeminiKey = () => {
  const stored = localStorage.getItem('lumiere:geminiKey');
  if (stored && RETIRED_GEMINI_KEYS.includes(stored)) {
    localStorage.removeItem('lumiere:geminiKey');
    try { localStorage.removeItem('lumiere:geminiModelWorking'); } catch {}
    return '';
  }
  return stored || '';
};
const setGeminiKey = (k) => localStorage.setItem('lumiere:geminiKey', k);
// Stable per-device identifier used by the proxy for rate limiting. Generated
// once on first call and persisted; clearing localStorage resets the daily cap
// (which is fine — these limits exist to slow abuse, not to be uncircumventable).
const getDeviceId = () => {
  let id = localStorage.getItem('lumiere:deviceId');
  if (!id || !/^[a-f0-9-]{16,64}$/i.test(id)) {
    id = (crypto.randomUUID && crypto.randomUUID()) ||
         (Date.now().toString(16) + Math.random().toString(16).slice(2) + Math.random().toString(16).slice(2)).slice(0, 36);
    localStorage.setItem('lumiere:deviceId', id);
  }
  return id;
};
// Single funnel for all Gemini calls. If the user has their own key in
// localStorage, hit Google directly. Otherwise route through the Supabase proxy.
// Returns the parsed JSON Gemini response (same shape either way) so existing
// caller logic doesn't have to change.
const callGeminiProxied = async ({ mode, model, payload, signal }) => {
  const userKey = getGeminiKey();
  if (userKey) {
    // BYO-key path — talk to Google directly, no caps.
    const url = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${encodeURIComponent(userKey)}`;
    const resp = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
      signal,
    });
    return { resp, viaProxy: false };
  }
  const resp = await fetch(SUPABASE_PROXY_URL, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'x-device-id': getDeviceId(),
    },
    body: JSON.stringify({ mode, model, payload }),
    signal,
  });
  return { resp, viaProxy: true };
};
// Remember the first Gemini image model that worked for this key so we can hit it
// directly on subsequent calls instead of paying the cost of trying the full
// fallback chain (each 404 in the chain is ~1s of wasted latency).
// Cleared whenever an auth/model error fires so a key swap re-discovers.
const getLastWorkingGeminiModel = () => localStorage.getItem('lumiere:geminiModelWorking') || null;
const setLastWorkingGeminiModel = (m) => { if (m) localStorage.setItem('lumiere:geminiModelWorking', m); };
const clearLastWorkingGeminiModel = () => localStorage.removeItem('lumiere:geminiModelWorking');
// Cached generated images keyed by product slug. Stored as data URIs so the row
// renders instantly on subsequent loads — no re-generation cost.
const getGeneratedProductArt = () => {
  try { return JSON.parse(localStorage.getItem('lumiere:generatedProductArt') || '{}'); }
  catch { return {}; }
};
const setGeneratedProductArt = (obj) => {
  try { localStorage.setItem('lumiere:generatedProductArt', JSON.stringify(obj)); } catch {}
};

// === SUPABASE SETUP ===
// Hardcoded credentials — anyone using this site gets cloud sync automatically
const SUPABASE_URL = 'https://vdtmflgetzilcgtcsogt.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_FyzirLiY3jyDInsZBWIOHA_32SX5aH6';

const getSupabaseConfig = () => ({
  url: localStorage.getItem('lumiere:supabaseUrl') || SUPABASE_URL,
  anonKey: localStorage.getItem('lumiere:supabaseKey') || SUPABASE_ANON_KEY
});
const setSupabaseConfig = (url, anonKey) => {
  localStorage.setItem('lumiere:supabaseUrl', url);
  localStorage.setItem('lumiere:supabaseKey', anonKey);
};

// Resilient Supabase initialization.
// The supabase-js CDN script may not be ready when this script first runs (slow network,
// blocking extensions, intermittent CDN). We poll for window.supabase up to ~5s, mark the
// status reactively, and let any UI subscribed via onSupabaseStateChange react to changes.
//
// State machine: 'pending' → 'connected' or 'failed' or 'disabled' (no creds configured).
let supabaseClient = null;
let supabaseInitState = 'pending';
let supabaseInitListeners = [];

const _notifySupabaseListeners = () => {
  const snapshot = { state: supabaseInitState, client: supabaseClient };
  supabaseInitListeners.forEach(fn => { try { fn(snapshot); } catch (_) {} });
};

const onSupabaseStateChange = (fn) => {
  supabaseInitListeners.push(fn);
  // Fire immediately with current state so subscribers don't miss the initial value
  try { fn({ state: supabaseInitState, client: supabaseClient }); } catch (_) {}
  return () => { supabaseInitListeners = supabaseInitListeners.filter(f => f !== fn); };
};

const _attemptSupabaseInit = () => {
  if (supabaseClient) return true;
  const { url, anonKey } = getSupabaseConfig();
  if (!url || !anonKey) {
    if (supabaseInitState !== 'disabled') {
      supabaseInitState = 'disabled';
      _notifySupabaseListeners();
    }
    return false;
  }
  if (!window.supabase || !window.supabase.createClient) return false; // library not yet loaded
  try {
    supabaseClient = window.supabase.createClient(url, anonKey, {
      auth: { persistSession: true, autoRefreshToken: true }
    });
    supabaseInitState = 'connected';
    _notifySupabaseListeners();
    return true;
  } catch (e) {
    console.error('Supabase init failed:', e);
    supabaseInitState = 'failed';
    _notifySupabaseListeners();
    return false;
  }
};

// Try once now; if it doesn't take, poll for the library to load.
if (!_attemptSupabaseInit() && supabaseInitState === 'pending') {
  let attempts = 0;
  const POLL_MS = 100;
  const MAX_ATTEMPTS = 50; // 5 seconds total
  const pollId = setInterval(() => {
    attempts++;
    if (_attemptSupabaseInit()) {
      clearInterval(pollId);
    } else if (attempts >= MAX_ATTEMPTS) {
      clearInterval(pollId);
      if (supabaseInitState === 'pending') {
        supabaseInitState = 'failed';
        _notifySupabaseListeners();
      }
    }
  }, POLL_MS);
}

// Manual retry — used by the "Retry connection" button if init fails.
const retrySupabaseInit = () => {
  if (supabaseClient) return true;
  // Reset state and try again
  supabaseInitState = 'pending';
  _notifySupabaseListeners();
  if (_attemptSupabaseInit()) return true;
  // Poll again briefly
  let attempts = 0;
  const pollId = setInterval(() => {
    attempts++;
    if (_attemptSupabaseInit() || attempts >= 30) {
      clearInterval(pollId);
      if (!supabaseClient && supabaseInitState === 'pending') {
        supabaseInitState = 'failed';
        _notifySupabaseListeners();
      }
    }
  }, 100);
  return false;
};

const isSupabaseEnabled = () => supabaseInitState === 'connected';
const getSupabaseInitState = () => supabaseInitState;

// === PHOTO STORAGE (Supabase Storage) ===
// Photos live in a private bucket keyed by user_id. RLS in Supabase enforces that users
// can only read/write photos in their own folder. Locally we store only the storage path
// (e.g. "user-id/photo-id.jpg") on log/product objects, never the base64 itself.
const PHOTO_BUCKET = 'etude-photos';
const PHOTO_CAP_PER_USER = 365; // hard cap; oldest non-anchor photos are pruned past this
const PHOTO_USER_SOFT_CAP_BYTES = 50 * 1024 * 1024; // 50 MB per user — pre-upload check
const SIGNED_URL_TTL_S = 60 * 60; // 1 hour

// In-memory cache of signed URLs for the session. Fetched lazily; expire 1 minute before
// the actual TTL to avoid edge-case stale URLs.
const _signedUrlCache = new Map(); // path -> { url, expiresAt }

const _b64ToBlob = (dataUrl) => {
  const m = dataUrl.match(/^data:image\/(\w+);base64,(.+)$/);
  if (!m) return null;
  const mime = `image/${m[1]}`;
  const binary = atob(m[2]);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  return { blob: new Blob([bytes], { type: mime }), ext: m[1] === 'jpeg' ? 'jpg' : m[1] };
};

// Upload a base64 data URL to Storage. Returns { path, error }.
const uploadPhotoToStorage = async (userId, base64DataUrl) => {
  if (!supabaseClient) return { path: null, error: 'Cloud sync not connected' };
  if (!userId) return { path: null, error: 'No user id' };
  const converted = _b64ToBlob(base64DataUrl);
  if (!converted) return { path: null, error: 'Invalid image data' };
  const photoId = `${Date.now()}-${Math.random().toString(36).slice(2, 9)}`;
  const path = `${userId}/${photoId}.${converted.ext}`;
  const { error } = await supabaseClient.storage
    .from(PHOTO_BUCKET)
    .upload(path, converted.blob, { contentType: converted.blob.type, upsert: false });
  if (error) return { path: null, error: error.message };
  return { path, error: null };
};

// Get a signed URL for a stored photo path. Cached in memory for the session.
const getSignedPhotoUrl = async (path) => {
  if (!path || !supabaseClient) return null;
  const cached = _signedUrlCache.get(path);
  if (cached && cached.expiresAt > Date.now()) return cached.url;
  try {
    const { data, error } = await supabaseClient.storage
      .from(PHOTO_BUCKET)
      .createSignedUrl(path, SIGNED_URL_TTL_S);
    if (error) {
      console.error('Signed URL error:', error);
      return null;
    }
    _signedUrlCache.set(path, {
      url: data.signedUrl,
      expiresAt: Date.now() + (SIGNED_URL_TTL_S - 60) * 1000,
    });
    return data.signedUrl;
  } catch (e) {
    console.error('getSignedPhotoUrl failed:', e);
    return null;
  }
};

// Delete a photo from Storage. Returns boolean success.
const deletePhotoFromStorage = async (path) => {
  if (!path || !supabaseClient) return false;
  try {
    const { error } = await supabaseClient.storage
      .from(PHOTO_BUCKET)
      .remove([path]);
    if (error) { console.error('Photo delete error:', error); return false; }
    _signedUrlCache.delete(path);
    return true;
  } catch (e) {
    console.error('deletePhotoFromStorage failed:', e);
    return false;
  }
};

// Returns { bytes, count } for the current user's photos. Used to enforce the soft cap
// and to surface usage info in settings.
const getUserStorageStats = async (userId) => {
  if (!userId || !supabaseClient) return { bytes: 0, count: 0 };
  try {
    const { data, error } = await supabaseClient.storage
      .from(PHOTO_BUCKET)
      .list(userId, { limit: 1000 });
    if (error) { console.error('Storage stats error:', error); return { bytes: 0, count: 0 }; }
    const bytes = (data || []).reduce((s, f) => s + (f.metadata?.size || 0), 0);
    return { bytes, count: (data || []).length };
  } catch (e) {
    console.error('getUserStorageStats failed:', e);
    return { bytes: 0, count: 0 };
  }
};

// Fetch a stored photo as base64 (data URL). Used by AI vision flows that need to send
// the image to Anthropic. Hits the signed URL, downloads bytes, encodes.
const fetchPhotoAsBase64 = async (path) => {
  if (!path) return null;
  const url = await getSignedPhotoUrl(path);
  if (!url) return null;
  try {
    const resp = await fetch(url);
    if (!resp.ok) return null;
    const blob = await resp.blob();
    return await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onloadend = () => resolve(reader.result);
      reader.onerror = reject;
      reader.readAsDataURL(blob);
    });
  } catch (e) {
    console.error('fetchPhotoAsBase64 failed:', e);
    return null;
  }
};

// Resolve a log/product/etc to whatever it has — new photoPath takes priority over
// legacy base64 in the photo field. Returns { path, legacyDataUrl }.
const _resolvePhotoSource = (item) => {
  if (!item) return { path: null, legacyDataUrl: null };
  const path = item.photoPath || null;
  const photoStr = typeof item.photo === 'string' ? item.photo : null;
  const legacyDataUrl = (photoStr && photoStr.startsWith('data:')) ? photoStr : null;
  return { path, legacyDataUrl };
};

// === PHOTO CAP & ANCHOR CLEANUP ===
// When a user passes 365 photos, we keep one "anchor" photo per year-month — the
// highest-rated photo that month — so year-over-year comparison stays possible. Beyond
// the anchors, we trim oldest non-anchor photos until back at the cap.
//
// Returns { toDeletePaths, updatedLogs, trimmed }. Does NOT mutate; the caller is
// responsible for deleting from Storage and persisting the updated logs.
const computePhotoCleanup = (logs) => {
  const withPhotos = logs.filter(l => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:')));
  if (withPhotos.length <= PHOTO_CAP_PER_USER) {
    return { toDeletePaths: [], updatedLogs: logs, trimmed: 0 };
  }
  // Anchor per year-month: highest-rated photo. Ties go to the latest in the month.
  const anchorByMonth = new Map();
  withPhotos.forEach(l => {
    const key = new Date(l.date).toISOString().slice(0, 7);
    const cur = anchorByMonth.get(key);
    if (!cur || +l.rating > +cur.rating || (+l.rating === +cur.rating && new Date(l.date) > new Date(cur.date))) {
      anchorByMonth.set(key, l);
    }
  });
  const anchorIds = new Set([...anchorByMonth.values()].map(l => l.id));
  // Walk oldest-first; mark non-anchors for deletion until we're back at the cap.
  const sortedAsc = [...withPhotos].sort((a, b) => new Date(a.date) - new Date(b.date));
  const toDelete = [];
  let remaining = withPhotos.length;
  for (const log of sortedAsc) {
    if (remaining <= PHOTO_CAP_PER_USER) break;
    if (anchorIds.has(log.id)) continue;
    toDelete.push(log);
    remaining--;
  }
  const deleteIds = new Set(toDelete.map(l => l.id));
  const toDeletePaths = toDelete.map(l => l.photoPath).filter(Boolean);
  // Strip photo + photoPath from the deleted entries (the log itself stays — only the
  // photo reference is removed, so notes/rating/concerns survive).
  const updatedLogs = logs.map(l => {
    if (!deleteIds.has(l.id)) return l;
    const { photo, photoPath, ...rest } = l;
    return rest;
  });
  return { toDeletePaths, updatedLogs, trimmed: toDelete.length };
};

// === ACTUAL USAGE — what the user is genuinely doing, not just what's on the shelf ===
//
// The shelf is *inventory* (products owned). The check-in (regimenLogs) and per-photo
// usedProducts list capture *behavior* (products actually applied). Every AI prompt that
// describes "your routine" must use this — passing the full shelf misleads the AI into
// assuming products the user owns but has stopped using are still in play, producing
// wrong analysis ("X may be irritating you" when X hasn't been used in 30 days).
//
// Returns:
//   {
//     actuallyUsed: [{ product, amCount, pmCount, onLogs, totalDays, lastDate, daysSinceLast, status: 'active' }],
//     occasional:   [...status: 'occasional' — used 1× in last 14d but not recently],
//     lapsed:       [...status: 'lapsed' — owned, used in window before but not in last 14d],
//     unused:       [...status: 'unused' — owned but never used in window],
//     all:          [...full list],
//   }
//
// `windowDays` defaults to 30. Set to 14 for tighter "what are they on right now."
const getActualUsage = (products, regimenLogs, photoLogs, opts = {}) => {
  const windowDays = opts.windowDays || 30;
  const cutoff = Date.now() - windowDays * 86400000;
  const usage = new Map();
  (products || []).forEach(p => {
    if (p.endDate) return; // explicitly retired — not a candidate
    usage.set(p.id, {
      product: p,
      amCount: 0,
      pmCount: 0,
      onLogs: 0,
      totalDays: 0,
      lastDate: null,
    });
  });
  (regimenLogs || []).forEach(r => {
    if (!r.date) return;
    if (new Date(r.date).getTime() < cutoff) return;
    const usedToday = new Set();
    (r.amProducts || []).forEach(id => {
      const u = usage.get(id);
      if (u) { u.amCount++; usedToday.add(id); if (!u.lastDate || r.date > u.lastDate) u.lastDate = r.date; }
    });
    (r.pmProducts || []).forEach(id => {
      const u = usage.get(id);
      if (u) { u.pmCount++; usedToday.add(id); if (!u.lastDate || r.date > u.lastDate) u.lastDate = r.date; }
    });
    usedToday.forEach(id => { const u = usage.get(id); if (u) u.totalDays++; });
  });
  (photoLogs || []).forEach(l => {
    if (!l.date) return;
    if (new Date(l.date).getTime() < cutoff) return;
    (l.usedProducts || []).forEach(id => {
      const u = usage.get(id);
      if (u) { u.onLogs++; if (!u.lastDate || l.date > u.lastDate) u.lastDate = l.date; }
    });
  });
  const today = new Date();
  const enriched = [];
  usage.forEach(u => {
    const usedAtAll = u.amCount + u.pmCount + u.onLogs > 0;
    const daysSinceLast = u.lastDate ? Math.floor((today - new Date(u.lastDate)) / 86400000) : Infinity;
    let status;
    if (!usedAtAll) status = 'unused';
    else if (daysSinceLast > 14) status = 'lapsed';
    else if (daysSinceLast > 7 || u.totalDays < 3) status = 'occasional';
    else status = 'active';
    enriched.push({ ...u, daysSinceLast, status });
  });
  return {
    actuallyUsed: enriched.filter(e => e.status === 'active'),
    occasional:   enriched.filter(e => e.status === 'occasional'),
    lapsed:       enriched.filter(e => e.status === 'lapsed'),
    unused:       enriched.filter(e => e.status === 'unused'),
    all: enriched,
  };
};

// Format the usage object as a structured prompt block. Every AI prompt that describes
// "the user's routine" should use this — the explicit categorization (active vs lapsed
// vs unused) prevents the model from assuming everything on the shelf is in play.
const formatUsageForPrompt = (usage) => {
  const lines = [];
  if (usage.actuallyUsed.length > 0) {
    lines.push('ACTIVELY USED (last 7-14 days, from check-ins + photo logs — these are what they\'re ACTUALLY ON):');
    usage.actuallyUsed.forEach(u => {
      const p = u.product;
      const freq = `${u.amCount}× AM, ${u.pmCount}× PM${u.onLogs > 0 ? `, ${u.onLogs}× tagged on photo entry` : ''}`;
      lines.push(`• ${p.name}${p.brand ? ` (${p.brand})` : ''} — ${p.activeIngredients || 'no actives listed'} [${freq}]`);
    });
  } else {
    lines.push('ACTIVELY USED: nothing recorded in recent check-ins. The user has products on their shelf but is NOT logging actual use. Do NOT assume any product is in their routine.');
  }
  if (usage.occasional.length > 0) {
    lines.push('\nOCCASIONAL / IRREGULAR (used 1-2× recently — treat as part-time, not core routine):');
    usage.occasional.forEach(u => lines.push(`• ${u.product.name} — ${u.product.activeIngredients || 'no actives listed'} (${u.totalDays} day${u.totalDays === 1 ? '' : 's'} in window)`));
  }
  if (usage.lapsed.length > 0) {
    lines.push('\nOWNED but LAPSED (>14 days since last use — DO NOT include in current-routine analysis. Only mention if relevant to "why aren\'t they using X" or "have they tried X"):');
    usage.lapsed.forEach(u => lines.push(`• ${u.product.name} (last used ${u.daysSinceLast}d ago)`));
  }
  if (usage.unused.length > 0) {
    const names = usage.unused.map(u => u.product.name).join(', ');
    lines.push(`\nOWNED but NEVER USED in window (sitting on shelf — DO NOT assume in routine): ${names}`);
  }
  return lines.join('\n');
};

// === PRODUCT COMPARE ANCHORS ===
// Computes "before & after" anchors for a single product. The start anchor is the EARLIEST
// of three signals: (1) product.startDate (explicit user opt-in), (2) first regimenLog
// where this product is checked off, (3) first photo log where this product is tagged.
// This way a long-running staple still gets a reasonable anchor even if the user never
// flipped "Started today" — we infer from real behavior.
//
// Photo selection is LOOSE — we want any full-face photo since the start anchor, not only
// photos on days the product was applied. The question being answered is "has my skin
// changed since I started X?", which is properly answered by time-spaced photos regardless
// of single-day usage. Falls back to non-full-face if no full-face exists.
//
// Returns:
//   {
//     startDate: 'YYYY-MM-DD' | null,
//     startSource: 'explicit' | 'regimen' | 'photo-tag' | null,
//     anchorPhotoLog: log | null,   // closest full-face on/after startDate
//     latestPhotoLog: log | null,   // most recent full-face since startDate
//     daysActive: number | null,
//     photoCount: number,           // photos in window
//     hasEnoughData: boolean,       // ≥14 days span AND ≥2 photos
//     reasonShort: string,          // 'Need 14+ days and 2 photos' if not ready
//   }
const _hasPhotoForCompare = (l) => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:'));
const findProductCompareAnchors = (product, products, regimenLogs, photoLogs) => {
  if (!product) return { startDate: null, startSource: null, anchorPhotoLog: null, latestPhotoLog: null, daysActive: null, photoCount: 0, hasEnoughData: false, reasonShort: 'No product' };
  // Signal 1 — explicit startDate
  let earliest = product.startDate || null;
  let source = product.startDate ? 'explicit' : null;
  // Signal 2 — first regimenLog mentioning this product
  const fromRegimen = (regimenLogs || [])
    .filter(r => (r.amProducts || []).includes(product.id) || (r.pmProducts || []).includes(product.id))
    .map(r => r.date)
    .sort()[0];
  if (fromRegimen && (!earliest || fromRegimen < earliest)) {
    earliest = fromRegimen;
    source = 'regimen';
  }
  // Signal 3 — first photo log tagging this product
  const fromPhotoTag = (photoLogs || [])
    .filter(l => (l.usedProducts || []).includes(product.id))
    .map(l => l.date)
    .sort()[0];
  if (fromPhotoTag && (!earliest || fromPhotoTag < earliest)) {
    earliest = fromPhotoTag;
    source = 'photo-tag';
  }
  if (!earliest) {
    return { startDate: null, startSource: null, anchorPhotoLog: null, latestPhotoLog: null, daysActive: null, photoCount: 0, hasEnoughData: false, reasonShort: 'No usage logged yet — check it off in your daily regimen first.' };
  }
  // Photo windowing: anchor = first full-face photo on/after start, latest = most recent.
  // Falls back to non-full-face if no full-face exists in the window.
  const since = (photoLogs || []).filter(l => l.date >= earliest && _hasPhotoForCompare(l));
  const sinceFullFace = since.filter(l => l.area === 'full-face');
  const candidatePool = sinceFullFace.length >= 2 ? sinceFullFace : since;
  const sortedAsc = [...candidatePool].sort((a, b) => {
    if (a.date !== b.date) return a.date.localeCompare(b.date);
    return (a.id || 0) - (b.id || 0);
  });
  const sortedDesc = [...candidatePool].sort((a, b) => {
    if (a.date !== b.date) return b.date.localeCompare(a.date);
    return (b.id || 0) - (a.id || 0);
  });
  const anchorPhotoLog = sortedAsc[0] || null;
  const latestPhotoLog = sortedDesc[0] || null;
  const sameLog = anchorPhotoLog && latestPhotoLog && anchorPhotoLog.id === latestPhotoLog.id;
  const photoCount = candidatePool.length;
  const daysActive = Math.floor((Date.now() - new Date(earliest).getTime()) / 86400000);
  const hasEnoughData = !sameLog && daysActive >= 14 && photoCount >= 2;
  const reasonShort = hasEnoughData ? '' :
    daysActive < 14 ? `Need 14+ days · you're at ${daysActive}.` :
    photoCount < 2 ? `Need 2+ photos since starting · you're at ${photoCount}.` :
    sameLog ? 'Need 2 distinct photos in the window.' :
    'Not enough data yet.';
  return { startDate: earliest, startSource: source, anchorPhotoLog, latestPhotoLog, daysActive, photoCount, hasEnoughData, reasonShort };
};

// === PEARLS — EDITORIAL LESSONS + MD-VERIFIED PICKS ===
// Lessons: short, evidence-graded teaching pieces. Triggered by keywords in AI responses.
// Verified picks: products explicitly endorsed by named MDs. The verifiedBy array stays
// empty until an entry is signed off — drafts render without attribution chips.
//
// Categories — lessons: 'actives' | 'protocol' | 'nutrition' | 'philosophy'
// Categories — picks: 'cleanser' | 'moisturizer' | 'sunscreen' | 'retinoid' | 'vitamin-c'
// Tiers: 'drugstore' | 'mid' | 'luxe'
// Splurge or save: 'save' | 'splurge' | 'either'
// Evidence grade (loosely GRADE-style): 'A' | 'B' | 'C'
// Verified by: array of curator surnames, e.g. ['Tang', 'Gainey']

// === STARTER PRODUCT PREVIEWS ===
// The four-bottle lineup in Today's Ritual maps positionally to a curated starter
// routine: SK-II essence, REJURAN ampoule, AESTURA Atobarrier cream, EltaMD UV Clear.
// Default rendering is a subtle dashed-outline silhouette per slot. If the user has
// added their own Gemini API key, we generate AI art for each slot and cache the
// resulting data URIs by `slug` so the row renders instantly thereafter.
const STARTER_PRODUCT_PREVIEWS = [
  {
    slug: 'sk2',
    name: 'SK-II Facial Treatment Essence',
    brand: 'SK-II',
    // Generic essence-bottle silhouette. No brand text, no logos, no
    // distinctive trade-dress markings — visual variety comes from the
    // bottle SHAPE (slim rectangular vs cylindrical vs tube), not from
    // mimicking any specific brand's packaging.
    prompt: 'A minimalist editorial product photograph of an unbranded clear glass essence bottle with a frosted finish, slim rectangular silhouette, plain unmarked surface, on a soft warm cream background. Soft diffuse natural light, gentle shadow, magazine beauty aesthetic, centered, full bottle visible. NO text, NO logos, NO brand markings, NO label graphics — just the bare bottle.',
    style: 'sk2',
  },
  {
    slug: 'rejuran',
    name: 'REJURAN Turnover Ampoule',
    brand: 'REJURAN',
    prompt: 'A minimalist editorial product photograph of an unbranded silver chrome metallic ampoule bottle with a pump dispenser top, slim cylindrical shape, plain unmarked surface, on a soft warm cream background. Soft diffuse natural light, gentle shadow, magazine beauty aesthetic, centered, full bottle visible. NO text, NO logos, NO brand markings, NO label graphics — just the bare bottle.',
    style: 'rejuran',
  },
  {
    slug: 'aestura',
    name: 'AESTURA Atobarrier 365 Cream',
    brand: 'AESTURA',
    prompt: 'A minimalist editorial product photograph of an unbranded soft white squeeze tube cream, slim rectangular tube shape with a small flip cap, plain matte unmarked surface, on a soft warm cream background. Soft diffuse natural light, gentle shadow, magazine beauty aesthetic, centered, full tube visible. NO text, NO logos, NO brand markings, NO accent stripes, NO label graphics — just the bare tube.',
    style: 'aestura',
  },
  {
    slug: 'eltamd',
    name: 'EltaMD UV Clear',
    brand: 'EltaMD',
    prompt: 'A minimalist editorial product photograph of an unbranded soft pale sage-green sunscreen tube with a matching cap, slim cylindrical shape, plain matte unmarked surface, on a soft warm cream background. Soft diffuse natural light, gentle shadow, magazine beauty aesthetic, centered, full tube visible. NO text, NO logos, NO brand markings, NO label graphics — just the bare tube.',
    style: 'photo',
    src: 'data:image/jpeg;base64,',
  },
];

// === LOCAL PRODUCT DATABASE ===
// Seed list of ~100 popular skincare products across K-beauty, drugstore,
// mid-range, and luxury. Used by the Add Product typeahead for INSTANT
// matches with zero API calls. Falls back to Claude search only when no
// local match. Keep entries terse — each adds bytes to the bundle.
//
// Field shape matches what Claude's search prompt returns so they're
// interchangeable downstream: { name, brand, category, actives, main, tags, concerns }
//
// To extend: run scripts/generate_products.js with your Anthropic key and a
// list of brands you want added — it appends new entries here. See
// scripts/generate_products.js for the prompt + format.
const POPULAR_PRODUCTS = [
  // === K-BEAUTY ===
  { name: 'Advanced Snail 96 Mucin Power Essence', brand: 'COSRX', category: 'essence', actives: 'Snail Secretion Filtrate 96%', main: 'Sodium Hyaluronate, Betaine, Panthenol, Allantoin', tags: ['snail-mucin','hydrating','barrier-repair','soothing'], concerns: ['dryness','texture','dullness','sensitivity'] },
