        {activeTab === 'pearls' && (() => {
          const lessonCategories = ['all', ...new Set(LESSONS.map(l => l.category))];
          const pickCategories = ['all', ...new Set(VERIFIED_PICKS.map(p => p.category))];
          const filteredLessons = pearlsLessonCategory === 'all' ? LESSONS : LESSONS.filter(l => l.category === pearlsLessonCategory);
          const filteredPicks = VERIFIED_PICKS.filter(p =>
            (pearlsPickCategory === 'all' || p.category === pearlsPickCategory) &&
            (pearlsPickTier === 'all' || p.tier === pearlsPickTier) &&
            (pearlsPickSplurge === 'all' || p.splurgeOrSave === pearlsPickSplurge || p.splurgeOrSave === 'either')
          );
          const decisionCards = [
            { icon: 'ShoppingBag', label: 'Buy smarter', text: 'Check gaps before adding another bottle.', tone: 'pink', action: () => { setPearlsTab('picks'); setPearlsPickSplurge('all'); } },
            { icon: 'Trash2', label: 'Cull the shelf', text: 'Find duplicates and products not earning their slot.', tone: 'gold', action: () => { setPearlsTab('picks'); setBudgetScope('shelf'); } },
            { icon: 'Wallet', label: 'Budget calls', text: 'Assess what can be swapped, saved, or skipped.', tone: 'blue', action: () => { setPearlsTab('picks'); setBudgetScope('regimen'); } },
            { icon: 'FlaskConical', label: 'Ingredient logic', text: 'See what layers well and what needs spacing.', tone: 'white', action: () => { setPearlsLessonCategory('ingredients'); setPearlsTab('lessons'); } },
          ];
          const activeProductsForBudget = (products || []).filter(p => !p.endDate);
          const builtProductsForBudget = activeProductsForBudget.filter(productIsInBuiltRoutine);
          const budgetBaseProducts = budgetScope === 'regimen' ? builtProductsForBudget : activeProductsForBudget;
          const productBudgetFamily = (p) => {
            const cat = String(p?.category || '').toLowerCase();
            const text = `${p?.name || ''} ${p?.brand || ''} ${p?.actives || ''} ${p?.main || ''} ${(p?.tags || []).join(' ')}`.toLowerCase();
            if (cat.includes('sunscreen') || /\bspf\b|sunscreen|uv clear|mineral/.test(text)) return 'spf';
            if (cat.includes('cleanser') || /cleanser|cleansing|wash|balm|oil cleanser/.test(text)) return 'cleanser';
            if (cat.includes('moisturizer') || /moisturizer|cream|lotion|barrier|ceramide|atobarrier|cicaplast/.test(text)) return 'moisturizer';
            if (/retinoid|retinol|retinal|adapalene|tretinoin|tazarotene|bha|aha|salicylic|glycolic|lactic|vitamin c|ascorbic|azelaic|benzoyl/.test(text)) return 'active';
            return 'other';
          };
          const scopeFilteredBudgetProducts = budgetBaseProducts.filter(p => budgetScope === 'all' || budgetScope === 'regimen' || budgetScope === 'shelf' || productBudgetFamily(p) === budgetScope);
          const budgetCounts = ['cleanser', 'moisturizer', 'spf', 'active'].reduce((acc, fam) => {
            acc[fam] = budgetBaseProducts.filter(p => productBudgetFamily(p) === fam).length;
            return acc;
          }, {});
          const budgetAssessment = [
            { id: 'cleanser', label: 'Cleanser', status: budgetCounts.cleanser ? `${budgetCounts.cleanser} on ${budgetScope === 'regimen' ? 'plan' : 'shelf'}` : 'Gap', tone: budgetCounts.cleanser ? 'ok' : 'gap' },
            { id: 'moisturizer', label: 'Moisturizer', status: budgetCounts.moisturizer ? `${budgetCounts.moisturizer} on ${budgetScope === 'regimen' ? 'plan' : 'shelf'}` : 'Gap', tone: budgetCounts.moisturizer ? 'ok' : 'gap' },
            { id: 'spf', label: 'SPF', status: budgetCounts.spf ? `${budgetCounts.spf} on ${budgetScope === 'regimen' ? 'plan' : 'shelf'}` : 'Gap', tone: budgetCounts.spf ? 'ok' : 'gap' },
            { id: 'active', label: 'Actives', status: budgetCounts.active ? `${budgetCounts.active} active lane${budgetCounts.active === 1 ? '' : 's'}` : 'Optional', tone: budgetCounts.active ? 'ok' : 'neutral' },
          ];
          const budgetAlternatives = [
            { id: 'cerave-hydrating-cleanser', family: 'cleanser', brand: 'CeraVe', name: 'Hydrating Cleanser', price: '$', swapFor: 'gentle daily cleanser', why: 'Boring, barrier-friendly, and hard to beat on price.' },
            { id: 'cetaphil-gentle-cleanser', family: 'cleanser', brand: 'Cetaphil', name: 'Gentle Skin Cleanser', price: '$', swapFor: 'non-stripping cleanser', why: 'Good fallback when skin is reactive or routines are too active-heavy.' },
            { id: 'cerave-pm-budget', family: 'moisturizer', brand: 'CeraVe', name: 'PM Facial Moisturizing Lotion', price: '$', swapFor: 'light barrier moisturizer', why: 'Ceramides + niacinamide without the premium moisturizer markup.' },
            { id: 'lrp-cicaplast-budget', family: 'moisturizer', brand: 'La Roche-Posay', name: 'Cicaplast Baume B5', price: '$$', swapFor: 'recovery balm', why: 'Worth keeping as a rescue layer after irritation, travel, or procedures.' },
            { id: 'boj-relief-sun-budget', family: 'spf', brand: 'Beauty of Joseon', name: 'Relief Sun SPF50+', price: '$$', swapFor: 'daily comfortable SPF', why: 'Good wearability is the budget logic: sunscreen only works if you use it.' },
            { id: 'cerave-am-spf-budget', family: 'spf', brand: 'CeraVe', name: 'AM Facial Moisturizing Lotion SPF 30', price: '$', swapFor: 'basic AM SPF moisturizer', why: 'Not glamorous, but covers the non-negotiable baseline cheaply.' },
            { id: 'differin-adapalene-budget', family: 'active', brand: 'Differin', name: 'Adapalene Gel 0.1%', price: '$', swapFor: 'acne / comedone retinoid', why: 'One of the best cost-to-evidence ratios in skincare.' },
            { id: 'ordinary-azelaic-budget', family: 'active', brand: 'The Ordinary', name: 'Azelaic Acid Suspension 10%', price: '$', swapFor: 'redness + pigment support', why: 'Budget way into azelaic logic if texture is tolerable.' },
          ];
          const budgetVisibleAlternatives = budgetAlternatives.filter(a => {
            if (budgetScope === 'regimen' || budgetScope === 'all' || budgetScope === 'shelf') return true;
            return a.family === budgetScope;
          });
          const savedBudgetItems = budgetAlternatives.filter(a => budgetSavedIds.includes(a.id));
          const builtBudgetIds = new Set(builtProductsForBudget.map(p => p.id));
          const shelfNotInRegimen = activeProductsForBudget.filter(p => !builtBudgetIds.has(p.id));
          const shelfDecisionBase = budgetScope === 'shelf' || budgetScope === 'regimen'
            ? shelfNotInRegimen
            : shelfNotInRegimen.filter(p => productBudgetFamily(p) === budgetScope);
          const overlapBaseProducts = builtProductsForBudget.length ? builtProductsForBudget : activeProductsForBudget;
          const overlapFamilyLabel = (family) => ({
            spf: 'SPF',
            cleanser: 'Cleansers',
            moisturizer: 'Moisturizers',
            retinoid: 'Retinoids',
            bha: 'BHA',
            aha: 'AHA',
            pha: 'PHA',
            bpo: 'Benzoyl peroxide',
            azelaic: 'Azelaic acid',
            vitc: 'Vitamin C',
            niacinamide: 'Niacinamide',
            peptide: 'Peptides',
            ceramide: 'Ceramides',
            humectant: 'Hydrators',
            centella: 'Centella',
            tranexamic: 'Tranexamic acid',
            arbutin: 'Arbutin',
            bakuchiol: 'Bakuchiol',
          })[family] || String(family || 'Other').replace(/-/g, ' ');
          const overlapFamilyForProduct = (p) => {
            const activeFamily = detectActiveFamily([p.activeIngredients, p.actives, p.main, p.name, p.category, ...(p.tags || [])].filter(Boolean).join(' '));
            return activeFamily || productBudgetFamily(p);
          };
          const overlapMap = overlapBaseProducts.reduce((acc, p) => {
            const family = overlapFamilyForProduct(p);
            if (!family || family === 'other') return acc;
            if (!acc[family]) acc[family] = [];
            acc[family].push(p);
            return acc;
          }, {});
          const overlapGroups = Object.entries(overlapMap)
            .map(([family, items]) => ({ family, label: overlapFamilyLabel(family), items }))
            .filter(g => g.items.length > 1)
            .sort((a, b) => b.items.length - a.items.length || a.label.localeCompare(b.label));
          // Bench (May 31 2026 per Jenni): owned products not currently in
          // the built routine (unused) + products that share an active
          // family with something already active (overlap). shelfNotInRegimen
          // already covers "owned but not scheduled in buildPlan".
          const unusedProducts = shelfNotInRegimen;
          const benchCount = unusedProducts.length + overlapGroups.length;
          // picksViewOptions is defined further down (after the budget pool
          // is built) so the Budget tab count can use the real list length.
          // See `const picksViewOptions = [...]` below the suggestion pools.
          // Action goal pills. No "All" pill — default state (picksActionFilter
          // === 'all') means no goal selected → curated top picks across all
          // goals. Clicking a pill filters; clicking the same active pill
          // again deselects back to top picks. 2026-05-31 per Jenni: removes
          // the "All vs. a goal" visual ambiguity entirely.
          const picksActionFilters = [
            { id: 'repair', label: 'Barrier', hint: 'repair + resilience' },
            { id: 'calm', label: 'Calm', hint: 'soothe reactivity' },
            { id: 'hydrate', label: 'Hydration', hint: 'water + cushion' },
            { id: 'brighten', label: 'Pigment', hint: 'tone support' },
            { id: 'exfoliate', label: 'Texture', hint: 'smooth + decongest' },
          ];
          const NO_PICK_CONCERN = '__none__';
          const picksConcernActive = (c) => !matchesActiveConcerns.has(NO_PICK_CONCERN) && (matchesActiveConcerns.size === 0 || matchesActiveConcerns.has(String(c || '').toLowerCase()));
          const togglePicksConcern = (concern) => {
            const k = String(concern || '').toLowerCase();
            setMatchesActiveConcerns(prev => {
              const next = prev.has(NO_PICK_CONCERN)
                ? new Set()
                : prev.size === 0
                  ? new Set((userConcerns || []).map(c => String(c || '').toLowerCase()))
                  : new Set(prev);
              if (next.has(k)) next.delete(k); else next.add(k);
              if (next.size === 0) next.add(NO_PICK_CONCERN);
              return next;
            });
          };
          const suggestedHaystackForProduct = (p) => [p.name, p.brand, p.category, p.actives, p.activeIngredients, p.main, p.mainIngredients, ...(p.tags || []), ...(p.concerns || [])].filter(Boolean).join(' ').toLowerCase();
          const suggestedTagsForProduct = (p) => {
            const text = suggestedHaystackForProduct(p);
            const tags = [];
            if (/ceramide|barrier|cicaplast|atobarrier|lipid|panthenol|madecassoside|balm|cream|recovery/.test(text)) tags.push('repair');
            if (/centella|cica|calm|soothing|sensitive|madecassoside|azelaic|mugwort|heartleaf/.test(text)) tags.push('calm');
            if (/hyaluronic|hydrate|hydrating|glycerin|snail|essence|lotion|humectant|toner/.test(text)) tags.push('hydrate');
            if (/vitamin c|ascorbic|niacinamide|bright|pigment|arbutin|tranexamic|kojic|tone|discoloration/.test(text)) tags.push('brighten');
            if (/salicylic|bha|glycolic|lactic|aha|retinol|retinal|adapalene|texture|exfoliat|pore/.test(text)) tags.push('exfoliate');
            return [...new Set(tags)];
          };
          const suggestedConcernHitsForProduct = (p) => {
            const hay = suggestedHaystackForProduct(p);
            const activeConcerns = matchesActiveConcerns.has(NO_PICK_CONCERN)
              ? new Set()
              : matchesActiveConcerns.size === 0
                ? new Set((userConcerns || []).map(c => String(c || '').toLowerCase()))
                : matchesActiveConcerns;
            return [...activeConcerns].filter(c => {
              if (!c) return false;
              if (hay.includes(c)) return true;
              if (/redness|flush|sensitive|irritation/.test(c) && /redness|sensitive|calm|soothing|centella|azelaic|cica|madecassoside/.test(hay)) return true;
              if (/dry|dryness|dehydration/.test(c) && /hyaluronic|hydrate|hydrating|glycerin|snail|ceramide|barrier|cream|lotion/.test(hay)) return true;
              if (/acne|breakout|blemish|congestion/.test(c) && /salicylic|bha|adapalene|benzoyl|azelaic|retinol|pore|blemish/.test(hay)) return true;
              if (/pore|enlarged pores/.test(c) && /pore|salicylic|bha|niacinamide|retinol|retinal|texture/.test(hay)) return true;
              if (/texture|rough|bump/.test(c) && /texture|exfoliat|lactic|glycolic|retinol|retinal|aha|bha/.test(hay)) return true;
              if (/pigment|dark spot|melasma|tone/.test(c) && /pigment|bright|vitamin c|ascorbic|niacinamide|tranexamic|arbutin|kojic|tone/.test(hay)) return true;
              return false;
            });
          };
          const suggestedScoreFor = (p) => {
            const tags = suggestedTagsForProduct(p);
            const concernHits = suggestedConcernHitsForProduct(p);
            let score = 0;
            const priority = typeof getBrandPriority === 'function' ? getBrandPriority(p.brand) : 3;
            if (priority === 1) score += 28;
            else if (priority === 2) score += 16;
            if (p.hero === true) score += 10;
            if (picksActionFilter !== 'all' && tags.includes(picksActionFilter)) score += 30;
            score += concernHits.length * 18;
            return score + tags.length;
          };
          const picksSeedHash = (p) => {
            const text = `${picksSuggestSeed}|${p.brand || ''}|${p.name || ''}`;
            let h = 2166136261;
            for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619);
            return (h >>> 0) / 0xffffffff;
          };
          const pickMatchesCurrentFilters = (p) => p._tags.length > 0
            && (picksActionFilter === 'all' || p._tags.includes(picksActionFilter))
            && (matchesActiveConcerns.has(NO_PICK_CONCERN) || matchesActiveConcerns.size === 0 || p._concernHits.length > 0);
          const sortSuggestedMatches = (a, b) => {
            if (a._source !== b._source) return a._source === 'shelf' ? -1 : 1;
            const scoreBand = Math.round((b._score || 0) / 5) - Math.round((a._score || 0) / 5);
            if (scoreBand !== 0) return scoreBand;
            return (a._tie || 0) - (b._tie || 0);
          };
          // Suggestions view (May 31 2026 per Jenni):
          //   Section 1 — "From your shelf": owned shelf items (activeProducts)
          //   that match the goal + concerns, scored by relevance.
          //   Section 2 — "Worth considering": POPULAR_PRODUCTS catalog
          //   filtered to gap-closers only (catalog item is skipped if user
          //   already owns something in the same productCategory + active
          //   family, e.g. niacinamide serum overlap).
          const shelfBaseForSuggestions = activeProductsForBudget;
          // Top picks cap (2026-05-31 per Jenni): tightened from 6 → 2
          // per section so Suggestions reads as a curated short list
          // (2 shelf + 2 non-shelf = 4 total) rather than a long catalog.
          //
          // Refresh fix (2026-05-31 v2): previously the refresh button
          // only shuffled ties within a score band, so highest-scoring
          // items stayed put and users saw no rotation. Now: keep #1
          // anchored (highest score) and random-pick #2 from the next
          // 4 candidates using picksSeedHash. Real variety on tap.
          // T2 (May 31 2026): map filter chip id → expected priceTier symbol.
          // 'all' is a pass-through; budget/mid/luxury → $/$$/$$$. The chip
          // strip below the action goals applies this filter to BOTH the
          // shelf and catalog pools used by the Suggestions view.
          const picksBudgetFilterSymbol = picksBudgetFilter === 'budget' ? '$'
            : picksBudgetFilter === 'mid' ? '$$'
            : picksBudgetFilter === 'luxury' ? '$$$'
            : null;
          const matchesBudgetFilter = (p) => {
            if (!picksBudgetFilterSymbol) return true;
            return String(p.priceTier || '').trim() === picksBudgetFilterSymbol;
          };
          const shelfCandidatePool = shelfBaseForSuggestions
            .map(p => ({ ...p, _source: 'shelf', _tags: suggestedTagsForProduct(p), _concernHits: suggestedConcernHitsForProduct(p), _score: suggestedScoreFor(p) + 18, _tie: picksSeedHash(p) }))
            .filter(pickMatchesCurrentFilters)
            .filter(matchesBudgetFilter)
            .sort(sortSuggestedMatches)
            .slice(0, 5);
          const shelfSuggestedMatchesInline = shelfCandidatePool.length <= 2
            ? shelfCandidatePool
            : [
                shelfCandidatePool[0],
                ...shelfCandidatePool.slice(1).sort((a, b) => picksSeedHash(a) - picksSeedHash(b)).slice(0, 1),
              ];
          // Compute "shelf coverage signature": for each owned shelf product,
          // capture (productBudgetFamily + active family) so we can suppress
          // any catalog item that fills the same slot.
          const shelfCoverageSignatures = new Set();
          (shelfBaseForSuggestions || []).forEach(sp => {
            const fam = productBudgetFamily(sp);
            const active = overlapFamilyForProduct(sp);
            shelfCoverageSignatures.add(`${fam}|${active}`);
            // Also flag by just the active family so a niacinamide serum on
            // shelf suppresses other niacinamide serums regardless of cat.
            if (active && active !== 'other') shelfCoverageSignatures.add(`*|${active}`);
          });
          const catalogClosesGap = (p) => {
            const fam = productBudgetFamily(p);
            const active = overlapFamilyForProduct(p);
            if (shelfCoverageSignatures.has(`${fam}|${active}`)) return false;
            if (active && active !== 'other' && shelfCoverageSignatures.has(`*|${active}`)) return false;
            return true;
          };
          // Same refresh-anchor pattern as shelf side: top #1 stays,
          // #2 rotates among next 4 candidates on every seed bump.
          const buyCandidatePool = (POPULAR_PRODUCTS || [])
            .map(p => ({ ...p, _source: 'buy', _tags: suggestedTagsForProduct(p), _concernHits: suggestedConcernHitsForProduct(p), _score: suggestedScoreFor(p), _tie: picksSeedHash(p) }))
            .filter(pickMatchesCurrentFilters)
            .filter(matchesBudgetFilter)
            .filter(p => !isOnShelf(p))
            .filter(catalogClosesGap)
            .sort(sortSuggestedMatches)
            .slice(0, 5);
          const buySuggestedMatchesInline = buyCandidatePool.length <= 2
            ? buyCandidatePool
            : [
                buyCandidatePool[0],
                ...buyCandidatePool.slice(1).sort((a, b) => picksSeedHash(a) - picksSeedHash(b)).slice(0, 1),
              ];
          // T1 (May 31 2026): Budget candidate pool — drugstore-tier ($)
          // catalog items scored with the same suggestedScoreFor helper
          // used by the Suggestions view. We do NOT apply the
          // catalogClosesGap filter here because the Budget tab is a
          // distinct lens ("what cheap option fits my goal?") that should
          // surface even when shelf already covers the slot — that is the
          // point of the swap conversation.
          const budgetCandidatePool = (POPULAR_PRODUCTS || [])
            .filter(p => String(p.priceTier || '').trim() === '$')
            .map(p => ({ ...p, _source: 'budget', _tags: suggestedTagsForProduct(p), _concernHits: suggestedConcernHitsForProduct(p), _score: suggestedScoreFor(p), _tie: picksSeedHash(p) }))
            .filter(pickMatchesCurrentFilters)
            .sort(sortSuggestedMatches);
          const budgetSuggestedMatchesInline = budgetCandidatePool.slice(0, 8);
          // T1 (May 31 2026): picksViewOptions declared here so the Budget
          // count reflects the actual pool length.
          const picksViewOptions = [
            { id: 'suggestions', label: 'Suggestions', count: null },
            { id: 'bench', label: 'Bench', count: benchCount },
            { id: 'budget', label: 'Budget', count: budgetSuggestedMatchesInline.length },
            { id: 'regimen', label: 'Regimen', count: builtProductsForBudget.length || activeProductsForBudget.length },
          ];
          // Kept for back-compat callers; not used by the new sectioned view.
          const suggestedMatchesInline = [...shelfSuggestedMatchesInline, ...buySuggestedMatchesInline]
            .sort(sortSuggestedMatches)
            .slice(0, 8);
          const recentInsightLogs = [...(logs || [])]
            .filter(Boolean)
            .sort((a, b) => new Date(b.date || b.createdAt || 0) - new Date(a.date || a.createdAt || 0));
          const signalPhotoLogs = recentInsightLogs.filter(l => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:')));
          const signalTitleCase = (w) => w ? String(w).charAt(0).toUpperCase() + String(w).slice(1).toLowerCase() : '';
          const signalConcernName = (c) => String(c || '').replace(/-/g, ' ');
          const signalConcernCount = {};
          recentInsightLogs.slice(0, 60).forEach(l => {
            (Array.isArray(l.concerns) ? l.concerns : []).forEach(c => {
              const k = String(c || '').trim().toLowerCase();
              if (k) signalConcernCount[k] = (signalConcernCount[k] || 0) + 1;
            });
            const m = l.metricSnapshot || {};
            if (m.redness && /moderate|high/i.test(m.redness)) signalConcernCount.redness = (signalConcernCount.redness || 0) + 1;
            if (m.hydration && /dry|parched/i.test(m.hydration)) signalConcernCount.dryness = (signalConcernCount.dryness || 0) + 1;
            if (m.texture && /uneven|rough|bumpy/i.test(m.texture)) signalConcernCount.texture = (signalConcernCount.texture || 0) + 1;
            if (m.breakouts && /some|many|severe/i.test(m.breakouts)) signalConcernCount.breakouts = (signalConcernCount.breakouts || 0) + 1;
            if (m.barrier && /compromised|stripped/i.test(m.barrier)) signalConcernCount.barrier = (signalConcernCount.barrier || 0) + 1;
            if (m.sensitivity && /reactive|inflamed|tender/i.test(m.sensitivity)) signalConcernCount.sensitivity = (signalConcernCount.sensitivity || 0) + 1;
          });
          const signalTopConcerns = Object.entries(signalConcernCount)
            .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
            .slice(0, 3);
          const signalProductResponse = (products || []).filter(p => p.startDate).map(p => {
            const start = new Date(p.startDate);
            const before = recentInsightLogs.filter(l => {
              const d = new Date(l.date || l.createdAt || 0);
              return d < start && (start - d) <= 14 * 86400000 && l.rating != null;
            });
            const after = recentInsightLogs.filter(l => {
              const d = new Date(l.date || l.createdAt || 0);
              return d >= start && (d - start) <= 14 * 86400000 && l.rating != null;
            });
            if (before.length < 1 || after.length < 1) return null;
            const beforeAvg = before.reduce((sum, l) => sum + Number(l.rating), 0) / before.length;
            const afterAvg = after.reduce((sum, l) => sum + Number(l.rating), 0) / after.length;
            return { product: p, delta: afterAvg - beforeAvg, before: beforeAvg, after: afterAvg };
          }).filter(Boolean);
          const signalResponders = [...signalProductResponse].sort((a, b) => b.delta - a.delta).filter(r => r.delta > 0.4).slice(0, 3);
          const signalWatchers = [...signalProductResponse].sort((a, b) => a.delta - b.delta).filter(r => r.delta < -0.4).slice(0, 3);
          const signalDataPointCount = recentInsightLogs.length;
          const signalEnoughObjectiveData = signalDataPointCount >= 5;
          const signalConcernInterpretation = (concern, n) => {
            const c = String(concern || '').toLowerCase();
            if (/redness|sensitivity|barrier/.test(c)) return 'Treat as irritation load before adding stronger actives.';
            if (/dry|hydration/.test(c)) return 'Hydration needs its own support lane.';
            if (/breakout|acne|pore|texture/.test(c)) return 'Pick one smoothing or clarifying lane.';
            if (/pigment|tone|dark/.test(c)) return 'SPF consistency plus one brightening lane.';
            return n >= 5 ? 'Repeating enough to guide the next move.' : 'Watch for one more repeat before changing routine.';
          };
          const signalConcernPlanFor = (concern, n = 0) => {
            const c = String(concern || '').toLowerCase();
            if (/redness|sensitivity|barrier/.test(c)) return {
              concern: /barrier/.test(c) ? 'dryness' : 'redness',
              action: /barrier/.test(c) ? 'repair' : 'calm',
              eyebrow: /barrier/.test(c) ? 'Barrier read' : 'Redness read',
              title: /barrier/.test(c) ? 'Barrier stress is showing up.' : 'Redness is showing up.',
              read: n <= 1 ? 'One flag is still early, but it is worth treating as an irritation-load clue.' : 'This looks less like a “stronger active” problem and more like the week may need calmer support.',
              why: 'Before adding retinoids, acids, or acne steps, check cleansing intensity, active stacking, and whether the routine has a real recovery layer.',
              next: 'Start with a shelf product that calms or repairs. If your shelf is thin, compare calm/barrier matches.'
            };
            if (/dry|hydration/.test(c)) return {
              concern: 'dryness',
              action: 'hydrate',
              eyebrow: 'Hydration read',
              title: 'Dryness needs a dedicated lane.',
              read: n <= 1 ? 'One dry reading is early, but it is useful because hydration is easy to test cleanly.' : 'Dryness repeating usually means the routine needs water-binding support, not just another heavy cream.',
              why: 'Humectants, panthenol, ceramides, and a better seal help more than stacking extra treatment steps.',
              next: 'Try a hydrator or barrier layer from your shelf first, then compare outside hydration matches only if there is a gap.'
            };
            if (/breakout|acne|pore|texture/.test(c)) return {
              concern: /pore/.test(c) ? 'enlarged pores' : (/breakout|acne/.test(c) ? 'acne' : 'texture'),
              action: 'exfoliate',
              eyebrow: /pore/.test(c) ? 'Pore read' : (/breakout|acne/.test(c) ? 'Breakout read' : 'Texture read'),
              title: /pore/.test(c) ? 'Pores are repeating.' : (/breakout|acne/.test(c) ? 'Breakouts need one clear lane.' : 'Texture needs one smoothing lane.'),
              read: 'This is actionable, but the risk is over-correcting with too many exfoliating or turnover steps at once.',
              why: 'BHA, retinoids, azelaic acid, and exfoliating acids can all help different versions of this signal. Pick one lane and protect recovery nights.',
              next: 'Look for an owned product that already covers the lane, then compare suggested matches if nothing fits.'
            };
            if (/pigment|tone|dark/.test(c)) return {
              concern: 'pigment',
              action: 'brighten',
              eyebrow: 'Pigment read',
              title: 'Pigment support starts with SPF.',
              read: 'Dark marks respond slowly, so this signal needs consistency more than a crowded brightening stack.',
              why: 'Vitamin C, niacinamide, tranexamic acid, and arbutin only pay off if daily SPF is locked in.',
              next: 'Check SPF consistency and one brightening lane from your shelf before buying another serum.'
            };
            return {
              concern: c || 'redness',
              action: 'all',
              eyebrow: 'Signal read',
              title: n >= 3 ? 'This pattern is worth acting on.' : 'This is still early signal.',
              read: n >= 3 ? 'There is enough repetition to choose a small weekly adjustment.' : 'Keep logging before making a big routine change.',
              why: 'Signals are most useful when they connect repeated observations to one controlled change.',
              next: 'Compare shelf options first, then outside matches if the shelf has a gap.'
            };
          };
          const signalPrimaryConcernEntry = signalTopConcerns[0] || null;
          const signalPrimaryPlan = signalPrimaryConcernEntry ? signalConcernPlanFor(signalPrimaryConcernEntry[0], signalPrimaryConcernEntry[1]) : null;
          const openMatchesForSignal = (concern, action = 'all') => {
            setPearlsTab('picks');
            setPicksView('suggestions');
            setPicksActionFilter(action || 'all');
            if (concern) setMatchesActiveConcerns(new Set([String(concern || '').toLowerCase()]));
            setPicksSuggestSeed(seed => seed + 1);
          };
          // === PRODUCT-AWARE INTERPRETATION (May 31 2026 per Jenni) ===
          // Pulls in the product's actives, evidence tier, and concurrent
          // shelf load so the interpretation says something specific to THIS
          // product instead of templated "do not panic" copy across the board.
          const extractActives = (p) => {
            const raw = (p && (p.activeIngredients || p.actives || p.tags?.join(' ')) || '').toLowerCase();
            const hits = [];
            const fam = (lbl, pat) => { if (pat.test(raw)) hits.push(lbl); };
            fam('vitamin C', /vit.?c|ascorb|sap|map|3-o-ethyl/);
            fam('retinoid', /retin|tret|tazaro|adapal|bakuchiol/);
            fam('AHA', /glycolic|lactic|mandelic|aha/);
            fam('BHA', /salicylic|bha\b/);
            fam('niacinamide', /niacinam/);
            fam('peptide', /peptide|matrixyl|copper trip|snap-8/);
            fam('azelaic', /azelaic/);
            fam('tranexamic', /tranexam/);
            fam('benzoyl peroxide', /benzoyl|bpo\b/);
            fam('vit E + ferulic', /ferul.*tocoph|tocoph.*ferul|vit.?e.*ferul|ferul.*vit.?e/);
            return hits;
          };
          const overlapActiveLoad = (target, allProducts) => {
            const targetActs = new Set(extractActives(target));
            if (targetActs.size === 0) return null;
            const others = (allProducts || [])
              .filter(p => p && p.id !== target.id && !p.endDate)
              .map(p => ({ name: p.name, actives: extractActives(p) }))
              .filter(o => o.actives.some(a => targetActs.has(a)));
            if (others.length === 0) return null;
            // Pick the strongest overlap (retinoid > AHA > BHA > others)
            const strongest = others.find(o => o.actives.includes('retinoid'))
              || others.find(o => o.actives.includes('AHA'))
              || others.find(o => o.actives.includes('BHA'))
              || others[0];
            return strongest ? strongest.name : null;
          };
          const responderInterpretation = (r) => {
            const p = r.product || {};
            const actives = extractActives(p);
            const family = actives[0] || (p.category || '').toLowerCase();
            const dermLine = p.derm_endorsement ? ` ${p.derm_endorsement} flagged this class as a solid pick.` : '';
            if (r.delta > 1.5) {
              return `Strong positive signal${family ? ` — ${family} is doing real work` : ''}.${dermLine} Keep using; recheck at 30 days.`;
            }
            if (r.delta > 1) {
              return `Likely contributor${family ? ` (${family})` : ''}. Hold the variable steady for 2 weeks before crediting it.`;
            }
            return `Useful pairing${family ? ` (${family})` : ''}. Track another 7-10 days before calling it.`;
          };
          const watcherInterpretation = (r, allProducts) => {
            const p = r.product || {};
            const actives = extractActives(p);
            const family = actives[0] || (p.category || '').toLowerCase();
            const stacked = overlapActiveLoad(p, allProducts);
