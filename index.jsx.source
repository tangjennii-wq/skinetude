              if (stacked) return `${family ? family.charAt(0).toUpperCase() + family.slice(1) + ' s' : 'S'}tacked with ${stacked} — that overlap may be the culprit. Try alternating nights.`;
              return `${family ? family.charAt(0).toUpperCase() + family.slice(1) + ' may be too much' : 'Too much load'} — drop frequency to 2–3×/wk before pulling.`;
            }
            if (stacked) return `Active overlap with ${stacked}. Space them apart or alternate nights before judging.`;
            return `${family ? family.charAt(0).toUpperCase() + family.slice(1) + ': mild dip' : 'Mild dip'}, worth a re-look. Check what else changed that week.`;
          };
          const insightConcernLabels = {
            repair: 'Barrier',
            calm: 'Redness',
            hydrate: 'Hydration',
            clarify: 'Breakouts',
            pigment: 'Pigment',
            texture: 'Texture',
          };
          const insightConcernTally = {};
          recentInsightLogs.slice(0, 30).forEach(l => {
            (Array.isArray(l.concerns) ? l.concerns : []).forEach(c => {
              const k = String(c || '').trim();
              if (k) insightConcernTally[k] = (insightConcernTally[k] || 0) + 1;
            });
            const m = l.metricSnapshot || {};
            if (m.barrier && /compromised|stripped/i.test(m.barrier)) insightConcernTally.repair = (insightConcernTally.repair || 0) + 1;
            if ((m.sensitivity && /reactive|inflamed/i.test(m.sensitivity)) || (m.redness && /moderate|high/i.test(m.redness))) insightConcernTally.calm = (insightConcernTally.calm || 0) + 1;
            if (m.hydration && /dry|parched/i.test(m.hydration)) insightConcernTally.hydrate = (insightConcernTally.hydrate || 0) + 1;
            if (m.breakouts && /many|severe/i.test(m.breakouts)) insightConcernTally.clarify = (insightConcernTally.clarify || 0) + 1;
          });
          const topInsightConcern = Object.entries(insightConcernTally).sort((a, b) => b[1] - a[1])[0];
          const topInsightConcernLabel = topInsightConcern
