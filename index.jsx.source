// === LOCAL PRODUCT DATABASE ===
// Seed list of ~100 popular skincare products across K-beauty, drugstore,
// mid-range, and luxury. Used by the Add Product typeahead for INSTANT
// matches with zero API calls. Falls back to Claude search only when no
// local match. Keep entries terse — each adds bytes to the bundle.
//
// Field shape matches what Claude's search prompt returns so they're
// interchangeable downstream: { name, brand, category, actives, main, tags, concerns }
//
// To extend: run scripts/generate_products.js with your Anthropic key and a
// list of brands you want added — it appends new entries here. See
// scripts/generate_products.js for the prompt + format.
// === BRAND TIER + POPULARITY MAP (May 2026 — recommendations pass) ===
//
// Two-dimensional classification used by the recommender:
//   tier:  'drugstore' | 'midrange' | 'prestige'   (budget filter)
//   popular: true | false                          (whether to surface as a pick)
//
// "Popular" means the brand has cult-level recognition + sustained press +
// widespread availability — the kind a derm would name first when asked
// "where would I get a good ___?" Niche-but-respected brands (e.g. small
// indie K-beauty, specialty European pharmacy) stay in POPULAR_PRODUCTS so
// brand search still finds them, but they're NOT proactively suggested.
//
// Anything not in this map defaults to { tier:'midrange', popular:false }.
// To raise visibility for a niche brand, flip `popular` to true.

// Lookup helper. Default: midrange + not-popular (so unknown brands
// don't accidentally get recommended).
const getBrandRecInfo = (brand) => {
  if (!brand) return { tier: 'midrange', popular: false };
  return BRAND_RECOMMENDATION_INFO[brand] || { tier: 'midrange', popular: false };
};

// Per-product helpers — read brand info off each catalog entry.
const productTier = (p) => getBrandRecInfo(p && p.brand).tier;
const productIsRecommendableBrand = (p) => getBrandRecInfo(p && p.brand).popular;




