// === HOME DEVICE SCHEDULES (May 2026 — derm pass) ===
//
// Each device has a recommended cadence + slot + interaction rules with
// active ingredients. Used by:
//   - generateBuildPlan to mark "no actives" days for invasive devices
//     (microneedling, dermaplane) so the actives loop avoids them.
//   - Today/Cover surfaces to remind the user which device to use today.
//
// `avoid`: family list. When this device is scheduled on a day, those
//   active families should NOT be scheduled that night (they'd irritate
//   freshly-needled or freshly-dermaplaned skin). Microneedling is the
//   strictest — no exfoliants, retinoids, or Vit C for 24h.
// `recoveryAfter`: days following a use that should also stay calm.
//   E.g., dermaplane uses a 1-day recovery to avoid Sunday-morning
//   irritation after Saturday's session.
const HOME_DEVICE_SCHEDULES = {
  'led-mask':       { label: 'LED red light mask',    days: [0,1,2,3,4,5,6], slot: 'pm', avoid: [],                                       recoveryAfter: 0 },
  'led-eye':        { label: 'LED red light eye mask',days: [0,1,2,3,4,5,6], slot: 'pm', avoid: [],                                       recoveryAfter: 0 },
  'microneedling':  { label: 'Home microneedling',    days: [3],             slot: 'pm', avoid: ['retinoid','aha','bha','bpo','vitc'],   recoveryAfter: 1 },
  'microcurrent':   { label: 'Microcurrent',          days: [1,2,3,4,5],     slot: 'am', avoid: [],                                       recoveryAfter: 0 },
  'high-frequency': { label: 'High-frequency wand',   days: [1,4],           slot: 'pm', avoid: [],                                       recoveryAfter: 0 },
  'ice-roller':     { label: 'Ice roller',            days: [0,1,2,3,4,5,6], slot: 'am', avoid: [],                                       recoveryAfter: 0 },
  'gua-sha':        { label: 'Gua sha',               days: [0,1,2,3,4,5,6], slot: 'pm', avoid: [],                                       recoveryAfter: 0 },
  'dermaplane':     { label: 'Dermaplane',            days: [6],             slot: 'pm', avoid: ['retinoid','aha','bha','bpo','vitc'],   recoveryAfter: 1 },
};

// Compute which days of the week each owned device occupies + which days
// must be kept "calm" (avoid families). Returns an array of
// { device, label, day, slot, avoid } entries — one per (device × day).
const computeDeviceOccupancy = (ownedDeviceIds) => {
  const out = [];
  for (const id of (ownedDeviceIds || [])) {
    const sched = HOME_DEVICE_SCHEDULES[id];
    if (!sched) continue;
    for (const d of sched.days) {
      out.push({ device: id, label: sched.label, day: d, slot: sched.slot, avoid: sched.avoid, recoveryAfter: sched.recoveryAfter });
      // Mark recovery days: same avoid list, no device label
      if (sched.recoveryAfter > 0 && sched.avoid.length > 0) {
        for (let r = 1; r <= sched.recoveryAfter; r++) {
          const recDay = (d + r) % 7;
          out.push({ device: id, label: `${sched.label} recovery`, day: recDay, slot: sched.slot, avoid: sched.avoid, isRecovery: true });
        }
      }
    }
  }
  return out;
};

// "Which families must this day avoid?" — union of avoid lists from any
// device or recovery occupying this day. Used by generateBuildPlan to
// teach suggestScheduleDays that this day is off-limits for those actives.
const getDeviceAvoidsForDay = (occupancy, day) => {
  const avoid = new Set();
  for (const o of occupancy) {
    if (o.day !== day) continue;
    o.avoid.forEach(f => avoid.add(f));
  }
  return avoid;
};

// "Which devices are scheduled today?" — used by Today/Cover reminders.
// Returns array of { id, label, slot, isRecovery? }.
const getDevicesForDay = (ownedDeviceIds, day) => {
  const out = [];
  for (const id of (ownedDeviceIds || [])) {
    const sched = HOME_DEVICE_SCHEDULES[id];
    if (!sched) continue;
    if (sched.days.includes(day)) {
      out.push({ id, label: sched.label, slot: sched.slot, isRecovery: false });
    }
  }
  return out;
};

const lookupSynergy = (famA, famB) => {
  if (!famA || !famB || famA === famB) return null;
  for (const s of ACTIVE_SYNERGIES) {
    if ((s.pair[0] === famA && s.pair[1] === famB) ||
        (s.pair[0] === famB && s.pair[1] === famA)) return s;
  }
  return null;
};

// Find all unique synergies present across a list of families (e.g. all
// families used this week, or just today's PM). Returns a deduped list.
const findSynergiesInFamilies = (families) => {
  if (!families || families.length === 0) return [];
  const found = [];
  const seenKeys = new Set();
  const list = Array.from(new Set(families));
  for (let i = 0; i < list.length; i++) {
    for (let j = i + 1; j < list.length; j++) {
      const s = lookupSynergy(list[i], list[j]);
      if (!s) continue;
      const key = [...s.pair].sort().join('|');
      if (seenKeys.has(key)) continue;
      seenKeys.add(key);
      found.push(s);
    }
  }
  return found;
};

// === DAY-DISTRIBUTION TABLE ===
// Standard clinical spacing patterns by frequency-per-week. Indexed 0=Sun..6=Sat.
// "M/W/F" = indices [1,3,5]. Patterns chosen for even gap distribution.
const DEFAULT_DAY_PATTERNS = {
  1: [0],            // 1x → Sunday (lowest-load day)
  2: [1, 4],         // 2x → Mon/Thu (3-day gap)
  3: [1, 3, 5],      // 3x → M/W/F
  4: [1, 3, 5, 0],   // 4x → M/W/F + Sun
  5: [1, 2, 3, 4, 5],// 5x → weekdays
  6: [1, 2, 3, 4, 5, 6], // 6x → skip Sunday
  7: [0, 1, 2, 3, 4, 5, 6], // 7x → daily
};

// Alternate offset pattern when primary conflicts with existing schedule.
const OFFSET_DAY_PATTERNS = {
  2: [2, 5],         // T/F
  3: [2, 4, 6],      // T/Th/Sat
  4: [2, 4, 6, 1],   // T/Th/Sat/M
};

// === SUGGEST DAYS ===
// Given a new product's active family, target frequency, and the existing
// weekly pattern, return { days, explanation, conflicts }.
//   days: array of day indices (0-6) recommended for this active
//   explanation: human-readable reasoning string
//   conflicts: any HARD conflicts that couldn't be avoided (rare)
//
// Algorithm:
//   1. Build existingByDay = day → list of active families scheduled that day
//   2. Try primary pattern. Count HARD conflicts per day.
//   3. If conflicts exist, try offset pattern. Pick whichever has fewer conflicts.
//   4. Build explanation string naming the rule that fired (retinoid avoidance,
//      friendly pair, even distribution, etc.).
const suggestScheduleDays = ({ newActiveFamily, frequency, existingPattern, avoidDays }) => {
  const freq = Math.max(1, Math.min(7, frequency || 3));
  // existingPattern: { 0: [family,...], 1: [family,...], ... } day → families
  // avoidDays: optional Set<number> — days the new family must NOT land on
  //   (e.g. microneedling/dermaplane recovery days for the strong actives).
  //   Treated as a hard-conflict equivalent.
  const existing = existingPattern || {};
  const avoid = avoidDays || new Set();
  const hasConflictOn = (day) => {
    if (avoid.has(day)) return { tier: 'hard', note: 'Device cadence — keep this day calm.' };
    const fams = existing[day] || [];
    for (const f of fams) {
      const c = lookupConflict(newActiveFamily, f);
      if (c && c.tier === 'hard') return c;
    }
    return null;
  };
  const hasFriendlyOn = (day) => {
    const fams = existing[day] || [];
    for (const f of fams) {
      const c = lookupConflict(newActiveFamily, f);
      if (c && c.tier === 'friendly') return c;
    }
    return null;
  };
  // === SYNERGY BIAS (May 2026 — derm pass) ===
  // Count days where a synergistic partner is already scheduled. Used as
  // a tie-breaker in pattern selection — we'd rather land the new active
  // ON a day that already has its synergistic partner (so they show up
  // together on the routine). Doesn't override conflict logic.
  const hasSynergyOn = (day) => {
    const fams = existing[day] || [];
    for (const f of fams) {
      const s = lookupSynergy(newActiveFamily, f);
      if (s) return s;
    }
    return null;
  };
  const score = (pattern) => {
    let hardHits = 0;
    let friendlyHits = 0;
    let synergyHits = 0;
    for (const d of pattern) {
      if (hasConflictOn(d)) hardHits++;
      if (hasFriendlyOn(d)) friendlyHits++;
      if (hasSynergyOn(d)) synergyHits++;
    }
    return { hardHits, friendlyHits, synergyHits };
  };
  const primary = DEFAULT_DAY_PATTERNS[freq] || DEFAULT_DAY_PATTERNS[3];
  const offset = OFFSET_DAY_PATTERNS[freq] || null;
  const pScore = score(primary);
  const oScore = offset ? score(offset) : null;
  // Pick pattern: prefer the one with fewer hard conflicts; tie-break by
  // synergy count (more synergistic pairings = better) and then friendly.
  // Synergies outrank friendly because synergy implies actual co-benefit
  // (collagen, barrier, brightening), while friendly just means "won't fight."
  let chosen = primary;
  let chosenScore = pScore;
  let usedOffset = false;
  if (oScore) {
    const oBetter =
      oScore.hardHits < pScore.hardHits ||
      (oScore.hardHits === pScore.hardHits && oScore.synergyHits > pScore.synergyHits) ||
      (oScore.hardHits === pScore.hardHits && oScore.synergyHits === pScore.synergyHits && oScore.friendlyHits > pScore.friendlyHits);
    if (oBetter) {
      chosen = offset;
      chosenScore = oScore;
      usedOffset = true;
    }
  }
  // === SMART RATIONALE GENERATOR (May 2026) ===
  // Builds a short, clinically intelligent observation tied to the actual
  // cadence + family relationships. Replaces generic phrases like
  // "pairs cleanly with what's already in your routine."
  // Tone: Apple Health + Aesop + derm planning notes. Concise, low-weight.
  const dayLabels = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const chosenLabels = chosen.map(d => dayLabels[d]).join('/');
  const buildSmartRationale = (fam, days, existingPattern) => {
    const numDays = days.length;
    const sortedDays = [...days].sort((a,b) => a-b);
    // Pattern shape detection
    const isAltPattern = sortedDays.length >= 2 && sortedDays.every((d, i) => i === 0 || (d - sortedDays[i-1]) === 2);
    const isWeekdayOnly = sortedDays.every(d => d >= 1 && d <= 5);
    // Inspect rest-of-week for neighboring families
    const allFams = new Set();
    for (let d = 0; d < 7; d++) {
      (existingPattern?.[d] || []).forEach(f => allFams.add(f));
    }
    const hasExfoliant = allFams.has('aha') || allFams.has('bha');
    const hasRetinoid = allFams.has('retinoid');
    const hasSPF = allFams.has('spf');
    // Family-specific phrasing (matches Jenni's spec — Apple Health voice)
    if (fam === 'retinoid') {
      if (hasExfoliant) return 'spaced from exfoliation nights';
      if (isAltPattern) return 'alternated to minimize irritation';
      if (numDays === 1) return 'reserved for a buffered night';
      return 'distributed for barrier recovery';
    }
    if (fam === 'aha' || fam === 'bha') {
      if (numDays === 1) return 'kept to one exfoliation night';
      if (isAltPattern) return 'spaced evenly for recovery time';
      if (hasRetinoid) return 'kept on non-retinoid nights';
      return 'spaced between recovery nights';
    }
    if (fam === 'vitc') {
      if (hasSPF) return 'stacked with SPF for UV synergy';
      if (isWeekdayOnly) return 'kept to weekday mornings';
      return 'kept to mornings';
    }
    if (fam === 'azelaic') {
      if (hasRetinoid) return 'alternated with retinoid nights';
      if (isAltPattern) return 'evenly spaced for pigmentation support';
      return 'distributed for pigmentation cadence';
    }
    if (fam === 'niacinamide') {
      if (numDays === 7) return 'stacks safely across the week';
      return 'distributed evenly for barrier support';
    }
    if (fam === 'arbutin' || fam === 'tranexamic' || fam === 'kojic') {
      return 'optimized for pigmentation cadence';
    }
    if (fam === 'peptide') return 'distributed for collagen support';
    if (fam === 'ceramide') {
      if (numDays === 7) return 'supports nightly barrier recovery';
      return 'buffered after active nights';
    }
    if (fam === 'panthenol') return 'supports barrier recovery';
    if (fam === 'bakuchiol') return 'gentle retinoid cadence, spaced daily';
    if (fam === 'bpo') return 'spot-targeted, kept low-impact';
    if (fam === 'centella') return 'calming support across the week';
    if (fam === 'humectant') return 'stacked with hydration support';
    if (fam === 'spf') return 'daily UV protection, AM anchored';
    // Frequency fallback when family is unclear
    if (numDays === 1) return 'kept to one focused day';
    if (numDays === 7) return 'distributed daily';
    if (isAltPattern) return 'spaced evenly for recovery time';
    if (isWeekdayOnly) return 'weekday cadence';
    return 'distributed evenly across the week';
  };
  let explanation = '';
  if (usedOffset && newActiveFamily) {
    // Conflict-avoidance copy (kept — it names the specific conflict)
    const conflictWith = [];
    for (let d = 0; d < 7; d++) {
      const fams = existing[d] || [];
      for (const f of fams) {
        const c = lookupConflict(newActiveFamily, f);
        if (c && c.tier === 'hard' && !conflictWith.includes(f)) conflictWith.push(f);
      }
    }
    if (conflictWith.length > 0) {
      explanation = `${chosenLabels} — avoids overlap with ${conflictWith.join(' + ')}`;
    } else {
      explanation = `${chosenLabels} — alternated to minimize irritation`;
    }
  } else {
    // Smart rationale — covers both friendly-pair and default-spacing cases
    explanation = `${chosenLabels} — ${buildSmartRationale(newActiveFamily, chosen, existing)}`;
  }
  return {
    days: chosen,
    explanation,
    conflicts: chosenScore.hardHits > 0,
  };
};

// === PATTERN HELPERS ===
// Read cadence from a product, defaulting to "daily" (all 7 days) when none
// is set. Treats several legacy field shapes for backwards compat.
// === SINGLE-SOURCE NORMALIZERS (May 2026) ===
// Historic data and various write-paths produced mixed-case useTimes
// (some 'am'/'pm', some 'AM'/'PM'). This caused Today view filters to
// miss freshly added products. These helpers are now the ONLY way the
// app reads or writes slot/cadence data — every consumer routes through
// `productUseTimesLower` for reads, `normalizeUseTimes` for writes,
// `productCadenceDays` for cadence reads.
const normalizeUseTimes = (arr) => {
  if (!Array.isArray(arr)) return [];
  const out = [];
  for (const t of arr) {
    const v = String(t || '').toLowerCase();
    if ((v === 'am' || v === 'pm') && !out.includes(v)) out.push(v);
  }
  return out;
};
const productUseTimesLower = (p) => {
  if (!p || !Array.isArray(p.useTimes)) return [];
  return normalizeUseTimes(p.useTimes);
};
const productInAM = (p) => {
  const ut = productUseTimesLower(p);
  return ut.length === 0 || ut.includes('am');
};
const productInPM = (p) => {
  const ut = productUseTimesLower(p);
  return ut.length === 0 || ut.includes('pm');
};
// Mutating helper: returns a NEW product object with normalized useTimes
// + cadence guaranteed. Use this whenever a product is saved or updated
// so storage stays clean.
const sanitizeProductForSave = (p) => {
  if (!p) return p;
  const next = { ...p };
  next.useTimes = normalizeUseTimes(p.useTimes);
  // Cadence: prefer explicit cadence.days, fallback to cadenceDays, fallback to all 7.
  let days = null;
  if (p.cadence && Array.isArray(p.cadence.days)) days = p.cadence.days;
  else if (Array.isArray(p.cadenceDays)) days = p.cadenceDays;
  if (!days || days.length === 0) days = [0,1,2,3,4,5,6];
  next.cadence = { days, frequency: days.length };
  return next;
};


const productCadenceDays = (p) => {
  if (!p) return [0,1,2,3,4,5,6];
  if (p.cadence && Array.isArray(p.cadence.days) && p.cadence.days.length > 0) return p.cadence.days;
  if (Array.isArray(p.cadenceDays) && p.cadenceDays.length > 0) return p.cadenceDays;
  // No cadence → daily fallback
  return [0,1,2,3,4,5,6];
};

// === "IS THIS PRODUCT IN THE BUILT ROUTINE?" — single source of truth ===
//
// May 2026 strict definition (fixes the "all shelf products dumped into AM"
// bug). A product belongs to the user's built routine ONLY when ALL are true:
//   1. `routineManaged === true` — written by accepting Build/Refine.
//      Shelf AM/PM tags alone do not count as the constructed routine.
//   2. `p.cadence` is an explicitly-set object with `days` array.
//   3. `p.useTimes` non-empty (contains 'am' and/or 'pm').
//      Empty useTimes = user never tagged a slot. Excluded.
//
// EVERY render path that auto-populates Today must route through this
// helper. If you write new code that derives Today's AM/PM from
// products and skips this check, you re-introduce the bug. Don't.
const productIsInBuiltRoutine = (p) => {
  if (!p || p.endDate) return false;
  if (p.routineManaged !== true) return false;
  const hasExplicitCadence = !!(p.cadence && Array.isArray(p.cadence.days));
  if (!hasExplicitCadence) return false;
  const ut = Array.isArray(p.useTimes)
    ? p.useTimes.map(t => String(t || '').toLowerCase()).filter(t => t === 'am' || t === 'pm')
    : [];
  return ut.length > 0;
};

// "Has the user built ANY weekly routine?" — true if at least one active
// product passes productIsInBuiltRoutine. Drives empty-state surfacing
// and the pattern-fallback gate. Sole consumer of productIsInBuiltRoutine
// for the boolean question; getProductsForTodayFromPattern uses it for
// the list-building question.
const userHasBuiltPattern = (products) => {
  if (!Array.isArray(products)) return false;
  return products.some(productIsInBuiltRoutine);
};

// === ADAPTIVE HOME — USER COMPLETION STATE (May 2026) ===
// Derives one of 5 states from existing app data sources. Used by the
// Home/Atelier surface to decide which set of cards to render. Source-
// of-truth approach: no boolean flags stored separately. If the data
// is there, the state reflects it; if data goes away, state degrades
// gracefully.
//
// State definitions:
//   exploring        — nothing logged. Show value-prop + sample routines.
//   partial_profile  — answered some questionnaire but no products.
//                      Show a "your starting routine" card seeded from
//                      goals + experience level.
//   partial_shelf    — has products but profile is sparse. Show a
//                      "we organized your shelf" card + nudge to
//                      complete profile.
//   routine_ready    — has a built cadence pattern (userHasBuiltPattern
//                      true) but tutorial not yet completed.
//   fully_onboarded  — has everything including the tutorial flag.
//
// Inputs are read from existing state:
//   - logs / regimenLogs → hasPhotoCheckIn
//   - products → hasShelfProducts, hasGeneratedRoutine
//   - userProfile + onboardingState + userConcerns → hasAnsweredX
//   - localStorage `lumiere:tutorialCompleted` → hasCompletedTutorial
const getUserCompletionState = ({ products, logs, regimenLogs, userProfile, userConcerns, onboardingState }) => {
  const hasShelfProducts = Array.isArray(products) && products.filter(p => !p.endDate).length > 0;
  const hasGeneratedRoutine = userHasBuiltPattern(products);
  const hasPhotoCheckIn = (Array.isArray(logs) && logs.length > 0) || (Array.isArray(regimenLogs) && regimenLogs.length > 0);
  const profile = userProfile || {};
  const onb = onboardingState || {};
  const hasAnsweredGoals = (
    (Array.isArray(profile.goals) && profile.goals.length > 0) ||
    (Array.isArray(profile.primaryConcerns) && profile.primaryConcerns.length > 0) ||
    (Array.isArray(onb.goals) && onb.goals.length > 0) ||
    (Array.isArray(userConcerns) && userConcerns.length > 0)
  );
  const hasAnsweredExperienceLevel = !!onb.experienceLevel;
  const hasAnsweredTolerance = !!(onb.skinTolerance || profile.barrierScale);
  const hasAnsweredClinicalContext = (
    (Array.isArray(onb.skinConditions) && onb.skinConditions.length > 0) ||
    (Array.isArray(profile.diagnosedConditions) && profile.diagnosedConditions.length > 0)
  );
  let hasCompletedTutorial = false;
  try { hasCompletedTutorial = localStorage.getItem('lumiere:tutorialCompleted') === '1'; } catch (_) {}
  const state = (() => {
    if (hasGeneratedRoutine && hasPhotoCheckIn && hasShelfProducts && hasAnsweredGoals && hasCompletedTutorial) return 'fully_onboarded';
    if (hasGeneratedRoutine) return 'routine_ready';
    if (hasShelfProducts) return 'partial_shelf';
    if (hasAnsweredGoals || hasAnsweredExperienceLevel || hasAnsweredTolerance || hasAnsweredClinicalContext) return 'partial_profile';
    return 'exploring';
  })();
  return {
    state,
    hasShelfProducts, hasGeneratedRoutine, hasPhotoCheckIn,
    hasAnsweredGoals, hasAnsweredExperienceLevel, hasAnsweredTolerance, hasAnsweredClinicalContext,
    hasCompletedTutorial,
  };
};

// === MOVED to src/resolvers/sampleRoutines.js (PR 4) ===
// SAMPLE_ROUTINES + FOUNDATIONAL_SAMPLE_ROUTINE

// === MOVED to src/resolvers/routineResolvers.js (PR 4b) ===
// MAX_FACE_ROUTINE_SLOT_PRODUCTS, isBodyProduct, resolveTodayRitual,
// getProductsForTodayFromPattern.
// === LEGACY DOCSTRING — preserved here for navigability ===
// resolveTodayRitual is THE single source of truth for today's routine.
// Every Home / Regimen Today / Check-in Modal view MUST use this
// resolver to decide which products are in today's AM and PM. Each
// component making its own decision is what caused the body-exfoliator-
// in-PM regression: the cover used buildSlot, Regimen used a different
// reader, the modal seeded from yet another path, and a fix on one
// surface broke the others.
//
// Rules enforced here:
//   1. If a regimenLog exists for date → use its amProducts/pmProducts
//      (PLUS amExtras/pmExtras) as the canonical list. Log wins
//      whether submitted or in-progress — the log IS today's truth.
//   2. If no log → if user has a built routine, derive from pattern
//      (getProductsForTodayFromPattern with cadence + useTimes).
//   3. If no log AND no pattern → empty.
//   4. Body / hand / scalp / hair products are filtered out at every
//      path. Face routines are face only.
//   5. Hard cap of MAX_FACE_ROUTINE_SLOT_PRODUCTS per slot. Overflow
//      surfaces as `amOverflow` / `pmOverflow` so the UI can render
//      "+N more — open Refine" instead of an unbounded scroll.
//   6. Dedupe by product id — defensive against logs that accidentally
//      pushed the same id twice.
//
// AI suggestions never enter today's ritual via this resolver — they
// must go through an explicit "apply" mutation that writes to the
// regimenLog first.
//
// Returns:
//   {
//     source: 'submitted-log' | 'in-progress-log' | 'pattern' | 'empty',
//     am: Product[],         // capped, body-filtered, deduped
//     pm: Product[],         // capped, body-filtered, deduped
//     amExtras: string[],    // free-text "used something else" entries
//     pmExtras: string[],
//     amOverflow: number,    // count truncated from am
//     pmOverflow: number,
//   }
// === END LEGACY DOCSTRING ===

// === BUILD-WIZARD: CONCERN → ACTIVE-FAMILY MAP ===
// What user-stated concerns translate to which active families. Used to
// boost relevant products on the shelf when generating the weekly plan.
const CONCERN_FAMILY_MAP = {
  'hyperpigmentation': ['vitc', 'arbutin', 'tranexamic', 'kojic', 'azelaic', 'niacinamide'],
  'dark spots': ['vitc', 'arbutin', 'tranexamic', 'kojic', 'azelaic'],
  'melasma': ['tranexamic', 'azelaic', 'arbutin', 'kojic'],
  'acne': ['bha', 'azelaic', 'retinoid', 'bpo', 'niacinamide'],
  'breakouts': ['bha', 'azelaic', 'niacinamide'],
  'texture': ['aha', 'retinoid', 'pha'],
  'fine lines': ['retinoid', 'peptide', 'bakuchiol'],
  'aging': ['retinoid', 'vitc', 'peptide'],
  'wrinkles': ['retinoid', 'peptide'],
  'dryness': ['humectant', 'ceramide', 'panthenol'],
  'sensitivity': ['centella', 'panthenol', 'ceramide'],
  'redness': ['centella', 'niacinamide', 'azelaic'],
  'dullness': ['vitc', 'aha', 'niacinamide'],
  'enlarged pores': ['niacinamide', 'bha', 'retinoid'],
};

// === BUILD-WIZARD: TOLERANCE → FREQUENCY MAP ===
// Maps an active family to its weekly frequency at each tolerance tier.
// "Cautious" introduces actives slowly; "Push" leans into clinical doses.
// === FREQUENCY TABLE — derm-evidence pass (May 2026) ===
//
// Reviewed against Samantha Ellis / general derm consensus:
//   - SPF is non-negotiable daily AM at every tolerance level.
//   - Vitamin C is well-tolerated daily AM at all tolerance levels —
//     not an "irritation-budget" active. Even cautious starters can do
//     daily Vit C; benefit compounds with consistency.
//   - Bakuchiol is well-tolerated daily by definition (it's marketed as
//     the gentle retinoid alternative). Was unnecessarily gated.
//   - Niacinamide stacks with anything; barrier basics (ceramide,
//     panthenol, centella, humectant) are daily-safe across all tiers.
//   - Retinoid escalation: cautious starts low (2 nights → ramp), push
//     hits 5 nights/week (closer to nightly for advanced users).
//   - AHA stays low — 1 night cautious, 2 standard, 3 push max (Ellis
//     would prefer 1-2/wk for most people; pushing past 3 increases
//     barrier disruption for marginal benefit).
//   - Azelaic could technically be daily but holding at 5-7 keeps the
//     plan navigable for users adding it as a brightening / acne combo.
//   - Peptides: daily-safe at standard+, slight cautious limit so the
//     barrier acclimates if they're new.
//
// Numbers below are nights/week (or AM/week for AM-defaulting actives).
const TOLERANCE_FREQUENCY = {
  cautious: {
    retinoid: 2, aha: 1, bha: 2, bpo: 2, vitc: 5, niacinamide: 7,
    azelaic: 4, arbutin: 7, tranexamic: 7, peptide: 5, bakuchiol: 7,
    centella: 7, panthenol: 7, ceramide: 7, humectant: 7, spf: 7,
  },
  standard: {
    retinoid: 3, aha: 2, bha: 3, bpo: 3, vitc: 7, niacinamide: 7,
    azelaic: 5, arbutin: 7, tranexamic: 7, peptide: 7, bakuchiol: 7,
    centella: 7, panthenol: 7, ceramide: 7, humectant: 7, spf: 7,
  },
  push: {
    retinoid: 5, aha: 3, bha: 4, bpo: 4, vitc: 7, niacinamide: 7,
    azelaic: 6, arbutin: 7, tranexamic: 7, peptide: 7, bakuchiol: 7,
    centella: 7, panthenol: 7, ceramide: 7, humectant: 7, spf: 7,
  },
};

// === BUILD-WIZARD: PLAN GENERATOR ===
// Rule-based, zero API spend. Inputs: user's shelf, concerns, tolerance.
// Output: { am: {0:[ids],1:[...],...,6:[...]}, pm: {...}, notes: [string],
//           missingBasics: [string], slotted: [{product, family, days, slot}] }
//
// Algorithm:
//   1. Add basics (cleanser, moisturizer, SPF) to every day's relevant slot.
//   2. For each ACTIVE-bearing product, detect family, look up frequency from
//      tolerance map, then use suggestScheduleDays() to pick days that avoid
//      hard conflicts with what's already scheduled.
//   3. Slot into AM or PM based on useTimes + family rules (vitc/spf → AM,
//      retinoid/acid → PM by default).
//   4. Surface missing basics + any conflicts the scheduler couldn't avoid.
const generateBuildPlan = ({ products, concerns, tolerance, selectedActives, homeDevices, experience, actionGoal, userProfile, sensitivities, cycleData }) => {
  // === ADVISORIES (May 2026 — clinical pass per Jenni) ===
  // Soft, user-facing flags that don't change scheduling but surface in the
  // plan UI. Distinct from `skipped` (hard exclusions) and `notes` (terse
  // engine summary). Shape: { kind, message }.
  const advisories = [];

  // === T4: barrierScale auto-prefill of tolerance ===
  // If the user's barrier profile signals fragility AND they didn't
  // explicitly pick a tolerance ('standard' is the default), bump them
  // to 'cautious' (gentlest cadence tier in TOLERANCE_FREQUENCY).
  // One-line advisory so they know we adjusted.
  // Bug #1 fix (May 2026): was 'sensitive' — not a key in
  // TOLERANCE_FREQUENCY, so every active family silently dropped out
  // of the schedule and fragile-barrier users got an empty plan.
  let tol = tolerance || 'standard';
  const barrierScale = userProfile && userProfile.barrierScale;
  const isFragileBarrier = barrierScale === 'reactive' || barrierScale === 'very-reactive' || barrierScale === 'eczema-prone';
  if (isFragileBarrier && tol === 'standard') {
    tol = 'cautious';
    advisories.push({ kind: 'tolerance-autopreset', message: 'Set tolerance to gentle based on your barrier profile. Override in the wizard if needed.' });
  }

  // === T5: Under-18 protocol ===
  // Teens get adapalene 0.1% over OTC retinol/tretinoin. Foundational
  // stack is cleaner: cleanser + adapalene PM + non-comedogenic moisturizer
  // + SPF. We exclude OTC retinol/tretinoin candidates here and surface
  // an advisory. Adapalene 0.1% is allowed if it's on the shelf.
  const ageNum = userProfile && userProfile.age ? Number(userProfile.age) : NaN;
  const isUnder18 = (userProfile && (userProfile.ageBand === 'under-18' || userProfile.ageBand === 'teen'))
    || (Number.isFinite(ageNum) && ageNum < 18);
  if (isUnder18) {
    advisories.push({ kind: 'under-18', message: 'Under-18 protocol: prefer adapalene 0.1% over retinol for actives; foundational stack is cleanser + adapalene PM + non-comedogenic moisturizer + SPF.' });
  }

  // === T4 (May 2026): Post-menopausal protocol ===
  // Three behaviors fold into the build:
  //   1. Drop high-strength AHAs (glycolic 15%+, TCA, jessner) by default
  //      — pushed to `skipped` so the user sees why an owned product
  //      didn't make it in. Barrier is thinner; gentler acids win.
  //   2. Prefer bakuchiol over retinol/retinaldehyde if barrier-thin
  //      (handled at slot-time once we know the candidate list). When
  //      no bakuchiol is on shelf, retinol is skipped and we advise.
  //   3. Always surface the topical-estrogen conversation as an advisory
  //      — strong derm evidence for postmenopausal skin atrophy.
  // All checks are silent no-ops when profile fields are missing.
  const isPostMenopausal = userProfile?.hormonalContext === 'post-menopausal'
    || userProfile?.lifeStage === 'post-menopausal'
    || userProfile?.ageBand === '60+';
  if (isPostMenopausal) {
    advisories.push({ kind: 'post-menopausal', message: 'Topical estrogen (estriol or estradiol-based products, by prescription) is worth a conversation with your derm — strong evidence for postmenopausal skin atrophy.' });
  }

  // selectedActives can include ids like 'aha-glycolic' or 'aha-lactic' —
  // normalize to the canonical family IDs the scheduling engine knows.
  const normalizedSelectedFamilies = new Set();
  (selectedActives || []).forEach(id => {
    if (id === 'aha-glycolic' || id === 'aha-lactic') normalizedSelectedFamilies.add('aha');
    else normalizedSelectedFamilies.add(id);
  });
  const am = { 0:[], 1:[], 2:[], 3:[], 4:[], 5:[], 6:[] };
  const pm = { 0:[], 1:[], 2:[], 3:[], 4:[], 5:[], 6:[] };
  const notes = [];
  const missingBasics = [];
  const slotted = [];
  // === SAFETY FILTERS (May 2026 — pregnancy / fragrance / Rx / cycle) ===
  // Each `skipped` entry: { productName, reason, ruleId }. Filters
  // silently no-op when their input data is missing (so callers
  // don't have to thread userProfile/sensitivities/cycleData if
  // they don't have them yet). The plan view renders this list
  // beneath missingBasics so the user can see why an owned product
  // didn't make it in.
  const skipped = [];
  const safetyHay = (p) => `${p?.name || ''} ${p?.category || ''} ${p?.activeIngredients || ''} ${p?.actives || ''} ${p?.mainIngredients || ''} ${p?.notes || ''} ${(p?.tags || []).join(' ')}`.toLowerCase();

  const pregStatus = userProfile && (userProfile.pregnancyStatus || userProfile.pregnancy || '');
  const isPregFlag = pregStatus === 'pregnant' || pregStatus === 'trying-to-conceive' || pregStatus === 'trying';

  // Sensitivities can be array of strings OR array of { trigger / name }.
  const sensTokens = (() => {
    const arr = Array.isArray(sensitivities) ? sensitivities : [];
    return arr.map(s => {
      if (!s) return '';
      if (typeof s === 'string') return s.toLowerCase();
      return String(s.trigger || s.name || '').toLowerCase();
    }).filter(Boolean);
  })();
  const hasFragranceSensitivity = sensTokens.some(t => t.includes('fragrance') || t.includes('parfum'));

  // currentRx: string OR array describing prescription topicals.
  const currentRxText = (() => {
    if (!userProfile) return '';
    const rx = userProfile.currentRx || userProfile.prescriptions || '';
    if (Array.isArray(rx)) return rx.map(x => typeof x === 'string' ? x : (x && (x.name || x.label || ''))).join(' ').toLowerCase();
    return String(rx || '').toLowerCase();
  })();
  const onRxRetinoid = /\b(tretinoin|retin-?a|tazarotene|tazorac|adapalene|differin)\b/.test(currentRxText);
  const onRxClindamycin = /\bclindamycin\b/.test(currentRxText);

  const isRetinoidProduct = (p) => /\b(retinoid|retinol|retin|tretinoin|tazarotene|adapalene|retinaldehyde|retinyl)\b/.test(safetyHay(p));
  const isHighSalicylic = (p) => {
    const hay = safetyHay(p);
    if (!hay.includes('salicylic')) return false;
    // Match "X%" or "X percent" — flag if > 2.
    const m = hay.match(/(\d+(?:\.\d+)?)\s*(?:%|percent)/);
    if (m && parseFloat(m[1]) > 2) return true;
    return false;
  };
  const isFragranceProduct = (p) => {
    const hay = safetyHay(p);
    if (!hay) return false;
    // Match "fragrance" or "parfum"; ignore "fragrance-free".
    if (/\bfragrance[-\s]?free\b/.test(hay)) return false;
    return /\b(fragrance|parfum)\b/.test(hay);
  };
  const isOtcRetinoidOnly = (p) => {
    // OTC retinol / retinaldehyde — Rx (tretinoin / adapalene / tazarotene)
    // already covered above. Exclude these when user is on Rx retinoid.
    const hay = safetyHay(p);
    if (/\b(tretinoin|tazarotene|adapalene)\b/.test(hay)) return false;
    return /\b(retinol|retinaldehyde|retinyl)\b/.test(hay);
  };
  const isOtcBpo = (p) => /\b(benzoyl\s*peroxide|bpo)\b/.test(safetyHay(p));

  // T5: under-18 — drop OTC retinol / tretinoin candidates from shelf.
  // Adapalene 0.1% is allowed (covered by the isOtcRetinoidOnly carve-out
  // below — it explicitly excludes adapalene).
  const isUnder18OtcRetinoid = (p) => {
    if (!isUnder18) return false;
    const hay = safetyHay(p);
    // Allow adapalene at any %.
    if (/\badapalene\b/.test(hay)) return false;
    return /\b(retinol|tretinoin|retinaldehyde|retinyl)\b/.test(hay);
  };

  // T4 (May 2026): post-menopausal — drop high-strength AHAs by default.
  // Matches glycolic 15-19% (incl. 20%+), TCA, jessner. Lower-strength
  // (glycolic <15%, mandelic, lactic, PHA) are fine and stay on shelf.
  const isHighStrengthAHA = (p) => {
    const hay = safetyHay(p);
    return /glycolic\s*1[5-9]\s*%|glycolic\s*[2-9]\d\s*%|\btca\b|\bjessner\b/.test(hay);
  };

  // T4 (May 2026): post-menopausal + barrier-thin — prefer bakuchiol
  // over retinol/retinaldehyde. We need to know whether a bakuchiol
  // option exists on shelf BEFORE deciding to skip the retinol — done
  // by precomputing here so filterSafety can branch correctly.
  const postMenoBakuchiolSwapNeeded = isPostMenopausal && isFragileBarrier;
  const shelfHasBakuchiol = postMenoBakuchiolSwapNeeded
    ? (products || []).filter(p => !p.endDate).some(p => /\bbakuchiol\b/.test(safetyHay(p)))
    : false;
  let postMenoRetinolAdvisoryPushed = false;
  const isPostMenoRetinolToSwap = (p) => {
    if (!postMenoBakuchiolSwapNeeded) return false;
    const hay = safetyHay(p);
    // Only OTC retinol-class; Rx tretinoin/adapalene/tazarotene stays
    // because a derm prescribed it knowing the barrier context.
    if (/\b(tretinoin|tazarotene|adapalene)\b/.test(hay)) return false;
    return /\b(retinol|retinaldehyde|retinyl)\b/.test(hay);
  };

  const filterSafety = (p) => {
    if (!p) return true;
    if (isUnder18 && isUnder18OtcRetinoid(p)) {
      skipped.push({ productName: p.name || 'Unnamed product', reason: 'under-18: prefer adapalene 0.1% over OTC retinol/tretinoin', ruleId: 'under-18-retinoid' });
      return false;
    }
    if (isPregFlag) {
      if (isRetinoidProduct(p)) {
        skipped.push({ productName: p.name || 'Unnamed product', reason: 'retinoid not advised during pregnancy', ruleId: 'pregnancy-retinoid' });
        return false;
      }
      if (isHighSalicylic(p)) {
        skipped.push({ productName: p.name || 'Unnamed product', reason: 'salicylic acid >2% not advised during pregnancy', ruleId: 'pregnancy-salicylic' });
        return false;
      }
    }
    if (hasFragranceSensitivity && isFragranceProduct(p)) {
      skipped.push({ productName: p.name || 'Unnamed product', reason: 'fragrance sensitivity flagged', ruleId: 'fragrance' });
      return false;
    }
    if (onRxRetinoid && isOtcRetinoidOnly(p)) {
      skipped.push({ productName: p.name || 'Unnamed product', reason: 'doubling up with prescription retinoid — skipped OTC equivalent', ruleId: 'rx-retinoid-conflict' });
      return false;
    }
    if (onRxClindamycin && isOtcBpo(p)) {
      skipped.push({ productName: p.name || 'Unnamed product', reason: 'pairs with prescription clindamycin — skipping OTC BPO to avoid stacking', ruleId: 'rx-clindamycin-conflict' });
      return false;
    }
    // T4: post-menopausal — drop high-strength AHAs by default. Lower
    // strengths and PHA remain on shelf for gentler scheduling.
    if (isPostMenopausal && isHighStrengthAHA(p)) {
      skipped.push({ productName: p.name || 'Unnamed product', reason: 'Post-menopausal default: high-strength AHA dropped — consider lower-strength or PHA.', ruleId: 'post-menopausal-high-aha' });
      return false;
    }
    // T4: post-menopausal + barrier-thin — when no bakuchiol on shelf,
    // skip the retinol and advise (single advisory, not per-product).
    if (postMenoBakuchiolSwapNeeded && !shelfHasBakuchiol && isPostMenoRetinolToSwap(p)) {
      skipped.push({ productName: p.name || 'Unnamed product', reason: 'Post-menopausal + barrier-thin: retinol skipped, no bakuchiol on shelf to swap in.', ruleId: 'post-menopausal-retinol-skip' });
      if (!postMenoRetinolAdvisoryPushed) {
        advisories.push({ kind: 'post-menopausal', message: 'Retinol skipped — barrier-thin profile. Consider bakuchiol or wait for barrier to stabilize.' });
        postMenoRetinolAdvisoryPushed = true;
      }
      return false;
    }
    return true;
  };

  const activeProducts = (products || []).filter(p => !p.endDate).filter(filterSafety);

  // Cycle-aware advisory (no exclusion) — flag a flare risk if the
  // user is in pre-period and a retinoid intro lands in the plan.
  // T3 (May 2026): also flag a generic cycling-hormonal-context advisory
  // whenever the plan slots a retinoid (independent of current phase),
  // because the late-luteal sting risk applies every cycle.
  const cyclePhase = cycleData && (cycleData.phase || cycleData.currentPhase || '');
  const isPrePeriodPhase = cyclePhase === 'late-luteal' || cyclePhase === 'pre-period' || cyclePhase === 'pms';
  const planSlotsRetinoid = activeProducts.some(p => isRetinoidProduct(p));
  const isCyclingContext = userProfile && (userProfile.hormonalContext === 'cycling');
  if (planSlotsRetinoid && (isCyclingContext || isPrePeriodPhase)) {
    advisories.push({ kind: 'cycle', message: 'Pre-period flare risk: retinoids can sting more in the late luteal phase. Consider light layer or skip the 3 days before menstruation.' });
  }
  if (isPrePeriodPhase && planSlotsRetinoid) {
    notes.push('Cycle phase: pre-period — retinoid intro may flare. Consider starting after period.');
  }

  // === DEVICE OCCUPANCY (May 2026 — derm pass) ===
  // Compute which days each owned home device occupies + recovery days.
  // Strong actives are routed AWAY from device days that strip the
  // barrier (microneedling, dermaplane). Surfaced to the user via the
  // Today/Cover "tonight's devices" reminder and in the plan notes.
  const deviceOccupancy = computeDeviceOccupancy(homeDevices || []);
  if (deviceOccupancy.length > 0) {
    const deviceList = [...new Set(deviceOccupancy.filter(o => !o.isRecovery).map(o => o.label))];
    if (deviceList.length > 0) {
      notes.push(`Devices in your rotation: ${deviceList.join(' · ')}.`);
    }
  }

  // === BASICS HIERARCHY + PER-CATEGORY CAPS (May 2026 fix) ===
  // Bug we're fixing: users with many products in one category (e.g. 30
  // moisturizers on shelf) were getting ALL of them slotted in every PM,
  // because the previous code iterated forEach without any cap.
  //
  // Caps below are sensible defaults — user can manually toggle more on
  // in Edit manually. We pick the TOP N per slot, preferring products the
  // user has explicitly tagged with that slot's AM/PM useTime.
  const byCategory = (catBucket) => activeProducts.filter(p => normalizeProductCategory(p.category) === catBucket);
  const cleansers    = byCategory('cleanser');
  const allMoist     = byCategory('moisturizer');
  const spfs         = byCategory('spf');
  const toners       = byCategory('toner');
  const essences     = byCategory('essence');
  const oils         = byCategory('oil');
  const allSerums    = byCategory('serum');
  const allMasks     = byCategory('mask');

  // === OVERNIGHT CREAMS (May 2026, derm pass) ===
  // Pulled out from regular moisturizers — these are *layered* on top
  // of the regular PM moisturizer on recovery nights for occlusion +
  // repair (e.g. Estée Lauder Advanced Night Repair, Drunk Elephant
  // Lala Retro at night, Augustinus Bader The Cream as overnight rich).
  // Scheduled 2×/week PM (Tue + Sat — recovery nights), added AFTER
  // the regular moisturizer in slot order.
  const overnightCreamHay = (p) => `${p.name || ''} ${p.mainIngredients || ''} ${(p.tags || []).join(' ')}`.toLowerCase();
  const isOvernightCream = (p) => /\b(overnight|night\s*cream|sleeping\s*cream|repair\s*cream|night\s*repair|barrier\s*cream)\b/i.test(overnightCreamHay(p));
  const overnightCreams = allMoist.filter(isOvernightCream);
  const moisturizers    = allMoist.filter(p => !isOvernightCream(p));

  // === MASK TYPE DETECTION (May 2026, derm pass) ===
  //
  // Different masks have different cadences and slot placements:
  //   - Hydrating sheet/hydrogel (Biodance, COSRX, etc.): 3×/week PM,
  //     daily-safe but capped at 3 to avoid over-occlusion.
  //   - Sleeping / overnight masks (Laneige Water Sleeping, etc.):
  //     2×/week PM, layered ON TOP of moisturizer on recovery nights.
  //   - Clay / mud / charcoal masks (drying): 1×/week PM, skip on
  //     active nights to avoid barrier stress.
  //   - Peel / exfoliating masks (AHA peels, enzyme masks): 1×/week
  //     PM, alternate with retinoid via suggestScheduleDays.
  //
  // Pattern matching is conservative — match on explicit keywords in
  // name / ingredients / tags. When uncertain, default to hydrating
  // (the safest cadence).
  const maskTextHay = (p) => `${p.name || ''} ${p.mainIngredients || ''} ${p.activeIngredients || ''} ${(p.tags || []).join(' ')}`.toLowerCase();
  const isOvernightMask = (p) => /\b(sleeping|overnight|night\s*mask|sleep\s*pack|sleep\s*mask)\b/i.test(maskTextHay(p));
  const isHydratingMask = (p) => /\b(hydrogel|biodance|sheet\s*mask|hydrating\s*mask|aqua|jelly|essence\s*mask|collagen\s*mask)\b/i.test(maskTextHay(p));
  const isClayMask      = (p) => /\b(clay|mud|charcoal|kaolin|bentonite|detox\s*mask)\b/i.test(maskTextHay(p));
  const isPeelMask      = (p) => /\b(peel|exfoliating\s*mask|aha\s*mask|glycolic\s*mask|enzyme\s*mask|resurfacing\s*mask)\b/i.test(maskTextHay(p));

  // Bucket masks by type. Priority order so each mask falls into ONE bucket.
  const overnightMasks = allMasks.filter(isOvernightMask);
  const hydratingMasks = allMasks.filter(p => !isOvernightMask(p) && isHydratingMask(p));
  const clayMasks      = allMasks.filter(p => !isOvernightMask(p) && !isHydratingMask(p) && isClayMask(p));
  const peelMasks      = allMasks.filter(p => !isOvernightMask(p) && !isHydratingMask(p) && !isClayMask(p) && isPeelMask(p));

  if (cleansers.length === 0)    missingBasics.push('cleanser');
  if (moisturizers.length === 0) missingBasics.push('moisturizer');
  if (spfs.length === 0)         missingBasics.push('SPF');

  // === CATEGORY CAPS BY EXPERIENCE (May 2026 — derm pass) ===
  //
  // Beginner: 3-4 steps avg, cap 5 — keep essentials only
  // Medium:   3.5-5 avg, cap 6   — add toner; skip oil/essence
  // Advanced: 5-7 avg, cap 7     — richer, but never the whole shelf
  //
  // Per Jenni's guidance after seeing how many steps the routine was
  // producing for beginners. Caps below are PER SLOT (so cleanser=2 means
  // up to 2 cleansers in PM for double-cleanse, etc.). Final per-slot
  // trim further enforces the total cap if active scheduling pushes
  // over (see SLOT_TOTAL_CAP below).
  const exp = (experience === 'beginner' || experience === 'medium' || experience === 'advanced') ? experience : 'medium';
  const CATEGORY_CAPS_BY_EXP = {
    beginner: { cleanser: 1, moisturizer: 1, spf: 1, toner: 0, essence: 0, oil: 0, serum: 1 },
    medium:   { cleanser: 2, moisturizer: 1, spf: 1, toner: 1, essence: 0, oil: 0, serum: 1 },
    advanced: { cleanser: 2, moisturizer: 1, spf: 1, toner: 1, essence: 1, oil: 1, serum: 2 },
  };
  const CATEGORY_CAPS = CATEGORY_CAPS_BY_EXP[exp];

  // Hard per-slot cap. Trimmed after all slotting if a particular day
  // ends up over (e.g. multiple actives stacking on same day).
  // Tightened May 30 2026 per Jenni — beginner onboarding was producing
  // 5-7 step routines, too overwhelming for first-time users. Lowered
  // to 4/5/6 to enforce the minimal-start rule.
  const SLOT_TOTAL_CAP_BY_EXP = { beginner: 4, medium: 5, advanced: 6 };
  const SLOT_TOTAL_CAP = SLOT_TOTAL_CAP_BY_EXP[exp];
  const ACTIVE_FAMILY_CAP_BY_EXP = { beginner: 2, medium: 4, advanced: 6 };
  const ACTIVE_FAMILY_CAP = ACTIVE_FAMILY_CAP_BY_EXP[exp];

  // === SERUM ROUTING (May 2026) ===
  // Strong-active serums (retinoid, AHA, BHA, BPO, Vit C, azelaic, etc.)
  // get handled by the actives loop below with cadence-aware scheduling.
  // GENERIC serums (no strong active, or only well-tolerated families like
  // niacinamide, peptides, hyaluronic, ceramide) get anchored daily here
  // in the basics pre-pick so they actually appear in the routine instead
  // of falling through both surfaces.
  //
  // This split matters because the actives loop defers strong serums to
  // a less-than-daily cadence; daily-anchoring those (e.g. Vit C) would
  // override the slot-specific (AM-only) and frequency rules.
  const STRONG_FAMILIES_DEFERRED = new Set([
    'retinoid','aha','bha','bpo','vitc',
    'azelaic','arbutin','tranexamic','kojic','bakuchiol',
  ]);
  const genericSerums = allSerums.filter(p => {
    const fam = detectActiveFamily(p.activeIngredients || p.actives || '');
    return !fam || !STRONG_FAMILIES_DEFERRED.has(fam);
  });

  // Cleanser ordering: oil/balm/butter → step 1; foam/cream/gel → step 2
  const isOilCleanser = (p) => /\b(oil|balm|butter|melt)\b/i.test(`${p.name || ''} ${p.mainIngredients || ''}`);
  const sortCleansers = (list) => [...list].sort((a, b) => {
    const aOil = isOilCleanser(a) ? 0 : 1;
    const bOil = isOilCleanser(b) ? 0 : 1;
    return aOil - bOil;
  });

  // === pickTopN — chooses best N products for a given slot (single-slot) ===
  // Used for categories that don't need AM↔PM splitting (SPF, oils — both
  // single-slot by default). For dual-slot categories (cleanser, moisturizer)
  // use pickAmPmSplit below to avoid double-slotting the same product.
  const pickTopN = (list, n, slotLc) => {
    if (n <= 0 || !list.length) return [];
    const eligible = list.filter(p => {
      const ut = productUseTimesLower(p);
      if (ut.length === 0) return true;
      return ut.includes(slotLc);
    });
    if (eligible.length === 0) return [];
    const sorted = eligible.sort((a, b) => {
      const aUt = productUseTimesLower(a);
      const bUt = productUseTimesLower(b);
      const aTagged = aUt.includes(slotLc) ? 0 : 1;
      const bTagged = bUt.includes(slotLc) ? 0 : 1;
      if (aTagged !== bTagged) return aTagged - bTagged;
      return (bUt.length || 0) - (aUt.length || 0);
    });
    return sorted.slice(0, n);
  };

  // === pickAmPmSplit — May 2026 smarter slot splitter ===
  //
  // PROBLEM WE'RE FIXING:
  //   With moisturizers (cap=1), the old logic ran pickTopN(am) and
  //   pickTopN(pm) independently. If a user had 2 untagged moisturizers,
  //   BOTH calls returned the same M1 — so M1 ended up in AM and PM
  //   while M2 was orphaned. Worse: with 1 moisturizer, that single
  //   product got duplicated to both slots even when it might be PM-only
  //   by texture (a rich balm should not be your AM moisturizer).
  //
  // NEW BEHAVIOR:
  //   1. Honor explicit useTimes first (user knows best).
  //   2. Use texture inference for the dual-slot categories: light items
  //      lean AM, rich items lean PM, ambiguous fill remaining slots.
  //   3. Each product appears in AT MOST one slot when alternatives exist.
  //   4. If only one product is available with no useTimes hint, it stays
  //      in BOTH slots — preserves the normal "one moisturizer, used twice
  //      a day" case.
  //
  // Returns { am: [...], pm: [...] } each capped at slotCap.
  const pickAmPmSplit = (list, slotCap, isLightForAm = () => false, isRichForPm = () => false) => {
    if (!list.length) return { am: [], pm: [] };
    // Honor explicit useTimes tags first.
    const explicitAm = list.filter(p => productUseTimesLower(p).includes('am'));
    const explicitPm = list.filter(p => productUseTimesLower(p).includes('pm'));
    const untagged = list.filter(p => productUseTimesLower(p).length === 0);

    const am = [];
    const pm = [];
    const usedIds = new Set();

    // Phase 1: respect explicit tags
    for (const p of explicitAm) {
      if (am.length >= slotCap) break;
      am.push(p);
      usedIds.add(p.id);
    }
    for (const p of explicitPm) {
      if (pm.length >= slotCap) break;
      if (usedIds.has(p.id)) continue; // already in AM (both tagged)
      pm.push(p);
      usedIds.add(p.id);
    }

    // Phase 2: split untagged by texture inference. Each product picks
    // ONE slot (no double-slotting when alternatives exist).
    const lightUntagged = untagged.filter(p => isLightForAm(p));
    const richUntagged = untagged.filter(p => isRichForPm(p));
    const neutralUntagged = untagged.filter(p => !isLightForAm(p) && !isRichForPm(p));

    // Fill AM with light first, then neutral
    for (const p of [...lightUntagged, ...neutralUntagged]) {
      if (am.length >= slotCap) break;
      if (usedIds.has(p.id)) continue;
      am.push(p);
      usedIds.add(p.id);
    }
    // Fill PM with rich first, then neutral (already-used neutrals skipped)
    for (const p of [...richUntagged, ...neutralUntagged]) {
      if (pm.length >= slotCap) break;
      if (usedIds.has(p.id)) continue;
      pm.push(p);
      usedIds.add(p.id);
    }

    // Phase 3: SINGLE-PRODUCT FALLBACK — if there's exactly one product
    // total AND it's untagged AND nothing went to one of the slots yet,
    // duplicate it to that slot. Preserves "one moisturizer used twice
    // daily" without forcing the user to manually tag AM and PM.
    if (list.length === 1 && untagged.length === 1) {
      const only = untagged[0];
      // Texture-aware: a rich-tagged single moisturizer goes PM only.
      // A light-tagged single goes AM only. Neutral → both slots.
      if (isRichForPm(only) && !isLightForAm(only)) {
        // Pure rich → PM only, AM left empty
        if (am.length > 0) am.length = 0;
      } else if (isLightForAm(only) && !isRichForPm(only)) {
        // Pure light → AM only, PM left empty
        if (pm.length > 0) pm.length = 0;
      } else {
        // Neutral → ensure both slots have it
        if (am.length === 0 && pm.length === 1) am.push(only);
        if (pm.length === 0 && am.length === 1) pm.push(only);
      }
    }

    return { am, pm };
  };

  // === TEXTURE INFERENCE HELPERS ===
  // Moisturizer texture: "rich" → PM (cream, balm, butter, occlusive).
  // Light → AM (gel, lotion, fluid, water-based, oil-free).
  const isRichMoisturizer = (p) => /\b(balm|butter|salve|rich|occlusive|overnight|night\s*cream|sleeping)\b/i.test(`${p.name || ''} ${p.mainIngredients || ''}`);
  const isLightMoisturizer = (p) => /\b(gel|fluid|essence|water[- ]based|oil[- ]free|matte|aqua|hydra(?:ting)?)\b/i.test(`${p.name || ''} ${p.mainIngredients || ''}`);

  // Pre-pick the basics for each category. Dual-slot categories use the
  // splitter so the same product never lands in both AM and PM when there's
  // an alternative. Single-slot categories use pickTopN.
  const cleanserSplit    = pickAmPmSplit(cleansers, CATEGORY_CAPS.cleanser, () => false, isOilCleanser);
  const amCleansers      = sortCleansers(cleanserSplit.am);
  const pmCleansers      = sortCleansers(cleanserSplit.pm);
  const moistSplit       = pickAmPmSplit(moisturizers, CATEGORY_CAPS.moisturizer, isLightMoisturizer, isRichMoisturizer);
  const amMoisturizers   = moistSplit.am;
  const pmMoisturizers   = moistSplit.pm;
  const tonerSplit       = pickAmPmSplit(toners, CATEGORY_CAPS.toner);
  const amToners         = tonerSplit.am;
  const pmToners         = tonerSplit.pm;
  const essenceSplit     = pickAmPmSplit(essences, CATEGORY_CAPS.essence);
  const amEssences       = essenceSplit.am;
  const pmEssences       = essenceSplit.pm;
  const serumSplit       = pickAmPmSplit(genericSerums, CATEGORY_CAPS.serum);
  const amSerums         = serumSplit.am;
  const pmSerums         = serumSplit.pm;
  const amSpfs           = pickTopN(spfs, CATEGORY_CAPS.spf, 'am');
  const pmOils           = pickTopN(oils, CATEGORY_CAPS.oil, 'pm');

  // Track IDs slotted by basics — the actives loop will skip these so we
  // don't double-slot the same product as both a basic and an active.
  const slottedByBasicsIds = new Set([
    ...amCleansers, ...pmCleansers,
    ...amToners, ...pmToners,
    ...amEssences, ...pmEssences,
    ...amSerums, ...pmSerums,
    ...amMoisturizers, ...pmMoisturizers,
    ...pmOils, ...amSpfs,
    ...overnightCreams,
  ].map(p => p.id));

  // Build a note for overflow — when the user has more in a category than
  // the cap, surface a single calm message in the plan summary so they
  // know unselected items are intentional. Counts the excess.
  const overflow = [];
  if (cleansers.length > CATEGORY_CAPS.cleanser) overflow.push(`${cleansers.length - CATEGORY_CAPS.cleanser} extra cleanser${cleansers.length - CATEGORY_CAPS.cleanser === 1 ? '' : 's'}`);
  if (moisturizers.length > CATEGORY_CAPS.moisturizer) overflow.push(`${moisturizers.length - CATEGORY_CAPS.moisturizer} extra moisturizer${moisturizers.length - CATEGORY_CAPS.moisturizer === 1 ? '' : 's'}`);
  if (spfs.length > CATEGORY_CAPS.spf) overflow.push(`${spfs.length - CATEGORY_CAPS.spf} extra SPF${spfs.length - CATEGORY_CAPS.spf === 1 ? '' : 's'}`);
  if (toners.length > CATEGORY_CAPS.toner) overflow.push(`${toners.length - CATEGORY_CAPS.toner} extra toner${toners.length - CATEGORY_CAPS.toner === 1 ? '' : 's'}`);
  if (essences.length > CATEGORY_CAPS.essence) overflow.push(`${essences.length - CATEGORY_CAPS.essence} extra essence${essences.length - CATEGORY_CAPS.essence === 1 ? '' : 's'}`);
  if (oils.length > CATEGORY_CAPS.oil) overflow.push(`${oils.length - CATEGORY_CAPS.oil} extra oil${oils.length - CATEGORY_CAPS.oil === 1 ? '' : 's'}`);
  // Serum overflow = generic serums beyond what fits across both slots.
  // Strong-active serums (Vit C, retinoid, etc.) go through the actives
  // loop and are not "extras" — they're just scheduled differently.
  const serumSlotsFilled = genericSerums.length > CATEGORY_CAPS.serum * 2 ? CATEGORY_CAPS.serum * 2 : genericSerums.length;
  if (genericSerums.length > serumSlotsFilled) overflow.push(`${genericSerums.length - serumSlotsFilled} extra serum${genericSerums.length - serumSlotsFilled === 1 ? '' : 's'}`);
  if (overflow.length) {
    notes.push(`${overflow.join(' · ')} on shelf — toggle on in Edit if you want them in rotation.`);
  }

  // 1. Anchor basics across all 7 days (same selection daily by default).
  // Order matters for the rendered routine: cleanse → tone → essence →
  // serum (actives, scheduled in step 2) → moisturize → oil (PM) → SPF (AM).
  for (let d = 0; d < 7; d++) {
    // Routine order: cleanser → toner → essence → serum → moisturizer →
    // oil (PM only) → SPF (AM only). Standard light-to-heavy texture rule.
    amCleansers.forEach(c => { if (!am[d].includes(c.id)) am[d].push(c.id); });
    pmCleansers.forEach(c => { if (!pm[d].includes(c.id)) pm[d].push(c.id); });
    amToners.forEach(t => { if (!am[d].includes(t.id)) am[d].push(t.id); });
    pmToners.forEach(t => { if (!pm[d].includes(t.id)) pm[d].push(t.id); });
    amEssences.forEach(e => { if (!am[d].includes(e.id)) am[d].push(e.id); });
    pmEssences.forEach(e => { if (!pm[d].includes(e.id)) pm[d].push(e.id); });
    amSerums.forEach(s => { if (!am[d].includes(s.id)) am[d].push(s.id); });
    pmSerums.forEach(s => { if (!pm[d].includes(s.id)) pm[d].push(s.id); });
    amMoisturizers.forEach(m => { if (!am[d].includes(m.id)) am[d].push(m.id); });
    pmMoisturizers.forEach(m => { if (!pm[d].includes(m.id)) pm[d].push(m.id); });
    pmOils.forEach(o => { if (!pm[d].includes(o.id)) pm[d].push(o.id); });
    amSpfs.forEach(s => { if (!am[d].includes(s.id)) am[d].push(s.id); });
  }

  // === 1a. OVERNIGHT CREAMS (May 2026 — derm pass) ===
  // Layered AFTER the regular moisturizer on recovery nights. 2×/week PM
  // (Tue + Sat by default — spaced so the user gets two recovery nights
  // with extra occlusion + repair). Goes to slottedByBasicsIds so the
  // actives loop doesn't try to re-slot them.
  if (overnightCreams.length > 0) {
    const chosen = overnightCreams.slice(0, 1); // 1 overnight cream cap
    const recoveryNights = [2, 6]; // Tue + Sat
    recoveryNights.forEach(d => {
      chosen.forEach(o => { if (!pm[d].includes(o.id)) pm[d].push(o.id); });
    });
    if (overnightCreams.length > 1) notes.push(`${overnightCreams.length - 1} extra overnight cream${overnightCreams.length === 2 ? '' : 's'} on shelf — rotate manually in Edit.`);
  }

  // === 1b. MASK SCHEDULING (May 2026 — derm pass) ===
  //
  // Masks don't anchor to every day — they have type-specific cadence.
  // Schedule each bucket separately into PM (masks are almost always PM).
  // Days are spread evenly via DEFAULT_DAY_PATTERNS for the frequency.
  //
  // Sleeping/overnight masks: 2×/week, on RECOVERY nights — days without
  // strong actives already scheduled. The actives loop hasn't run yet, so
  // we just put them on alt days (Tue, Sat by default) and let the
  // actives loop avoid those days for retinoid/AHA via suggestScheduleDays.
  // The masks getting scheduled FIRST is intentional: they reserve those
  // recovery slots so the actives loop respects them.
  if (hydratingMasks.length > 0) {
    // 3×/week PM, daily-safe pattern (M, W, F)
    const pattern = DEFAULT_DAY_PATTERNS[3] || [1,3,5];
    const chosen = hydratingMasks.slice(0, 1); // 1 hydrating mask cap
    pattern.forEach(d => {
      chosen.forEach(m => { if (!pm[d].includes(m.id)) pm[d].push(m.id); });
    });
    if (hydratingMasks.length > 1) notes.push(`${hydratingMasks.length - 1} extra hydrating mask${hydratingMasks.length === 2 ? '' : 's'} on shelf — rotate manually in Edit.`);
  }
  if (overnightMasks.length > 0) {
    // 2×/week PM, on recovery nights (Tue + Sat, gives spaced barrier recovery)
    const pattern = [2, 6]; // Tue + Sat
    const chosen = overnightMasks.slice(0, 1);
    pattern.forEach(d => {
      chosen.forEach(m => { if (!pm[d].includes(m.id)) pm[d].push(m.id); });
    });
    if (overnightMasks.length > 1) notes.push(`${overnightMasks.length - 1} extra overnight mask${overnightMasks.length === 2 ? '' : 's'} on shelf — rotate manually in Edit.`);
  }
  if (clayMasks.length > 0) {
    // 1×/week PM, single day (Friday — end-of-week deep clean)
    const chosen = clayMasks.slice(0, 1);
    chosen.forEach(m => { if (!pm[5].includes(m.id)) pm[5].push(m.id); });
    if (clayMasks.length > 1) notes.push(`${clayMasks.length - 1} extra clay/mud mask${clayMasks.length === 2 ? '' : 's'} on shelf — rotate manually in Edit.`);
  }
  if (peelMasks.length > 0) {
    // 1×/week PM, single day (Saturday — recovery weekend ahead)
    const chosen = peelMasks.slice(0, 1);
    chosen.forEach(m => { if (!pm[6].includes(m.id)) pm[6].push(m.id); });
    if (peelMasks.length > 1) notes.push(`${peelMasks.length - 1} extra peel mask${peelMasks.length === 2 ? '' : 's'} on shelf — rotate manually in Edit.`);
  }
  // Add masks to slottedByBasicsIds so the actives loop doesn't try to
  // re-slot them (e.g. an exfoliating peel mask has detected family=aha;
  // we don't want the actives loop to also schedule it as AHA).
  [...hydratingMasks, ...overnightMasks, ...clayMasks, ...peelMasks]
    .forEach(p => slottedByBasicsIds.add(p.id));

  // 2. Schedule actives. Process in priority order so the "loudest" actives
  //    (retinoids, acids) get scheduled first and softer actives fill gaps.
  const familyPriority = ['retinoid', 'bha', 'aha', 'bpo', 'vitc', 'azelaic',
                          'tranexamic', 'arbutin', 'kojic', 'bakuchiol',
                          'peptide', 'niacinamide', 'centella', 'panthenol',
                          'ceramide', 'humectant'];

  // Build "preferred families" from concerns + explicitly selected actives.
  // Selected actives take top priority — the user explicitly wants those.
  // Concerns secondary — derived recommendations.
  const preferred = new Set();
  normalizedSelectedFamilies.forEach(f => preferred.add(f));
  (concerns || []).forEach(c => {
    const fams = CONCERN_FAMILY_MAP[String(c).toLowerCase()];
    if (fams) fams.forEach(f => preferred.add(f));
  });

  // Sort: preferred families first, then default priority
  const sortedFamilies = [...familyPriority].sort((a, b) => {
    const aP = preferred.has(a) ? 0 : 1;
    const bP = preferred.has(b) ? 0 : 1;
    if (aP !== bP) return aP - bP;
    return familyPriority.indexOf(a) - familyPriority.indexOf(b);
  });

  // Default slot by family — acids/retinoids → PM (irritation + photosensitivity),
  // vitc/spf-adjacent → AM, niacinamide/etc → both fine, default AM.
  const defaultSlotFor = (family) => {
    if (['retinoid', 'aha', 'bha', 'bpo'].includes(family)) return 'pm';
    if (['vitc'].includes(family)) return 'am';
    return 'am';
  };

  let activeFamiliesSlotted = 0;
  let activeFamiliesSkippedByCap = 0;
  for (const fam of sortedFamilies) {
    const freq = TOLERANCE_FREQUENCY[tol]?.[fam];
    if (!freq) continue;
    // Find products on shelf matching this family. Skip anything already
    // slotted by the basics pre-pick (e.g. a generic niacinamide serum
    // anchored daily as a basic shouldn't get re-slotted by the actives
    // loop). May 2026 fix to prevent double-slotting after the serum
    // bucket was added.
    const candidates = activeProducts.filter(p => {
      if (slottedByBasicsIds.has(p.id)) return false;
      const det = detectActiveFamily(p.activeIngredients || p.actives || '');
      return det === fam;
    });
    if (candidates.length === 0) continue;
    if (activeFamiliesSlotted >= ACTIVE_FAMILY_CAP) {
      activeFamiliesSkippedByCap += 1;
      continue;
    }
    // Pick the highest-strength candidate (primaryActive sort by pct)
    const sorted = candidates.sort((a, b) => {
      const aP = primaryActive(parseActivesWithPct(a.activeIngredients))?.pct || 0;
      const bP = primaryActive(parseActivesWithPct(b.activeIngredients))?.pct || 0;
      return bP - aP;
    });
    const chosen = sorted[0];

    // Determine slot(s). Now an {am, pm} flag pair so a single product
    // can be scheduled in both slots when the user has both AM and PM on
    // the product. acceptPlan reads both flags and writes useTimes
    // accordingly.
    const useTimes = Array.isArray(chosen.useTimes) ? chosen.useTimes.map(s => String(s).toUpperCase()) : [];
    let slotAM = useTimes.includes('AM');
    let slotPM = useTimes.includes('PM');
    if (!slotAM && !slotPM) {
      // No explicit toggle — pick the family default
      const def = defaultSlotFor(fam);
      if (def === 'am') slotAM = true; else slotPM = true;
    }
    // Primary slot for scheduling-conflict math (use the heavier one)
    const slot = slotPM ? 'pm' : 'am';
    const targetMap = slot === 'am' ? am : pm;

    // Build existingPattern in the family-shape that suggestScheduleDays expects:
    //   { 0: ['retinoid', 'spf', ...], 1: [...], ... }
    const existingPattern = {};
    for (let d = 0; d < 7; d++) {
      const ids = targetMap[d];
      existingPattern[d] = ids.map(id => {
        const p = activeProducts.find(x => x.id === id);
        return p ? detectActiveFamily(p.activeIngredients || p.actives || '') : null;
      }).filter(Boolean);
    }

    // === DEVICE AVOID DAYS (May 2026) ===
    // If user owns devices that strip skin (microneedling, dermaplane),
    // compute which days of the week want this family avoided. Treats
    // those days as hard conflicts so suggestScheduleDays routes around.
    const avoidDays = (() => {
      const set = new Set();
      for (const o of deviceOccupancy) {
        if (o.avoid && o.avoid.includes(fam)) set.add(o.day);
      }
      return set;
    })();

    const { days, explanation, conflicts } = suggestScheduleDays({
      newActiveFamily: fam,
      frequency: freq,
      existingPattern,
      avoidDays,
    });

    days.forEach(d => {
      if (!targetMap[d].includes(chosen.id)) targetMap[d].push(chosen.id);
    });

    slotted.push({ product: chosen, family: fam, frequency: freq, days, slot, am: slotAM, pm: slotPM, explanation });
    activeFamiliesSlotted += 1;
    if (conflicts) notes.push(`${chosen.name}: ${explanation}`);
  }
  if (activeFamiliesSkippedByCap > 0) {
    notes.push(`Held back ${activeFamiliesSkippedByCap} lower-priority active famil${activeFamiliesSkippedByCap === 1 ? 'y' : 'ies'} so the build stays focused instead of scheduling your whole shelf.`);
  }

  // === FINAL PER-SLOT CAP TRIM (May 2026 — derm pass) ===
  //
  // Some days end up over the experience cap when multiple actives land
  // on the same day. Trim by KEEP_PRIORITY (highest = most essential):
  //   1. SPF (AM) / cleanser            — non-negotiable basics
  //   2. Active treatment (retinoid, AHA, BHA, vitC, etc.) — derm-effective
  //   3. Moisturizer                    — barrier
  //   4. Hydrating / barrier serum       — supportive
  //   5. Toner / essence                — optional
  //   6. Oil                            — optional
  //
  // Items kept are limited to SLOT_TOTAL_CAP. Trimmed items get a single
  // "X extra steps on shelf — toggle on in Edit to add back." note.
  const STRONG_ACTIVE_FAMS = new Set(['retinoid','aha','bha','bpo','vitc','azelaic','arbutin','tranexamic','kojic','bakuchiol']);
  const stepPriority = (productId, slotName) => {
    const p = activeProducts.find(x => x.id === productId);
    if (!p) return 99;
    const cat = normalizeProductCategory(p.category);
    const fam = detectActiveFamily(p.activeIngredients || p.actives || '');
    if (cat === 'spf' && slotName === 'am') return 1;     // SPF first to keep
    if (cat === 'cleanser')                  return 2;     // cleanser essential
    if (STRONG_ACTIVE_FAMS.has(fam))         return 3;     // active treatment
    if (cat === 'moisturizer')               return 4;     // barrier
    if (cat === 'serum')                     return 5;     // hydrating support
    if (cat === 'toner')                     return 6;
    if (cat === 'essence')                   return 7;
    if (cat === 'oil')                       return 8;
    return 9;
  };
  let totalTrimmed = 0;
  for (let d = 0; d < 7; d++) {
    if (am[d].length > SLOT_TOTAL_CAP) {
      const sorted = [...am[d]].sort((a, b) => stepPriority(a, 'am') - stepPriority(b, 'am'));
      totalTrimmed += am[d].length - SLOT_TOTAL_CAP;
      am[d] = sorted.slice(0, SLOT_TOTAL_CAP);
    }
    if (pm[d].length > SLOT_TOTAL_CAP) {
      const sorted = [...pm[d]].sort((a, b) => stepPriority(a, 'pm') - stepPriority(b, 'pm'));
      totalTrimmed += pm[d].length - SLOT_TOTAL_CAP;
      pm[d] = sorted.slice(0, SLOT_TOTAL_CAP);
    }
  }
  if (totalTrimmed > 0) {
    notes.push(`Trimmed ${totalTrimmed} extra step${totalTrimmed === 1 ? '' : 's'} to fit your ${exp} step count. Toggle products back on in Edit if you want more layers.`);
  }

  return { am, pm, notes, missingBasics, slotted, skipped, advisories };
};

// === CATEGORY → LUCIDE ICON MAP ===
// Used by the cover + regimen card renderers to pick a quiet visual stand-in
// for the product type, replacing the Gemini-generated bottle art and the
// dashed bottle outline placeholder. Returns the Icon name string. Keep the
// list tight — generic categories cover most products; oddball ones fall
// through to the catch-all Circle.
const getCategoryIcon = (category) => {
  const c = (category || '').toLowerCase();
  if (c.includes('cleanser') || c.includes('wash') || c.includes('foam')) return 'Droplets';
  if (c.includes('toner')) return 'Droplet';
  if (c.includes('essence')) return 'Wind';
  if (c.includes('serum') || c.includes('ampoule')) return 'Sparkles';
  if (c.includes('moisturizer') || c.includes('cream') || c.includes('lotion')) return 'Cloud';
  if (c.includes('sunscreen') || c.includes('spf') || c.includes('sun')) return 'Sun';
  if (c.includes('treatment') || c.includes('spot')) return 'Star';
  if (c.includes('exfoliant') || c.includes('peel') || c.includes('acid')) return 'Zap';
  if (c.includes('mask')) return 'Square';
  if (c.includes('oil')) return 'Droplet';
  if (c.includes('eye')) return 'Eye';
  if (c.includes('lip')) return 'Smile';
  if (c.includes('mist') || c.includes('spray')) return 'Wind';
  return 'Circle';
};

// === TEXTURE / FOCUS-CHIP MAPS for the new ritual-card tiles ===
// Picks the texture-gradient class for a product's circular swatch on the
// cover/regimen tile. Maps a product category to one of: oil, foam, serum,
// cream, mist, sun. Used in place of the old bottle photo / DashedBottleOutline
// per Jenni's May 2026 redesign.
const getTextureClass = (category) => {
  const c = (category || '').toLowerCase();
  if (c.includes('oil')) return 'oil';
  if (c.includes('cleanser') || c.includes('wash') || c.includes('foam')) return 'foam';
  if (c.includes('mist') || c.includes('spray')) return 'mist';
  if (c.includes('spf') || c.includes('sunscreen')) return 'sun';
  if (c.includes('moisturizer') || c.includes('cream') || c.includes('lotion') || c.includes('mask') || c.includes('balm') || c.includes('eye') || c.includes('lip')) return 'cream';
  if (c.includes('serum') || c.includes('ampoule') || c.includes('toner') || c.includes('essence') || c.includes('treatment') || c.includes('exfoliant')) return 'serum';
  return 'cream';
};
// === TEXTURE SWATCH STYLES (Option B — May 2026) ===
// Multi-layer radial-gradient stack per category gives the swatch dimensional
// "drop of cream / glob of oil" feel — more editorial than the flat pearls
// they replace. Each entry has BOTH a `bg` (background-image string, comma-
// separated layers) and a `shadow` (boxShadow inset highlights + depth) so
// the swatch reads as a 3D form rather than a flat disc.
//
// Layer composition (top → bottom):
//   1. Bright highlight blob (upper-left, white ~80% opacity)
//   2. Mid-tone gloss (center, slight color cast)
//   3. Deep base color (radial center-out)
//
// To re-key a category, add the slug to getTextureClass() and add an entry
// here. Falls back to .cream when no mapping found.
//
// FOLLOW-UP: replace with hand-built SVG illustrations (Option A, deferred).
// See project_texture_swatch_followup.md in auto-memory.
const TEXTURE_STYLES = {
  oil: {
    bg: 'radial-gradient(circle at 28% 26%, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0) 22%), radial-gradient(circle at 70% 70%, rgba(180,135,55,0.20) 0%, rgba(180,135,55,0) 55%), radial-gradient(circle at 50% 50%, #fff3c0 0%, #e8c777 60%, #d8a94a 100%)',
    shadow: 'inset 0 -10px 18px rgba(150,100,40,0.22), inset 0 6px 10px rgba(255,255,255,0.55), 0 4px 12px rgba(180,140,60,0.18)',
  },
  foam: {
    bg: 'radial-gradient(circle at 30% 28%, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0) 30%), radial-gradient(circle at 65% 70%, rgba(180,160,140,0.12) 0%, rgba(180,160,140,0) 50%), radial-gradient(circle at 50% 50%, #ffffff 0%, #efe9e2 70%, #d8cfc4 100%)',
    shadow: 'inset 0 -10px 16px rgba(120,95,75,0.14), inset 0 6px 10px rgba(255,255,255,0.7), 0 4px 12px rgba(120,95,75,0.10)',
  },
  serum: {
    bg: 'radial-gradient(circle at 32% 28%, rgba(255,255,255,0.90) 0%, rgba(255,255,255,0) 25%), radial-gradient(circle at 70% 70%, rgba(200,165,130,0.18) 0%, rgba(200,165,130,0) 55%), radial-gradient(circle at 50% 50%, #fffaf3 0%, #e8d6c2 65%, #cdb29a 100%)',
    shadow: 'inset 0 -10px 18px rgba(150,110,75,0.18), inset 0 6px 10px rgba(255,255,255,0.55), 0 4px 12px rgba(150,110,75,0.14)',
  },
  cream: {
    bg: 'radial-gradient(circle at 32% 28%, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0) 28%), radial-gradient(circle at 70% 72%, rgba(180,150,130,0.12) 0%, rgba(180,150,130,0) 55%), radial-gradient(circle at 50% 50%, #ffffff 0%, #efe5dc 68%, #d4c4b6 100%)',
    shadow: 'inset 0 -10px 18px rgba(140,105,80,0.16), inset 0 6px 10px rgba(255,255,255,0.6), 0 4px 12px rgba(140,105,80,0.12)',
  },
  mist: {
    bg: 'radial-gradient(circle at 30% 30%, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0) 28%), radial-gradient(circle at 70% 70%, rgba(120,160,180,0.15) 0%, rgba(120,160,180,0) 55%), radial-gradient(circle at 50% 50%, #f5fbff 0%, #d8e6ee 65%, #b0c5d3 100%)',
    shadow: 'inset 0 -10px 18px rgba(80,120,140,0.18), inset 0 6px 10px rgba(255,255,255,0.65), 0 4px 12px rgba(80,120,140,0.14)',
  },
  sun: {
    bg: 'radial-gradient(circle at 28% 26%, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0) 22%), radial-gradient(circle at 70% 70%, rgba(240,180,80,0.22) 0%, rgba(240,180,80,0) 55%), radial-gradient(circle at 50% 50%, #fff4c8 0%, #f5cf70 60%, #e3a13d 100%)',
    shadow: 'inset 0 -10px 18px rgba(190,130,40,0.25), inset 0 6px 10px rgba(255,255,255,0.55), 0 4px 12px rgba(190,130,40,0.18)',
  },
};
// Back-compat: legacy code references TEXTURE_GRADIENTS expecting a string.
// Provide a shim that returns just the bg string.
const TEXTURE_GRADIENTS = Object.fromEntries(
  Object.entries(TEXTURE_STYLES).map(([k, v]) => [k, v.bg])
);

// Picks the Lucide icon for an active-ingredient chip in the focus-row.
const focusChipIcon = (label) => {
  const l = (label || '').toLowerCase();
  if (l.includes('hyaluronic') || l.includes('hydration')) return 'Droplet';
  if (l.includes('panthenol') || l.includes('barrier')) return 'Activity';
  if (l.includes('centella') || l.includes('cica')) return 'Leaf';
  if (l.includes('niacinamide')) return 'Sparkles';
  if (l.includes('vitamin c') || l.includes('ascorb')) return 'Sun';
  if (l.includes('retinoid') || l.includes('retinol')) return 'Moon';
  if (l.includes('ceramide')) return 'Shield';
  if (l.includes('aha') || l.includes('bha') || l.includes('pha')) return 'Zap';
  if (l.includes('spf')) return 'Sun';
  if (l.includes('peptide')) return 'Atom';
  if (l.includes('snail')) return 'Droplets';
  if (l.includes('azelaic')) return 'Sparkle';
  return 'Sparkles';
};

// === LOCAL DATE HELPER (module scope) ===
// .toISOString().split('T')[0] returns the UTC date — drifts a calendar day
// off for users east of UTC after midnight local. Always use this helper
// when persisting/comparing user-facing dates so a 1am EDT photo doesn't get
// filed under yesterday's date in UTC, and an Asia-timezone user's morning
// photo doesn't get tagged with the previous day. Lifted to module scope so
// pre-App components (ProcedureCompareSlot, etc.) can use it too.
const localDateISO = (d = new Date()) => {
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  const dd = String(d.getDate()).padStart(2, '0');
  return `${yyyy}-${mm}-${dd}`;
};



// === SUGGESTED CADENCE HEURISTIC ===
// Returns { days: number[], times: ('am'|'pm')[] } recommending which days
// of the week (0=Sun..6=Sat) and which time(s) of day to use a product.
// Tier 1 (actives) overrides Tier 2 (category) — strongest active wins.
// Falls back to all-7-days AM+PM when nothing is recognized.
const suggestedCadence = (category, actives) => {
  const all7 = [0, 1, 2, 3, 4, 5, 6];
  const mwf = [1, 3, 5];
  const tts = [2, 4, 6];
  const tt = [2, 4];
  const sunday = [0];
  const a = (actives || '').toLowerCase();
  const c = (category || '').toLowerCase();
  // Tier 1 — strong actives (most specific). Strongest wins on ties.
  if (/(tretinoin|retinaldehyde|retinol|adapalene|tazarotene|retinyl)/.test(a)) {
    return { days: mwf, times: ['pm'] };
  }
  if (/benzoyl\s*peroxide/.test(a)) {
    return { days: mwf, times: ['pm'] };
  }
  if (/(glycolic|lactic|mandelic|aha)/.test(a)) {
    return { days: tts, times: ['pm'] };
  }
  if (/(salicylic|bha)/.test(a)) {
    return { days: tts, times: ['pm'] };
  }
  if (/(vitamin\s*c|ascorbic|ascorbate)/.test(a)) {
    return { days: all7, times: ['am'] };
  }
  if (/azelaic/.test(a)) {
    return { days: all7, times: ['am', 'pm'] };
  }
  if (/(niacinamide|hyaluronic|glycerin|panthenol|squalane|ceramide)/.test(a)) {
    return { days: all7, times: ['am', 'pm'] };
  }
  // Tier 2 — category fallback.
  if (c.includes('sunscreen') || c.includes('spf')) return { days: all7, times: ['am'] };
  if (c.includes('cleanser')) return { days: all7, times: ['am', 'pm'] };
  if (c.includes('toner') || c.includes('essence')) return { days: all7, times: ['am', 'pm'] };
  if (c.includes('moistur') || c.includes('cream') || c.includes('lotion')) return { days: all7, times: ['am', 'pm'] };
  if (c.includes('mask')) return { days: sunday, times: ['pm'] };
  if (c.includes('exfoliant') || c.includes('peel')) return { days: tt, times: ['pm'] };
  if (c.includes('treatment')) return { days: mwf, times: ['pm'] };
  if (c.includes('oil') || c.includes('balm')) return { days: all7, times: ['pm'] };
  if (c.includes('serum')) return { days: all7, times: ['am', 'pm'] };
  // Tier 3 — fallback.
  return { days: all7, times: ['am', 'pm'] };
};
// Compares current useDays/useTimes to the suggested pattern — used to drive
// the "Suggested ✦" chip's active state. If user has manually overridden,
// the chip fades to outline (signal "you've customized").
const cadenceMatchesSuggested = (useDays, useTimes, category, actives) => {
  const sug = suggestedCadence(category, actives);
  const sortedA = [...(useDays || [])].sort().join(',');
  const sortedB = [...sug.days].sort().join(',');
  if (sortedA !== sortedB) return false;
  const timesA = [...(useTimes || [])].sort().join(',');
  const timesB = [...sug.times].sort().join(',');
  return timesA === timesB;
};

