              concern: 'dryness',
              eyebrow: 'Hydrate · this week',
              headline: 'Dryness? Add water, not weight.',
              analysis: 'Look for humectants and cushion layers before another treatment step.',
              missing: 'Check whether your routine has a dedicated hydration layer.',
            },
          };
          const insightDecision = insightDecisionMap[insightSignalKey]
            || insightDecisionMap[String(insightSignalKey || '').toLowerCase()]
            || null;
          const signalCoverage = (() => {
            try {
              if (!insightDecision || !Array.isArray(products) || products.length === 0) return null;
              const dateKey = (typeof localDateISO === 'function') ? localDateISO() : new Date().toISOString().slice(0, 10);
              const ritual = resolveTodayRitual({ products, regimenLogs: regimenLogs || [], date: dateKey });
              return resolveCoverageStates({
                routine: { am: ritual.am, pm: ritual.pm },
                concerns: [insightDecision.coverageConcern],
                preferences: {},
              }, deriveProductJobs);
            } catch (e) {
              return null;
            }
          })();
          const hasSignalRecCards = !!signalCoverage && (
            (signalCoverage.swap?.length || 0) ||
            (signalCoverage.concernGap?.length || 0) ||
            (signalCoverage.complement?.length || 0)
          );
          const signalLogCount = recentInsightLogs.length;
          const signalReady = signalLogCount >= 3;
          const recentProcedure = [...(procedures || [])]
            .filter(Boolean)
            .sort((a, b) => new Date(b.date || 0) - new Date(a.date || 0))[0];
          const procedureName = recentProcedure?.name || recentProcedure?.type || '';
          const procedureLower = String(procedureName || '').toLowerCase();
          const procedureSignal = recentProcedure
            ? (/rf|radiofrequency|microneed/i.test(procedureLower)
                ? 'Track texture, redness, and bounce across the next few check-ins before escalating actives.'
                : 'Watch recovery pattern before changing the routine around this procedure.')
            : null;
          const overlapInsight = overlapGroups.length
            ? `${overlapGroups[0].label} repeats across ${overlapGroups[0].items.length} products.`
            : 'No obvious repeated product lane.';
          const regimenSignalCopy = signalReady
            ? (hasSignalRecCards ? 'Routine has an actionable gap or rethink.' : 'Routine looks covered for the strongest signal.')
            : 'Need 3+ logs before regimen interpretation is reliable.';
          const patternSignalCopy = signalReady
            ? (topInsightConcern ? `${topInsightConcernLabel} is the clearest repeat.` : 'No dominant repeat yet.')
            : `${signalLogCount} log${signalLogCount === 1 ? '' : 's'} so far; keep logging for a real read.`;
          const topIngredientRows = activeIngredientFamilyRows.slice(0, 2);
          const latestMetricLog = recentInsightLogs.find(l => l && l.metricSnapshot);
          const latestMetrics = latestMetricLog?.metricSnapshot || {};
          const hasIngredientFamily = (families) => families.some(f => !!activeIngredientFamilyCounts[f]);
          const ingredientOutcomeRead = (() => {
            const fams = new Set(activeIngredientFamilies);
            const title = (f) => String(f || '').replace(/-/g, ' ');
            const famList = (families) => families.filter(f => fams.has(f)).map(title).slice(0, 3).join(' + ');
            const rednessBad = latestMetrics.redness && /moderate|high/i.test(latestMetrics.redness);
            const sensitivityBad = latestMetrics.sensitivity && /reactive|inflamed|tender/i.test(latestMetrics.sensitivity);
            const hydrationGood = latestMetrics.hydration && /plump|good/i.test(latestMetrics.hydration);
            const rednessGood = latestMetrics.redness && /clear|low/i.test(latestMetrics.redness);
            const textureGood = latestMetrics.texture && /smooth|even/i.test(latestMetrics.texture);
            const breakoutsGood = latestMetrics.breakouts && /clear|few/i.test(latestMetrics.breakouts);
            const irritantFamilies = ['retinoid', 'aha', 'bha', 'pha', 'bpo', 'vitc'].filter(f => fams.has(f));
            if ((rednessBad || sensitivityBad) && irritantFamilies.length) {
              return {
                title: `Possible irritant: ${famList(irritantFamilies)}`,
                body: `Because latest read shows ${rednessBad ? `redness ${latestMetrics.redness}` : `sensitivity ${latestMetrics.sensitivity}`}. These active lanes can be helpful, but timing/frequency may be too much right now.`,
              };
            }
            if (hydrationGood && hasIngredientFamily(['humectant', 'ceramide', 'panthenol'])) {
              const helpers = ['humectant', 'ceramide', 'panthenol'].filter(f => fams.has(f));
              return {
                title: `${famList(helpers)} may be helping`,
                body: `Hydration is reading ${latestMetrics.hydration}; these are the hydration/barrier-support families present in your routine.`,
              };
            }
            if (rednessGood && hasIngredientFamily(['centella', 'azelaic', 'niacinamide', 'ceramide', 'panthenol'])) {
              const helpers = ['centella', 'azelaic', 'niacinamide', 'ceramide', 'panthenol'].filter(f => fams.has(f));
              return {
                title: `${famList(helpers)} may be helping`,
                body: `Redness is reading ${latestMetrics.redness}; these calm/barrier-support families are present, so they are plausible contributors.`,
              };
            }
            if ((textureGood || breakoutsGood) && hasIngredientFamily(['niacinamide', 'bha', 'retinoid', 'azelaic'])) {
              const helpers = ['niacinamide', 'bha', 'retinoid', 'azelaic'].filter(f => fams.has(f));
              const metric = textureGood ? `texture ${latestMetrics.texture}` : `breakouts ${latestMetrics.breakouts}`;
              return {
                title: `${famList(helpers)} may be helping`,
                body: `${metric} looks controlled; these pore/turnover families are present. Treat this as a clue, not proof.`,
              };
            }
            if (topIngredientRows.length) {
              return {
                title: topIngredientRows.map(r => r.family).join(' + '),
                body: `Most represented in routine products: ${topIngredientRows.map(r => `${r.family} (${r.count})`).join(' + ')}. Need clearer before/after signal to call them helpful.`,
              };
            }
            return {
              title: 'No ingredient map yet',
              body: 'Add products to map which ingredients line up with skin changes.',
            };
          })();
          const ingredientSignalCopy = ingredientOutcomeRead.body;
          const openSignalPicks = () => {
            // Always route to picks/suggestions. If insightDecision is
            // null (concern not in insightDecisionMap), fall back to
            // filtering by the raw concern key so unmapped concerns
            // still land on the right surface with pre-filter applied.
            // 2026-05-31: previous fallback to LESSONS confused users
            // who clicked "See matches" for pores.
            setPearlsTab('picks');
            setPicksView('suggestions');
            setPicksActionFilter(insightDecision?.action || 'all');
            const concernKey = insightDecision?.concern
              || (topInsightConcern && topInsightConcern[0])
              || null;
            if (concernKey) setMatchesActiveConcerns(new Set([String(concernKey).toLowerCase()]));
            setPicksSuggestSeed(s => s + 1);
          };

          return (
            // Wrapped in md:max-w-md md:mx-auto so Counsel uses the same
            // phone-feel container as Assessment / Regimen / Compare on
            // desktop. Was full-bleed before, which made the page feel
            // mismatched with the rest of the app.
            <div className="md:max-w-md md:mx-auto pb-6">
              <div className="mb-4 md:mb-3">
                <div className="flex items-end justify-between gap-3 flex-wrap">
                  <div>
                    <div className="text-[10px] tracking-[0.32em] uppercase mb-1" style={{color:'var(--ink-soft)', fontWeight:650}}>Insights</div>
                    <h1 className="text-[26px] md:text-[30px] leading-[1.05]" style={{color:'var(--ink)', fontWeight:700, letterSpacing:'-0.025em'}}>Insights</h1>
                  </div>
                  {pearlsTab === 'qa' && pearlsQAMessages.length > 0 && (
                    <button
                      type="button"
                      onClick={clearPearlsQA}
                      className="text-[10px] tracking-[0.18em] uppercase rounded-full px-3 py-1.5 border"
                      style={{borderColor: 'var(--line)', color:'var(--ink-soft)', background:'var(--cream)'}}
                    >
                      New conversation
                    </button>
                  )}
                </div>
                <p className="text-[11.5px] leading-snug mt-1" style={{color:'var(--ink-soft)'}}>
                  Understand your skin, choose products, learn the logic, and ask follow-ups.
                </p>
                <div className="mt-4" style={{borderTop:'1px solid var(--line)'}} />
              </div>

              {/* Sub-tab toggle — unified with EditorialSubTabs for consistency
                  with Journal/Compare/Regimen pill rows. 'Saved' surfaces the
                  user's bookmarked lessons (set via the bookmark icon in any
                  open lesson modal).

                  May 2026: Color sub-tab retired (per Jenni). Color analysis
                  may return as an optional field inside Skin Profile later;
                  for now no nav surface. The portal logic + ColorModal +
                  activeTab === 'makeup' page stay alive as dead code in case
                  we revive. */}
              <div className="mb-5">
                <EditorialSubTabs
                  tabs={[
                    { id: 'signals', label: 'Signals', icon: 'Activity' },
                    { id: 'picks', label: 'Picks', icon: 'CheckCircle2' },
                    { id: 'lessons', label: 'Lessons', icon: 'BookOpen' },
                    { id: 'qa', label: 'Ask', icon: 'MessageCircle' },
                  ]}
                  value={pearlsTab === 'color' || pearlsTab === 'saved' ? 'lessons' : pearlsTab === 'budget' ? 'picks' : pearlsTab}
                  onChange={(id) => setPearlsTab(id)}
                />
              </div>

              {pearlsTab === 'signals' && (
                <div className="space-y-3 mb-5">
                  <div className="rounded-[14px] border p-3" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
                    <div className="mb-3">
                      <div className="text-[10px] tracking-[0.25em] uppercase mb-1" style={{color:'var(--accent)', fontWeight:650}}>Signals</div>
                      <h2 className="text-[17px] leading-tight" style={{color:'var(--ink)', fontWeight:700, letterSpacing:'-0.01em'}}>What your skin is telling you.</h2>
                    </div>

                    {/* === Log → Interpret → Choose flowchart removed June 2026 (Tier A.2) ===
                        Onboarding chrome welded to a live surface — narrated verbs the user
                        is already doing. The substantive "not enough check-ins yet" copy is
                        preserved below as a standalone establishing-state line. */}
                    {!signalReady && (
                      <div className="rounded-[12px] border px-3 py-2 mb-3 text-[10px] leading-snug" style={{background:'var(--cream-deep)', borderColor: 'var(--line)', color:'var(--ink-soft)'}}>
                        Not enough check-ins for a confident interpretation yet. Three or more logs gives Signals something real to compare.
                      </div>
                    )}

                    <div className="space-y-2.5">
                      <div className="rounded-[14px] border p-3" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                        <div className="text-[9px] tracking-[0.22em] uppercase mb-2" style={{color:'var(--ink-soft)', fontWeight:700}}>Emerging patterns</div>
                        {!signalEnoughObjectiveData ? (
                          <div className="text-[11px] leading-snug" style={{color:'var(--ink-soft)'}}>
                            A few more readings and patterns will start to surface. {Math.max(0, 5 - signalDataPointCount)} more to go.
                          </div>
                        ) : signalTopConcerns.length === 0 ? (
                          <div className="text-[11px] leading-snug" style={{color:'var(--ink-soft)'}}>No recurring concern is clearly repeating yet.</div>
                        ) : (
                          <div className="space-y-2.5">
                            {signalTopConcerns.map(([concern, n]) => (
                              // Non-interactive row (2026-05-31): pattern click
                              // routed nowhere meaningful — turned off until the
                              // dedicated "tap a pattern → pre-filtered picks"
                              // flow is built. See pattern reads + Go to matches
                              // below for the live entry point.
                              <div
                                key={concern}
                                className="w-full text-left flex items-start justify-between gap-3"
                              >
                                <div className="min-w-0">
                                  <div className="text-[13px] leading-tight capitalize" style={{color:'var(--ink)', fontWeight:700}}>{signalConcernName(concern)}</div>
                                  <div className="text-[10px] mt-0.5" style={{color:'var(--ink-soft)'}}>flagged in {n} reading{n === 1 ? '' : 's'}</div>
                                  <div className="text-[10px] mt-1 leading-snug" style={{color:'var(--ink-soft)'}}>{signalConcernInterpretation(concern, n)}</div>
                                </div>
                                <div className="text-right flex-shrink-0">
                                  <div className="text-[19px] leading-none" style={{color:'var(--accent)', fontWeight:750}}>{n}</div>
                                  <div className="text-[8.5px] tracking-[0.12em] uppercase mt-1" style={{color:'var(--ink-soft)', fontWeight:650}}>matches</div>
                                </div>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>

                      {/* === Primary Plan card removed June 2026 (Tier B) ===
                          Folded into "What we'd try" below — same job (concern → why
                          → action + CTAs), now consolidated to one card per concern
                          so users don't see "Frida noticed X" rendered twice with
                          different framing. */}

                      <div className="rounded-[14px] border p-3" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
                        <div className="text-[9px] tracking-[0.22em] uppercase mb-3" style={{color:'var(--accent-sage-dark)', fontWeight:700}}>Most responsive</div>
                        {signalResponders.length === 0 ? (
                          <div className="text-[11px] leading-snug" style={{color:'var(--ink-soft)'}}>
                            {signalProductResponse.length === 0
                              ? 'Add product start dates and ratings to see which changes line up with better skin days.'
                              : 'Nothing has moved the needle convincingly yet. Keep logging.'}
                          </div>
                        ) : (
                          <div className="space-y-2">
                            {signalResponders.map(r => (
                              <div key={r.product.id} className="rounded-[10px] border p-3 flex items-start justify-between gap-3" style={{background:'var(--cream-deep)', borderColor:'var(--line)'}}>
                                <div className="min-w-0 flex-1">
                                  <div className="text-[13px] leading-tight" style={{color:'var(--ink)', fontWeight:700}}>{r.product.name}</div>
                                  <div className="text-[9.5px] tracking-[0.12em] uppercase mt-0.5" style={{color:'var(--ink-soft)', fontWeight:600}}>{r.product.brand || 'product'}{r.product.activeIngredients ? ` · ${String(r.product.activeIngredients).split(',')[0].trim()}` : ''} · 14 days</div>
                                  <div className="text-[10.5px] mt-1.5 leading-snug" style={{color:'var(--ink)'}}>{responderInterpretation(r)}</div>
                                </div>
                                <div className="text-right flex-shrink-0">
                                  <div className="text-[20px] leading-none" style={{color:'var(--accent-sage-dark)', fontWeight:750, letterSpacing:'-0.02em'}}>+{r.delta.toFixed(1)}</div>
                                  <div className="text-[8.5px] mt-0.5 tracking-[0.14em] uppercase" style={{color:'var(--ink-soft)', fontWeight:600}}>shift</div>
                                </div>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>

                      {/* === UNIFIED READS PANEL — Jun 1 2026 per Jenni ===
                          Replaces the previous nested-box Watch card + separate
                          tile grid (5 disconnected islands, 2 with yellow
                          surfaces). Everything now lives in ONE bordered
                          editorial panel: Watch at top as a quiet typographic
                          list with serif-italic shifts (not alarm red), then
                          a hairline rule, then the Reads as flush divided
                          rows. Overlap caution shows a small gold dot — no
                          background flag. Less chrome, single visual object.
                          See InsightsReadRow above for the row renderer. */}
                      {(() => {
                        // June 2026 (Tier B): cut 3 of 4 Reads tiles. Regimen
                        // ("16 products") is just inventory — belongs in Regimen
                        // tab. Overlap is duplicated by the Bench view in Picks
                        // (and routed there from a single click already). Procedure
                        // is one-off and doesn't return. Ingredient is the only
                        // tile that surfaces non-obvious "what's actually helping"
                        // — kept and default-expanded so the supporting reasoning
                        // shows without a tap.
                        const readsTiles = [
                          { label:'Ingredient', title: ingredientOutcomeRead.title, body: ingredientSignalCopy, defaultExpanded: true },
                        ];
                        return (
                          <div className="rounded-[18px] border overflow-hidden" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                            {signalWatchers.length > 0 && (
                              <div className="px-4 pt-4 pb-3">
                                <div className="flex items-baseline justify-between mb-3">
                                  <div className="text-[9px] tracking-[0.22em] uppercase" style={{color:'var(--gold)', fontWeight:700}}>Watch</div>
                                  <div className="text-[9px] tracking-[0.18em] uppercase" style={{color:'var(--ink-soft)'}}>{signalWatchers.length} dipping · 14d</div>
                                </div>
                                <ul className="divide-y" style={{borderColor:'var(--line)'}}>
                                  {signalWatchers.map((r, idx) => (
                                    <li key={r.product.id} className={`flex items-start justify-between gap-3 ${idx === 0 ? 'pb-3' : 'py-3'}`}>
                                      <div className="min-w-0 flex-1">
                                        <div className="text-[12.5px] leading-tight" style={{color:'var(--ink)', fontWeight:650}}>{r.product.name}</div>
                                        <div className="text-[9px] tracking-[0.12em] uppercase mt-0.5" style={{color:'var(--ink-soft)', fontWeight:600}}>
                                          {r.product.brand || 'product'}{r.product.activeIngredients ? ` · ${String(r.product.activeIngredients).split(',')[0].trim()}` : ''}
                                        </div>
                                        <div className="text-[10.5px] mt-1 leading-snug" style={{color:'var(--ink-soft)'}}>{watcherInterpretation(r, activeProductsForBudget || products)}</div>
                                      </div>
                                      <div className="font-serif text-[18px] leading-none flex-shrink-0" style={{color:'var(--ink-soft)', fontWeight:500, letterSpacing:'-0.01em', marginTop:'2px'}}>
                                        {r.delta.toFixed(1)}
                                      </div>
                                    </li>
                                  ))}
                                </ul>
                                <div className="text-[9px] mt-3" style={{color:'var(--ink-soft)'}}>
                                  Correlation, not causation.
                                </div>
                              </div>
                            )}
                            <ul className="divide-y" style={{borderColor:'var(--line)', borderTop: signalWatchers.length > 0 ? '1px solid var(--line)' : 'none'}}>
                              {readsTiles.map(t => <InsightsReadRow key={t.label} tile={t} />)}
                            </ul>
                          </div>
                        );
                      })()}
                    </div>
                  </div>

                  <div>
                    <div className="text-[9px] tracking-[0.22em] uppercase mb-2" style={{color:'var(--ink-soft)', fontWeight:650}}>What we'd try</div>
                    <div className="rounded-[14px] border p-3 mb-2" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
                      {/* === Header — NOT a button (June 2026 per Jenni) ===
                          Previous version made the entire header a button that
                          routed to Picks/Suggestions. Tapping anywhere on the
                          card text shipped the user out of the Signals tab —
                          which is exactly the "leading user out of the section"
                          problem. Header is now a plain div; navigation only
                          happens via the explicit bottom CTAs. */}
                      <div className="flex items-center gap-1.5 text-[9.5px] tracking-[0.22em] uppercase mb-2" style={{color:'var(--accent)', fontWeight:700}}>
                        <Icon name="Sparkles" size={11} />
                        {topInsightConcern ? (insightDecision?.eyebrow || `${topInsightConcernLabel} · this week`) : 'Start · keep logging'}
                      </div>
                      <div className="text-[15px] leading-tight mb-1" style={{color:'var(--ink)', fontWeight:700}}>
                        {topInsightConcern ? (insightDecision?.headline || `${topInsightConcernLabel} is repeating.`) : 'Log a few more days.'}
                      </div>
                      <div className="text-[11px] leading-snug" style={{color:'var(--ink-soft)'}}>
                        {topInsightConcern
                          ? insightDecision?.analysis || insightRefine?.tryThis || 'Choose a focused adjustment for this week.'
                          : 'Signals will turn repeat observations into a specific next move.'}
                      </div>

                      {/* === Inline lesson snippet (June 2026 per Jenni) ===
                          Pulls excerpt + first 2 actions from CONCERN_GUIDE when
                          a matching entry exists (redness / breakouts / dryness
                          / hyperpigmentation / fine-lines / irritation / sun-
                          damage). Pore + texture don't have CONCERN_GUIDE
                          entries — fall back to insightDecision.missing which
                          already serves a similar "what to check" line.
                          Goal: the user gets the "why + concrete next moves"
                          inline. No tap-through required. */}
                      {topInsightConcern && (() => {
                        const concernKey = topInsightConcern[0];
                        // Map concern aliases to CONCERN_GUIDE.id
                        const guideKey = concernKey === 'acne' ? 'breakouts'
                          : concernKey === 'pigment' ? 'hyperpigmentation'
                          : concernKey === 'aging' ? 'fine-lines'
                          : concernKey;
                        const guide = CONCERN_GUIDE.find(c => c.id === guideKey);
                        const hasGuide = guide && (guide.excerpt || (guide.actions && guide.actions.length));
                        const hasFallback = !!insightDecision?.missing;
                        if (!hasGuide && !hasFallback) return null;
                        return (
                          <div className="rounded-[12px] border px-3 py-2.5 mt-3" style={{background:'var(--cream-deep)', borderColor:'var(--line)'}}>
                            <div className="text-[8.5px] tracking-[0.22em] uppercase mb-1.5" style={{color:'var(--ink-soft)', fontWeight:700}}>
                              Why this matters
                            </div>
                            {hasGuide ? (
                              <>
                                {guide.excerpt && (
                                  <div className="text-[11px] leading-snug mb-2" style={{color:'var(--ink-soft)'}}>{guide.excerpt}</div>
                                )}
                                {guide.actions && guide.actions.length > 0 && (
                                  <ul className="space-y-1.5 mt-2">
                                    {guide.actions.slice(0, 2).map((a, i) => (
                                      <li key={i} className="text-[11px] leading-snug flex items-start gap-2" style={{color:'var(--ink)'}}>
                                        <span style={{color:'var(--accent)', flexShrink:0, marginTop:'1px', fontWeight:700}}>·</span>
                                        <span>{a}</span>
                                      </li>
                                    ))}
                                  </ul>
                                )}
                              </>
                            ) : (
                              <div className="text-[11px] leading-snug" style={{color:'var(--ink-soft)'}}>{insightDecision.missing}</div>
                            )}
                          </div>
                        );
                      })()}
                    </div>

                    {/* Inline picks — RecCardSection renders shelf-first then
                        outside picks. Default-visible (not collapsible) so the
                        actual product cards show without a tap. */}
                    {hasSignalRecCards && (
                      <div className="space-y-2">
                        <RecCardSection
                          coverage={signalCoverage}
                          surface="journal"
                          maxCards={2}
                          onPickClick={openSignalPicks}
                          onSwapClick={openSignalPicks}
                        />
                      </div>
                    )}
                    <div className="grid grid-cols-2 gap-1.5 mt-2">
                      <button
                        type="button"
                        onClick={() => { setPearlsLessonCategory(topInsightConcern ? 'concerns' : 'start'); setPearlsTab('lessons'); }}
                        className="rounded-full border px-3 py-2 text-[8.5px] tracking-[0.14em] uppercase"
                        style={{borderColor: 'var(--line)', color:'var(--accent)', background:'var(--cream-deep)', fontWeight:700}}
                      >
                        Learn more
                      </button>
                      <button
                        type="button"
                        onClick={openSignalPicks}
                        className="rounded-full border px-3 py-2 text-[8.5px] tracking-[0.14em] uppercase"
                        style={{borderColor: 'var(--line)', color:'var(--cream)', background:'var(--accent)', fontWeight:700}}
                      >
                        See more matches
                      </button>
                    </div>
                  </div>
                </div>
              )}

              {/* === SAVED ===
                  Reference cards the user has bookmarked from any lesson modal.
                  Each card opens the same lesson modal so they can re-read or
                  un-save. Empty state shows a hint. */}
              {pearlsTab === 'saved' && (() => {
                const savedLessons = savedPearlIds
                  .map(id => LESSONS.find(l => l.id === id))
                  .filter(Boolean);
                if (savedLessons.length === 0) {
                  return (
                    <div className="border p-10 text-center" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                      <Icon name="BookmarkPlus" size={28} className="mx-auto mb-3" style={{color:'var(--ink-soft)'}} />
                      <p className="font-serif text-base mb-1" style={{color:'var(--ink)'}}>No saved pearls yet.</p>
                      <p className="text-xs font-light" style={{color:'var(--ink-soft)'}}>Open any lesson and tap the Save icon to keep it as a reference card here.</p>
                    </div>
                  );
                }
                return (
                  <div className="border" style={{borderColor: 'var(--line)', background:'var(--cream)'}}>
                    {savedLessons.map((l, i) => (
                      <div key={l.id} className="px-4 md:px-5 py-3 md:py-4 flex items-start gap-3 md:gap-4" style={{borderTop: i === 0 ? 'none' : '1px solid var(--line)'}}>
                        <button onClick={() => setOpenLesson(l)} className="flex-1 min-w-0 text-left transition hover:opacity-80">
                          <div className="text-[9px] tracking-[0.25em] uppercase mb-1" style={{color:'var(--ink-soft)'}}>{l.category}</div>
                          <div className="flex items-baseline gap-2 md:gap-3 flex-wrap">
                            <span className="font-serif text-base md:text-xl leading-tight" style={{color:'var(--ink)'}}>{l.title}</span>
                            <span className="text-xs md:text-sm font-light leading-snug" style={{color:'var(--ink-soft)'}}>— {l.excerpt}</span>
                          </div>
                        </button>
                        <div className="flex items-center gap-1.5 md:gap-2 flex-shrink-0 mt-1">
                          {l.evidenceGrade && (
                            <span className="text-[9px] tracking-[0.15em] uppercase px-1.5 py-0.5 border" style={{borderColor:'var(--ink-soft)', color:'var(--ink-soft)'}}>{l.evidenceGrade}</span>
                          )}
                          <button
                            onClick={() => { toggleSavedPearl(l.id); toast('Removed from Saved', 'info'); }}
                            className="p-1 transition hover:opacity-70"
                            style={{color:'var(--accent)'}}
                            aria-label="Remove from saved"
                          >
                            <Icon name="BookmarkCheck" size={14} />
                          </button>
                        </div>
                      </div>
                    ))}
                  </div>
                );
              })()}

              {/* === LESSONS === */}
              {pearlsTab === 'lessons' && (() => {
                const subtabs = [
                  { id: 'start', label: 'Start', icon: 'Map' },
                  { id: 'routine', label: 'My Terms', icon: 'Sparkles' },
                  { id: 'concerns', label: 'By Concern', icon: 'Heart' },
                  { id: 'basics', label: 'Basics', icon: 'BookOpen' },
                  { id: 'ingredients', label: 'Ingredients', icon: 'Beaker' },
                  { id: 'hormones', label: 'Hormones', icon: 'Activity' },
                  { id: 'nutrition', label: 'Nutrition', icon: 'Apple' },
                  { id: 'procedures', label: 'Procedures', icon: 'Layers' },
                ];
                const basicsLessonIds = ['double-cleansing', 'sixty-second-cleanse', 'layering-order', 'sunscreen-mechanisms'];
                const basicsLessons = basicsLessonIds.map(id => LESSONS.find(l => l.id === id)).filter(Boolean);
                const routineTermMap = {
                  retinoid: { label: 'Retinoids', lessonId: 'retinoid-hierarchy', note: 'Turnover, texture, breakouts' },
                  bakuchiol: { label: 'Bakuchiol', lessonId: 'retinoid-hierarchy', note: 'Retinoid-adjacent active' },
                  bha: { label: 'BHA', lessonId: 'ahas-vs-bhas', note: 'Oil-soluble pore exfoliant' },
                  aha: { label: 'AHA', lessonId: 'ahas-vs-bhas', note: 'Surface texture exfoliant' },
                  pha: { label: 'PHA', lessonId: 'ahas-vs-bhas', note: 'Gentler exfoliant lane' },
                  bpo: { label: 'Benzoyl peroxide', lessonId: 'benzoyl-peroxide', note: 'Breakout active' },
                  azelaic: { label: 'Azelaic acid', lessonId: 'azelaic-acid', note: 'Redness, bumps, pigment' },
                  vitc: { label: 'Vitamin C', lessonId: 'vitamin-c', note: 'Brightening antioxidant' },
                  niacinamide: { label: 'Niacinamide', lessonId: 'niacinamide', note: 'Barrier and tone support' },
                  peptide: { label: 'Peptides', lessonId: 'peptides', note: 'Signal and cushion support' },
                  ceramide: { label: 'Ceramides', lessonId: 'ceramides', note: 'Barrier lipid support' },
                  centella: { label: 'Centella', lessonId: 'centella', note: 'Calming and recovery' },
                  panthenol: { label: 'Panthenol', lessonId: 'ceramides', note: 'Recovery humectant' },
                  humectant: { label: 'Hyaluronic acid', lessonId: 'hyaluronic-acid', note: 'Water-binding layer' },
                  emollient: { label: 'Squalane', lessonId: 'ceramides', note: 'Softening support' },
                  spf: { label: 'SPF filters', lessonId: 'sunscreen-mechanisms', note: 'Daily protection baseline' },
                };
                const ownedRoutineTerms = Array.from(new Set(
                  activeProductsForBudget
                    .map(p => detectActiveFamily([p.activeIngredients, p.actives, p.main, p.name, p.brand, p.category, ...(p.tags || [])].filter(Boolean).join(' ')))
                    .filter(Boolean)
                ))
                  .map(family => ({ family, ...(routineTermMap[family] || { label: family, lessonId: null, note: 'Owned routine term' }) }))
                  .slice(0, 8);
                const activeSubtab = (pearlsLessonCategory === 'all' || !subtabs.find(s => s.id === pearlsLessonCategory)) ? 'start' : pearlsLessonCategory;
                const filteredLessonsSub = ['start', 'routine', 'concerns'].includes(activeSubtab)
                  ? []
                  : activeSubtab === 'basics'
                    ? basicsLessons
                    : LESSONS.filter(l => l.category === activeSubtab);
                const savedLessonsInline = savedPearlIds.map(id => LESSONS.find(l => l.id === id)).filter(Boolean);
                const chapterMeta = {
                  start: {
                    eyebrow: 'New user path',
                    title: 'Start here',
                    body: 'Barrier, SPF, one active, then refine.',
                    count: 4,
                  },
                  routine: {
                    eyebrow: 'Your glossary',
                    title: 'My terms',
                    body: 'Ingredients and active families you own.',
                    count: ownedRoutineTerms.length,
                  },
                  concerns: {
                    eyebrow: 'Problem-first index',
                    title: 'By concern',
                    body: 'Pick the skin problem first, then open protocol and ingredient logic.',
                    count: CONCERN_GUIDE.length,
                  },
                  basics: {
                    eyebrow: 'Foundation chapter',
                    title: 'Basics',
                    body: 'Cleansing, moisturizing, sunscreen, layering order, and routine structure.',
                    count: basicsLessons.length,
                  },
                  ingredients: {
                    eyebrow: 'Ingredient library',
                    title: 'Ingredients',
                    body: 'Retinoids, niacinamide, sunscreen, acids, peptides, and what they do.',
                    count: LESSONS.filter(l => l.category === 'ingredients').length,
                  },
                  hormones: {
                    eyebrow: 'Pattern context',
                    title: 'Hormones',
                    body: 'Cycle, stress, sleep, and fluctuation patterns that can change skin.',
                    count: LESSONS.filter(l => l.category === 'hormones').length,
                  },
                  nutrition: {
                    eyebrow: 'Inside-out context',
                    title: 'Nutrition',
                    body: 'Diet, supplements, hydration, and evidence strength.',
                    count: LESSONS.filter(l => l.category === 'nutrition').length,
                  },
                  procedures: {
                    eyebrow: 'In-office map',
                    title: 'Procedures',
                    body: 'Peels, lasers, microneedling, timelines, and recovery logic.',
                    count: LESSONS.filter(l => l.category === 'procedures').length,
                  },
                };
                return (
                  <>
                    {/* === ALL / SAVED TOGGLE (May 30 2026 per Jenni) ===
                        Top-of-page pills that switch the Lessons surface
                        between full browse and saved-only. When 'saved',
                        the regular browse hides and only saved lessons
                        render below. */}
                    <div className="inline-flex border rounded-full p-0.5 mb-3" style={{ background: 'var(--cream-deep)', borderColor: 'var(--line)' }}>
                      {[
                        { id: 'all',   label: 'All' },
                        { id: 'saved', label: 'Saved', count: savedLessonsInline.length }
                      ].map(opt => {
                        const on = pearlsLessonsFilter === opt.id;
                        return (
                          <button
                            key={opt.id}
                            type="button"
                            onClick={() => setPearlsLessonsFilter(opt.id)}
                            aria-pressed={on}
                            className="text-[10px] tracking-[0.18em] uppercase px-3.5 py-1.5 rounded-full transition flex items-center gap-1.5"
                            style={{ background: on ? 'var(--accent-ink)' : 'transparent', color: on ? 'var(--cream)' : 'var(--ink-soft)', fontWeight: 700 }}
                          >
                            {opt.label}
                            {typeof opt.count === 'number' && opt.count > 0 && (
                              <span className="text-[8.5px] px-1.5 py-0.5 rounded-full" style={{ background: on ? 'rgba(255,255,255,0.22)' : 'var(--accent-primary-soft)', color: on ? 'var(--cream)' : 'var(--accent)', fontWeight: 800, letterSpacing: 0 }}>{opt.count}</span>
                            )}
                          </button>
                        );
                      })}
                    </div>

                    {pearlsLessonsFilter === 'saved' ? (
                      savedLessonsInline.length === 0 ? (
                        <div className="rounded-[14px] border p-6 text-center" style={{ background: 'var(--cream)', borderColor: 'var(--line)' }}>
                          <Icon name="Bookmark" size={20} className="mx-auto mb-2 opacity-40" />
                          <div className="text-[13px]" style={{ color: 'var(--ink)', fontWeight: 700, letterSpacing: '-0.01em' }}>No saved lessons yet.</div>
                          <p className="text-[11px] mt-1 leading-snug" style={{ color: 'var(--ink-soft)' }}>Tap the bookmark inside any lesson modal to save it here for later.</p>
                        </div>
                      ) : (
                        <div className="space-y-2">
                          {savedLessonsInline.map(l => (
                            <button
                              key={l.id}
                              type="button"
                              onClick={() => setOpenLesson(l)}
                              className="w-full rounded-[12px] border px-3 py-2.5 text-left flex items-center justify-between gap-2"
                              style={{ background: 'var(--cream)', borderColor: 'var(--line)' }}
                            >
                              <span className="min-w-0">
                                <span className="block text-[13px] leading-tight" style={{ color: 'var(--ink)', fontWeight: 650 }}>{l.title}</span>
                                {l.body && <span className="block text-[10.5px] mt-1 leading-snug" style={{ color: 'var(--ink-soft)' }}>{l.body.slice(0, 80)}{l.body.length > 80 ? '…' : ''}</span>}
                              </span>
                              <Icon name="ChevronRight" size={11} className="opacity-50 flex-shrink-0" />
                            </button>
                          ))}
                        </div>
                      )
                    ) : (<>
                    <div className="rounded-[14px] border mb-3 overflow-hidden" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
                      <button
                        type="button"
                        onClick={() => setLessonsSavedOpen(v => !v)}
                        className="w-full px-3 py-2.5 flex items-center justify-between gap-3 text-left"
                      >
                        <div className="min-w-0 flex items-center gap-2">
                          <Icon name="Bookmark" size={12} style={{color:'var(--accent)'}} />
                          <span className="text-[9px] tracking-[0.22em] uppercase" style={{color:'var(--ink-soft)', fontWeight:650}}>Saved lessons</span>
                          <span className="text-[10px]" style={{color:'var(--ink-soft)'}}>{savedLessonsInline.length}</span>
                        </div>
                        <Icon name={lessonsSavedOpen ? 'ChevronUp' : 'ChevronDown'} size={13} style={{color:'var(--ink-soft)'}} />
                      </button>
                      {lessonsSavedOpen && (
                        <div className="px-3 pb-3 space-y-1.5 border-t" style={{borderColor: 'var(--line)'}}>
                          {savedLessonsInline.length === 0 ? (
                            <div className="text-[11px] leading-snug pt-2" style={{color:'var(--ink-soft)'}}>
                              Save lessons from any lesson modal and they will appear here as your reference shelf.
                            </div>
                          ) : savedLessonsInline.slice(0, 5).map(l => (
                            <button
                              key={l.id}
                              type="button"
                              onClick={() => setOpenLesson(l)}
                              className="w-full rounded-[12px] border px-3 py-2 text-left flex items-center justify-between gap-2"
                              style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}
                            >
                              <span className="text-[11.5px] leading-tight truncate" style={{color:'var(--ink)', fontWeight:650}}>{l.title}</span>
                              <Icon name="ChevronRight" size={11} style={{color:'var(--ink-soft)'}} />
                            </button>
                          ))}
                          {savedLessonsInline.length > 5 && (
                            <button
                              type="button"
                              onClick={() => setPearlsTab('saved')}
                              className="text-[9px] tracking-[0.18em] uppercase mt-1"
                              style={{color:'var(--accent)', fontWeight:650}}
                            >
                              View all saved
                            </button>
                          )}
                        </div>
                      )}
                    </div>

                    <div className="rounded-[16px] border p-3 mb-4" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
                      <div className="flex items-center justify-between gap-3 mb-2">
                        <div>
                          <div className="text-[9px] tracking-[0.24em] uppercase mb-1" style={{color:'var(--accent)', fontWeight:650}}>Learning map</div>
                          <div className="text-[14px] leading-tight" style={{color:'var(--ink)', fontWeight:700}}>Choose the next lens.</div>
                        </div>
                        <button
                          type="button"
                          onClick={() => setPearlsTab('signals')}
                          className="text-[8.5px] tracking-[0.14em] uppercase rounded-full border px-2.5 py-1.5"
                          style={{color:'var(--ink-soft)', borderColor: 'var(--line)', background:'var(--cream-deep)', fontWeight:700}}
                        >
                          Back to signals
                        </button>
                      </div>
                      <div className="grid grid-cols-4 gap-1.5">
                        {subtabs.map(chapter => {
                          const meta = chapterMeta[chapter.id];
                          const active = activeSubtab === chapter.id;
                          return (
                            <button
                              key={chapter.id}
                              type="button"
                              onClick={() => setPearlsLessonCategory(chapter.id)}
                              className="rounded-[11px] border px-2 py-2 text-center min-h-[58px] flex flex-col items-center justify-center gap-1"
                              style={{
                                background: active ? 'var(--surface-selected-soft)' : 'var(--cream-deep)',
                                borderColor: active ? 'var(--accent)' : 'var(--line)',
                              }}
                            >
                              <Icon name={chapter.icon} size={12} style={{color: active ? 'var(--accent)' : 'var(--ink-soft)'}} />
                              <span className="block text-[9.5px] leading-tight truncate max-w-full" style={{color:'var(--ink)', fontWeight:700}}>{chapter.label}</span>
                              <span className="block text-[8px]" style={{color: active ? 'var(--accent)' : 'var(--ink-soft)', fontWeight:700}}>{meta.count}</span>
                            </button>
                          );
                        })}
                      </div>
                      <div className="rounded-[12px] border px-3 py-2 mt-2" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                        <div className="text-[8px] tracking-[0.18em] uppercase" style={{color:'var(--ink-soft)', fontWeight:650}}>{chapterMeta[activeSubtab].eyebrow}</div>
                        <div className="text-[12px] leading-tight mt-0.5" style={{color:'var(--ink)', fontWeight:700}}>{chapterMeta[activeSubtab].title}</div>
                        <div className="text-[10px] leading-snug mt-0.5" style={{color:'var(--ink-soft)'}}>{chapterMeta[activeSubtab].body}</div>
                      </div>
                    </div>

                    {activeSubtab === 'start' && (
                      <div className="rounded-[14px] border p-3 mb-4" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
                        <div className="text-[9px] tracking-[0.24em] uppercase mb-2" style={{color:'var(--accent)', fontWeight:650}}>New user pathway</div>
                        <div className="grid grid-cols-2 md:grid-cols-4 gap-1.5">
                          {[
                            { n: '1', title: 'Barrier first', body: 'Keep skin calm before chasing actives.', action: () => setPearlsLessonCategory('concerns') },
                            { n: '2', title: 'Daily SPF', body: 'Make protection the non-negotiable AM step.', action: () => setOpenLesson(LESSONS.find(l => l.id === 'sunscreen-mechanisms')) },
                            { n: '3', title: 'One active', body: 'Choose one goal lane before stacking.', action: () => setPearlsLessonCategory('ingredients') },
                            { n: '4', title: 'Refine', body: 'Adjust the week from what your skin shows.', action: () => { setActiveTab('regimen'); setRegimenView('build'); } },
                          ].map(step => (
                            <button
                              key={step.n}
                              type="button"
                              onClick={step.action}
                              className="rounded-[12px] border p-2.5 text-left min-h-[76px]"
                              style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}
                            >
                              <span className="w-4 h-4 rounded-full border inline-flex items-center justify-center text-[9px] mb-1.5" style={{borderColor: 'var(--line)', color:'var(--accent)', fontWeight:700}}>{step.n}</span>
                              <span className="block text-[11.5px] leading-tight" style={{color:'var(--ink)', fontWeight:700}}>{step.title}</span>
                              <span className="block text-[9.5px] leading-snug mt-0.5" style={{color:'var(--ink-soft)'}}>{step.body}</span>
                            </button>
                          ))}
                        </div>
                      </div>
                    )}

                    {activeSubtab === 'routine' && (
                      <div className="rounded-[14px] border p-3 mb-4" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
                        {ownedRoutineTerms.length === 0 ? (
                          <div className="text-[11px] leading-snug rounded-[12px] border px-3 py-2" style={{color:'var(--ink-soft)', borderColor: 'var(--line)', background:'var(--cream-deep)'}}>
                            Add products to your shelf and Frida will turn your actual routine into a glossary.
                          </div>
                        ) : (
                          <div className="grid grid-cols-1 md:grid-cols-2 gap-1.5">
                            {ownedRoutineTerms.map(term => {
                              const lesson = term.lessonId ? LESSONS.find(l => l.id === term.lessonId) : null;
                              return (
                                <button
                                  key={term.family}
                                  type="button"
                                  onClick={() => lesson ? setOpenLesson(lesson) : setPearlsLessonCategory('ingredients')}
                                  className="rounded-[12px] border px-3 py-2 text-left flex items-center justify-between gap-2"
                                  style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}
                                >
                                  <span className="min-w-0">
                                    <span className="block text-[11.5px] leading-tight truncate" style={{color:'var(--ink)', fontWeight:700}}>{term.label}</span>
                                    <span className="block text-[10px] leading-snug mt-0.5 truncate" style={{color:'var(--ink-soft)'}}>{term.note}</span>
                                  </span>
                                  <Icon name="ChevronRight" size={11} style={{color:'var(--ink-soft)'}} />
                                </button>
                              );
                            })}
                          </div>
                        )}
                      </div>
                    )}

                    {activeSubtab === 'concerns' && (
                      <ConcernGuide onOpenLesson={setOpenLesson} framing="editorial" />
                    )}

                    {!['start', 'routine', 'concerns'].includes(activeSubtab) && filteredLessonsSub.length === 0 && (
                      <div className="border p-10 text-center" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                        <p className="text-sm font-light" style={{color:'var(--ink-soft)'}}>No lessons in this category yet — drafts coming.</p>
                      </div>
                    )}

                    {/* Compact lesson list — tuned to match the denser Regimen/Insights cards. */}
                    {!['start', 'routine', 'concerns'].includes(activeSubtab) && filteredLessonsSub.length > 0 && (
                      <div className="rounded-[14px] border overflow-hidden" style={{borderColor: 'var(--line)', background:'var(--cream)'}}>
                        {filteredLessonsSub.map((l, i) => (
                          <button
                            key={l.id}
                            onClick={() => setOpenLesson(l)}
                            className="w-full px-3 md:px-4 py-2.5 md:py-3 text-left transition hover:bg-[var(--cream-deep)] grid items-center gap-2"
                            style={{borderTop: i === 0 ? 'none' : '1px solid var(--line)', gridTemplateColumns:'minmax(0,1fr) auto'}}
                          >
                            <span className="min-w-0">
                              <span className="block text-[12.5px] md:text-[13.5px] leading-tight" style={{color:'var(--ink)', fontWeight:700}}>{l.title}</span>
                              <span className="block text-[10.5px] md:text-[11px] leading-snug mt-1 font-light" style={{color:'var(--ink-soft)'}}>{l.excerpt}</span>
                            </span>
                            <span className="flex items-center gap-1.5 flex-shrink-0">
                              {l.evidenceGrade && (
                                <span className="text-[8px] tracking-[0.14em] uppercase px-1.5 py-0.5 border" style={{borderColor: 'var(--line)', color:'var(--ink-soft)', fontWeight:650}}>{l.evidenceGrade}</span>
                              )}
                              <Icon name="ChevronRight" size={11} className="opacity-50" />
                            </span>
                          </button>
                        ))}
                      </div>
                    )}
                    </>)}
                  </>
                );
              })()}

              {/* === PICKS === */}
              {pearlsTab === 'picks' && (
                <div className="space-y-4">
                  <div className="rounded-[18px] border p-4" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
                    <div className="text-[10px] tracking-[0.25em] uppercase mb-1" style={{color:'var(--accent)', fontWeight:650}}>Picks</div>
                    <h2 className="text-[17px] leading-tight" style={{color:'var(--ink)', fontWeight:700, letterSpacing:'-0.01em'}}>Choose the next move.</h2>
                    <p className="text-[12px] leading-relaxed mt-2" style={{color:'var(--ink-soft)'}}>
                      Shelf options appear first when they fit. Suggested buys show only when they close a gap.
                    </p>
                  </div>

                  <div className="grid grid-cols-4 gap-1 rounded-[16px] border p-1" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
                    {picksViewOptions.map(option => {
                      const active = picksView === option.id;
                      return (
                        <button
                          key={option.id}
                          type="button"
                          onClick={() => setPicksView(option.id)}
                          className="rounded-[12px] px-2 py-2 text-[9px] md:text-[9.5px] tracking-[0.14em] uppercase transition flex items-center justify-center gap-1.5 min-w-0"
                          style={{
                            background: active ? 'var(--surface-selected-soft)' : 'transparent',
                            color: active ? 'var(--accent)' : 'var(--ink-soft)',
                            fontWeight:700,
                          }}
                        >
                          <span className="truncate">{option.label}</span>
                          {option.count !== null && <span className="opacity-70">{option.count}</span>}
                        </button>
                      );
                    })}
                  </div>

                  {picksView === 'suggestions' && (() => {
                    /* === SUGGESTIONS (May 31 2026 per Jenni) ===
                       Shelf fits first, then catalog gap-closers. The action
                       goal + concern chips drive both sections; the catalog
                       half is suppressed for any (productCategory, active
                       family) the shelf already covers. */
                    const goalForCopy = (buildAnswers && buildAnswers.actionGoal)
                      ? String(buildAnswers.actionGoal).toLowerCase()
                      : 'your goal';
                    // === QUICK-ADD TO ROUTINE (2026-05-31 per Jenni) ===
                    // One-tap from a suggestion card → product gets slotted
                    // into AM/PM with a daily cadence. NEVER rebuilds the
                    // full routine — user keeps custom tweaks. For NEW
                    // (catalog) items, also adds to shelf first.
                    //
                    // Slot inference: SPF/vitc → AM, retinoid/aha/bha →
                    // PM, cleanser/moisturizer → both, anything else → PM
                    // default (matches existing slot-bias used elsewhere
                    // in build/scheduler code).
                    const inferSlotForQuickAdd = (p) => {
                      const hay = `${p.category || ''} ${p.name || ''} ${p.actives || ''} ${p.main || ''}`.toLowerCase();
                      if (/\bspf\b|sunscreen|broad[- ]spectrum/.test(hay)) return ['am'];
                      if (/\bvitamin c\b|\bvit\s*c\b|\b(l-)?ascorbic\b|\bferulic\b/.test(hay)) return ['am'];
                      if (/\b(retinoid|retinol|retin|tretinoin|tazarotene|adapalene|retinaldehyde|retinyl|bakuchiol)\b/.test(hay)) return ['pm'];
                      if (/\b(aha|bha|glycolic|lactic|salicylic|mandelic|azelaic)\b/.test(hay)) return ['pm'];
                      if (/cleanser|cleansing|face wash|cleansing oil|cleansing balm/.test(hay)) return ['am','pm'];
                      if (/moisturizer|moisturising|cream|lotion|emulsion|gel cream/.test(hay)) return ['am','pm'];
                      // Default: PM (safer for unknown actives — won't
                      // collide with SPF or sun exposure).
                      return ['pm'];
                    };
                    const slotLabel = (slots) => slots.length === 2 ? 'AM + PM'
                      : slots[0] === 'am' ? 'AM' : 'PM';
                    const handleQuickAddOnShelf = (catalogP) => {
                      // Find the actual shelf product by name+brand match.
                      const sig = `${(catalogP.brand || '').toLowerCase()}|${(catalogP.name || '').toLowerCase()}`;
                      const shelfP = (products || []).find(sp => `${(sp.brand || '').toLowerCase()}|${(sp.name || '').toLowerCase()}` === sig);
                      if (!shelfP) {
                        toast('Could not find this on your shelf.', 'error');
                        return;
                      }
                      const slots = inferSlotForQuickAdd(shelfP);
                      // === CENTRALIZED via addProductToRoutine (June 2026 refactor) ===
                      // For Picks quick-add, useTimes comes from inferSlotForQuickAdd
                      // (not addProductToRoutine's default slot wiring), but cadence
                      // is still safety-resolved through the helper to prevent the
                      // over-scheduling bug (Codex flagged).
                      const promoted = addProductToRoutine({ ...shelfP, useTimes: slots }, slots[0] || 'am');
                      const updated = (products || []).map(p =>
                        p.id === shelfP.id ? sanitizeProductForSave(promoted) : p
                      );
                      setProducts(updated);
                      saveData('products', updated);
                      setCoverRoutineRebuildToken(t => t + 1);
                      toast(`Slotted into ${slotLabel(slots)}. Edit in Regimen if needed.`, 'success');
                    };
                    const handleQuickAddNewBuy = (catalogP) => {
                      // Build a fresh shelf product from the catalog item.
                      const slots = inferSlotForQuickAdd(catalogP);
                      // === SAFETY: USE SUGGESTED CADENCE (June 2026 per Codex) ===
                      const sug = suggestedCadence(catalogP.category, catalogP.actives || catalogP.main);
                      const newProduct = sanitizeProductForSave({
                        id: Date.now() + Math.floor(Math.random() * 1000),
                        brand: catalogP.brand || '',
                        name: catalogP.name || '',
                        category: catalogP.category || 'treatment',
                        actives: catalogP.actives || catalogP.main || '',
                        main: catalogP.main || catalogP.actives || '',
                        priceTier: catalogP.priceTier || catalogP.tier || '$$',
                        useTimes: slots,
                        cadence: { days: sug.days, frequency: sug.days.length },
                        addedAt: Date.now(),
                        startDate: new Date().toISOString().slice(0, 10),
                      });
                      const updated = [...(products || []), newProduct];
                      setProducts(updated);
                      saveData('products', updated);
                      setCoverRoutineRebuildToken(t => t + 1);
                      toast(`Added to shelf + slotted into ${slotLabel(slots)}.`, 'success');
                    };
                    const renderSuggestionCard = (p, i, scope) => {
                      const ownedMatch = p._source === 'shelf';
                      const key = ownedMatch ? `shelf-${p.id || p.brand || ''}-${p.name || i}` : offShelfKey(p);
                      const saved = !ownedMatch && isFavorited(p);
                      const fit = ownedMatch ? 'On shelf' : ((p._score || 0) >= 48 ? 'Solid pick' : (p._score || 0) >= 24 ? 'Worth a shot' : 'Long shot');
                      const actionTag = picksActionFilter !== 'all' && (p._tags || []).includes(picksActionFilter) ? picksActionFilter : (p._tags || [])[0];
                      const actionLabel = picksActionFilters.find(g => g.id === actionTag)?.label || 'Curated';
                      const concernLabel = (p._concernHits || [])[0];
                      // === ONE-LINE WHY (2026-05-31 per Jenni) ===
                      // Short reason this product matched. Reads as the
                      // doctor-friend voice: direct, names the lane, no
                      // marketing flourish. Falls back gracefully when
                      // we don't know the active or concern.
                      const oneLineWhy = (() => {
                        const concern = concernLabel ? String(concernLabel).toLowerCase() : null;
                        const primaryActive = (p.actives || p.main || '').toString().trim();
                        const goalWord = actionLabel ? String(actionLabel).toLowerCase() : null;
                        if (ownedMatch) {
                          if (concern && primaryActive) return `Covers ${concern} via ${primaryActive}.`;
                          if (concern) return `Already in your ${concern} lane.`;
                          if (goalWord) return `Already covers ${goalWord}.`;
                          return null;
                        }
                        if (concern && primaryActive) return `Closes the ${concern} gap with ${primaryActive}.`;
                        if (concern) return `Closes a ${concern} gap.`;
                        if (goalWord && primaryActive) return `Adds ${goalWord} via ${primaryActive}.`;
                        if (goalWord) return `Adds a ${goalWord} lane.`;
                        return null;
                      })();
                      return (
                        <div key={`${scope}-${key || `${p.brand}-${p.name}-${i}`}`} className="rounded-[14px] border p-3" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                          <div className="flex items-start justify-between gap-3">
                            <button
                              type="button"
                              onClick={() => {
                                const willOpen = expandedSuggestedKey !== key;
                                setExpandedSuggestedKey(willOpen ? key : null);
                                if (!ownedMatch && willOpen && !offShelfAssessment[key] && offShelfAssessing !== key) assessOffShelfProduct(p);
                              }}
                              className="min-w-0 flex-1 text-left"
                            >
                              <div className="text-[8.5px] tracking-[0.22em] uppercase mb-0.5" style={{color:'var(--accent)', fontWeight:700}}>{actionLabel}{concernLabel ? ` · ${concernLabel}` : ''}</div>
                              <div className="text-[8.5px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)'}}>{p.brand}</div>
                              <div className="text-[13px] leading-tight mt-0.5" style={{color:'var(--ink)', fontWeight:700}}>{p.name}</div>
                              <div className="text-[10.5px] mt-1 leading-snug" style={{color:'var(--ink-soft)'}}>{p.actives || p.main || p.category}</div>
                              {oneLineWhy && (
                                <div className="text-[11px] mt-1.5 leading-snug" style={{color:'var(--ink)'}}>{oneLineWhy}</div>
                              )}
                            </button>
                            <div className="flex items-center gap-1.5 flex-shrink-0">
                              <span className="rounded-full px-2.5 py-1 text-[8.5px] tracking-[0.14em] uppercase" style={{background: ownedMatch ? 'var(--accent)' : 'var(--ink)', color:'var(--cream)', fontWeight:700}}>{fit}</span>
                              {!ownedMatch && (
                                <button
                                  type="button"
                                  onClick={() => toggleFavorite(p)}
                                  className="w-8 h-8 rounded-full border flex items-center justify-center"
                                  style={{borderColor: 'var(--line)', color:'var(--accent)', background: saved ? 'var(--surface-selected-soft)' : 'var(--cream)'}}
                                  aria-label={saved ? 'Remove from saved' : 'Save for later'}
                                >
                                  <Icon name="Heart" size={13} fill={saved ? 'currentColor' : 'none'} />
                                </button>
                              )}
                            </div>
                          </div>
                          {/* === QUICK-ADD CTA (2026-05-31 per Jenni) ===
                              One-tap action per card. Never rebuilds the
                              routine — just slots the product. Toast
                              confirms the slot so user can verify or
                              edit in Regimen. */}
                          <div className="mt-2.5 pt-2.5 flex justify-end" style={{borderTop:'1px solid var(--line)'}}>
                            <button
                              type="button"
                              onClick={(e) => {
                                e.stopPropagation();
                                if (ownedMatch) handleQuickAddOnShelf(p);
                                else handleQuickAddNewBuy(p);
                              }}
                              className="text-[10px] tracking-[0.18em] uppercase flex items-center gap-1 transition hover:opacity-75"
                              style={{color:'var(--accent)', fontWeight:700, cursor:'pointer'}}
                              aria-label={ownedMatch ? 'Add to your routine' : "Mark as bought and add to routine"}
                            >
                              {ownedMatch ? 'Add to routine' : 'I bought it'}
                              <Icon name="ArrowRight" size={11} />
                            </button>
                          </div>
                          {expandedSuggestedKey === key && (
                            <div className="rounded-[12px] border p-3 mt-3 text-[11px] leading-relaxed whitespace-pre-wrap" style={{background:'var(--cream)', borderColor: 'var(--line)', color:'var(--ink-soft)'}}>
                              {ownedMatch
                                ? 'Already on your shelf. Use this before buying: add it to the weekly rotation, then watch whether the signal improves over the next few check-ins.'
                                : (offShelfAssessing === key ? 'Analyzing mechanism, evidence, and alternatives...' : (offShelfAssessment[key] || 'Tap again to analyze this match.'))}
                            </div>
                          )}
                        </div>
                      );
                    };
                    return (
                      <div className="rounded-[14px] border p-3" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
                        <div className="flex items-center justify-between gap-3 mb-3">
                          <div>
                            <div className="text-[10px] tracking-[0.25em] uppercase" style={{color:'var(--accent)', fontWeight:650}}>Suggestions for this signal</div>
                            <div className="text-[12px] mt-1 leading-snug" style={{color:'var(--ink-soft)'}}>Owned shelf fits first, then outside options only when your shelf has a gap.</div>
                          </div>
                          <button
                            type="button"
                            onClick={() => setPicksSuggestSeed(s => s + 1)}
                            className="rounded-full border w-8 h-8 flex items-center justify-center flex-shrink-0"
                            style={{borderColor: 'var(--line)', color:'var(--ink-soft)', background:'var(--cream-deep)'}}
                            aria-label="Refresh suggestions"
                          >
                            <Icon name="RefreshCw" size={12} />
                          </button>
                        </div>

                        <div className="flex items-baseline justify-between mb-1">
                          <div className="text-[8.5px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)', fontWeight:700}}>Action goal</div>
                          <div className="text-[8.5px] tracking-[0.14em] uppercase" style={{color:'var(--ink-soft)', fontWeight:650, fontStyle:'normal'}}>
                            {picksActionFilter === 'all' ? 'Showing top picks' : 'Tap to clear'}
                          </div>
                        </div>
                        <div className="flex gap-1.5 overflow-x-auto no-scrollbar mb-3">
                          {picksActionFilters.map(goal => {
                            const active = picksActionFilter === goal.id;
                            return (
                              <button
                                key={goal.id}
                                type="button"
                                // Toggle: clicking the active pill deselects
                                // back to 'all' (= curated top picks). 2026-05-31.
                                onClick={() => setPicksActionFilter(active ? 'all' : goal.id)}
                                title={active ? `${goal.hint} — tap to clear` : goal.hint}
                                className="rounded-full border px-3 py-1.5 text-[9.5px] tracking-[0.14em] uppercase whitespace-nowrap"
                                style={{
                                  background: active ? 'var(--ink)' : 'var(--cream-deep)',
                                  color: active ? 'var(--cream)' : 'var(--ink-soft)',
                                  borderColor: active ? 'var(--ink)' : 'var(--line)',
                                  fontWeight:700,
                                }}
                              >
                                {goal.label}
                              </button>
                            );
                          })}
                        </div>

                        <div className="text-[8.5px] tracking-[0.2em] uppercase mb-1" style={{color:'var(--ink-soft)', fontWeight:700}}>Observed concern</div>
                        <div className="flex gap-1.5 overflow-x-auto no-scrollbar mb-3">
                          {(userConcerns || []).map(c => {
                            const active = picksConcernActive(c);
                            return (
                              <button
                                key={c}
                                type="button"
                                onClick={() => togglePicksConcern(c)}
                                className="rounded-full px-3 py-1.5 text-[10px] tracking-[0.04em] whitespace-nowrap flex items-center gap-1.5"
                                style={{
                                  background: active ? 'var(--accent)' : 'var(--cream-deep)',
                                  color: active ? 'var(--cream)' : 'var(--ink-soft)',
                                  border:'1px solid ' + (active ? 'var(--accent)' : 'var(--line)'),
                                  fontWeight:650,
                                }}
                              >
                                {c}
                                {active && <span style={{opacity:0.65}}>×</span>}
                              </button>
                            );
                          })}
                          {(!userConcerns || userConcerns.length === 0) && (
                            <span className="text-[10.5px]" style={{color:'var(--ink-soft)'}}>Add concerns in profile to personalize matches.</span>
                          )}
                        </div>

                        {/* T2 (May 31 2026): $ / $$ / $$$ filter chips —
                            narrow BOTH shelf and catalog suggestion pools
                            by priceTier. Same chip pattern as action goals
                            above, but using accent fill for active state to
                            visually distinguish from goal pills. */}
                        <div className="text-[8.5px] tracking-[0.2em] uppercase mb-1" style={{color:'var(--ink-soft)', fontWeight:700}}>Budget</div>
                        <div className="flex gap-1.5 overflow-x-auto no-scrollbar mb-3">
                          {[
                            { id: 'all', label: 'All' },
                            { id: 'budget', label: '$' },
                            { id: 'mid', label: '$$' },
                            { id: 'luxury', label: '$$$' },
                          ].map(chip => {
                            const active = picksBudgetFilter === chip.id;
                            return (
                              <button
                                key={chip.id}
                                type="button"
                                onClick={() => setPicksBudgetFilter(chip.id)}
                                className="rounded-full border px-3 py-1.5 text-[9.5px] tracking-[0.14em] uppercase whitespace-nowrap"
                                style={{
                                  background: active ? 'var(--accent)' : 'var(--cream-deep)',
                                  color: active ? 'var(--cream)' : 'var(--ink-soft)',
                                  borderColor: active ? 'var(--accent)' : 'var(--line)',
                                  fontWeight:700,
                                }}
                              >
                                {chip.label}
                              </button>
                            );
                          })}
                        </div>

                        {/* Section 1 — From your shelf */}
                        <div className="text-[9px] tracking-[0.22em] uppercase mb-2" style={{color:'var(--ink-soft)', fontWeight:700}}>From your shelf</div>
                        <div className="space-y-2 mb-4">
                          {shelfSuggestedMatchesInline.length === 0 ? (
                            <div className="rounded-[12px] border p-3 text-[12px] leading-snug" style={{background:'var(--cream-deep)', borderColor: 'var(--line)', color:'var(--ink-soft)'}}>
                              {picksBudgetFilter !== 'all'
                                ? `No ${picksBudgetFilter === 'budget' ? '$' : picksBudgetFilter === 'mid' ? '$$' : '$$$'} options for ${goalForCopy} right now.`
                                : 'Nothing on your shelf matches this goal + concern combo. Check the catalog options below.'}
                            </div>
                          ) : shelfSuggestedMatchesInline.map((p, i) => renderSuggestionCard(p, i, 'shelf'))}
                        </div>

                        {/* Section 2 — Worth considering */}
                        <div className="text-[9px] tracking-[0.22em] uppercase mb-2" style={{color:'var(--ink-soft)', fontWeight:700}}>Worth considering</div>
                        <div className="space-y-2">
                          {buySuggestedMatchesInline.length === 0 ? (
                            <div className="rounded-[12px] border p-3 text-[12px] leading-snug" style={{background:'var(--cream-deep)', borderColor: 'var(--line)', color:'var(--ink-soft)'}}>
                              {picksBudgetFilter !== 'all'
                                ? `No ${picksBudgetFilter === 'budget' ? '$' : picksBudgetFilter === 'mid' ? '$$' : '$$$'} options for ${goalForCopy} right now.`
                                : `Your shelf has good coverage for ${goalForCopy}. No outside picks needed right now.`}
                            </div>
                          ) : buySuggestedMatchesInline.map((p, i) => renderSuggestionCard(p, i, 'buy'))}
                        </div>
                      </div>
                    );
                  })()}

                  {picksView === 'bench' && (
                    /* === BENCH (May 31 2026 per Jenni) ===
                       Owned products NOT currently scheduled in the built
                       routine (Unused) + products that share an active family
                       with something already in rotation (Overlap). The badge
                       count = unusedProducts.length + overlapGroups.length. */
                    <div className="rounded-[14px] border p-3" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
                      <div className="flex items-start justify-between gap-3 mb-3">
                        <div>
                          <div className="text-[10px] tracking-[0.25em] uppercase" style={{color:'var(--accent)', fontWeight:650}}>Bench</div>
                          <div className="text-[12px] mt-1 leading-snug" style={{color:'var(--ink-soft)'}}>Products on the bench — not currently in your routine, or overlapping something active.</div>
                        </div>
                        <span className="rounded-full border px-3 py-1.5 text-[9px] tracking-[0.14em] uppercase flex-shrink-0" style={{borderColor: 'var(--line)', color:'var(--ink-soft)', background:'var(--cream-deep)', fontWeight:700}}>
                          {benchCount || 'Clear'}
                        </span>
                      </div>

                      {/* Unused — owned but not scheduled in buildPlan */}
                      <div className="text-[9px] tracking-[0.22em] uppercase mb-2" style={{color:'var(--ink-soft)', fontWeight:700}}>Unused — owned but not in routine</div>
                      <div className="space-y-2 mb-4">
                        {unusedProducts.length === 0 ? (
                          <div className="rounded-[12px] border p-3 text-[12px] leading-snug" style={{borderColor: 'var(--line)', background:'var(--cream-deep)', color:'var(--ink-soft)'}}>
                            Every owned product is already scheduled in your routine.
                          </div>
                        ) : (
                          unusedProducts.slice(0, 8).map(p => {
                            const fam = productBudgetFamily(p);
                            const tier = p.priceTier || (typeof productTier === 'function' ? productTier(p) : '') || '$$';
                            return (
                              <div key={p.id || `${p.brand}-${p.name}`} className="rounded-[14px] border p-3 flex items-start justify-between gap-3" style={{borderColor: 'var(--line)', background:'var(--cream-deep)'}}>
                                <div className="min-w-0">
                                  <div className="text-[9px] tracking-[0.22em] uppercase mb-0.5" style={{color:'var(--ink-soft)'}}>{p.brand || fam}</div>
                                  <div className="text-[13px] leading-tight" style={{color:'var(--ink)', fontWeight:650}}>{p.name || p.displayName}</div>
                                  <span className="inline-flex mt-2 text-[8.5px] tracking-[0.13em] uppercase rounded-full border px-2 py-0.5" style={{borderColor: 'var(--line)', color:'var(--ink-soft)'}}>{fam}</span>
                                </div>
                                <div className="flex flex-col items-end gap-1.5 flex-shrink-0">
                                  <div className="text-[11px] tracking-[0.18em] uppercase" style={{color:'var(--accent)', fontWeight:700}}>{tier}</div>
                                  <button
                                    type="button"
                                    onClick={() => { setActiveTab('regimen'); setRegimenView('build'); }}
                                    className="text-[9px] tracking-[0.16em] uppercase rounded-full border px-2.5 py-1"
                                    style={{borderColor: 'var(--accent)', color:'var(--accent)', background:'var(--cream)', fontWeight:700}}
                                  >
                                    Add to routine
                                  </button>
                                </div>
                              </div>
                            );
                          })
                        )}
                      </div>

                      {/* Overlap — products that share an active family */}
                      <div className="text-[9px] tracking-[0.22em] uppercase mb-2" style={{color:'var(--ink-soft)', fontWeight:700}}>Overlapping with active products</div>
                      {overlapGroups.length === 0 ? (
                        <div className="rounded-[12px] border p-3 text-[12px] leading-snug" style={{borderColor: 'var(--line)', background:'var(--cream-deep)', color:'var(--ink-soft)'}}>
                          No obvious duplicate lanes. Your current routine is not repeating the same job heavily.
                        </div>
                      ) : (
                        <div className="space-y-2">
                          {overlapGroups.slice(0, 8).map(group => (
                            <div key={group.family} className="rounded-[14px] border p-3" style={{borderColor: 'var(--line)', background:'var(--cream-deep)'}}>
                              <div className="flex items-start justify-between gap-3 mb-2">
                                <div>
                                  <div className="text-[8.5px] tracking-[0.2em] uppercase" style={{color:'var(--accent)', fontWeight:700}}>Repeated lane</div>
                                  <div className="text-[13px] leading-tight mt-0.5" style={{color:'var(--ink)', fontWeight:700}}>{group.label}</div>
                                </div>
                                <span className="text-[8.5px] tracking-[0.14em] uppercase rounded-full border px-2 py-1 flex-shrink-0" style={{borderColor: 'var(--line)', color:'var(--ink-soft)', background:'var(--cream)'}}>{group.items.length} products</span>
                              </div>
                              <div className="space-y-1.5">
                                {group.items.slice(0, 4).map(p => (
                                  <div key={p.id || `${p.brand}-${p.name}`} className="rounded-[10px] border px-2.5 py-2" style={{borderColor: 'var(--line)', background:'var(--cream)'}}>
                                    <div className="text-[8px] tracking-[0.18em] uppercase" style={{color:'var(--ink-soft)'}}>{p.brand || group.label}</div>
                                    <div className="text-[11.5px] leading-tight mt-0.5" style={{color:'var(--ink)', fontWeight:650}}>{p.name || p.displayName}</div>
                                  </div>
                                ))}
                              </div>
                              <div className="text-[10.5px] leading-snug mt-2" style={{color:'var(--ink-soft)'}}>
                                Decide whether each product has a different timing, texture, or purpose. If not, one can probably rotate out.
                              </div>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  )}

                  {picksView === 'budget' && (
                    /* === BUDGET PICKS (May 31 2026 per Jenni) ===
                       Drugstore-tier ($) catalog matches scored against the
                       user's actionGoal + observed concerns. Card style
                       mirrors the Suggestions "Worth considering" section
                       so users have visual continuity, plus a small
                       "Budget pick · $" badge to make the tier explicit.
                       Derm endorsements (new catalog field on the 120 new
                       entries) render as a tiny eyebrow chip above the
                       brand line — short label like "Dr. Dray • IG". */
                    <div className="rounded-[14px] border p-3" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
                      <div className="flex items-start justify-between gap-3 mb-3">
                        <div>
                          <div className="text-[10px] tracking-[0.25em] uppercase" style={{color:'var(--accent)', fontWeight:650}}>Budget picks</div>
                          <div className="text-[12px] mt-1 leading-snug" style={{color:'var(--ink-soft)'}}>Drugstore-tier matches for your goal. Same scoring as Suggestions, narrowed to the $ shelf.</div>
                        </div>
                        <span className="rounded-full border px-3 py-1.5 text-[9px] tracking-[0.14em] uppercase flex-shrink-0" style={{borderColor: 'var(--line)', color:'var(--ink-soft)', background:'var(--cream-deep)', fontWeight:700}}>
                          {budgetSuggestedMatchesInline.length || 'None'}
                        </span>
                      </div>
                      <div className="text-[9px] tracking-[0.22em] uppercase mb-2" style={{color:'var(--ink-soft)', fontWeight:700}}>BUDGET PICKS — drugstore-tier matches for your goal</div>
                      <div className="space-y-2">
                        {budgetSuggestedMatchesInline.length === 0 ? (
                          <div className="rounded-[12px] border p-3 text-[12px] leading-snug" style={{background:'var(--cream-deep)', borderColor: 'var(--line)', color:'var(--ink-soft)'}}>
                            No drugstore-tier matches for this goal + concern combo yet.
                          </div>
                        ) : budgetSuggestedMatchesInline.map((p, i) => {
                          // Compact derm chip — collapse long strings like
                          // "Andrea Suarez (drdrayzday) YT: Drugstore Roundup"
                          // into a short, scannable label.
                          const dermLabelShort = (raw) => {
                            if (!raw) return '';
                            const s = String(raw);
                            // Pick first parenthetical handle if present.
                            const handle = (s.match(/\(([^)]+)\)/) || [])[1];
                            const platform = /IG\b|Instagram/i.test(s) ? 'IG'
                              : /YT\b|YouTube/i.test(s) ? 'YT'
                              : /TikTok/i.test(s) ? 'TikTok'
                              : '';
                            if (handle) return platform ? `${handle} • ${platform}` : handle;
                            // Fallback: grab the first "Dr. X" or "X MD" phrase.
                            const dr = (s.match(/(Dr\.?\s+\w+|\w+\s+MD)/) || [])[1];
                            if (dr) return platform ? `${dr} • ${platform}` : dr;
                            return s.length > 40 ? s.slice(0, 40) + '…' : s;
                          };
                          const dermChip = p.derm_endorsement ? dermLabelShort(p.derm_endorsement) : null;
                          const concernLabel = (p._concernHits || [])[0];
                          const actionTag = (p._tags || [])[0];
                          const actionLabel = picksActionFilters.find(g => g.id === actionTag)?.label || 'Budget';
                          return (
                            <div key={`budget-${p.brand}-${p.name}-${i}`} className="rounded-[14px] border p-3" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                              <div className="flex items-start justify-between gap-3">
                                <div className="min-w-0 flex-1">
                                  {dermChip && (
                                    <div className="inline-flex items-center rounded-full px-2 py-0.5 mb-1 text-[8.5px] tracking-[0.14em] uppercase" style={{background:'var(--surface-selected-soft)', color:'var(--accent)', fontWeight:700}}>{dermChip}</div>
                                  )}
                                  <div className="text-[8.5px] tracking-[0.22em] uppercase mb-0.5" style={{color:'var(--accent)', fontWeight:700}}>{actionLabel}{concernLabel ? ` · ${concernLabel}` : ''}</div>
                                  <div className="text-[8.5px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)'}}>{p.brand}</div>
                                  <div className="text-[13px] leading-tight mt-0.5" style={{color:'var(--ink)', fontWeight:700}}>{p.name}</div>
                                  <div className="text-[10.5px] mt-1 leading-snug" style={{color:'var(--ink-soft)'}}>{p.actives || p.main || p.category}</div>
                                  {p.evidence_tier && (
                                    <div className="text-[9.5px] mt-1.5" style={{color:'var(--ink-soft)'}}>{String(p.evidence_tier).replace(/-/g, ' ')}</div>
                                  )}
                                </div>
                                <div className="flex flex-col items-end gap-1.5 flex-shrink-0">
                                  <span className="rounded-full px-2.5 py-1 text-[8.5px] tracking-[0.14em] uppercase whitespace-nowrap" style={{background:'var(--accent)', color:'var(--cream)', fontWeight:700}}>Budget pick · $</span>
                                </div>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  )}

                  {picksView === 'regimen' && (() => {
                    /* === IDEAL COMP (May 30 2026 per Jenni) ===
                       Side-by-side current vs ideal routine, per step,
                       AM + PM. Three states: covered / suboptimal / missing.
                       Pulls from the same data the right-edge drawer reads. */
                    const STEPS_PG = [
                      { key:'cleanser',   label:'Cleanser' },
                      { key:'toner',      label:'Toner / Essence' },
                      { key:'serum',      label:'Serum / Treatment' },
                      { key:'moisturizer',label:'Moisturizer' },
                      { key:'oil',        label:'Face oil' },
                      { key:'spf',        label:'SPF' }
                    ];
                    const IDEAL_PG = {
                      BARRIER:  { cleanser:{t:'Low-pH, non-stripping gel', a:'BHA <2%, no SLS'}, toner:{t:'Hydrating, no astringents', a:'PHA, panthenol'}, serum:{t:'Niacinamide 5%', a:'Niacinamide, peptides'}, moisturizer:{t:'Ceramide + cholesterol cream', a:'Ceramides, squalane'}, oil:{t:'Optional night seal', a:'Squalane'}, spf:{t:'Mineral SPF 50', a:'Zinc oxide >=10%'} },
                      CALM:     { cleanser:{t:'Cream or oil cleanser', a:'Centella, no fragrance'}, toner:{t:'Centella / madecassoside', a:'Centella, allantoin'}, serum:{t:'Azelaic 10% or centella', a:'Azelaic, madecassoside'}, moisturizer:{t:'Fragrance-free cream', a:'Ceramides, niacinamide'}, oil:{t:'Skip — keep it minimal', a:''}, spf:{t:'Mineral SPF 50', a:'Zinc oxide'} },
                      HYDRATION:{ cleanser:{t:'Cream or milky cleanser', a:'Glycerin, no SLS'}, toner:{t:'Layering hydration toner', a:'HA, glycerin'}, serum:{t:'B5 / panthenol serum', a:'Panthenol, polyglutamic acid'}, moisturizer:{t:'Occlusive-light cream', a:'Squalane, ceramides'}, oil:{t:'Night seal', a:'Squalane'}, spf:{t:'Moisturizing SPF 50', a:'Hybrid filters'} },
                      PIGMENT:  { cleanser:{t:'Gentle gel cleanser', a:'No physical scrub'}, toner:{t:'Mandelic or PHA toner', a:'Mandelic 5%'}, serum:{t:'Vit C AM, Azelaic PM', a:'L-AA 10-15%, azelaic 10%'}, moisturizer:{t:'Niacinamide cream', a:'Niacinamide 5%'}, oil:{t:'Optional', a:''}, spf:{t:'Mineral SPF 50 — non-negotiable', a:'Zinc oxide'} },
                      PIH:      { cleanser:{t:'Gentle non-foaming cleanser', a:'No physical scrub, low pH'}, toner:{t:'Mandelic 5% (gentler on PIH)', a:'Mandelic acid'}, serum:{t:'Azelaic 10% AM, Tranexamic 2-5% PM', a:'Azelaic, tranexamic acid'}, moisturizer:{t:'Niacinamide 5% cream', a:'Niacinamide'}, oil:{t:'Optional', a:''}, spf:{t:'TINTED mineral SPF 50 (iron oxides essential)', a:'Zinc oxide + iron oxides — visible light protection critical'} },
                      TEXTURE:  { cleanser:{t:'Low-pH gel', a:'BHA <2%'}, toner:{t:'BHA or PHA exfoliating', a:'BHA, PHA'}, serum:{t:'Retinoid PM, Niacinamide AM', a:'Retinoid 0.025-0.05%'}, moisturizer:{t:'Ceramide cream', a:'Ceramides'}, oil:{t:'Skip during retinoid purge', a:''}, spf:{t:'SPF 50', a:'Hybrid'} },
                      TOP:      { cleanser:{t:'Low-pH gel', a:'Gentle surfactants'}, toner:{t:'Hydrating toner', a:'HA, PHA'}, serum:{t:'Niacinamide 5%', a:'Niacinamide'}, moisturizer:{t:'Ceramide cream', a:'Ceramides, squalane'}, oil:{t:'Optional', a:''}, spf:{t:'SPF 50', a:'Mineral or hybrid'} },
                      ACNE:     { cleanser:{t:'Salicylic acid wash 2%', a:'BHA 2%'}, toner:{t:'BHA toner if tolerated', a:'Salicylic acid'}, serum:{t:'Adapalene 0.1% PM, Niacinamide AM', a:'Adapalene, niacinamide'}, moisturizer:{t:'Lightweight non-comedogenic gel', a:'Hyaluronic acid, zinc'}, oil:{t:'Skip', a:''}, spf:{t:'Non-comedogenic SPF 50', a:'Hybrid or mineral'} },
                      AGING:    { cleanser:{t:'Gentle cream cleanser', a:'No SLS, glycerin'}, toner:{t:'Hydrating + antioxidant', a:'Polyglutamic acid, niacinamide'}, serum:{t:'Vit C AM, Retinoid PM', a:'L-AA 10-15%, retinol/retinal/tret'}, moisturizer:{t:'Peptide + ceramide cream', a:'Peptides, ceramides, squalane'}, oil:{t:'Optional night seal', a:'Squalane, rosehip'}, spf:{t:'Tinted mineral SPF 50', a:'Zinc + iron oxides'} },
                      ROSACEA:  { cleanser:{t:'Non-foaming cream/oil cleanser', a:'Fragrance-free, low pH'}, toner:{t:'Centella or skip', a:'Centella, allantoin'}, serum:{t:'Azelaic 15% (Rx) or 10% (OTC) AM+PM, ivermectin if Rx', a:'Azelaic 10-15%, brimonidine'}, moisturizer:{t:'Barrier cream with ceramides', a:'Ceramides, niacinamide 4-5%'}, oil:{t:'Skip during flare', a:''}, spf:{t:'Mineral SPF 50 only', a:'Zinc oxide 10%+'} },
                      SEBORRHEIC:{cleanser:{t:'BHA gel cleanser', a:'Salicylic acid 2%'}, toner:{t:'BHA or PHA exfoliating', a:'Salicylic, mandelic'}, serum:{t:'Niacinamide 10% AM, retinoid PM', a:'Niacinamide 10%, retinoid'}, moisturizer:{t:'Lightweight gel-cream', a:'Hyaluronic acid, zinc'}, oil:{t:'Skip', a:''}, spf:{t:'Mattifying SPF 50', a:'Hybrid, oil-free'} }
                    };
                    const goal = (buildAnswers && buildAnswers.actionGoal) ? String(buildAnswers.actionGoal).toUpperCase() : 'BARRIER';
                    const ideal = IDEAL_PG[goal] || IDEAL_PG.BARRIER;
                    const todayIso = (typeof localDateISO === 'function') ? localDateISO() : new Date().toISOString().slice(0,10);
                    const ritual = (typeof getRitualForDate === 'function')
                      ? getRitualForDate(todayIso, regimenLogs, products)
                      : { amProducts: [], pmProducts: [] };
                    const normCat = (p) => {
                      const c = (typeof normalizeProductCategory === 'function') ? normalizeProductCategory(p.category) : String(p.category||'').toLowerCase();
                      return c === 'treatment' ? 'serum' : c;
                    };
                    const byTypeFor = (arr) => {
                      const out = {};
                      (arr||[]).forEach(p => {
                        const c = normCat(p);
                        if (!out[c]) out[c] = p;
                      });
                      return out;
                    };
                    const amByType = byTypeFor(ritual.amProducts);
                    const pmByType = byTypeFor(ritual.pmProducts);
                    const judge = (cur, rec) => {
                      if (!cur) return 'miss';
                      if (!rec || !rec.a) return 'covered';
                      const blob = `${cur.name||''} ${cur.activeIngredients||''} ${cur.actives||''}`.toLowerCase();
                      const hits = rec.a.toLowerCase().split(/[\s,]+/).filter(t => t.length > 3);
                      const matched = hits.some(h => blob.includes(h));
                      return (matched || !hits.length) ? 'covered' : 'sub';
                    };
                    const Dot = ({ status }) => {
                      const color = status === 'covered' ? 'var(--accent-sage-dark)' : status === 'sub' ? 'var(--accent-gold)' : 'var(--accent)';
                      return <span style={{ display:'inline-block', width:9, height:9, borderRadius:999, background:color, marginTop:5 }} />;
                    };
                    const renderSide = (label, byType) => (
                      <div>
                        <div className="text-[9px] tracking-[0.28em] uppercase mb-2" style={{ color:'var(--ink-soft)', fontWeight:700 }}>{label}</div>
                        <div className="space-y-2">
                          {STEPS_PG.filter(s => !(label === 'PM' && s.key === 'spf')).map(step => {
                            const rec = ideal[step.key];
                            if (!rec) return null;
                            const cur = byType[step.key] || (step.key === 'serum' ? byType['treatment'] : null);
                            const status = judge(cur, rec);
                            return (
                              <div key={step.key} className="rounded-[10px] border p-2.5 flex items-start gap-2" style={{ background:'var(--cream-deep)', borderColor:'var(--line)' }}>
                                <Dot status={status} />
                                <div className="min-w-0 flex-1">
                                  <div className="text-[8.5px] tracking-[0.22em] uppercase" style={{ color:'var(--ink-soft)', fontWeight:700 }}>{step.label}</div>
                                  <div className="text-[12px] mt-0.5 leading-tight" style={{ color: cur ? 'var(--ink)' : 'var(--ink-soft)', fontStyle: 'normal', fontWeight: cur ? 600 : 500 }}>
                                    {cur ? `${cur.brand || ''}${cur.brand ? ' · ' : ''}${cur.name || ''}` : 'nothing here yet'}
                                  </div>
                                  <div className="text-[10.5px] mt-1 leading-snug" style={{ color:'var(--ink-soft)' }}>
                                    <strong style={{ color:'var(--accent)', fontWeight:700 }}>Ideal:</strong> {rec.t}{rec.a ? <span style={{ opacity:.7 }}> ({rec.a})</span> : null}
                                  </div>
                                </div>
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    );
                    const concerns = Array.isArray(userConcerns) ? userConcerns : [];
                    return (
                      <div className="space-y-4">
                        <div className="rounded-[14px] border p-4" style={{ background:'var(--cream)', borderColor:'var(--line)' }}>
                          <div className="text-[10px] tracking-[0.28em] uppercase mb-1" style={{ color:'var(--accent)', fontWeight:700 }}>Ideal vs current</div>
                          <h3 className="text-[18px] leading-[1.1] mb-2" style={{ color:'var(--ink)', fontWeight:700, letterSpacing:'-0.02em' }}>Where your routine matches the brief.</h3>
                          <p className="text-[12px] leading-snug mb-3" style={{ color:'var(--ink-soft)' }}>
                            Comparing today's regimen against an ideal routine for <strong style={{ color:'var(--accent)' }}>{goal}</strong>{concerns.length ? <> with your concerns ({concerns.slice(0,3).join(', ')})</> : null}.
                          </p>
                          <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                            {renderSide('AM', amByType)}
                            {renderSide('PM', pmByType)}
                          </div>
                          <div className="flex gap-3 mt-3 pt-3 border-t text-[8.5px] tracking-[0.18em] uppercase" style={{ borderColor:'var(--line)', color:'var(--ink-soft)', fontWeight:700 }}>
                            <span className="inline-flex items-center gap-1.5"><i style={{ width:7, height:7, borderRadius:999, background:'var(--accent-sage-dark)', display:'inline-block' }} />Covered</span>
                            <span className="inline-flex items-center gap-1.5"><i style={{ width:7, height:7, borderRadius:999, background:'var(--accent-gold)', display:'inline-block' }} />Suboptimal</span>
                            <span className="inline-flex items-center gap-1.5"><i style={{ width:7, height:7, borderRadius:999, background:'var(--accent)', display:'inline-block' }} />Missing</span>
                          </div>
                        </div>

                    {/* === Current Regimen snapshot removed June 2026 (Tier A.1) ===
                        Both stratechery + design critics flagged this as the single
                        highest-leverage delete. The Ideal-vs-Current grid above already
                        encodes current state in its "current" column, and the Regimen
                        tab is the canonical inventory. The comment that lived here
                        ("Reference only, so Picks stays focused on decisions") was the
                        design defending what shouldn't be there. */}
                      </div>
                    );
                  })()}
                </div>
              )}

              {/* === Q&A === */}
              {pearlsTab === 'qa' && (
                <>
                  {pearlsQAMessages.length === 0 ? (
                    <div className="border p-12 text-center" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                      <Icon name="MessageCircle" size={28} className="mx-auto mb-4 opacity-40" />
                      <h3 className="text-[18px] mb-2" style={{color:'var(--ink)', fontWeight:700, letterSpacing:'-0.01em'}}>Ask about skin logic.</h3>
                      <p className="text-sm font-light max-w-md mx-auto" style={{color:'var(--ink-soft)'}}>Use this for mechanisms, ingredients, routine theory, and what the research says. It pairs with your lessons and helps you make better regimen decisions.</p>
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-3 mt-8 max-w-2xl mx-auto">
                        {[
                          'How exactly does retinol work in the skin?',
                          'Is mineral or chemical sunscreen better?',
                          'What is the evidence for the gut-skin axis?',
                          'Why does niacinamide layer well with everything?'
                        ].map(q => (
                          <button key={q} onClick={() => handlePearlsQA(q)} className="border p-4 text-left text-sm font-light transition hover:border-[var(--ink)]" style={{background:'var(--cream)', borderColor: 'var(--line)', color:'var(--ink)'}}>"{q}"</button>
                        ))}
                      </div>
                    </div>
                  ) : (
                    <div className="border p-6 md:p-8 space-y-6" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                      {pearlsQAMessages.map((m, i) => (
                        <div key={i}>
                          {m.role === 'user' ? (
                            <div className="flex justify-end">
                              <div className="max-w-[85%] px-4 py-3 rounded-2xl rounded-tr-sm text-sm font-light leading-relaxed" style={{background:'var(--ink)', color:'var(--cream)'}}>
                                {m.content}
                              </div>
                            </div>
                          ) : (
                            <div className="flex gap-3">
                              <div className="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0" style={{background:'var(--ink)', color:'var(--cream)'}}>
                                <Icon name="BookOpen" size={12} />
                              </div>
                              <div className="flex-1 min-w-0">
                                <div className="text-[10px] tracking-[0.2em] uppercase mb-1" style={{color:'var(--ink-soft)'}}>Pearls</div>
                                <div className="whitespace-pre-wrap leading-relaxed font-light text-[13px]" style={{color: m.error ? 'var(--accent)' : 'var(--ink)'}}>{withPearls(m.content, setOpenLesson)}</div>
                              </div>
                            </div>
                          )}
                        </div>
                      ))}
                      {pearlsQALoading && (
                        <div className="flex gap-3">
                          <div className="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0" style={{background:'var(--ink)', color:'var(--cream)'}}>
                            <Icon name="BookOpen" size={12} />
                          </div>
                          <div className="flex-1 flex items-center gap-2 pulse-soft" style={{color:'var(--ink-soft)'}}>
                            <Icon name="Loader2" size={14} className="spin" />
                            <span className="text-[11px] tracking-[0.2em] uppercase">Looking it up…</span>
                          </div>
                        </div>
                      )}
                    </div>
                  )}

                  <div className="mt-4 border" style={{borderColor: 'var(--line)', background:'var(--cream)'}}>
                    <textarea autoCapitalize="off" autoCorrect="off" spellCheck={false}
                      value={pearlsQAInput}
                      onChange={e => setPearlsQAInput(e.target.value)}
                      onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handlePearlsQA(); } }}
                      placeholder={pearlsQAMessages.length === 0 ? "Ask a general dermatology question…" : "Continue…"}
                      rows="2"
                      className="w-full px-4 py-3 border-0 focus:outline-none font-light resize-none"
                      style={{background:'transparent', color:'var(--ink)'}}
                    />
                    <div className="flex items-center justify-between px-3 pb-3">
                      <span className="text-[9px] tracking-[0.15em] uppercase" style={{color:'var(--ink-soft)'}}>Teaching mode · ingredients, routines, evidence</span>
                      <button onClick={() => handlePearlsQA()} disabled={!pearlsQAInput.trim() || pearlsQALoading} className="px-4 py-2 tracking-[0.2em] text-[10px] uppercase transition disabled:opacity-40 flex items-center gap-2" style={{background:'var(--ink)', color:'var(--cream)'}}>
                        {pearlsQALoading ? <Icon name="Loader2" size={11} className="spin" /> : <><Icon name="ArrowUp" size={11} /> Send</>}
                      </button>
                    </div>
                  </div>
                </>
              )}
            </div>
          );
        })()}

        {activeTab === 'insights' && (
          <InsightsView
            logs={logs}
            hormonalContext={hormonalContext}
            counselInsights={counselInsights}
            counselSubTab={counselSubTab}
            setCounselSubTab={setCounselSubTab}
            counselGenerating={counselGenerating}
            counselExpanded={counselExpanded}
            setCounselExpanded={setCounselExpanded}
            insightMessages={insightMessages}
            insightQuery={insightQuery}
            setInsightQuery={setInsightQuery}
            insightLoading={insightLoading}
            handleGenerateCounselInsight={handleGenerateCounselInsight}
            discussInsightInAsk={discussInsightInAsk}
            handleInsight={handleInsight}
            clearInsightChat={clearInsightChat}
            setOpenLesson={setOpenLesson}
            procedures={procedures}
            products={products}
            regimenLogs={regimenLogs}
            // === LESSONS FILTER + AGE BRIDGE (May 30 2026) ===
            // Bridge userProfile + onboardingState so the new
            // Lessons filter can read goals + experience level and
            // write them back through the App's existing setters.
            userProfile={userProfile}
            setUserProfile={setUserProfile}
            onboardingState={onboardingState}
            updateOnboarding={updateOnboarding}
            saveData={saveData}
          />
        )}

        {/* === ABOUT US — slim placeholder ===
            Per Jenni: just the two names + "coming soon." Full bios,
            ethos, voice principles will land later — keep this quiet
            for now. Brand voice still saved in memory + threaded into
            the AI prompts. */}
        {activeTab === 'about' && (
          <div className="md:max-w-md md:mx-auto pb-6">
            <div className="text-[10px] tracking-[0.32em] uppercase mb-2" style={{color:'var(--ink-soft)'}}>About</div>
            <h2 className="font-serif italic text-[26px] md:text-[28px] leading-[1.1] mb-7" style={{color:'var(--ink)'}}>Two doctors, one quiet study of skin.</h2>

            <div className="flex items-center justify-center gap-6 mb-7">
              <div className="flex flex-col items-center">
                <div className="w-20 h-20 rounded-full flex items-center justify-center" style={{background:'var(--cream-deep)', border: '1px solid var(--line)', color:'var(--accent)'}}>
                  <Icon name="User" size={32} />
                </div>
                <div className="text-[9.5px] tracking-[0.22em] uppercase mt-2.5" style={{color:'var(--ink)'}}>Dr. Jenni Tang</div>
                <div className="text-[9px] italic mt-0.5" style={{color:'var(--ink-soft)'}}>Co-founder</div>
              </div>
              <div className="flex flex-col items-center">
                <div className="w-20 h-20 rounded-full flex items-center justify-center" style={{background:'var(--cream-deep)', border: '1px solid var(--line)', color:'var(--accent)'}}>
                  <Icon name="User" size={32} />
                </div>
                <div className="text-[9.5px] tracking-[0.22em] uppercase mt-2.5" style={{color:'var(--ink)'}}>Dr. Christiana Gainey</div>
                <div className="text-[9px] italic mt-0.5" style={{color:'var(--ink-soft)'}}>Co-founder</div>
              </div>
            </div>

            <div className="text-center pt-5 mt-3" style={{borderTop:'1px solid var(--line)'}}>
              <div className="text-[10px] tracking-[0.32em] uppercase mb-1.5" style={{color:'var(--accent)'}}>Coming soon</div>
              <p className="font-serif italic text-[13px] leading-relaxed" style={{color:'var(--ink-soft)'}}>
                More on who we are, why we built this, and how we think about skin.
              </p>
            </div>

            {/* === EDUCATIONAL DISCLAIMER (May 2026 launch-safety) ===
                Required surfacing — the app's voice leans confident
                and dermatology-informed, but the experience is
                educational tracking, not a clinical consultation.
                Anchored here on the About page so the user can find
                it deliberately. */}
            <div className="mt-8 pt-5 px-1 text-[10.5px] leading-relaxed text-center" style={{borderTop:'1px solid var(--line)', color:'var(--ink-soft)'}}>
              <p style={{fontWeight:500, color:'var(--ink)', marginBottom:6, fontSize:'11px', letterSpacing:'0.04em'}}>A note on what this is.</p>
              <p>
                Frida is an educational skin-tracking and learning tool — informational only, not a medical diagnosis or substitute for in-person care. For anything severe, painful, infected, rapidly changing, or unusual, please see a dermatologist or urgent care in person. Decisions about prescription products (tretinoin, hydroquinone, spironolactone, isotretinoin, antibiotics) belong to you and your clinician.
              </p>
            </div>
          </div>
        )}

        {activeTab === 'makeup' && (
          <div className="md:max-w-md md:mx-auto pb-6">
            <SectionHeader title="Atelier de Couleur" subtitle="Makeup tailored to your palette." action={() => setShowColorModal(true)} actionLabel={colorProfile ? "Edit Profile" : "Set Profile"} />
            {!colorProfile ? (
              <div className="border p-12 text-center" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                <div className="flex justify-center mb-4" style={{color:'var(--ink-soft)'}}><Icon name="Palette" size={40} /></div>
                <h3 className="font-serif text-2xl italic mb-2" style={{color:'var(--ink)'}}>Begin with your palette</h3>
                <p className="text-sm font-light max-w-sm mx-auto mb-6" style={{color:'var(--ink-soft)'}}>Set your color analysis profile so recommendations align with your season and undertone.</p>
                <button onClick={() => setShowColorModal(true)} className="px-6 py-3 tracking-[0.2em] text-[10px] uppercase" style={{background:'var(--ink)', color:'var(--cream)'}}>Set Profile</button>
              </div>
            ) : (
              <>
                <div className="border p-8 mb-8" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                  <div className="flex gap-8 flex-wrap">
                    {(colorProfile.photo || colorProfile.photoPath) && <Photo item={colorProfile} alt="" className="w-32 h-32 object-cover rounded-full" />}
                    <div className="flex-1 min-w-0">
                      <div className="flex items-center gap-2 flex-wrap">
                        <div className="text-[10px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)'}}>Your Color Story</div>
                        {colorProfile.aiAnalysis && (
                          <span className="text-[9px] tracking-[0.15em] uppercase px-2 py-0.5 rounded-full flex items-center gap-1" style={{background:'var(--accent-blue-soft)', color:'var(--accent-blue-dark)'}}>
                            <Icon name="Check" size={9} /> AI verified
                          </span>
                        )}
                      </div>
                      <h3 className="font-serif text-3xl italic mt-1 capitalize" style={{color:'var(--ink)'}}>{colorProfile.season?.replace(/-/g, ' ') || 'Undefined Season'}</h3>
                      {colorProfile.aiAnalysis?.predictedSeason && colorProfile.aiAnalysis.predictedSeason !== colorProfile.season && (
                        <div className="text-[10px] mt-1 italic flex items-center gap-1" style={{color:'#a04555'}}>
                          <Icon name="AlertCircle" size={11} /> AI suggests <span className="capitalize">{colorProfile.aiAnalysis.predictedSeason.replace(/-/g, ' ')}</span> instead — <button onClick={() => setShowColorModal(true)} className="underline">review</button>
                        </div>
                      )}
                      <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
                        <ProfileTrait label="Tone" value={colorProfile.skinTone} />
                        <ProfileTrait label="Undertone" value={colorProfile.undertone} />
                        <ProfileTrait label="Eyes" value={colorProfile.eyeColor} />
                        <ProfileTrait label="Hair" value={colorProfile.hairColor} />
                      </div>
                      <div className="flex gap-2 mt-4 flex-wrap">
                        {!colorProfile.aiAnalysis && colorProfile.photo && (
                          <button onClick={() => setShowColorModal(true)} className="text-[10px] tracking-[0.2em] uppercase border px-3 py-2 transition flex items-center gap-2" style={{borderColor:'var(--ink)', color:'var(--ink)'}}>
                            <Icon name="Sparkles" size={11} /> Verify with AI
                          </button>
                        )}
                        {colorProfile.aiAnalysis && (
                          <button onClick={() => openChat({
                            context: `Color analysis from photo:\n\n${colorProfile.aiAnalysis.fullText}\n\nUser's profile: ${colorProfile.season || 'unspecified'} season, ${colorProfile.undertone || '?'} undertone, ${colorProfile.skinTone || '?'} depth, ${colorProfile.hairColor || '?'} hair, ${colorProfile.eyeColor || '?'} eyes.`,
                            title: `${colorProfile.season?.replace(/-/g, ' ') || 'Color profile'}`,
                            subtitle: 'Color analysis',
                            image: colorProfile.photo, imagePath: colorProfile.photoPath,
                            suggestions: [
                              'What lipstick shades work for me?',
                              'Best foundation undertone and shade range to look at?',
                              'Which colors should I avoid wearing?',
                              'What would my best neutral palette look like?',
                              'Recommend specific blush and bronzer products'
                            ]
                          })} className="text-[10px] tracking-[0.2em] uppercase border px-3 py-2 transition flex items-center gap-2" style={{borderColor:'var(--ink)', color:'var(--ink)'}}>
                            <Icon name="MessageCircle" size={11} /> Ask follow-up
                          </button>
                        )}
                      </div>
                    </div>
                  </div>
                </div>

                <div className="flex justify-between items-center mb-4 flex-wrap gap-3">
                  <div className="text-[10px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)'}}>Ask the Artist</div>
                  {makeupMessages.length > 0 && (
                    <button onClick={clearMakeupChat} className="text-[10px] tracking-[0.15em] uppercase italic underline" style={{color:'var(--ink-soft)'}}>New conversation</button>
                  )}
                </div>

                {makeupMessages.length === 0 ? (
                  <div className="border p-8 mb-4" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                    <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
                      {[
                        "Daily natural look — products & shades",
                        "Best lipstick colors for my season",
                        "Evening glam palette recommendations",
                        "Best foundation shades to look at",
                        "Blush colors that flatter my undertone",
                        "What metals (gold/silver/rose) suit me?"
                      ].map(q => (
                        <button key={q} onClick={() => handleMakeup(q)} className="border p-4 text-left text-sm font-light italic transition hover:border-[var(--ink)]" style={{background:'var(--cream)', borderColor: 'var(--line)', color:'var(--ink)'}}>"{q}"</button>
                      ))}
                    </div>
                  </div>
                ) : (
                  <div className="border p-6 md:p-8 space-y-6 mb-4" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                    {makeupMessages.map((m, i) => (
                      <div key={i}>
                        {m.role === 'user' ? (
                          <div className="flex justify-end">
                            <div className="max-w-[85%] px-4 py-3 rounded-2xl rounded-tr-sm text-sm font-light leading-relaxed" style={{background:'var(--ink)', color:'var(--cream)'}}>
                              {m.content}
                            </div>
                          </div>
                        ) : (
                          <div className="flex gap-3">
                            <div className="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0" style={{background:'var(--ink)', color:'var(--cream)'}}>
                              <Icon name="Palette" size={12} />
                            </div>
                            <div className="flex-1 min-w-0">
                              <div className="text-[10px] tracking-[0.2em] uppercase mb-1" style={{color:'var(--ink-soft)'}}>The Artist</div>
                              <div className="whitespace-pre-wrap leading-relaxed font-light text-[13px]" style={{color: m.error ? '#a04555' : 'var(--ink)'}}>{m.content}</div>
                            </div>
                          </div>
                        )}
                      </div>
                    ))}
                    {makeupLoading && (
                      <div className="flex gap-3">
                        <div className="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0" style={{background:'var(--ink)', color:'var(--cream)'}}>
                          <Icon name="Palette" size={12} />
                        </div>
                        <div className="flex-1 flex items-center gap-2 pulse-soft" style={{color:'var(--ink-soft)'}}>
                          <Icon name="Loader2" size={14} className="spin" />
                          <span className="text-[11px] tracking-[0.2em] uppercase">Curating…</span>
                        </div>
                      </div>
                    )}
                  </div>
                )}

                <div className="border" style={{borderColor: 'var(--line)', background:'var(--cream)'}}>
                  <textarea autoCapitalize="off" autoCorrect="off" spellCheck={false}
                    value={makeupQuery}
                    onChange={e => setMakeupQuery(e.target.value)}
                    onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleMakeup(); } }}
                    placeholder={makeupMessages.length === 0 ? "What lipstick shades for daytime? Best blush for my undertone?" : "Continue the conversation…"}
                    rows="2"
                    className="w-full px-4 py-3 border-0 focus:outline-none font-light italic resize-none"
                    style={{background:'transparent', color:'var(--ink)'}}
                  />
                  <div className="flex items-center justify-between px-3 pb-3">
                    <span className="text-[9px] tracking-[0.15em] uppercase" style={{color:'var(--ink-soft)'}}>Enter to send · Shift+Enter for new line</span>
                    <button onClick={() => handleMakeup()} disabled={!makeupQuery.trim() || makeupLoading} className="px-4 py-2 tracking-[0.2em] text-[10px] uppercase disabled:opacity-40 flex items-center gap-2" style={{background:'var(--ink)', color:'var(--cream)'}}>
                      {makeupLoading ? <><Icon name="Loader2" size={11} className="spin" /></> : <><Icon name="ArrowUp" size={11} /> Send</>}
                    </button>
                  </div>
                </div>
              </>
            )}
          </div>
        )}
      </main>

      {showLogModal && (
        <SkinLogModal
          logs={logs}
          setLogs={setLogs}
          products={products}
          setProducts={setProducts}
          procedures={procedures}
          setProcedures={setProcedures}
          regimenLogs={regimenLogs}
          sensitivities={sensitivities}
          user={user}
          editingLogId={editingLogId}
          setEditingLogId={setEditingLogId}
          skinLogForm={skinLogForm}
          setSkinLogForm={setSkinLogForm}
          skinLogFormRef={skinLogFormRef}
          skinLogSuggesting={skinLogSuggesting}
          setSkinLogSuggesting={setSkinLogSuggesting}
          skinLogShowCamera={skinLogShowCamera}
          setSkinLogShowCamera={setSkinLogShowCamera}
          setShowLogModal={setShowLogModal}
          setCoverRoutineRebuildToken={setCoverRoutineRebuildToken}
          setPostSaveSuggestion={setPostSaveSuggestion}
          setShowApiKeyModal={setShowApiKeyModal}
          setShowPhotoImportQueue={setShowPhotoImportQueue}
          buildUserProfileBlock={buildUserProfileBlock}
          modalScrollMemo={modalScrollMemo}
          useModalScrollPreserve={useModalScrollPreserve}
          toast={toast}
          saveData={saveData}
          callClaude={callClaude}
        />
      )}
      {showBulkUploadModal && (
        <BulkPhotoUploadModal
          logs={logs}
          setLogs={setLogs}
          saveData={saveData}
          toast={toast}
          user={user}
          setShowBulkUploadModal={setShowBulkUploadModal}
          setCoverRoutineRebuildToken={setCoverRoutineRebuildToken}
          retryLogAnalysis={retryLogAnalysis}
          userProfile={userProfile}
        />
      )}

      {/* === GUIDED PHOTO CAPTURE (May 2026) ===
          Shared modal used by Home cover, onboarding, and daily check-in.
          Canonical model:
            1. Daily guided set, detailed-area shots, and uploads all become
               checkInDetailsQueue first.
            2. CheckInDetailsModal is the only daily place that assigns
               rating / noticed / context / note / region labels.
            3. Onboarding baseline is the only exception: it saves a quiet
               baseline log immediately so the onboarding read can run. */}
      {showGuidedCaptureModal && (
        <GuidedPhotoCaptureModal
          contextLabel={
            guidedCaptureCtx?.intent === 'onboarding_baseline' ? 'Baseline'
            : guidedCaptureCtx?.intent === 'check_in' ? 'Today’s check-in'
            : 'Today’s set'
          }
          requireFullGuidedSet={guidedCaptureCtx?.requireFullGuidedSet === true}
	          onClose={() => { setShowGuidedCaptureModal(false); setGuidedCaptureCtx(null); }}
	          onComplete={async (shots) => {
	            if (!shots || shots.length === 0) return;
              const shotToQueueItem = (s) => ({
                dataUrl: s.dataUrl,
                capturedAt: s.capturedAt || new Date().toISOString(),
                source: s.source || 'guided_capture',
                angle: s.angle,
              });
              const angleToArea = (angle, index) => ({
                front: 'full-face',
                left_cheek: 'left-cheek',
                right_cheek: 'right-cheek',
                t_zone: 't-zone',
                chin_jaw: 'chin',
                eye_area: 'eye-area',
                right_eye: 'right-eye',
                left_eye: 'left-eye',
                neck: 'neck',
                back: 'back',
                spot: 'spot',
                custom: 'other',
              }[angle] || (index === 0 ? 'full-face' : 'other'));
	            // Daily guided captures should behave like a re-check-in:
	            // close the camera, open the Skin Check-In details screen,
	            // and save only after the user confirms rating/notes/main
	            // context. The previous path saved immediately, so adding an
	            // evening photo silently bypassed the check-in modal.
	            if (guidedCaptureCtx?.intent !== 'onboarding_baseline') {
	              const queue = shots.map(shotToQueueItem);
	              setShowGuidedCaptureModal(false);
	              setGuidedCaptureCtx(null);
	              setCheckInDetailsQueue(queue);
	              setCheckInDetailsIdx(0);
	              return;
	            }
	            const today = localDateISO();
	            const baseTime = Date.now();
            // Onboarding-baseline branch reached here. Close the camera
            // modal so the user lands back on the onboarding photo step
            // and sees the captured photo + Continue affordance. Without
            // this, the modal stayed mounted and onboardingState's
            // hasPhoto transition could be missed visually.
            setShowGuidedCaptureModal(false);
            setGuidedCaptureCtx(null);
            // Build a log entry per shot. Each entry holds the angle
            // metadata so timeline + compare can group/filter later.
            // === FIRST SHOT = FULL FACE (May 2026 v2 — Home cover fix) ===
            // The front shot of a guided 5-step is always the front of
            // the face. Tag it area:'full-face' so the Home cover's
            // canonical preferred filter (`l.area === 'full-face'`)
            // surfaces it. Otherwise the cover fell back to the generic
            // photo path and several downstream optimizations (hero
            // photo selection, since-last-reading chips) missed the
            // shot. Subsequent shots stay untagged — their angle field
            // is enough for journal/compare to group them.
            const newLogs = shots.map((s, i) => ({
              id: baseTime + i,
              date: today,
              photo: s.dataUrl,
              photoPath: null,
              area: angleToArea(s.angle, i),
              concerns: [],
              rating: null,
              notes: '',
              context: '',
              angle: s.angle,
              source: s.source || 'guided_capture',
              capturedAt: s.capturedAt || new Date().toISOString(),
              aiAnalysis: null,
              analyzing: false,
            }));
            // Persist immediately (concrete array — no functional updater,
            // per Codex bug fix on saveData).
            const updated = [...newLogs, ...logs].sort((a,b) => new Date(b.date) - new Date(a.date));
            setLogs(updated);
            await saveData('logs', updated);
            toast(`${shots.length} photo${shots.length > 1 ? 's' : ''} added ✨`);
            // Upload to Supabase Storage in the background if cloud user.
            // Mirrors the per-log path swap pattern used elsewhere so we
            // never persist raw base64 to the cloud row.
            if (user && user.cloud && uploadPhotoToStorage) {
              for (const log of newLogs) {
                try {
                  // BUG FIX (May 2026): uploadPhotoToStorage returns
                  // { path, error }. Capturing the whole object into
                  // `path` and writing it to photoPath silently broke
                  // every cloud user's onboarding/guided uploads — the
                  // image never rendered in Journal/Compare/Timeline
                  // because Photo couldn't resolve an object as a URL.
                  const { path } = await uploadPhotoToStorage(user.id, log.photo);
                  if (path) {
                    setLogs(prev => {
                      const next = prev.map(l => l.id === log.id ? { ...l, photoPath: path, photo: undefined } : l);
                      saveData('logs', next).catch(() => {});
                      return next;
                    });
                  }
                } catch (e) { /* swallow — local copy is still good */ }
              }
            }
            // === ONBOARDING BASELINE BRIDGE (May 2026) ===
            // When guided capture runs from the onboarding photo step,
            // promote the first shot into onboardingState so the existing
            // first-read analysis useEffect picks it up. Without this the
            // OnboardingOverlay would never see the photo land.
            if (guidedCaptureCtx?.intent === 'onboarding_baseline' && newLogs[0]) {
              setOnboardingState(prev => ({
                ...prev,
                photoProvided: true,
                photoSource: 'guided',
                photoDataUrl: newLogs[0].photo,
                photoLogId: newLogs[0].id,
                photoAnalyzing: !!getApiKey(),
              }));
              if (getApiKey()) {
                // Mark log as analyzing so the existing log-analysis
                // observer can complete the cycle.
                setLogs(prev => prev.map(l => l.id === newLogs[0].id ? { ...l, analyzing: true, analyzingStartedAt: Date.now() } : l));
              }
            }
            // Defer to caller for any post-save action (e.g. open the
            // check-in details modal for the newly captured shots).
            if (guidedCaptureCtx?.onDone) guidedCaptureCtx.onDone(newLogs);
            // === CHECK-IN: CENTRALIZED via createPhotoLogs ===
            // Was: hand-rolled analyzing-flag + worker-pool replicating
            // the same pattern as BulkPhotoUpload. Now: createPhotoLogs
            // owns both. We still need to mark the EXISTING newLogs as
            // analyzing in-place (they already landed via setLogs above
            // from the guided capture's own save path) since we don't
            // re-create logs here — just promote analysis on them.
            // Onboarding baseline stays special-cased above.
            if (guidedCaptureCtx?.intent === 'check_in') {
              const apiKeyOn = !!getApiKey();
              if (apiKeyOn && typeof retryLogAnalysis === 'function') {
                setLogs(prev => prev.map(l => {
                  if (!newLogs.find(nl => nl.id === l.id)) return l;
                  return { ...l, analyzing: true, analyzingStartedAt: Date.now() };
                }));
                // Reuse the same worker-pool helper from createPhotoLogs by
                // calling it with the existing newLogs. fireAnalysis runs
                // bounded-concurrency over the array we pass in.
                const { fireAnalysis } = createPhotoLogs({
                  shots: newLogs.map(l => ({
                    dataUrl: l.photo,
                    capturedAt: l.capturedAt,
                    angle: l.angle,
                    area: l.area,
                    source: l.source,
                  })),
                  defaultDate: newLogs[0]?.date,
                  apiKeyOn: true,
                });
                // The helper's fireAnalysis closure uses the SHOTS-derived
                // logs internally for analysis, but we want analysis to
                // attach to the EXISTING log ids. Direct loop with the
                // existing newLogs ids — same pattern, just preserving
                // ids. Worker-pool semantics intact.
                const ANALYSIS_CONCURRENCY = 3;
                const queue = [...newLogs];
                const runOne = async (log) => {
                  try { await retryLogAnalysis(log.id, { ...log, analyzing: true, analyzingStartedAt: Date.now() }); }
                  catch (e) { console.warn('[check_in auto-analysis]', log.id, e?.message); }
                };
                Array(Math.min(ANALYSIS_CONCURRENCY, queue.length)).fill(null).forEach(async () => {
                  while (queue.length > 0) {
                    const next = queue.shift();
                    if (next) await runOne(next);
                  }
                });
              }
              // Route to CheckInDetailsModal for rating/chips/note capture.
              if (typeof setCheckInDetailsQueue === 'function' && !guidedCaptureCtx?.onDone) {
                const queueItems = newLogs.map(l => ({
                  dataUrl: l.photo,
                  capturedAt: l.capturedAt,
                  source: l.source,
                  angle: l.angle,
                  existingLogId: l.id,
                  date: l.date,
                }));
                setCheckInDetailsQueue(queueItems);
                setCheckInDetailsIdx(0);
              }
            }
          }}
        />
      )}

      {/* === HOME UPLOAD PICKER (May 2026) ===
          Bottom sheet that splits the old single "Upload" button into the
          three distinct intents users actually have: capture today's
          structured set, upload today's photos from library, or back-fill
          historical photos via bulk import. Per design: do NOT replace
          bulk import with guided capture — preserve both. */}
      {showHomeUploadPicker && (
        <Modal compact onClose={() => setShowHomeUploadPicker(false)} eyebrow="Photos" title="Add to your timeline">
          <div className="space-y-2">
            <button
              onClick={() => {
                setShowHomeUploadPicker(false);
                setGuidedCaptureCtx({ intent: 'today' });
                setShowGuidedCaptureModal(true);
              }}
              className="w-full text-left rounded-[14px] px-4 py-3 transition"
              style={{background:'var(--cream-deep)', border: '1px solid var(--line)', cursor:'pointer'}}
            >
              <div className="flex items-center gap-3">
                <Icon name="Camera" size={16} style={{color:'var(--accent)'}} />
                <div className="flex-1 min-w-0">
                  <div className="text-[13px] font-medium" style={{color:'var(--ink)'}}>Take today’s photo set</div>
                  <div className="text-[10.5px] mt-0.5" style={{color:'var(--ink-soft)'}}>5 photos &middot; about 60 seconds</div>
                </div>
                <Icon name="ChevronRight" size={14} style={{color:'var(--ink-soft)'}} />
              </div>
            </button>
            <button
              onClick={() => {
                setShowHomeUploadPicker(false);
                if (homeUploadInputRef && homeUploadInputRef.current) homeUploadInputRef.current.click();
              }}
              className="w-full text-left rounded-[14px] px-4 py-3 transition"
              style={{background:'var(--cream-deep)', border: '1px solid var(--line)', cursor:'pointer'}}
            >
              <div className="flex items-center gap-3">
                <Icon name="Upload" size={16} style={{color:'var(--ink-soft)'}} />
                <div className="flex-1 min-w-0">
                  <div className="text-[13px] font-medium" style={{color:'var(--ink)'}}>Upload today’s photos</div>
                  <div className="text-[10.5px] mt-0.5" style={{color:'var(--ink-soft)'}}>From your camera roll — dated today</div>
                </div>
                <Icon name="ChevronRight" size={14} style={{color:'var(--ink-soft)'}} />
              </div>
            </button>
            <button
              onClick={() => {
                setShowHomeUploadPicker(false);
                setShowPhotoImportQueue(true);
              }}
              className="w-full text-left rounded-[14px] px-4 py-3 transition"
              style={{background:'var(--cream-deep)', border: '1px solid var(--line)', cursor:'pointer'}}
            >
              <div className="flex items-center gap-3">
                <Icon name="Layers" size={16} style={{color:'var(--ink-soft)'}} />
                <div className="flex-1 min-w-0">
                  <div className="text-[13px] font-medium" style={{color:'var(--ink)'}}>Import photo history</div>
                  <div className="text-[10.5px] mt-0.5" style={{color:'var(--ink-soft)'}}>Many older photos with batch labels</div>
                </div>
                <Icon name="ChevronRight" size={14} style={{color:'var(--ink-soft)'}} />
              </div>
            </button>
          </div>
        </Modal>
      )}

      {/* === PHOTO IMPORT QUEUE (May 2026) ===
          3-step Select/Label/Save bulk import flow with batch labels.
          Replaces the older BulkPhotoUploadModal for the
          "Import photo history" intent. */}
      {showPhotoImportQueue && (
        <PhotoImportQueue
          logs={logs}
          setLogs={setLogs}
          saveData={saveData}
          toast={toast}
          user={user}
          uploadPhotoToStorage={uploadPhotoToStorage}
          onClose={() => setShowPhotoImportQueue(false)}
          onNavigateTimeline={() => { setActiveTab && setActiveTab('journal'); }}
          onOpenCompare={() => { setActiveTab && setActiveTab('journal'); }}
        />
      )}

      {/* === CAMERA-FIRST CHECK IN (May 2026 — Phase 2) ===
          Triggered by the cover's "Check in" pill. Opens the camera
          immediately, captures a single front face photo, writes a
          minimal log entry, then dismisses. A toast offers the option
          to add details (opens SkinLogModal in edit mode for that log).
          Most users won't tap that — they just want the photo logged
          and to move on. */}
      {/* Hidden file input for the home-cover "Upload" pill. Multi-select.
          Output → checkInDetailsQueue → CheckInDetailsModal. */}
      <input
        ref={homeUploadInputRef}
        type="file"
        accept="image/*"
        multiple
        onChange={handleHomeUpload}
        style={{display:'none'}}
      />
      {/* === ADD A PHOTO MODAL (May 2026 — centered floating redesign) ===
          Truly centered on all screen sizes (not stuck to bottom).
          Blurred backdrop. Soft elevated card with two action rows in a
          shared bordered container. Each row has a blush-circle icon,
          title, subtitle, and right chevron — matches the editorial
          luxury-skincare-consult feel. Closes on overlay tap, X button,
          or Escape (Escape handled at App's global keydown listener).
          Used for adding a photo on days that already have one — empty
          days bypass this and route straight to camera/upload. */}
      {showCheckInChooser && (
        <div
          className="fixed inset-0 z-[64] flex items-center justify-center px-6 py-6"
          style={{
            background: 'rgba(20, 16, 14, 0.55)',
            backdropFilter: 'blur(6px)',
            WebkitBackdropFilter: 'blur(6px)',
            animation: 'addPhotoFadeIn 180ms ease-out',
          }}
          onClick={() => setShowCheckInChooser(false)}
        >
          <div
            role="dialog"
            aria-modal="true"
            aria-labelledby="add-photo-title"
            onClick={(e) => e.stopPropagation()}
            className="w-full max-w-[420px] rounded-[28px]"
            style={{
              background: 'var(--cream)',
              border: '1px solid var(--line)',
              padding: 24,
              boxShadow: '0 24px 70px rgba(39, 31, 27, 0.22), 0 2px 6px rgba(39, 31, 27, 0.05)',
              animation: 'addPhotoPopIn 220ms cubic-bezier(0.16, 1, 0.3, 1)',
            }}
          >
            {/* Top row — eyebrow + X close */}
            <div className="flex items-center justify-between mb-5">
              <h2
                id="add-photo-title"
                className="text-[11px] tracking-[0.28em] uppercase"
                style={{color: 'var(--accent)', fontWeight: 600, margin: 0}}
              >
                Add a photo
              </h2>
              <button
                type="button"
                onClick={() => setShowCheckInChooser(false)}
                className="flex items-center justify-center w-7 h-7 rounded-full transition hover:bg-[var(--cream-deep)]"
                style={{color: 'var(--ink-soft)', cursor: 'pointer'}}
                aria-label="Close"
              >
                <Icon name="X" size={14} />
              </button>
            </div>

            {/* Single bordered container holds both action rows with a divider */}
            <div
              className="rounded-[20px] overflow-hidden"
              style={{border: '1px solid var(--line)', background: 'var(--cream)'}}
            >
              <button
                type="button"
                onClick={() => {
                  // May 2026: check-in primary path now opens the shared
                  // guided 5-step capture instead of the single-shot
                  // CameraCaptureModal. The guided flow stores per-angle
                  // metadata so timeline + compare can group by zone.
                  setShowCheckInChooser(false);
                  setGuidedCaptureCtx({ intent: 'check_in' });
                  setShowGuidedCaptureModal(true);
                }}
                className="w-full flex items-center gap-4 px-5 py-5 transition hover:bg-[var(--cream-deep)] active:bg-[var(--cream-deep)]"
                style={{cursor: 'pointer', textAlign: 'left'}}
              >
                <span
                  className="flex-shrink-0 flex items-center justify-center"
                  style={{
                    width: 44, height: 44, borderRadius: '50%',
                    background: 'rgba(192, 95, 60, 0.10)',
                    border: '1px solid rgba(192, 95, 60, 0.15)',
                  }}
                >
                  <Icon name="Camera" size={17} style={{color: 'var(--accent)'}} />
                </span>
                <span className="min-w-0 flex-1">
                  <span className="block text-[15px] leading-tight" style={{color: 'var(--ink)', fontWeight: 600, letterSpacing: '-0.012em'}}>Take photo set</span>
                  <span className="block text-[12px] mt-0.5 leading-snug" style={{color: 'var(--ink-soft)'}}>5 photos &middot; about 60 seconds</span>
                </span>
                <Icon name="ChevronRight" size={15} style={{color: 'var(--ink-soft)', flexShrink: 0}} />
              </button>
              <div style={{height: 1, background: 'var(--line)', margin: '0 20px'}} />
              <button
                type="button"
                onClick={() => { setShowCheckInChooser(false); homeUploadInputRef.current && homeUploadInputRef.current.click(); }}
                className="w-full flex items-center gap-4 px-5 py-5 transition hover:bg-[var(--cream-deep)] active:bg-[var(--cream-deep)]"
                style={{cursor: 'pointer', textAlign: 'left'}}
              >
                <span
                  className="flex-shrink-0 flex items-center justify-center"
                  style={{
                    width: 44, height: 44, borderRadius: '50%',
                    background: 'rgba(192, 95, 60, 0.10)',
                    border: '1px solid rgba(192, 95, 60, 0.15)',
                  }}
                >
                  <Icon name="Upload" size={17} style={{color: 'var(--accent)'}} />
                </span>
                <span className="min-w-0 flex-1">
                  <span className="block text-[15px] leading-tight" style={{color: 'var(--ink)', fontWeight: 600, letterSpacing: '-0.012em'}}>Upload from library</span>
                  <span className="block text-[12px] mt-0.5 leading-snug" style={{color: 'var(--ink-soft)'}}>Import from your library.</span>
                </span>
                <Icon name="ChevronRight" size={15} style={{color: 'var(--ink-soft)', flexShrink: 0}} />
              </button>
            </div>
          </div>
        </div>
      )}
      {/* === USED-SOMETHING-ELSE SHEET (May 2026 — Home Ritual redesign) ===
          Opened from the cover Ritual card's secondary CTA. Today-only
          additions: From shelf / New product / Procedure / Supplement-
          medication / Note only. The first three route to existing
          modals; the last two append to the day's amExtras/pmExtras as
          a labeled free-text entry (e.g. "Vitamin D · supplement", "felt
          tight after toner · note"). Important separation per Jenni's
          spec: this is for today; "Edit routine" is for future plan. */}
      {usedSomethingElseSheet && usedSomethingElseSheet.open && (() => {
        const sheet = usedSomethingElseSheet;
        const close = () => {
          setUsedSomethingElseSheet(null);
          setUsedSomethingElseInput('');
          setUsedSomethingElseKind(null);
        };
        // === DATE-AWARE COPY HELPERS (May 2026 per Jenni) ===
        // Sheet may be opened against today OR a past day from the cover.
        // Format a short date label and a boolean isToday so the buttons,
        // subtitle, and toast all read the same way.
        const sheetDate = sheet.date || localDateISO();
        const isToday = sheetDate === localDateISO();
        const dateLabel = isToday
          ? 'today'
          : new Date(sheetDate + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
        const appendExtra = (label) => {
          const date = sheetDate;
          const slot = sheet.slot || 'am';
          const extrasKey = slot === 'pm' ? 'pmExtras' : 'amExtras';
          const existing = (regimenLogs || []).find(r => r.date === date);
          // June 2026 Phase 2: tag the log with travel:true when the user
          // is in active travel mode so Journal/Compare can filter home
          // weeks vs. travel weeks. Applied to brand-new logs only —
          // editing an existing log preserves whatever tag it already has.
          const isTraveling = !!(userProfile?.travel?.active);
          const nextLog = existing
            ? { ...existing, [extrasKey]: [...(existing[extrasKey] || []), label] }
            : {
                id: Date.now(),
                date,
                amProducts: [],
                pmProducts: [],
                amDone: [],
                pmDone: [],
                amExtras: slot === 'am' ? [label] : [],
                pmExtras: slot === 'pm' ? [label] : [],
                notes: '',
                submitted: false,
                ...(isTraveling ? { travel: true } : {}),
              };
          const next = existing
            ? regimenLogs.map(r => r.date === date ? nextLog : r)
            : [nextLog, ...regimenLogs];
          setRegimenLogs(next);
          saveData('regimenLogs', next).catch(() => {});
          // Date-stamped toast on past days; conventional "today's" on today.
          toast(
            isToday
              ? `Added "${label}" to today's ${slot.toUpperCase()}`
              : `Added "${label}" to ${slot.toUpperCase()} for ${dateLabel}`,
            'success'
          );
        };
        const renderOption = (icon, title, subtitle, onClick) => (
          <button
            type="button"
            onClick={onClick}
            className="w-full flex items-center gap-4 px-5 py-4 transition hover:bg-[var(--cream-deep)] active:bg-[var(--cream-deep)]"
            style={{cursor: 'pointer', textAlign: 'left'}}
          >
            <span
              className="flex-shrink-0 flex items-center justify-center"
              style={{
                width: 38, height: 38, borderRadius: '50%',
                background: 'rgba(192, 95, 60, 0.10)',
                border: '1px solid rgba(192, 95, 60, 0.15)',
              }}
            >
              <Icon name={icon} size={15} style={{color: 'var(--accent)'}} />
            </span>
            <span className="min-w-0 flex-1">
              <span className="block text-[14px] leading-tight" style={{color: 'var(--ink)', fontWeight: 600, letterSpacing: '-0.012em'}}>{title}</span>
              <span className="block text-[11px] mt-0.5 leading-snug" style={{color: 'var(--ink-soft)'}}>{subtitle}</span>
            </span>
            <Icon name="ChevronRight" size={14} style={{color: 'var(--ink-soft)', flexShrink: 0}} />
          </button>
        );
        return (
          <div
            className="fixed inset-0 z-[64] flex items-end md:items-center justify-center"
            style={{
              background: 'rgba(20, 16, 14, 0.55)',
              backdropFilter: 'blur(6px)',
              WebkitBackdropFilter: 'blur(6px)',
              animation: 'addPhotoFadeIn 180ms ease-out',
            }}
            onClick={close}
          >
            <div
              role="dialog"
              aria-modal="true"
              aria-labelledby="used-else-title"
              onClick={(e) => e.stopPropagation()}
              className="w-full max-w-[420px] rounded-t-[28px] md:rounded-[28px]"
              style={{
                background: 'var(--cream)',
                border: '1px solid var(--line)',
                padding: 24,
                boxShadow: '0 24px 70px rgba(39, 31, 27, 0.22), 0 2px 6px rgba(39, 31, 27, 0.05)',
                animation: 'addPhotoPopIn 220ms cubic-bezier(0.16, 1, 0.3, 1)',
              }}
            >
              <div className="mb-2">
                <h2
                  id="used-else-title"
                  className="text-[20px] leading-tight"
                  style={{color: 'var(--ink)', fontWeight: 700, letterSpacing: '-0.018em', margin: 0}}
                >
                  Used something else?
                </h2>
              </div>
              <p className="text-[12px] mb-4 leading-snug" style={{color: 'var(--ink-soft)'}}>
                {isToday
                  ? 'Add what changed today. Your routine stays the same unless you choose otherwise.'
                  : `Add what changed on ${dateLabel}. Your routine stays the same unless you choose otherwise.`}
              </p>
              {usedSomethingElseKind === 'supplement' || usedSomethingElseKind === 'note' || usedSomethingElseKind === 'device' ? (
                <div className="space-y-3">
                  <div className="text-[10px] tracking-[0.22em] uppercase" style={{color: 'var(--ink-soft)', fontWeight: 600}}>
                    {usedSomethingElseKind === 'supplement' ? 'Took supplement / medication'
                      : usedSomethingElseKind === 'device' ? 'Used a device'
                      : 'Add a note'}
                  </div>
                  {usedSomethingElseKind === 'device' ? (
                    <>
                      {/* === DEVICE PICKER (May 2026 per Jenni) ===
                          Curated common-device list — same vocabulary as
                          the Refine > Evolve device picker. Selecting a
                          row drops a 'X · device' entry into that day's
                          extras (supplement-shape). 'Other…' falls back
                          to the free-text path. */}
                      <div className="space-y-1.5">
                        {[
                          'Red light therapy (LED panel)',
                          'Microcurrent device',
                          'High-frequency wand',
                          'Cleansing brush',
                          'Ice roller / globes',
                          'Gua sha',
                          'Dermaroller / microneedling',
                        ].map((deviceName) => (
                          <button
                            key={deviceName}
                            type="button"
                            onClick={() => {
                              appendExtra(`${deviceName} · device`);
                              close();
                            }}
                            className="w-full text-left rounded-[12px] px-3 py-2.5 flex items-center justify-between gap-3 transition hover:bg-[var(--cream-deep)]"
                            style={{background: 'var(--cream)', border: '1px solid var(--line)', cursor: 'pointer'}}
                          >
                            <span className="text-[13px]" style={{color: 'var(--ink)', fontWeight: 500}}>{deviceName}</span>
                            <Icon name="ChevronRight" size={13} style={{color: 'var(--ink-soft)'}} />
                          </button>
                        ))}
                      </div>
                      <div className="text-[10px] tracking-[0.22em] uppercase mt-3 mb-1.5" style={{color: 'var(--ink-soft)', fontWeight: 600}}>Other</div>
                      <input
                        type="text"
                        value={usedSomethingElseInput}
                        onChange={(e) => setUsedSomethingElseInput(e.target.value)}
                        placeholder="e.g. dermaplane razor"
                        className="w-full rounded-[12px] px-3 py-2.5 text-[13px]"
                        style={{background: 'var(--cream-deep)', border: '1px solid var(--line)', color: 'var(--ink)'}}
                      />
                      <div className="flex gap-2">
                        <button
                          type="button"
                          onClick={() => { setUsedSomethingElseKind(null); setUsedSomethingElseInput(''); }}
                          className="flex-1 rounded-full py-2.5 px-4 text-[11px] tracking-[0.18em] uppercase transition hover:opacity-80"
                          style={{background: 'transparent', color: 'var(--ink-soft)', border: '1px solid var(--line)', fontWeight: 600, cursor: 'pointer'}}
                        >Back</button>
                        <button
                          type="button"
                          onClick={() => {
                            const trimmed = usedSomethingElseInput.trim();
                            if (!trimmed) return;
                            appendExtra(`${trimmed} · device`);
                            close();
                          }}
                          disabled={!usedSomethingElseInput.trim()}
                          className="flex-1 rounded-full py-2.5 px-4 text-[11px] tracking-[0.18em] uppercase transition hover:opacity-90 disabled:opacity-50"
                          style={{background: 'var(--accent)', color: 'var(--cream)', border: '1px solid var(--accent)', fontWeight: 600, cursor: usedSomethingElseInput.trim() ? 'pointer' : 'not-allowed'}}
                        >Add</button>
                      </div>
                    </>
                  ) : (
                    <>
                      <input
                        type="text"
                        value={usedSomethingElseInput}
                        onChange={(e) => setUsedSomethingElseInput(e.target.value)}
                        placeholder={usedSomethingElseKind === 'supplement' ? 'e.g. Vitamin D 1000 IU · started today' : 'e.g. Slept 5h, felt tight'}
                        className="w-full rounded-[12px] px-3 py-2.5 text-[13px]"
                        style={{
                          background: 'var(--cream-deep)',
                          border: '1px solid var(--line)',
                          color: 'var(--ink)',
                        }}
                        autoFocus
                      />
                      <div className="flex gap-2">
                        <button
                          type="button"
                          onClick={() => { setUsedSomethingElseKind(null); setUsedSomethingElseInput(''); }}
                          className="flex-1 rounded-full py-2.5 px-4 text-[11px] tracking-[0.18em] uppercase transition hover:opacity-80"
                          style={{background: 'transparent', color: 'var(--ink-soft)', border: '1px solid var(--line)', fontWeight: 600, cursor: 'pointer'}}
                        >Back</button>
                        <button
                          type="button"
                          onClick={() => {
                            const trimmed = usedSomethingElseInput.trim();
                            if (!trimmed) return;
                            const label = usedSomethingElseKind === 'supplement' ? `${trimmed} · supplement` : `${trimmed} · note`;
                            appendExtra(label);
                            close();
                          }}
                          disabled={!usedSomethingElseInput.trim()}
                          className="flex-1 rounded-full py-2.5 px-4 text-[11px] tracking-[0.18em] uppercase transition hover:opacity-90 disabled:opacity-50"
                          style={{background: 'var(--accent)', color: 'var(--cream)', border: '1px solid var(--accent)', fontWeight: 600, cursor: usedSomethingElseInput.trim() ? 'pointer' : 'not-allowed'}}
                        >Add</button>
                      </div>
                    </>
                  )}
                </div>
              ) : (
                <>
                  <div
                    className="rounded-[20px] overflow-hidden"
                    style={{border: '1px solid var(--line)', background: 'var(--cream)'}}
                  >
                    {renderOption('Layers', 'Used another shelf product', isToday ? 'Add from your shelf for today.' : `Add from your shelf for ${dateLabel}.`, () => {
                      close();
                      const slot = sheet.slot || 'am';
                      const date = sheet.date || localDateISO();
                      // June 2026: track that user came from the add menu so
                      // every downstream surface can offer a "Back to add menu" link.
                      setAddMenuReturnContext({ slot, date });
                      if (typeof setShelfQuickAddOpen === 'function') {
                        setShelfQuickAddOpen({ open: true, date, slot });
                      }
                    })}
                    <div style={{height: 1, background: 'var(--line)', margin: '0 18px'}} />
                    {renderOption('Plus', 'Started a new product', 'Save it, then mark it used today.', () => {
                      close();
                      const slot = sheet.slot || 'am';
                      const date = sheet.date || localDateISO();
                      setAddMenuReturnContext({ slot, date });
                      setProductModalRegimenContext({ slot, date });
                      setEditingProductId(null);
                      setShowProductModal(true);
                    })}
                    <div style={{height: 1, background: 'var(--line)', margin: '0 18px'}} />
                    {renderOption('Activity', 'Had a procedure', 'Facial, microneedling, peel, etc.', () => {
                      close();
                      setEditingProcedureId && setEditingProcedureId(null);
                      setShowProcedureModal && setShowProcedureModal(true);
                    })}
                    <div style={{height: 1, background: 'var(--line)', margin: '0 18px'}} />
                    {renderOption('Pill', 'Took supplement / medication', 'Started or changed something.', () => {
                      setUsedSomethingElseKind('supplement');
                    })}
                    <div style={{height: 1, background: 'var(--line)', margin: '0 18px'}} />
                    {renderOption('Zap', 'Used a device', 'LED, microcurrent, gua sha, ice roller…', () => {
                      setUsedSomethingElseKind('device');
                    })}
                    <div style={{height: 1, background: 'var(--line)', margin: '0 18px'}} />
                    {renderOption('FileText', 'Add a note', 'Sleep, stress, irritation.', () => {
                      setUsedSomethingElseKind('note');
                    })}
                    <div style={{height: 1, background: 'var(--line)', margin: '0 18px'}} />
                    {/* === GOING TRAVELING (June 2026 per Jenni) ===
                        Phase 2 update: routes directly to the dedicated
                        TravelSetupModal instead of the Refine intent +
                        Build view detour. The modal captures destination,
                        dates, location kind, and the packed product set —
                        which then triggers the cover banner + ritual swap
                        + log tagging for the duration of the trip. */}
                    {renderOption('Briefcase', 'Going traveling', 'Pack a routine for the trip.', () => {
                      close();
                      setShowTravelSetupModal(true);
                    })}
                  </div>
                  <button
                    type="button"
                    onClick={close}
                    className="w-full mt-4 py-3 text-[12.5px] tracking-[0.04em] transition hover:opacity-70"
                    style={{color: 'var(--ink-soft)', cursor: 'pointer', fontWeight: 500, background: 'transparent', border: 0}}
                  >
                    Cancel
                  </button>
                </>
              )}
            </div>
          </div>
        );
      })()}
      {/* === ADD-DEVICE picker sheet (May 2026 per Jenni) ===
          Curated list of common devices. Selecting an item pre-fills
          ProductModal in manual mode with the device name + a 'device'
          tag, so the user lands on the edit form already populated.
          Custom routes to a blank manual entry with the device tag set
          for free-text entry. */}
      {addDeviceSheet && (() => {
        const close = () => setAddDeviceSheet(false);
        const COMMON_DEVICES = [
          { name: 'Red light therapy (LED panel)', icon: 'Sun' },
          { name: 'Microcurrent device (e.g. NuFACE)', icon: 'Zap' },
          { name: 'High-frequency wand', icon: 'Activity' },
          { name: 'Cleansing brush (e.g. Foreo Luna)', icon: 'Droplets' },
          { name: 'Ice roller / globes', icon: 'Snowflake' },
          { name: 'Gua sha', icon: 'Triangle' },
          { name: 'Dermaroller / microneedling (home)', icon: 'Layers' },
        ];
        const openModalWithDevice = (deviceName) => {
          setEditingProductId(null);
          setProductForm({
            name: deviceName || '',
            brand: '',
            category: 'treatment',
            startDate: '', endDate: '',
            activeIngredients: '',
            mainIngredients: '',
            tags: ['device'],
            concerns: [],
            useDays: [0,1,2,3,4,5,6],
            useTimes: [],
            frequency: 'weekly',
            notes: deviceName ? `Device: ${deviceName}` : 'Device: ',
            photo: null, photoPath: null, status: 'active',
          });
          if (typeof setProductEntryMode === 'function') setProductEntryMode('manual');
          setShowProductModal(true);
          close();
        };
        return (
          <div
            className="fixed inset-0 z-[64] flex items-end md:items-center justify-center"
            style={{
              background: 'rgba(20, 16, 14, 0.55)',
              backdropFilter: 'blur(6px)',
              WebkitBackdropFilter: 'blur(6px)',
              animation: 'addPhotoFadeIn 180ms ease-out',
            }}
            onClick={close}
          >
            <div
              role="dialog"
              aria-modal="true"
              aria-labelledby="add-device-title"
              onClick={(e) => e.stopPropagation()}
              className="w-full max-w-[420px] rounded-t-[28px] md:rounded-[28px]"
              style={{
                background: 'var(--cream)',
                border: '1px solid var(--line)',
                padding: 24,
                boxShadow: '0 24px 70px rgba(39, 31, 27, 0.22), 0 2px 6px rgba(39, 31, 27, 0.05)',
                animation: 'addPhotoPopIn 220ms cubic-bezier(0.16, 1, 0.3, 1)',
              }}
            >
              <div className="mb-2">
                <h2
                  id="add-device-title"
                  className="text-[20px] leading-tight"
                  style={{color: 'var(--ink)', fontWeight: 700, letterSpacing: '-0.018em', margin: 0}}
                >
                  Add a device
                </h2>
              </div>
              <p className="text-[12px] mb-4 leading-snug" style={{color: 'var(--ink-soft)'}}>
                Pick a common device or add your own.
              </p>
              <div
                className="rounded-[20px] overflow-hidden"
                style={{border: '1px solid var(--line)', background: 'var(--cream)'}}
              >
                {COMMON_DEVICES.map((d, i) => (
                  <React.Fragment key={d.name}>
                    {i > 0 && <div style={{height: 1, background: 'var(--line)', margin: '0 18px'}} />}
                    <button
                      type="button"
                      onClick={() => openModalWithDevice(d.name)}
                      className="w-full flex items-center gap-4 px-5 py-3.5 transition hover:bg-[var(--cream-deep)] active:bg-[var(--cream-deep)]"
                      style={{cursor: 'pointer', textAlign: 'left'}}
                    >
                      <span
                        className="flex-shrink-0 flex items-center justify-center"
                        style={{
                          width: 34, height: 34, borderRadius: '50%',
                          background: 'rgba(192, 95, 60, 0.10)',
                          border: '1px solid rgba(192, 95, 60, 0.15)',
                        }}
                      >
                        <Icon name={d.icon} size={14} style={{color: 'var(--accent)'}} />
                      </span>
                      <span className="min-w-0 flex-1 text-[13.5px] leading-tight" style={{color: 'var(--ink)', fontWeight: 600, letterSpacing: '-0.01em'}}>{d.name}</span>
                      <Icon name="ChevronRight" size={13} style={{color: 'var(--ink-soft)', flexShrink: 0}} />
                    </button>
                  </React.Fragment>
                ))}
                <div style={{height: 1, background: 'var(--line)', margin: '0 18px'}} />
                <button
                  type="button"
                  onClick={() => openModalWithDevice('')}
                  className="w-full flex items-center gap-4 px-5 py-3.5 transition hover:bg-[var(--cream-deep)] active:bg-[var(--cream-deep)]"
                  style={{cursor: 'pointer', textAlign: 'left'}}
                >
                  <span
                    className="flex-shrink-0 flex items-center justify-center"
                    style={{
                      width: 34, height: 34, borderRadius: '50%',
                      background: 'var(--cream-deep)',
                      border: '1px solid var(--line)',
                    }}
                  >
                    <Icon name="Plus" size={14} style={{color: 'var(--ink-soft)'}} />
                  </span>
                  <span className="min-w-0 flex-1">
                    <span className="block text-[13.5px] leading-tight" style={{color: 'var(--ink)', fontWeight: 600, letterSpacing: '-0.01em'}}>Custom device</span>
                    <span className="block text-[11px] mt-0.5" style={{color: 'var(--ink-soft)'}}>Type the device name yourself.</span>
                  </span>
                  <Icon name="ChevronRight" size={13} style={{color: 'var(--ink-soft)', flexShrink: 0}} />
                </button>
              </div>
              <button
                type="button"
                onClick={close}
                className="w-full mt-4 py-3 text-[12.5px] tracking-[0.04em] transition hover:opacity-70"
                style={{color: 'var(--ink-soft)', cursor: 'pointer', fontWeight: 500, background: 'transparent', border: 0}}
              >
                Cancel
              </button>
            </div>
          </div>
        );
      })()}
      {/* === ADD-PRESCRIPTION picker sheet (May 2026 per Jenni) ===
          Curated list of common Rx items. Same pattern as device picker:
          selecting pre-fills ProductModal in manual mode; Custom opens a
          blank manual entry with the prescription tag. */}
      {addRxSheet && (() => {
        const close = () => setAddRxSheet(false);
        const COMMON_RX = [
          { name: 'Tretinoin', sub: 'Topical retinoid', icon: 'Sparkles' },
          { name: 'Adapalene (Differin Rx-strength)', sub: 'Topical retinoid', icon: 'Sparkles' },
          { name: 'Tazarotene', sub: 'Topical retinoid', icon: 'Sparkles' },
          { name: 'Spironolactone', sub: 'Oral anti-androgen', icon: 'Pill' },
          { name: 'Isotretinoin (Accutane)', sub: 'Oral retinoid', icon: 'Pill' },
          { name: 'Hydroquinone', sub: 'Topical brightener', icon: 'Droplet' },
          { name: 'Azelaic acid (Rx-strength)', sub: 'Topical for redness + pigment', icon: 'Droplet' },
          { name: 'Topical antibiotic (clindamycin, etc.)', sub: 'Topical anti-bacterial', icon: 'Droplet' },
          { name: 'Topical steroid', sub: 'Short-course flare control', icon: 'Droplet' },
        ];
        const openModalWithRx = (rxName, rxSub) => {
          setEditingProductId(null);
          setProductForm({
            name: rxName || '',
            brand: '',
            category: 'treatment',
            startDate: '', endDate: '',
            activeIngredients: rxName || '',
            mainIngredients: '',
            tags: ['prescription'],
            concerns: [],
            useDays: [0,1,2,3,4,5,6],
            useTimes: [],
            frequency: 'daily',
            notes: rxName
              ? `Prescription: ${rxName}${rxSub ? ` (${rxSub})` : ''}`
              : 'Prescription: ',
            photo: null, photoPath: null, status: 'active',
          });
          if (typeof setProductEntryMode === 'function') setProductEntryMode('manual');
          setShowProductModal(true);
          close();
        };
        return (
          <div
            className="fixed inset-0 z-[64] flex items-end md:items-center justify-center"
            style={{
              background: 'rgba(20, 16, 14, 0.55)',
              backdropFilter: 'blur(6px)',
              WebkitBackdropFilter: 'blur(6px)',
              animation: 'addPhotoFadeIn 180ms ease-out',
            }}
            onClick={close}
          >
            <div
              role="dialog"
              aria-modal="true"
              aria-labelledby="add-rx-title"
              onClick={(e) => e.stopPropagation()}
              className="w-full max-w-[420px] rounded-t-[28px] md:rounded-[28px]"
              style={{
                background: 'var(--cream)',
                border: '1px solid var(--line)',
                padding: 24,
                boxShadow: '0 24px 70px rgba(39, 31, 27, 0.22), 0 2px 6px rgba(39, 31, 27, 0.05)',
                animation: 'addPhotoPopIn 220ms cubic-bezier(0.16, 1, 0.3, 1)',
                maxHeight: '85vh', overflowY: 'auto',
              }}
            >
              <div className="mb-2">
                <h2
                  id="add-rx-title"
                  className="text-[20px] leading-tight"
                  style={{color: 'var(--ink)', fontWeight: 700, letterSpacing: '-0.018em', margin: 0}}
                >
                  Add or update prescription
                </h2>
              </div>
              <p className="text-[12px] mb-4 leading-snug" style={{color: 'var(--ink-soft)'}}>
                Pick a common Rx or add your own. Your provider's exact dose
                + cadence goes on the next screen.
              </p>
              <div
                className="rounded-[20px] overflow-hidden"
                style={{border: '1px solid var(--line)', background: 'var(--cream)'}}
              >
                {COMMON_RX.map((r, i) => (
                  <React.Fragment key={r.name}>
                    {i > 0 && <div style={{height: 1, background: 'var(--line)', margin: '0 18px'}} />}
                    <button
                      type="button"
                      onClick={() => openModalWithRx(r.name, r.sub)}
                      className="w-full flex items-center gap-4 px-5 py-3.5 transition hover:bg-[var(--cream-deep)] active:bg-[var(--cream-deep)]"
                      style={{cursor: 'pointer', textAlign: 'left'}}
                    >
                      <span
                        className="flex-shrink-0 flex items-center justify-center"
                        style={{
                          width: 34, height: 34, borderRadius: '50%',
                          background: 'rgba(192, 95, 60, 0.10)',
                          border: '1px solid rgba(192, 95, 60, 0.15)',
                        }}
                      >
                        <Icon name={r.icon} size={14} style={{color: 'var(--accent)'}} />
                      </span>
                      <span className="min-w-0 flex-1">
                        <span className="block text-[13.5px] leading-tight" style={{color: 'var(--ink)', fontWeight: 600, letterSpacing: '-0.01em'}}>{r.name}</span>
                        <span className="block text-[11px] mt-0.5" style={{color: 'var(--ink-soft)'}}>{r.sub}</span>
                      </span>
                      <Icon name="ChevronRight" size={13} style={{color: 'var(--ink-soft)', flexShrink: 0}} />
                    </button>
                  </React.Fragment>
                ))}
                <div style={{height: 1, background: 'var(--line)', margin: '0 18px'}} />
                <button
                  type="button"
                  onClick={() => openModalWithRx('', '')}
                  className="w-full flex items-center gap-4 px-5 py-3.5 transition hover:bg-[var(--cream-deep)] active:bg-[var(--cream-deep)]"
                  style={{cursor: 'pointer', textAlign: 'left'}}
                >
                  <span
                    className="flex-shrink-0 flex items-center justify-center"
                    style={{
                      width: 34, height: 34, borderRadius: '50%',
                      background: 'var(--cream-deep)',
                      border: '1px solid var(--line)',
                    }}
                  >
                    <Icon name="Plus" size={14} style={{color: 'var(--ink-soft)'}} />
                  </span>
                  <span className="min-w-0 flex-1">
                    <span className="block text-[13.5px] leading-tight" style={{color: 'var(--ink)', fontWeight: 600, letterSpacing: '-0.01em'}}>Custom prescription</span>
                    <span className="block text-[11px] mt-0.5" style={{color: 'var(--ink-soft)'}}>Type the Rx name yourself.</span>
                  </span>
                  <Icon name="ChevronRight" size={13} style={{color: 'var(--ink-soft)', flexShrink: 0}} />
                </button>
              </div>
              <button
                type="button"
                onClick={close}
                className="w-full mt-4 py-3 text-[12.5px] tracking-[0.04em] transition hover:opacity-70"
                style={{color: 'var(--ink-soft)', cursor: 'pointer', fontWeight: 500, background: 'transparent', border: 0}}
              >
                Cancel
              </button>
            </div>
          </div>
        );
      })()}
      {/* === REMOVE-SCOPE PROMPT (May 2026 — Daily Ritual Loop Tier 2 / Audit #4) ===
          Fires when the user taps X on a product in Today's Ritual card.
          Default path (dominant CTA): "Skip today" — write to today's
            regimenLog only (routine unchanged for future).
          Explicit secondary path (quiet link): "Remove from routine" —
            also strips the slot from product.useTimes so future days no
            longer auto-include it. Product stays on the shelf.
          Per audit #4: X defaults to skip-today; only an explicit choice
          changes the future routine. */}
      {removeScopePrompt && (() => {
        const { product, slot, today, seedAmIds, seedPmIds } = removeScopePrompt;
        const slotLabel = slot === 'am' ? 'AM' : 'PM';
        const productName = product?.displayName || product?.name || 'this product';
        const close = () => setRemoveScopePrompt(null);
        const removeFromToday = () => {
          const targetLog = (regimenLogs || []).find(r => r.date === today);
          const slotKey = slot === 'am' ? 'amProducts' : 'pmProducts';
          const otherKey = slot === 'am' ? 'pmProducts' : 'amProducts';
          const baseLog = targetLog || {
            id: Date.now(),
            date: today,
            amProducts: Array.isArray(seedAmIds) ? [...seedAmIds] : [],
            pmProducts: Array.isArray(seedPmIds) ? [...seedPmIds] : [],
            amDone: [], pmDone: [], notes: '', submitted: false,
          };
          const updated = {
            ...baseLog,
            [slotKey]: (baseLog[slotKey] || []).filter(id => id !== product.id),
            [otherKey]: baseLog[otherKey] || [],
          };
          const exists = (regimenLogs || []).some(r => r.date === today);
          const newLogs = exists
            ? regimenLogs.map(r => r.date === today ? updated : r)
            : [updated, ...(regimenLogs || [])];
          setRegimenLogs(newLogs);
          saveData('regimenLogs', newLogs).catch(e => {
            console.error('[remove-today] saveData failed:', e);
            toast(`Save error: ${e?.message || 'unknown'}`, 'error');
          });
          setCoverRoutineRebuildToken(t => t + 1);
          toast(`Skipped for today's ${slotLabel}`, 'info');
          close();
        };
        const removeFromRoutine = () => {
          // Step 1: same as today removal (so it disappears from cover now).
          removeFromToday();
          // Step 2: strip the slot from product.useTimes so future days
          // don't auto-include it. Use sanitizeProductForSave to keep the
          // schema normalized.
          const nextUseTimes = (Array.isArray(product.useTimes) ? product.useTimes : [])
            .map(t => String(t).toLowerCase())
            .filter(t => t !== slot);
          const updatedProducts = (products || []).map(p =>
            p.id === product.id
              ? sanitizeProductForSave({ ...p, useTimes: nextUseTimes })
              : p
          );
          setProducts(updatedProducts);
          saveData('products', updatedProducts).catch(() => {});
          setCoverRoutineRebuildToken(t => t + 1);
          toast(`${productName} removed from ${slotLabel} routine`, 'info');
        };
        return (
          <div
            className="fixed inset-0 z-[64] flex items-end md:items-center justify-center px-3 py-6"
            style={{background:'rgba(0,0,0,0.55)'}}
            onClick={close}
          >
            <div
              className="w-full max-w-sm rounded-[20px] overflow-hidden"
              style={{background:'var(--cream)', border: '1px solid var(--line)'}}
              onClick={(e) => e.stopPropagation()}
            >
              <div className="px-5 pt-5 pb-3">
                <div className="text-[9px] tracking-[0.26em] uppercase mb-1.5" style={{color:'var(--accent)', fontWeight:600}}>Skip · {slotLabel}</div>
                <h3 className="text-[17px] leading-tight" style={{color:'var(--ink)', fontWeight:600, letterSpacing:'-0.012em'}}>
                  Skip {productName} today?
                </h3>
                <p className="text-[11.5px] mt-1.5 leading-snug" style={{color:'var(--ink-soft)'}}>
                  Today's {slotLabel} only. Tomorrow's routine stays as planned.
                </p>
              </div>
              <div className="px-5 pb-3">
                <button
                  type="button"
                  onClick={removeFromToday}
                  className="w-full rounded-full py-3 px-4 flex items-center justify-center gap-2 transition hover:opacity-90"
                  style={{background:'var(--accent)', color:'var(--cream)', border:'1px solid var(--accent)', fontWeight:600, fontSize:13, letterSpacing:'0.04em', cursor:'pointer'}}
                >
                  <Icon name="Check" size={13} />
                  <span>Skip today</span>
                </button>
              </div>
              <div className="px-5 pb-4 flex flex-col items-center gap-2.5">
                <button
                  type="button"
                  onClick={removeFromRoutine}
                  className="text-[11px] transition hover:opacity-70"
                  style={{color:'var(--ink-soft)', textDecoration:'underline', textUnderlineOffset:'3px', cursor:'pointer'}}
                  title={`Remove ${productName} from your ${slotLabel} routine going forward`}
                >
                  Or remove from routine
                </button>
              </div>
              <div className="px-4 py-3 border-t flex justify-end" style={{borderColor: 'var(--line)', background:'var(--cream-deep)'}}>
                <button
                  type="button"
                  onClick={close}
                  className="text-[10px] tracking-[0.18em] uppercase"
                  style={{color:'var(--ink-soft)', fontWeight:600, cursor:'pointer'}}
                >Cancel</button>
              </div>
            </div>
          </div>
        );
      })()}
      {/* === SAMPLE ROUTINE PREVIEW MODAL (May 2026 — empty-state Home) ===
          Opens from the Sample Routine card OR the three Explore Sample
          Routines cards on the empty-state Home. Read-only preview of an
          AM/PM list with a small footer of CTAs. "Add to my routine"
          routes to the Build wizard so the user can shape a real
          routine from the sample as starting context. */}
      {sampleRoutinePreview && (() => {
        const r = sampleRoutinePreview;
        const close = () => setSampleRoutinePreview(null);
        return (
          <div
            className="fixed inset-0 z-[80] flex items-end md:items-center justify-center px-3 py-6"
            style={{background:'rgba(0,0,0,0.55)'}}
            onClick={close}
          >
            <div
              className="w-full max-w-md rounded-[20px] overflow-hidden"
              style={{background:'var(--cream)', border: '1px solid var(--line)', maxHeight:'90vh', overflowY:'auto'}}
              onClick={(e) => e.stopPropagation()}
            >
              <div className="px-5 pt-5 pb-3 border-b" style={{borderColor: 'var(--line)'}}>
                <div className="flex items-center gap-1.5 mb-2">
                  <Icon name={r.icon || 'Sparkles'} size={12} style={{color:'var(--accent)'}} />
                  <div className="text-[9px] tracking-[0.26em] uppercase" style={{color:'var(--accent)', fontWeight:600}}>Sample Routine</div>
                </div>
                <h3 className="font-serif text-[22px] leading-tight mb-1" style={{color:'var(--ink)', fontWeight:700, letterSpacing:'-0.018em'}}>{r.label}</h3>
                <p className="text-[11.5px] leading-snug" style={{color:'var(--ink-soft)'}}>{r.blurb}</p>
              </div>
              <div className="px-5 py-4">
                <div className="grid grid-cols-2 gap-4">
                  <div>
                    <div className="text-[9px] tracking-[0.24em] uppercase mb-2" style={{color:'var(--accent)', fontWeight:600}}>AM</div>
                    <ul className="space-y-2">
                      {(r.am || []).map((p, i) => (
                        <li key={i}>
                          <div className="text-[11.5px]" style={{color:'var(--ink)', fontWeight:600}}>{p.name}</div>
                          <div className="text-[10px] leading-snug" style={{color:'var(--ink-soft)'}}>{p.sub}</div>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <div className="text-[9px] tracking-[0.24em] uppercase mb-2" style={{color:'var(--ink-soft)', fontWeight:600}}>PM</div>
                    <ul className="space-y-2">
                      {(r.pm || []).map((p, i) => (
                        <li key={i}>
                          <div className="text-[11.5px]" style={{color:'var(--ink)', fontWeight:600}}>{p.name}</div>
                          <div className="text-[10px] leading-snug" style={{color:'var(--ink-soft)'}}>{p.sub}</div>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
              <div className="px-5 pb-4 space-y-2">
                <button
                  type="button"
                  onClick={() => { close(); setActiveTab('regimen'); setRegimenView('build'); }}
                  className="w-full rounded-full py-2.5 px-4 flex items-center justify-center gap-1.5 transition hover:opacity-90"
                  style={{background:'var(--accent)', color:'var(--cream)', border:'1px solid var(--accent)', fontWeight:600, fontSize:11, letterSpacing:'0.14em', cursor:'pointer', textTransform:'uppercase'}}
                >
                  <Icon name="ArrowRight" size={11} />
                  <span>Use as starting point</span>
                </button>
                <button
                  type="button"
                  onClick={close}
                  className="w-full text-center py-2 transition hover:opacity-70"
                  style={{color:'var(--ink-soft)', fontWeight:600, fontSize:10, letterSpacing:'0.22em', cursor:'pointer', textTransform:'uppercase'}}
                >Keep exploring</button>
              </div>
            </div>
          </div>
        );
      })()}
      {/* === REFINE — INTENT SHEET (May 2026 v3, item 6 per Jenni) ===
          Per-intent picker instead of AI prose. For intents with a clean
          family map (glow / irritation / recovery / barrier / climate):
            - Score user's shelf products by family priority for the intent
            - Show top 3 with the best match preselected; user can multi-select
            - If user has zero products in the TOP-PRIORITY family, surface
              up to 2 curated alternatives (not in their shelf, no buy link)
            - "Apply to this week" writes a sensible cadence/useTimes to
              selected shelf products (vitC daily AM, AHA 3x/week PM, etc.)
            - "Talk through it" preserves the old Counsel path for users
              who want the prose
          For intents WITHOUT a family map (simplify / travel): falls back
          to the Counsel-only card — no picker, since family scoring would
          give garbage. */}
      {refineSheetOpen && refineIntent && (() => {
        const close = () => { setRefineSheetOpen(false); setRefineIntent(null); setRefinePickerSelections({}); setRefinePlanAnswers({}); };
        // === FAMILY MAP LOOKUP — drives picker vs Counsel-only branching ===
        const familyPriority = REFINE_INTENT_FAMILIES[refineIntent.id] || null;
        // === SHELF SCORING ===
        // For each active product, detect its family and assign a score
        // based on position in familyPriority. Lower index = better fit.
        // Products with no family match are dropped. Top 3 surface.
        const activeProducts = (products || []).filter(p => !p.endDate);
        let shelfPicks = [];
        if (familyPriority) {
          shelfPicks = activeProducts
            .map(p => {
              const fam = detectActiveFamily(p.activeIngredients || p.actives || '');
              const idx = fam ? familyPriority.indexOf(fam) : -1;
              return { product: p, family: fam, score: idx };
            })
            .filter(x => x.score >= 0)
            .sort((a, b) => a.score - b.score)
            .slice(0, 3);
        }
        // === RECOMMENDED OPTIONS ===
        // These are not-from-shelf references. Keep them tight so the sheet
        // stays actionable instead of becoming a shopping directory.
        const topFamily = familyPriority?.[0];
        const normalizeRecText = (value) => String(value || '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, ' ')
          .trim();
        const shelfProductKeys = new Set(activeProducts.map(p => `${normalizeRecText(p.brand)}|${normalizeRecText(p.name)}`));
        const shelfProductNames = new Set(activeProducts.map(p => normalizeRecText(`${p.brand || ''} ${p.name || ''}`)));
        const isRecommendedOnShelf = (alt) => {
          const key = `${normalizeRecText(alt.brand)}|${normalizeRecText(alt.name)}`;
          const full = normalizeRecText(`${alt.brand || ''} ${alt.name || ''}`);
          return shelfProductKeys.has(key) || shelfProductNames.has(full);
        };
        const recommendedOptions = topFamily
          ? (REFINE_CURATED_ALTERNATIVES[topFamily] || [])
              .filter(alt => !isRecommendedOnShelf(alt))
              .slice(0, 3)
          : [];
        const planContextText = [
          refinePlanAnswers.context,
          refinePlanAnswers.timing,
          refinePlanAnswers.climate,
          refinePlanAnswers.eventType,
          refinePlanAnswers.procedureType,
          refinePlanAnswers.energy,
          refinePlanAnswers.duration,
          refinePlanAnswers.risk,
          refinePlanAnswers.note,
        ].filter(Boolean).join(' ').toLowerCase();
        const timingValue = String(refinePlanAnswers.timing || '').trim();
        const planDaysUntil = (() => {
          if (timingValue === 'today' || timingValue === 'tomorrow' || timingValue === 'this-week') return 3;
          if (timingValue === 'next-week' || timingValue === 'two-weeks') return 14;
          if (timingValue === 'one-month') return 30;
          if (timingValue === 'one-to-three-months') return 60;
          if (timingValue === 'three-plus-months') return 100;
          return null;
        })();
        const isDryTrip = /\b(dry|desert|plane|flight|winter|cold|ski|altitude|heated|cabin)\b/.test(planContextText);
        const isHumidTrip = /\b(humid|tropical|beach|hot|sweat|sweaty|gym|pool)\b/.test(planContextText);
        const isAblativeLike = /\b(peel|laser|ablative|co2|fraxel|rf|radiofrequency|microneedl|micro needl|morpheus|vivace|skinpen)\b/.test(planContextText);
        const isGentleFacial = /\b(facial|hydrafacial|extraction|dermaplane)\b/.test(planContextText) && !isAblativeLike;
        const fallbackRecommendations = (() => {
          const id = refineIntent.id;
          if (id === 'simplify') return [
            { title: 'Pick one strong-active lane', body: 'Keep either exfoliation or retinoid as the weekly driver; avoid stacking both when skin feels overloaded.' },
            { title: 'Protect the boring basics', body: 'Cleanser, moisturizer, and SPF stay. The easiest simplification is usually fewer treatment nights, not fewer barrier steps.' },
            { title: 'Run a one-week lighter test', body: 'Use the simpler cadence for seven days, then restore actives only if redness and dryness stay quiet.' },
          ];
          if (id === 'travel') return [
            { title: 'Pack a shelf, not a suitcase', body: 'Cleanser, moisturizer, and SPF are the non-negotiables. One familiar treatment product max.' },
            { title: isDryTrip ? 'Plane air is barrier theft' : isHumidTrip ? 'Sweat changes tolerance' : 'No travel-week experiments', body: isDryTrip ? 'Use moisturizer twice daily and skip exfoliating acids until you are settled.' : isHumidTrip ? 'Keep layers light, cleanse at night, and do not add extra acids just because you feel oily.' : 'No new retinoids, peels, acids, or devices while away. Travel already counts as a skin stressor.' },
            { title: 'SPF becomes the main character', body: 'Daily AM sunscreen, with reapplication if outdoors. Treatment results do not matter if UV is undoing them.' },
          ];
          if (id === 'event') return [
            { title: planDaysUntil != null && planDaysUntil <= 7 ? 'Final week: no heroics' : 'Build glow early, not last-minute', body: planDaysUntil != null && planDaysUntil <= 7 ? 'Pause retinoids, acids, benzoyl peroxide, peels, and new products. Calm skin photographs better than ambitious skin.' : 'Keep proven actives steady now; taper irritation risks as the event gets close.' },
            { title: 'Hydration is the makeup primer', body: 'Moisturizer AM and PM, sunscreen AM, and a calming layer if you own one. This is where the glow comes from.' },
            { title: 'No procedures in the danger window', body: 'Avoid RF microneedling, lasers, medium peels, or first-time facials close to the event. Bruising and PIH do not care about your calendar.' },
          ];
          if (id === 'sick') return [
            { title: 'Minimum viable routine', body: 'Night cleanse if needed, moisturizer twice daily, SPF only if you are seeing daylight. That is enough.' },
            { title: 'Inflammation lowers tolerance', body: 'Hold retinoids, exfoliating acids, benzoyl peroxide, and strong vitamin C while you are feverish, dehydrated, or wiped out.' },
            { title: 'Restart like you have sense', body: 'When energy returns, bring back one active night first. If skin stings, you were not ready.' },
          ];
          if (id === 'routine-change') return [
            { title: 'Put actives where life will allow them', body: 'If mornings are chaotic, treatments move PM. The best routine is the one that survives Tuesday.' },
            { title: planContextText.includes('gym') || planContextText.includes('workout') ? 'Sweat gets a cleanse, not punishment' : 'Cut friction first', body: planContextText.includes('gym') || planContextText.includes('workout') ? 'Cleanse after heavy sweat when you can; do not compensate with extra acid nights.' : 'Keep AM to moisturizer plus SPF if needed. Treatment steps can live at night.' },
            { title: 'Two-week test window', body: 'Use the adjusted cadence for two weeks before deciding it failed. Schedules need data, not vibes.' },
          ];
          if (id === 'procedure-plan') return [
            { title: isAblativeLike ? 'Five-to-seven day active pause' : 'Do not irritate the canvas', body: isAblativeLike ? 'Hold retinoids, AHAs/BHAs, benzoyl peroxide, scrubs, and strong vitamin C before and after unless your provider directs otherwise.' : 'Even for a facial, skip exfoliation and retinoids around the appointment if you tend to flush, peel, or sting.' },
            { title: 'Barrier-only until skin is boring', body: 'Gentle cleanse, bland moisturizer, SPF. Restart only after tenderness, peeling, heat, and stinging have settled.' },
            { title: 'Wedding timing rule', body: 'RF microneedling, lasers, and deeper peels need real lead time. For an event, think weeks, not days.' },
          ];
          return [
            { title: 'Start with the current week', body: 'Keep what is working, change one lever, and test for seven days before stacking more edits.' },
            { title: 'Prefer lower-risk changes first', body: 'Spacing, pausing, or shifting timing is safer than adding several new products at once.' },
            { title: 'Escalate only if skin stays calm', body: 'If redness, dryness, or stinging rises, back down before adding another active.' },
          ];
        })();
        // === BEST-MATCH PRESELECTION ===
        // First time the user opens the sheet for a given intent, the
        // top-ranked shelf pick is checked. Subsequent toggles persist
        // until the sheet closes (handled via close() above).
        const bestId = shelfPicks[0]?.product?.id;
        const isChecked = (id) => {
          if (id in refinePickerSelections) return refinePickerSelections[id];
          return id === bestId; // default-checked for the best match
        };
        const toggle = (id) => {
          setRefinePickerSelections(prev => ({
            ...prev,
            [id]: !isChecked(id),
          }));
        };
        // === CADENCE DEFAULTS PER FAMILY ===
        // What "Apply" actually writes when a shelf product gets activated
        // for this intent. Doctor-aligned defaults — daily for tolerant
        // actives (vitC, niacinamide, ceramide), alternating for the
        // sharper ones (retinoid, AHA/BHA).
        const cadenceFor = (family) => {
          // vitC = daily AM
          if (family === 'vitc') return { days: [0,1,2,3,4,5,6], useTimes: ['am'] };
          // SPF = daily AM
          if (family === 'spf') return { days: [0,1,2,3,4,5,6], useTimes: ['am'] };
          // Niacinamide / ceramide / panthenol / centella / humectant = daily,
          // both AM + PM (barrier-supportive — they layer freely)
          if (['niacinamide','ceramide','panthenol','centella','humectant','arbutin'].includes(family)) {
            return { days: [0,1,2,3,4,5,6], useTimes: ['am','pm'] };
          }
          // AHA / BHA = 3x/week PM (Mon, Wed, Fri)
          if (['aha','aha-glycolic','aha-lactic','bha'].includes(family)) {
            return { days: [1,3,5], useTimes: ['pm'] };
          }
          // Retinoid / bakuchiol = 3x/week PM (Tue, Thu, Sat — alternates
          // from acids so the user can't accidentally double-night)
          if (['retinoid','bakuchiol'].includes(family)) {
            return { days: [2,4,6], useTimes: ['pm'] };
          }
          // Azelaic, tranexamic, kojic = daily PM
          if (['azelaic','tranexamic','kojic'].includes(family)) {
            return { days: [0,1,2,3,4,5,6], useTimes: ['pm'] };
          }
          // Fallback — daily PM, single slot
          return { days: [0,1,2,3,4,5,6], useTimes: ['pm'] };
        };
        const formatAppliedSchedule = (applications) => {
          const dayNames = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
          const formatDays = (days = []) => {
            const sorted = [...new Set(days)].sort((a, b) => a - b);
            if (sorted.length === 7) return 'daily';
            if (sorted.join(',') === '1,2,3,4,5') return 'weekdays';
            return sorted.map(d => dayNames[d] || '').filter(Boolean).join('/');
          };
          const uniq = [];
          const seen = new Set();
          applications.forEach(app => {
            const slots = (app.useTimes || []).map(t => String(t).toUpperCase()).join(' + ') || 'unscheduled';
            const label = formatDays(app.days) + ' ' + slots;
            if (!seen.has(label)) { seen.add(label); uniq.push(label); }
          });
          return uniq.slice(0, 2).join(' + ') + (uniq.length > 2 ? ' +' + (uniq.length - 2) : '');
        };
        const buildApplySummary = (applications, actionLabel) => {
          const first = applications.find(app => Array.isArray(app.days) && app.days.length > 0) || applications[0] || {};
          const productNames = applications
            .map(app => {
              const p = app.product || {};
              return [p.brand, p.name].filter(Boolean).join(' ').trim();
            })
            .filter(Boolean);
          const productCount = productNames.length;
          const concernLabel = refineIntent.label || 'This focus';
          const verb = actionLabel === 'built into your week' ? 'built into' : 'addressed in';
          return {
            title: concernLabel + ' is now ' + verb + ' this week',
            schedule: formatAppliedSchedule(applications),
            productNames,
            productCount,
            targetDay: first?.days?.length ? first.days[0] : null,
            targetSlot: (first?.useTimes || [])[0] || null,
          };
        };
        const applyToWeek = () => {
          try {
            const selectedIds = shelfPicks
              .map(x => x.product.id)
              .filter(id => isChecked(id));
            if (selectedIds.length === 0) {
              toast('Pick at least one product', 'info');
              return;
            }
            const applications = [];
            const updated = (products || []).map(p => {
              if (!selectedIds.includes(p.id)) return p;
              const pick = shelfPicks.find(x => x.product.id === p.id);
              if (!pick) return p;
              const c = cadenceFor(pick.family);
              applications.push({ product: p, family: pick.family, days: c.days, useTimes: c.useTimes });
              return sanitizeProductForSave({
                ...p,
                cadence: { days: c.days, frequency: c.days.length },
                useTimes: c.useTimes,
              });
            });
            setProducts(updated);
            saveData('products', updated);
            setCoverRoutineRebuildToken(t => t + 1);
            const summary = buildApplySummary(applications, 'added to your week');
            close();
            setRefineApplySummary(summary);
          } catch (e) {
            console.error('[refine apply]', e);
            toast('Could not apply changes', 'error');
          }
        };
        const fallbackActionLabel = (() => {
          const id = refineIntent.id;
          if (id === 'event') return 'Yes, build event week';
          if (id === 'travel') return 'Yes, build travel week';
          if (id === 'sick') return 'Yes, build low-energy week';
          if (id === 'procedure-plan') return 'Yes, build recovery week';
          if (id === 'routine-change') return 'Yes, adjust my week';
          if (id === 'simplify') return 'Yes, simplify this week';
          return 'Yes, apply this week';
        })();
        const planQuestionConfig = (() => {
          const id = refineIntent.id;
          if (id === 'event') return {
            required: ['eventType','timing'],
            fields: [
              { key: 'eventType', label: 'What is it?', options: [
                { value: 'wedding', label: 'Wedding' },
                { value: 'photos', label: 'Photos / shoot' },
                { value: 'date', label: 'Date / night out' },
                { value: 'presentation', label: 'Presentation' },
              ] },
              { key: 'timing', label: 'When?', options: [
                { value: 'this-week', label: 'This week' },
                { value: 'two-weeks', label: 'About 2 weeks' },
                { value: 'one-month', label: 'About 1 month' },
                { value: 'one-to-three-months', label: '1-3 months' },
              ] },
              { key: 'risk', label: 'Risk tolerance', options: [
                { value: 'ultra-safe', label: 'Ultra safe' },
                { value: 'normal', label: 'Normal' },
                { value: 'ok-peeling', label: 'Okay with mild peeling' },
              ] },
              { key: 'note', label: 'Anything specific?', freeText: true, placeholder: 'Optional: makeup, photos, redness fear...' },
            ],
          };
          if (id === 'travel') return {
            required: ['climate','duration'],
            fields: [
              { key: 'climate', label: 'What kind of trip?', options: [
                { value: 'dry flight altitude', label: 'Dry / flights' },
                { value: 'humid tropical beach hot pool', label: 'Humid / beach' },
                { value: 'cold winter heated cabin', label: 'Cold / winter' },
                { value: 'city work routine change', label: 'City / work' },
              ] },
              { key: 'duration', label: 'How long?', options: [
                { value: 'weekend', label: 'Weekend' },
                { value: 'one-week', label: 'About a week' },
                { value: 'two-plus-weeks', label: '2+ weeks' },
              ] },
              { key: 'risk', label: 'Packing mode', options: [
                { value: 'carry-on', label: 'Carry-on only' },
                { value: 'small-bag', label: 'Small bag' },
                { value: 'full-shelf', label: 'Can pack more' },
              ] },
              { key: 'note', label: 'Anything specific?', freeText: true, placeholder: 'Optional: sun, hiking, wedding trip...' },
            ],
          };
          if (id === 'procedure-plan') return {
            required: ['procedureType','timing'],
            fields: [
              { key: 'procedureType', label: 'What procedure?', options: [
                { value: 'facial hydrafacial extraction dermaplane', label: 'Facial / Hydrafacial' },
                { value: 'light peel', label: 'Light peel' },
                { value: 'rf microneedling micro needling', label: 'RF microneedling' },
                { value: 'laser fraxel co2 ablative', label: 'Laser' },
                { value: 'series plan more procedures', label: 'Series / ongoing plan' },
              ] },
              { key: 'timing', label: 'Timing?', options: [
                { value: 'this-week', label: 'This week' },
                { value: 'two-weeks', label: 'About 2 weeks' },
                { value: 'one-month', label: 'About 1 month' },
                { value: 'one-to-three-months', label: '1-3 months' },
              ] },
              { key: 'risk', label: 'Provider instructions?', options: [
                { value: 'none', label: 'None yet' },
                { value: 'stop-actives', label: 'Stop actives' },
                { value: 'barrier-only', label: 'Barrier only' },
              ] },
              { key: 'note', label: 'Anything specific?', freeText: true, placeholder: 'Optional: exact date, provider rule...' },
            ],
          };
          if (id === 'sick') return {
            required: ['energy'],
            fields: [
              { key: 'energy', label: 'Energy level?', options: [
                { value: 'bed fever flu', label: 'Bed / fever' },
                { value: 'low tired dehydrated', label: 'Low energy' },
                { value: 'functional but tired', label: 'Functional' },
              ] },
              { key: 'duration', label: 'Expected duration?', options: [
                { value: 'few-days', label: 'Few days' },
                { value: 'one-week', label: 'About a week' },
                { value: 'unsure', label: 'Unsure' },
              ] },
              { key: 'note', label: 'Anything specific?', freeText: true, placeholder: 'Optional: flu, migraine, travel sick...' },
            ],
          };
          if (id === 'routine-change') return {
            required: ['context','duration'],
            fields: [
              { key: 'context', label: 'What changed?', options: [
                { value: 'gym workout sweat', label: 'Gym / sweat' },
                { value: 'sleep work night shift', label: 'Sleep / work' },
                { value: 'climate dry humid cold', label: 'Climate' },
                { value: 'schedule chaos travel commute', label: 'Schedule chaos' },
              ] },
              { key: 'duration', label: 'How long?', options: [
                { value: 'temporary week', label: 'Temporary week' },
                { value: 'two-plus-weeks', label: '2+ weeks' },
                { value: 'new-normal', label: 'New normal' },
              ] },
              { key: 'risk', label: 'Hardest slot?', options: [
                { value: 'am-rushed', label: 'AM rushed' },
                { value: 'pm-exhausted', label: 'PM exhausted' },
                { value: 'post-gym', label: 'Post-gym' },
              ] },
              { key: 'note', label: 'Anything specific?', freeText: true, placeholder: 'Optional: days, schedule, commute...' },
            ],
          };
          return null;
        })();
        const planLifecycle = (() => {
          const id = refineIntent.id;
          const eventType = String(refinePlanAnswers.eventType || '');
          const procedureType = String(refinePlanAnswers.procedureType || '');
          const duration = String(refinePlanAnswers.duration || '');
          if (id === 'event' && eventType === 'wedding' && planDaysUntil != null && planDaysUntil > 21) {
            return { mode: 'renewal', label: 'Renewal plan', body: 'Wedding prep with enough runway becomes the standing plan until you change it again.' };
          }
          if (id === 'procedure-plan' && /series|ongoing/.test(procedureType)) {
            return { mode: 'renewal', label: 'Renewal plan', body: 'A procedure series changes the whole skin strategy, so this becomes the standing plan.' };
          }
          if (id === 'routine-change' && duration === 'new-normal') {
            return { mode: 'renewal', label: 'Renewal plan', body: 'This is your new normal, so Frida treats it as the standing cadence.' };
          }
          const resume = id === 'sick' ? 'when energy returns'
            : id === 'travel' ? 'when the trip ends'
            : id === 'event' ? 'after the event'
            : id === 'procedure-plan' ? 'after skin is calm and provider rules clear'
            : 'after this temporary window';
          return { mode: 'temporary', label: 'Temporary overlay', body: `Frida pauses the old cadence, runs this plan, then prompts you to resume the previous routine ${resume}.` };
        })();
        const ChoiceGroup = ({ field }) => (
          <div>
            <div className="text-[8.5px] tracking-[0.18em] uppercase mb-1.5" style={{color:'var(--ink-soft)', fontWeight:600}}>{field.label}</div>
            <div className="flex flex-wrap gap-1.5">
              {(field.options || []).map(opt => {
                const on = refinePlanAnswers[field.key] === opt.value;
                return (
                  <button
                    key={opt.value}
                    type="button"
                    onClick={() => setPlanAnswer(field.key, opt.value)}
                    className="rounded-full px-3 py-1.5 text-[10.5px] transition hover:opacity-80"
                    style={{
                      background: on ? 'var(--accent)' : 'var(--cream)',
                      color: on ? 'var(--cream)' : 'var(--ink)',
                      border: '1px solid ' + (on ? 'var(--accent)' : 'var(--line)'),
                      fontWeight: 600,
                      cursor: 'pointer',
                    }}
                  >
                    {opt.label}
                  </button>
                );
              })}
            </div>
          </div>
        );
        const setPlanAnswer = (key, value) => {
          setRefinePlanAnswers(prev => ({ ...prev, [key]: value }));
        };
        const applyFallbackPlan = () => {
          try {
            const id = refineIntent.id;
            const missing = (planQuestionConfig?.required || []).find(key => !String(refinePlanAnswers[key] || '').trim());
            if (missing) {
              toast(missing === 'date' ? 'Add the date first' : 'Answer the quick question first', 'info');
              return;
            }
            const strongFamilies = new Set(['retinoid','bakuchiol','aha','aha-glycolic','aha-lactic','bha','bpo']);
            const acidFamilies = new Set(['aha','aha-glycolic','aha-lactic','bha']);
            const retinoidFamilies = new Set(['retinoid','bakuchiol']);
            const barrierFamilies = new Set(['ceramide','panthenol','centella','humectant','niacinamide']);
            const pigmentGlowFamilies = new Set(['vitc','azelaic','tranexamic','arbutin','kojic']);
            const productRole = (p) => {
              const text = `${p.category || ''} ${p.name || ''} ${p.brand || ''} ${p.activeIngredients || p.actives || ''}`.toLowerCase();
              if (/sunscreen|spf|uv clear|sun/.test(text)) return 'spf';
              if (/cleanser|cleansing|wash|foam|oil cleanser|micellar/.test(text)) return 'cleanser';
              if (/moisturizer|moisturiser|cream|lotion|balm|barrier/.test(text)) return 'moisturizer';
              return 'treatment';
            };
            const days = {
              daily: [0,1,2,3,4,5,6],
              weekdays: [1,2,3,4,5],
              monThu: [1,4],
              tueFri: [2,5],
              wedSat: [3,6],
              fri: [5],
              weekend: [0,6],
              none: [],
            };
            const isFinalEventWeek = id === 'event' && (planDaysUntil == null || planDaysUntil <= 7);
            const isNearProcedure = id === 'procedure-plan' && (planDaysUntil == null || planDaysUntil <= 10);
            const isMediumProcedureWindow = id === 'procedure-plan' && planDaysUntil != null && planDaysUntil > 10 && planDaysUntil <= 28;
            const oneActiveLane = (fam) => {
              if (retinoidFamilies.has(fam)) return { days: days.monThu, useTimes: ['pm'] };
              if (acidFamilies.has(fam) || fam === 'bpo') return { days: days.wedSat, useTimes: ['pm'] };
              if (fam === 'vitc') return { days: days.weekdays, useTimes: ['am'] };
              if (['azelaic','tranexamic','arbutin','kojic'].includes(fam)) return { days: days.tueFri, useTimes: ['pm'] };
              return null;
            };
            const planCadenceFor = (fam, role, currentDays, currentTimes) => {
              if (role === 'spf') return { days: days.daily, useTimes: ['am'], managed: true };
              if (role === 'cleanser') {
                if (id === 'sick') return { days: days.daily, useTimes: ['pm'], managed: true };
                return { days: days.daily, useTimes: ['am','pm'], managed: true };
              }
              if (role === 'moisturizer' || barrierFamilies.has(fam)) {
                return { days: days.daily, useTimes: ['am','pm'], managed: true };
              }
              if (id === 'sick') {
                return { days: days.none, useTimes: [], managed: false };
              }
              if (id === 'procedure-plan') {
                if (isNearProcedure || isAblativeLike) {
                  if (pigmentGlowFamilies.has(fam) && !isAblativeLike && isGentleFacial) return { days: days.monThu, useTimes: fam === 'vitc' ? ['am'] : ['pm'], managed: true };
                  return { days: days.none, useTimes: [], managed: false };
                }
                if (isMediumProcedureWindow && strongFamilies.has(fam)) return { days: days.fri, useTimes: ['pm'], managed: true };
                const activeLane = oneActiveLane(fam);
                if (activeLane) return { ...activeLane, managed: true };
              }
              if (id === 'event') {
                if (isFinalEventWeek) {
                  if (fam === 'vitc') return { days: days.weekdays, useTimes: ['am'], managed: true };
                  if (['azelaic','tranexamic','arbutin','kojic'].includes(fam)) return { days: days.monThu, useTimes: ['pm'], managed: true };
                  return { days: days.none, useTimes: [], managed: false };
                }
                if (retinoidFamilies.has(fam)) return { days: days.monThu, useTimes: ['pm'], managed: true };
                if (acidFamilies.has(fam) || fam === 'bpo') return { days: days.wedSat, useTimes: ['pm'], managed: true };
                if (fam === 'vitc') return { days: days.weekdays, useTimes: ['am'], managed: true };
                if (['azelaic','tranexamic','arbutin','kojic'].includes(fam)) return { days: days.tueFri, useTimes: ['pm'], managed: true };
              }
              if (id === 'travel') {
                if (isDryTrip && strongFamilies.has(fam)) return { days: days.none, useTimes: [], managed: false };
                if (isHumidTrip && (acidFamilies.has(fam) || fam === 'bpo')) return { days: days.wedSat, useTimes: ['pm'], managed: true };
                if (retinoidFamilies.has(fam)) return { days: days.fri, useTimes: ['pm'], managed: true };
                if (acidFamilies.has(fam) || fam === 'bpo') return { days: days.wedSat, useTimes: ['pm'], managed: true };
                if (fam === 'vitc') return { days: days.weekdays, useTimes: ['am'], managed: true };
              }
              if (id === 'routine-change') {
                if (retinoidFamilies.has(fam)) return { days: days.monThu, useTimes: ['pm'], managed: true };
                if (acidFamilies.has(fam) || fam === 'bpo') return { days: days.wedSat, useTimes: ['pm'], managed: true };
                if (fam === 'vitc') return { days: days.weekdays, useTimes: ['am'], managed: true };
                if (['azelaic','tranexamic','arbutin','kojic'].includes(fam)) return { days: days.tueFri, useTimes: ['pm'], managed: true };
              }
              if (id === 'simplify') {
                if (retinoidFamilies.has(fam)) return { days: days.monThu, useTimes: ['pm'], managed: true };
                if (acidFamilies.has(fam) || fam === 'bpo') return { days: days.fri, useTimes: ['pm'], managed: true };
                if (fam === 'vitc') return { days: days.weekdays, useTimes: ['am'], managed: true };
              }
              return { days: currentDays, useTimes: currentTimes, managed: currentDays.length > 0 };
            };
            const managedProducts = (products || []).filter(p => isRoutineBuiltProduct(p));
            const anchorIds = new Set();
            managedProducts.forEach(p => {
              const fam = detectActiveFamily(p.activeIngredients || p.actives || '');
              const role = productRole(p);
              if (role === 'spf' || role === 'cleanser' || role === 'moisturizer' || barrierFamilies.has(fam)) anchorIds.add(p.id);
            });
            const updated = (products || []).map(p => {
              if (!isRoutineBuiltProduct(p)) return p;
              const fam = detectActiveFamily(p.activeIngredients || p.actives || '');
              const role = productRole(p);
              let nextDays = (p.cadence && Array.isArray(p.cadence.days)) ? [...p.cadence.days] : [];
              let nextTimes = Array.isArray(p.useTimes) ? [...p.useTimes] : [];
              const planned = planCadenceFor(fam, role, nextDays, nextTimes);
              nextDays = planned.days;
              nextTimes = planned.useTimes;

              return sanitizeProductForSave({
                ...p,
                cadence: { days: nextDays, frequency: nextDays.length },
                useTimes: nextTimes,
                routineManaged: planned.managed || anchorIds.has(p.id),
                temporaryPlan: {
                  intent: id,
                  label: refineIntent.label,
                  mode: planLifecycle.mode,
                  shouldResumePrevious: planLifecycle.mode === 'temporary',
                  context: planContextText,
                  timing: refinePlanAnswers.timing || '',
                  notes: refinePlanAnswers.risk || '',
                  freeTextNote: refinePlanAnswers.note || '',
                  appliedAt: new Date().toISOString(),
                },
              });
            });
            setProducts(updated);
            saveData('products', updated);
            setCoverRoutineRebuildToken(t => t + 1);
            const visibleManaged = updated
              .filter(p => isRoutineBuiltProduct(p) && p.cadence && Array.isArray(p.cadence.days) && p.cadence.days.length > 0)
              .map(p => ({ product: p, days: p.cadence.days, useTimes: Array.isArray(p.useTimes) ? p.useTimes : [] }));
            const summary = buildApplySummary(visibleManaged, 'built into your week');
            close();
            setRefineApplySummary(summary);
          } catch (e) {
            console.error('[refine fallback apply]', e);
            toast('Could not build this week', 'error');
          }
        };
        // === PICKER UI vs. COUNSEL-ONLY FALLBACK ===
        // Picker UI surfaces only when (a) the intent has a family map
        // AND (b) the user has at least 1 matching shelf product OR a
        // curated alternative to suggest. Otherwise: Counsel-only card.
        const showPicker = !!familyPriority && (shelfPicks.length > 0 || recommendedOptions.length > 0);
        const FAMILY_NICE_LOCAL = {
          retinoid: 'Retinoid', aha: 'AHA', bha: 'BHA', vitc: 'Vitamin C',
          azelaic: 'Azelaic Acid', arbutin: 'Arbutin', tranexamic: 'Tranexamic',
          niacinamide: 'Niacinamide', ceramide: 'Ceramides', panthenol: 'Panthenol',
          peptide: 'Peptides', centella: 'Centella', humectant: 'Hydration',
          spf: 'SPF', bakuchiol: 'Bakuchiol', bpo: 'BPO',
        };
        return (
          <div
            className="fixed inset-0 z-[64] flex items-end md:items-center justify-center px-3 py-6"
            style={{background:'rgba(0,0,0,0.55)'}}
            onClick={close}
          >
            <div
              className="w-full max-w-md rounded-[20px] overflow-hidden flex flex-col"
              style={{background:'var(--cream)', border: '1px solid var(--line)', maxHeight:'90vh'}}
              onClick={(e) => e.stopPropagation()}
            >
              <div className="px-5 pt-5 pb-3 border-b flex-shrink-0" style={{borderColor: 'var(--line)'}}>
                <div className="text-[9px] tracking-[0.26em] uppercase mb-1.5" style={{color:'var(--accent)', fontWeight:600}}>Refine</div>
                <h3 className="text-[18px] leading-tight mb-1" style={{color:'var(--ink)', fontWeight:600, letterSpacing:'-0.012em'}}>
                  {refineIntent.label}
                </h3>
                {showPicker ? (
                  <p className="text-[11.5px] mt-1.5 leading-snug" style={{color:'var(--ink-soft)'}}>
                    Lean into what you already have. Pick what to push this week.
                  </p>
                ) : (
                  <p className="text-[11.5px] mt-1.5 leading-snug" style={{color:'var(--ink-soft)'}}>
                    We'll read your current routine and propose specific changes — nothing is applied unless you say so.
                  </p>
                )}
              </div>
              {showPicker ? (
                <>
                  <div className="flex-1 overflow-y-auto px-5 py-4 space-y-4">
                    {shelfPicks.length > 0 && (
                      <div>
                        <div className="text-[9px] tracking-[0.28em] uppercase mb-2" style={{color:'var(--ink-soft)', fontWeight:600}}>From your shelf</div>
                        <div className="space-y-1.5">
                          {shelfPicks.map((pick, i) => {
                            const checked = isChecked(pick.product.id);
                            const isBest = pick.product.id === bestId;
                            return (
                              <button
                                key={pick.product.id}
                                type="button"
                                onClick={() => toggle(pick.product.id)}
                                className="w-full text-left rounded-[12px] px-3 py-3 flex items-center gap-3 transition hover:bg-[var(--cream-deep)]"
                                style={{
                                  background: checked ? 'var(--cream-deep)' : 'var(--cream)',
                                  border: '1px solid ' + (checked ? 'var(--accent)' : 'var(--line)'),
                                  cursor: 'pointer',
                                }}
                              >
                                <span
                                  className="flex-shrink-0 w-5 h-5 rounded-[5px] flex items-center justify-center"
                                  style={{
                                    background: checked ? 'var(--accent)' : 'transparent',
                                    border: '1.5px solid ' + (checked ? 'var(--accent)' : 'var(--line)'),
                                  }}
                                >
                                  {checked && <Icon name="Check" size={11} style={{color:'var(--cream)'}} />}
                                </span>
                                <span className="min-w-0 flex-1">
                                  {pick.product.brand && (
                                    <span className="block text-[8.5px] tracking-[0.22em] uppercase truncate" style={{color:'var(--ink-soft)', fontWeight:600}}>{pick.product.brand}</span>
                                  )}
                                  <span className="block text-[12.5px] leading-tight truncate" style={{color:'var(--ink)', fontWeight:600}}>{pick.product.name}</span>
                                  <span className="block text-[10px] mt-0.5" style={{color:'var(--accent)', fontWeight:500}}>
                                    {FAMILY_NICE_LOCAL[pick.family] || pick.family}
                                    {isBest && <span style={{color:'var(--ink-soft)', fontWeight:400}}> · Best fit</span>}
                                  </span>
                                </span>
                              </button>
                            );
                          })}
                        </div>
                      </div>
                    )}
                    {recommendedOptions.length > 0 && (
                      <div>
                        <div className="text-[9px] tracking-[0.28em] uppercase mb-2 flex items-center gap-1.5" style={{color:'var(--ink-soft)', fontWeight:600}}>
                          <Icon name="Plus" size={10} style={{color:'var(--accent)'}} />
                          <span>Recommended options</span>
                        </div>
                        <div className="space-y-1.5">
                          {recommendedOptions.map((alt, i) => (
                            <div
                              key={i}
                              className="rounded-[12px] px-3 py-2.5"
                              style={{background:'var(--cream)', border:'1px dashed var(--line)'}}
                            >
                              <div className="flex items-center justify-between gap-2">
                                <div className="text-[8.5px] tracking-[0.22em] uppercase truncate" style={{color:'var(--ink-soft)', fontWeight:600}}>{alt.brand}</div>
                                {alt.price && (
                                  <div className="text-[8.5px] tracking-[0.16em] uppercase flex-shrink-0" style={{color:'var(--accent)', fontWeight:700}}>{alt.price}</div>
                                )}
                              </div>
                              <div className="text-[12.5px] leading-tight" style={{color:'var(--ink)', fontWeight:600}}>{alt.name}</div>
                              <p className="text-[10.5px] mt-1 leading-snug" style={{color:'var(--ink-soft)'}}>{alt.why}</p>
                            </div>
                          ))}
                        </div>
                        <p className="text-[10px] mt-2 leading-snug italic" style={{color:'var(--ink-soft)'}}>
                          Recommended references — not affiliate. Add manually via Evolve → Add a product if one fits.
                        </p>
                      </div>
                    )}
                    {shelfPicks.length === 0 && recommendedOptions.length === 0 && (
                      <p className="text-[12px] leading-snug" style={{color:'var(--ink-soft)'}}>
                        Nothing on your shelf maps cleanly to this intent yet. Add a product from Evolve, then come back to apply it.
                      </p>
                    )}
                  </div>
                  <div className="px-5 py-3 border-t flex-shrink-0 space-y-2" style={{borderColor: 'var(--line)', background:'var(--cream-deep)'}}>
                    {shelfPicks.length > 0 && (
                      <button
                        type="button"
                        onClick={applyToWeek}
                        className="w-full rounded-full py-3 px-4 flex items-center justify-center gap-2 transition hover:opacity-90"
                        style={{background:'var(--accent)', color:'var(--cream)', border:'1px solid var(--accent)', fontWeight:600, fontSize:13, letterSpacing:'0.04em', cursor:'pointer'}}
                      >
                        <Icon name="Check" size={13} />
                        <span>Apply to this week</span>
                      </button>
                    )}
                    <div className="flex items-center justify-center">
                      <button
                        type="button"
                        onClick={close}
                        className="text-[10px] tracking-[0.18em] uppercase"
                        style={{color:'var(--ink-soft)', fontWeight:600, cursor:'pointer'}}
                      >Cancel</button>
                    </div>
                  </div>
                </>
              ) : (
                <>
                  <div className="flex-1 overflow-y-auto px-5 py-4 space-y-2">
                    {planQuestionConfig && (
                      <div className="rounded-[12px] px-3 py-3 mb-3 space-y-2" style={{background:'var(--cream-deep)', border: '1px solid var(--line)'}}>
                        <div className="text-[9px] tracking-[0.24em] uppercase" style={{color:'var(--accent)', fontWeight:600}}>Quick context</div>
                        <div className="space-y-3">
                          {planQuestionConfig.fields.map(field => field.freeText ? (
                            <label key={field.key} className="block">
                              <span className="block text-[8.5px] tracking-[0.18em] uppercase mb-1" style={{color:'var(--ink-soft)', fontWeight:600}}>{field.label}</span>
                              <textarea
                                value={refinePlanAnswers[field.key] || ''}
                                onChange={(e) => setPlanAnswer(field.key, e.target.value)}
                                placeholder={field.placeholder || ''}
                                rows={2}
                                className="w-full rounded-[10px] px-3 py-2 text-[12px] outline-none resize-none"
                                style={{background:'var(--cream)', border: '1px solid var(--line)', color:'var(--ink)'}}
                              />
                            </label>
                          ) : (
                            <ChoiceGroup key={field.key} field={field} />
                          ))}
                        </div>
                        <div className="rounded-[10px] px-3 py-2 mt-1" style={{background:'var(--cream)', border: '1px solid var(--line)'}}>
                          <div className="text-[8.5px] tracking-[0.18em] uppercase mb-0.5" style={{color:'var(--accent)', fontWeight:650}}>{planLifecycle.label}</div>
                          <p className="text-[10.5px] leading-snug" style={{color:'var(--ink-soft)'}}>{planLifecycle.body}</p>
                        </div>
                      </div>
                    )}
                    <div className="text-[9px] tracking-[0.28em] uppercase mb-2" style={{color:'var(--ink-soft)', fontWeight:600}}>Recommendations</div>
                    {fallbackRecommendations.map((rec, i) => (
                      <div key={i} className="rounded-[12px] px-3 py-3" style={{background:'var(--cream)', border: '1px solid var(--line)'}}>
                        <div className="text-[12.5px] leading-tight" style={{color:'var(--ink)', fontWeight:600}}>{rec.title}</div>
                        <p className="text-[10.5px] mt-1 leading-snug" style={{color:'var(--ink-soft)'}}>{rec.body}</p>
                      </div>
                    ))}
                  </div>
                  <div className="px-5 py-3 border-t flex-shrink-0 space-y-2" style={{borderColor: 'var(--line)', background:'var(--cream-deep)'}}>
                    <button
                      type="button"
                      onClick={applyFallbackPlan}
                      className="w-full rounded-full py-3 px-4 flex items-center justify-center gap-2 transition hover:opacity-90"
                      style={{background:'var(--accent)', color:'var(--cream)', border:'1px solid var(--accent)', fontWeight:600, fontSize:13, letterSpacing:'0.04em', cursor:'pointer'}}
                    >
                      <Icon name="Check" size={13} />
                      <span>{fallbackActionLabel}</span>
                    </button>
                    <div className="flex justify-center">
                      <button
                        type="button"
                        onClick={close}
                        className="text-[10px] tracking-[0.18em] uppercase"
                        style={{color:'var(--ink-soft)', fontWeight:600, cursor:'pointer'}}
                      >Cancel</button>
                    </div>
                  </div>
                </>
              )}
            </div>
          </div>
        );
      })()}
      {refineApplySummary && (
        <div
          className="fixed inset-0 z-[66] flex items-end md:items-center justify-center px-3 py-6"
          style={{background:'rgba(0,0,0,0.55)'}}
          onClick={() => setRefineApplySummary(null)}
        >
          <div
            className="w-full max-w-sm rounded-[20px] overflow-hidden"
            style={{background:'var(--cream)', border: '1px solid var(--line)'}}
            onClick={(e) => e.stopPropagation()}
          >
            <div className="px-5 pt-5 pb-3 border-b" style={{borderColor: 'var(--line)'}}>
              <div className="text-[9px] tracking-[0.26em] uppercase mb-1.5" style={{color:'var(--accent)', fontWeight:600}}>Applied</div>
              <h3 className="text-[18px] leading-tight" style={{color:'var(--ink)', fontWeight:600, letterSpacing:'-0.012em'}}>
                {refineApplySummary.title}
              </h3>
              <p className="text-[11.5px] mt-1.5 leading-snug" style={{color:'var(--ink-soft)'}}>
                Scheduled {refineApplySummary.schedule || 'for this week'}.
              </p>
            </div>
            <div className="px-5 py-4">
              <div className="text-[9px] tracking-[0.22em] uppercase mb-2" style={{color:'var(--ink-soft)', fontWeight:600}}>
                What changed
              </div>
              <div className="space-y-2">
                {(refineApplySummary.productNames || []).slice(0, 4).map((name) => (
                  <div
                    key={name}
                    className="rounded-[14px] border px-3 py-2 text-[12px] leading-snug"
                    style={{borderColor: 'var(--line)', color:'var(--ink)', background:'rgba(255,255,255,0.42)', fontWeight:600}}
                  >
                    {name}
                  </div>
                ))}
                {refineApplySummary.productCount > 4 && (
                  <div className="text-[11px]" style={{color:'var(--ink-soft)'}}>
                    +{refineApplySummary.productCount - 4} more products updated.
                  </div>
                )}
              </div>
            </div>
            <div className="px-5 pb-4 space-y-2">
              <button
                type="button"
                onClick={() => {
                  const targetDay = refineApplySummary.targetDay;
                  const targetSlot = refineApplySummary.targetSlot;
                  setRefineApplySummary(null);
                  if (targetDay !== null && targetDay !== undefined) setWeeklyExpandedDay(targetDay);
                  if (targetSlot) setRotationTargetSlot(String(targetSlot).toLowerCase());
                  setRotationViewMode('day');
                  setActiveTab('regimen');
                  setRegimenView('occasions');
                }}
                className="w-full rounded-full py-3 text-[12px] tracking-[0.08em] uppercase flex items-center justify-center gap-2"
                style={{background:'var(--accent)', color:'white', fontWeight:700}}
              >
                <Icon name="CalendarDays" size={15} /> View in Rotation
              </button>
              <button
                type="button"
                onClick={() => setRefineApplySummary(null)}
                className="w-full rounded-full border py-3 text-[11px] tracking-[0.14em] uppercase"
                style={{borderColor: 'var(--line)', color:'var(--ink-soft)', background:'var(--cream)', fontWeight:700}}
              >
                Stay on page
              </button>
            </div>
          </div>
        </div>
      )}
      {/* === REFINE — START OVER CONFIRMATION (May 2026) ===
          Destructive — clears the user's built routine. Gated behind an
          explicit are-you-sure. On confirm: resets buildAnswers / buildPlan
          / buildPlanAccepted / buildStep, drops the user back into the
          wizard (buildMode='choose' so Step 0 mode picker shows). Does NOT
          touch shelf products or logs — only the cadence/plan state. */}
      {startOverConfirmOpen && (
        <div
          className="fixed inset-0 z-[64] flex items-end md:items-center justify-center px-3 py-6"
          style={{background:'rgba(0,0,0,0.55)'}}
          onClick={() => setStartOverConfirmOpen(false)}
        >
          <div
            className="w-full max-w-sm rounded-[20px] overflow-hidden"
            style={{background:'var(--cream)', border: '1px solid var(--line)'}}
            onClick={(e) => e.stopPropagation()}
          >
            <div className="px-5 pt-5 pb-3 border-b" style={{borderColor: 'var(--line)'}}>
              <div className="text-[9px] tracking-[0.26em] uppercase mb-1.5" style={{color:'var(--accent)', fontWeight:600}}>Fresh start</div>
              <h3 className="text-[18px] leading-tight" style={{color:'var(--ink)', fontWeight:600, letterSpacing:'-0.012em'}}>
                Clear your current routine?
              </h3>
              <p className="text-[11.5px] mt-1.5 leading-snug" style={{color:'var(--ink-soft)'}}>
                Resets your weekly plan and walks you through the build questionnaire again. Your shelf and logs stay intact — only the cadence is cleared.
              </p>
            </div>
            <div className="px-5 py-4 space-y-2">
              <button
                type="button"
                onClick={() => {
                  // Clear cadence on all products (the post-build summary
                  // uses cadence.days to detect "built" state). Strip
                  // cadenceDays and cadence object so userHasBuiltPattern
                  // returns false again.
                  const cleared = (products || []).map(p => {
                    const { cadence, cadenceDays, ...rest } = p;
                    return rest;
                  });
                  setProducts(cleared);
                  saveData('products', cleared).catch(() => {});
                  setBuildAnswers(null);
                  setBuildPlan(null);
                  setBuildPlanAccepted(false);
                  setBuildStep(1);
                  setBuildMode('choose');
                  setStartOverConfirmOpen(false);
                  setRegimenView('build');
                  toast('Cleared. Walk through the build to set a new routine.', 'info');
                }}
                className="w-full rounded-full py-3 px-4 flex items-center justify-center gap-2 transition hover:opacity-90"
                style={{background:'var(--accent)', color:'var(--cream)', border:'1px solid var(--accent)', fontWeight:600, fontSize:13, letterSpacing:'0.04em', cursor:'pointer'}}
              >
                <Icon name="RotateCcw" size={13} />
                <span>Yes, start over</span>
              </button>
              <button
                type="button"
                onClick={() => setStartOverConfirmOpen(false)}
                className="w-full rounded-full py-2.5 px-4 transition hover:bg-[var(--cream-deep)]"
                style={{background:'transparent', color:'var(--ink-soft)', border: '1px solid var(--line)', fontWeight:600, fontSize:12, letterSpacing:'0.04em', cursor:'pointer'}}
              >
                Keep my routine
              </button>
            </div>
          </div>
        </div>
      )}
      {/* === REFINE — HOW IT WORKS (May 2026) ===
          Small explainer sheet — what Refine is, what the three sections
          do, and the propose-don't-alter rule. Plain copy, no controls. */}
      {refineHowItWorks && (
        <div
          className="fixed inset-0 z-[64] flex items-end md:items-center justify-center px-3 py-6"
          style={{background:'rgba(0,0,0,0.55)'}}
          onClick={() => setRefineHowItWorks(false)}
        >
          <div
            className="w-full max-w-md rounded-[20px] overflow-hidden"
            style={{background:'var(--cream)', border: '1px solid var(--line)'}}
            onClick={(e) => e.stopPropagation()}
          >
            <div className="px-5 pt-5 pb-3 border-b" style={{borderColor: 'var(--line)'}}>
              <div className="text-[9px] tracking-[0.26em] uppercase mb-1.5" style={{color:'var(--accent)', fontWeight:600}}>How Refine works</div>
              <h3 className="text-[18px] leading-tight" style={{color:'var(--ink)', fontWeight:600, letterSpacing:'-0.012em'}}>
                Evolve, don't rebuild.
              </h3>
            </div>
            <div className="px-5 py-4 space-y-3 text-[12px] leading-relaxed" style={{color:'var(--ink)'}}>
              <p><strong style={{color:'var(--accent)'}}>Quick Refinements</strong> — pick an intent (e.g. Reduce Irritation), we'll propose specific changes against your current routine. Nothing applies until you accept.</p>
              <p><strong style={{color:'var(--accent)'}}>Evolve Your Routine</strong> — add a product, add a device, log a prescription, or update your goals and sensitivities. Discrete edits, no questionnaire required.</p>
              <p><strong style={{color:'var(--accent)'}}>Reassess Profile</strong> — retake the questionnaire if your skin has shifted meaningfully. Useful seasonally or after a procedure.</p>
              <p style={{color:'var(--ink-soft)'}}>The wizard you originally walked through is still there — tap <em>Start over</em> if you want to clear and rebuild from scratch.</p>
            </div>
            <div className="px-4 py-3 border-t flex justify-end" style={{borderColor: 'var(--line)', background:'var(--cream-deep)'}}>
              <button
                type="button"
                onClick={() => setRefineHowItWorks(false)}
                className="text-[10px] tracking-[0.18em] uppercase"
                style={{color:'var(--ink-soft)', fontWeight:600, cursor:'pointer'}}
              >Got it</button>
            </div>
          </div>
        </div>
      )}
      {showCheckInCamera && (
        <CameraCaptureModal
          angles={['front']}
          multi={true}
          mode="face"
          allowUpload={true}
          onClose={() => setShowCheckInCamera(false)}
          onCapture={(dataUrl, shots) => {
            // === POST-CAPTURE FLOW (May 2026) ===
            // Branch based on cameraDestination:
            //   - 'normal' (daily check-in): populate checkInDetailsQueue
            //     and let CheckInDetailsModal collect rating/chips/notes
            //   - 'onboarding': save log immediately with minimal metadata,
            //     kick analysis (if API key), surface first-read chips
            //     inline on onboarding Step 2 — no details modal interruption
            setShowCheckInCamera(false);
            const nowIso = new Date().toISOString();
            let queue = [];
            if (Array.isArray(shots) && shots.length > 0) {
              queue = shots.map((s, i) => ({
                dataUrl: s.dataUrl,
                capturedAt: s.capturedAt || nowIso,
                source: s.source || 'capture',
                angle: s.angle || (i === 0 ? 'front' : undefined),
              }));
            } else if (dataUrl) {
              queue = [{ dataUrl, capturedAt: nowIso, source: 'capture', angle: 'front' }];
            }
            if (queue.length === 0) {
              // Empty capture (user backed out) — reset destination flag.
              setCameraDestination('normal');
              return;
            }
            // === ONBOARDING PATH ===
            // Save first photo as a log with minimal metadata; ignore
            // additional shots for v1 (analyze first, the rest are
            // recoverable later via Journal "log historical photo").
            if (cameraDestination === 'onboarding') {
              const apiKeyOn = !!getApiKey();
              const firstShot = queue[0];
              const newLog = {
                id: Date.now(),
                date: (firstShot.capturedAt || nowIso).split('T')[0],
                area: 'full-face',
                rating: null,
                notes: '',
                concerns: [],
                photo: firstShot.dataUrl,
                photoPath: null,
                usedProducts: [],
                usedTags: [],
                ratingExplanation: null,
                suggestedRating: null,
                aiAnalysis: null,
                analyzing: apiKeyOn,
                analyzingStartedAt: apiKeyOn ? Date.now() : undefined,
              };
              const updated = [newLog, ...logs];
              setLogs(updated);
              saveData('logs', updated).catch(e => {
                console.warn('[onboarding photo save]', e?.message);
              });
              updateOnboarding({
                photoProvided: true,
                photoDataUrl: firstShot.dataUrl,
                photoSource: firstShot.source === 'upload' ? 'upload' : 'selfie',
                photoLogId: newLog.id,
                photoAnalyzing: apiKeyOn,
                photoChips: null,
              });
              // Kick analysis if API key is present. The chip watcher
              // useEffect below polls onboardingState.photoLogId for
              // metricSnapshot and populates photoChips when it arrives.
              if (apiKeyOn && typeof retryLogAnalysis === 'function') {
                (async () => {
                  try { await retryLogAnalysis(newLog.id, newLog); /* logHint avoids stale-closure miss */ }
                  catch (e) { console.warn('[onboarding auto-analysis]', e?.message); }
                })();
              }
              setCameraDestination('normal');
              return;
            }
            // === NORMAL PATH === daily check-in flow
            setCheckInDetailsQueue(queue);
            setCheckInDetailsIdx(0);
            setCameraDestination('normal');
            return;
          }}
        />
      )}
      {/* === CHECK-IN DETAILS FORM (May 2026 — Phase 2 refinement) ===
          Opens after every camera capture or upload. Lets the user
          adjust date (auto-filled from EXIF/lastModified for uploads),
          set a rating, tap observation chips, and add a free-text
          note before saving. Multi-upload steps through photos one at
          a time; "Skip rest" bulk-saves remaining with their
          auto-filled dates and no extras. */}
      {checkInDetailsQueue.length > 0 && (() => {
        // === BATCH SAVE MODEL (May 2026 — refinement) ===
        // One shared form for ALL photos in the queue. Same date, rating,
        // concerns, and note get stamped onto every photo. Simpler than
        // processing one-by-one — Jenni's call. Each photo still becomes
        // its own log entry, just with identical metadata.
        const queueLen = checkInDetailsQueue.length;
        const saveLogFromForm = (form) => {
          // === Per-photo dates (May 2026 bulk-upload fix) ===
          // Previously every photo in the batch took the FIRST photo's
          // date — destructive for backfill where each photo has its
          // own EXIF date. Now: form.date is the user's "override"
          // applied to the first photo only; every other photo uses its
          // own capturedAt timestamp. Same rating/concerns/notes still
          // apply to all (the "apply to all" behavior that makes bulk
          // upload worthwhile).
          const apiKeyOn = !!getApiKey();
          const userOverrideDate = form.date || null;
          // Per-photo region tags (May 2026 per Jenni). CheckInDetailsModal
          // now ships an aligned array of region ids ('full-face', 'left-cheek',
          // 'right-cheek', 't-zone', 'chin', 'eye-area', 'spot'). Default is 'full-face'
          // so older callers / single-photo flows behave identically.
          const regions = Array.isArray(form.photoRegions) ? form.photoRegions : [];
          const batchRecords = checkInDetailsQueue.map((shot, i) => {
            const photoDate = (() => {
              if (i === 0 && userOverrideDate) return userOverrideDate.split('T')[0];
              const captured = shot.capturedAt || new Date().toISOString();
              return captured.split('T')[0];
            })();
            const isEdit = !!shot.existingLogId;
            const baseLog = isEdit ? (logs.find(l => l.id === shot.existingLogId) || shot.existingLog || {}) : {};
            const log = {
              ...baseLog,
              id: isEdit ? shot.existingLogId : Date.now() + i, // unique per queue item
              date: photoDate,
              area: regions[i] || 'full-face',
              rating: form.rating != null ? form.rating : null,
              notes: form.notes || '',
              concerns: Array.isArray(form.concerns) ? form.concerns : [],
              noticed: Array.isArray(form.noticed) ? form.noticed : [],
              contextFactors: Array.isArray(form.contextFactors) ? form.contextFactors : [],
              angle: shot.angle || baseLog.angle,
              source: shot.source || baseLog.source || 'capture',
              capturedAt: shot.capturedAt || baseLog.capturedAt || new Date().toISOString(),
              photo: shot.dataUrl || shot.photo || baseLog.photo,
              photoPath: shot.photoPath || baseLog.photoPath || null,
              usedProducts: baseLog.usedProducts || [],
              usedTags: baseLog.usedTags || [],
              ratingExplanation: baseLog.ratingExplanation || null,
              suggestedRating: baseLog.suggestedRating || null,
              aiAnalysis: baseLog.aiAnalysis || null,
              analyzing: isEdit ? !!baseLog.analyzing : apiKeyOn,
              analyzingStartedAt: isEdit ? baseLog.analyzingStartedAt : (apiKeyOn ? Date.now() : undefined),
            };
            return { log, isEdit };
          });
          const batch = batchRecords.map(r => r.log);
          const editedIds = new Set(batchRecords.filter(r => r.isEdit).map(r => r.log.id));
          const newLogs = batchRecords.filter(r => !r.isEdit).map(r => r.log);
          const updated = [...batch, ...logs.filter(l => !editedIds.has(l.id))].sort((a, b) => new Date(b.date) - new Date(a.date));
          setLogs(updated);
          setCoverRoutineRebuildToken(t => t + 1);
          saveData('logs', updated).catch(e => {
            console.error('[CheckIn] saveData failed:', e);
            toast(`Save error: ${e?.message || 'unknown'}`, 'error');
          });
          // Cloud upload for each (background — doesn't block UI).
          // === SERIALIZE FIX (May 2026 per Codex) ===
          // Pre-fix: saveData('logs', prev => prev) saved the FUNCTION
          // `prev => prev` as the logs payload. JSON.stringify on a
          // function returns undefined → localStorage key 'logs:<user>'
          // was wiped on the next persist → reload showed an empty
          // journal and the "weird after reload" symptom Jenni hit.
          // Now: use the functional setLogs return to capture the
          // updated array, then persist that array directly.
          if (user?.cloud && user?.id && supabaseClient) {
            newLogs.forEach(log => {
              if (!log.photo) return;
              (async () => {
                const { path, error } = await uploadPhotoToStorage(user.id, log.photo);
                if (path) {
                  setLogs(prev => {
                    const next = prev.map(l => l.id === log.id ? { ...l, photoPath: path, photo: undefined } : l);
                    saveData('logs', next).catch(() => {});
                    return next;
                  });
                } else if (error) {
                  console.warn('[CheckIn] photo cloud upload failed:', error);
                }
              })();
            });
          }
          setCheckInDetailsQueue([]);
          setCheckInDetailsIdx(0);
          // === AUTO-PROMOTE NEW TODAY PHOTO TO MAIN (May 2026 per Jenni) ===
          // Home "Add photo" means "use this as today's current snapshot" unless
          // the user later picks a different one. Keep older AM photos in the
          // timeline, but point both main-photo systems at this fresh log so the
          // cover + Journal Today agree and the new analysis becomes visible.
          let promotedTodayMain = false;
          try {
            const todayKey = localDateISO();
            const todayBatch = batch.filter(l => l.date === todayKey);
            if (todayBatch.length > 0) {
              const mainPhoto = todayBatch.find(l => l.area === 'full-face') || todayBatch[0];
              if (mainPhoto && typeof setDailyCoverPick === 'function') {
                setDailyCoverPick(prev => {
                  const next = { ...(prev || {}), [todayKey]: mainPhoto.id };
                  saveData('dailyCoverPick', next).catch(() => {});
                  return next;
                });
                if (typeof setMainPhotoForDate === 'function') setMainPhotoForDate(todayKey, mainPhoto.id);
                promotedTodayMain = true;
              }
            }
          } catch (e) {
            console.warn('[check-in cover auto-pick]', e?.message);
          }
          toast(
            editedIds.size > 0
              ? 'Check-in updated.'
              : promotedTodayMain
              ? 'Re-check-in saved as today’s main read. Analysis will also appear in Journal.'
              : (queueLen === 1 ? 'Photo logged. Analysis will appear in Journal.' : `${queueLen} photos logged. Analyses will appear in Journal.`),
            'success'
          );
          // === AUTO-FIRE ANALYSIS (May 2026 regression fix) ===
          // Previously the save set analyzing:true but no effect actually
          // RAN the AI call — analysis only happened after a page reload
          // when the boot-scrub flipped analyzing → false and the cover
          // recovery effect fired. Users saw "Photo logged. Tap to
          // generate analysis." indefinitely. Now we kick off retryLogAnalysis
          // for every fresh log immediately after save so the metric chips
          // (redness/hydration/texture/etc.) auto-populate on the cover.
          // Sequential await avoids double-burning Anthropic credits on
          // a multi-photo batch.
          if (apiKeyOn && typeof retryLogAnalysis === 'function') {
            (async () => {
              for (const log of newLogs) {
                try { await retryLogAnalysis(log.id, log); /* logHint avoids stale-closure miss */ }
                catch (e) { console.warn('[CheckIn auto-analysis]', log.id, e?.message); }
              }
            })();
          }
        };
        const cancelQueue = () => {
          setCheckInDetailsQueue([]);
          setCheckInDetailsIdx(0);
        };
        return (
          <CheckInDetailsModal
            photos={checkInDetailsQueue}
            userConcerns={userConcerns}
            onSave={saveLogFromForm}
            onCancel={cancelQueue}
          />
        );
      })()}
      {/* Legacy single-shot save path retained as no-op for compile safety */}
      {false && showCheckInCamera && (
        <CameraCaptureModal
          angles={['front']}
          multi={false}
          mode="face"
          onClose={() => setShowCheckInCamera(false)}
          onCapture={(dataUrl) => {
            if (!dataUrl) { setShowCheckInCamera(false); return; }
            // Friendly confirmation.
            toast('Photo logged ✨', 'success');
            // Trigger background AI analysis if API key configured.
            if (getApiKey()) {
              (async () => {
                try {
                  const recentContext = logs.slice(0, 5).map(l => `${l.date}: ${l.area || 'full-face'} ${l.rating != null ? l.rating + '/10' : ''}`).join('; ') || 'no prior entries';
                  // Reuse the existing photo-analysis prompt path — same flow
                  // as SkinLogModal save uses. The log already has analyzing:true.
                  // (Analysis result populates aiAnalysis + suggestedRating;
                  // the log card will refresh once it's back.)
                  // No-op here — App's existing photo-analyzer effect picks it
                  // up from the analyzing:true flag. If that effect doesn't
                  // exist yet for this pathway, the flag is harmless.
                } catch (e) {
                  console.warn('[CheckIn] background analysis kickoff failed:', e);
                }
              })();
            }
          }}
        />
      )}


      {/* === USE-TODAY PROMPT BANNER (May 2026) ===
          Fires after a new product is saved from Cover or Check-in bridge
          paths (NOT from Today's regimen — that auto-slots). Three chips:
          AM · PM · Later. Auto-dismisses at 8s via the useEffect timer.
          Tapping AM/PM appends the product id to today's regimenLog slot
          and triggers a coverRoutineRebuildToken bump so Today refreshes. */}
      {useTodayPrompt && (() => {
        const slotIntoToday = (slot) => {
          const targetDate = localDateISO();
          const slotKey = slot === 'am' ? 'amProducts' : 'pmProducts';
          const existingLog = (regimenLogs || []).find(r => r.date === targetDate);
          const productId = useTodayPrompt.product.id;
          let updatedLogs;
          if (existingLog) {
            updatedLogs = regimenLogs.map(r => {
              if (r.date !== targetDate) return r;
              const current = r[slotKey] || [];
              const extrasKey = slot === 'am' ? 'amExtras' : 'pmExtras';
              const noteLabel = `${useTodayPrompt.product.name || 'New product'} · added to routine today`;
              return {
                ...r,
                [slotKey]: current.includes(productId) ? current : [...current, productId],
                // Drop a one-time note in today's extras so the journal /
                // weekly rotation surface reads "this was added to your
                // routine on [date]" per Jenni (May 2026).
                [extrasKey]: (r[extrasKey] || []).concat(noteLabel),
                submitted: r.submitted || false,
              };
            });
          } else {
            const extrasKey = slot === 'am' ? 'amExtras' : 'pmExtras';
            const noteLabel = `${useTodayPrompt.product.name || 'New product'} · added to routine today`;
            updatedLogs = [
              ...regimenLogs,
              {
                date: targetDate,
                amProducts: slot === 'am' ? [productId] : [],
                pmProducts: slot === 'pm' ? [productId] : [],
                amExtras: slot === 'am' ? [noteLabel] : [],
                pmExtras: slot === 'pm' ? [noteLabel] : [],
                submitted: false,
                createdAt: new Date().toISOString(),
              },
            ];
          }
          setRegimenLogs(updatedLogs);
          saveData('regimenLogs', updatedLogs).catch(() => {});
          // === EXTEND TO WEEKLY ROUTINE (May 2026 per Jenni) ===
          // "Use today" should also commit the product into the user's
          // weekly routine going forward — without this the product
          // disappears from tomorrow's regimen because its useTimes /
          // cadence are unset. Set useTimes to include the chosen slot,
          // and default cadence.days to all 7 days (daily) unless the
          // product already had a more specific cadence from the AI
          // suggestion path. Existing values are preserved.
          try {
            const productsList = products || [];
            const existingProduct = productsList.find(p => p.id === productId);
            if (existingProduct) {
              // === CENTRALIZED via addProductToRoutine (June 2026 refactor) ===
              const promoted = addProductToRoutine(existingProduct, slot);
              const nextProducts = productsList.map(p => p.id === productId
                ? sanitizeProductForSave(promoted)
                : p
              );
              setProducts(nextProducts);
              saveData('products', nextProducts).catch(() => {});
            }
          } catch (e) {
            console.warn('[useTodayPrompt → routine commit]', e?.message);
          }
          setCoverRoutineRebuildToken(t => t + 1);
          setUseTodayPrompt(null);
          toast(`Added to ${slot.toUpperCase()} routine ✨`, 'success');
        };
        return (
          <div className="fixed top-4 left-1/2 z-40 px-3 max-w-md w-full" style={{transform:'translateX(-50%)'}}>
            <div
              className="rounded-[14px] shadow-lg flex items-center gap-2 px-3 py-2 flex-wrap"
              style={{background:'var(--cream)', border:'1px solid var(--accent)'}}
            >
              <span className="text-[10px] tracking-[0.2em] uppercase flex items-center gap-1.5 flex-1 min-w-0" style={{color:'var(--ink-soft)'}}>
                <Icon name="Check" size={11} style={{color:'var(--accent)'}} />
                <span className="truncate" style={{color:'var(--ink)', fontWeight:600, letterSpacing:'0.05em'}}>Saved</span>
                <span style={{color:'var(--ink-soft)'}}>· add to routine?</span>
              </span>
              <div className="flex gap-1.5 flex-shrink-0">
                <button
                  type="button"
                  onClick={() => slotIntoToday('am')}
                  className="text-[10px] tracking-[0.18em] uppercase px-3 py-1.5 rounded-full transition hover:opacity-90"
                  style={{background:'var(--accent)', color:'var(--cream)', fontWeight:600, cursor:'pointer'}}
                >
                  AM
                </button>
                <button
                  type="button"
                  onClick={() => slotIntoToday('pm')}
                  className="text-[10px] tracking-[0.18em] uppercase px-3 py-1.5 rounded-full transition hover:opacity-90"
                  style={{background:'var(--ink)', color:'var(--cream)', fontWeight:600, cursor:'pointer'}}
                >
                  PM
                </button>
                <button
                  type="button"
                  onClick={() => setUseTodayPrompt(null)}
                  className="text-[10px] tracking-[0.18em] uppercase px-2 py-1.5 transition hover:opacity-70"
                  style={{color:'var(--ink-soft)', fontWeight:600, cursor:'pointer'}}
                >
                  Later
                </button>
              </div>
            </div>
          </div>
        );
      })()}

      {/* === PROMOTE-TO-ROUTINE BANNER (May 2026 per Jenni) ===
          Quiet 8s banner after the user adds a new product to TODAY via
          "Used something else? → Started a new product" on the cover.
          The product is already in today's log; the banner asks whether
          they want it in the standing routine going forward. One CTA
          ("Add to routine") sets the product's cadence to all 7 days +
          useTimes for the slot and routes them to the Regimen tab editor
          so they can adjust cadence per day if they want. "Later" or
          auto-dismiss leaves it as a one-off. */}
      {promoteToRoutinePrompt && (() => {
        // Banner accepts arrays so a single mechanism covers single-save
        // and bulk brand-add. Backward-compat with old callers that may
        // still send { productId } singular.
        const ids = Array.isArray(promoteToRoutinePrompt.productIds)
          ? promoteToRoutinePrompt.productIds
          : (promoteToRoutinePrompt.productId ? [promoteToRoutinePrompt.productId] : []);
        const count = ids.length;
        const subtitle = count > 1 ? `${count} saved · keep going forward?` : 'Saved to today · keep going forward?';
        return (
        <div className="fixed top-4 left-1/2 z-40 px-3 max-w-md w-full" style={{transform:'translateX(-50%)'}}>
          <div
            className="rounded-[14px] shadow-lg flex items-center gap-2 px-3 py-2 flex-wrap"
            style={{background:'var(--cream)', border:'1px solid var(--accent)'}}
          >
            <span className="text-[10px] tracking-[0.2em] uppercase flex items-center gap-1.5 flex-1 min-w-0" style={{color:'var(--ink-soft)'}}>
              <Icon name="Check" size={11} style={{color:'var(--accent)'}} />
              <span className="truncate" style={{color:'var(--ink)', fontWeight:600, letterSpacing:'0.05em'}}>{subtitle}</span>
            </span>
            <div className="flex gap-1.5 flex-shrink-0">
              <button
                type="button"
                onClick={() => {
                  // Promote ALL ids in the banner. For each product, set
                  // useTimes to include the slot and default cadence to
                  // all 7 days (unless the product already had cadence).
                  // Then jump to Regimen → today edit so the user sees
                  // where they landed and can adjust cadence per day.
                  try {
                    const slot = promoteToRoutinePrompt.slot || 'am';
                    const productsList = products || [];
                    // === CENTRALIZED via addManyToRoutine (June 2026 refactor) ===
                    // Was: inline cadence safety check repeated across 4 sites.
                    // Now: single helper enforces suggestedCadence + slot wiring.
                    // sanitizeProductForSave still wraps for storage normalization.
                    const promotedProducts = addManyToRoutine(productsList, ids, slot);
                    const nextProducts = promotedProducts.map(p =>
                      new Set(ids).has(p.id) ? sanitizeProductForSave(p) : p
                    );
                    setProducts(nextProducts);
                    saveData('products', nextProducts).catch(() => {});
                    setCoverRoutineRebuildToken(t => t + 1);
                  } catch (e) {
                    console.warn('[promoteToRoutine commit]', e?.message);
                  }
                  setPromoteToRoutinePrompt(null);
                  setActiveTab('regimen');
                  setRegimenView('today');
                  toast(count > 1 ? `${count} added to your weekly routine ✨` : `Added to your weekly routine ✨`, 'success');
                }}
                className="text-[10px] tracking-[0.18em] uppercase px-3 py-1.5 rounded-full transition hover:opacity-90"
                style={{background:'var(--accent)', color:'var(--cream)', fontWeight:600, cursor:'pointer'}}
              >
                Add to routine
              </button>
              {/* === REFINE OPTION (June 2026 per Jenni) ===
                  Routes the user to Refine with an "I just added a product"
                  intent. After the engine resolves the refined weekly
                  pattern with the new product in place, the result lands
                  in the Rotation view. */}
              <button
                type="button"
                onClick={() => {
                  const productNames = Array.isArray(promoteToRoutinePrompt.productNames)
                    ? promoteToRoutinePrompt.productNames.join(', ')
                    : 'a new product';
                  setRefineIntent && setRefineIntent({
                    id: 'added-product',
                    label: 'Add + refine',
                    prompt: `I just added ${productNames} to my shelf. Refine my weekly routine to fold it in — pick the right days, adjust cadence on competing actives, and show me the result in the Rotation view.`,
                  });
                  setPromoteToRoutinePrompt(null);
                  setActiveTab('regimen');
                  setRegimenView('build');
                }}
                className="text-[10px] tracking-[0.18em] uppercase px-3 py-1.5 rounded-full transition hover:bg-[var(--cream-deep)]"
                style={{background:'transparent', color:'var(--accent)', border:'1px solid var(--accent)', fontWeight:600, cursor:'pointer'}}
              >
                Refine
              </button>
              <button
                type="button"
                onClick={() => setPromoteToRoutinePrompt(null)}
                className="text-[10px] tracking-[0.18em] uppercase px-2 py-1.5 transition hover:opacity-70"
                style={{color:'var(--ink-soft)', fontWeight:600, cursor:'pointer'}}
              >
                Later
              </button>
            </div>
          </div>
        </div>
        );
      })()}

      {/* === PROCEDURE REBUILD PROMPT (June 2026 per Jenni) ===
          Fired after a procedure logs successfully. Asks if the user
          wants to rebuild their routine around the procedure. Post-
          procedure skin needs gentler actives + careful sequencing,
          so this routes to Refine with a procedure-aware intent. */}
      {procedureRebuildPrompt && (
        <div className="fixed top-4 left-1/2 z-40 px-3 max-w-md w-full" style={{transform:'translateX(-50%)'}}>
          <div
            className="rounded-[14px] shadow-lg flex items-center gap-2 px-3 py-2 flex-wrap"
            style={{background:'var(--cream)', border:'1px solid var(--accent)'}}
          >
            <span className="text-[10px] tracking-[0.2em] uppercase flex items-center gap-1.5 flex-1 min-w-0" style={{color:'var(--ink-soft)'}}>
              <Icon name="Sparkles" size={11} style={{color:'var(--accent)'}} />
              <span className="truncate" style={{color:'var(--ink)', fontWeight:600, letterSpacing:'0.05em'}}>
                {procedureRebuildPrompt.name ? `${procedureRebuildPrompt.name} logged · refine routine?` : 'Procedure logged · refine routine?'}
              </span>
            </span>
            <div className="flex gap-1.5 flex-shrink-0">
              <button
                type="button"
                onClick={() => {
                  const procName = procedureRebuildPrompt?.name || 'procedure';
                  setRefineIntent({
                    id: 'post-procedure',
                    label: `Post-${procName}`,
                    prompt: `I just had ${procName}. Adjust my routine for recovery: drop actives that compete with healing, lean on hydration + barrier support, time anything irritating away from the procedure window.`,
                  });
                  setProcedureRebuildPrompt(null);
                  setActiveTab('regimen');
                  setRegimenView('build');
                }}
                className="text-[10px] tracking-[0.18em] uppercase px-3 py-1.5 rounded-full transition hover:opacity-90"
                style={{background:'var(--accent)', color:'var(--cream)', fontWeight:600, cursor:'pointer'}}
              >
                Refine
              </button>
              <button
                type="button"
                onClick={() => setProcedureRebuildPrompt(null)}
                className="text-[10px] tracking-[0.18em] uppercase px-2 py-1.5 transition hover:opacity-70"
                style={{color:'var(--ink-soft)', fontWeight:600, cursor:'pointer'}}
              >
                Skip
              </button>
            </div>
          </div>
        </div>
      )}

      {/* === POST-SAVE SUGGESTION BANNER === */}
      {/* Floats top-center after a SkinLog save. Suggests procedure or product start
          for items the user did NOT log inline via the chip rail in the modal. */}
      {postSaveSuggestion && (
        <div className="fixed top-4 left-1/2 z-40 px-3 max-w-md w-full" style={{transform:'translateX(-50%)'}}>
          <div className="border shadow-lg flex items-center gap-2 px-3 py-2 flex-wrap" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
            <span className="text-[10px] tracking-[0.2em] uppercase flex items-center gap-1.5" style={{color:'var(--ink-soft)'}}>
              <Icon name="Check" size={11} style={{color:'var(--accent)'}} />
              Saved · also today?
            </span>
            <div className="flex gap-1.5 flex-wrap">
              {postSaveSuggestion.suggestProcedure && (
                <button
                  onClick={() => {
                    setPostSaveSuggestion(null);
                    setShowProcedureModal(true);
                  }}
                  className="text-[10px] tracking-[0.15em] uppercase italic px-2 py-1 border rounded-full transition hover:bg-[var(--cream-deep)]"
                  style={{borderColor: 'var(--line)', color:'var(--ink)'}}
                >
                  + procedure
                </button>
              )}
              {postSaveSuggestion.suggestProductStart && (
                <button
                  onClick={() => {
                    setPostSaveSuggestion(null);
                    setShowProductModal(true);
                  }}
                  className="text-[10px] tracking-[0.15em] uppercase italic px-2 py-1 border rounded-full transition hover:bg-[var(--cream-deep)]"
                  style={{borderColor: 'var(--line)', color:'var(--ink)'}}
                >
                  + product start
                </button>
              )}
            </div>
            <button
              onClick={() => setPostSaveSuggestion(null)}
              className="ml-auto p-1 transition hover:opacity-60"
              style={{color:'var(--ink-soft)'}}
              title="Dismiss"
            >
              <Icon name="X" size={11} />
            </button>
          </div>
        </div>
      )}
      {/* === JOURNAL DAY DETAIL === opens when user taps a day in the compact journal calendar/photo row. */}
      {journalDayDetail && (() => {
        const iso = journalDayDetail;
        const dayLogs = logs.filter(l => l.date === iso).sort((a, b) => (b.id || 0) - (a.id || 0));
        const reg = (regimenLogs || []).find(r => r.date === iso);
        const procs = (procedures || []).filter(p => p.date === iso);
        const newProds = (products || []).filter(p => p.startDate === iso);
        const fmt = new Date(iso).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
        const close = () => setJournalDayDetail(null);
        return (
          <Modal title={fmt} onClose={close}>
            <div className="space-y-5">
              {dayLogs.length === 0 && procs.length === 0 && newProds.length === 0 && !reg && (
                <p className="font-serif italic text-base text-center py-6" style={{color:'var(--ink-soft)'}}>Quiet day. Nothing logged.</p>
              )}
              {/* Photos */}
              {dayLogs.length > 0 && (
                <div>
                  <div className="text-[10px] tracking-[0.25em] uppercase mb-2" style={{color:'var(--ink-soft)'}}>Photos · {dayLogs.length}</div>
                  <div className="grid grid-cols-2 gap-3">
                    {dayLogs.map(l => (
                      <div key={l.id} className="border" style={{borderColor: 'var(--line)', background:'var(--cream)'}}>
                        {(l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:'))) ? (
                          <div className="aspect-square overflow-hidden" style={{background:'var(--cream-deep)'}}>
                            <Photo item={l} alt="" className="w-full h-full object-cover" />
                          </div>
                        ) : (
                          <div className="aspect-square flex items-center justify-center" style={{background:'var(--cream-deep)'}}>
                            <span className="font-serif italic text-5xl" style={{color:'var(--ink-soft)'}}>{l.rating}</span>
                          </div>
                        )}
                        <div className="px-3 py-2.5">
                          <div className="flex items-baseline justify-between gap-2">
                            <span className="font-serif italic text-base" style={{color:'var(--ink)'}}>{(l.area || 'full-face').replace(/-/g, ' ')}</span>
                            <span className="font-serif italic text-lg" style={{color:'var(--accent)'}}>{l.rating}<span className="text-[10px]" style={{color:'var(--ink-soft)'}}>/10</span></span>
                          </div>
                          {(l.concerns || []).length > 0 && (
                            <div className="text-xs font-light mt-1" style={{color:'var(--ink-soft)'}}>{l.concerns.join(' · ')}</div>
                          )}
                          {l.notes && <p className="text-xs italic mt-1.5 leading-snug" style={{color:'var(--ink)'}}>"{l.notes}"</p>}
                          {(l.aiAnalysis || l.ratingExplanation) && (
                            <p className="font-serif italic text-xs mt-2 leading-relaxed line-clamp-3" style={{color:'var(--ink)'}}>{(l.aiAnalysis || l.ratingExplanation).slice(0, 220)}…</p>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {/* Regimen check-in */}
              {reg && (
                <div className="border-t pt-4" style={{borderColor: 'var(--line)'}}>
                  <div className="text-[10px] tracking-[0.25em] uppercase mb-2" style={{color:'var(--ink-soft)'}}>Regimen</div>
                  <div className="text-sm font-light leading-relaxed" style={{color:'var(--ink)'}}>
                    {reg.amProducts?.length > 0 && (
                      <div><span className="font-serif italic text-xs" style={{color:'var(--ink-soft)'}}>AM · </span>{(reg.amProducts || []).map(id => products.find(p => p.id === id)?.name).filter(Boolean).join(', ')}</div>
                    )}
                    {reg.pmProducts?.length > 0 && (
                      <div><span className="font-serif italic text-xs" style={{color:'var(--ink-soft)'}}>PM · </span>{(reg.pmProducts || []).map(id => products.find(p => p.id === id)?.name).filter(Boolean).join(', ')}</div>
                    )}
                    {(reg.devices?.length > 0) && (
                      <div className="text-xs italic mt-1" style={{color:'var(--ink-soft)'}}>devices · {(reg.devices || []).join(', ')}</div>
                    )}
                  </div>
                </div>
              )}
              {/* Procedures + new products */}
              {procs.length > 0 && (
                <div className="border-t pt-4" style={{borderColor: 'var(--line)'}}>
                  <div className="text-[10px] tracking-[0.25em] uppercase mb-2" style={{color:'var(--ink-soft)'}}>Procedure</div>
                  {procs.map(p => (
                    <div key={p.id} className="text-sm font-light" style={{color:'var(--ink)'}}>
                      <span className="font-serif italic">{p.name}</span> {p.type ? <span className="text-xs italic" style={{color:'var(--ink-soft)'}}>· {p.type}</span> : null}
                    </div>
                  ))}
                </div>
              )}
              {newProds.length > 0 && (
                <div className="border-t pt-4" style={{borderColor: 'var(--line)'}}>
                  <div className="text-[10px] tracking-[0.25em] uppercase mb-2" style={{color:'var(--ink-soft)'}}>Started this day</div>
                  <div className="text-sm font-light" style={{color:'var(--ink)'}}>
                    {newProds.map(p => p.name).join(', ')}
                  </div>
                </div>
              )}
            </div>
          </Modal>
        );
      })()}
      {/* === PRODUCT COMPARE === before/after for a single product, shared by shelf + Compare tab. */}
      {productCompareId && (() => {
        const product = products.find(p => p.id === productCompareId);
        if (!product) return null;
        const a = findProductCompareAnchors(product, products, regimenLogs, logs);
        const fmt = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
        const close = () => setProductCompareId(null);
        const slugify = (s) => (s || 'product').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        const handleExport = async (e) => {
          const card = e.currentTarget.closest('.export-target');
          if (!card) { toast('Couldn’t find the card to export', 'error'); return; }
          try {
            await exportNodeAsJpg(card, `etude-compare-${slugify(product.name)}`);
            toast('Saved to your downloads', 'success');
          } catch (err) {
            toast(err?.message || 'Export failed', 'error');
          }
        };
        return (
          <Modal
            eyebrow="Compare · product"
            title={`${product.name} · before & after`}
            onClose={close}
            action={handleExport}
            actionLabel="Export"
          >
            <div className="space-y-5 export-target" style={{background:'var(--cream)'}}>
              {/* Lede — what we're comparing and over what window. */}
              <div className="text-[10px] tracking-[0.25em] uppercase" style={{color:'var(--ink-soft)'}}>
                {a.startSource === 'explicit' ? 'Started' : a.startSource === 'regimen' ? 'First in routine' : 'First photo-tagged'} {fmt(a.startDate)}
                {a.daysActive != null && <span> · {a.daysActive} {a.daysActive === 1 ? 'day' : 'days'} of usage data</span>}
              </div>
              {!a.hasEnoughData ? (
                <div className="border p-8 text-center" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                  <Icon name="Hourglass" size={28} className="mx-auto mb-3 opacity-40" />
                  <p className="font-serif italic text-base mb-1" style={{color:'var(--ink)'}}>Not enough data yet</p>
                  <p className="text-sm font-light italic" style={{color:'var(--ink-soft)'}}>{a.reasonShort || 'Log more photos to see a comparison.'}</p>
                </div>
              ) : (
                <>
                  <div className="grid grid-cols-2 gap-3 md:gap-4">
                    {/* BEFORE */}
                    <div className="border" style={{borderColor: 'var(--line)', background:'var(--cream)'}}>
                      <div className="aspect-square overflow-hidden" style={{background:'var(--cream-deep)'}}>
                        <Photo item={a.anchorPhotoLog} alt="" className="w-full h-full object-cover"
                          renderFallback={() => <div className="w-full h-full flex items-center justify-center"><span className="font-serif italic text-5xl" style={{color:'var(--ink-soft)'}}>{a.anchorPhotoLog.rating}</span></div>}
                        />
                      </div>
                      <div className="px-3 py-2.5">
                        <div className="text-[10px] tracking-[0.25em] uppercase mb-0.5" style={{color:'var(--accent)'}}>Before</div>
                        <div className="font-serif italic text-base" style={{color:'var(--ink)'}}>{fmt(a.anchorPhotoLog.date)}</div>
                        <div className="text-xs font-light" style={{color:'var(--ink-soft)'}}>
                          {(a.anchorPhotoLog.area || 'full-face').replace(/-/g, ' ')} · {a.anchorPhotoLog.rating}/10
                        </div>
                      </div>
                    </div>
                    {/* AFTER */}
                    <div className="border" style={{borderColor: 'var(--line)', background:'var(--cream)'}}>
                      <div className="aspect-square overflow-hidden" style={{background:'var(--cream-deep)'}}>
                        <Photo item={a.latestPhotoLog} alt="" className="w-full h-full object-cover"
                          renderFallback={() => <div className="w-full h-full flex items-center justify-center"><span className="font-serif italic text-5xl" style={{color:'var(--ink-soft)'}}>{a.latestPhotoLog.rating}</span></div>}
                        />
                      </div>
                      <div className="px-3 py-2.5">
                        <div className="text-[10px] tracking-[0.25em] uppercase mb-0.5" style={{color:'var(--accent)'}}>After · today</div>
                        <div className="font-serif italic text-base" style={{color:'var(--ink)'}}>{fmt(a.latestPhotoLog.date)}</div>
                        <div className="text-xs font-light" style={{color:'var(--ink-soft)'}}>
                          {(a.latestPhotoLog.area || 'full-face').replace(/-/g, ' ')} · {a.latestPhotoLog.rating}/10
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* Metric infographic — same visual as Quick + Procedure tabs. */}
                  <CompareMetricInfographic
                    before={a.anchorPhotoLog}
                    after={a.latestPhotoLog}
                    ratingDelta={Number(a.latestPhotoLog.rating) - Number(a.anchorPhotoLog.rating)}
                    daysApart={Math.abs(Math.floor((new Date(a.latestPhotoLog.date) - new Date(a.anchorPhotoLog.date)) / 86400000))}
                  />

                  {/* AI analysis — same shape as Quick/Procedure analysis cards. */}
                  {(() => {
                    const prodKey = `${a.anchorPhotoLog.id}-${a.latestPhotoLog.id}`;
                    const prodCached = compareTimeAnalysis[prodKey];
                    return (
                      <EditorialCard>
                        <div className="text-[10px] tracking-[0.3em] uppercase mb-3 flex items-center gap-2" style={{color:'var(--accent)'}}>
                          <Icon name="Sparkles" size={11} style={{color:'var(--accent)'}} /> Frida analysis
                        </div>
                        {prodCached ? (
                          <>
                            <TaggedAnalysisBullets
                              text={formatAnalysisText(prodCached)}
                              onOpen={setOpenLesson}
                              IconComponent={Icon}
                              withPearlsFn={withPearls}
                            />
                            <button onClick={() => runComparePairAnalysisShared(a.anchorPhotoLog, a.latestPhotoLog)} disabled={compareTimeAnalyzing} className="mt-3 text-[10px] tracking-[0.2em] uppercase italic flex items-center gap-1.5" style={{color:'var(--ink-soft)'}}>
                              {compareTimeAnalyzing ? <><Icon name="Loader2" size={11} className="spin" /> Re-running</> : <>Refresh analysis</>}
                            </button>
                          </>
                        ) : compareTimeAnalyzing ? (
                          <p className="font-serif italic text-sm flex items-center gap-2" style={{color:'var(--ink-soft)'}}>
                            <Icon name="Loader2" size={13} className="spin" style={{color:'var(--accent)'}} /> Reading the difference…
                          </p>
                        ) : !getApiKey() ? (
                          <button onClick={() => setShowApiKeyModal(true)} className="text-[11px] tracking-[0.18em] uppercase italic flex items-center gap-1.5 transition hover:opacity-70" style={{color:'var(--accent)'}}>
                            <Icon name="Key" size={11} /> Add API key to analyze
                          </button>
                        ) : (
                          <button onClick={() => runComparePairAnalysisShared(a.anchorPhotoLog, a.latestPhotoLog)} className="text-[11px] tracking-[0.18em] uppercase italic flex items-center gap-1.5 transition hover:opacity-70" style={{color:'var(--accent)'}}>
                            <Icon name="Sparkles" size={11} /> Analyze {product.name}'s impact
                          </button>
                        )}
                      </EditorialCard>
                    );
                  })()}

                  {/* Discuss in Counsel */}
                  <button
                    onClick={() => {
                      const ctx = `Comparing skin from ${fmt(a.anchorPhotoLog.date)} (${a.anchorPhotoLog.rating}/10) — when ${product.name} entered my routine — to ${fmt(a.latestPhotoLog.date)} (${a.latestPhotoLog.rating}/10).\n\nProduct: ${product.name} by ${product.brand || 'unknown'}, actives: ${product.activeIngredients || 'unknown'}.\nDays of usage data: ${a.daysActive}. Photos in window: ${a.photoCount}.`;
                      openChat({
                        context: ctx,
                        title: `${product.name} · ${a.daysActive}d`,
                        subtitle: 'Product progress',
                        suggestions: [
                          'Is this product working for me?',
                          'What pattern do you see?',
                          'Should I keep using it or switch?',
                          'What would you compare it to?',
                        ],
                      });
                      close();
                    }}
                    className="w-full py-2.5 tracking-[0.2em] text-[11px] uppercase transition flex items-center justify-center gap-2"
                    style={{background:'var(--ink)', color:'var(--cream)'}}
                  >
                    <Icon name="MessageCircle" size={12} /> Discuss with Counsel
                  </button>
                </>
              )}
            </div>
          </Modal>
        );
      })()}
      {/* === COMPARE TIME PICKER === handles either side (Before or After) on the Time tab. */}
      {compareTimePickerFor && (() => {
        const side = compareTimePickerFor; // 'before' | 'after'
        const allPhotoLogs = logs.filter(l => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:')))
          .sort((a, b) => new Date(b.date) - new Date(a.date));
        const fmt = (d) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        const close = () => setCompareTimePickerFor(null);
        const currentId = side === 'before' ? compareTimeBeforeId : compareTimeAfterId;
        return (
          <Modal eyebrow="Compare" title={side === 'before' ? 'Pick the "before" photo' : 'Pick the "after" photo'} onClose={close}>
            <div className="space-y-4">
              <p className="text-sm font-light italic" style={{color:'var(--ink-soft)'}}>
                {side === 'before' ? 'Choose any photo from your timeline as the earlier comparison anchor.' : 'Choose any photo as the later comparison anchor — defaults to today.'}
              </p>
              {allPhotoLogs.length === 0 ? (
                <p className="font-serif italic text-base text-center py-6" style={{color:'var(--ink-soft)'}}>No photos in your journal yet.</p>
              ) : (
                <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                  {allPhotoLogs.map(l => {
                    const picked = currentId === l.id;
                    return (
                      <button
                        key={l.id}
                        onClick={() => {
                          if (side === 'before') setCompareTimeBeforeId(l.id);
                          else setCompareTimeAfterId(l.id);
                          close();
                        }}
                        className="border overflow-hidden text-left transition hover:opacity-90"
                        style={{borderColor: picked ? 'var(--accent)' : 'var(--line)', background:'var(--cream)', boxShadow: picked ? '0 0 0 2px var(--accent-soft)' : 'none'}}
                      >
                        <div className="relative aspect-square">
                          <Photo item={l} alt="" className="w-full h-full object-cover" />
                          {picked && (
                            <span className="absolute bottom-1.5 right-1.5 w-5 h-5 rounded-full flex items-center justify-center" style={{background:'var(--accent)', color:'var(--cream)'}}>
                              <Icon name="Check" size={11} />
                            </span>
                          )}
                        </div>
                        <div className="px-2 py-1.5">
                          <div className="font-serif italic text-sm leading-tight" style={{color:'var(--ink)'}}>{fmt(l.date)}</div>
                          <div className="text-[10px] font-light" style={{color:'var(--ink-soft)'}}>{(l.area || 'full-face').replace(/-/g, ' ')} · {l.rating}/10</div>
                        </div>
                      </button>
                    );
                  })}
                </div>
              )}
              {/* Reset link — only on After side, reverts to today's default */}
              {side === 'after' && compareTimeAfterId && (
                <button
                  onClick={() => { setCompareTimeAfterId(null); close(); }}
                  className="text-[10px] tracking-[0.2em] uppercase italic flex items-center gap-1.5"
                  style={{color:'var(--ink-soft)'}}
                ><Icon name="RotateCcw" size={11} /> Reset to today's photo</button>
              )}
            </div>
          </Modal>
        );
      })()}
      {/* === COVER PICKER === lets the user elevate a non-full-face photo to be that day's hero. */}
      {showCoverPickerForDate && (() => {
        const date = showCoverPickerForDate;
        const candidates = logs
          .filter(l => l.date === date && (l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:'))))
          .sort((a, b) => (b.id || 0) - (a.id || 0));
        const currentPick = dailyCoverPick[date];
        return (
          <Modal eyebrow="Cover" title="Choose today's photo" onClose={() => setShowCoverPickerForDate(null)}>
            <div className="space-y-4">
              <p className="text-sm font-light italic" style={{color:'var(--ink-soft)'}}>
                Cover and timeline default to the full-face photo. Pick a different angle to use as today's view.
              </p>
              {candidates.length === 0 ? (
                <p className="font-serif italic text-base text-center py-6" style={{color:'var(--ink-soft)'}}>No photos for this day yet.</p>
              ) : (
                <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                  {candidates.map(l => {
                    const isFullFace = l.area === 'full-face';
                    const isPicked = currentPick === l.id || (!currentPick && isFullFace && candidates.find(c => c.area === 'full-face' && c.id === candidates.filter(x => x.area === 'full-face').sort((a,b)=>(b.id||0)-(a.id||0))[0]?.id)?.id === l.id);
                    return (
                      <button
                        key={l.id}
                        onClick={() => {
                          // If user picks the default full-face, clear the override (canonical default).
                          // Otherwise set this entry as the override for that date.
                          const next = { ...dailyCoverPick };
                          if (isFullFace && candidates.filter(c => c.area === 'full-face').sort((a,b)=>(b.id||0)-(a.id||0))[0]?.id === l.id) {
                            delete next[date];
                          } else {
                            next[date] = l.id;
                          }
                          setDailyCoverPick(next);
                          saveData('dailyCoverPick', next);
                          if (typeof setMainPhotoForDate === 'function') setMainPhotoForDate(date, l.id);
                          setShowCoverPickerForDate(null);
                          toast(isFullFace ? 'Showing full-face' : `Showing ${l.area.replace(/-/g, ' ')}`);
                        }}
                        className="border overflow-hidden text-left transition hover:opacity-90"
                        style={{borderColor: isPicked ? 'var(--accent)' : 'var(--line)', background:'var(--cream)', boxShadow: isPicked ? '0 0 0 2px var(--accent-soft)' : 'none'}}
                      >
                        <div className="relative aspect-square">
                          <Photo item={l} alt="" className="w-full h-full object-cover" />
                          {isFullFace && (
                            <span className="absolute top-1.5 left-1.5 text-[9px] tracking-[0.2em] uppercase px-1.5 py-0.5" style={{background:'rgba(250,250,246,0.92)', color:'var(--accent)'}}>Default</span>
                          )}
                          {isPicked && (
                            <span className="absolute bottom-1.5 right-1.5 w-5 h-5 rounded-full flex items-center justify-center" style={{background:'var(--accent)', color:'var(--cream)'}}>
                              <Icon name="Check" size={11} />
                            </span>
                          )}
                        </div>
                        <div className="px-2 py-1.5 flex items-baseline justify-between gap-2">
                          <span className="font-sans text-[10px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)'}}>{l.area.replace(/-/g, ' ')}</span>
                          <span className="font-serif italic text-sm" style={{color:'var(--accent)'}}>{l.rating}<span className="text-[10px]" style={{color:'var(--ink-soft)'}}>/10</span></span>
                        </div>
                      </button>
                    );
                  })}
                </div>
              )}
              {currentPick && (
                <button
                  onClick={() => {
                    const next = { ...dailyCoverPick };
                    delete next[date];
                    setDailyCoverPick(next);
                    saveData('dailyCoverPick', next);
                    if (typeof setMainPhotoForDate === 'function') setMainPhotoForDate(date, null);
                    setShowCoverPickerForDate(null);
                    toast('Reset to full-face default');
                  }}
                  className="text-[10px] tracking-[0.2em] uppercase italic flex items-center gap-1.5"
                  style={{color:'var(--ink-soft)'}}
                >
                  <Icon name="RotateCcw" size={11} /> Reset to full-face default
                </button>
              )}
            </div>
          </Modal>
        );
      })()}
      {showProductModal && (
        <ProductModal
          logs={logs}
          products={products}
          setProducts={setProducts}
          regimenLogs={regimenLogs}
          setRegimenLogs={setRegimenLogs}
          user={user}
          editingProductId={editingProductId}
          setEditingProductId={setEditingProductId}
          productForm={productForm}
          setProductForm={setProductForm}
          productModalRegimenContext={productModalRegimenContext}
          addMenuReturnContext={addMenuReturnContext}
          onReturnToAddMenu={returnToAddMenu}
          setProductModalRegimenContext={setProductModalRegimenContext}
          setShowProductModal={setShowProductModal}
          setShowApiKeyModal={setShowApiKeyModal}
          setCoverRoutineRebuildToken={setCoverRoutineRebuildToken}
          setActiveTab={setActiveTab}
          setRegimenView={setRegimenView}
          ritualForm={ritualForm}
          ritualFormRef={ritualFormRef}
          setRitualForm={setRitualForm}
          modalScrollMemo={modalScrollMemo}
          useModalScrollPreserve={useModalScrollPreserve}
          callClaude={callClaude}
          saveData={saveData}
          toast={toast}
          onboardingState={onboardingState}
          brandSelectedKeys={brandSelectedKeys}
          setBrandSelectedKeys={setBrandSelectedKeys}
          bypassDupeCheckRef={bypassDupeCheckRef}
          callGeminiVision={callGeminiVision}
          cleanProductPhotoWithGemini={cleanProductPhotoWithGemini}
          productBrandCatFilter={productBrandCatFilter}
          setProductBrandCatFilter={setProductBrandCatFilter}
          productBrandSelected={productBrandSelected}
          setProductBrandSelected={setProductBrandSelected}
          setProductBrandSearch={setProductBrandSearch}
          productDeepFilling={productDeepFilling}
          setProductDeepFilling={setProductDeepFilling}
          productDetected={productDetected}
          setProductDetected={setProductDetected}
          productDupeWarning={productDupeWarning}
          setProductDupeWarning={setProductDupeWarning}
          productEntryMode={productEntryMode}
          setProductEntryMode={setProductEntryMode}
          productHasSearched={productHasSearched}
          setProductHasSearched={setProductHasSearched}
          productNameSearching={productNameSearching}
          setProductNameSearching={setProductNameSearching}
          productNameSuggestions={productNameSuggestions}
          setProductNameSuggestions={setProductNameSuggestions}
          productNeedsLabelHelp={productNeedsLabelHelp}
          setProductNeedsLabelHelp={setProductNeedsLabelHelp}
          productReadingLabel={productReadingLabel}
          setProductReadingLabel={setProductReadingLabel}
          productSaveFlash={productSaveFlash}
          setProductSaveFlash={setProductSaveFlash}
          productScanBatch={productScanBatch}
          setProductScanBatch={setProductScanBatch}
          productScanBatchProgress={productScanBatchProgress}
          setProductScanBatchProgress={setProductScanBatchProgress}
          productScanError={productScanError}
          setProductScanError={setProductScanError}
          productScanPhoto={productScanPhoto}
          setProductScanPhoto={setProductScanPhoto}
          productScanning={productScanning}
          setProductScanning={setProductScanning}
          productSearchError={productSearchError}
          setProductSearchError={setProductSearchError}
          productSearchInput={productSearchInput}
          setProductSearchInput={setProductSearchInput}
          productSearchInputResetKey={productSearchInputResetKey}
          setProductSearchInputResetKey={setProductSearchInputResetKey}
          productUrlFetchError={productUrlFetchError}
          setProductUrlFetchError={setProductUrlFetchError}
          productUrlFetching={productUrlFetching}
          setProductUrlFetching={setProductUrlFetching}
          setExpandedShelfProductId={setExpandedShelfProductId}
          setUseTodayPrompt={setUseTodayPrompt}
          setPromoteToRoutinePrompt={setPromoteToRoutinePrompt}
        />
      )}
      {/* AddProductFlowModal placeholder retired — the consolidated
          ProductModal (above) handles all add-product entry points
          including scan, search, brand-browse, and shelf-pick. The
          earlier separate "flow modal" concept was rolled into
          ProductModal's entryMode states. State variables that were
          previously wired for it are now unused but left in place
          (harmless) until a wider cleanup pass. */}
      {showCheckInModal && (
        <TodayRitualModal
          regimenLogs={regimenLogs}
          setRegimenLogs={setRegimenLogs}
          products={products}
          ritualViewDate={ritualViewDate}
          generatedProductArt={{}}
          ritualForm={ritualForm}
          setRitualForm={setRitualForm}
          ritualFormRef={ritualFormRef}
          ritualSlot={ritualSlot}
          setRitualSlot={userSetRitualSlot}
          editRegimenShelfOpen={editRegimenShelfOpen}
          setEditRegimenShelfOpen={setEditRegimenShelfOpen}
          editRegimenShelfSelected={editRegimenShelfSelected}
          setEditRegimenShelfSelected={setEditRegimenShelfSelected}
          editRegimenShelfSearch={editRegimenShelfSearch}
          setEditRegimenShelfSearch={setEditRegimenShelfSearch}
          editRegimenShelfFilter={editRegimenShelfFilter}
          setEditRegimenShelfFilter={setEditRegimenShelfFilter}
          somethingElseInput={somethingElseInput}
          setSomethingElseInput={setSomethingElseInput}
          somethingElsePromptOpen={somethingElsePromptOpen}
          setSomethingElsePromptOpen={setSomethingElsePromptOpen}
          setShowCheckInModal={setShowCheckInModal}
          setShowProductModal={setShowProductModal}
          setShowProcedureModal={setShowProcedureModal}
          setProductModalRegimenContext={setProductModalRegimenContext}
          setProductForm={setProductForm}
          setCoverRoutineRebuildToken={setCoverRoutineRebuildToken}
          lastArtSyncRef={lastArtSyncRef}
          toast={toast}
          saveData={saveData}
          generateProductArtForAll={generateProductArtForAll}
          userProfile={userProfile}
        />
      )}
      {/* === CONFLICT OVERRIDE PROMPT ===
          Surfaces when a user tries to add a product that conflicts (HARD
          tier) with something already scheduled in the same AM/PM slot for
          today. Snarky Tang & Gainey copy + explicit Override path. The
          prompt is the gate, not a block — we don't refuse the action, we
          name what's happening and let the user proceed. */}
      {pendingConflict && (() => {
        const { product, slot, conflictWith, note, commit } = pendingConflict;
        // Snarky one-liner pool, picked by family pair. Falls through to a
        // generic snark if we don't have a custom line for the pairing.
        const a = detectActiveFamily(product?.activeIngredients || product?.actives || '');
        const b = conflictWith ? detectActiveFamily(conflictWith.activeIngredients || conflictWith.actives || '') : null;
        const pair = [a, b].sort().join('+');
        const SNARK_LINES = {
          'aha+retinoid':     "Retinoid and an acid the same night? Bold. Your barrier will let you know by Wednesday.",
          'bha+retinoid':     "Retinoid and BHA same night. The cumulative burn isn't a vibe.",
          'aha+bha':          "Two acids same night. Pick your favorite — the other can wait a day.",
          'bpo+retinoid':     "Benzoyl peroxide deactivates most retinoids on contact. So one of them is doing nothing.",
          'bpo+vitc':         "Vitamin C plus BPO. They literally cancel each other out. Split AM/PM at minimum.",
        };
        const snark = SNARK_LINES[pair] || "These two compete for the same skin tonight. Worth alternating — but you do you.";
        return (
          <div className="fixed inset-0 z-[80] flex items-center justify-center px-5" style={{background:'rgba(28,25,23,0.5)', backdropFilter:'blur(4px)'}} onClick={() => setPendingConflict(null)}>
            <div onClick={e => e.stopPropagation()} className="w-full max-w-[420px] rounded-[16px] px-5 py-5" style={{background:'var(--cream)', border: '1px solid var(--line)', boxShadow:'0 12px 32px -8px rgba(28,25,23,0.20)'}}>
              <div className="flex items-baseline justify-between mb-3">
                <div className="text-[9.5px] tracking-[0.32em] uppercase" style={{color:'var(--rose)', fontWeight:600}}>Heads up</div>
                <button onClick={() => setPendingConflict(null)} className="w-6 h-6 rounded-full flex items-center justify-center" style={{color:'var(--ink-soft)'}} aria-label="Close">
                  <Icon name="X" size={11} />
                </button>
              </div>
              <h3 className="text-[17px] leading-tight mb-2" style={{color:'var(--ink)', fontWeight:600, letterSpacing:'-0.012em'}}>{snark}</h3>
              {note && (
                <p className="text-[11.5px] leading-relaxed mb-4" style={{color:'var(--ink-soft)'}}>{note}</p>
              )}
              <div className="text-[10.5px] tracking-[0.05em] mb-4 px-3 py-2 rounded-[10px]" style={{background:'var(--cream-deep)', color:'var(--ink-soft)'}}>
                Adding <span style={{color:'var(--ink)', fontWeight:500}}>{product?.name}</span> · already scheduled: <span style={{color:'var(--ink)', fontWeight:500}}>{conflictWith?.name}</span>
              </div>
              <div className="flex gap-2">
                <button
                  onClick={() => setPendingConflict(null)}
                  className="flex-1 pill-btn secondary"
                  type="button"
                >Cancel</button>
                <button
                  onClick={() => { if (commit) commit(); setPendingConflict(null); }}
                  className="flex-1 pill-btn primary"
                  type="button"
                >Add anyway</button>
              </div>
            </div>
          </div>
        );
      })()}

      {/* === COVER-LAUNCHED ADD-FROM-SHELF SHEET ===
          Opened by the cover's "From Shelf" pill. Shows ALL active shelf
          products with per-row [+ AM] and [+ PM] toggle buttons. Each tap
          mutates today's regimenLog directly (auto-save), so there's no
          separate commit step — the user just closes when they're done.
          Footer shows live counts + a single obvious Close action. */}
      {shelfQuickAddState && (() => {
        // === DATE PLUMBING (May 2026 bug fix per Jenni) ===
        // The "Add from shelf" sheet used to hardcode today, so adding from a
        // past-day cover view silently wrote to today's regimenLog. The state
        // now carries the user's viewDate. We keep the `todayKey` identifier
        // for blame minimization but it now points to the TARGET day, not
        // literally today.
        const todayKey = shelfQuickAddState.date || localDateISO();
        const isViewingToday = todayKey === localDateISO();
        const todayLog = (regimenLogs || []).find(r => r.date === todayKey);
        const amIds = new Set((todayLog?.amProducts) || []);
        const pmIds = new Set((todayLog?.pmProducts) || []);
        const activeProductsList = (products || []).filter(p => !p.endDate);
        const filterMap = {
          all: null,
          toner: ['toner'],
          serum: ['serum'],
          moisturizer: ['moisturizer', 'cream'],
          essence: ['essence'],
          cleanser: ['cleanser', 'wash'],
          'eye-care': ['eye'],
          spf: ['spf', 'sunscreen'],
        };
        const q = shelfQuickAddSearch.trim().toLowerCase();
        const matchKeys = filterMap[shelfQuickAddFilter];
        const visible = activeProductsList
          .filter(p => {
            if (!matchKeys) return true;
            const cat = (p.category || '').toLowerCase();
            return matchKeys.some(k => cat.includes(k));
          })
          .filter(p => {
            if (!q) return true;
            return (p.brand || '').toLowerCase().includes(q) || (p.name || '').toLowerCase().includes(q);
          })
          .sort((a, b) => (a.brand || a.name || '').localeCompare(b.brand || b.name || ''));

        // === AUTO-SAVE TOGGLE ===
        // Mutates today's regimenLog directly. If today has no log yet, creates
        // one with submitted: false (the user can run the formal Save later via
        // the Edit Today modal if they want a "logged" check-in record). Persists
        // via saveData and triggers cover rebuild + product art generation so
        // bottles paint in if needed.
        const toggleSlot = (productId, slot) => {
          const slotKey = slot === 'am' ? 'amProducts' : 'pmProducts';
          const otherKey = slot === 'am' ? 'pmProducts' : 'amProducts';
          const baseLog = todayLog || {
            id: Date.now(),
            date: todayKey,
            amProducts: [],
            pmProducts: [],
            amDone: [],
            pmDone: [],
            notes: '',
            submitted: false,
          };
          const currentSlot = baseLog[slotKey] || [];
          const isInSlot = currentSlot.includes(productId);
          // === CONFLICT CHECK — commit-then-warn (May 2026 per Jenni) ===
          // Was: route to pendingConflict modal that blocked the add. User
          // had to click Add anyway to commit. Per Jenni's feedback: "let
          // the user select it still then prompt that it interacts" — i.e.
          // surface the interaction as info, not a gate. Now the add
          // commits immediately and we fire a soft toast with the warning
          // copy. User stays in flow; the heads-up still lands.
          let conflictWarning = null;
          if (!isInSlot) {
            const incomingProduct = activeProductsList.find(p => p.id === productId);
            const slotShelfProducts = currentSlot.map(id => activeProductsList.find(p => p.id === id)).filter(Boolean);
            const conflict = detectAddConflict(incomingProduct, slotShelfProducts);
            if (conflict) {
              conflictWarning = `Added — heads up: ${incomingProduct?.name || 'this'} overlaps with ${conflict.conflictWith?.name || 'another active'}. ${conflict.note || 'Consider alternating days.'}`;
            }
          }
          const nextSlot = isInSlot
            ? currentSlot.filter(id => id !== productId)
            : [...currentSlot, productId];
          // === INHERIT DONE STATE (June 2026 per Jenni — bug fix) ===
          // When adding a product to a slot that's already in "Done today"
          // state, the new product should inherit the done state. Without
          // this, the user has to manually tap the circle on the new
          // product after add, which contradicts the "Done today" promise.
          // Detection: slot was batch-confirmed OR every existing product
          // was already done. Removal path also strips from done.
          const doneKey = slot === 'am' ? 'amDone' : 'pmDone';
          const batchKey = slot === 'am' ? 'amBatchConfirmed' : 'pmBatchConfirmed';
          const currentDone = Array.isArray(baseLog[doneKey]) ? baseLog[doneKey] : [];
          const slotWasFullyDone = baseLog[batchKey] === true
            || (currentSlot.length > 0 && currentSlot.every(id => currentDone.includes(id)));
          let nextDone;
          if (isInSlot) {
            // Removing — also strip from done.
            nextDone = currentDone.filter(id => id !== productId);
          } else if (slotWasFullyDone) {
            // Adding to an already-done slot — inherit done.
            nextDone = currentDone.includes(productId) ? currentDone : [...currentDone, productId];
          } else {
            nextDone = currentDone;
          }
          const nextLog = {
            ...baseLog,
            [slotKey]: nextSlot,
            [otherKey]: baseLog[otherKey] || [],
            [doneKey]: nextDone,
          };
          const nextRegimenLogs = todayLog
            ? regimenLogs.map(r => r.date === todayKey ? nextLog : r)
            : [nextLog, ...regimenLogs];
          setRegimenLogs(nextRegimenLogs);
          setCoverRoutineRebuildToken(t => t + 1);
          saveData('regimenLogs', nextRegimenLogs).catch(e => {
            console.error('[quick-add shelf] saveData failed:', e);
            toast(`Save error: ${e?.message || 'unknown'}`, 'error');
          });
          // Surface the interaction warning AFTER the add commits.
          // Soft prompt, not a gate (May 2026 per Jenni).
          if (conflictWarning && !isInSlot) {
            toast(conflictWarning, 'warning');
          }
          // Product imagery is text/icon-only now; do not trigger
          // background AI bottle generation after routine edits.
        };
        const closeSheet = () => {
          setShelfQuickAddOpen(false);
          setShelfQuickAddSearch('');
          setShelfQuickAddFilter('all');
        };
        const amCount = (todayLog?.amProducts || []).length;
        const pmCount = (todayLog?.pmProducts || []).length;

        return (
          <div
            className="shelf-bottom-sheet-overlay"
            onClick={(e) => { if (e.target === e.currentTarget) closeSheet(); }}
          >
            <div className="shelf-bottom-sheet" role="dialog" aria-label="Add from shelf">
              {/* Header */}
              <div className="px-4 pt-4 pb-2 flex items-start justify-between">
                <div className="min-w-0">
                  <div className="font-serif italic text-[18px]" style={{color:'var(--ink)'}}>Add from shelf</div>
                  <div className="text-[11px] mt-0.5" style={{color:'var(--ink-soft)'}}>
                    Tap +AM or +PM to add to today’s routine.
                  </div>
                </div>
                <button
                  onClick={closeSheet}
                  className="w-8 h-8 rounded-full flex items-center justify-center transition hover:bg-[var(--cream-deep)] flex-shrink-0"
                  style={{color:'var(--ink-soft)'}}
                  aria-label="Close"
                  type="button"
                >
                  <Icon name="X" size={14} />
                </button>
              </div>

              {/* Search */}
              <div className="px-4 pb-2">
                <div className="flex items-center gap-2 rounded-full px-3 py-2" style={{background:'var(--cream-deep)', border: '1px solid var(--line)'}}>
                  <Icon name="Search" size={12} style={{color:'var(--ink-soft)'}} />
                  <input
                    type="text"
                    value={shelfQuickAddSearch}
                    onChange={(e) => setShelfQuickAddSearch(e.target.value)}
                    placeholder="Search your shelf"
                    className="flex-1 bg-transparent outline-none text-[13px]"
                    style={{color:'var(--ink)'}}
                  />
                  {shelfQuickAddSearch && (
                    <button onClick={() => setShelfQuickAddSearch('')} style={{color:'var(--ink-soft)'}} type="button">
                      <Icon name="X" size={11} />
                    </button>
                  )}
                </div>
              </div>

              {/* Filter chips — WRAPPED to two lines so all 8 categories
                  are visible at once on a 380px viewport. Replaces the prior
                  horizontal-scroll affordance, which kept hiding "Cleanser /
                  Eye Care / SPF" off-screen. */}
              <div className="px-4 pb-3 flex flex-wrap gap-1.5">
                {[
                  { id: 'all', label: 'All' },
                  { id: 'toner', label: 'Toner' },
                  { id: 'serum', label: 'Serum' },
                  { id: 'moisturizer', label: 'Moisturizer' },
                  { id: 'essence', label: 'Essence' },
                  { id: 'cleanser', label: 'Cleanser' },
                  { id: 'eye-care', label: 'Eye Care' },
                  { id: 'spf', label: 'SPF' },
                ].map(chip => (
                  <button
                    key={chip.id}
                    onClick={() => setShelfQuickAddFilter(chip.id)}
                    className={'filter-chip' + (shelfQuickAddFilter === chip.id ? ' active' : '')}
                    type="button"
                  >
                    {chip.label}
                  </button>
                ))}
              </div>

              {/* Scrollable product list */}
              <div className="shelf-scroll-area">
                {visible.length === 0 ? (
                  <div className="py-12 text-center">
                    <div className="font-serif italic text-[14px] mb-1" style={{color:'var(--ink)'}}>
                      {activeProductsList.length === 0 ? 'Empty shelf, empty mind.' : 'Nothing here. Try less.'}
                    </div>
                    <div className="text-[11px]" style={{color:'var(--ink-soft)'}}>
                      {activeProductsList.length === 0 ? 'Hit + New Product on the cover. We’ll wait.' : 'Loosen the filter or search shorter.'}
                    </div>
                  </div>
                ) : (
                  visible.map(p => {
                    const inAm = amIds.has(p.id);
                    const inPm = pmIds.has(p.id);
                    const art = null;
                    const hasRealPhoto = p.photo || p.photoPath;
                    // Compact descriptor: combine product name (if distinct from brand)
                    // + category + size into ONE secondary line. Brand goes on its own
                    // line above. Keeps every row to a clean 2-line text block.
                    const descParts = [];
                    if (p.brand && p.name && p.brand !== p.name) descParts.push(p.name);
                    if (p.category) descParts.push(p.category.replace(/-/g, ' '));
                    if (p.size) descParts.push(p.size);
                    const descLine = descParts.join(' · ');
                    return (
                      <div key={p.id} className="quickadd-row">
                        {/* Bottle thumbnail */}
                        <div className="h-11 flex items-end justify-center overflow-hidden">
                          {hasRealPhoto ? (
                            <Photo item={p} alt={p.name} className="h-full w-auto max-w-full object-contain"
                              renderFallback={() => art ? <img src={art} alt={p.name} className="h-full w-auto max-w-full object-contain" /> : <DashedBottleOutline />}
                            />
                          ) : art ? (
                            <img src={art} alt={p.name} className="h-full w-auto max-w-full object-contain" />
                          ) : (
                            <DashedBottleOutline />
                          )}
                        </div>
                        {/* Brand on line 1, description on line 2 */}
                        <div className="min-w-0">
                          <div className="font-medium text-[13px] truncate" style={{color:'var(--ink)'}}>{p.brand || p.name}</div>
                          {descLine && (
                            <div className="text-[10.5px] truncate" style={{color:'var(--ink-soft)'}}>{descLine}</div>
                          )}
                        </div>
                        {/* AM / PM affordance ===
                            BIDIRECTIONAL TOGGLE (May 2026 update): items already
                            in today's routine show a filled "✓ IN AM" / "✓ IN PM"
                            button — TAP TO REMOVE. Items not in the slot show
                            outline "+ AM" / "+ PM" — TAP TO ADD. The same
                            toggleSlot handler covers both directions, so user
                            can curate routines without leaving this sheet. */}
                        <div className="flex gap-1.5 items-center justify-end">
                          <button
                            onClick={() => toggleSlot(p.id, 'am')}
                            className={'slot-toggle' + (inAm ? ' added' : '')}
                            type="button"
                            title={inAm ? "Remove from AM routine" : "Add to AM"}
                            aria-label={inAm ? `Remove ${p.name} from AM` : `Add ${p.name} to AM`}
                            aria-pressed={inAm}
                          >
                            <Icon name={inAm ? 'Check' : 'Plus'} size={11} />
                            <span>{inAm ? 'IN AM' : 'AM'}</span>
                          </button>
                          <button
                            onClick={() => toggleSlot(p.id, 'pm')}
                            className={'slot-toggle' + (inPm ? ' added' : '')}
                            type="button"
                            title={inPm ? "Remove from PM routine" : "Add to PM"}
                            aria-label={inPm ? `Remove ${p.name} from PM` : `Add ${p.name} to PM`}
                            aria-pressed={inPm}
                          >
                            <Icon name={inPm ? 'Check' : 'Plus'} size={11} />
                            <span>{inPm ? 'IN PM' : 'PM'}</span>
                          </button>
                        </div>
                      </div>
                    );
                  })
                )}
              </div>

              {/* Sticky footer: live AM/PM counts + Done with change count */}
              <div className="shelf-footer">
                <div className="text-[11.5px] flex items-center gap-3" style={{color:'var(--ink-soft)'}}>
                  <span><span style={{color:'var(--accent)', fontWeight:600}}>{amCount}</span> in AM</span>
                  <span style={{opacity:0.4}}>·</span>
                  <span><span style={{color:'var(--accent)', fontWeight:600}}>{pmCount}</span> in PM</span>
                </div>
                {(() => {
                  // === CHANGE COUNT IN DONE BUTTON (June 2026 per Jenni) ===
                  // Diff current AM/PM slots vs the snapshot captured when the
                  // sheet opened. Additions + removals = "changes." When > 0,
                  // append "· N change(s)" to the Done label so the user has a
                  // clear summary of what they just did before closing.
                  const initial = shelfQuickAddInitialRef.current;
                  const currentAm = new Set(todayLog?.amProducts || []);
                  const currentPm = new Set(todayLog?.pmProducts || []);
                  let changes = 0;
                  if (initial) {
                    for (const id of currentAm) if (!initial.am.has(id)) changes++;
                    for (const id of initial.am) if (!currentAm.has(id)) changes++;
                    for (const id of currentPm) if (!initial.pm.has(id)) changes++;
                    for (const id of initial.pm) if (!currentPm.has(id)) changes++;
                  }
                  const label = changes > 0
                    ? `Done · ${changes} change${changes === 1 ? '' : 's'}`
                    : 'Done';
                  return (
                    <button
                      onClick={closeSheet}
                      className="pill-primary"
                      type="button"
                      aria-label={changes > 0 ? `Close shelf, ${changes} changes made` : 'Close shelf'}
                    >
                      <Icon name="Check" size={13} />
                      <span>{label}</span>
                    </button>
                  );
                })()}
              </div>
            </div>
          </div>
        );
      })()}
      {showProcedureModal && (
        <ProcedureModal
          procedures={procedures}
          setProcedures={setProcedures}
          editingProcedureId={editingProcedureId}
          setEditingProcedureId={setEditingProcedureId}
          logs={logs}
          callClaude={callClaude}
          saveData={saveData}
          toast={toast}
          user={user}
          setShowProcedureModal={setShowProcedureModal}
          modalScrollMemo={modalScrollMemo}
          useModalScrollPreserve={useModalScrollPreserve}
          uploadPhotoToStorage={uploadPhotoToStorage}
          fileToBase64={fileToBase64}
          withTimeout={withTimeout}
          getApiKey={getApiKey}
          onProcedureLogged={(proc) => setProcedureRebuildPrompt({ name: proc?.name, id: proc?.id })}
        />
      )}

      {/* === RITUAL · WHY THIS TODAY BOTTOM SHEET ===
          Editorial bottom sheet explaining the rationale behind today's plan.
          Slides up from bottom on mobile; centered modal on desktop. */}
      {ritualWhySheet && (() => {
        // Synthesize copy from current state. If we have an AI key + a today's
        // recommended routine cached, show its rationale. Otherwise fall back to
        // a thoughtful evergreen explanation grounded in user concerns.
        const concernText = (userConcerns && userConcerns.length > 0)
          ? userConcerns.slice(0, 3).join(', ').toLowerCase()
          : 'barrier health and consistency';
        const sensText = (sensitivities && sensitivities.length > 0)
          ? sensitivities.slice(0, 3).map(s => s.trigger || s.name || s).filter(Boolean).join(', ')
          : null;
        const recentLog = (logs || [])[0];
        const recentRating = recentLog ? `${recentLog.rating}/10` : null;
        return (
          <div
            className="fixed inset-0 z-50 flex items-end md:items-center justify-center"
            style={{background:'rgba(28,25,23,0.55)', backdropFilter:'blur(6px)'}}
            onClick={() => setRitualWhySheet(false)}
          >
            <div
              onClick={e => e.stopPropagation()}
              className="rounded-t-[24px] md:rounded-[24px] w-full md:max-w-md max-h-[85vh] overflow-y-auto"
              style={{background:'var(--cream)', animation:'slide 280ms ease-out'}}
            >
              {/* Drag handle for mobile */}
              <div className="flex justify-center pt-2.5 pb-1 md:hidden">
                <div style={{width:'40px', height:'4px', borderRadius:'2px', background:'var(--line)'}} />
              </div>
              <div className="px-5 pt-4 md:pt-6 pb-6 md:px-7">
                <Eyebrow tone="accent" className="mb-1.5">Why this today</Eyebrow>
                <h2 className="font-serif italic text-[20px] md:text-[22px] leading-[1.15] mb-4" style={{color:'var(--ink)'}}>
                  Tuned to where your skin is.
                </h2>

                <div className="space-y-4">
                  <div>
                    <Eyebrow className="mb-1">What we're targeting</Eyebrow>
                    <p className="text-[13px] leading-relaxed" style={{color:'var(--ink)'}}>
                      Today's plan focuses on <span className="italic">{concernText}</span>{recentRating ? <> with your last skin reading at {recentRating}</> : null}. The actives chosen have evidence-grade A or B for these targets and pair safely with the rest of your shelf.
                    </p>
                  </div>

                  <div>
                    <Eyebrow className="mb-1">What we avoided</Eyebrow>
                    <p className="text-[13px] leading-relaxed" style={{color:'var(--ink)'}}>
                      {sensText
                        ? <>Your sensitivities to <span className="italic">{sensText}</span> are filtered out before any product reaches the plan.</>
                        : <>Antagonistic actives (e.g. retinol stacked with high-strength acids) are spaced across the week so nothing competes for skin tolerance on the same night.</>}
                    </p>
                  </div>

                  <div>
                    <Eyebrow className="mb-1">Best practice tonight</Eyebrow>
                    <p className="text-[13px] leading-relaxed" style={{color:'var(--ink)'}}>
                      Cleanse on damp skin, layer thinnest-to-thickest, finish with the heaviest occlusive last. If a step stings or pills, skip it for tonight rather than pushing through — barrier disruption costs more than missing a single application.
                    </p>
                    <button
                      onClick={() => { setRitualWhySheet(false); setRegimenView('today'); /* surface technique lesson */ if (typeof setOpenLesson === 'function') {/* opening a lesson would go here */} }}
                      className="mt-2 text-[10.5px] tracking-[0.18em] uppercase italic flex items-center gap-1 transition hover:opacity-70"
                      style={{color:'var(--accent)'}}
                    >
                      <Icon name="BookOpen" size={11} /> Read the technique guide
                    </button>
                  </div>
                </div>

                <div className="mt-6 flex justify-end">
                  <button
                    onClick={() => setRitualWhySheet(false)}
                    className="text-[10.5px] tracking-[0.18em] uppercase italic flex items-center gap-1 transition hover:opacity-70"
                    style={{color:'var(--ink-soft)'}}
                  >
                    Close <Icon name="X" size={11} />
                  </button>
                </div>
              </div>
            </div>
          </div>
        );
      })()}

      {/* === RITUAL · WEEKLY DAY DETAIL BOTTOM SHEET ===
          THE signature interaction. Triggered by tapping any Mon-Sun tile in
          the Weekly Rotation card. Designed to feel magical: backdrop blur,
          slide-up animation, the tapped day's theme rendered as serif italic
          display, AI reasoning paragraph, full numbered AM/PM regimen, and
          three action buttons (Use this plan today / Edit this day / Ask AI
          why). On mobile renders as a bottom sheet, on desktop as a centered
          modal — same component handles both. */}
      {ritualDaySheet && (() => {
        const iso = ritualDaySheet;
        const date = new Date(iso + 'T00:00:00');
        const todayKey = localDateISO();
        const isToday = iso === todayKey;
        const productById = Object.fromEntries((products || []).map(p => [p.id, p]));
        // Try submitted log first; if not present, try ANY log for the date
        // (un-submitted draft); finally fall back to shelf defaults so
        // clicking an unlogged day still shows the planned ritual instead
        // of an empty sheet. Mirrors cover/regimen card behavior — a day
        // sheet is the "view this day" surface, not "view only logged days."
        const submittedLog = (regimenLogs || []).find(r => r.date === iso && r.submitted);
        const anyLog = submittedLog || (regimenLogs || []).find(r => r.date === iso);
        const dayLog = anyLog;
        const activeShelf = (products || []).filter(p => !p.endDate);
        // === DAY SHEET FALLBACK (May 2026 fix) ===
        // When no log exists for this day, derive AM/PM from the user's
        // built weekly rotation for that specific weekday. If no pattern,
        // show empty — don't dump the whole shelf into the day view.
        const sheetDOW = (() => {
          try { return new Date(iso + 'T00:00:00').getDay(); }
          catch { return new Date().getDay(); }
        })();
        const sheetHasPattern = userHasBuiltPattern(products);
        const sheetPatternFallback = (!dayLog && sheetHasPattern)
          ? getProductsForTodayFromPattern(activeShelf, sheetDOW)
          : null;
        const dayAm = dayLog
          ? (dayLog.amProducts || []).map(id => productById[id]).filter(Boolean)
          : (sheetPatternFallback ? sheetPatternFallback.am : []);
        const dayPm = dayLog
          ? (dayLog.pmProducts || []).map(id => productById[id]).filter(Boolean)
          : (sheetPatternFallback ? sheetPatternFallback.pm : []);
        // Also show the photo if one exists for that day.
        const hasPhoto = (l) => l && (l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:')));
        const dayPhotoLog = (logs || []).filter(l => l.date === iso && hasPhoto(l))
          .sort((a, b) => (b.id || 0) - (a.id || 0))[0];
        // Theme inference (mirror of strip logic) — anchor on hero ingredient.
        const all = [...dayAm, ...dayPm];
        const txt = all.map(p => `${p.name || ''} ${p.activeIngredients || ''}`).join(' ').toLowerCase();
        const dow = (date.getDay() + 6) % 7;
        const themeRotation = ['Vitamin C AM', 'Retinol PM', 'Recovery Day', 'Acid Night', 'Hydration', 'Barrier Repair', 'Reset Sunday'];
        let theme = themeRotation[dow];
        if (/retinol|tretinoin|retinaldehyde|adapalene/.test(txt)) theme = 'Retinol PM';
        else if (/ascorbic|vitamin c|c.?ferulic/.test(txt)) theme = 'Vitamin C AM';
        else if (/glycolic|salicylic|lactic|mandelic|aha|bha/.test(txt)) theme = 'Acid Night';
        else if (/niacinamide|panthenol|ceramide|centella/.test(txt)) theme = 'Barrier Repair';
        // AI reasoning — synthesized from theme. Real AI fetch wires later.
        const reasonByTheme = {
          'Vitamin C AM': "Vitamin C front-loads antioxidant defense before sun exposure builds free radicals. Pair with sunscreen — it's a sentence, not a contract.",
          'Retinol PM':   "Retinoids work overnight on cell turnover. Tonight is spaced two days from your last acid night so tolerance has time to rebuild.",
          'Recovery Day': "Your last check-in showed mild reactivity, so we scheduled a break from actives — only barrier ingredients tonight to let your skin reset.",
          'Acid Night':   "Exfoliating acids tonight to refresh tone and texture. Skip retinoids and high-percentage vitamin C for 24 hours afterward.",
          'Hydration':    "Lipid-water balance focus tonight — humectants below an occlusive to hold moisture through to morning.",
          'Barrier Repair':"Ceramides + niacinamide reinforce the lipid lamellae after the week's actives. Think of this as restoration time.",
          'Reset Sunday': "Lightest-touch day of the week. Cleanse, hydrate, sunscreen — that's it. Lets your skin show its true baseline before next week begins.",
        };
        const reason = reasonByTheme[theme] || `Plan for ${date.toLocaleDateString('en-US', { weekday: 'long' })}, balanced against the rest of your week.`;
        const usePlanToday = () => {
          // Set today's check-in to mirror this day's products (or open the
          // check-in modal pre-filled — for now just close + open modal).
          setRitualDaySheet(null);
          setShowCheckInModal(true);
        };
        const editThisDay = () => {
          setRitualDaySheet(null);
          // Could deep-link to a per-day editor — for now uses the same modal.
          setShowCheckInModal(true);
        };
        const askWhy = () => {
          // Open Counsel pre-seeded with the day's plan + reasoning.
          if (typeof openChat === 'function') {
            openChat({
              context: `Plan for ${date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })} — ${theme}\n\nAM:\n${dayAm.map((p, i) => `${i + 1}. ${p.name}`).join('\n') || '(no AM products planned)'}\n\nPM:\n${dayPm.map((p, i) => `${i + 1}. ${p.name}`).join('\n') || '(no PM products planned)'}\n\nAI rationale: ${reason}`,
              title: `${date.toLocaleDateString('en-US', { weekday: 'long' })} · ${theme}`,
              subtitle: 'Ask about this day',
              suggestions: [
                'Why these products and not others?',
                'What if I skip a step tonight?',
                'How does this fit with the rest of the week?',
                'What signs would tell me to switch the plan?',
              ],
            });
            setRitualDaySheet(null);
          }
        };
        return (
          <div
            className="fixed inset-0 z-50 flex items-end md:items-center justify-center"
            style={{background:'rgba(28,25,23,0.55)', backdropFilter:'blur(6px)', animation:'fadeIn 220ms ease-out'}}
            onClick={() => setRitualDaySheet(null)}
          >
            <div
              onClick={e => e.stopPropagation()}
              className="rounded-t-[24px] md:rounded-[24px] w-full md:max-w-md max-h-[88vh] overflow-y-auto"
              style={{background:'var(--cream)', animation:'slide 320ms cubic-bezier(0.2, 0.9, 0.3, 1)'}}
            >
              {/* Drag handle */}
              <div className="flex justify-center pt-2.5 pb-1 md:hidden">
                <div style={{width:'40px', height:'4px', borderRadius:'2px', background:'var(--line)'}} />
              </div>

              {/* Header — back + date title. Meatball "More" button
                  retired (May 2026 launch-safety pass): it had no
                  onClick handler, which would mislead users into
                  expecting a menu. Add it back when a real overflow
                  menu earns its place. */}
              <div className="flex items-center justify-between px-5 pt-3 md:pt-5 md:px-7">
                <button
                  onClick={() => setRitualDaySheet(null)}
                  className="w-8 h-8 rounded-full flex items-center justify-center transition hover:bg-[var(--cream-deep)]"
                  style={{color:'var(--ink-soft)'}}
                  aria-label="Back"
                >
                  <Icon name="ChevronLeft" size={16} />
                </button>
                <div className="text-center flex-1">
                  <div className="font-serif italic text-[18px] md:text-[20px] leading-tight" style={{color:'var(--ink)'}}>
                    {date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}
                  </div>
                </div>
                <div className="w-8 h-8" aria-hidden="true" />
              </div>

              <div className="px-5 md:px-7 pt-2 pb-7">
                {/* Theme card with botanical accent — terracotta tint background.
                    Mirrors the mockup's "Recovery Day" hero panel exactly. */}
                <div
                  className="rounded-[18px] px-4 py-4 mt-3 mb-5 relative overflow-hidden"
                  style={{background:'#f3e6d8'}}
                >
                  <div className="flex items-center gap-2 mb-1.5">
                    <Icon name="Sparkles" size={11} style={{color:'var(--accent)'}} />
                    <span className="text-[10px] tracking-[0.22em] uppercase" style={{color:'var(--accent)'}}>{theme}</span>
                    <span className="text-[8px] tracking-[0.18em] uppercase px-1.5 py-0.5 rounded-sm ml-auto" style={{background:'var(--cream)', color:'var(--ink-soft)'}}>AI</span>
                  </div>
                  <p className="text-[12.5px] leading-relaxed pr-10" style={{color:'var(--ink)'}}>{reason}</p>
                  {/* Subtle decorative botanical mark */}
                  <svg viewBox="0 0 60 60" width="60" height="60" className="absolute right-2 bottom-2 opacity-25" style={{pointerEvents:'none'}}>
                    <path d="M30 50 Q30 30 35 18 Q40 28 38 42" fill="none" stroke="var(--accent)" strokeWidth="1" strokeLinecap="round" />
                    <ellipse cx="34" cy="22" rx="3" ry="6" fill="none" stroke="var(--accent)" strokeWidth="0.8" transform="rotate(20 34 22)" />
                    <ellipse cx="32" cy="34" rx="3.5" ry="7" fill="none" stroke="var(--accent)" strokeWidth="0.8" transform="rotate(-15 32 34)" />
                  </svg>
                </div>

                {/* Day photo — if a photo was logged on this day, show it
                    above the ritual lists. Tap → opens the Skin Read drawer
                    with the day's AI analysis. */}
                {dayPhotoLog && (
                  <button
                    type="button"
                    onClick={() => { setRitualDaySheet(null); setSkinReadDrawerLogId(dayPhotoLog.id); }}
                    className="w-full mb-5 rounded-[14px] overflow-hidden flex items-stretch gap-3 text-left transition hover:opacity-95"
                    style={{background:'var(--cream-deep)', border: '1px solid var(--line)'}}
                  >
                    <div className="w-24 h-24 flex-shrink-0 overflow-hidden">
                      <Photo item={dayPhotoLog} alt="" className="w-full h-full object-cover" />
                    </div>
                    <div className="flex-1 min-w-0 py-2 pr-3 flex flex-col justify-center">
                      <div className="text-[9.5px] tracking-[0.22em] uppercase" style={{color:'var(--ink-soft)'}}>
                        Photo · {(dayPhotoLog.area || 'full-face').replace(/-/g, ' ')}
                      </div>
                      {aiScoreOut10(dayPhotoLog) && (
                        <div className="font-serif italic text-[18px] leading-tight mt-1" style={{color:'var(--ink)'}}>
                          <span style={{color:'var(--accent)'}}>✦</span> {aiScoreOut10(dayPhotoLog)}<span className="text-[10px]" style={{color:'var(--ink-soft)'}}> /10</span>
                        </div>
                      )}
                      <div className="text-[10px] tracking-[0.15em] uppercase italic mt-1" style={{color:'var(--accent)'}}>
                        Tap for analysis →
                      </div>
                    </div>
                  </button>
                )}

                {/* Numbered step renderer — used for both AM + PM. Each step shows
                    the step number, product name + category, and a bottle thumb on
                    the right (real photo > Gemini art > dashed outline). Mirrors the
                    mockup's numbered AM/PM list pattern. */}
                {(() => null)() /* spacer */}
                {(dayAm.length > 0 || !dayLog) && (
                  <div className="mb-5">
                    <div className="flex items-center gap-1.5 mb-2.5">
                      <Icon name="Sun" size={12} style={{color:'var(--accent)'}} />
                      <span className="text-[10.5px] tracking-[0.22em] uppercase" style={{color:'var(--accent)'}}>Morning</span>
                    </div>
                    {dayAm.length > 0 ? (
                      <ol className="space-y-2.5">
                        {dayAm.map((p, i) => {
                          const aiArt = null;
                          const hasRealPhoto = !!(p.photo || p.photoPath);
                          return (
                            <li key={p.id} className="flex items-center gap-3 rounded-[12px] px-3 py-2.5" style={{background:'var(--cream-deep)'}}>
                              <div className="w-6 h-6 rounded-full flex items-center justify-center text-[11px] flex-shrink-0" style={{background:'var(--cream)', color:'var(--ink-soft)', border: '1px solid var(--line)'}}>{i + 1}</div>
                              <div className="flex-1 min-w-0">
                                <div className="font-serif italic text-[14px] leading-tight truncate" style={{color:'var(--ink)'}}>{p.name}</div>
                                {p.category && <div className="text-[10.5px] tracking-[0.15em] uppercase" style={{color:'var(--ink-soft)'}}>{p.category}</div>}
                              </div>
                              <div className="w-9 h-12 flex items-end justify-center flex-shrink-0 overflow-hidden">
                                {hasRealPhoto ? (
                                  <Photo item={p} alt={p.name} className="h-full w-auto max-w-full object-contain"
                                    renderFallback={() => aiArt ? <img src={aiArt} alt="" className="h-full w-auto max-w-full object-contain" /> : <DashedBottleOutline />}
                                  />
                                ) : aiArt ? (
                                  <img src={aiArt} alt="" className="h-full w-auto max-w-full object-contain" />
                                ) : (
                                  <DashedBottleOutline />
                                )}
                              </div>
                            </li>
                          );
                        })}
                      </ol>
                    ) : (
                      <p className="text-[11.5px] italic" style={{color:'var(--ink-soft)'}}>No AM plan logged for this day.</p>
                    )}
                  </div>
                )}

                {(dayPm.length > 0 || !dayLog) && (
                  <div className="mb-6">
                    <div className="flex items-center gap-1.5 mb-2.5">
                      <Icon name="Moon" size={12} style={{color:'var(--accent)'}} />
                      <span className="text-[10.5px] tracking-[0.22em] uppercase" style={{color:'var(--accent)'}}>Evening</span>
                    </div>
                    {dayPm.length > 0 ? (
                      <ol className="space-y-2.5">
                        {dayPm.map((p, i) => {
                          const aiArt = null;
                          const hasRealPhoto = !!(p.photo || p.photoPath);
                          return (
                            <li key={p.id} className="flex items-center gap-3 rounded-[12px] px-3 py-2.5" style={{background:'var(--cream-deep)'}}>
                              <div className="w-6 h-6 rounded-full flex items-center justify-center text-[11px] flex-shrink-0" style={{background:'var(--cream)', color:'var(--ink-soft)', border: '1px solid var(--line)'}}>{i + 1}</div>
                              <div className="flex-1 min-w-0">
                                <div className="font-serif italic text-[14px] leading-tight truncate" style={{color:'var(--ink)'}}>{p.name}</div>
                                {p.category && <div className="text-[10.5px] tracking-[0.15em] uppercase" style={{color:'var(--ink-soft)'}}>{p.category}</div>}
                              </div>
                              <div className="w-9 h-12 flex items-end justify-center flex-shrink-0 overflow-hidden">
                                {hasRealPhoto ? (
                                  <Photo item={p} alt={p.name} className="h-full w-auto max-w-full object-contain"
                                    renderFallback={() => aiArt ? <img src={aiArt} alt="" className="h-full w-auto max-w-full object-contain" /> : <DashedBottleOutline />}
                                  />
                                ) : aiArt ? (
                                  <img src={aiArt} alt="" className="h-full w-auto max-w-full object-contain" />
                                ) : (
                                  <DashedBottleOutline />
                                )}
                              </div>
                            </li>
                          );
                        })}
                      </ol>
                    ) : (
                      <p className="text-[11.5px] italic" style={{color:'var(--ink-soft)'}}>No PM plan logged for this day.</p>
                    )}
                  </div>
                )}

                {/* Action row — primary edit/use-plan pill, then secondary
                    accent links. The "Edit this day" italic link was removed
                    since the big primary button already opens the editor —
                    duplicating it under was redundant + the disabled state
                    on the primary made the big button look broken on mobile. */}
                <button
                  onClick={usePlanToday}
                  className="w-full rounded-full py-3 px-4 text-[11px] tracking-[0.2em] uppercase flex items-center justify-center gap-2 transition hover:opacity-90 mb-3 cursor-pointer"
                  style={{background:'var(--ink)', color:'var(--cream)', cursor:'pointer'}}
                >
                  {isToday ? 'Edit today\'s ritual' : 'Use this plan today'}
                </button>
                <div className="flex items-center justify-center gap-5 flex-wrap">
                  {/* Suggest with AI — opt-in. Opens the AI Suggest sheet
                      pre-targeted at THIS day instead of today, so suggestions
                      land in the right regimenLog when applied. */}
                  <button
                    onClick={() => {
                      setRitualSuggestion(null);
                      setRitualSuggestSelected(new Set());
                      setRitualSuggestError('');
                      setRitualSuggestSheet({ dateISO: iso, source: 'day' });
                      setRitualDaySheet(null);
                    }}
                    className="text-[10.5px] tracking-[0.18em] uppercase italic flex items-center gap-1 transition hover:opacity-70 cursor-pointer"
                    style={{color:'var(--accent)', cursor:'pointer'}}
                  >
                    <Icon name="Sparkles" size={11} /> Suggest with AI
                  </button>
                  <button
                    onClick={askWhy}
                    className="text-[10.5px] tracking-[0.18em] uppercase italic flex items-center gap-1 transition hover:opacity-70"
                    style={{color:'var(--ink-soft)'}}
                  >
                    <Icon name="MessageCircle" size={11} /> Ask AI why
                  </button>
                </div>
              </div>
            </div>
          </div>
        );
      })()}

      {/* === RITUAL · AI SUGGEST BOTTOM SHEET ===
          Opt-in AI flow. Triggered from Today's hero "Suggest with AI" link
          (source: 'today') or from a day-detail sheet (source: 'day'). The
          sheet:
            1. Calls Claude with user's shelf, concerns, recent skin logs, and
               sensitivities — asks for an AM + PM plan with a one-line "why"
               per item (3-8 words). Each item is either an existing shelf
               product (productId set) or a generic ingredient/category gap.
            2. Renders the proposal as checkbox cards. Defaults: every item
               selected. The user UNticks anything they don't want.
            3. "Apply selected" merges the chosen items into the target day's
               regimenLog (creating it if missing) and closes the sheet. The
               user's plan stays the source of truth — AI only writes what was
               explicitly accepted.
          Uses the same Claude key + callClaude helper the rest of the app uses. */}
      {/* === SKIN READS MONTH CALENDAR ===
          Triggered by the "Expand" button on the swipeable week strip. Renders
          a full-month grid (7 cols × 5-6 rows) with photo thumbnails on days
          that have a log. Tap any day → opens the SkinReadDrawer for that
          log. Arrows step the displayed month back/forward (capped at current). */}
      {skinReadsCalendarOpen && (() => {
        const hasPhotoFn = (l) => l && (l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:')));
        const photoLogs = (logs || []).filter(hasPhotoFn);
        const tdy = new Date(); tdy.setHours(0,0,0,0);
        // Anchored to a "displayed month" derived from skinReadsWeekOffset
        // (week 0 = this week → this month; week -5 → ~5 weeks ago, etc.).
        const refDate = new Date(tdy);
        refDate.setDate(tdy.getDate() + skinReadsWeekOffset * 7);
        const year = refDate.getFullYear();
        const month = refDate.getMonth();
        const monthStart = new Date(year, month, 1);
        const monthEnd = new Date(year, month + 1, 0);
        const startDayIdx = (monthStart.getDay() === 0 ? 6 : monthStart.getDay() - 1); // Mon = 0
        const totalCells = Math.ceil((startDayIdx + monthEnd.getDate()) / 7) * 7;
        const cells = Array.from({ length: totalCells }, (_, i) => {
          const dayNum = i - startDayIdx + 1;
          if (dayNum < 1 || dayNum > monthEnd.getDate()) return { empty: true };
          const d = new Date(year, month, dayNum);
          const iso = localDateISO(d);
          const log = photoLogs.find(l => l.date === iso) || null;
          return {
            iso, dayNum,
            isToday: d.getTime() === tdy.getTime(),
            isFuture: d.getTime() > tdy.getTime(),
            log,
          };
        });
        const monthLabel = monthStart.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
        const stepMonth = (delta) => {
          // Convert a month step into the equivalent week offset.
          const newRef = new Date(year, month + delta, 1);
          const diffDays = Math.round((newRef.getTime() - tdy.getTime()) / 86400000);
          const newOffset = Math.min(0, Math.round(diffDays / 7));
          setSkinReadsWeekOffset(newOffset);
        };
        const isCurrentMonth = year === tdy.getFullYear() && month === tdy.getMonth();
        return (
          <div
            className="fixed inset-0 z-50 flex items-center justify-center"
            style={{background:'rgba(28,25,23,0.55)', backdropFilter:'blur(6px)', animation:'fadeIn 220ms ease-out'}}
            onClick={() => setSkinReadsCalendarOpen(false)}
          >
            <div
              onClick={e => e.stopPropagation()}
              className="rounded-[24px] w-full md:max-w-md max-h-[90vh] overflow-y-auto m-4"
              style={{background:'var(--cream)', animation:'slide 280ms cubic-bezier(0.2, 0.9, 0.3, 1)'}}
            >
              <div className="px-5 md:px-7 pt-5 pb-6">
                <div className="flex items-center justify-between mb-4">
                  <button
                    onClick={() => stepMonth(-1)}
                    className="w-8 h-8 rounded-full flex items-center justify-center transition hover:bg-[var(--cream-deep)]"
                    aria-label="Previous month"
                    style={{color:'var(--ink-soft)'}}
                  >
                    <Icon name="ChevronLeft" size={16} />
                  </button>
                  <div className="text-center">
                    <div className="text-[10px] tracking-[0.3em] uppercase" style={{color:'var(--ink-soft)'}}>Photo log</div>
                    <h2 className="font-serif italic text-[20px] mt-0.5" style={{color:'var(--ink)'}}>{monthLabel}</h2>
                  </div>
                  <button
                    onClick={() => stepMonth(1)}
                    disabled={isCurrentMonth}
                    className="w-8 h-8 rounded-full flex items-center justify-center transition hover:bg-[var(--cream-deep)] disabled:opacity-30 disabled:cursor-not-allowed"
                    aria-label="Next month"
                    style={{color:'var(--ink-soft)'}}
                  >
                    <Icon name="ChevronRight" size={16} />
                  </button>
                </div>
                {/* Day-of-week header */}
                <div className="grid grid-cols-7 gap-1 mb-1">
                  {['M','T','W','T','F','S','S'].map((d, i) => (
                    <div key={i} className="text-[8.5px] tracking-[0.15em] uppercase text-center pb-1" style={{color:'var(--ink-soft)'}}>{d}</div>
                  ))}
                </div>
                {/* Calendar grid */}
                <div className="grid grid-cols-7 gap-1">
                  {cells.map((c, i) => {
                    if (c.empty) return <div key={i} className="aspect-square" />;
                    return (
                      <button
                        key={i}
                        onClick={() => {
                          if (c.log) {
                            setSkinReadDrawerLogId(c.log.id);
                            setSkinReadsCalendarOpen(false);
                          }
                        }}
                        disabled={!c.log}
                        className="aspect-square rounded-[6px] overflow-hidden flex items-center justify-center relative transition hover:opacity-80 disabled:cursor-default"
                        style={{
                          background: c.log ? 'var(--cream-deep)' : (c.isFuture ? 'transparent' : 'var(--cream)'),
                          border: c.isToday ? '1.5px solid var(--accent)' : '1px solid var(--line)',
                          opacity: c.isFuture ? 0.35 : 1,
                        }}
                        aria-label={c.log ? `Open analysis for day ${c.dayNum}` : `Day ${c.dayNum} (no photo)`}
                      >
                        {c.log ? (
                          <>
                            <Photo item={c.log} alt="" className="w-full h-full object-cover"
                              renderFallback={() => <span className="font-serif italic text-[11px]" style={{color:'var(--ink-soft)'}}>{c.dayNum}</span>}
                            />
                            <span className="absolute bottom-0 right-0.5 text-[8.5px] font-serif italic" style={{color:'var(--cream)', textShadow:'0 1px 2px rgba(0,0,0,0.4)'}}>{c.dayNum}</span>
                          </>
                        ) : (
                          <span className="text-[10px] font-serif italic" style={{color:'var(--ink-soft)'}}>{c.dayNum}</span>
                        )}
                      </button>
                    );
                  })}
                </div>
                <div className="text-[10px] italic mt-3 text-center" style={{color:'var(--ink-soft)'}}>
                  Tap any day with a photo to open its analysis
                </div>
                <button
                  onClick={() => setSkinReadsCalendarOpen(false)}
                  className="mt-4 w-full py-2 text-[10px] tracking-[0.2em] uppercase transition"
                  style={{background:'var(--ink)', color:'var(--cream)'}}
                >
                  Close
                </button>
              </div>
            </div>
          </div>
        );
      })()}

      {/* === SKIN READ MINI DRAWER ===
          Lightweight bottom sheet preview. Triggered by tapping today's photo
          on the Journal Skin Reads landing. Shows the snapshot summary, a
          tiny sparkline, and one AI-derived insight. CTA at the bottom opens
          the existing photo detail modal as the "full skin read" — that
          surface gets a richer overhaul in a future round. */}
      {skinReadDrawerLogId && (() => {
        const log = (logs || []).find(l => l.id === skinReadDrawerLogId);
        if (!log) { setSkinReadDrawerLogId(null); return null; }
        const SCORE_MAP = {
          redness:    { Clear: 100, Low: 80, Mild: 55, Moderate: 30, High: 10 },
          hydration:  { Plump: 100, Good: 80, Balanced: 55, Dry: 30, Parched: 10 },
          texture:    { Smooth: 100, Even: 80, Uneven: 55, Rough: 30, Bumpy: 10 },
          breakouts:  { Clear: 100, Few: 75, Some: 50, Many: 25, Severe: 10 },
          barrier:    { Strong: 100, Steady: 80, Holding: 55, Compromised: 30, Stripped: 10 },
          sensitivity:{ Calm: 100, Settled: 80, Tender: 55, Reactive: 30, Inflamed: 10 },
        };
        const titleCase = (w) => w !== undefined && w !== null && w !== '' ? String(w).charAt(0).toUpperCase() + String(w).slice(1).toLowerCase() : null;
        const snap = log.metricSnapshot || null;
        const summaryWords = snap
          ? [
              snap.redness && /clear|low/i.test(snap.redness) ? 'Calm' : null,
              snap.hydration && /plump|good/i.test(snap.hydration) ? 'Hydrated' : null,
              snap.texture && /smooth|even/i.test(snap.texture) ? 'Smooth' : null,
            ].filter(Boolean).join(' · ')
          : '';
        const breakoutMap = { Clear: 0, Few: 1, Some: 3, Many: 5, Severe: 8 };
        const breakoutN = snap ? (breakoutMap[titleCase(snap.breakouts)] ?? 0) : 0;

        // Build sparkline from the last 7 days of snapshots.
        const photoLogs = (logs || []).filter(l => l.metricSnapshot).sort((a,b) => new Date(b.date) - new Date(a.date));
        const last7 = (() => {
          const points = [];
          for (let i = 6; i >= 0; i--) {
            const d = new Date(); d.setDate(d.getDate() - i);
            const iso = localDateISO(d);
            const found = photoLogs.find(l => l.date === iso);
            if (found?.metricSnapshot) {
              const vals = ['redness','hydration','texture','breakouts','barrier','sensitivity']
                .map(k => SCORE_MAP[k][titleCase(found.metricSnapshot[k])])
                .filter(v => typeof v === 'number');
              points.push(vals.length ? vals.reduce((s,v)=>s+v,0)/vals.length : null);
            } else points.push(null);
          }
          return points;
        })();
        const sparkW = 240, sparkH = 36;
        const sparkPoints = last7
          .map((v, i) => v == null ? null : `${(i/6)*sparkW},${sparkH - ((v/100)*sparkH*0.85) - 2}`)
          .filter(Boolean).join(' ');

        // Insight: pick the metric where today most differs from last week.
        const lastWeekLog = photoLogs.find(l => {
          const days = Math.floor((Date.now() - new Date(l.date).getTime()) / 86400000);
          return days >= 6 && days <= 9;
        });
        let insightLine = 'Keep logging — patterns appear after a few entries.';
        if (snap && lastWeekLog?.metricSnapshot) {
          const deltas = ['redness','hydration','texture','breakouts','barrier','sensitivity'].map(k => {
            const a = SCORE_MAP[k][titleCase(snap[k])];
            const b = SCORE_MAP[k][titleCase(lastWeekLog.metricSnapshot[k])];
            if (typeof a !== 'number' || typeof b !== 'number') return null;
            return { k, delta: a - b };
          }).filter(Boolean).sort((x, y) => Math.abs(y.delta) - Math.abs(x.delta));
          if (deltas[0] && Math.abs(deltas[0].delta) >= 5) {
            const word = deltas[0].delta > 0 ? 'improved' : 'worsened';
            insightLine = `${titleCase(deltas[0].k)} ${word} ${Math.abs(Math.round(deltas[0].delta))} pts vs last week.`;
          }
        }

        return (
          <div
            className="fixed inset-0 z-50 flex items-end md:items-center justify-center"
            style={{background:'rgba(28,25,23,0.55)', backdropFilter:'blur(6px)', animation:'fadeIn 220ms ease-out'}}
            onClick={() => setSkinReadDrawerLogId(null)}
          >
            {/* Drawer body — full-bleed on mobile (100dvh, no top gap) so the
                whole reading fits in one shot. md+ centers as a tall card.
                dvh shrinks with the iOS keyboard so inputs stay visible. */}
            <div
              onClick={e => e.stopPropagation()}
              className="mobile-full-sheet rounded-t-[24px] md:rounded-[24px] w-full md:max-w-md overflow-y-auto relative export-target"
              style={{background:'var(--cream)', animation:'slide 280ms cubic-bezier(0.2, 0.9, 0.3, 1)'}}
            >
              {/* === SHARE BUTTONS (May 2026 per Jenni — 2 modes) ===
                  Was: single Download icon → JPG to filesystem.
                  Now: two icons that build a purpose-rendered share card
                  off-screen and pass it through exportNodeAsJpg, which
                  triggers the native share sheet on iOS (Save to Photos,
                  Instagram, Twitter/X, Messages, etc.).
                    [Camera] → Quick (photo + metrics only, social-safe)
                    [Sparkles] → Full (with analysis, journal/private)
                  The off-screen render is cleaner than capturing the live
                  drawer because it excludes scrollbars, close buttons,
                  and the share buttons themselves. */}
              {(() => {
                const runShare = async (shareMode) => {
                  try {
                    // Resolve photo URL — accept either the inline data URL
                    // or a Supabase Storage path that needs base64-fetching.
                    let photoUrl = log.photo;
                    if (!photoUrl && log.photoPath && typeof fetchPhotoAsBase64 === 'function') {
                      photoUrl = await fetchPhotoAsBase64(log.photoPath).catch(() => null);
                    }
                    const aiAvg = snap ? (() => {
                      const vals = ['redness','hydration','texture','breakouts','barrier','sensitivity']
                        .map(k => SCORE_MAP[k]?.[titleCase(snap[k])])
                        .filter(v => typeof v === 'number');
                      return vals.length ? Math.round(vals.reduce((s, v) => s + v, 0) / vals.length) : null;
                    })() : null;
                    const scoreOut10 = aiAvg != null ? (aiAvg / 10).toFixed(1) : null;
                    const dateLabel = new Date(log.date + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'long', day: 'numeric' });
                    const analysisText = log.aiAnalysis || '';
                    const card = buildSkinReadShareCard({
                      mode: shareMode,
                      log, snap, scoreOut10, dateLabel, photoUrl, analysisText,
                    });
                    document.body.appendChild(card);
                    try {
                      await exportNodeAsJpg(card, `etude-${shareMode === 'full' ? 'full-read' : 'snapshot'}-${log.date || localDateISO()}`, {
                        title: shareMode === 'full' ? 'Frida · Full Skin Read' : 'Frida · Skin Snapshot',
                      });
                      // Toast wording depends on what surface accepted the
                      // export. Web Share API resolves silently on success
                      // (system sheet handled it); fall through means we
                      // downloaded instead.
                      const canShareFiles = typeof navigator !== 'undefined' && typeof navigator.canShare === 'function';
                      toast(canShareFiles ? 'Ready to share ✨' : 'Saved to downloads', 'success');
                    } finally {
                      if (card.parentNode) card.parentNode.removeChild(card);
                    }
                  } catch (err) {
                    toast(err?.message || 'Share failed', 'error');
                  }
                };
                return (
                  <>
                    <button
                      onClick={() => runShare('full')}
                      className="absolute top-3 right-14 md:top-4 md:right-16 z-10 w-9 h-9 rounded-full flex items-center justify-center transition hover:opacity-90 cursor-pointer"
                      style={{background:'var(--cream-deep)', border: '1px solid var(--line)', color:'var(--ink)', boxShadow:'0 1px 4px rgba(28,25,23,0.06)', cursor:'pointer'}}
                      aria-label="Share full read with analysis"
                      title="Share with analysis"
                    >
                      <Icon name="Sparkles" size={14} />
                    </button>
                    <button
                      onClick={() => runShare('quick')}
                      className="absolute top-3 right-[100px] md:top-4 md:right-[112px] z-10 w-9 h-9 rounded-full flex items-center justify-center transition hover:opacity-90 cursor-pointer"
                      style={{background:'var(--cream-deep)', border: '1px solid var(--line)', color:'var(--ink)', boxShadow:'0 1px 4px rgba(28,25,23,0.06)', cursor:'pointer'}}
                      aria-label="Share photo and metrics only"
                      title="Share photo + metrics"
                    >
                      <Icon name="Share2" size={14} />
                    </button>
                  </>
                );
              })()}
              <button
                onClick={() => setSkinReadDrawerLogId(null)}
                className="absolute top-3 right-3 md:top-4 md:right-4 z-10 w-9 h-9 rounded-full flex items-center justify-center transition hover:opacity-90 cursor-pointer"
                style={{background:'var(--cream-deep)', border: '1px solid var(--line)', color:'var(--ink)', boxShadow:'0 1px 4px rgba(28,25,23,0.06)', cursor:'pointer'}}
                aria-label="Close"
                title="Close"
              >
                <Icon name="X" size={15} />
              </button>
              <div className="flex justify-center pt-2.5 pb-1 md:hidden">
                <div style={{width:'40px', height:'4px', borderRadius:'2px', background:'var(--line)'}} />
              </div>
              <div className="px-5 md:px-7 pt-3 md:pt-5 pb-6">
                {/* Same-day siblings — if the user logged multiple photos today
                    (e.g. AM vs PM), let them cycle through them right in the drawer
                    so pre/post-mask comparisons are one tap away. */}
                {(() => {
                  const sameDay = (logs || []).filter(l => l.date === log.date && (l.photo || l.photoPath));
                  if (sameDay.length <= 1) return null;
                  sameDay.sort((a, b) => (a.id || 0) - (b.id || 0));
                  const idx = sameDay.findIndex(l => l.id === log.id);
                  const prev = sameDay[(idx - 1 + sameDay.length) % sameDay.length];
                  const next = sameDay[(idx + 1) % sameDay.length];
                  // Is this the photo currently powering the cover?
                  // === SYNCED WITH COVER LOGIC (May 2026 per Jenni) ===
                  // Cover now picks NEWEST by default (was strict
                  // 'full-face' filter). Drawer must match or its
                  // "Cover" pin will lie. New rule:
                  //   - dailyCoverPick[today] override → that's cover
                  //   - else → newest log by id wins
                  const todayKeyForCover = log.date;
                  const sameDayByRecency = [...sameDay].sort((a, b) => (b.id || 0) - (a.id || 0));
                  const isPickedCover = dailyCoverPick[todayKeyForCover] === log.id;
                  const isAutoNewestCover = !dailyCoverPick[todayKeyForCover] && sameDayByRecency[0]?.id === log.id;
                  const isCurrentCover = isPickedCover || isAutoNewestCover;
                  const setAsMain = () => {
                    setDailyCoverPick(prev => {
                      const next = { ...prev, [todayKeyForCover]: log.id };
                      saveData('dailyCoverPick', next);
                      return next;
                    });
                    if (typeof setMainPhotoForDate === 'function') setMainPhotoForDate(todayKeyForCover, log.id);
                    toast(`Set as today's main photo`, 'info');
                  };
                  // Simple ‹ › arrows + caption + Set-as-main button. Stack so
                  // both rows fit cleanly on mobile.
                  return (
                    <div className="mb-3 rounded-[14px] px-3 py-2 space-y-1.5" style={{background:'var(--cream-deep)'}}>
                      <div className="flex items-center justify-between">
                        <button onClick={() => setSkinReadDrawerLogId(prev.id)} className="w-7 h-7 rounded-full flex items-center justify-center transition hover:bg-[var(--cream)]" style={{color:'var(--ink)'}} aria-label="Previous photo">
                          <Icon name="ChevronLeft" size={13} />
                        </button>
                        <span className="text-[10px] tracking-[0.18em] uppercase" style={{color:'var(--ink-soft)'}}>
                          {idx + 1} of {sameDay.length} today {isCurrentCover && <span style={{color:'var(--accent)'}}>· cover</span>}
                        </span>
                        <button onClick={() => setSkinReadDrawerLogId(next.id)} className="w-7 h-7 rounded-full flex items-center justify-center transition hover:bg-[var(--cream)]" style={{color:'var(--ink)'}} aria-label="Next photo">
                          <Icon name="ChevronRight" size={13} />
                        </button>
                      </div>
                      {/* Set-as-main affordance. Suppressed when this photo
                          already powers the cover (avoid a no-op tap). */}
                      {!isCurrentCover && (
                        <button
                          onClick={setAsMain}
                          className="w-full text-[10px] tracking-[0.18em] uppercase italic flex items-center justify-center gap-1.5 py-1 transition hover:opacity-80 cursor-pointer"
                          style={{color:'var(--accent)', cursor:'pointer'}}
                        >
                          <Icon name="Star" size={11} /> Set as main photo
                        </button>
                      )}
                    </div>
                  );
                })()}

                {/* === HEADER (editorial score + descriptor) ===
                    Mirrors the Today tab: italic serif score, /10 hairline,
                    single-word descriptor (Radiant / Balanced / Steady /
                    Tending / Reactive). When no snapshot yet, falls back to
                    the gentler "Reading your skin…" headline. */}
                {(() => {
                  const aiAvg = snap ? (() => {
                    const vals = ['redness','hydration','texture','breakouts','barrier','sensitivity']
                      .map(k => SCORE_MAP[k]?.[titleCase(snap[k])])
                      .filter(v => typeof v === 'number');
                    return vals.length ? Math.round(vals.reduce((s, v) => s + v, 0) / vals.length) : null;
                  })() : null;
                  const aiOut10 = aiAvg != null ? (aiAvg / 10) : null;
                  const aiFmt = aiOut10 != null ? (aiOut10 >= 9.95 ? '10' : aiOut10.toFixed(1)) : null;
                  const desc = aiOut10 == null ? null
                    : aiOut10 >= 8.7 ? 'Radiant'
                    : aiOut10 >= 7.5 ? 'Balanced'
                    : aiOut10 >= 6.5 ? 'Steady'
                    : aiOut10 >= 5.5 ? 'Tender'
                    : 'Reactive';
                  // User's self-rating shown alongside AI when both exist, so
                  // the drawer is the place where you can compare AI vs your gut.
                  const userFmt = log.rating != null ? Number(log.rating).toFixed(1) : null;
                  return (
                    <div className="flex items-start justify-between gap-3 mb-3">
                      <div className="flex-1 min-w-0">
                        <Eyebrow>Skin Read · {new Date(log.date + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'long', day: 'numeric' })}</Eyebrow>
                        {aiFmt != null ? (
                          <div className="flex items-baseline gap-1.5 mt-1">
                            <span style={{color:'var(--accent)', fontSize:'13px', lineHeight:1}} title="AI-derived score">✦</span>
                            <div className="font-serif italic leading-none" style={{color:'var(--ink)', fontSize:'34px'}}>{aiFmt}</div>
                            <div className="font-serif italic leading-none text-[12px]" style={{color:'var(--ink-soft)'}}>/10</div>
                            {desc && <div className="font-serif italic text-[16px] leading-none ml-2 pb-0.5" style={{color:'var(--accent)'}}>{desc}</div>}
                          </div>
                        ) : (
                          <h2 className="font-serif italic text-[20px] leading-[1.15] mt-1" style={{color:'var(--ink)'}}>
                            {summaryWords || 'Reading your skin…'}
                          </h2>
                        )}
                        {/* AI ✦ (Frida) vs your gut — line up both readings so you
                            can see where intuition diverged from the photo read. */}
                        {aiFmt != null && userFmt != null && (
                          <div className="text-[10px] tracking-[0.18em] uppercase italic mt-1.5 flex items-center gap-2" style={{color:'var(--ink-soft)'}}>
                            <span><span style={{color:'var(--accent)'}}>✦</span> Frida {aiFmt}</span>
                            <span style={{opacity:0.5}}>·</span>
                            <span>You {userFmt}</span>
                            {Number(aiFmt) !== Number(userFmt) && (
                              <span style={{opacity:0.5, fontStyle:'italic'}}>{Math.abs(Number(aiFmt) - Number(userFmt)) >= 1.5 ? 'big gap' : 'close'}</span>
                            )}
                          </div>
                        )}
                        {/* User-only fallback (no AI yet) — shows their rating with subtle "you read" label */}
                        {aiFmt == null && userFmt != null && (
                          <div className="text-[10px] tracking-[0.18em] uppercase italic mt-1.5" style={{color:'var(--ink-soft)'}}>
                            You read · {userFmt}/10
                          </div>
                        )}
                        {summaryWords && aiFmt != null && (
                          <div className="text-[12px] italic mt-1" style={{color:'var(--ink-soft)'}}>{summaryWords}</div>
                        )}
                      </div>
                      {/* Inline X removed — sticky close lives at the top-right
                          of the drawer instead, more obvious + always reachable. */}
                    </div>
                  );
                })()}

                {/* Photo + trend chart side-by-side. Photo on the left with
                    its area + daypart caption directly underneath. User's
                    self-rating is INTENTIONALLY omitted here — this is the
                    AI's read of the photo, mixing in the user's 5/10
                    confused the comparison. Chart shrunk to half-size cute
                    infographic. */}
                <div className="flex items-start gap-3 mb-4">
                  <div className="flex-shrink-0">
                    <Photo item={log} alt="" className="w-24 h-24 object-cover rounded-[14px]"
                      renderFallback={() => <div className="w-24 h-24 rounded-[14px] flex items-center justify-center font-serif italic text-2xl" style={{background:'var(--cream-deep)', color:'var(--ink-soft)'}}>—</div>}
                    />
                    {/* Caption directly under the photo: area only — rating dropped. */}
                    <div className="text-[10px] tracking-[0.15em] uppercase mt-1.5 text-center leading-tight" style={{color:'var(--ink-soft)'}}>
                      {log.area?.replace(/-/g, ' ') || 'full face'}
                    </div>
                    {/* Daypart toggle — auto-tagged on upload, tap to override. */}
                    <button
                      onClick={() => {
                        const next = log.daypart === 'am' ? 'pm' : 'am';
                        setLogs(prev => {
                          const updated = prev.map(l => l.id === log.id ? { ...l, daypart: next } : l);
                          saveData('logs', updated);
                          return updated;
                        });
                      }}
                      className="mt-1.5 mx-auto block px-2 py-0.5 rounded-full text-[9px] tracking-[0.18em] uppercase italic transition hover:opacity-70"
                      style={{
                        background: log.daypart === 'pm' ? 'var(--ink)' : 'var(--cream-deep)',
                        color: log.daypart === 'pm' ? 'var(--cream)' : 'var(--ink)',
                        border: '1px solid var(--line)',
                      }}
                      aria-label="Toggle AM / PM"
                    >
                      {(log.daypart || 'am').toUpperCase()}
                    </button>
                  </div>
                  {/* Trend chart — small "cute infographic" 7-day spark.
                      Half the height of the previous version, no value labels,
                      no day-of-week axis — just the line + today's dot. */}
                  <div className="flex-1 min-w-0 rounded-[14px] px-3 py-2" style={{background:'var(--cream-deep)'}}>
                    <div className="flex items-baseline justify-between mb-1">
                      <Eyebrow>7-day trend</Eyebrow>
                      {breakoutN > 0 && (
                        <span className="text-[9px] italic" style={{color:'var(--ink-soft)'}}>
                          {breakoutN} breakout{breakoutN === 1 ? '' : 's'}
                        </span>
                      )}
                    </div>
                    {(() => {
                      // Real rating chart — X axis = day-of-week (S M T W T F S),
                      // Y axis = rating /10 (subtle min/max ticks). Uses a
                      // FIXED 0–100 domain so the line ACTUALLY rises and falls
                      // proportionally — auto-scaling to the local range was
                      // flattening the curve into a horizontal mess. Gentle,
                      // hairline gridlines + small dots per day. Today is the
                      // filled accent dot; other days are quiet hollow circles.
                      const chartW = 200, chartH = 70;
                      const padTop = 8, padBot = 14, padL = 12, padR = 6;
                      const innerW = chartW - padL - padR;
                      const innerH = chartH - padTop - padBot;
                      const validIdx = last7.map((v, i) => v == null ? null : i).filter(i => i != null);
                      if (validIdx.length === 0) {
                        return (
                          <div className="text-[10px] italic py-3 text-center" style={{color:'var(--ink-soft)'}}>
                            keep logging
                          </div>
                        );
                      }
                      // Use 0–100 domain so the visual range is meaningful.
                      // Sub-axis ticks at 25/50/75/100 mapped to /10 labels.
                      const xAt = (i) => padL + (i / 6) * innerW;
                      const yAt = (v) => padTop + innerH - (v / 100) * innerH;
                      const points = last7.map((v, i) => v == null ? null : { i, v, x: xAt(i), y: yAt(v) });
                      const pathPts = points.filter(Boolean);
                      const polyline = pathPts.map(p => `${p.x},${p.y}`).join(' ');
                      const firstV = pathPts[0]?.v;
                      const lastV = pathPts[pathPts.length - 1]?.v;
                      const delta = (firstV != null && lastV != null) ? Math.round((lastV - firstV) / 10 * 10) / 10 : null;
                      const dayLabels = last7.map((_, i) => {
                        const d = new Date(); d.setDate(d.getDate() - (6 - i));
                        return ['S','M','T','W','T','F','S'][d.getDay()];
                      });
                      return (
                        <>
                          <svg width="100%" viewBox={`0 0 ${chartW} ${chartH}`} preserveAspectRatio="none" style={{display:'block'}}>
                            {/* Subtle horizontal gridlines at 0, 5, 10 */}
                            {[0, 50, 100].map(v => (
                              <line key={v} x1={padL} y1={yAt(v)} x2={chartW - padR} y2={yAt(v)} stroke="var(--line)" strokeWidth="0.4" strokeDasharray={v === 50 ? "1.5,2" : ""} opacity={v === 50 ? 0.6 : 1} />
                            ))}
                            {/* Y-axis tick labels — quiet 5 / 10 markers */}
                            <text x={padL - 2} y={yAt(100) + 2.5} fontSize="6" fill="var(--ink-soft)" textAnchor="end" opacity="0.6">10</text>
                            <text x={padL - 2} y={yAt(50) + 2.5} fontSize="6" fill="var(--ink-soft)" textAnchor="end" opacity="0.6">5</text>
                            <text x={padL - 2} y={yAt(0) + 2.5} fontSize="6" fill="var(--ink-soft)" textAnchor="end" opacity="0.6">0</text>
                            {/* Polyline — soft accent stroke */}
                            {pathPts.length >= 2 && (
                              <polyline points={polyline} fill="none" stroke="var(--accent)" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round" opacity="0.85" />
                            )}
                            {/* Per-day dots — hollow for prior days, filled for today */}
                            {pathPts.map(p => (
                              <circle
                                key={p.i}
                                cx={p.x}
                                cy={p.y}
                                r={p.i === 6 ? 2.4 : 1.5}
                                fill={p.i === 6 ? 'var(--accent)' : 'var(--cream-deep)'}
                                stroke="var(--accent)"
                                strokeWidth={p.i === 6 ? 0 : 0.9}
                              />
                            ))}
                            {/* AI-score numeric labels — show /10 value above each
                                logged day so the user sees the actual numbers, not
                                just the line shape. Today's gets emphasis (bold,
                                slightly larger); others are quiet annotations. */}
                            {pathPts.map(p => {
                              const score = (p.v / 10).toFixed(1);
                              const isToday = p.i === 6;
                              const labelY = p.y - 3.5;
                              return (
                                <text
                                  key={`label-${p.i}`}
                                  x={p.x}
                                  y={labelY}
                                  fontSize={isToday ? "6.5" : "5.5"}
                                  fill={isToday ? 'var(--accent)' : 'var(--ink-soft)'}
                                  fontWeight={isToday ? "600" : "400"}
                                  textAnchor="middle"
                                  fontStyle="italic"
                                  opacity={isToday ? 1 : 0.65}
                                >{score}</text>
                              );
                            })}
                            {/* X-axis day labels */}
                            {dayLabels.map((d, i) => (
                              <text key={i} x={xAt(i)} y={chartH - 3} fontSize="6.5" fill="var(--ink-soft)" textAnchor="middle" opacity="0.7">{d}</text>
                            ))}
                          </svg>
                          {delta != null && (
                            <div className="text-[9px] italic mt-0.5 text-center flex items-center justify-center gap-1" style={{color: delta > 0 ? 'var(--accent)' : 'var(--ink-soft)'}}>
                              <span style={{color:'var(--accent)'}}>✦</span>
                              {delta > 0 ? `+${delta.toFixed(1)} this week` : delta < 0 ? `${delta.toFixed(1)} this week` : 'steady this week'}
                            </div>
                          )}
                        </>
                      );
                    })()}
                  </div>
                </div>

                {/* === 5-METRIC STRIP — same compact pattern as Today tab ===
                    Drops in below the photo+chart row to give a fast,
                    horizontal read of the per-metric scores from this snapshot. */}
                {snap && (() => {
                  const tiles = [
                    { key: 'hydration', label: 'Hydra',   icon: 'Droplet' },
                    { key: 'barrier',   label: 'Barrier', icon: 'Shield' },
                    { key: 'redness',   label: 'Redness', icon: 'Flame' },
                    { key: 'breakouts', label: 'Pores',   icon: 'Circle' },
                    { key: 'texture',   label: 'Texture', icon: 'Activity' },
                  ];
                  return (
                    <div className="rounded-[14px] px-2 py-3 mb-4" style={{background:'var(--cream-deep)', border: '1px solid var(--line)'}}>
                      <div className="grid grid-cols-5 gap-0.5">
                        {tiles.map(t => {
                          const v = SCORE_MAP[t.key]?.[titleCase(snap[t.key])];
                          const word = titleCase(snap[t.key]) || '—';
                          return (
                            <div key={t.key} className="flex flex-col items-center text-center min-w-0">
                              <Icon name={t.icon} size={11} style={{color:'var(--ink-soft)'}} />
                              <span className="text-[8.5px] tracking-[0.08em] uppercase mt-1 truncate w-full" style={{color:'var(--ink-soft)'}}>{t.label}</span>
                              <span className="font-serif italic text-[12px] leading-tight mt-1" style={{color: v != null && v >= 70 ? 'var(--ink)' : 'var(--ink-soft)'}}>{word}</span>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  );
                })()}

                {/* === FULL AI ANALYSIS — inline, no click required ===
                    Shows the complete dermatologist-voice prose (≤100 words from
                    the prompt). Falls back to a Generate/Try-again button when
                    the analysis hasn't been generated yet OR is stuck mid-call. */}
                <div className="rounded-[14px] px-4 py-3 mb-4" style={{background:'var(--cream-deep)', border: '1px solid var(--line)'}}>
                  <div className="text-[10px] tracking-[0.3em] uppercase mb-2 flex items-center gap-1.5" style={{color:'var(--ink-soft)'}}>
                    <Icon name="Sparkles" size={11} style={{color:'var(--accent)'}} /> Frida analysis
                  </div>
                  {/* While re-analyzing, hide the OLD analysis text entirely so the user
                      doesn't see the wordy previous version flash before the new bullets
                      arrive. Spinner-only state until the new analysis lands. */}
                  {retryingLogId === log.id ? (
                    <p className="font-serif italic text-[13px] flex items-center gap-2" style={{color:'var(--ink-soft)'}}>
                      <Icon name="Loader2" size={12} className="spin" style={{color:'var(--accent)'}} /> Reading your skin…
                    </p>
                  ) : log.aiAnalysis ? (
                    <>
                      <TaggedAnalysisBullets
                        text={formatAnalysisText(log.aiAnalysis)}
                        onOpen={setOpenLesson}
                        IconComponent={Icon}
                        withPearlsFn={withPearls}
                      />
                      {/* Subtle re-analyze affordance for users who want a fresh take. */}
                      {getApiKey() && (
                        <button
                          onClick={() => retryLogAnalysis(log.id)}
                          className="text-[10px] tracking-[0.18em] uppercase italic mt-2 flex items-center gap-1 transition hover:opacity-70"
                          style={{color:'var(--ink-soft)'}}
                        >
                          <Icon name="RefreshCw" size={10} /> Re-analyze
                        </button>
                      )}
                    </>
                  ) : !getApiKey() ? (
                    <button onClick={() => setShowApiKeyModal(true)} className="text-[11px] tracking-[0.18em] uppercase italic flex items-center gap-1.5 transition hover:opacity-70" style={{color:'var(--accent)'}}>
                      <Icon name="Key" size={11} /> Add API key to read this photo
                    </button>
                  ) : (
                    <button
                      onClick={() => retryLogAnalysis(log.id)}
                      className="text-[11px] tracking-[0.18em] uppercase italic flex items-center gap-1.5 transition hover:opacity-70"
                      style={{color:'var(--accent)'}}
                    >
                      <Icon name="Sparkles" size={11} /> Generate analysis
                    </button>
                  )}
                </div>

                {/* === FRIDA OBSERVED — quiet editorial delta line ===
                    Replaces the prior "Pattern delta" treatment. Same content
                    (vs-last-week metric shift) but in the editorial voice now
                    used across the rest of the app. */}
                <div className="px-1 mb-4">
                  <div className="flex items-center gap-1.5 mb-1.5" style={{color:'var(--accent)'}}>
                    <Icon name="Sparkles" size={11} />
                    <span className="text-[10px] tracking-[0.22em] uppercase">Frida observed</span>
                  </div>
                  <p className="font-serif italic text-[13px] leading-relaxed" style={{color:'var(--ink)'}}>{insightLine}</p>
                </div>

                {/* Footer actions — Edit fixes wrong date / area / notes;
                    Delete purges entries that got logged with the wrong day
                    (e.g. before the UTC date fix). Delete confirms first to
                    avoid accidental taps. */}
                <div className="flex items-center justify-between pt-3 border-t" style={{borderColor: 'var(--line)'}}>
                  <button
                    onClick={() => {
                      setSkinReadDrawerLogId(null);
                      openCheckInDetailsForLog(log);
                    }}
                    className="text-[10px] tracking-[0.18em] uppercase italic flex items-center gap-1.5 transition hover:opacity-70"
                    style={{color:'var(--ink-soft)'}}
                  >
                    <Icon name="Edit2" size={11} /> Edit entry
                  </button>
                  <button
                    onClick={() => {
                      const dateLabel = new Date(log.date + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                      if (window.confirm(`Delete this skin entry from ${dateLabel}? This can't be undone.`)) {
                        setSkinReadDrawerLogId(null);
                        deleteLog(log.id);
                        toast('Entry deleted', 'info');
                      }
                    }}
                    className="text-[10px] tracking-[0.18em] uppercase italic flex items-center gap-1.5 transition hover:opacity-70"
                    style={{color:'var(--rose, #c08a8a)'}}
                  >
                    <Icon name="Trash2" size={11} /> Delete
                  </button>
                </div>
              </div>
            </div>
          </div>
        );
      })()}

      {ritualSuggestSheet && (() => {
        const target = ritualSuggestSheet;
        const dateISO = target.dateISO;
        const date = new Date(dateISO + 'T00:00:00');
        const isTodayTarget = dateISO === localDateISO();
        // The actual API call runs in the App-level useEffect that watches
        // ritualSuggestToken. Bumping the token from anywhere triggers a fetch.
        const requestSuggestion = () => setRitualSuggestToken(t => t + 1);

        const toggleSel = (key) => {
          const next = new Set(ritualSuggestSelected);
          if (next.has(key)) next.delete(key); else next.add(key);
          setRitualSuggestSelected(next);
        };

        const applySelection = () => {
          if (!ritualSuggestion) return;
          // Look up any existing log for this day FIRST so we can MERGE into it
          // (not replace — that was the bug where saving twice wiped the first
          // batch). Existing amProducts / pmProducts are preserved; new selected
          // items append, deduped by id so re-saving the same suggestion is a
          // no-op rather than a duplicate.
          const existing = (regimenLogs || []).find(r => r.date === dateISO);
          const existingAm = [...(existing?.amProducts || [])];
          const existingPm = [...(existing?.pmProducts || [])];
          const amExtras = [...(existing?.amExtras || [])];
          const pmExtras = [...(existing?.pmExtras || [])];
          let addedCount = 0;
          let gapCount = 0;
          ritualSuggestion.am.forEach((it, i) => {
            if (!ritualSuggestSelected.has(`am-${i}`)) return;
            if (it.productId) {
              if (!existingAm.includes(it.productId)) { existingAm.push(it.productId); addedCount++; }
            } else if (it.name && !amExtras.includes(it.name)) {
              amExtras.push(it.name); gapCount++; addedCount++;
            } else { gapCount++; }
          });
          ritualSuggestion.pm.forEach((it, i) => {
            if (!ritualSuggestSelected.has(`pm-${i}`)) return;
            if (it.productId) {
              if (!existingPm.includes(it.productId)) { existingPm.push(it.productId); addedCount++; }
            } else if (it.name && !pmExtras.includes(it.name)) {
              pmExtras.push(it.name); gapCount++; addedCount++;
            } else { gapCount++; }
          });
          // Merge into the target day's regimenLog. Preserves all existing
          // metadata (devices, sleep, supplements, etc).
          const next = {
            id: existing?.id || Date.now(),
            date: dateISO,
            amProducts: existingAm,
            pmProducts: existingPm,
            amExtras: amExtras,
            pmExtras: pmExtras,
            devices: existing?.devices || [],
            sleep: existing?.sleep || '',
            supplements: existing?.supplements || [],
            hydration: existing?.hydration || false,
            sunscreenReapply: existing?.sunscreenReapply || false,
            notes: existing?.notes || '',
            submitted: true,
          };
          const newList = existing
            ? (regimenLogs || []).map(r => r.date === dateISO ? next : r)
            : [next, ...(regimenLogs || [])];
          setRegimenLogs(newList);
          saveData('regimenLogs', newList);
          setCoverRoutineRebuildToken(t => t + 1);
          const msg = addedCount === 0
            ? 'Already in your routine'
            : gapCount > 0
              ? `Added ${addedCount} · ${gapCount} need products added to your shelf`
              : `Added ${addedCount} step${addedCount === 1 ? '' : 's'} ✨`;
          toast(msg, 'success');
          // === STAY OPEN + REFRESH ===
          // Don't close the sheet — user often wants to add more in one pass.
          // Clear selection (Add-to-ritual visually "unchecks") and bump the
          // suggest token so a fresh batch generates. The new batch replaces
          // the just-added ones in the list naturally; if the AI re-suggests
          // anything already in the log, that's fine — applySelection's dedup
          // guards against duplicates on the next save.
          setRitualSuggestSelected(new Set());
          setRitualSuggestToken(t => t + 1);
        };

        const close = () => setRitualSuggestSheet(null);

        // === REFRESH ONLY UNSAVED ===
        // Bumps token to re-fetch — saved selections persist across the
        // refresh because we keep their keys in ritualSuggestSelected and
        // the new fetch only replaces unsaved slots. (Implementation: full
        // refetch is fine as long as saved keys are re-applied to whatever
        // matching items appear. For now we just re-fetch and the user
        // re-saves if they want. Later we can be smarter here.)
        const refreshIdeas = () => requestSuggestion();

        // Compact suggestion row — status dot · bottle outline · name · 1-line
        // why · single concern chip · Select pill OR ✓ check. Selected rows
        // float to the top of their AM/PM section (handled in render below);
        // we still pass `origIdx` so the slot key (`am-0`, `pm-2`, ...) tracks
        // the original suggestion array — applySelection iterates by index.
        const renderSuggestRow = (slot, item, origIdx, isLast) => {
          const key = `${slot}-${origIdx}`;
          const checked = ritualSuggestSelected.has(key);
          const shelfProduct = item.productId ? (products || []).find(p => p.id === item.productId) : null;
          // Brand-first display per Jenni: when the suggestion matches a shelf
          // product, lead with the BRAND; product name slides into the subtitle
          // line. Falls back to the suggestion's raw name for gap suggestions
          // (no shelf match — AI proposing a generic category like "Gentle cleanser").
          const displayName = shelfProduct ? (shelfProduct.brand || shelfProduct.name) : item.name;
          const subtitle = item.why || (shelfProduct
            ? [shelfProduct.brand && shelfProduct.name && shelfProduct.brand !== shelfProduct.name ? shelfProduct.name : null, shelfProduct.category]
                .filter(Boolean).join(' · ')
            : (item.category || ''));
          const concern = (shelfProduct?.concerns?.[0]) || (item.concern) || (item.category || null);
          const onShelf = !!shelfProduct;
          return (
            <div
              key={key}
              role="button"
              tabIndex={0}
              onClick={() => toggleSel(key)}
              onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleSel(key); } }}
              className="flex items-center gap-2.5 py-2 px-1 -mx-1 rounded-[8px] transition cursor-pointer"
              style={{
                borderBottom: isLast ? 'none' : '1px solid var(--line)',
                background: checked ? 'var(--accent-soft, #FCE8EE)' : 'transparent',
                cursor: 'pointer',
              }}
              aria-pressed={checked}
            >
              {/* Status marker — ● if on shelf (filled muted dot), ✦ if not */}
              <div className="w-4 flex items-center justify-center flex-shrink-0">
                {onShelf ? (
                  <span className="block w-2 h-2 rounded-full" style={{background:'var(--ink-soft)'}} title="On your shelf" />
                ) : (
                  <span style={{color:'var(--accent)', fontSize:'13px', lineHeight:1}} title="Suggested — not on your shelf">✦</span>
                )}
              </div>
              {/* Bottle outline silhouette — uses the shared dotted bottle icon */}
              <div className="w-8 h-12 flex items-center justify-center flex-shrink-0" style={{color:'var(--ink-soft)'}}>
                <DashedBottleOutline />
              </div>
              {/* Name + 1-line why + 1 concern chip */}
              <div className="flex-1 min-w-0">
                <div className="font-serif italic text-[13px] leading-tight truncate" style={{color:'var(--ink)'}} title={displayName}>
                  {displayName}
                </div>
                {subtitle && (
                  <div className="text-[10.5px] mt-0.5 truncate" style={{color:'var(--ink-soft)'}} title={subtitle}>{subtitle}</div>
                )}
                {concern && (
                  <div className="mt-1">
                    <span className="text-[9px] tracking-[0.05em] px-2 py-0.5 rounded-full inline-block" style={{border:'1px solid var(--accent)', color:'var(--accent)', background:'transparent'}}>
                      {String(concern).replace(/-/g, ' ')}
                    </span>
                  </div>
                )}
              </div>
              {/* Right affordance — Select pill (unselected) OR check glyph only (selected).
                  Stop propagation so the inner button click doesn't double-fire the row's
                  onClick (which already toggles). Both still toggle the same key. */}
              {checked ? (
                <button
                  onClick={(e) => { e.stopPropagation(); toggleSel(key); }}
                  className="flex-shrink-0 w-8 h-8 flex items-center justify-center transition hover:opacity-90 cursor-pointer"
                  style={{color:'var(--accent)', cursor:'pointer'}}
                  title="Selected — tap to deselect"
                  aria-label="Deselect"
                >
                  <Icon name="Check" size={18} />
                </button>
              ) : (
                <button
                  onClick={(e) => { e.stopPropagation(); toggleSel(key); }}
                  className="flex-shrink-0 rounded-full px-3 py-1 text-[10px] tracking-[0.15em] uppercase transition hover:opacity-90 border cursor-pointer"
                  style={{background:'transparent', color:'var(--accent)', borderColor: 'var(--line)', cursor:'pointer'}}
                >
                  Select
                </button>
              )}
            </div>
          );
        };

        // Sort helper — selected items float to the top of their section,
        // preserving original index/key so applySelection still works.
        const sortBySelected = (slot, list) => {
          if (!Array.isArray(list)) return [];
          return list
            .map((item, origIdx) => ({ item, origIdx }))
            .sort((a, b) => {
              const aSel = ritualSuggestSelected.has(`${slot}-${a.origIdx}`) ? 1 : 0;
              const bSel = ritualSuggestSelected.has(`${slot}-${b.origIdx}`) ? 1 : 0;
              return bSel - aSel; // selected first
            });
        };

        return (
          <div
            className="fixed inset-0 z-50 flex items-end md:items-center justify-center"
            style={{background:'rgba(28,25,23,0.55)', backdropFilter:'blur(6px)', animation:'fadeIn 220ms ease-out'}}
            onClick={close}
          >
            <div
              onClick={e => e.stopPropagation()}
              className="mobile-full-sheet rounded-t-[24px] md:rounded-[24px] w-full md:max-w-md overflow-y-auto"
              style={{background:'var(--cream)', animation:'slide 320ms cubic-bezier(0.2, 0.9, 0.3, 1)'}}
            >
              {/* Header — sparkle + serif title left, X close right.
                  Search icon dropped per latest spec; the surface is short
                  enough now that browsing > searching. */}
              <div className="px-4 md:px-6 pt-4 pb-3 flex items-center justify-between gap-3">
                <div className="flex items-center gap-2 min-w-0">
                  <Icon name="Sparkles" size={20} style={{color:'var(--accent)', flexShrink:0}} />
                  <h2 className="font-serif italic text-[22px] md:text-[24px] leading-[1.1] truncate" style={{color:'var(--ink)'}}>
                    Frida suggests
                  </h2>
                </div>
                <button
                  onClick={close}
                  className="w-8 h-8 rounded-full flex items-center justify-center transition hover:opacity-80 cursor-pointer flex-shrink-0"
                  style={{color:'var(--ink)', cursor:'pointer'}}
                  aria-label="Close"
                >
                  <Icon name="X" size={18} />
                </button>
              </div>

              <div className="px-4 md:px-6 pb-6">
                {/* === LOADING STATE ===
                    Two lines: a live status ("Reading your shelf and recent
                    skin reads…") above, and a quieter italic helper
                    explaining what's actually happening behind the scenes
                    ("Frida learns from your log..."). The helper used to
                    live as a static card on the ritual surface — moved here
                    so it has meaning at the moment personalization is
                    actively happening, not as ambient marketing copy. */}
                {ritualSuggestLoading && (
                  <div className="flex flex-col items-center gap-2 py-12 px-4 text-center" style={{color:'var(--ink-soft)'}}>
                    <div className="flex items-center gap-2">
                      <Icon name="Loader2" size={14} className="spin" />
                      <span className="text-[12px] pulse-soft">Reading your shelf and recent skin reads…</span>
                    </div>
                    <p className="text-[10.5px] mt-1 max-w-[300px]" style={{color:'var(--ink-soft)', opacity:0.75}}>
                      <span style={{color:'var(--ink)', fontWeight:500}}>Frida</span> learns from your log to personalize recommendations.
                    </p>
                  </div>
                )}

                {ritualSuggestError && !ritualSuggestLoading && (
                  <div className="rounded-[14px] px-4 py-3 mb-4" style={{background:'var(--cream-deep)', border:'1px solid var(--rose, #c08a8a)'}}>
                    <div className="text-[10px] tracking-[0.2em] uppercase mb-1" style={{color:'var(--accent)'}}>Suggestion failed</div>
                    <p className="text-[12px] italic" style={{color:'var(--ink-soft)'}}>{ritualSuggestError}</p>
                    <button
                      onClick={requestSuggestion}
                      className="mt-2 text-[10.5px] tracking-[0.18em] uppercase italic flex items-center gap-1 cursor-pointer"
                      style={{color:'var(--accent)', cursor:'pointer'}}
                    >
                      <Icon name="RefreshCw" size={11} /> Try again
                    </button>
                  </div>
                )}

                {ritualSuggestion && !ritualSuggestLoading && (() => {
                  const selCount = ritualSuggestSelected.size;
                  const hasSel = selCount > 0;
                  return (
                  <>
                    {/* Metadata row — left: count + legend caption; right:
                        terracotta "Add to ritual" pill (softened to caption
                        when 0 selected so it doesn't beg for a tap). */}
                    <div className="flex items-center justify-between gap-3 mb-3 pb-3 border-b" style={{borderColor: 'var(--line)'}}>
                      <div className="text-[11px] flex items-center gap-1.5 flex-wrap min-w-0" style={{color:'var(--ink-soft)'}}>
                        <span style={{color: hasSel ? 'var(--accent)' : 'var(--ink-soft)'}}>{selCount} selected</span>
                        <span style={{color:'var(--ink-soft)'}}>·</span>
                        <span style={{color:'var(--accent)'}}>✦</span>
                        <span>suggested</span>
                        <span style={{color:'var(--ink-soft)'}}>·</span>
                        <span className="inline-block w-1.5 h-1.5 rounded-full" style={{background:'var(--ink-soft)'}} />
                        <span>on shelf</span>
                      </div>
                      <button
                        onClick={applySelection}
                        disabled={!hasSel}
                        className="rounded-full px-4 py-2 text-[11px] tracking-[0.04em] flex items-center gap-1.5 transition hover:opacity-90 cursor-pointer flex-shrink-0 border"
                        style={{
                          background: hasSel ? 'var(--accent)' : 'transparent',
                          color: hasSel ? 'var(--cream)' : 'var(--accent)',
                          borderColor: 'var(--line)',
                          opacity: hasSel ? 1 : 0.6,
                          cursor: hasSel ? 'pointer' : 'not-allowed',
                        }}
                      >
                        Add to ritual <Icon name="ArrowRight" size={13} />
                      </button>
                    </div>

                    {/* AM section */}
                    <div className="mb-3">
                      <div className="flex items-center justify-between mb-1">
                        <div className="flex items-center gap-2">
                          <Icon name="Sun" size={14} style={{color:'var(--accent)'}} />
                          <div className="font-serif italic text-[15px] leading-tight" style={{color:'var(--ink)'}}>AM</div>
                        </div>
                        <button
                          onClick={refreshIdeas}
                          className="text-[10px] tracking-[0.05em] flex items-center gap-1 transition hover:opacity-80 cursor-pointer"
                          style={{color:'var(--accent)', cursor:'pointer'}}
                          title="Refresh AM ideas"
                        >
                          <Icon name="RefreshCw" size={11} /> New ideas
                        </button>
                      </div>
                      {ritualSuggestion.am && ritualSuggestion.am.length > 0 ? (
                        <div>
                          {sortBySelected('am', ritualSuggestion.am.slice(0, 3))
                            .map(({ item, origIdx }, i, arr) => renderSuggestRow('am', item, origIdx, i === arr.length - 1))}
                        </div>
                      ) : (
                        <p className="text-[11px] italic py-3 text-center" style={{color:'var(--ink-soft)'}}>No AM suggestions.</p>
                      )}
                    </div>

                    {/* PM section */}
                    <div className="mb-1">
                      <div className="flex items-center justify-between mb-1">
                        <div className="flex items-center gap-2">
                          <Icon name="Moon" size={14} style={{color:'var(--accent)'}} />
                          <div className="font-serif italic text-[15px] leading-tight" style={{color:'var(--ink)'}}>PM</div>
                        </div>
                        <button
                          onClick={refreshIdeas}
                          className="text-[10px] tracking-[0.05em] flex items-center gap-1 transition hover:opacity-80 cursor-pointer"
                          style={{color:'var(--accent)', cursor:'pointer'}}
                          title="Refresh PM ideas"
                        >
                          <Icon name="RefreshCw" size={11} /> New ideas
                        </button>
                      </div>
                      {ritualSuggestion.pm && ritualSuggestion.pm.length > 0 ? (
                        <div>
                          {sortBySelected('pm', ritualSuggestion.pm.slice(0, 3))
                            .map(({ item, origIdx }, i, arr) => renderSuggestRow('pm', item, origIdx, i === arr.length - 1))}
                        </div>
                      ) : (
                        <p className="text-[11px] italic py-3 text-center" style={{color:'var(--ink-soft)'}}>No PM suggestions.</p>
                      )}
                    </div>
                  </>
                  );
                })()}
              </div>
            </div>
          </div>
        );
      })()}

      {showEventModal && (
        <EventModal
          events={events}
          setEvents={setEvents}
          logs={logs}
          products={products}
          regimenLogs={regimenLogs}
          callClaude={callClaude}
          saveData={saveData}
          toast={toast}
          setShowEventModal={setShowEventModal}
          modalScrollMemo={modalScrollMemo}
          useModalScrollPreserve={useModalScrollPreserve}
          setOpenLesson={setOpenLesson}
          getActualUsage={getActualUsage}
          formatUsageForPrompt={formatUsageForPrompt}
          withPearls={withPearls}
          getApiKey={getApiKey}
        />
      )}
      {showColorModal && (
        <ColorModal
          colorProfile={colorProfile}
          setColorProfile={setColorProfile}
          setShowColorModal={setShowColorModal}
          setShowApiKeyModal={setShowApiKeyModal}
          callClaude={callClaude}
          getApiKey={getApiKey}
          fileToBase64={fileToBase64}
          saveData={saveData}
          toast={toast}
          useModalScrollPreserve={useModalScrollPreserve}
          user={user}
          uploadPhotoToStorage={uploadPhotoToStorage}
          modalScrollMemo={modalScrollMemo}
          openChat={typeof openChat === 'function' ? openChat : undefined}
        />
      )}
      {showApiKeyModal && (
        <ApiKeyModal
          setApiKeyState={setApiKeyState}
          setShowApiKeyModal={setShowApiKeyModal}
          setShowApiKeyModalRaw={setShowApiKeyModalRaw}
          clearApiKeyDismissal={clearApiKeyDismissal}
          toast={toast}
        />
      )}
      {showSupabaseModal && (
        <SupabaseModal
          user={user}
          setUser={setUser}
          supaEnabled={supaEnabled}
          setShowSupabaseModal={setShowSupabaseModal}
          setLogs={setLogs}
          setProducts={setProducts}
          setProcedures={setProcedures}
          setEvents={setEvents}
          setColorProfile={setColorProfile}
          setPatternInsight={setPatternInsight}
          setCycleData={setCycleData}
          setHormonalContext={setHormonalContext}
          setSensitivities={setSensitivities}
          setRegimenLogs={setRegimenLogs}
          setUserConcerns={setUserConcerns}
          setCoverRoutine={setCoverRoutine}
          setCounselInsights={setCounselInsights}
          setDailyCoverPick={setDailyCoverPick}
          setWeeklyInsights={setWeeklyInsights}
          toast={toast}
        />
      )}
      {showYouModal && <YouModal />}
      {/* Sunday Digest modal — gated render; the modal itself early-
          returns null when open === false but we still gate to avoid
          building the digest data when it's not needed. */}
      {showSundayDigest && (
        <SundayDigestModal
          open={showSundayDigest}
          onClose={() => setShowSundayDigest(false)}
          logs={logs}
          regimenLogs={regimenLogs}
          products={products}
          toast={toast}
        />
      )}
      {showProfileModal && (
        <ProfileModal
          profileWizardForm={profileWizardForm}
          setProfileWizardForm={setProfileWizardForm}
          profileWizardStep={profileWizardStep}
          setProfileWizardStep={setProfileWizardStep}
          profileTonePhoto={profileTonePhoto}
          setProfileTonePhoto={setProfileTonePhoto}
          profileTonePhotoSource={profileTonePhotoSource}
          setProfileTonePhotoSource={setProfileTonePhotoSource}
          profileToneSuggestion={profileToneSuggestion}
          setProfileToneSuggestion={setProfileToneSuggestion}
          profileToneSuggesting={profileToneSuggesting}
          setProfileToneSuggesting={setProfileToneSuggesting}
          profileToneError={profileToneError}
          setProfileToneError={setProfileToneError}
          profileAiSummary={profileAiSummary}
          setProfileAiSummary={setProfileAiSummary}
          profileSummaryLoading={profileSummaryLoading}
          setProfileSummaryLoading={setProfileSummaryLoading}
          userProfile={userProfile}
          setUserProfile={setUserProfile}
          logs={logs}
          hormonalContext={hormonalContext}
          setHormonalContext={setHormonalContext}
          sensitivities={sensitivities}
          setSensitivities={setSensitivities}
          callClaude={callClaude}
          callGeminiVision={callGeminiVision}
          fetchPhotoAsBase64={fetchPhotoAsBase64}
          getApiKey={getApiKey}
          toast={toast}
          saveData={saveData}
          setShowProfileModal={setShowProfileModal}
          DEFAULT_USER_PROFILE={DEFAULT_USER_PROFILE}
          onOpenScoreExplainer={() => setShowScoreExplainer(true)}
        />
      )}

      {/* === SCORE EXPLAINER (June 2026 per Jenni) ===
          Single source of truth for "what does this 8.4 actually mean?"
          Opens from cover delta line, cover kebab "How your score works",
          ProfileModal Settings link, and the first-time auto-show. */}
      {showScoreExplainer && (() => {
        const todayKey = localDateISO();
        const todayLog = (logs || []).find(l => l.date === todayKey);
        const goalKey = userProfile?.actionGoal || 'MAINTENANCE';
        const baseline = computeBaseline(logs || [], goalKey);
        const dismiss = () => {
          setShowScoreExplainer(false);
          if (!scoreExplainerSeen) setScoreExplainerSeen(true);
        };
        return (
          <ScoreExplainerModal
            onClose={dismiss}
            baseline={baseline}
            goal={goalKey}
          />
        );
      })()}

      {/* === TRAVEL SETUP MODAL (June 2026 — Phase 1) === */}
      {showTravelSetupModal && (
        <TravelSetupModal
          userProfile={userProfile}
          setUserProfile={setUserProfile}
          products={products}
          saveData={saveData}
          toast={toast}
          onClose={() => setShowTravelSetupModal(false)}
        />
      )}

      {/* === WELCOME BACK PROMPT (June 2026 per Jenni — Phase 1) ===
          Top banner after travel mode auto-flips off. Asks how the trip
          went; tap routes to a check-in. Auto-dismisses after 12s. Once
          dismissed, persists a seen flag so we don't re-prompt. */}
      {welcomeBackPrompt && (
        <div className="fixed top-4 left-1/2 z-40 px-3 max-w-md w-full" style={{transform:'translateX(-50%)'}}>
          <div
            className="rounded-[14px] shadow-lg flex items-center gap-2 px-3 py-2 flex-wrap"
            style={{background:'var(--cream)', border:'1px solid var(--accent-blue)'}}
          >
            <span className="text-[10px] tracking-[0.2em] uppercase flex items-center gap-1.5 flex-1 min-w-0" style={{color:'var(--ink-soft)'}}>
              <span style={{color:'var(--accent-blue)'}}>✈</span>
              <span className="truncate" style={{color:'var(--ink)', fontWeight:600, letterSpacing:'0.05em'}}>
                Welcome back · how'd {welcomeBackPrompt.destination} go?
              </span>
            </span>
            <div className="flex gap-1.5 flex-shrink-0">
              <button
                type="button"
                onClick={() => {
                  try { localStorage.setItem(welcomeBackPrompt.seenKey, '1'); } catch {}
                  setWelcomeBackPrompt(null);
                  setShowCheckInChooser && setShowCheckInChooser(true);
                }}
                className="text-[10px] tracking-[0.18em] uppercase px-3 py-1.5 rounded-full transition hover:opacity-90"
                style={{background:'var(--accent-blue)', color:'var(--cream)', fontWeight:600, cursor:'pointer'}}
              >
                Check in
              </button>
              <button
                type="button"
                onClick={() => {
                  try { localStorage.setItem(welcomeBackPrompt.seenKey, '1'); } catch {}
                  setWelcomeBackPrompt(null);
                }}
                className="text-[10px] tracking-[0.18em] uppercase px-2 py-1.5 transition hover:opacity-70"
                style={{color:'var(--ink-soft)', fontWeight:600, cursor:'pointer'}}
              >
                Later
              </button>
            </div>
          </div>
        </div>
      )}

      {/* === FRIDA FORMULARY — SUGGESTED MATCHES DRAWER ===
          Bottom sheet on mobile, right drawer on desktop.
          Surfaces products from POPULAR_PRODUCTS scored against the user's
          current metric profile. Five filter categories: All / Repair /
          Calm / Hydrate / Brighten. Compact rows per Jenni's brief —
          fit-tag (FOR YOUR BARRIER, etc.) instead of LUXURY/SMART. */}
      {/* === ADD TO RITUAL SHEET ===
          Single bottom sheet that replaces the prior multi-step "+ Add
          product" chooser. Three sections (Suggested Next, Recently Used,
          Your Products), tap-anywhere-to-add, "Add & keep browsing"
          toggle, sticky Cancel. Per Jenni's spec — Spotify playlist picker
          / Apple Health add-flow / Notion sheet aesthetic. */}
      {addRitualSheet && (() => {
        const slotContext = addRitualSheet.slot || (() => {
          // Auto-detect AM/PM by current local hour if not specified.
          const h = new Date().getHours();
          return h < 14 ? 'am' : 'pm';
        })();
        const todayKey = localDateISO();
        const todayLog = (regimenLogs || []).find(r => r.date === todayKey);
        const todayIds = todayLog
          ? new Set([...(todayLog.amProducts || []), ...(todayLog.pmProducts || [])])
          : new Set();
        const activeShelf = (products || []).filter(p => !p.endDate);

        // === SUGGESTED NEXT ===
        // AM → favor SPF, antioxidants (vit C), hydration.
        // PM → favor retinoids, barrier, richer moisturizers.
        // Filter by what's NOT already in today's regimen + matches context.
        const isAMRelevant = (p) => {
          const hay = `${p.activeIngredients || ''} ${p.actives || ''} ${(p.tags || []).join(' ')} ${p.category || ''} ${p.name || ''}`.toLowerCase();
          return /spf|sunscreen|titanium|zinc ox|vitamin c|ascorb|niacinamide|hyaluronic|antioxidant/.test(hay);
        };
        const isPMRelevant = (p) => {
          const hay = `${p.activeIngredients || ''} ${p.actives || ''} ${(p.tags || []).join(' ')} ${p.category || ''} ${p.name || ''}`.toLowerCase();
          return /retinol|tretinoin|retinaldehyde|adapalene|tazarotene|ceramide|barrier|peptide|squalane|rich cream|night cream|repair/.test(hay);
        };
        const isRelevant = slotContext === 'am' ? isAMRelevant : isPMRelevant;
        // Deterministic shuffle keyed on addRitualSuggestSeed — same seed
        // produces same order, refresh icon bumps the seed to reshuffle.
        // Mulberry-style fast hash, no dependencies.
        const seedShuffle = (arr, seed) => {
          if (!arr.length) return arr;
          const out = [...arr];
          let s = seed | 0;
          for (let i = out.length - 1; i > 0; i--) {
            s = (s * 1103515245 + 12345) & 0x7fffffff;
            const j = s % (i + 1);
            [out[i], out[j]] = [out[j], out[i]];
          }
          return out;
        };
        const suggestedPool = activeShelf
          .filter(p => !todayIds.has(p.id))
          .filter(isRelevant);
        const suggestedNext = seedShuffle(suggestedPool, addRitualSuggestSeed).slice(0, 3);

        // === RECENTLY USED ===
        // Products that appeared in the user's regimenLogs over the past 7 days.
        const sevenDaysAgo = (() => { const d = new Date(); d.setDate(d.getDate() - 7); return localDateISO(d); })();
        const recentUsageMap = {}; // productId → { lastUsed: iso, count }
        (regimenLogs || []).forEach(r => {
          if (r.date < sevenDaysAgo || r.date > todayKey) return;
          [...(r.amProducts || []), ...(r.pmProducts || [])].forEach(pid => {
            if (!recentUsageMap[pid]) recentUsageMap[pid] = { lastUsed: r.date, count: 0 };
            if (r.date > recentUsageMap[pid].lastUsed) recentUsageMap[pid].lastUsed = r.date;
            recentUsageMap[pid].count++;
          });
        });
        const recentlyUsed = activeShelf
          .filter(p => recentUsageMap[p.id])
          .filter(p => !todayIds.has(p.id))
          .map(p => ({ ...p, _usage: recentUsageMap[p.id] }))
          .sort((a, b) => b._usage.lastUsed.localeCompare(a._usage.lastUsed))
          .slice(0, 5);
        const usedLabel = (iso) => {
          if (iso === todayKey) return 'Used today';
          const yKey = (() => { const d = new Date(); d.setDate(d.getDate() - 1); return localDateISO(d); })();
          if (iso === yKey) return 'Used yesterday';
          const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
          if (days < 7) return `Used ${days} days ago`;
          return 'Used this week';
        };

        // === YOUR PRODUCTS (full shelf, search-filtered) ===
        const search = (addRitualSearch || '').trim().toLowerCase();
        const matchesSearch = (p) => {
          if (!search) return true;
          const hay = `${p.name || ''} ${p.brand || ''} ${p.activeIngredients || ''} ${p.actives || ''} ${(p.tags || []).join(' ')}`.toLowerCase();
          return search.split(/\s+/).every(t => hay.includes(t));
        };
        const yourProducts = activeShelf
          .filter(p => !todayIds.has(p.id))
          .filter(matchesSearch);

        const compactTags = (p) => {
          const t = [];
          if (p.category) t.push(p.category[0].toUpperCase() + p.category.slice(1));
          const acts = (p.activeIngredients || p.actives || '').split(',').map(s => s.trim()).filter(Boolean).slice(0, 2);
          acts.forEach(a => t.push(a.replace(/\s*\d+\.?\d*%?\s*$/, '')));
          if ((p.useTimes || []).includes('AM')) t.push('AM');
          if ((p.useTimes || []).includes('PM')) t.push('PM');
          return t.slice(0, 3).join(' · ');
        };

        // === ADD action ===
        // Adds the product to today's regimen log under the right slot.
        // Creates the log if it doesn't exist. Toasts on success so the
        // user sees the add land (previously silent → felt like the tap
        // didn't register). Closes the sheet unless "Add & keep
        // browsing" is on.
        const addToToday = (p) => {
          const slotKey = slotContext === 'pm' ? 'pmProducts' : 'amProducts';
          const existing = (regimenLogs || []).find(r => r.date === todayKey);
          if (existing && (existing[slotKey] || []).includes(p.id)) {
            toast(`${p.name} already in ${slotContext.toUpperCase()}`, 'info');
            return;
          }
          // === CONFLICT CHECK (May 2026) ===
          // Resolve the slot's current shelf products before commit. If the
          // incoming product collides on a HARD-tier active family with
          // anything already in the slot, route through setPendingConflict
          // so the user gets a snarky T&G prompt with explicit Override.
          const slotIds = (existing?.[slotKey]) || [];
          const slotShelfProducts = slotIds.map(id => (products || []).find(p2 => p2.id === id)).filter(Boolean);
          const conflict = detectAddConflict(p, slotShelfProducts);
          const doCommit = () => {
            let next;
            if (existing) {
              next = (regimenLogs || []).map(r => r.date === todayKey ? {
                ...r,
                [slotKey]: [...(r[slotKey] || []), p.id],
                submitted: true,
              } : r);
            } else {
              next = [{
                id: Date.now(),
                date: todayKey,
                amProducts: slotContext === 'am' ? [p.id] : [],
                pmProducts: slotContext === 'pm' ? [p.id] : [],
                amExtras: [],
                pmExtras: [],
                devices: [],
                sleep: '',
                supplements: [],
                hydration: false,
                sunscreenReapply: false,
                notes: '',
                submitted: true,
              }, ...(regimenLogs || [])];
            }
            setRegimenLogs(next);
            saveData('regimenLogs', next);
            setCoverRoutineRebuildToken(t => t + 1);
            toast(`Added to ${slotContext.toUpperCase()}`, 'info');
            if (!addRitualKeepOpen) setAddRitualSheet(null);
          };
          if (conflict) {
            setPendingConflict({
              product: p,
              slot: slotContext,
              conflictWith: conflict.conflictWith,
              note: conflict.note,
              commit: doCommit,
            });
            return;
          }
          doCommit();
        };

        // Clean text-only rows per Jenni's reference — no thumbnails.
        // Suggested + Recent rows show the [+] add button; Your Products
        // rows show a [›] chevron (tap to expand or open detail in a
        // future iteration; tap on row body still adds for now).
        const Row = ({ p, meta, action = 'add' }) => {
          const tags = compactTags(p);
          return (
            <button
              onClick={() => addToToday(p)}
              className="w-full text-left flex items-center gap-3 px-3 py-2.5 transition hover:bg-[var(--cream-deep)] rounded-[10px]"
            >
              <div className="flex-1 min-w-0">
                <div className="text-[13.5px] leading-tight truncate" style={{color:'var(--ink)'}}>{p.name}</div>
                <div className="text-[10.5px] mt-0.5 truncate" style={{color:'var(--ink-soft)'}}>{tags}{meta ? ` · ${meta}` : ''}</div>
              </div>
              {action === 'chevron' ? (
                <Icon name="ChevronRight" size={14} style={{color:'var(--ink-soft)', flexShrink:0}} />
              ) : (
                <div className="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center transition" style={{border: '1px solid var(--line)', color:'var(--accent)'}}>
                  <Icon name="Plus" size={14} />
                </div>
              )}
            </button>
          );
        };

        const SectionHeader2 = ({ icon, label, count, onSeeAll }) => (
          <div className="flex items-center justify-between mt-4 mb-1.5 px-3">
            <div className="flex items-center gap-1.5">
              <Icon name={icon} size={11} style={{color:'var(--accent)'}} />
              <span className="text-[10px] tracking-[0.22em] uppercase" style={{color:'var(--ink-soft)'}}>{label}</span>
              {count > 0 && <span className="text-[10px] italic" style={{color:'var(--ink-soft)'}}>({count})</span>}
            </div>
            {onSeeAll && (
              <button onClick={onSeeAll} className="text-[10px] tracking-[0.22em] uppercase italic" style={{color:'var(--accent)'}}>See all</button>
            )}
          </div>
        );

        return (
          <>
            <div
              onClick={() => setAddRitualSheet(null)}
              className="fixed inset-0 z-[60]"
              style={{background:'rgba(42,37,32,0.32)', backdropFilter:'blur(2px)'}}
            />
            <div
              className="fixed z-[70] flex flex-col bottom-0 left-0 right-0 h-[80vh] max-h-[88vh] rounded-t-[24px] md:rounded-[20px] md:bottom-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 md:max-w-[440px] md:h-auto md:max-h-[80vh] md:min-h-[60vh]"
              style={{background:'var(--cream)', boxShadow:'0 -16px 48px -8px rgba(42,37,32,0.18)', border: '1px solid var(--line)'}}
              role="dialog"
              aria-label="Add product to regimen"
            >
              {/* Drag affordance */}
              <div className="md:hidden flex justify-center pt-2.5 pb-1">
                <div style={{width:'40px', height:'4px', borderRadius:'2px', background:'var(--line)'}} />
              </div>

              {/* Header */}
              <div className="flex items-center justify-between px-4 pt-3 pb-3 flex-shrink-0">
                <div className="font-serif italic text-[20px] leading-tight flex items-center gap-1.5" style={{color:'var(--ink)'}}><Icon name="Plus" size={16} style={{color:'var(--accent)'}} /> Product</div>
                <button
                  onClick={() => setAddRitualSheet(null)}
                  className="w-8 h-8 rounded-full flex items-center justify-center transition hover:bg-[var(--cream-deep)]"
                  style={{color:'var(--ink-soft)'}}
                  aria-label="Close"
                ><Icon name="X" size={14} /></button>
              </div>

              {/* Search — uses LocalSearchInput (module-scope, owns its own
                  state, debounces commit to App state) so every keystroke
                  renders ONLY the input, not the entire addRitualSheet IIFE
                  with its filter computations. Previously every letter
                  triggered an App re-render → felt like the keyboard froze
                  between letters. With debounceMs=140, the list updates
                  smoothly after the user pauses typing. */}
              <div className="px-4 pb-2 flex-shrink-0">
                <div className="flex items-center gap-2 pl-3 pr-2 py-2 rounded-full" style={{background:'var(--cream-deep)', border: '1px solid var(--line)'}}>
                  <Icon name="Search" size={13} style={{color:'var(--ink-soft)'}} />
                  <LocalSearchInput
                    initial={addRitualSearch}
                    placeholder="Search products, brands, ingredients…"
                    className="flex-1 bg-transparent border-0 focus:outline-none text-[12.5px] italic"
                    style={{color:'var(--ink)'}}
                    debounceMs={140}
                    onCommit={(v) => setAddRitualSearch(v)}
                  />
                  <Icon name="SlidersHorizontal" size={13} style={{color:'var(--ink-soft)', flexShrink:0}} />
                </div>
              </div>

              {/* Scrollable list */}
              <div className="flex-1 overflow-y-auto px-1 pb-4">
                {!search && suggestedNext.length > 0 && (
                  <>
                    {/* Suggested Next header — refresh icon (reshuffles the
                        ranked list with a new seed). "Why these?" removed
                        per spec; refresh is the only affordance. */}
                    <div className="flex items-center justify-between mt-4 mb-1.5 px-3">
                      <div className="flex items-center gap-1.5">
                        <Icon name="Sparkles" size={11} style={{color:'var(--accent)'}} />
                        <span className="text-[10px] tracking-[0.22em] uppercase" style={{color:'var(--ink-soft)'}}>Suggested next</span>
                        <span className="text-[10px] italic" style={{color:'var(--ink-soft)'}}>({suggestedNext.length})</span>
                      </div>
                      <button
                        onClick={() => setAddRitualSuggestSeed(s => s + 1)}
                        className="w-7 h-7 rounded-full flex items-center justify-center transition hover:bg-[var(--cream-deep)] cursor-pointer"
                        style={{color:'var(--accent)', cursor:'pointer'}}
                        title="Reshuffle suggestions"
                        aria-label="Refresh suggestions"
                      >
                        <Icon name="RefreshCw" size={12} />
                      </button>
                    </div>
                    <div className="space-y-0.5">{suggestedNext.map(p => <Row key={p.id} p={p} />)}</div>
                  </>
                )}
                {!search && recentlyUsed.length > 0 && (
                  <>
                    {/* Recently used — "See all" removed per spec; we
                        show all 5 inline, no slicing. */}
                    <SectionHeader2 icon="Clock" label="Recently used" count={recentlyUsed.length} />
                    <div className="space-y-0.5">{recentlyUsed.map(p => <Row key={p.id} p={p} meta={usedLabel(p._usage.lastUsed)} />)}</div>
                  </>
                )}
                {/* Your Products — "See all" removed. Shows 8 at a time
                    with a refresh icon that pages through the rest. When
                    the user has ≤8 products, all show on first paint and
                    the refresh icon is hidden. */}
                {(() => {
                  const pageSize = 8;
                  const totalPages = Math.max(1, Math.ceil(yourProducts.length / pageSize));
                  const page = totalPages > 0 ? addRitualProductsPage % totalPages : 0;
                  const start = page * pageSize;
                  const visible = yourProducts.slice(start, start + pageSize);
                  const showRefresh = yourProducts.length > pageSize && !search;
                  return (
                    <>
                      <div className="flex items-center justify-between mt-4 mb-1.5 px-3">
                        <div className="flex items-center gap-1.5">
                          <Icon name="Package" size={11} style={{color:'var(--accent)'}} />
                          <span className="text-[10px] tracking-[0.22em] uppercase" style={{color:'var(--ink-soft)'}}>Your products</span>
                          <span className="text-[10px] italic" style={{color:'var(--ink-soft)'}}>
                            ({yourProducts.length}{totalPages > 1 ? ` · ${page + 1}/${totalPages}` : ''})
                          </span>
                        </div>
                        {showRefresh && (
                          <button
                            onClick={() => setAddRitualProductsPage(p => p + 1)}
                            className="w-7 h-7 rounded-full flex items-center justify-center transition hover:bg-[var(--cream-deep)] cursor-pointer"
                            style={{color:'var(--accent)', cursor:'pointer'}}
                            title="Show next products"
                            aria-label="Next products"
                          >
                            <Icon name="RefreshCw" size={12} />
                          </button>
                        )}
                      </div>
                      {yourProducts.length === 0 ? (
                        <p className="text-[11.5px] italic px-4 py-3" style={{color:'var(--ink-soft)'}}>
                          {search ? 'Nothing matches. Try less.' : 'Empty shelf, empty mind. One product to start.'}
                        </p>
                      ) : (
                        <div className="space-y-0.5">{visible.map(p => <Row key={p.id} p={p} />)}</div>
                      )}
                    </>
                  );
                })()}

                {/* "+ Add a new product to your shelf" CTA removed —
                    the modal-on-modal navigation was breaking (sheet
                    would close cleanly but ProductModal didn't always
                    layer correctly on top of the underlying Today's
                    Ritual modal, dropping the user to the home tab).
                    True add-new-product lives on Regimen → "+ Product"
                    in the page header. This sheet is now strictly a
                    "pick from your existing shelf" picker. */}
              </div>

              {/* Sticky bottom — Cancel + Add & keep browsing toggle */}
              <div className="flex-shrink-0 px-4 py-3 flex items-center justify-between gap-3" style={{borderTop:'1px solid var(--line)', background:'var(--cream)'}}>
                <button
                  onClick={() => setAddRitualSheet(null)}
                  className="text-[10.5px] tracking-[0.22em] uppercase italic px-3 py-2"
                  style={{color:'var(--ink-soft)'}}
                >Cancel</button>
                <label className="flex items-center gap-2 text-[10.5px] tracking-[0.05em] cursor-pointer" style={{color:'var(--ink-soft)'}}>
                  <span className="italic">Add &amp; keep browsing</span>
                  <span
                    onClick={() => setAddRitualKeepOpen(v => !v)}
                    className="inline-flex items-center w-9 h-5 rounded-full transition relative"
                    style={{background: addRitualKeepOpen ? 'var(--accent)' : 'var(--line)'}}
                  >
                    <span
                      className="absolute w-4 h-4 rounded-full transition"
                      style={{
                        background: 'var(--cream)',
                        top: '2px',
                        left: addRitualKeepOpen ? '18px' : '2px',
                      }}
                    />
                  </span>
                </label>
              </div>
            </div>
          </>
        );
      })()}

      {matchesDrawerOpen && (() => {
        const todayKey = localDateISO();
        const photoLogsForMatch = (logs || []).filter(l => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:'))).sort((a, b) => new Date(b.date) - new Date(a.date));
        const todayLogForMatch = photoLogsForMatch.find(l => l.date === todayKey) || photoLogsForMatch[0] || null;
        const snap = todayLogForMatch?.metricSnapshot || null;
        const titleCaseLocal = (w) => w !== undefined && w !== null && w !== '' ? String(w).charAt(0).toUpperCase() + String(w).slice(1).toLowerCase() : null;
        const SCORE_LOCAL = COMPARE_SCORE_MAP;
        const m = (k) => snap ? (SCORE_LOCAL[k]?.[titleCaseLocal(snap[k])] ?? 50) : 50;
        const profile = snap ? {
          hydration: m('hydration'),
          barrier: m('barrier'),
          redness: m('redness'),
          congestion: m('breakouts'),
          sensitivity: m('sensitivity'),
        } : null;

        // === STRICT INGREDIENT-BASED TAG RULES ===
        // Match ONLY against actives + main ingredient lists, never against
        // marketing copy in name/tags/concerns. Earlier version used "soothe"
        // and "calm" which appear in product names everywhere → every product
        // matched every filter, so the pills did nothing. Now each tag
        // requires an actual INCI ingredient match. A product can still match
        // multiple needs (e.g. CeraVe Moisturizing Cream = repair + hydrate),
        // which is correct — those products legitimately do both.
        const tagsForProduct = (p) => {
          const ingredients = `${p.actives || ''} ${p.activeIngredients || ''} ${p.main || ''} ${p.mainIngredients || ''}`.toLowerCase();
          const tags = new Set();
          if (/\b(ceramide|cholesterol|fatty acid|phytosphingosine|stearic acid|palmitic acid|linoleic|olei[sc] acid)\b/.test(ingredients)) tags.add('repair');
          if (/\b(centella|cica|madecassoside|panthenol|allantoin|colloidal oat|avena|bisabolol|azulene|licochalcone)\b/.test(ingredients)) tags.add('calm');
          if (/\b(hyaluronic|sodium hyaluronate|glycerin|trehalose|polyglutamic|betaine|propanediol|sodium pca|urea|panthenol)\b/.test(ingredients)) tags.add('hydrate');
          if (/\b(niacinamide|ascorb|vitamin c|tranexamic|alpha arbutin|arbutin|kojic|azelaic|tetrahexyldecyl ascorbate)\b/.test(ingredients)) tags.add('brighten');
          if (/\b(glycolic|lactic|mandelic|salicylic|azelaic|gluconolactone|lactobionic|aha|bha|pha|willow bark|enzyme|papain|bromelain)\b/.test(ingredients)) tags.add('exfoliate');
          return Array.from(tags);
        };

        // Match score: weighted by what the user's skin needs MOST.
        // Each need contributes (100 - profile_score) × tag_match × weight.
        // Additionally, active concerns (chip strip) boost products whose
        // actives/name/tags/concerns text mention the concern — +15 per
        // matched concern, capped so a product can't dominate from concern
        // matches alone.
        const scoreFor = (p) => {
          const tags = tagsForProduct(p);
          let score = 0;
          if (!profile) score = tags.length * 25;
          else {
            if (tags.includes('repair')   && profile.barrier     < 75) score += (100 - profile.barrier) * 0.6;
            if (tags.includes('calm')     && (profile.sensitivity < 75 || profile.redness < 75)) score += (100 - Math.min(profile.sensitivity, profile.redness)) * 0.5;
            if (tags.includes('hydrate')  && profile.hydration   < 75) score += (100 - profile.hydration) * 0.5;
            if (tags.includes('brighten') && profile.redness     < 80) score += 18;
            if (tags.includes('exfoliate') && profile.congestion < 80) score += 16;
            score += tags.length * 4;
          }
          // Shared brand-priority layer: the "What we'd try" drawer should
          // respect the same top-tier brands used by product search/browse.
          // Previously the drawer only scored ingredient tags, so random
          // lower-priority catalog rows could crowd out the agreed-upon
          // brands even when the active fit was equivalent.
          const priority = typeof getBrandPriority === 'function' ? getBrandPriority(p.brand) : 3;
          if (priority === 1) score += 28;
          else if (priority === 2) score += 14;
          else if (priority === 4) score -= 24;
          if (p.hero === true) score += 10;
          if (p.popular === true) score += 6;
          // === CONCERN BOOST ===
          // Active chips reshape the ranking. Each concern that appears in
          // the product's text fields earns +15. Capped at 3 matches to
          // avoid one product dominating from keyword spam.
          const activeConcerns = matchesActiveConcerns;
          if (activeConcerns && activeConcerns.size > 0) {
            const hay = `${p.actives || ''} ${p.activeIngredients || ''} ${p.main || ''} ${p.mainIngredients || ''} ${p.name || ''} ${(p.tags || []).join(' ')} ${(p.concerns || []).join(' ')}`.toLowerCase();
            let hits = 0;
            for (const c of activeConcerns) {
              if (c && hay.includes(c)) { hits++; if (hits >= 3) break; }
            }
            score += hits * 15;
          }
          return score;
        };

        const filterToTag = matchesDrawerFilter === 'all' ? null : matchesDrawerFilter;
        // === EYEBROW (per-card) ===
        // Jenni's brief: drop the long phrase from every card, use a short
        // tag instead. The ONE exception is the calm tag, which is genuinely
        // about a user concern (redness/sensitivity) and reads more honestly
        // as "Matches your concern" than "Calm." All other tags get the
        // ingredient-functional name.
        const fitLabel = (tags) => {
          if (tags.includes('calm')) return 'Matches your concern';
          if (tags.includes('repair')) return 'Repair';
          if (tags.includes('hydrate')) return 'Hydrate';
          if (tags.includes('brighten')) return 'Brighten';
          if (tags.includes('exfoliate')) return 'Exfoliate';
          return 'Curated';
        };
        const whyThisPick = (p) => {
          const tags = p._tags || [];
          const parts = [];
          if (typeof getBrandPriority === 'function') {
            const priority = getBrandPriority(p.brand);
            if (priority === 1) parts.push('top-tier brand');
            else if (priority === 2) parts.push('strong brand fit');
          }
          if (tags.includes('repair')) parts.push('barrier lipids');
          if (tags.includes('calm')) parts.push('calming actives');
          if (tags.includes('hydrate')) parts.push('hydrators');
          if (tags.includes('brighten')) parts.push('tone support');
          if (tags.includes('exfoliate')) parts.push('texture actives');
          if (p.hero === true) parts.push('hero product');
          if (parts.length === 0) parts.push('ingredient fit');
          return parts.slice(0, 3).join(' · ');
        };
        // === DESCRIPTIVE BANNER (shown once above the list) ===
        // Replaces the "FOR YOUR BARRIER" repeated on every card. One line,
        // editorial, keyed off the active filter so it explains WHY this set
        // of products is in front of you right now.
        const bannerLabel = (() => {
          if (matchesDrawerFilter === 'repair')   return "For your barrier";
          if (matchesDrawerFilter === 'calm')     return "Matches your concern";
          if (matchesDrawerFilter === 'hydrate')  return "For hydration";
          if (matchesDrawerFilter === 'brighten') return "For your tone";
          if (matchesDrawerFilter === 'exfoliate') return "For texture";
          return "Curated for you";
        })();

        // === RANKED LIST — NEW FINDS ONLY ===
        // May 2026: Jenni decoupled the two suggestion surfaces. Shelf-based
        // picks live under the "Suggest picks from your shelf" button on the
        // ritual card. This drawer ("What we'd try") is now PURELY external
        // discovery from POPULAR_PRODUCTS. Don't put the user's own shelf
        // products back into this list — separation of surfaces is the
        // whole point of the rename.
        // (The unused-shelf branch + recentlyUsedIds logic that used to mix
        // in 14-day-dormant shelf items has been removed. If you want it
        // back, it lives in git history.)

        const popularMatches = (POPULAR_PRODUCTS || [])
          .map(p => ({ ...p, _tags: tagsForProduct(p), _score: scoreFor(p) }))
          .filter(p => p._tags.length > 0)
          .filter(p => !filterToTag || p._tags.includes(filterToTag));

        // === DISMISS KEY HELPER ===
        // Stable identity for the dismissed Set. Brand+name lower-cased so
        // dupes between unused-shelf and popular collapse correctly.
        const dismissKey = (p) => `${(p.brand || '').toLowerCase()}|${(p.name || '').toLowerCase()}`;
        // === SEEDED TIE-BREAKER ===
        // Score bands are coarse — many products score within a couple
        // points of each other, so the same top-5 always wins. Mix the
        // shuffleSeed into the sort comparator so equal-ish scores
        // reorder on each Refresh tap. Mulberry-style hash, no deps.
        const seedHash = (s, salt) => {
          let h = (matchesDrawerShuffleSeed + 0x9e3779b9) ^ 0;
          for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 2654435761);
          h = (h ^ salt) >>> 0;
          return h / 0xffffffff;
        };
        const tieBroken = (a, b) => {
          // Group by integer score band so reshuffles don't violate ranking.
          const diff = Math.round(b._score) - Math.round(a._score);
          if (diff !== 0) return diff;
          return seedHash(dismissKey(a), 1) - seedHash(dismissKey(b), 1);
        };
        // Sort, filter dismissed + already-on-shelf, cap at 7 per Jenni's
        // brief. Filtering out on-shelf items keeps the discovery surface
        // honest — if a "new find" is already on your shelf, the shelf
        // button is the right place to surface it, not here.
        const ranked = (() => {
          const sorted = [...popularMatches].sort(tieBroken);
          const dismissed = matchesDrawerDismissed || new Set();
          const out = [];
          const seen = new Set();
          const brandCounts = {};
          const canUse = (p) => {
            const k = dismissKey(p);
            const brandKey = normalizeSearchText(p.brand || '');
            if (seen.has(k) || dismissed.has(k)) return false;
            if (isOnShelf(p)) return false;
            if (brandKey && brandCounts[brandKey] >= 2) return false;
            return true;
          };
          const addPick = (p) => {
            const k = dismissKey(p);
            const brandKey = normalizeSearchText(p.brand || '');
            seen.add(k);
            if (brandKey) brandCounts[brandKey] = (brandCounts[brandKey] || 0) + 1;
            out.push(p);
          };
          for (const p of sorted) {
            if (out.length >= 7) break;
            if (!canUse(p)) continue;
            addPick(p);
          }
          // Trust rule: if a top-tier brand has a real ingredient match,
          // the final set should not accidentally contain zero top-tier
          // options just because score bands shuffled tightly. Respect the
          // same dismissal/on-shelf/brand-cap rules, then replace the
          // weakest non-top-tier pick.
          const hasTopTier = out.some(p => typeof getBrandPriority === 'function' && getBrandPriority(p.brand) === 1);
          if (!hasTopTier && typeof getBrandPriority === 'function') {
            const topTierCandidate = sorted.find(p => getBrandPriority(p.brand) === 1 && canUse(p));
            if (topTierCandidate) {
              const replaceIdx = out.length < 7
                ? -1
                : [...out].map((p, i) => ({ p, i }))
                    .filter(x => getBrandPriority(x.p.brand) !== 1)
                    .sort((a, b) => (a.p._score || 0) - (b.p._score || 0))[0]?.i;
              if (replaceIdx === -1) addPick(topTierCandidate);
              else if (replaceIdx != null) out[replaceIdx] = topTierCandidate;
            }
          }
          return out;
        })();

        // === TANG & GAINEY FIT SIGNAL ===
        // Replaces the old "Match 5.9/10" pill, which was decorative noise —
        // the 5.0–10.0 compression made every product look mediocre even when
        // the underlying score was strong. Three-tier signal in doctor-friend
        // banter instead: a co-sign, a try-it, a we'll-see. Thresholds are
        // on the RAW score (0–~200) not the compressed display number.
        //   Solid pick   ≥ 40   — they'd hand you this
        //   Worth a shot 20–40  — credible but unproven for your profile
        //   Long shot     < 20  — dry acknowledgement it's reaching
        const fitSignal = (s) => {
          if (s >= 40) return { label: 'Solid pick', tone: 'strong' };
          if (s >= 20) return { label: 'Worth a shot', tone: 'medium' };
          return { label: 'Long shot', tone: 'soft' };
        };

        // === FILTER PILLS ===
        // "Top" replaces "All" — the unfiltered view actually shows the
        // top-5 ranked by concern match, not the literal full list, so
        // the label should reflect that. Other pills filter to a single
        // ingredient-function category.
        const FILTER_PILLS = [
          { id: 'all',      label: 'Top' },
          { id: 'repair',   label: 'Repair' },
          { id: 'calm',     label: 'Calm' },
          { id: 'hydrate',  label: 'Hydrate' },
          { id: 'brighten', label: 'Brighten' },
          { id: 'exfoliate', label: 'Exfoliate' },
        ];

        // === ROW ACTION RULES ===
        // Per Jenni: don't ever show "+ Add" in the matches drawer unless the
        // product is already on the user's shelf. Browsing state should be
        // low-commitment — heart icon for "save to look at later," and a
        // "✓ On shelf" pill for products they already own. The "Saved" list
        // becomes a Shelf sub-tab where they can promote favorites to
        // Active when they actually start using one.
        // (No toast — silent action like Gemini work.)

        return (
          <>
            {/* Backdrop */}
            <div
              onClick={() => setMatchesDrawerOpen(false)}
              className="fixed inset-0 z-[60]"
              style={{background:'rgba(42,37,32,0.32)', backdropFilter:'blur(2px)'}}
              aria-hidden
            />
            {/* Sheet — bottom on mobile, right on md+ */}
            <div
              className="fixed z-[70] flex flex-col bottom-0 left-0 right-0 max-h-[85vh] rounded-t-[24px] md:rounded-t-none md:rounded-l-[24px] md:bottom-0 md:right-0 md:left-auto md:top-0 md:h-full md:max-h-none md:w-[420px] md:max-w-[90vw]"
              style={{background:'var(--cream)', boxShadow:'0 -16px 48px -8px rgba(42,37,32,0.18)', border: '1px solid var(--line)'}}
              role="dialog"
              aria-label="What we'd try"
            >
              {/* Header */}
              <div className="flex items-start justify-between px-5 pt-5 pb-3 flex-shrink-0">
                <div>
                  <div className="text-[9.5px] tracking-[0.32em] uppercase mb-1.5" style={{color:'var(--ink-soft)'}}>What we'd try</div>
                  <div className="font-serif italic text-[18px] leading-tight" style={{color:'var(--ink)'}}>Suggested matches for you.</div>
                  <div className="text-[11px] italic mt-1 leading-snug whitespace-nowrap" style={{color:'var(--ink-soft)'}}>Tap a row to analyze · heart to save for later.</div>
                  <div className="text-[9.5px] mt-1 leading-snug" style={{color:'var(--ink-soft)'}}>
                    Rules: max 2 per brand · top-tier boost · ingredient fit.
                  </div>
                </div>
                <div className="flex items-center gap-1 flex-shrink-0">
                  {/* Refresh — clears the per-session dismiss list and bumps
                       the shuffle seed so the top 5 re-rolls. Same icon
                       vocabulary as the +Add Product sheet's reshuffle. */}
                  <button
                    onClick={refreshMatchesDrawer}
                    className="w-8 h-8 rounded-full flex items-center justify-center transition hover:bg-[var(--cream-deep)]"
                    style={{color:'var(--ink-soft)'}}
                    aria-label="Refresh suggestions"
                    title="Refresh suggestions"
                  ><Icon name="RefreshCw" size={13} /></button>
                  <button
                    onClick={() => setMatchesDrawerOpen(false)}
                    className="w-8 h-8 rounded-full flex items-center justify-center transition hover:bg-[var(--cream-deep)]"
                    style={{color:'var(--ink-soft)'}}
                    aria-label="Close"
                  ><Icon name="X" size={14} /></button>
                </div>
              </div>

              {/* === CONCERN CHIP STRIP ===
                  One thin horizontal-scroll row of the user's concerns.
                  Each chip toggles active in the current ranking. Custom
                  concerns can be typed via the "+ Add" pill at the end —
                  on Enter they persist to userConcerns and immediately
                  reshape the list. No-scrollbar so it reads as a single
                  clean band even on overflow. */}
              <div className="px-5 pb-2 flex-shrink-0">
                <div className="flex gap-1.5 overflow-x-auto no-scrollbar items-center">
                  {/* Existing concerns */}
                  {(userConcerns || []).map(c => {
                    const k = c.toLowerCase();
                    const isActive = matchesActiveConcerns.has(k);
                    return (
                      <div
                        key={c}
                        className="flex items-center gap-1 rounded-full pl-2.5 pr-1 py-0.5 transition flex-shrink-0"
                        style={{
                          background: isActive ? 'var(--accent)' : 'var(--cream-deep)',
                          color: isActive ? 'var(--cream)' : 'var(--ink-soft)',
                          border: '1px solid ' + (isActive ? 'var(--accent)' : 'var(--line)'),
                        }}
                      >
                        <button
                          type="button"
                          onClick={() => toggleConcernFilter(c)}
                          className="text-[10px] tracking-[0.05em] cursor-pointer"
                          style={{color:'inherit'}}
                          title={isActive ? 'Tap to mute this concern' : 'Tap to filter by this concern'}
                        >{c}</button>
                        <button
                          type="button"
                          onClick={() => removeUserConcern(c)}
                          className="w-3.5 h-3.5 rounded-full flex items-center justify-center transition hover:bg-[rgba(0,0,0,0.08)]"
                          style={{color:'inherit', opacity:0.7}}
                          title="Remove this concern entirely"
                          aria-label={`Remove ${c}`}
                        ><Icon name="X" size={7} /></button>
                      </div>
                    );
                  })}
                  {/* + Add (collapsed) → inline input (expanded) */}
                  {matchesConcernsInputOpen ? (
                    <input
                      type="text"
                      autoFocus
                      value={matchesConcernsInputValue}
                      onChange={(e) => setMatchesConcernsInputValue(e.target.value)}
                      onKeyDown={(e) => {
                        if (e.key === 'Enter') { e.preventDefault(); addCustomConcern(matchesConcernsInputValue); }
                        else if (e.key === 'Escape') { setMatchesConcernsInputOpen(false); setMatchesConcernsInputValue(''); }
                      }}
                      onBlur={() => {
                        // Save on blur if there's text, otherwise just close.
                        if (matchesConcernsInputValue.trim()) addCustomConcern(matchesConcernsInputValue);
                        else setMatchesConcernsInputOpen(false);
                      }}
                      placeholder="e.g. rosacea"
                      className="text-[10px] italic px-2.5 py-1 rounded-full flex-shrink-0 outline-none"
                      style={{
                        background:'var(--cream)',
                        border:'1px solid var(--accent)',
                        color:'var(--ink)',
                        width:'120px',
                      }}
                    />
                  ) : (
                    <button
                      type="button"
                      onClick={() => setMatchesConcernsInputOpen(true)}
                      className="flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[10px] tracking-[0.05em] transition flex-shrink-0 italic hover:opacity-80"
                      style={{
                        background:'transparent',
                        color:'var(--accent)',
                        border:'1px dashed var(--accent)',
                      }}
                      title="Add a concern"
                    >
                      <Icon name="Plus" size={8} /> Add concern
                    </button>
                  )}
                  {/* Empty-state hint when user has no concerns yet */}
                  {(!userConcerns || userConcerns.length === 0) && !matchesConcernsInputOpen && (
                    <span className="text-[10px] italic flex-shrink-0" style={{color:'var(--ink-soft)'}}>Tell us what's bothering you →</span>
                  )}
                </div>
              </div>
              {/* Filter pills */}
              <div className="flex gap-1.5 px-5 pb-3 overflow-x-auto no-scrollbar flex-shrink-0">
                {FILTER_PILLS.map(f => {
                  const active = matchesDrawerFilter === f.id;
                  return (
                    <button
                      key={f.id}
                      onClick={() => setMatchesDrawerFilter(f.id)}
                      className="px-3 py-1.5 rounded-full text-[10px] tracking-[0.18em] uppercase transition flex-shrink-0"
                      style={{
                        background: active ? 'var(--ink)' : 'var(--cream-deep)',
                        color: active ? 'var(--cream)' : 'var(--ink-soft)',
                        border: '1px solid ' + (active ? 'var(--ink)' : 'var(--line)'),
                      }}
                    >{f.label}</button>
                  );
                })}
              </div>

              {/* Banner card removed (May 2026 per Jenni): redundant
                  with the new subtitle right under "Suggested matches
                  for you" which now carries the tap hint. bannerLabel
                  helper kept in scope above in case we want to
                  reintroduce a section header later. */}
              {/* Matches list — COMPACT
                  Each card is now icon-free per Jenni's note that the
                  tag icon was redundant when every card in a filtered
                  list mapped to the same icon. Layout: eyebrow tag +
                  brand · name + actives + fit signal + heart, with
                  chevron at end of row 3. Tap row → expand analysis. */}
              <div className="flex-1 overflow-y-auto px-5 pb-6 space-y-1.5">
                {ranked.length === 0 ? (
                  <div className="text-center py-10">
                    <p className="font-serif italic text-[14px] mb-2" style={{color:'var(--ink-soft)'}}>Nothing left in this category.</p>
                    <button
                      onClick={refreshMatchesDrawer}
                      className="text-[10px] tracking-[0.18em] uppercase inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full transition hover:opacity-80"
                      style={{borderColor: 'var(--line)', border: '1px solid var(--line)', color:'var(--ink)', background:'var(--cream)'}}
                    >
                      <Icon name="RefreshCw" size={10} /> Refresh
                    </button>
                  </div>
                ) : ranked.map((p, i) => {
                  const key = offShelfKey(p);
                  const expanded = expandedSuggestedKey === key;
                  const analyzing = offShelfAssessing === key;
                  const analysis = offShelfAssessment[key];
                  const primaryTag = (p._tags || [])[0] || '';
                  const tagIcon = ({
                    repair: 'Shield',
                    calm: 'Leaf',
                    hydrate: 'Droplet',
                    brighten: 'Sun',
                    exfoliate: 'Zap',
                  })[primaryTag] || 'Sparkles';
                  return (
                  <div
                    key={`${p.brand}-${p.name}-${i}`}
                    className="relative rounded-[10px]"
                    style={{background:'var(--cream-deep)', border: '1px solid var(--line)'}}
                  >
                    {/* Dismiss X — absolute top-right so it doesn't eat row width */}
                    <button
                      onClick={(e) => {
                        e.stopPropagation();
                        const k = dismissKey(p);
                        setMatchesDrawerDismissed(prev => {
                          const next = new Set(prev || []);
                          next.add(k);
                          return next;
                        });
                      }}
                      className="absolute top-1 right-1 w-5 h-5 rounded-full flex items-center justify-center transition hover:bg-[var(--cream)] z-10"
                      style={{color:'var(--ink-soft)'}}
                      aria-label={`Dismiss ${p.name}`}
                      title="Not for me — show something else"
                    ><Icon name="X" size={9} /></button>
                    {/* === SUMMARY ROW (button) ===
                        Whole row is tappable to expand → fire Mechanism /
                        Evidence / Alternatives analysis. Nested buttons
                        (dismiss, heart) stopPropagation so they don't fire
                        the expand. Aria-expanded for screen readers. */}
                    <button
                      type="button"
                      onClick={() => {
                        const willOpen = !expanded;
                        setExpandedSuggestedKey(willOpen ? key : null);
                        if (willOpen && !analysis && !analyzing) {
                          assessOffShelfProduct(p);
                        }
                      }}
                      className="w-full text-left px-3 py-2.5 flex items-center gap-2.5 transition hover:bg-[var(--cream)]"
                      style={{cursor:'pointer'}}
                      aria-expanded={expanded}
                      aria-label={`${expanded ? 'Collapse' : 'See analysis for'} ${p.name}`}
                    >
                      {/* Thumbnail icon removed (May 2026 per Jenni): every
                          row in a filtered category mapped to the same icon,
                          so it was visual noise. Card width regained for
                          the content. tagIcon var still computed above —
                          left intentionally so we can reintroduce later
                          if we add a non-redundant per-card visual. */}
                      <div className="flex-1 min-w-0 pr-5">
                        {/* Row 1: eyebrow */}
                        <div className="text-[7.5px] tracking-[0.22em] uppercase leading-none" style={{color:'var(--accent)'}}>
                          <span className="truncate">{fitLabel(p._tags)}</span>
                        </div>
                        {/* Row 2: brand · name */}
                        <div className="flex items-baseline gap-1.5 mt-0.5 min-w-0">
                          <span className="text-[8.5px] tracking-[0.05em] uppercase flex-shrink-0 truncate max-w-[35%]" style={{color:'var(--ink-soft)'}}>{p.brand}</span>
                          <span className="font-serif italic text-[11.5px] leading-tight truncate flex-1" style={{color:'var(--ink)'}}>{p.name}</span>
                        </div>
                        {/* Row 3: actives + fit signal + heart */}
                        <div className="flex items-center gap-1.5 mt-1 min-w-0">
                          {(p.actives) && (
                            <div className="text-[9px] italic leading-tight truncate flex-1 min-w-0" style={{color:'var(--ink-soft)'}}>{p.actives}</div>
                          )}
                          {/* Tang & Gainey fit signal */}
                          {(() => {
                            const sig = fitSignal(p._score);
                            const sigStyle = sig.tone === 'strong'
                              ? { background: 'var(--ink)', color: 'var(--cream)', border: '1px solid var(--ink)' }
                              : sig.tone === 'medium'
                                ? { background: 'var(--cream)', color: 'var(--ink)', border: '1px solid var(--ink-soft)' }
                                : { background: 'transparent', color: 'var(--ink-soft)', border: '1px solid var(--line)' };
                            return (
                              <div
                                className="text-[8.5px] tracking-[0.15em] uppercase px-1.5 py-px rounded-full flex-shrink-0 whitespace-nowrap italic"
                                style={sigStyle}
                                title={
                                  sig.tone === 'strong' ? "We'd hand you this"
                                  : sig.tone === 'medium' ? "Credible, worth testing"
                                  : "Reaching, but maybe"
                                }
                              >
                                {sig.label}
                              </div>
                            );
                          })()}
                          {/* On-shelf check vs. heart-save toggle */}
                          {isOnShelf(p) ? (
                            <span className="flex-shrink-0 w-5 h-5 rounded-full flex items-center justify-center" style={{background:'var(--cream)', color:'var(--ink-soft)', border: '1px solid var(--line)'}} title="On shelf">
                              <Icon name="Check" size={9} />
                            </span>
                          ) : (
                            <span
                              role="button"
                              tabIndex={0}
                              onClick={(e) => { e.stopPropagation(); toggleFavorite(p); }}
                              onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.stopPropagation(); e.preventDefault(); toggleFavorite(p); } }}
                              className="flex-shrink-0 w-5 h-5 rounded-full flex items-center justify-center transition hover:opacity-80 cursor-pointer"
                              style={{
                                background: isFavorited(p) ? 'var(--accent)' : 'var(--cream)',
                                color: isFavorited(p) ? 'var(--cream)' : 'var(--accent)',
                                border: '1px solid var(--accent)',
                              }}
                              aria-label={isFavorited(p) ? 'Remove from Save for later' : 'Save for later — future purchase or folder'}
                              title={isFavorited(p) ? 'Saved — tap to remove' : 'Save for later (future purchase)'}
                            >
                              <Icon name="Heart" size={9} fill={isFavorited(p) ? 'currentColor' : 'none'} />
                            </span>
                          )}
                          {/* Chevron — visual hint that the row expands */}
                          <span aria-hidden className="flex-shrink-0 transition" style={{color:'var(--ink-soft)', transform: expanded ? 'rotate(180deg)' : 'rotate(0deg)'}}>
                            <Icon name="ChevronDown" size={10} />
                          </span>
                        </div>
                        <div className="text-[8.5px] mt-1 truncate" style={{color:'var(--ink-soft)', letterSpacing:'0.02em'}}>
                          Why: {whyThisPick(p)}
                        </div>
                      </div>
                    </button>
                    {/* === EXPANDED ANALYSIS PANEL ===
                        Lazy-fires assessOffShelfProduct on first expand,
                        caches the result by brand|name. Parses the same
                        MECHANISM / EVIDENCE / ALTERNATIVES contract as the
                        shelf row. */}
                    {expanded && (
                      <div className="px-3 pb-3 pt-1 border-t" style={{borderColor: 'var(--line)'}}>
                        {analyzing && !analysis && (
                          <div className="pt-2 flex items-center gap-1.5 pulse-soft" style={{color:'var(--ink-soft)'}}>
                            <Icon name="Loader2" size={10} className="spin" />
                            <span className="text-[9px] tracking-[0.2em] uppercase">Reading the literature…</span>
                          </div>
                        )}
                        {!analyzing && !analysis && (
                          <div className="pt-2 text-[10.5px] italic" style={{color:'var(--ink-soft)'}}>
                            Couldn't pull an analysis right now. Tap to retry.
                          </div>
                        )}
                        {analysis && (() => {
                          // Same parser as the shelf row — walks line-start
                          // MECHANISM/EVIDENCE/ALTERNATIVES labels and slices
                          // between them. Keep these two paths' parsers in
                          // sync: if you fix a bug here, fix it in the shelf
                          // row too (around line 24180).
                          const raw = analysis;
                          const sections = {};
                          const labelRe = /^\s*(MECHANISM|EVIDENCE|ALTERNATIVES)\s*:\s*/gmi;
                          let lastLabel = null;
                          let lastIndex = 0;
                          let m;
                          while ((m = labelRe.exec(raw)) !== null) {
                            if (lastLabel !== null) {
                              sections[lastLabel] = raw.slice(lastIndex, m.index).trim();
                            }
                            lastLabel = m[1].toUpperCase();
                            lastIndex = m.index + m[0].length;
                          }
                          if (lastLabel !== null) sections[lastLabel] = raw.slice(lastIndex).trim();
                          const scrubAltLeak = (text) => (text || '').split(/\n/).filter(l => {
                            const t = l.trim();
                            return !/^\s*[12]\.\s*(CHEAPER|SIMILAR)/i.test(t) && !/^\s*(CHEAPER|SIMILAR-OR-HIGHER)\s*\|/i.test(t);
                          }).join('\n').trim();
                          const mechanism = scrubAltLeak(sections.MECHANISM || '');
                          const evidence = scrubAltLeak(sections.EVIDENCE || '');
                          const alternativesRaw = sections.ALTERNATIVES || '';
                          const isStructured = !!(mechanism && (evidence || alternativesRaw));
                          const altLines = isStructured
                            ? alternativesRaw.split(/\n/).map(l => l.trim()).filter(l => /^\s*[12]\./.test(l))
                            : [];
                          const parsedAlts = altLines.map(line => {
                            const cleaned = line.replace(/^\s*[12]\.\s*/, '');
                            const parts = cleaned.split(/\s*\|\s*/).map(s => s.trim());
                            return {
                              tier: parts[0] || '',
                              name: parts[1] || '',
                              price: parts[2] || '',
                              active: parts[3] || '',
                              rationale: parts.slice(4).join(' | ') || '',
                            };
                          });
                          const splitSentences = (text) => (text || '')
                            .replace(/\n+/g, ' ')
                            .split(/(?<=[.!?])\s+(?=[A-Z\[])/)
                            .map(s => s.trim())
                            .filter(Boolean);
                          const mechanismBullets = splitSentences(mechanism).slice(0, 2);
                          const evidenceBullets = splitSentences(evidence).slice(0, 1);
                          if (!isStructured) return null;
                          return (
                            <div className="space-y-2 mt-2">
                              {mechanismBullets.length > 0 && (
                                <div>
                                  <div className="text-[8px] tracking-[0.2em] uppercase mb-1" style={{color:'var(--accent)'}}>Mechanism</div>
                                  <ul className="space-y-0.5">
                                    {mechanismBullets.map((b, idx) => (
                                      <li key={idx} className="flex gap-1.5 text-[11px] leading-snug font-light" style={{color:'var(--ink)'}}>
                                        <span style={{color:'var(--accent)'}}>·</span>
                                        <span className="flex-1">{withPearls(b, setOpenLesson)}</span>
                                      </li>
                                    ))}
                                  </ul>
                                </div>
                              )}
                              {evidenceBullets.length > 0 && (
                                <div>
                                  <div className="text-[8px] tracking-[0.2em] uppercase mb-1" style={{color:'var(--accent)'}}>Evidence</div>
                                  <div className="flex gap-1.5 text-[11px] leading-snug font-light" style={{color:'var(--ink)'}}>
                                    <span style={{color:'var(--accent)'}}>·</span>
                                    <span className="flex-1">{withPearls(evidenceBullets[0], setOpenLesson)}</span>
                                  </div>
                                </div>
                              )}
                              {parsedAlts.length > 0 && (
                                <div className="mt-2.5">
                                  <div className="flex items-baseline justify-between mb-1.5">
                                    <div className="text-[8px] tracking-[0.2em] uppercase" style={{color:'var(--accent)'}}>Alternatives</div>
                                  </div>
                                  <div className="grid grid-cols-2 gap-1.5">
                                    {parsedAlts.map((a, idx) => {
                                      const isCheap = a.tier.toLowerCase().includes('cheap');
                                      return (
                                        <div
                                          key={idx}
                                          className="rounded-[10px] px-2.5 py-2 min-w-0"
                                          style={{background:'var(--cream)', border: '1px solid var(--line)'}}
                                        >
                                          <div className="flex items-baseline justify-between gap-1.5 mb-1">
                                            <span className="text-[8px] tracking-[0.15em] uppercase" style={{color:'var(--ink-soft)'}}>
                                              {isCheap ? '↓ Cheap' : '↑ Premium'}
                                            </span>
                                            {a.price && <span className="font-serif italic text-[10.5px] leading-none" style={{color:'var(--accent)'}}>{a.price}</span>}
                                          </div>
                                          <div className="font-serif italic text-[11.5px] leading-tight mb-1" style={{color:'var(--ink)'}}>{a.name}</div>
                                          {a.active && (
                                            <div className="text-[9.5px] leading-tight" style={{color:'var(--ink-soft)'}}>{a.active}</div>
                                          )}
                                        </div>
                                      );
                                    })}
                                  </div>
                                </div>
                              )}
                            </div>
                          );
                        })()}
                      </div>
                    )}
                  </div>
                  );
                })}
              </div>
            </div>
          </>
        );
      })()}

      {showTodaysRegimen && <TodaysRegimenModal />}
      {showSearch && <SearchModal />}
      {/* === GEMINI WORK STAYS SILENT IN UI ===
          The product art floating chip was removed. Per Jenni: no
          notifications about Gemini activity, ever. The error state still
          flows through `productArtError` for console diagnostics, but it
          never surfaces visually. */}

      {openLesson && (() => {
        // === LESSON MODAL — compact + AWA palette (May 29 2026 per Jenni) ===
        // Tighter spacing throughout. Category gets a color-coded dot
        // prefix using AWA accents (sleep=blue, hormones=rose, barrier=
        // gold, sun=gold, sensitivity=rose, others=sage). Evidence
        // grade is a tinted sage chip instead of an inked border box.
        // Save button is an icon-only bookmark that highlights when on.
        // Splurge/Save take + References get tinted accent rails.
        const catLower = (openLesson.category || '').toLowerCase();
        const catColor =
          catLower.includes('sleep') || catLower.includes('hydra') ? 'var(--accent-blue)' :
          catLower.includes('hormone') || catLower.includes('sensitiv') || catLower.includes('redness') ? 'var(--rose)' :
          catLower.includes('barrier') || catLower.includes('sun') || catLower.includes('uv') ? 'var(--gold)' :
          'var(--accent-sage-dark)';
        const isSaved = isPearlSaved(openLesson.id);
        return (
        <Modal eyebrow="Pearls · lesson" title={openLesson.title} onClose={() => setOpenLesson(null)}>
          <div className="space-y-3.5">
            {/* Header row: color-dot category + evidence chip + save icon */}
            <div className="flex items-center gap-2 flex-wrap">
              <span className="inline-flex items-center gap-1.5 text-[9px] tracking-[0.22em] uppercase" style={{color:'var(--ink-soft)', fontWeight:600}}>
                <span aria-hidden style={{display:'inline-block', width:6, height:6, borderRadius:'50%', background: catColor}} />
                {openLesson.category}
              </span>
              {openLesson.evidenceGrade && (
                <span
                  className="text-[9px] tracking-[0.14em] uppercase px-2 py-0.5 rounded-full"
                  style={{
                    background: 'rgba(199, 231, 245, 0.42)',
                    color: 'var(--accent-sage-dark)',
                    border: '1px solid rgba(134, 202, 231, 0.46)',
                    fontWeight: 600,
                  }}
                >
                  Evidence {openLesson.evidenceGrade}
                </span>
              )}
              <button
                onClick={() => {
                  toggleSavedPearl(openLesson.id);
                  toast(isPearlSaved(openLesson.id) ? 'Removed from Saved' : 'Saved to Pearls', 'info');
                }}
                className="ml-auto w-7 h-7 rounded-full flex items-center justify-center transition hover:opacity-75"
                style={{
                  color: isSaved ? 'var(--accent)' : 'var(--ink-soft)',
                  background: isSaved ? 'var(--accent-primary-soft)' : 'transparent',
                  border: '1px solid ' + (isSaved ? 'var(--accent)' : 'var(--line)'),
                }}
                aria-label={isSaved ? 'Remove from saved' : 'Save to Pearls'}
                title={isSaved ? 'Saved — tap to remove' : 'Save to Pearls'}
              >
                <Icon name={isSaved ? 'BookmarkCheck' : 'BookmarkPlus'} size={12} />
              </button>
            </div>

            {openLesson.excerpt && (
              <p className="text-[12.5px] font-light italic leading-snug" style={{color:'var(--ink-soft)'}}>{openLesson.excerpt}</p>
            )}

            <div className="text-[13.5px] leading-[1.55] font-light whitespace-pre-wrap" style={{color:'var(--ink)'}}>{openLesson.body}</div>

            {openLesson.splurgeSaveTake && (
              <div
                className="rounded-[12px] px-3.5 py-3"
                style={{
                  background: 'rgba(199, 231, 245, 0.32)',
                  borderLeft: '2px solid var(--accent-blue)',
                }}
              >
                <div className="text-[9px] tracking-[0.22em] uppercase mb-1" style={{color:'var(--accent-sage-dark)', fontWeight:600}}>The Splurge & Save Take</div>
                <div className="text-[13px] font-light italic leading-snug" style={{color:'var(--ink)'}}>{openLesson.splurgeSaveTake}</div>
              </div>
            )}

            {openLesson.linkedPickIds?.length > 0 && (
              <div>
                <div className="text-[9px] tracking-[0.22em] uppercase mb-2" style={{color:'var(--ink-soft)', fontWeight:600}}>Verified picks for this</div>
                <div className="space-y-1.5">
                  {openLesson.linkedPickIds.map(pid => {
                    const pick = VERIFIED_PICKS.find(p => p.id === pid);
                    if (!pick) return null;
                    const tagColor = pick.splurgeOrSave === 'save' ? 'var(--accent-blue)' : pick.splurgeOrSave === 'splurge' ? 'var(--rose)' : 'var(--ink-soft)';
                    return (
                      <div key={pid} className="rounded-[10px] px-3 py-2 flex justify-between items-center gap-3" style={{background:'var(--cream-deep)', border: '1px solid var(--line)'}}>
                        <div className="min-w-0">
                          <div className="text-[8.5px] tracking-[0.18em] uppercase" style={{color:'var(--ink-soft)', fontWeight:600}}>{pick.brand}</div>
                          <div className="text-[12.5px]" style={{color:'var(--ink)', fontWeight:500}}>{pick.name}</div>
                        </div>
                        <div className="text-right flex-shrink-0">
                          <div className="text-[12px]" style={{color:'var(--ink)', fontWeight:600}}>{pick.price}</div>
                          <div className="text-[8.5px] tracking-[0.16em] uppercase" style={{color: tagColor, fontWeight:600}}>
                            {pick.splurgeOrSave === 'save' ? 'Save' : pick.splurgeOrSave === 'splurge' ? 'Splurge' : 'Either'}
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {openLesson.references?.length > 0 && (
              <div className="pt-2.5 border-t" style={{borderColor: 'var(--line)'}}>
                <div className="text-[9px] tracking-[0.22em] uppercase mb-1.5" style={{color:'var(--ink-soft)', fontWeight:600}}>References</div>
                <ol className="text-[10.5px] font-light leading-snug space-y-1 list-decimal list-inside" style={{color:'var(--ink-soft)'}}>
                  {openLesson.references.map((r, i) => (
                    <li key={i}>
                      {r.author} ({r.year}). <em style={{color:'var(--ink)'}}>{r.title}</em>. {r.journal}.
                      {r.pmid && <> PMID: <a href={`https://pubmed.ncbi.nlm.nih.gov/${r.pmid}/`} target="_blank" rel="noopener noreferrer" style={{color:'var(--accent)'}}>{r.pmid}</a></>}
                    </li>
                  ))}
                </ol>
              </div>
            )}

            <div className="pt-2 border-t text-[9px] tracking-[0.2em] uppercase flex items-center gap-1.5" style={{borderColor: 'var(--line)', color: openLesson.verifiedBy?.length ? 'var(--accent-sage-dark)' : 'var(--gold)', fontWeight:600}}>
              <Icon name={openLesson.verifiedBy?.length ? 'ShieldCheck' : 'Clock'} size={10} />
              {openLesson.verifiedBy?.length > 0
                ? <>Verified by {openLesson.verifiedBy.map(v => 'Dr. ' + v).join(' & ')}</>
                : <span className="italic">Draft — pending MD review</span>
              }
            </div>
          </div>
        </Modal>
        );
      })()}

      {/* FOLLOW-UP CHAT PANEL */}
      {chatPanel && (
        <div className="fixed inset-0 z-50 flex" style={{background:'rgba(28,25,23,0.45)', backdropFilter:'blur(4px)'}} onClick={closeChat}>
          <div onClick={e => e.stopPropagation()} className="ml-auto w-full md:w-[480px] h-full flex flex-col shadow-2xl" style={{background:'var(--cream)'}}>
            {/* Header */}
            <div className="px-5 py-4 border-b flex items-start justify-between gap-3" style={{borderColor: 'var(--line)'}}>
              <div className="flex-1 min-w-0">
                <div className="text-[10px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)'}}>{chatPanel.subtitle || 'Follow-up'}</div>
                <h3 className="font-serif text-xl italic mt-0.5 truncate" style={{color:'var(--ink)'}}>{chatPanel.title}</h3>
              </div>
              <button onClick={closeChat} style={{color:'var(--ink-soft)'}}><Icon name="X" size={20} /></button>
            </div>

            {/* Messages */}
            <div className="flex-1 overflow-y-auto p-5 space-y-4">
              {Array.isArray(chatPanel.compareEntries) && chatPanel.compareEntries.length === 2 ? (
                <div className="grid grid-cols-2 gap-2">
                  {chatPanel.compareEntries.map((l, idx) => (
                    <div key={l.id} className="border" style={{borderColor: idx === 1 ? 'var(--accent)' : 'var(--line)', background:'var(--cream)'}}>
                      <div className="aspect-square overflow-hidden" style={{background:'var(--cream-deep)'}}>
                        <Photo item={l} alt="" className="w-full h-full object-cover" />
                      </div>
                      <div className="px-2 py-1.5">
                        <div className="text-[9px] tracking-[0.2em] uppercase" style={{color: idx === 1 ? 'var(--accent)' : 'var(--ink-soft)'}}>{idx === 0 ? 'Earlier' : 'Later'}</div>
                        <div className="font-serif italic text-xs mt-0.5" style={{color:'var(--ink)'}}>{new Date(l.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
                        <div className="text-[10px] font-light" style={{color:'var(--ink-soft)'}}>{l.rating}/10</div>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (chatPanel.image || chatPanel.imagePath) ? (
                <Photo
                  item={{ photo: chatPanel.image, photoPath: chatPanel.imagePath }}
                  alt=""
                  className="w-full max-h-48 object-cover rounded-md"
                />
              ) : null}
              {chatPanel.messages.map((m, i) => (
                <div key={i} className={m.role === 'user' ? 'flex justify-end' : ''}>
                  {m.role === 'assistant' && m.isContextual && (
                    <div className="p-4 rounded-md border" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
                      <div className="text-[10px] tracking-[0.2em] uppercase mb-2 flex items-center gap-1" style={{color:'var(--ink-soft)'}}>
                        <Icon name="Sparkles" size={11} /> {String(chatPanel.subtitle || '').toLowerCase().includes('refine') ? 'Recommendations' : 'Original analysis'}
                      </div>
                      <div className="text-xs leading-relaxed font-light whitespace-pre-wrap" style={{color:'var(--ink)'}}>{withPearls(m.content, setOpenLesson)}</div>
                    </div>
                  )}
                  {m.role === 'assistant' && !m.isContextual && (
                    <div className="flex gap-2">
                      <div className="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style={{background:'var(--ink)', color:'var(--cream)'}}>
                        <Icon name="Sparkles" size={10} />
                      </div>
                      <div className="flex-1 text-xs leading-relaxed font-light whitespace-pre-wrap" style={{color: m.error ? '#a04555' : 'var(--ink)'}}>{withPearls(m.content, setOpenLesson)}</div>
                    </div>
                  )}
                  {m.role === 'user' && (
                    <div className="max-w-[80%] px-3 py-2 rounded-2xl rounded-tr-sm text-xs font-light leading-relaxed" style={{background:'var(--ink)', color:'var(--cream)'}}>
                      {m.content}
                    </div>
                  )}
                </div>
              ))}

              {chatLoading && (
                <div className="flex gap-3">
                  <div className="w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0" style={{background:'var(--ink)', color:'var(--cream)'}}>
                    <Icon name="Sparkles" size={11} />
                  </div>
                  <div className="flex-1 flex items-center gap-2 pulse-soft" style={{color:'var(--ink-soft)'}}>
                    <Icon name="Loader2" size={12} className="spin" />
                    <span className="text-xs tracking-[0.2em] uppercase">Thinking…</span>
                  </div>
                </div>
              )}

              {/* Suggestion chips - shown only before any user message */}
              {chatPanel.suggestions?.length > 0 && chatPanel.messages.filter(m => m.role === 'user').length === 0 && !chatLoading && (
                <div className="space-y-2">
                  <div className="text-[10px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)'}}>Try asking</div>
                  {chatPanel.suggestions.map((s, i) => (
                    <button key={i} onClick={() => sendChat(s)} className="w-full text-left p-3 rounded-md border text-sm font-light italic transition" style={{background:'var(--cream-deep)', borderColor: 'var(--line)', color:'var(--ink)'}}>
                      "{s}"
                    </button>
                  ))}
                </div>
              )}
            </div>

            {/* Input — module-scope ChatInputBox owns its own typing state so
                each keystroke renders ONLY the input, not the whole Counsel
                surface. Without this, typing felt like "one letter at a time"
                because every setChatInput recreated the entire view. */}
            <div className="border-t p-3" style={{borderColor: 'var(--line)', background:'var(--cream)'}}>
              <ChatInputBox
                onSend={(text, reset) => { sendChat(text); reset(); }}
                disabled={chatLoading}
                placeholder="Ask a follow-up question…"
              />
            </div>
          </div>
        </div>
      )}

      {/* === GLOBAL FOOTER ===
       * Quiet sign-off — sits at the bottom of every page, above the mobile bottom nav.
       * Centers the brand line so it reads as a magazine colophon rather than chrome. */}
      <footer className="max-w-7xl mx-auto px-6 py-8 mt-12 mb-20 md:mb-8 border-t flex justify-center" style={{borderColor: 'var(--line)'}}>
        <div className="text-center leading-tight">
          <div className="font-serif italic text-[13px]" style={{color:'var(--ink-soft)'}}>Frida</div>
          <div className="text-[8px] tracking-[0.3em] uppercase mt-1" style={{color:'var(--ink-soft)'}}>Est. 2026</div>
          <div className="text-[9px] font-light italic mt-0.5" style={{color:'var(--ink-soft)'}}>by Dr. Christina Gainey · Dr. Jenni Tang</div>
        </div>
      </footer>

      {/* === MOBILE QUICK-ACTIONS FAB ===
          Fixed terracotta + button hovering above the bottom nav. Tap
          fans up a stack of four high-frequency actions:
            · Log skin (photo + rating)
            · Add product (scan/search/manual)
            · Log procedure
            · Ask Tang & Gainey
          Goal: zero-thought capture from anywhere. Modal backdrops at
          z-50+ naturally cover this when a sheet is already open, so
          the FAB only shows when the user is in browse state.
          NOTE: never expand the action count past ~5 — defeats the
          "fast / without thinking" purpose. */}
      {/* === QUICK ACTIONS FAB — RETIRED MAY 2026 ===
          Removed per Jenni's call. quickActionsOpen state is left in place
          (harmless) since other code might reference it; nothing renders it. */}

      {/* === MOBILE BOTTOM NAV — 5 EVEN TABS (May 2026) ===
          FAB retired. Insights restored to the dock. Tabs: Home / Regimen /
          Journal / Compare / Insights. About lives in the upper-right
          drawer (hamburger menu) for less-frequent access.
          Journal before Compare per record→reflect→analyze model. */}
      <div className="md:hidden fixed bottom-0 left-0 right-0 z-40 border-t" style={{background:'rgba(255,255,255,0.96)', backdropFilter:'blur(12px)', borderColor:'var(--border-soft)'}}>
        {(() => {
          const allTabs = [
            { id: 'dashboard', label: 'Home', icon: 'Home' },
            { id: 'regimen', label: 'Regimen', icon: 'Layers' },
            { id: 'journal', label: 'Journal', icon: 'Notebook' },
            { id: 'compare', label: 'Compare', icon: 'Eye' },
            { id: 'pearls', label: 'Insights', icon: 'Sparkles' },
          ];
          const renderTab = (t) => {
            const active = activeTab === t.id;
            // Tapping Regimen from the bottom nav ALWAYS lands on Today.
            // Deep-links (e.g. "Build my routine" from cover) still work
            // because they call setRegimenView AFTER setActiveTab in their
            // own handlers — this nav handler doesn't run for those paths.
            const handleTap = () => openTopLevelTab(t.id);
            return (
              <button key={t.id} onClick={handleTap} className="flex-1 flex flex-col items-center justify-center gap-0.5 py-2.5 transition min-w-0 relative" style={{
                color: active ? 'var(--ink)' : 'var(--ink-soft)',
                opacity: active ? 1 : 0.45,
              }}>
                <span className="flex items-center justify-center w-9 h-7 rounded-full transition" style={{background: active ? 'var(--surface-selected-soft)' : 'transparent'}}>
                  <Icon name={t.icon} size={16} />
                </span>
                <span className="text-[8px] tracking-[0.1em] uppercase font-medium whitespace-nowrap" style={{fontWeight: active ? 600 : 400}}>{t.label}</span>
                {active && <div className="w-1 h-1 rounded-full" style={{background:'var(--accent)'}}></div>}
              </button>
            );
          };
          return (
            <div className="flex items-stretch">{allTabs.map(renderTab)}</div>
          );
        })()}
      </div>

      {/* MOBILE SLIDE-IN SIDEBAR — all sections + account */}
      {showMobileMenu && (
        // Menu now opens on every viewport — `md:hidden` removed (May 2026).
        // The hamburger icon in the top-right header is also visible on
        // desktop, so hiding the panel there made it look broken: icon
        // present, tap, nothing happens. State name is still
        // showMobileMenu/setShowMobileMenu for blast-radius reasons;
        // semantically it's "main menu" now, not "mobile menu."
        <div className="fixed inset-0 z-50 flex justify-end" style={{background:'rgba(28,25,23,0.5)', backdropFilter:'blur(4px)'}} onClick={() => setShowMobileMenu(false)}>
          <div onClick={e => e.stopPropagation()} className="w-[82%] max-w-sm h-full overflow-y-auto animate-slide-right shadow-2xl flex flex-col" style={{background:'var(--cream)'}}>
            {/* Sidebar header */}
            <div className="px-6 pt-7 pb-5 border-b" style={{borderColor: 'var(--line)'}}>
              <div className="flex items-start justify-between gap-3">
                <div>
                  <div className="font-serif text-2xl italic leading-tight" style={{color:'var(--ink)'}}>Frida</div>
                  <div className="text-[9px] tracking-[0.3em] uppercase mt-1" style={{color:'var(--ink-soft)'}}>{user?.name || 'Atelier'}</div>
                </div>
                <button onClick={() => setShowMobileMenu(false)} className="p-1.5 -mr-1.5" style={{color:'var(--ink-soft)'}} aria-label="Close menu">
                  <Icon name="X" size={18} />
                </button>
              </div>
            </div>

            {/* Sections */}
            <div className="px-2 py-3 flex-1">
              <div className="text-[9px] tracking-[0.3em] uppercase px-4 pt-3 pb-2" style={{color:'var(--ink-soft)'}}>Sections</div>
              {tabs.map(t => (
                <button key={t.id} onClick={() => { openTopLevelTab(t.id); setShowMobileMenu(false); }} className="w-full flex items-center gap-3 px-4 py-3 text-left transition" style={{
                  background: activeTab === t.id ? 'var(--cream-deep)' : 'transparent',
                  borderLeft: activeTab === t.id ? '2px solid var(--accent)' : '2px solid transparent',
                  color: 'var(--ink)'
                }}>
                  <Icon name={t.icon} size={15} />
                  <span className="text-[12px] tracking-[0.1em] font-medium">{t.label}</span>
                </button>
              ))}

              <div className="text-[9px] tracking-[0.3em] uppercase px-4 pt-5 pb-2" style={{color:'var(--ink-soft)'}}>Account</div>
              {/* Direct entry to the Skin Profile wizard. Kept in the
                  hamburger menu only (May 2026 — Jenni's call): cover +
                  header entry points were removed because the wizard
                  has bugs and the Living Skin Profile rebuild is pending,
                  but the menu surface is two clicks deep so it's an
                  intentional dig-in rather than an accidental tap.
                  Bugs to fix in a follow-up pass. */}
              <button onClick={() => { setShowMobileMenu(false); setShowProfileModal(true); }} className="w-full flex items-center gap-3 px-4 py-3 text-left transition" style={{color:'var(--ink)'}}>
                <Icon name="Sparkles" size={15} style={{color:'var(--accent)'}} />
                <div className="flex-1">
                  <div className="text-[12px] tracking-[0.1em] font-medium">Clinical Skin Profile</div>
                  <div className="text-[10px] italic" style={{color:'var(--ink-soft)'}}>11-step science-backed setup</div>
                </div>
                {(userProfile.sunReactivity || userProfile.skinType || userProfile.monkSkinTone) && (
                  <span className="w-1.5 h-1.5 rounded-full" style={{background:'var(--accent-blue)'}} title="Profile started" />
                )}
              </button>
              <button onClick={() => { setShowMobileMenu(false); setShowYouModal(true); }} className="w-full flex items-center gap-3 px-4 py-3 text-left transition" style={{color:'var(--ink)'}}>
                <Icon name="User" size={15} /> <span className="text-[12px] tracking-[0.1em] font-medium">Profile</span>
              </button>
              <button onClick={() => { setShowMobileMenu(false); setShowSupabaseModal(true); }} className="w-full flex items-center gap-3 px-4 py-3 text-left transition" style={{color:'var(--ink)'}}>
                <Icon name="Cloud" size={15} /> <span className="text-[12px] tracking-[0.1em] font-medium">Cloud sync</span>
                {supaEnabled && <span className="ml-auto w-1.5 h-1.5 rounded-full" style={{background:'var(--accent-blue)'}} />}
              </button>
              <button onClick={() => { setShowMobileMenu(false); setShowApiKeyModal(true); }} className="w-full flex items-center gap-3 px-4 py-3 text-left transition" style={{color:'var(--ink)'}}>
                <Icon name="Key" size={15} /> <span className="text-[12px] tracking-[0.1em] font-medium">API key</span>
                {apiKey && <span className="ml-auto w-1.5 h-1.5 rounded-full" style={{background:'var(--accent-blue)'}} />}
              </button>
              <button onClick={() => { setShowMobileMenu(false); setShowSearch(true); }} className="w-full flex items-center gap-3 px-4 py-3 text-left transition" style={{color:'var(--ink)'}}>
                <Icon name="Search" size={15} /> <span className="text-[12px] tracking-[0.1em] font-medium">Search</span>
              </button>
              {/* Replay onboarding (May 2026 — Phase 3E follow-up).
                  Walks the user back through the 10-step wizard with their
                  current answers prefilled. Non-destructive: their products,
                  logs, regimenLogs, and existing profile answers are
                  preserved. Tapping Next on a step with no edit keeps the
                  prior value; tapping Skip leaves it (filled stays filled,
                  empty stays empty). Phase 3G will add a matching entry
                  point inside the Skin Profile / Insights surface. */}
              <button
                onClick={() => {
                  setShowMobileMenu(false);
                  setOnboardingState(prev => ({ ...prev, stage: 'welcome', skipped: false }));
                }}
                className="w-full flex items-center gap-3 px-4 py-3 text-left transition"
                style={{color:'var(--ink)'}}
              >
                <Icon name="RotateCcw" size={15} />
                <div className="flex-1">
                  <div className="text-[12px] tracking-[0.1em] font-medium">Replay onboarding</div>
                  <div className="text-[10px] italic" style={{color:'var(--ink-soft)'}}>Walk through the setup again</div>
                </div>
              </button>
              {/* Sunday Digest (May 2026 — roadmap item 2).
                  Opens the modal that summarizes the week + drops an
                  .ics calendar file with the digest body embedded.
                  Lives in the hamburger account drawer per Jenni's
                  file boundary — Journal/Home/Regimen are off-limits
                  this week. Two clicks deep so it doesn't compete
                  with daily-loop affordances. */}
              <button
                onClick={() => { setShowMobileMenu(false); setShowSundayDigest(true); }}
                className="w-full flex items-center gap-3 px-4 py-3 text-left transition"
                style={{color:'var(--ink)'}}
              >
                <Icon name="Calendar" size={15} style={{color:'var(--accent)'}} />
                <div className="flex-1">
                  <div className="text-[12px] tracking-[0.1em] font-medium">Sunday Digest</div>
                  <div className="text-[10px] italic" style={{color:'var(--ink-soft)'}}>This week, on one page — add to calendar</div>
                </div>
              </button>
              <button onClick={() => { setShowMobileMenu(false); handleSignOut(); }} className="w-full flex items-center gap-3 px-4 py-3 text-left transition" style={{color:'var(--ink-soft)'}}>
                <Icon name="LogOut" size={15} /> <span className="text-[12px] tracking-[0.1em] font-medium">Sign out</span>
              </button>
            </div>

            <div className="px-6 py-4 border-t text-[9px] tracking-[0.25em] uppercase italic" style={{borderColor: 'var(--line)', color:'var(--ink-soft)'}}>
              by Dr. Christina Gainey & Dr. Jenni Tang
            </div>
          </div>
        </div>
      )}

      {/* iOS INSTALL PROMPT */}
      {showInstallPrompt && (
        <div className="fixed bottom-20 left-4 right-4 z-50 max-w-md mx-auto">
          <div className="rounded-2xl shadow-2xl overflow-hidden animate-slide" style={{background:'var(--cream)', border: '1px solid var(--line)'}}>
            <div className="p-5">
              <div className="flex items-start justify-between gap-3 mb-3">
                <div>
                  <div className="text-[10px] tracking-[0.3em] uppercase" style={{color:'var(--ink-soft)'}}>Save your account</div>
                  <h3 className="font-serif text-xl italic mt-1" style={{color:'var(--ink)'}}>Add Frida to your home screen</h3>
                </div>
                <button onClick={() => {
                  localStorage.setItem('lumiere:installPromptDismissed', '1');
                  setShowInstallPrompt(false);
                }} style={{color:'var(--ink-soft)'}}>
                  <Icon name="X" size={18} />
                </button>
              </div>
              <p className="text-sm font-light leading-relaxed mb-4" style={{color:'var(--ink-soft)'}}>
                iOS Safari clears website data after 7 days. To keep your skin journal forever, install Frida to your home screen — it's free and takes 5 seconds.
              </p>
              <div className="space-y-2 text-sm font-light p-3 rounded-lg" style={{background:'var(--cream-deep)', color:'var(--ink)'}}>
                <div className="flex items-center gap-3">
                  <span className="text-[10px] tracking-[0.2em] uppercase font-medium w-6" style={{color:'var(--ink-soft)'}}>1</span>
                  <span>Tap the <span style={{display:'inline-block', verticalAlign:'middle'}}><svg width="16" height="20" viewBox="0 0 16 20" fill="currentColor"><path d="M8 0L4 4h3v8h2V4h3L8 0zM2 8v10h12V8h-2v8H4V8H2z"/></svg></span> Share button at the bottom of Safari</span>
                </div>
                <div className="flex items-center gap-3">
                  <span className="text-[10px] tracking-[0.2em] uppercase font-medium w-6" style={{color:'var(--ink-soft)'}}>2</span>
                  <span>Scroll down → tap <strong>Add to Home Screen</strong></span>
                </div>
                <div className="flex items-center gap-3">
                  <span className="text-[10px] tracking-[0.2em] uppercase font-medium w-6" style={{color:'var(--ink-soft)'}}>3</span>
                  <span>Tap <strong>Add</strong> — and use Frida from your home screen</span>
                </div>
              </div>
              <button onClick={() => {
                localStorage.setItem('lumiere:installPromptDismissed', '1');
                setShowInstallPrompt(false);
              }} className="w-full mt-3 py-3 tracking-[0.2em] text-[10px] uppercase" style={{background:'var(--ink)', color:'var(--cream)'}}>
                Got it
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Floating chat launcher REMOVED (May 2026 per Jenni): it duplicated
          the Ask Tang & Gainey action in the bottom-nav FAB. Cleaner
          surface area without it. setShowLauncher() still exists for
          launcher modal callers elsewhere — just no floating trigger. */}

      {showLauncher && (
        <div className="fixed inset-0 z-50 flex items-end justify-center md:items-center" style={{background:'rgba(28,25,23,0.5)', backdropFilter:'blur(4px)'}} onClick={() => setShowLauncher(false)}>
          <div onClick={e => e.stopPropagation()} className="w-full md:max-w-xl rounded-t-2xl md:rounded-lg p-5 md:p-7 max-h-[85vh] flex flex-col shadow-2xl" style={{background:'var(--cream)'}}>
            <div className="text-[10px] tracking-[0.32em] uppercase mb-1.5" style={{color:'var(--ink-soft)'}}>Frida · quick chat</div>
            <h3 className="font-serif text-[22px] md:text-2xl italic mb-1 leading-tight" style={{color:'var(--ink)'}}>
              {launcherMessages.length === 0 ? 'What would you like to do?' : 'Frida'}
            </h3>
            {launcherMessages.length === 0 && (
              <p className="text-[12px] font-light italic mb-4" style={{color:'var(--ink-soft)'}}>Ask anything — about your data, a concern, a product, an ingredient.</p>
            )}

            {/* === INLINE CHAT THREAD ===
                Renders above the input when there's a conversation. Stays
                INSIDE the launcher (no Counsel navigation). User bubbles
                terracotta, assistant bubbles cream-deep. Auto-scrolls to
                latest message via overflow-y on this column. */}
            {launcherMessages.length > 0 && (
              <div className="flex-1 overflow-y-auto -mx-1 px-1 py-2 space-y-2.5 mb-3" style={{minHeight:'160px', maxHeight:'50vh'}}>
                {launcherMessages.map((m, i) => (
                  <div key={i} className={`flex ${m.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                    <div className={`max-w-[85%] rounded-[14px] px-3 py-2 ${m.role === 'user' ? '' : 'font-serif italic'}`} style={{
                      background: m.role === 'user' ? 'var(--accent)' : 'var(--cream-deep)',
                      color: m.role === 'user' ? 'var(--cream)' : 'var(--ink)',
                      border: m.role === 'user' ? 'none' : '1px solid var(--line)',
                    }}>
                      <div className={`${m.role === 'user' ? 'text-[12px]' : 'text-[12.5px] leading-relaxed'} whitespace-pre-line`}>{m.content}</div>
                    </div>
                  </div>
                ))}
                {launcherChatLoading && (
                  <div className="flex justify-start">
                    <div className="px-3 py-2 rounded-[14px] flex items-center gap-2" style={{background:'var(--cream-deep)', border: '1px solid var(--line)'}}>
                      <Icon name="Loader2" size={11} className="spin" style={{color:'var(--accent)'}} />
                      <span className="text-[11px] italic" style={{color:'var(--ink-soft)'}}>Frida is thinking…</span>
                    </div>
                  </div>
                )}
              </div>
            )}

            <div className="border" style={{borderColor: 'var(--line)', background:'var(--cream-deep)'}}>
              <textarea autoCapitalize="off" autoCorrect="off" spellCheck={false}
                value={launcherInput}
                onChange={e => setLauncherInput(e.target.value)}
                onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleLauncherSubmit(); } }}
                placeholder={launcherMessages.length === 0 ? "Ask Frida anything…" : "Ask a follow-up…"}
                rows={launcherMessages.length === 0 ? '3' : '2'}
                autoFocus
                className="w-full px-3 py-2.5 border-0 focus:outline-none font-light italic text-[13px] resize-none"
                style={{background:'transparent', color:'var(--ink)'}}
              />
              <div className="flex items-center justify-between px-3 pb-2">
                <span className="text-[9px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)'}}>{launcherMessages.length > 0 ? 'Enter to send' : 'Enter to ask · or pick a shortcut'}</span>
                <button onClick={() => handleLauncherSubmit()} disabled={!launcherInput.trim() || launcherChatLoading} className="px-3 py-1.5 tracking-[0.2em] text-[10px] uppercase transition disabled:opacity-40 flex items-center gap-2" style={{background:'var(--ink)', color:'var(--cream)'}}>
                  <Icon name="ArrowUp" size={11} /> Send
                </button>
              </div>
            </div>

            {/* Shortcuts hide once a chat is in progress so the
                conversation stays focused. Re-appear when launcher reopens. */}
            {launcherMessages.length === 0 && (
            <div className="mt-6 overflow-y-auto" style={{maxHeight:'40vh'}}>
            <div>
              <div className="text-[10px] tracking-[0.3em] uppercase mb-3" style={{color:'var(--ink-soft)'}}>Assess</div>
              <div className="flex flex-wrap gap-2">
                <button onClick={() => { setShowLauncher(false); setShowCheckInChooser(true); }} className="text-[11px] tracking-[0.15em] uppercase px-4 py-2 border transition hover:border-[var(--ink)]" style={{borderColor: 'var(--line)', color:'var(--ink)'}}>Log today's skin</button>
                <button onClick={() => { setShowLauncher(false); if (logs.length >= 2) enterCompare(); else setActiveTab('journal'); }} className="text-[11px] tracking-[0.15em] uppercase px-4 py-2 border transition hover:border-[var(--ink)]" style={{borderColor: 'var(--line)', color:'var(--ink)'}}>Compare two entries</button>
              </div>
            </div>

            <div className="mt-5">
              <div className="text-[10px] tracking-[0.3em] uppercase mb-3" style={{color:'var(--ink-soft)'}}>Work on</div>
              <div className="flex flex-wrap gap-2">
                <button onClick={() => { setShowLauncher(false); setShowProductModal(true); }} className="text-[11px] tracking-[0.15em] uppercase px-4 py-2 border transition hover:border-[var(--ink)]" style={{borderColor: 'var(--line)', color:'var(--ink)'}}>Add a product</button>
                <button onClick={() => { setShowLauncher(false); setActiveTab('regimen'); setRegimenView('build'); }} className="text-[11px] tracking-[0.15em] uppercase px-4 py-2 border transition hover:border-[var(--ink)]" style={{borderColor: 'var(--line)', color:'var(--ink)'}}>Build my routine</button>
                <button onClick={() => { setShowLauncher(false); setShowEventModal(true); }} className="text-[11px] tracking-[0.15em] uppercase px-4 py-2 border transition hover:border-[var(--ink)]" style={{borderColor: 'var(--line)', color:'var(--ink)'}}>Plan an occasion</button>
                <button onClick={() => { setShowLauncher(false); setShowProcedureModal(true); }} className="text-[11px] tracking-[0.15em] uppercase px-4 py-2 border transition hover:border-[var(--ink)]" style={{borderColor: 'var(--line)', color:'var(--ink)'}}>Log a procedure</button>
              </div>
            </div>

            <div className="mt-5">
              <div className="text-[10px] tracking-[0.3em] uppercase mb-3" style={{color:'var(--ink-soft)'}}>Learn</div>
              <div className="flex flex-wrap gap-2">
                <button onClick={() => { setShowLauncher(false); setActiveTab('pearls'); setPearlsTab('lessons'); setPearlsLessonCategory('ingredients'); }} className="text-[11px] tracking-[0.15em] uppercase px-4 py-2 border transition hover:border-[var(--ink)]" style={{borderColor: 'var(--line)', color:'var(--ink)'}}>Browse Pearls</button>
                <button onClick={() => { setShowLauncher(false); setActiveTab('pearls'); setPearlsTab('qa'); }} className="text-[11px] tracking-[0.15em] uppercase px-4 py-2 border transition hover:border-[var(--ink)]" style={{borderColor: 'var(--line)', color:'var(--ink)'}}>Ask the science</button>
                <button onClick={() => { setShowLauncher(false); setActiveTab('pearls'); setPearlsTab('qa'); }} className="text-[11px] tracking-[0.15em] uppercase px-4 py-2 border transition hover:border-[var(--ink)]" style={{borderColor: 'var(--line)', color:'var(--ink)'}}>Ask Counsel about my skin</button>
              </div>
            </div>

            </div>
            )}

            <div className="mt-4 pt-3 border-t flex items-center justify-between gap-3" style={{borderColor: 'var(--line)'}}>
              {launcherMessages.length > 0 ? (
                <button onClick={() => { setLauncherMessages([]); setLauncherInput(''); }} className="text-[10px] tracking-[0.2em] uppercase italic flex items-center gap-1.5" style={{color:'var(--ink-soft)'}}>
                  <Icon name="RefreshCw" size={11} /> New chat
                </button>
              ) : (
                <button onClick={() => { setShowLauncher(false); setShowMobileMenu(true); }} className="text-[10px] tracking-[0.2em] uppercase italic flex items-center gap-1.5" style={{color:'var(--ink)'}}>
                  <Icon name="Menu" size={11} /> All sections
                </button>
              )}
              <button onClick={() => setShowLauncher(false)} className="text-[10px] tracking-[0.2em] uppercase italic" style={{color:'var(--ink-soft)'}}>Close</button>
            </div>
          </div>
        </div>
      )}

      {/* TOAST CONTAINER */}
      <div className="fixed bottom-24 md:bottom-6 right-6 z-50 space-y-2 pointer-events-none" style={{maxWidth:'360px'}}>
        {toasts.map(t => (
          <div key={t.id} className="pointer-events-auto px-4 py-3 shadow-lg border flex items-center gap-3 animate-slide" style={{
            background: t.type === 'error' ? '#fef0ef' : t.type === 'info' ? 'var(--cream-deep)' : 'var(--cream)',
            borderColor: t.type === 'error' ? '#d4a094' : 'var(--line)',
            color: 'var(--ink)'
          }}>
            <Icon name={t.type === 'error' ? 'AlertCircle' : t.type === 'info' ? 'Loader2' : 'Check'} size={14} className={t.type === 'info' ? 'spin' : ''} />
            <div className="text-sm font-light">{t.msg}</div>
          </div>
        ))}
      </div>

      <footer className="border-t mt-20 py-8 text-center" style={{borderColor: 'var(--line)'}}>
        <button onClick={exportToPDF} disabled={!logs.length} className="text-[10px] tracking-[0.3em] uppercase border px-4 py-2 mb-4 transition disabled:opacity-30 inline-flex items-center gap-2" style={{borderColor: 'var(--line)', color:'var(--ink-soft)'}}>
          <Icon name="Download" size={11} /> Export Diary as PDF
        </button>
        <div className="text-[9px] tracking-[0.3em] uppercase" style={{color:'var(--ink-soft)'}}>Frida — Get To Know Your Skin</div>
        <div className="font-serif italic text-sm mt-2" style={{color:'var(--ink-soft)'}}>"Care, in its quiet repetition."</div>
      </footer>
    </div>
  );
}




// Renders the small set of LESSONS tagged 'protocol' (cleansing, layering, sunscreen) as
// the Technique sub-view inside Regimen. Each lesson is a compact editorial card; tapping
// opens the full lesson modal via the parent's onOpenLesson handler.
const TECHNIQUE_LESSON_IDS = ['double-cleansing', 'sixty-second-cleanse', 'layering-order', 'sunscreen-mechanisms'];







const PatternCard = ({ insight, loading, onGenerate, entryCount, onOpenLesson }) => {
  const isStale = insight && (Date.now() - insight.generatedAt > 1000 * 60 * 60 * 24 * 7); // > 1 week
  const newEntriesSince = insight ? entryCount - insight.entryCount : 0;
  return (
    <div className="border p-8" style={{background:'linear-gradient(135deg, var(--cream-deep), #f0e8d8)', borderColor: 'var(--line)'}}>
      <div className="flex justify-between items-start gap-4 flex-wrap mb-4">
        <div>
          <div className="text-[10px] tracking-[0.3em] uppercase" style={{color:'var(--ink-soft)'}}>Patterns in your data</div>
          <h3 className="font-serif text-3xl italic mt-1" style={{color:'var(--ink)'}}>What your skin is telling you</h3>
        </div>
        <button onClick={onGenerate} disabled={loading} className="text-[10px] tracking-[0.2em] uppercase border px-4 py-2 transition disabled:opacity-50 flex items-center gap-2" style={{borderColor:'var(--ink)', color:'var(--ink)'}}>
          {loading ? <><Icon name="Loader2" size={11} className="spin" /> Analyzing</> : <><Icon name="Sparkles" size={11} /> {insight ? 'Refresh' : 'Analyze'}</>}
        </button>
      </div>
      {!insight && !loading && (
        <p className="text-sm font-light italic" style={{color:'var(--ink-soft)'}}>You have {entryCount} entries — enough for a meaningful pattern analysis. Tap analyze to surface correlations across your journal, products, and procedures.</p>
      )}
      {insight && (
        <>
          <div className="text-[10px] tracking-[0.2em] uppercase mb-3" style={{color:'var(--ink-soft)'}}>
            Generated {new Date(insight.generatedAt).toLocaleDateString('en-US', { month:'short', day:'numeric' })}
            {isStale && <span style={{marginLeft:8, color:'#a04555'}}>· refresh recommended</span>}
            {newEntriesSince > 0 && <span style={{marginLeft:8}}>· {newEntriesSince} new {newEntriesSince === 1 ? 'entry' : 'entries'} since</span>}
          </div>
          <div className="text-sm leading-relaxed font-light whitespace-pre-wrap" style={{color:'var(--ink)'}}>{withPearls(insight.content, onOpenLesson)}</div>
        </>
      )}
    </div>
  );
};

// Surfaces a "then vs now" prompt on the Atelier dashboard when the data warrants it.
// Logic: take the most recent photo log; look for a photo log 14–60 days earlier (target 30);
// prefer same area. If found, render a card with both thumbnails and a one-tap Compare CTA.
const CompareContextCard = ({ logs, enterCompare }) => {
  const photoLogs = logs.filter(l => l.photo);
  if (photoLogs.length < 2) return null;

  const sorted = [...photoLogs].sort((a, b) => new Date(b.date) - new Date(a.date));
  const recent = sorted[0];
  const recentDate = new Date(recent.date);

  const candidates = sorted.slice(1).map(l => {
    const days = Math.round((recentDate - new Date(l.date)) / (1000 * 60 * 60 * 24));
    if (days < 14 || days > 60) return null;
    const sameArea = l.area === recent.area;
    // Lower score = better. Penalty for area mismatch.
    const score = Math.abs(days - 30) + (sameArea ? 0 : 100);
    return { log: l, days, sameArea, score };
  }).filter(Boolean).sort((a, b) => a.score - b.score);

  const best = candidates[0];
  if (!best) return null;

  return (
    <div className="border p-4" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
      <div className="flex items-center gap-5 flex-wrap">
        <div className="flex gap-3 flex-shrink-0">
          <Photo item={best.log} alt="" className="w-16 h-16 object-cover rounded-sm" />
          <Photo item={recent} alt="" className="w-16 h-16 object-cover rounded-sm" />
        </div>
        <div className="flex-1 min-w-0">
          <div className="text-[10px] tracking-[0.3em] uppercase" style={{color:'var(--ink-soft)'}}>{best.days} days{best.sameArea ? ' · same area' : ''}</div>
          <h3 className="font-serif text-2xl italic mt-1" style={{color:'var(--ink)'}}>Then and now — see what's changed.</h3>
          <p className="text-sm font-light mt-1" style={{color:'var(--ink-soft)'}}>
            {best.log.rating}/10 → {recent.rating}/10
            {recent.rating > best.log.rating ? ' · trending upward' : recent.rating < best.log.rating ? ' · worth a closer look' : ' · steady'}
          </p>
        </div>
        <button onClick={() => enterCompare(best.log.id, recent.id)} className="text-[10px] tracking-[0.2em] uppercase px-4 py-2.5 flex items-center gap-1.5 transition flex-shrink-0" style={{background:'var(--ink)', color:'var(--cream)'}}>
          Compare <Icon name="ArrowRight" size={11} />
        </button>
      </div>
    </div>
  );
};

const QuickAction = ({ icon, label, desc, onClick }) => (
  <button onClick={onClick} className="w-full border p-5 transition text-left flex items-center gap-4" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
    <div className="w-10 h-10 flex items-center justify-center flex-shrink-0" style={{background:'var(--cream)', color:'var(--ink)'}}>
      <Icon name={icon} size={16} />
    </div>
    <div className="flex-1 min-w-0">
      <div className="font-serif italic" style={{color:'var(--ink)'}}>{label}</div>
      <div className="text-xs font-light truncate" style={{color:'var(--ink-soft)'}}>{desc}</div>
    </div>
    <Icon name="ChevronRight" size={14} className="flex-shrink-0" />
  </button>
);

const SectionHeader = ({ title, subtitle, action, actionLabel }) => (
  // Title scale matches the cover hero greeting (text-2xl md:text-4xl italic) for cross-page uniformity.
  <div className="flex justify-between items-end flex-wrap gap-3 mb-6 pb-3 border-b" style={{borderColor: 'var(--line)'}}>
    <div className="min-w-0">
      <h1 className="font-serif text-2xl md:text-4xl italic leading-[1.05] tracking-tight" style={{color:'var(--ink)'}}>{title}</h1>
      {subtitle && <div className="text-[11px] md:text-xs font-light italic mt-1 leading-snug" style={{color:'var(--ink-soft)'}}>{subtitle}</div>}
    </div>
    {action && (
      <button onClick={action} className="px-4 py-2 rounded-full tracking-[0.15em] text-[10px] uppercase transition flex items-center gap-1.5" style={{background:'var(--ink)', color:'var(--cream)'}}>
        <Icon name="Plus" size={11} /> {actionLabel}
      </button>
    )}
  </div>
);

const EmptyState = ({ icon, text, action, actionText }) => (
  <div className="border p-16 text-center" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
    <div className="flex justify-center mb-4 opacity-50" style={{color:'var(--ink-soft)'}}><Icon name={icon} size={32} /></div>
    <p className="font-serif italic text-xl mb-6" style={{color:'var(--ink)'}}>{text}</p>
    {action && <button onClick={action} className="px-6 py-3 tracking-[0.2em] text-[10px] uppercase" style={{background:'var(--ink)', color:'var(--cream)'}}>{actionText}</button>}
  </div>
);

const ProfileTrait = ({ label, value }) => (
  <div>
    <div className="text-[9px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)'}}>{label}</div>
    <div className="font-serif italic mt-0.5 capitalize" style={{color:'var(--ink)'}}>{value || '—'}</div>
  </div>
);

// Procedure card — collapsed default (date, type, photo intervals row); click to expand
// for full briefing, notes, results. The interval thumbnails pair the procedure with
// closest photos at day before, day after, 1mo, 2mo, 6mo, 1yr post-procedure.
const PROCEDURE_INTERVALS = [
  { days: -1, label: '−1d' },
  { days: 1, label: '+1d' },
  { days: 30, label: '1mo' },
  { days: 60, label: '2mo' },
  { days: 180, label: '6mo' },
  { days: 365, label: '1yr' },
];

const findClosestPhotoLog = (logs, targetISO, windowDays = 5) => {
  const target = new Date(targetISO).getTime();
  if (isNaN(target)) return null;
  const hasPhoto = (l) => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:'));
  const candidates = logs.filter(hasPhoto).map(l => ({
    log: l,
    diffDays: Math.abs((new Date(l.date).getTime() - target) / 86400000),
  })).filter(c => c.diffDays <= windowDays);
  candidates.sort((a, b) => a.diffDays - b.diffDays);
  return candidates[0]?.log || null;
};

const ProcedureCard = ({ procedure: p, logs = [], onOpenLesson, onOpenChat, onDelete, onPhotoClick, onUpdate, onEdit }) => {
  const [expanded, setExpanded] = useState(false);
  const today = new Date(); today.setHours(0, 0, 0, 0);
  const procDate = new Date(p.date);
  const intervals = PROCEDURE_INTERVALS.filter(i => {
    // Only render intervals that have already happened (target date <= today)
    const target = new Date(procDate.getTime() + i.days * 86400000);
    return target <= today;
  }).map(i => {
    const targetISO = localDateISO(new Date(procDate.getTime() + i.days * 86400000));
    const log = findClosestPhotoLog(logs, targetISO, i.days >= 30 ? 7 : 3);
    return { ...i, log, targetISO };
  });

  return (
    <div className="relative pb-6 group">
      <div className="absolute w-3 h-3 rounded-full" style={{left:'-25px', top:'8px', background:'var(--cream)', border:'2px solid var(--ink)'}}></div>
      <div className="border" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
        {/* Always visible header row */}
        <button onClick={() => setExpanded(!expanded)} className="w-full p-4 text-left flex items-center gap-3 transition hover:bg-[var(--cream-deep)]">
          <div className="flex-shrink-0 min-w-[72px]">
            <div className="text-[9px] tracking-[0.25em] uppercase" style={{color:'var(--ink-soft)'}}>{new Date(p.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</div>
            <div className="text-[8px] tracking-wider" style={{color:'var(--ink-soft)', opacity:0.7}}>{new Date(p.date).getFullYear()}</div>
          </div>
          <div className="flex-1 min-w-0">
            <div className="font-serif italic text-base md:text-lg leading-tight truncate" style={{color:'var(--ink)'}}>{p.name}</div>
            <div className="text-[10px] tracking-[0.15em] uppercase mt-0.5 truncate" style={{color:'var(--ink-soft)'}}>{p.type?.replace(/-/g, ' ')}{p.provider ? ` · ${p.provider}` : ''}</div>
          </div>
          <Icon name={expanded ? 'ChevronUp' : 'ChevronDown'} size={14} className="flex-shrink-0 opacity-50" />
        </button>

        {/* Photo intervals row — always visible if any */}
        {intervals.length > 0 && (
          <div className="px-4 pb-3">
            <div className="text-[9px] tracking-[0.25em] uppercase mb-2" style={{color:'var(--ink-soft)'}}>Progress</div>
            <div className="flex gap-1.5 overflow-x-auto">
              {intervals.map(iv => (
                <button key={iv.label} onClick={(e) => { if (iv.log && onPhotoClick) { e.stopPropagation(); onPhotoClick(iv.log); } }} className="flex-shrink-0 text-center" style={{cursor: iv.log ? 'pointer' : 'default'}}>
                  <div className="w-12 h-12 md:w-14 md:h-14 overflow-hidden" style={{background:'var(--cream-deep)', border: '1px solid var(--line)'}}>
                    {iv.log ? (
                      <Photo item={iv.log} alt="" className="w-full h-full object-cover"
                        renderFallback={() => (
                          <div className="w-full h-full flex items-center justify-center font-serif italic text-sm" style={{color:'var(--ink-soft)'}}>{iv.log.rating}</div>
                        )}
                      />
                    ) : (
                      <div className="w-full h-full flex items-center justify-center text-[10px]" style={{color:'var(--ink-soft)', opacity:0.5}}>—</div>
                    )}
                  </div>
                  <div className="text-[9px] tracking-wider mt-1" style={{color:'var(--ink-soft)'}}>{iv.label}</div>
                </button>
              ))}
            </div>
          </div>
        )}

        {/* Expanded details */}
        {expanded && (
          <div className="px-4 pb-4 pt-1 border-t" style={{borderColor: 'var(--line)'}}>
            <div className="mt-3 flex items-center gap-2 flex-wrap">
              <label className="text-[9px] tracking-[0.25em] uppercase" style={{color:'var(--ink-soft)'}}>Date</label>
              {onUpdate ? (
                <input
                  type="date"
                  value={p.date}
                  max={localDateISO()}
                  onClick={(e) => e.stopPropagation()}
                  onChange={(e) => onUpdate(p.id, { date: e.target.value })}
                  className="text-xs font-light border px-2 py-1"
                  style={{background:'var(--cream-deep)', borderColor: 'var(--line)', color:'var(--ink)'}}
                />
              ) : (
                <span className="text-xs font-light" style={{color:'var(--ink-soft)'}}>{new Date(p.date).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}</span>
              )}
              {p.cost && <span className="text-xs font-light" style={{color:'var(--ink-soft)'}}>· {p.cost}</span>}
            </div>
            {p.notes && <p className="text-sm mt-2 font-light" style={{color:'var(--ink)'}}>{p.notes}</p>}
            {p.results && (
              <div className="mt-3 pt-3 border-t" style={{borderColor: 'var(--line)'}}>
                <span className="text-[9px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)'}}>Results</span>
                <p className="text-sm italic font-light mt-0.5" style={{color:'var(--ink)'}}>{p.results}</p>
              </div>
            )}
            {p.aiAnalysis && <ProcedureBriefing analysis={p.aiAnalysis} onOpenLesson={onOpenLesson} />}
            {p.aiAnalysis && onOpenChat && (
              <button onClick={(e) => { e.stopPropagation(); onOpenChat(p); }} className="mt-3 text-[10px] tracking-[0.2em] uppercase italic flex items-center gap-1" style={{color:'var(--ink)'}}>
                <Icon name="MessageCircle" size={11} /> Ask follow-up
              </button>
            )}
            {p.analyzing && !p.aiAnalysis && (
              <div className="mt-3 pt-3 border-t flex items-center gap-2 pulse-soft" style={{borderColor: 'var(--line)', color:'var(--ink-soft)'}}>
                <Icon name="Loader2" size={12} className="spin" />
                <span className="text-[10px] tracking-[0.2em] uppercase">Generating evidence-based briefing…</span>
              </div>
            )}
            <div className="mt-3 flex justify-end gap-3">
              {onEdit && (
                <button onClick={(e) => { e.stopPropagation(); onEdit(); }} className="text-[10px] tracking-[0.15em] uppercase italic flex items-center gap-1" style={{color:'var(--ink)'}}>
                  <Icon name="Edit2" size={10} /> Edit
                </button>
              )}
              <button onClick={(e) => { e.stopPropagation(); onDelete?.(p.id); }} className="text-[10px] tracking-[0.15em] uppercase" style={{color:'var(--ink-soft)'}}>Remove</button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

// Event card — same expand-on-click pattern as ProcedureCard. Default shows name +
// days-until + 2 lines of plan preview. Expanded shows full plan and notes.
const EventCard = ({ event: e, onOpenChat, onDelete }) => {
  const [expanded, setExpanded] = useState(false);
  const days = Math.ceil((new Date(e.date) - new Date()) / 86400000);
  const planPreview = e.plan ? e.plan.split('\n').slice(0, 2).join(' ') : null;

  return (
    <div className="border" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
      <button onClick={() => setExpanded(!expanded)} className="w-full p-4 md:p-5 text-left transition hover:bg-[var(--cream-deep)]">
        <div className="flex items-baseline gap-3 flex-wrap mb-1.5">
          {days >= 0 ? (
            <div className="text-[9px] tracking-[0.25em] uppercase px-2 py-0.5" style={{background:'var(--ink)', color:'var(--cream)'}}>{days === 0 ? 'Today' : `In ${days} ${days === 1 ? 'day' : 'days'}`}</div>
          ) : (
            <div className="text-[9px] tracking-[0.25em] uppercase line-through" style={{color:'var(--ink-soft)'}}>Past</div>
          )}
          <div className="text-[9px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)'}}>{e.priority} priority</div>
        </div>
        <div className="flex justify-between items-start gap-3">
          <div className="flex-1 min-w-0">
            <h3 className="font-serif text-xl md:text-2xl italic leading-tight" style={{color:'var(--ink)'}}>{e.name}</h3>
            <div className="text-[10px] tracking-[0.15em] uppercase mt-0.5" style={{color:'var(--ink-soft)'}}>{new Date(e.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</div>
            {!expanded && planPreview && (
              <p className="text-sm font-light italic mt-2 leading-relaxed line-clamp-2" style={{color:'var(--ink-soft)'}}>{planPreview}</p>
            )}
            {!expanded && !planPreview && e.notes && (
              <p className="text-sm font-light italic mt-2 leading-relaxed line-clamp-2" style={{color:'var(--ink-soft)'}}>{e.notes}</p>
            )}
          </div>
          <Icon name={expanded ? 'ChevronUp' : 'ChevronDown'} size={14} className="flex-shrink-0 opacity-50 mt-1" />
        </div>
      </button>

      {expanded && (
        <div className="px-4 md:px-5 pb-5 pt-1 border-t" style={{borderColor: 'var(--line)'}}>
          {e.notes && <p className="text-sm mt-3 font-light" style={{color:'var(--ink)'}}>{e.notes}</p>}
          {e.plan && (
            <div className="mt-4">
              <div className="text-[10px] tracking-[0.2em] uppercase mb-2 flex items-center gap-1" style={{color:'var(--ink-soft)'}}>
                <Icon name="Sparkles" size={11} /> Prep Plan
              </div>
              <div className="text-sm whitespace-pre-wrap leading-relaxed font-light" style={{color:'var(--ink)'}}>{e.plan}</div>
              {onOpenChat && (
                <button onClick={(ev) => { ev.stopPropagation(); onOpenChat(e); }} className="mt-3 text-[10px] tracking-[0.2em] uppercase italic flex items-center gap-1" style={{color:'var(--ink)'}}>
                  <Icon name="MessageCircle" size={11} /> Ask follow-up
                </button>
              )}
            </div>
          )}
          {e.analyzing && !e.plan && (
            <div className="mt-4 flex items-center gap-2 pulse-soft" style={{color:'var(--ink-soft)'}}>
              <Icon name="Loader2" size={12} className="spin" />
              <span className="text-[10px] tracking-[0.2em] uppercase">Generating prep plan…</span>
            </div>
          )}
          <div className="mt-3 flex justify-end">
            <button onClick={(ev) => { ev.stopPropagation(); onDelete?.(e.id); }} className="text-[10px] tracking-[0.15em] uppercase" style={{color:'var(--ink-soft)'}}>Remove</button>
          </div>
        </div>
      )}
    </div>
  );
};

const ProcedureBriefing = ({ analysis, onOpenLesson }) => {
  const [expanded, setExpanded] = useState(false);
  // Try to parse structured sections (WHAT IT DOES:, RECOVERY:, etc.)
  const sections = [];
  const headers = ['WHAT IT DOES', 'EXPECTED TIMELINE', 'RECOVERY & DOWNTIME', 'POST-CARE PROTOCOL', 'RECOMMENDED FREQUENCY', 'COMPLEMENTARY TREATMENTS', 'RED FLAGS', 'EVIDENCE NOTE'];
  let remaining = analysis;
  headers.forEach((h, i) => {
    const regex = new RegExp(`${h}:\\s*([\\s\\S]*?)(?=(${headers.slice(i+1).join('|')}):|$)`, 'i');
    const match = analysis.match(regex);
    if (match) sections.push({ header: h, body: match[1].trim() });
  });

  if (sections.length === 0) {
    // Fallback to raw display
    return (
      <div className="mt-3 pt-3 border-t" style={{borderColor: 'var(--line)'}}>
        <div className="text-[9px] tracking-[0.2em] uppercase mb-2 flex items-center gap-1" style={{color:'var(--ink-soft)'}}>
          <Icon name="Sparkles" size={10} /> Briefing
        </div>
        <div className="text-xs leading-relaxed font-light whitespace-pre-wrap" style={{color:'var(--ink)'}}>{withPearls(analysis, onOpenLesson)}</div>
      </div>
    );
  }

  const shown = expanded ? sections : sections.slice(0, 3);
  return (
    <div className="mt-3 pt-3 border-t" style={{borderColor: 'var(--line)'}}>
      <div className="text-[9px] tracking-[0.2em] uppercase mb-3 flex items-center gap-1" style={{color:'var(--ink-soft)'}}>
        <Icon name="Sparkles" size={10} /> Evidence-Based Briefing
      </div>
      <div className="space-y-3">
        {shown.map(s => (
          <div key={s.header}>
            <div className="text-[9px] tracking-[0.2em] uppercase font-medium" style={{color:'var(--ink-soft)'}}>{s.header}</div>
            <div className="text-xs leading-relaxed font-light mt-0.5 whitespace-pre-wrap" style={{color:'var(--ink)'}}>{s.body}</div>
          </div>
        ))}
      </div>
      {sections.length > 3 && (
        <button onClick={() => setExpanded(!expanded)} className="mt-3 text-[10px] tracking-[0.2em] uppercase italic" style={{color:'var(--ink-soft)'}}>
          {expanded ? '— Show less' : `+ Show ${sections.length - 3} more sections`}
        </button>
      )}
    </div>
  );
};

const ProcedureRecommendations = ({ logs, procedures, callClaude, setShowApiKeyModal }) => {
  const [recs, setRecs] = useState('');
  const [loading, setLoading] = useState(false);
  const fetchRecs = async () => {
    if (!getApiKey()) { setShowApiKeyModal(true); return; }
    setLoading(true);
    try {
      const ctx = `Recent skin: ${logs.slice(0, 15).map(l => `${l.date} ${l.area} ${l.rating}/10 [${l.concerns?.join(',') || ''}]`).join('; ')}\nPast procedures: ${procedures.map(p => p.name).join(', ') || 'none'}`;
      const r = await callClaude(`${ctx}\n\nBased on this user's tracked skin patterns and concerns, recommend 3-4 evidence-based in-office procedures or treatments that could benefit them. For each, explain mechanism, ideal candidates, expected results, downtime, and rough cost range. Be specific and only recommend procedures with strong clinical evidence.`, '', null, { voice: true });
      setRecs(r);
    } catch (e) { if (!e.message.includes('API key')) setRecs('Unable to load recommendations.'); }
    setLoading(false);
  };
  return (
    <div className="border p-6 mb-8" style={{background:'linear-gradient(135deg, var(--cream-deep), var(--cream))', borderColor: 'var(--line)'}}>
      <div className="flex justify-between items-start gap-4 flex-wrap">
        <div>
          <div className="text-[10px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)'}}>Curated for you</div>
          <h3 className="font-serif text-xl italic mt-1" style={{color:'var(--ink)'}}>Recommended Procedures</h3>
          <p className="text-xs font-light mt-1" style={{color:'var(--ink-soft)'}}>Based on your tracked patterns and concerns.</p>
        </div>
        {!recs && (
          <button onClick={fetchRecs} disabled={loading} className="text-[10px] tracking-[0.2em] uppercase border px-4 py-2 transition disabled:opacity-50 flex items-center gap-2" style={{borderColor:'var(--ink)', color:'var(--ink)'}}>
            {loading ? <><Icon name="Loader2" size={11} className="spin" /> Curating</> : <><Icon name="Sparkles" size={11} /> Get Recommendations</>}
          </button>
        )}
      </div>
      {recs && <div className="mt-4 pt-4 border-t text-sm whitespace-pre-wrap leading-relaxed font-light" style={{borderColor: 'var(--line)', color:'var(--ink)'}}>{recs}</div>}
    </div>
  );
};

// === ERROR BOUNDARY ===
// Catches any runtime render error and surfaces it visibly so we never get a blank
// page again. Without this, a thrown error in any descendant unmounts the entire
// app and shows nothing — exactly the failure mode we just hit.
class AppErrorBoundary extends React.Component {
  constructor(props) { super(props); this.state = { error: null, info: null }; }
  static getDerivedStateFromError(error) { return { error }; }
  componentDidCatch(error, info) {
    console.error('[AppErrorBoundary]', error, info);
    this.setState({ info });
  }
  render() {
    if (this.state.error) {
      const msg = String(this.state.error?.message || this.state.error);
      const stk = String(this.state.error?.stack || '').split('\n').slice(0, 8).join('\n');
      return React.createElement('div', { style: { padding: '24px', fontFamily: 'Figtree, Inter, system-ui, sans-serif', maxWidth: '720px', margin: '40px auto', background: '#FFFFFF', border: '1px solid #E53C2D', borderRadius: '12px', color: '#221B18' } },
        React.createElement('div', { style: { fontFamily: 'Figtree, Inter, system-ui, sans-serif', fontWeight: 700, fontSize: '24px', marginBottom: '12px' } }, 'Something hiccuped while rendering.'),
        React.createElement('div', { style: { fontSize: '12px', color: '#786a5e', marginBottom: '16px' } }, "Don't worry — your data is safe. Reload to try again, or send this to support:"),
        React.createElement('pre', { style: { fontSize: '11px', background: '#F9DCE5', padding: '12px', borderRadius: '8px', overflow: 'auto', whiteSpace: 'pre-wrap', wordBreak: 'break-word', color: '#221B18' } }, msg + '\n\n' + stk),
        React.createElement('button', { onClick: () => location.reload(), style: { marginTop: '16px', padding: '10px 20px', background: '#221B18', color: '#FFFFFF', border: 'none', borderRadius: '999px', fontSize: '11px', letterSpacing: '0.2em', textTransform: 'uppercase', cursor: 'pointer' } }, 'Reload')
      );
    }
    return this.props.children;
  }
}

// Hide the loading screen unconditionally on first paint so we never get stuck on it.
window.addEventListener('error', (e) => { console.error('[window.onerror]', e.error || e.message); });

ReactDOM.createRoot(document.getElementById('root')).render(
  React.createElement(AppErrorBoundary, null, React.createElement(App))
);
