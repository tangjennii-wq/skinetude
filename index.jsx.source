// === LOCALSTORAGE HELPERS (replaces window.storage) ===
// Test localStorage availability up-front
let storageAvailable = false;
try {
  const t = '__lumiere_test__';
  localStorage.setItem(t, t);
  localStorage.removeItem(t);
  storageAvailable = true;
} catch (e) {
  console.error('localStorage is not available:', e);
}

const storage = {
  get: async (key) => {
    if (!storageAvailable) return null;
    try {
      const v = localStorage.getItem(`lumiere:${key}`);
      return v ? { value: v } : null;
    } catch (e) {
      console.error('storage.get failed for', key, e);
      return null;
    }
  },
  set: async (key, value) => {
    if (!storageAvailable) throw new Error('Storage unavailable');
    try {
      localStorage.setItem(`lumiere:${key}`, value);
      return { value };
    } catch (e) {
      console.error('storage.set failed for', key, e);
      throw e;
    }
  },
  delete: async (key) => {
    if (!storageAvailable) return { deleted: false };
    try {
      localStorage.removeItem(`lumiere:${key}`);
      return { deleted: true };
    } catch (e) {
      return { deleted: false };
    }
  }
};

// Debug: expose storage state for troubleshooting
window.__lumiereDebug = () => {
  const keys = Object.keys(localStorage).filter(k => k.startsWith('lumiere:'));
  console.log('Storage available:', storageAvailable);
  console.log('Lumiere keys in localStorage:', keys);
  keys.forEach(k => console.log(`  ${k}:`, localStorage.getItem(k)?.slice(0, 100)));
  return { available: storageAvailable, keys };
};

// === API KEY MANAGEMENT ===
// Bug #5 (May 31 2026): iOS Safari Private mode throws QuotaExceededError on
// localStorage operations. getApiKey is called hundreds of times — first
// throw in a private session was uncaught. Wrap both in try/catch so the
// app degrades to "no key" instead of crashing.
const getApiKey = () => {
  try { return localStorage.getItem('lumiere:apiKey') || ''; }
  catch { return ''; }
};
const setApiKey = (k) => {
  try { localStorage.setItem('lumiere:apiKey', k); return true; }
  catch (e) { console.warn('[setApiKey] localStorage unavailable', e); return false; }
};

// === GEMINI API KEY / PROXY ===
// The Gemini key is no longer shipped in the client bundle. By default all
// Gemini calls go through a Supabase Edge Function (`gemini-proxy`) which
// holds the key as a server secret and enforces per-device daily caps
// (30 image gens, 100 text/vision calls). See supabase/functions/gemini-proxy/.
//
// Users can still bring their own Gemini key (Settings → API key) — when set,
// the app talks to Google directly and bypasses the proxy + caps.
const SUPABASE_PROXY_URL = 'https://vdtmflgetzilcgtcsogt.supabase.co/functions/v1/gemini-proxy';
// Retired keys — if any of these are still stuck in a user's localStorage from
// the old hardcoded-default era, drop them silently so we route through the proxy.
const RETIRED_GEMINI_KEYS = [
  'AIzaSyACBlFyOukgnhCf8FAz8ui466AL_iXP3tk',
  'AIzaSyDz4qNdG10ocEzGzGWz5Ofj__2wqhb3wJ8',
];
const getGeminiKey = () => {
  try {
    const stored = localStorage.getItem('lumiere:geminiKey');
    if (stored && RETIRED_GEMINI_KEYS.includes(stored)) {
      try { localStorage.removeItem('lumiere:geminiKey'); } catch {}
      try { localStorage.removeItem('lumiere:geminiModelWorking'); } catch {}
      return '';
    }
    return stored || '';
  } catch { return ''; }
};
const setGeminiKey = (k) => {
  try { localStorage.setItem('lumiere:geminiKey', k); return true; }
  catch (e) { console.warn('[setGeminiKey] localStorage unavailable', e); return false; }
};
// Stable per-device identifier used by the proxy for rate limiting. Generated
// once on first call and persisted; clearing localStorage resets the daily cap
// (which is fine — these limits exist to slow abuse, not to be uncircumventable).
const getDeviceId = () => {
  let id = localStorage.getItem('lumiere:deviceId');
  if (!id || !/^[a-f0-9-]{16,64}$/i.test(id)) {
    id = (crypto.randomUUID && crypto.randomUUID()) ||
         (Date.now().toString(16) + Math.random().toString(16).slice(2) + Math.random().toString(16).slice(2)).slice(0, 36);
    localStorage.setItem('lumiere:deviceId', id);
  }
  return id;
};
// Single funnel for all Gemini calls. If the user has their own key in
// localStorage, hit Google directly. Otherwise route through the Supabase proxy.
// Returns the parsed JSON Gemini response (same shape either way) so existing
// caller logic doesn't have to change.
const callGeminiProxied = async ({ mode, model, payload, signal }) => {
  const userKey = getGeminiKey();
  if (userKey) {
    // BYO-key path — talk to Google directly, no caps.
    const url = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${encodeURIComponent(userKey)}`;
    const resp = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
      signal,
    });
    return { resp, viaProxy: false };
  }
  const resp = await fetch(SUPABASE_PROXY_URL, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'x-device-id': getDeviceId(),
    },
    body: JSON.stringify({ mode, model, payload }),
    signal,
  });
  return { resp, viaProxy: true };
};
// Remember the first Gemini image model that worked for this key so we can hit it
// directly on subsequent calls instead of paying the cost of trying the full
// fallback chain (each 404 in the chain is ~1s of wasted latency).
// Cleared whenever an auth/model error fires so a key swap re-discovers.
const getLastWorkingGeminiModel = () => localStorage.getItem('lumiere:geminiModelWorking') || null;
const setLastWorkingGeminiModel = (m) => { if (m) localStorage.setItem('lumiere:geminiModelWorking', m); };
const clearLastWorkingGeminiModel = () => localStorage.removeItem('lumiere:geminiModelWorking');
// Cached generated images keyed by product slug. Stored as data URIs so the row
// renders instantly on subsequent loads — no re-generation cost.
const getGeneratedProductArt = () => {
  try { return JSON.parse(localStorage.getItem('lumiere:generatedProductArt') || '{}'); }
  catch { return {}; }
};
const setGeneratedProductArt = (obj) => {
  try { localStorage.setItem('lumiere:generatedProductArt', JSON.stringify(obj)); } catch {}
};

// === SUPABASE SETUP ===
// Hardcoded credentials — anyone using this site gets cloud sync automatically
const SUPABASE_URL = 'https://vdtmflgetzilcgtcsogt.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_FyzirLiY3jyDInsZBWIOHA_32SX5aH6';

const getSupabaseConfig = () => ({
  url: localStorage.getItem('lumiere:supabaseUrl') || SUPABASE_URL,
  anonKey: localStorage.getItem('lumiere:supabaseKey') || SUPABASE_ANON_KEY
});
const setSupabaseConfig = (url, anonKey) => {
  localStorage.setItem('lumiere:supabaseUrl', url);
  localStorage.setItem('lumiere:supabaseKey', anonKey);
};

// Resilient Supabase initialization.
// The supabase-js CDN script may not be ready when this script first runs (slow network,
// blocking extensions, intermittent CDN). We poll for window.supabase up to ~5s, mark the
// status reactively, and let any UI subscribed via onSupabaseStateChange react to changes.
//
// State machine: 'pending' → 'connected' or 'failed' or 'disabled' (no creds configured).
let supabaseClient = null;
let supabaseInitState = 'pending';
let supabaseInitListeners = [];

const _notifySupabaseListeners = () => {
  const snapshot = { state: supabaseInitState, client: supabaseClient };
  supabaseInitListeners.forEach(fn => { try { fn(snapshot); } catch (_) {} });
};

const onSupabaseStateChange = (fn) => {
  supabaseInitListeners.push(fn);
  // Fire immediately with current state so subscribers don't miss the initial value
  try { fn({ state: supabaseInitState, client: supabaseClient }); } catch (_) {}
  return () => { supabaseInitListeners = supabaseInitListeners.filter(f => f !== fn); };
};

const _attemptSupabaseInit = () => {
  if (supabaseClient) return true;
  const { url, anonKey } = getSupabaseConfig();
  if (!url || !anonKey) {
    if (supabaseInitState !== 'disabled') {
      supabaseInitState = 'disabled';
      _notifySupabaseListeners();
    }
    return false;
  }
  if (!window.supabase || !window.supabase.createClient) return false; // library not yet loaded
  try {
    supabaseClient = window.supabase.createClient(url, anonKey, {
      auth: { persistSession: true, autoRefreshToken: true }
    });
    supabaseInitState = 'connected';
    _notifySupabaseListeners();
    return true;
  } catch (e) {
    console.error('Supabase init failed:', e);
    supabaseInitState = 'failed';
    _notifySupabaseListeners();
    return false;
  }
};

// Try once now; if it doesn't take, poll for the library to load.
if (!_attemptSupabaseInit() && supabaseInitState === 'pending') {
  let attempts = 0;
  const POLL_MS = 100;
  const MAX_ATTEMPTS = 50; // 5 seconds total
  const pollId = setInterval(() => {
    attempts++;
    if (_attemptSupabaseInit()) {
      clearInterval(pollId);
    } else if (attempts >= MAX_ATTEMPTS) {
      clearInterval(pollId);
      if (supabaseInitState === 'pending') {


        supabaseInitState = 'failed';
        _notifySupabaseListeners();
      }
    }
  }, POLL_MS);
}

// Manual retry — used by the "Retry connection" button if init fails.
const retrySupabaseInit = () => {
  if (supabaseClient) return true;
  // Reset state and try again
  supabaseInitState = 'pending';
  _notifySupabaseListeners();
  if (_attemptSupabaseInit()) return true;
  // Poll again briefly
  let attempts = 0;
  const pollId = setInterval(() => {
    attempts++;
    if (_attemptSupabaseInit() || attempts >= 30) {
      clearInterval(pollId);
      if (!supabaseClient && supabaseInitState === 'pending') {
        supabaseInitState = 'failed';
        _notifySupabaseListeners();
      }
    }
  }, 100);
  return false;
};

const isSupabaseEnabled = () => supabaseInitState === 'connected';
const getSupabaseInitState = () => supabaseInitState;

// === PHOTO STORAGE (Supabase Storage) ===
// Photos live in a private bucket keyed by user_id. RLS in Supabase enforces that users
// can only read/write photos in their own folder. Locally we store only the storage path
// (e.g. "user-id/photo-id.jpg") on log/product objects, never the base64 itself.
const PHOTO_BUCKET = 'etude-photos';
const PHOTO_CAP_PER_USER = 365; // hard cap; oldest non-anchor photos are pruned past this
const PHOTO_USER_SOFT_CAP_BYTES = 50 * 1024 * 1024; // 50 MB per user — pre-upload check
const SIGNED_URL_TTL_S = 60 * 60; // 1 hour

// In-memory cache of signed URLs for the session. Fetched lazily; expire 1 minute before
// the actual TTL to avoid edge-case stale URLs.
const _signedUrlCache = new Map(); // path -> { url, expiresAt }

const _b64ToBlob = (dataUrl) => {
  const m = dataUrl.match(/^data:image\/(\w+);base64,(.+)$/);
  if (!m) return null;
  const mime = `image/${m[1]}`;
  const binary = atob(m[2]);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  return { blob: new Blob([bytes], { type: mime }), ext: m[1] === 'jpeg' ? 'jpg' : m[1] };
};

// Upload a base64 data URL to Storage. Returns { path, error }.
const uploadPhotoToStorage = async (userId, base64DataUrl) => {
  if (!supabaseClient) return { path: null, error: 'Cloud sync not connected' };
  if (!userId) return { path: null, error: 'No user id' };
  const converted = _b64ToBlob(base64DataUrl);
  if (!converted) return { path: null, error: 'Invalid image data' };

  // === MAY 2026 DEFENSIVE: verify the Supabase session before upload ===
  // RLS bug we're fixing: bucket policy is
  //   auth.uid()::text = (storage.foldername(name))[1]
  // If the Supabase auth session is missing or expired, auth.uid() returns
  // null inside the policy and the upload fails with "new row violates
  // row-level security policy" — a cryptic error that gives the user no
  // path forward. This guard:
  //   1. Confirms we have a live session.
  //   2. Tries refreshSession() once if the session is missing/expired —
  //      handles the common case where the access token aged out while
  //      the tab was idle and autoRefresh didn't fire yet.
  //   3. Confirms session.user.id matches the userId param so we never
  //      try to upload into someone else's folder.
  //   4. Returns a clear, actionable error if any step fails.
  try {
    let { data: sessData, error: sessErr } = await supabaseClient.auth.getSession();
    let session = sessData?.session || null;
    if (sessErr || !session) {
      // Try one refresh — covers expired-token-mid-session case.
      const { data: refreshData } = await supabaseClient.auth.refreshSession();
      session = refreshData?.session || null;
    }
    if (!session) {
      return { path: null, error: 'Session expired — sign out and sign back in to upload photos' };
    }
    if (session.user?.id && session.user.id !== userId) {
      return { path: null, error: 'Session mismatch — sign out and sign back in' };
    }
  } catch (e) {
    return { path: null, error: 'Could not verify session: ' + (e.message || e) };
  }

  const photoId = `${Date.now()}-${Math.random().toString(36).slice(2, 9)}`;
  const path = `${userId}/${photoId}.${converted.ext}`;
  const { error } = await supabaseClient.storage
    .from(PHOTO_BUCKET)
    .upload(path, converted.blob, { contentType: converted.blob.type, upsert: false });
  if (error) {
    // Translate the cryptic RLS message into something the user can act on.
    const msg = error.message || '';
    if (/row-level security|RLS|policy/i.test(msg)) {
      return { path: null, error: 'Cloud sync rejected the photo — your sign-in may have expired. Sign out and back in to fix.' };
    }
    return { path: null, error: msg };
  }
  return { path, error: null };
};

// Get a signed URL for a stored photo path. Cached in memory for the session.
const getSignedPhotoUrl = async (path) => {
  if (!path || !supabaseClient) return null;
  const cached = _signedUrlCache.get(path);
  if (cached && cached.expiresAt > Date.now()) return cached.url;
  try {
    const { data, error } = await supabaseClient.storage
      .from(PHOTO_BUCKET)
      .createSignedUrl(path, SIGNED_URL_TTL_S);
    if (error) {
      console.error('Signed URL error:', error);
      return null;
    }
    _signedUrlCache.set(path, {
      url: data.signedUrl,
      expiresAt: Date.now() + (SIGNED_URL_TTL_S - 60) * 1000,
    });
    return data.signedUrl;
  } catch (e) {
    console.error('getSignedPhotoUrl failed:', e);
    return null;
  }
};

// Delete a photo from Storage. Returns boolean success.
const deletePhotoFromStorage = async (path) => {
  if (!path || !supabaseClient) return false;
  try {
    const { error } = await supabaseClient.storage
      .from(PHOTO_BUCKET)
      .remove([path]);
    if (error) { console.error('Photo delete error:', error); return false; }
    _signedUrlCache.delete(path);
    return true;
  } catch (e) {
    console.error('deletePhotoFromStorage failed:', e);
    return false;
  }
};

// Returns { bytes, count } for the current user's photos. Used to enforce the soft cap
// and to surface usage info in settings.
const getUserStorageStats = async (userId) => {
  if (!userId || !supabaseClient) return { bytes: 0, count: 0 };
  try {
    const { data, error } = await supabaseClient.storage
      .from(PHOTO_BUCKET)
      .list(userId, { limit: 1000 });
    if (error) { console.error('Storage stats error:', error); return { bytes: 0, count: 0 }; }
    const bytes = (data || []).reduce((s, f) => s + (f.metadata?.size || 0), 0);
    return { bytes, count: (data || []).length };
  } catch (e) {
    console.error('getUserStorageStats failed:', e);
    return { bytes: 0, count: 0 };
  }
};

// Fetch a stored photo as base64 (data URL). Used by AI vision flows that need to send
// the image to Anthropic. Hits the signed URL, downloads bytes, encodes.
const fetchPhotoAsBase64 = async (path) => {
  if (!path) return null;
  const url = await getSignedPhotoUrl(path);
  if (!url) return null;
  try {
    const resp = await fetch(url);
    if (!resp.ok) return null;
    const blob = await resp.blob();
    return await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onloadend = () => resolve(reader.result);
      reader.onerror = reject;
      reader.readAsDataURL(blob);
    });
  } catch (e) {
    console.error('fetchPhotoAsBase64 failed:', e);
    return null;
  }
};

// Resolve a log/product/etc to whatever it has — new photoPath takes priority over
// legacy base64 in the photo field. Returns { path, legacyDataUrl }.
const _resolvePhotoSource = (item) => {
  if (!item) return { path: null, legacyDataUrl: null };
  const path = item.photoPath || null;
  const photoStr = typeof item.photo === 'string' ? item.photo : null;
  const legacyDataUrl = (photoStr && photoStr.startsWith('data:')) ? photoStr : null;
  return { path, legacyDataUrl };
};

// === PHOTO CAP & ANCHOR CLEANUP ===
// When a user passes 365 photos, we keep one "anchor" photo per year-month — the
// highest-rated photo that month — so year-over-year comparison stays possible. Beyond
// the anchors, we trim oldest non-anchor photos until back at the cap.
//
// Returns { toDeletePaths, updatedLogs, trimmed }. Does NOT mutate; the caller is
// responsible for deleting from Storage and persisting the updated logs.
const computePhotoCleanup = (logs) => {
  const withPhotos = logs.filter(l => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:')));
  if (withPhotos.length <= PHOTO_CAP_PER_USER) {
    return { toDeletePaths: [], updatedLogs: logs, trimmed: 0 };
  }
  // Anchor per year-month: highest-rated photo. Ties go to the latest in the month.
  const anchorByMonth = new Map();
  withPhotos.forEach(l => {
    const key = new Date(l.date).toISOString().slice(0, 7);
    const cur = anchorByMonth.get(key);
    if (!cur || +l.rating > +cur.rating || (+l.rating === +cur.rating && new Date(l.date) > new Date(cur.date))) {
      anchorByMonth.set(key, l);
    }
  });
  const anchorIds = new Set([...anchorByMonth.values()].map(l => l.id));
  // Walk oldest-first; mark non-anchors for deletion until we're back at the cap.
  const sortedAsc = [...withPhotos].sort((a, b) => new Date(a.date) - new Date(b.date));
  const toDelete = [];
  let remaining = withPhotos.length;
  for (const log of sortedAsc) {
    if (remaining <= PHOTO_CAP_PER_USER) break;
    if (anchorIds.has(log.id)) continue;
    toDelete.push(log);
    remaining--;
  }
  const deleteIds = new Set(toDelete.map(l => l.id));
  const toDeletePaths = toDelete.map(l => l.photoPath).filter(Boolean);
  // Strip photo + photoPath from the deleted entries (the log itself stays — only the
  // photo reference is removed, so notes/rating/concerns survive).
  const updatedLogs = logs.map(l => {
    if (!deleteIds.has(l.id)) return l;
    const { photo, photoPath, ...rest } = l;
    return rest;
  });
  return { toDeletePaths, updatedLogs, trimmed: toDelete.length };
};

// === ACTUAL USAGE — what the user is genuinely doing, not just what's on the shelf ===
//
// The shelf is *inventory* (products owned). The check-in (regimenLogs) and per-photo
// usedProducts list capture *behavior* (products actually applied). Every AI prompt that
// describes "your routine" must use this — passing the full shelf misleads the AI into
// assuming products the user owns but has stopped using are still in play, producing
// wrong analysis ("X may be irritating you" when X hasn't been used in 30 days).
//
// Returns:
//   {
//     actuallyUsed: [{ product, amCount, pmCount, onLogs, totalDays, lastDate, daysSinceLast, status: 'active' }],
//     occasional:   [...status: 'occasional' — used 1× in last 14d but not recently],
//     lapsed:       [...status: 'lapsed' — owned, used in window before but not in last 14d],
//     unused:       [...status: 'unused' — owned but never used in window],
//     all:          [...full list],
//   }
//
// `windowDays` defaults to 30. Set to 14 for tighter "what are they on right now."
const getActualUsage = (products, regimenLogs, photoLogs, opts = {}) => {
  const windowDays = opts.windowDays || 30;
  const cutoff = Date.now() - windowDays * 86400000;
  const usage = new Map();
  (products || []).forEach(p => {
    if (p.endDate) return; // explicitly retired — not a candidate
    usage.set(p.id, {
      product: p,
      amCount: 0,
      pmCount: 0,
      onLogs: 0,
      // === BATCH VS EXPLICIT TRACKING (May 2026 per Jenni) ===
      // amCount/pmCount lump every appearance together. These two split
      // the same days into:
      //   explicitDays = user touched per-product UI for that day
      //     (signal: amSkipped/pmSkipped non-empty, meaning the user
      //      curated which products they actually used)
      //   batchDays = "Yes I did" auto-confirm with no per-product
      //     interaction. Treated as "planned" not "verified used."
      // Active status requires at least one explicit day. Otherwise the
      // product gets downgraded to status='scheduled' so the analysis
      // prompt knows not to attribute it as a real driver of today's
      // skin state.
      explicitDays: 0,
      batchDays: 0,
      totalDays: 0,
      lastDate: null,
      lastExplicitDate: null,
    });
  });
  (regimenLogs || []).forEach(r => {
    if (!r.date) return;
    if (new Date(r.date).getTime() < cutoff) return;
    const usedToday = new Set();
    (r.amProducts || []).forEach(id => {
      const u = usage.get(id);
      if (u) { u.amCount++; usedToday.add(id); if (!u.lastDate || r.date > u.lastDate) u.lastDate = r.date; }
    });
    (r.pmProducts || []).forEach(id => {
      const u = usage.get(id);
      if (u) { u.pmCount++; usedToday.add(id); if (!u.lastDate || r.date > u.lastDate) u.lastDate = r.date; }
    });
    usedToday.forEach(id => { const u = usage.get(id); if (u) u.totalDays++; });
    // === Explicit vs batch attribution per slot ===
    // Per-slot batchConfirmed flag from HomeDashboard's logRitualNow
    // tells us whether the user touched any per-product UI. If true,
    // products count as batch. If false, explicit.
    //
    // === LEGACY INFERENCE (May 2026 per Jenni) ===
    // Logs created BEFORE the batchConfirmed flag shipped don't have
    // the field. Treating them all as explicit (the safe default)
    // meant AHA/BHA that the user had stopped touching kept counting
    // as actively used in the 7-day analysis window — exactly the bug
    // Jenni flagged. Inference: a SUBMITTED legacy log with an EMPTY
    // amSkipped/pmSkipped list almost certainly came from "Yes I did"
    // batch confirm (the only path that submits without per-product
    // engagement). Treat that as batch. Logs WITH per-product skipped
    // entries demonstrate engagement → keep as explicit. Pre-existing
    // submitted: false drafts are also treated as engagement (user
    // was actively editing the log).
    const inferBatch = (slot) => {
      if (slot === 'am' && typeof r.amBatchConfirmed === 'boolean') return r.amBatchConfirmed;
      if (slot === 'pm' && typeof r.pmBatchConfirmed === 'boolean') return r.pmBatchConfirmed;
      // Legacy log — flag absent. Infer:
      const isSubmitted = r.submitted === true;
      if (!isSubmitted) return false; // draft → treat as explicit
      const skippedKey = slot === 'am' ? 'amSkipped' : 'pmSkipped';
      const slotSkipped = Array.isArray(r[skippedKey]) ? r[skippedKey] : [];
      return slotSkipped.length === 0; // no per-product engagement → likely batch
    };
    const amExplicit = !inferBatch('am');
    const pmExplicit = !inferBatch('pm');
    (r.amProducts || []).forEach(id => {
      const u = usage.get(id);
      if (!u) return;
      if (amExplicit) {
        u.explicitDays++;
        if (!u.lastExplicitDate || r.date > u.lastExplicitDate) u.lastExplicitDate = r.date;
      } else {
        u.batchDays++;
      }
    });
    (r.pmProducts || []).forEach(id => {
      const u = usage.get(id);
      if (!u) return;
      if (pmExplicit) {
        u.explicitDays++;
        if (!u.lastExplicitDate || r.date > u.lastExplicitDate) u.lastExplicitDate = r.date;
      } else {
        u.batchDays++;
      }
    });
  });
  (photoLogs || []).forEach(l => {
    if (!l.date) return;
    if (new Date(l.date).getTime() < cutoff) return;
    (l.usedProducts || []).forEach(id => {
      const u = usage.get(id);
      // Photo-tagged products count as explicit — user actively named
      // them on a check-in (different intent than batch ritual confirm).
      if (u) {
        u.onLogs++;
        u.explicitDays++;
        if (!u.lastDate || l.date > u.lastDate) u.lastDate = l.date;
        if (!u.lastExplicitDate || l.date > u.lastExplicitDate) u.lastExplicitDate = l.date;
      }
    });
  });
  const today = new Date();
  const enriched = [];
  usage.forEach(u => {
    const usedAtAll = u.amCount + u.pmCount + u.onLogs > 0;
    const daysSinceLast = u.lastDate ? Math.floor((today - new Date(u.lastDate)) / 86400000) : Infinity;
    const daysSinceLastExplicit = u.lastExplicitDate ? Math.floor((today - new Date(u.lastExplicitDate)) / 86400000) : Infinity;
    let status;
    if (!usedAtAll) status = 'unused';
    else if (daysSinceLast > 14) status = 'lapsed';
    // === NEW: scheduled-only bucket (May 2026 per Jenni) ===
    // Appears in logs but ALL of them were batch-confirmed. Means the
    // product is in the user's planned cadence + Yes-I-Did auto-batches
    // are recording it, but the user has never explicitly engaged with
    // it (never tapped its row, never skipped it, never tagged it on a
    // photo log). Analyses should treat it as "planned but not verified
    // recently used" — not as a current driver of skin state.
    else if (u.explicitDays === 0 && u.batchDays > 0) status = 'scheduled';
    else if (daysSinceLast > 7 || u.totalDays < 3) status = 'occasional';
    else status = 'active';
    enriched.push({ ...u, daysSinceLast, daysSinceLastExplicit, status });
  });
  return {
    actuallyUsed: enriched.filter(e => e.status === 'active'),
    occasional:   enriched.filter(e => e.status === 'occasional'),
    scheduled:    enriched.filter(e => e.status === 'scheduled'),
    lapsed:       enriched.filter(e => e.status === 'lapsed'),
    unused:       enriched.filter(e => e.status === 'unused'),
    all: enriched,
  };
};

// Format the usage object as a structured prompt block. Every AI prompt that describes
// "the user's routine" should use this — the explicit categorization (active vs lapsed
// vs unused) prevents the model from assuming everything on the shelf is in play.
//
// Options:
//   activeOnly: when true, drops lapsed/unused/occasional sections from the
//     output and emits only ACTIVELY USED + a tightly-labeled SCHEDULED
//     BUT UNVERIFIED section. Intended for "today's photo analysis"
//     prompts where 30-day breadth is noise and the model needs a sharp
//     signal of what the user is RIGHT NOW on. Pattern detection and
//     trend reads keep the full breakdown (default: activeOnly=false).
const formatUsageForPrompt = (usage, opts = {}) => {
  const activeOnly = opts.activeOnly === true;
  const lines = [];
  if (usage.actuallyUsed.length > 0) {
    lines.push('ACTIVELY USED (last 7-14 days, explicitly confirmed via check-ins or per-product interaction — these are what they\'re ACTUALLY ON):');
    usage.actuallyUsed.forEach(u => {
      const p = u.product;
      const freq = `${u.amCount}× AM, ${u.pmCount}× PM${u.onLogs > 0 ? `, ${u.onLogs}× tagged on photo entry` : ''}`;
      lines.push(`• ${p.name}${p.brand ? ` (${p.brand})` : ''} — ${p.activeIngredients || 'no actives listed'} [${freq}]`);
    });
  } else {
    lines.push('ACTIVELY USED: nothing explicitly confirmed in recent check-ins. The user has products on their shelf but is NOT logging actual use. Do NOT assume any product is in their routine.');
  }
  // === SCHEDULED BUT UNVERIFIED (May 2026 per Jenni) ===
  // Products in cadence that the user batch-confirmed via "Yes I did"
  // without ever touching the per-product UI. We can't tell if they're
  // really being used. Surface them explicitly so the AI knows the
  // distinction.
  if (usage.scheduled && usage.scheduled.length > 0) {
    lines.push('\nSCHEDULED BUT UNVERIFIED (products in the user\'s weekly cadence + auto-batched via "Yes I did my regimen" — but the user has NEVER explicitly engaged with these per-product. Treat as planned, NOT confirmed used. Do NOT claim these are causing today\'s skin state):');
    usage.scheduled.forEach(u => {
      const p = u.product;
      lines.push(`• ${p.name}${p.brand ? ` (${p.brand})` : ''} — ${p.activeIngredients || 'no actives listed'} [planned ${u.batchDays}× in window, 0 explicit confirmations]`);
    });
  }
  if (activeOnly) return lines.join('\n');
  if (usage.occasional.length > 0) {
    lines.push('\nOCCASIONAL / IRREGULAR (used 1-2× recently — treat as part-time, not core routine):');
    usage.occasional.forEach(u => lines.push(`• ${u.product.name} — ${u.product.activeIngredients || 'no actives listed'} (${u.totalDays} day${u.totalDays === 1 ? '' : 's'} in window)`));
  }
  if (usage.lapsed.length > 0) {
    lines.push('\nOWNED but LAPSED (>14 days since last use — DO NOT include in current-routine analysis. Only mention if relevant to "why aren\'t they using X" or "have they tried X"):');
    usage.lapsed.forEach(u => lines.push(`• ${u.product.name} (last used ${u.daysSinceLast}d ago)`));
  }
  if (usage.unused.length > 0) {
    const names = usage.unused.map(u => u.product.name).join(', ');
    lines.push(`\nOWNED but NEVER USED in window (sitting on shelf — DO NOT assume in routine): ${names}`);
  }
  return lines.join('\n');
};

// === PRODUCT COMPARE ANCHORS ===
// Computes "before & after" anchors for a single product. The start anchor is the EARLIEST
// of three signals: (1) product.startDate (explicit user opt-in), (2) first regimenLog
// where this product is checked off, (3) first photo log where this product is tagged.
// This way a long-running staple still gets a reasonable anchor even if the user never
// flipped "Started today" — we infer from real behavior.
//
// Photo selection is LOOSE — we want any full-face photo since the start anchor, not only
// photos on days the product was applied. The question being answered is "has my skin
// changed since I started X?", which is properly answered by time-spaced photos regardless
// of single-day usage. Falls back to non-full-face if no full-face exists.
//
// Returns:
//   {
//     startDate: 'YYYY-MM-DD' | null,
//     startSource: 'explicit' | 'regimen' | 'photo-tag' | null,
//     anchorPhotoLog: log | null,   // closest full-face on/after startDate
//     latestPhotoLog: log | null,   // most recent full-face since startDate
//     daysActive: number | null,
//     photoCount: number,           // photos in window
//     hasEnoughData: boolean,       // ≥14 days span AND ≥2 photos
//     reasonShort: string,          // 'Need 14+ days and 2 photos' if not ready
//   }
const _hasPhotoForCompare = (l) => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:'));
const findProductCompareAnchors = (product, products, regimenLogs, photoLogs) => {
  if (!product) return { startDate: null, startSource: null, anchorPhotoLog: null, latestPhotoLog: null, daysActive: null, photoCount: 0, hasEnoughData: false, reasonShort: 'No product' };
  // Signal 1 — explicit startDate
  let earliest = product.startDate || null;
  let source = product.startDate ? 'explicit' : null;
  // Signal 2 — first regimenLog mentioning this product
  const fromRegimen = (regimenLogs || [])
    .filter(r => (r.amProducts || []).includes(product.id) || (r.pmProducts || []).includes(product.id))
    .map(r => r.date)
    .sort()[0];
  if (fromRegimen && (!earliest || fromRegimen < earliest)) {
    earliest = fromRegimen;
    source = 'regimen';
  }
  // Signal 3 — first photo log tagging this product
  const fromPhotoTag = (photoLogs || [])
    .filter(l => (l.usedProducts || []).includes(product.id))
    .map(l => l.date)
    .sort()[0];
  if (fromPhotoTag && (!earliest || fromPhotoTag < earliest)) {
    earliest = fromPhotoTag;
    source = 'photo-tag';
  }
  if (!earliest) {
    return { startDate: null, startSource: null, anchorPhotoLog: null, latestPhotoLog: null, daysActive: null, photoCount: 0, hasEnoughData: false, reasonShort: 'No usage logged yet — check it off in your daily regimen first.' };
  }
  // Photo windowing: anchor = first full-face photo on/after start, latest = most recent.
  // Falls back to non-full-face if no full-face exists in the window.
  const since = (photoLogs || []).filter(l => l.date >= earliest && _hasPhotoForCompare(l));
  const sinceFullFace = since.filter(l => l.area === 'full-face');
  const candidatePool = sinceFullFace.length >= 2 ? sinceFullFace : since;
  const sortedAsc = [...candidatePool].sort((a, b) => {
    if (a.date !== b.date) return a.date.localeCompare(b.date);
    return (a.id || 0) - (b.id || 0);
  });
  const sortedDesc = [...candidatePool].sort((a, b) => {
    if (a.date !== b.date) return b.date.localeCompare(a.date);
    return (b.id || 0) - (a.id || 0);
  });
  const anchorPhotoLog = sortedAsc[0] || null;
  const latestPhotoLog = sortedDesc[0] || null;
  const sameLog = anchorPhotoLog && latestPhotoLog && anchorPhotoLog.id === latestPhotoLog.id;
  const photoCount = candidatePool.length;
  const daysActive = Math.floor((Date.now() - new Date(earliest).getTime()) / 86400000);
  const hasEnoughData = !sameLog && daysActive >= 14 && photoCount >= 2;
  const reasonShort = hasEnoughData ? '' :
    daysActive < 14 ? `Need 14+ days · you're at ${daysActive}.` :
    photoCount < 2 ? `Need 2+ photos since starting · you're at ${photoCount}.` :
    sameLog ? 'Need 2 distinct photos in the window.' :
    'Not enough data yet.';
  return { startDate: earliest, startSource: source, anchorPhotoLog, latestPhotoLog, daysActive, photoCount, hasEnoughData, reasonShort };
};

// === PEARLS — EDITORIAL LESSONS + MD-VERIFIED PICKS ===
// Lessons: short, evidence-graded teaching pieces. Triggered by keywords in AI responses.
