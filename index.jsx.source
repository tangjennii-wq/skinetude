// Reusable Concerns guide — used in Regimen "Concerns" sub-tab and Pearls "By Concern" sub-tab.
// Each card lists the primary protocol pearl + key ingredient pearls. All chips open the
// lesson modal via onOpenLesson. Optional onSwitchToPicks lets Regimen route users to the
// Verified Picks shelf for the same concern.
const ConcernGuide = ({ onOpenLesson, framing = 'editorial' }) => {
  return (
    <div>
      <div className="text-[11.5px] font-light mb-3 max-w-2xl" style={{color:'var(--ink-soft)'}}>
        {framing === 'regimen'
          ? 'For each concern: protocol, evidence-backed ingredients, and matching products.'
          : 'Open a concern chapter, then jump into the protocol or ingredient logic behind it.'}
      </div>
      <div className="grid grid-cols-1 gap-3">
        {CONCERN_GUIDE.map(c => {
          const protocolLesson = LESSONS.find(l => l.id === c.protocolLessonId);
          const ingredientLessons = (c.ingredientLessonIds || []).map(id => LESSONS.find(l => l.id === id)).filter(Boolean);
          return (
            <div key={c.id} className="rounded-[14px] border p-3 md:p-4" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
              <div className="flex items-start justify-between gap-3 mb-2">
                <div className="min-w-0">
                  <h3 className="text-[15px] leading-tight" style={{color:'var(--ink)', fontWeight:700, letterSpacing:'-0.01em'}}>{c.title}</h3>
                  <p className="text-[11.5px] font-light leading-snug mt-1" style={{color:'var(--ink-soft)'}}>{c.excerpt}</p>
                </div>
                {protocolLesson && (
                  <button onClick={() => onOpenLesson?.(protocolLesson)} className="rounded-full border px-3 py-2 text-[9px] tracking-[0.16em] uppercase flex items-center gap-1 flex-shrink-0" style={{color:'var(--accent)', borderColor: 'var(--line)', background:'var(--cream-deep)'}}>
                    Protocol <Icon name="ArrowRight" size={10} />
                  </button>
                )}
              </div>

              {c.actions?.length > 0 && (
                <ul className="space-y-1.5 my-3">
                  {c.actions.map((a, i) => (
                    <li key={i} className="flex items-start gap-2 text-[12px] font-light" style={{color:'var(--ink)'}}>
                      <span className="mt-0.5 w-5 h-5 rounded-full border flex items-center justify-center text-[9px] flex-shrink-0" style={{borderColor: 'var(--line)', color:'var(--ink-soft)'}}>{i + 1}</span>
                      <span className="leading-snug pt-0.5">{a}</span>
                    </li>
                  ))}
                </ul>
              )}

              {ingredientLessons.length > 0 && (
                <div className="pt-2.5 border-t" style={{borderColor: 'var(--line)'}}>
                  <div className="text-[9px] tracking-[0.25em] uppercase mb-2" style={{color:'var(--ink-soft)'}}>Ingredient logic</div>
                  <div className="flex flex-wrap gap-2">
                    {ingredientLessons.map(l => (
                      <button key={l.id} onClick={() => onOpenLesson?.(l)} className="rounded-full text-[10px] tracking-[0.08em] px-3 py-1.5 border transition flex items-center gap-1.5 hover:border-[var(--ink)]" style={{borderColor: 'var(--line)', color:'var(--ink)', background:'var(--cream-deep)'}}>
                        <Icon name="Beaker" size={11} /> {l.title}
                      </button>
                    ))}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  );
};

// Build a flat index of every trigger phrase → lesson, sorted longest-first
// so multi-word and longer terms (retinaldehyde) win over substrings (retinal).
const PEARL_INDEX = (() => {
  const items = [];
  LESSONS.forEach(lesson => {
    (lesson.triggers || []).forEach(trigger => {
      items.push({ trigger: trigger.toLowerCase(), lesson });
    });
  });
  return items.sort((a, b) => b.trigger.length - a.trigger.length);
})();


// Defensive cleanup applied at render time to any AI analysis text. Handles
// older cached analyses that still use the legacy paragraph + **bold** format
// the prompts used to ask for. Specifically:
//   - strips **bold** markdown
//   - normalizes various bullet glyphs (•, ·, *) to "- "
//   - drops the trailing METRICS: line (parsed elsewhere, never displayed)
//   - drops the trailing WATCH: line (handled separately if surfaced)
//   - tightens spacing so the bullet block renders cleanly with whitespace-pre-line
const formatAnalysisText = (s) => {
  if (!s || typeof s !== 'string') return '';
  return s
    .replace(/\*\*/g, '')
    .replace(/^\s*[•·*]\s+/gm, '- ')
    .replace(/\n?\s*METRICS:.*$/im, '')
    .replace(/\n?\s*(WATCH|SUSPECT):.*$/im, '')
    // Strip evidence grades [A]/[B]/[C] and "[expert opinion: X]" — Jenni
    // found them noisy and confusing. The grades stay in the AI's reasoning
    // but never surface as visible UI clutter. Also strip the new
    // [ev:level:source] machine tag so it can't leak into displays that
    // bypass the TaggedAnalysisBullets renderer (the EvidenceDot consumes
    // it from parseTaggedBullet directly).
    .replace(/\s*\[[A-C]\]\s*/g, ' ')
    .replace(/\s*\[expert opinion[^\]]*\]\s*/gi, ' ')
    .replace(/\s*\[ev:[a-z]+:[a-z]+\]\s*/gi, ' ')
    .replace(/[ \t]{2,}/g, ' ')
    .replace(/\n{3,}/g, '\n\n')
    .trim();
};

// Parse one analysis line into a typed bullet for the new icon-tagged
// renderer. Returns { type: 'observe'|'cause'|'action'|'plain', text }.
// Recognizes [OBSERVE]/[CAUSE]/[ACTION] tags from the new prompt format.
// Unknown/missing tags fall through as 'plain' so legacy responses still
// render cleanly.
const parseTaggedBullet = (line) => {
  const stripped = line.replace(/^[\s•·*-]+/, '').trim();
  const m = stripped.match(/^\[(OBSERVE|CAUSE|ACTION|MECHANISM|DO|READ)\]\s*/i);
  // Pull the trailing [ev:level:source] tag if present; strip it from
  // display text. Format: [ev:strong:RCT] | [ev:moderate:observational]
  // | [ev:emerging:mechanism] | [ev:emerging:expert].
  const evMatch = stripped.match(/\[ev:(strong|moderate|emerging):(rct|observational|mechanism|expert)\]\s*$/i);
  const evidence = evMatch ? { level: evMatch[1].toLowerCase(), source: evMatch[2].toLowerCase() } : null;
  const noEv = (s) => s.replace(/\s*\[ev:[a-z]+:[a-z]+\]\s*$/i, '').trim();
  if (!m) return { type: 'plain', text: noEv(stripped), evidence };
  const tag = m[1].toUpperCase();
  const text = noEv(stripped.slice(m[0].length));
  if (tag === 'OBSERVE' || tag === 'READ') return { type: 'observe', text, evidence };
  if (tag === 'CAUSE' || tag === 'MECHANISM') return { type: 'cause', text, evidence };
  if (tag === 'ACTION' || tag === 'DO') return { type: 'action', text, evidence };
  return { type: 'plain', text, evidence };
};


// === TAGGED ANALYSIS RENDERER ===
// Each bullet → a row with a CONTEXT-AWARE icon (Droplet for cleanse,
// Sun for SPF, Moon for retinoid PM, Heart for moisturize, etc.) plus a
// type label (Observe / Why / Try). The icon picks itself based on
// keywords in the bullet text — water drop for cleansers, sun for SPF,
// etc. Falls back to a generic icon per type if nothing matches.
//
// Why context-aware: "label each type of observation and advice" —
// Jenni wants the icon to TELL you what the recommendation is at a
// glance. Generic Eye/Activity/Sparkles wasn't doing that work.
const pickContextIcon = (text, type) => {
  const t = (text || '').toLowerCase();
  // Action-specific contextual icons — the most informative
  if (type === 'action') {
    if (/cleanse|cleanser|wash|double cleanse|micellar/.test(t)) return 'Droplet';
    if (/sunscreen|spf|sun ?protection|reapply.*sun/.test(t)) return 'Sun';
    if (/retinoid|retinol|tretinoin|adapalene|retinaldehyde|differin|granactive/.test(t)) return 'Moon';
    if (/moisturiz|moisturis|hydrat|barrier cream|ceramide/.test(t)) return 'Heart';
    if (/exfoliat|aha|bha|glycolic|salicylic|lactic|mandelic|enzyme|peel/.test(t)) return 'Layers';
    if (/serum|essence|ampoule|treatment/.test(t)) return 'Beaker';
    if (/mask|sheet mask|clay/.test(t)) return 'Square';
    if (/spot ?treat|benzoyl|acne treat/.test(t)) return 'Target';
    if (/oil|squalane/.test(t)) return 'Droplets';
    if (/vitamin c|ascorbic|brighten/.test(t)) return 'Sparkles';
    if (/niacinamide/.test(t)) return 'Shield';
    if (/sleep|rest|recover/.test(t)) return 'Cloud';
    if (/hydrate|water|drink/.test(t)) return 'Droplet';
    if (/spf reapply|reapply/.test(t)) return 'RotateCcw';
    if (/wait|space|alternate|every other/.test(t)) return 'Clock';
    if (/stop|pause|hold|skip/.test(t)) return 'Pause';
    if (/add|introduce|start/.test(t)) return 'Plus';
    return 'Sparkles';
  }
  // Observe = a reading of the skin
  if (type === 'observe') {
    if (/redness|flush|inflam/.test(t)) return 'Flame';
    if (/dry|parched|dehydrat/.test(t)) return 'Droplet';
    if (/oil|sebum|shine|congest/.test(t)) return 'Circle';
    if (/breakout|pimple|acne|pustule|comedone/.test(t)) return 'Target';
    if (/texture|smooth|rough/.test(t)) return 'Layers';
    if (/barrier|sensitive|reactive/.test(t)) return 'Shield';
    return 'Eye';
  }
  // Cause / why / mechanism
  if (type === 'cause') {
    return 'Activity';
  }
  return null;
};
const TaggedAnalysisBullets = ({ text, onOpen, IconComponent, withPearlsFn }) => {
  if (!text || typeof text !== 'string') return null;
  const lines = text.split(/\n+/).map(l => l.trim()).filter(Boolean);
  const intro = [];
  const bullets = [];
  let inBullets = false;
  lines.forEach(l => {
    const isBullet = /^[-•·*]\s+/.test(l) || /^\[(OBSERVE|CAUSE|ACTION|MECHANISM|DO|READ)\]/i.test(l);
    if (isBullet) { inBullets = true; bullets.push(parseTaggedBullet(l)); }
    else if (!inBullets) intro.push(l);
    else bullets.push({ type: 'plain', text: l });
  });
  const TYPE_META = {
    observe: { label: 'Observe', color: 'var(--ink-soft)' },
    cause:   { label: 'Why',     color: 'var(--accent-gold,#B99324)' },
    action:  { label: 'Try',     color: 'var(--accent)' },
    plain:   { label: '',        color: 'var(--ink-soft)' },
  };
  const renderInline = (s) => withPearlsFn && onOpen ? withPearlsFn(s, onOpen) : s;
  return (
    <div>
      {intro.length > 0 && (
        <p className="font-serif italic text-[13px] leading-relaxed mb-3" style={{color:'var(--ink)'}}>
          {renderInline(intro.join(' '))}
        </p>
      )}
      <div className="space-y-2.5">
        {bullets.map((b, i) => {
          const meta = TYPE_META[b.type] || TYPE_META.plain;
          const iconName = b.type !== 'plain' ? pickContextIcon(b.text, b.type) : null;
          return (
            <div key={i} className="flex items-start gap-2.5">
              {iconName && IconComponent && (
                <div className="flex flex-col items-center pt-0.5 flex-shrink-0" style={{width:'36px'}}>
                  <div className="w-7 h-7 rounded-full flex items-center justify-center" style={{background:'var(--cream)', border:'1px solid ' + meta.color, color: meta.color}}>
                    <IconComponent name={iconName} size={12} />
                  </div>
                  <span className="text-[7px] tracking-[0.18em] uppercase mt-1" style={{color: meta.color}}>{meta.label}</span>
                </div>
              )}
              <div className="flex-1 min-w-0 text-[13px] leading-relaxed pt-0.5" style={{color:'var(--ink)', fontWeight:400, letterSpacing:'-0.005em'}}>
                {renderInline(b.text)}
                {b.evidence && b.type === 'action' && (
                  <EvidenceDot evidence={b.evidence} IconComponent={IconComponent} />
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
};

// Walk an AI response string, find lesson trigger words (case-insensitive,
// whole-word, longest-match-wins), wrap each lesson's FIRST hit only,
// return mixed array of strings + JSX safe to render directly.
const withPearls = (text, onOpen) => {
  if (!text || typeof text !== 'string' || !onOpen) return text;

  const wrapped = new Set(); // lesson ids already wrapped (one underline per lesson per block)
  const out = [];
  const lower = text.toLowerCase();
  const isWordChar = (c) => !!c && /[a-z0-9]/i.test(c);

  let cursor = 0;
  let key = 0;
  while (cursor < text.length) {
    let best = null;
    for (const item of PEARL_INDEX) {
      if (wrapped.has(item.lesson.id)) continue;
      let pos = cursor;
      while (pos < lower.length) {
        const idx = lower.indexOf(item.trigger, pos);
        if (idx < 0) break;
        const before = idx === 0 ? '' : text[idx - 1];
        const after = text[idx + item.trigger.length] || '';
        if (!isWordChar(before) && !isWordChar(after)) {
          if (!best || idx < best.idx) {
            best = { idx, lesson: item.lesson, length: item.trigger.length };
          }
          break;
        }
        pos = idx + 1;
      }
    }
    if (!best) {
      out.push(text.slice(cursor));
      break;
    }
    if (best.idx > cursor) out.push(text.slice(cursor, best.idx));
    out.push(
      <PearlTrigger key={key++} lesson={best.lesson} onOpen={onOpen}>
        {text.slice(best.idx, best.idx + best.length)}
      </PearlTrigger>
    );
    wrapped.add(best.lesson.id);
    cursor = best.idx + best.length;
  }
  return out;
};


function App() {
  const [user, setUser] = useState(null);
  const [authMode, setAuthMode] = useState('signin');
  const [authAllowLocalOnly, setAuthAllowLocalOnly] = useState(false); // explicit opt-in for browser-only signup when Supabase isn't connected
  // Show/hide toggle for the password input — friends will mistype on
  // mobile keyboards and blame the app if they can't see what they
  // typed. False by default so the field starts masked.
  const [showAuthPassword, setShowAuthPassword] = useState(false);
  const [authForm, setAuthForm] = useState({ email: '', password: '', name: '' });
  const [authError, setAuthError] = useState('');
  const [loading, setLoading] = useState(true);
  // Force-hide the loading screen on first React mount. The original code only hid it
  // inside loadSession; if loadSession ever throws or hangs the loading screen sticks
  // forever and the app reads as blank. This guarantees the React tree always shows.
  useEffect(() => {
    const ls = document.getElementById('loading-screen');
    if (ls) ls.style.display = 'none';
  }, []);

  const [activeTab, setActiveTabRaw] = useState('dashboard');
  // === BROWSER BACK-BUTTON TRAP ===
  // When the user taps the browser back button, we want them to stay INSIDE
  // the app — closing whatever overlay is open, or returning to Home — rather
  // than exiting out to the previous webpage. Implementation:
  // 1. On mount, push a sentinel state so the very first back press is caught
  //    by our popstate handler instead of exiting immediately.
  // 2. Each time popstate fires, dismiss the topmost overlay (modals, drawers,
  //    sheets) OR navigate to Home if the user was on a non-home tab.
  // 3. Re-push the sentinel after handling so the user stays trapped — only
  //    a real "no overlays + already on home" case allows the browser to
  //    actually leave the page.
  useEffect(() => {
    if (typeof window === 'undefined' || !window.history) return;
    if (!window.history.state || !window.history.state.appSentinel) {
      window.history.pushState({ appSentinel: true }, '');
    }
  }, []);
  // Backwards-compat: 'procedures' redirects to Journal+procedures sub-tab; 'events' redirects to Regimen+occasions sub-tab.
  const setActiveTab = (id) => {
    if (id === 'procedures') {
      setActiveTabRaw('journal');
      setTimeout(() => setJournalViewOverride && setJournalViewOverride('procedures'), 0);
      return;
    }
    if (id === 'events') {
      setActiveTabRaw('regimen');
      setTimeout(() => setRegimenView && setRegimenView('occasions'), 0);
      return;
    }
    setActiveTabRaw(id);
  };
  // === SUB-TAB RESET ON LEAVE ===
  // When the user leaves a top-level tab, reset its sub-tab to the default. The next
  // time they enter that tab they always land on the canonical landing screen instead
  // of remembering whatever sub-view they were last in. The reset uses a ref to track
  // the previous activeTab so we only fire when the tab CHANGES (not on every render).
  // Note: handlers that explicitly set sub-tabs while changing activeTab (e.g. the
  // "events" alias setting regimenView='occasions') still work because those setters
  // run AFTER this effect on the same render cycle.
  const prevActiveTabRef = useRef('dashboard');
  useEffect(() => {
    const prev = prevActiveTabRef.current;
    if (prev === activeTab) return;
    // Reset the sub-tab(s) of the tab we just LEFT so it's fresh on next entry.
    // June 2026: regimen landing is now 'refine' (normalizes to 'build') per
    // stratechery critic + Jenni — the JTBD for tapping Regimen is "do
    // something to my routine," not "see today again." See project_regimen_canonical.
    if (prev === 'regimen') setRegimenView('refine');
    if (prev === 'compare') setCompareSubTab('time');
    if (prev === 'journal') setJournalViewOverride(null);
    if (prev === 'pearls') setPearlsTab('signals');
    if (prev === 'insights') setCounselSubTab('insights');
    prevActiveTabRef.current = activeTab;
  }, [activeTab]);
  // Canonical top-level nav tap. This is intentionally separate from
  // setActiveTab(): deep links are allowed to land in specific sub-views,
  // while the visible nav bars should always reset to a safe landing screen.
  // Fixes stale Journal/Compare sub-view state after moving between pages.
  const openTopLevelTab = (id) => {
    // June 2026: regimen landing is now 'refine' (normalizes to 'build')
    // so dock taps land on the "do something" surface, not "Today."
    if (id === 'regimen') setRegimenView('refine');
    if (id === 'journal') {
      setJournalViewOverride(null);
      setJournalMode('today');
      setSelectMode(false);
      setSelectedIds([]);
    }
    if (id === 'compare') {
      setCompareSubTab('time');
      setCompareTimePickerFor(null);
    }
    if (id === 'pearls') setPearlsTab('signals');
    if (id === 'insights') setCounselSubTab('insights');
    setActiveTab(id);
  };
  const [logs, setLogs] = useState([]);
  const [products, setProducts] = useState([]);
  const [procedures, setProcedures] = useState([]);
  const [events, setEvents] = useState([]);
  const [colorProfile, setColorProfile] = useState(null);
  const [cycleData, setCycleData] = useState({ periods: [], cycleLength: 28 });
  // 'cycling' | 'post-menopausal' | 'androgen-pattern' | 'pregnancy' | 'hormone-therapy' | 'unspecified' | null
  // null = never set (will trigger soft onboarding prompt). Stored in user_data + localStorage.
  const [hormonalContext, setHormonalContext] = useState(null);
  // === USER PROFILE — demographics that meaningfully change the AI's read ===
  // Persisted in localStorage as 'lumiere:userProfile' AND threaded through every
  // skin-photo analysis + Counsel chat as system context, so recommendations are
  // age-appropriate, Fitzpatrick-aware, hormonal-context-aware, and respect any
  // diagnosed conditions or Rx the user has flagged.
  //
  // Fields:
  //   ageBand:           '18-24' | '25-34' | '35-44' | '45-54' | '55-64' | '65+'
  //   fitzpatrick:       'I' | 'II' | 'III' | 'IV' | 'V' | 'VI'    (sun-reactivity scale)
  //   monkSkinTone:      '1'..'10'   (granular tone scale, 10 swatches — more inclusive than Fitz alone)
  //   skinType:          'oily' | 'dry' | 'combination' | 'normal' | 'sensitive'
  //   diagnosedConditions: array of strings (rosacea, melasma, eczema, …)
  //   currentRx:         array of strings (tretinoin, spironolactone, …)
  //   location:          free-text (city / climate region)
  // Schema is the 11-section Skin Profile spec — every field is
  // optional but each filled answer enriches Counsel + every photo analysis.
  // Fields stay flat (not nested) so storage / migration / Supabase writes
  // are trivial. Sliders default to null (don't show as "0/10" in prompts).
  const DEFAULT_USER_PROFILE = {
    // Section 1 — Sun Reactivity (user-friendly, maps to Fitzpatrick internally)
    sunReactivity: '',         // 'always-burns' | 'usually-burns' | 'sometimes-burns' | 'rarely-burns' | 'very-rarely' | 'never-burns'
    fitzpatrick: '',           // I-VI (auto-derived from sunReactivity)
    // Section 2 — Visible Skin Tone
    monkSkinTone: '',          // '1'..'10'
    undertone: '',             // 'warm' | 'cool' | 'neutral' | 'olive' | 'unsure'
    // Section 3 — Skin Type
    skinType: '',              // 'dry' | 'oily' | 'combination' | 'balanced' | 'sensitive'
    skinModifiers: [],         // ['dehydrated','congestion-prone','reactive','easily-flushed','acne-prone','compromised-barrier']
    // Section 4 — Primary Concerns
    primaryConcerns: [],       // multi-select from a long list
    // Section 5 — Pigment Biology (sliders 1-5, null = unset)
    pigmentBiology: { redness: null, flushing: null, freckles: null, darkMarks: null, melasma: null, unevenTone: null },
    // Section 6 — Barrier / Sensitivity
    barrierScale: '',          // 'resilient' | 'mildly-sensitive' | 'sensitive' | 'reactive' | 'very-reactive' | 'eczema-prone'
    triggers: [],              // multi-select
    // Section 7 — Hormonal context (lives separately on hormonalContext state)
    // Section 8 — Diagnosed Conditions
    diagnosedConditions: [],   // multi-select
    // Section 9 — Current Treatments
    currentRx: [],
    // Section 10 — Environment
    environment: { city: '', humidity: '', uv: '', altitude: '', seasonality: '', pollution: '', hardWater: '' },
    location: '',              // legacy free-text (still surfaced)
    // Section 11 — Goals (top 3)
    goals: [],
    // Demographics
    ageBand: '',
    // === AGE (May 30 2026 — Agent D-v3) ===
    // Numeric age — distinct from the legacy ageBand range field.
    // Set in OnboardingOverlay's `context` stage and editable in
    // ProfileModal step 8. Used by Insights for context.
    age: null,
    // === EXPERIENCE LEVEL (May 30 2026) ===
    // Mirrored from onboardingState.experienceLevel post-onboarding
    // so the Insights "Lessons" filter has a single source of truth.
    experienceLevel: '',
    // === TRAVEL MODE (June 2026 per Jenni — Phase 1) ===
    // Global mode set from "Used something else? → Going traveling" or
    // the cover banner. When active, resolveTodayRitual swaps the
    // weekly routine for travel.products. Every regimenLog and photo
    // log captured during travel gets travel:true so Journal and
    // Compare can filter on it. Auto-flips off after endDate; a
    // welcome-back prompt offers a "how'd it go?" check-in.
    travel: {
      active: false,
      startDate: '',
      endDate: '',
      durationHint: '',         // 'weekend' | 'week' | '2-weeks' | 'longer' (derived from dates, editable)
      products: [],              // product IDs in the travel-only routine
      locationKind: '',          // 'beach' | 'cold' | 'humid' | 'dry' | 'normal'
      destinationTz: '',         // IANA timezone string (e.g. 'Asia/Tokyo')
      destinationLabel: '',      // human-friendly city/region label
      homeTz: '',                // captured at setup time
      tzDeltaHours: 0,           // derived; triggers jetlag content in Phase 2 when |Δ| ≥ 3
      notes: '',
    },
  };
  const [userProfile, setUserProfile] = useState(() => {
    try {
      const raw = localStorage.getItem('lumiere:userProfile');
      if (!raw) return DEFAULT_USER_PROFILE;
      const parsed = JSON.parse(raw);
      return { ...DEFAULT_USER_PROFILE, ...parsed };
    } catch { return DEFAULT_USER_PROFILE; }
  });
  // Persist on every change.
  useEffect(() => {
    try { localStorage.setItem('lumiere:userProfile', JSON.stringify(userProfile)); } catch {}
  }, [userProfile]);
  // === ONBOARDING FLOW STATE (May 2026) ===
  // Floating-card 10-step flow. Persisted to localStorage so refresh
  // doesn't reset. On completion (stage === 'done'), the overlay
  // dismisses and collected data writes into existing app state
  // (userConcerns, userProfile fields, products, etc.).
  // Stages (May 2026 v2 — 11 → 7):
  //   'welcome' → 'photo' → 'key' → 'about' → 'context' →
  //   'shelf' → 'reveal' → 'done'
  // Photo now precedes key so the user has a captured artifact before
  // the API-key ask; the read fires in-place on the key card. `about`
  // packs goals + tolerance; `context` packs experience + clinical;
  // `reveal` collapses the v1 building + first-routine stages and
  // absorbs the fallback (no-shelf) preview as a substate.
  // 'explore' = user tapped "Explore first" on Welcome — skips entire
  // flow, sets stage to 'done' but flags onboardingSkipped so we can
  // re-prompt later via Home empty-state cards.
  const DEFAULT_ONBOARDING_STATE = {
    stage: 'welcome',
    skipped: false,
    photoProvided: false,
    photoSource: null, // 'selfie' | 'upload' | 'skipped'
    photoDataUrl: null,
    photoLogId: null,        // id of the log saved during onboarding step 2 — used by chip-population watcher
    photoAnalyzing: false,   // true once log saved + AI key set, until metricSnapshot arrives
    photoChips: null,        // [{label, word, kind}] | null — first-read chips surfaced on Step 2 after analysis
    goals: [],
    experienceLevel: null, // 'essential' | 'balanced' | 'advanced'
    skinTolerance: null,   // 'very_sensitive' | 'occasionally_reactive' | 'resilient' | 'unsure'
    // === AGE (May 30 2026 — Agent D-v3) ===
    // Captured on the `context` card; mirrored into userProfile.age
    // in finishOnboarding so it survives past the flow.
    age: null,
    skinConditions: [],
    currentRxOrHistory: [],
    // API-key onboarding step draft. Lives on onboardingState so the
    // value survives App re-renders (the welcome → key transition can
    // trigger a few before the user starts typing). Committed via
    // setApiKey on Save & Continue; cleared on skip.
    apiKeyDraft: '',
    timeZone: null,
    shelfStarted: false,
    productEntryMethod: null, // 'scan' | 'search' | 'later'
    generatedRoutineType: null, // 'personalized' | 'foundational'
    generatedRoutine: null, // { am: [...], pm: [...] }
    // === REVEAL SUBSTATE (May 2026 v2 — onboarding rework) ===
    // Drives the in-place morph on the final 'reveal' stage:
    //   null/'building' → OnboardingBuildingPhases plays
    //   'routine'       → first-routine card renders
    // Replaces the v1 standalone 'building' + 'first-routine' stages.
    revealSubstate: null,
  };
  // === ONBOARDING FLASH FIX (May 2026 per Jenni) ===
  // Returning cloud users saw a half-second flash of the welcome screen
  // every login. Cause: onboardingState defaults to {stage:'welcome'}
  // when there's no local copy, the UI renders the overlay, THEN
  // loadFromSupabase resolves and flips it to 'done.'
  // Fix: gate the OnboardingOverlay render on onboardingResolved. Flip
  // true when either (a) loadFromSupabase finishes, (b) we confirm
  // there's no cloud session so cloud-data won't arrive, or (c) a 3s
  // safety timeout fires (so true-new-users with no cloud session
  // aren't blocked indefinitely if Supabase init hangs).
  const [onboardingResolved, setOnboardingResolved] = useState(false);
  useEffect(() => {
    const t = setTimeout(() => setOnboardingResolved(true), 3000);
    return () => clearTimeout(t);
  }, []);
  const [onboardingState, setOnboardingState] = useState(() => {
    try {
      // === RETURNING-USER GATE (Jun 1 2026 per Jenni) ===
      // Compute "is this browser a returning user" from any of the
      // long-standing localStorage keys an old account would have.
      // Reused below to override a stale non-done onboardingState
      // before it flashes the wizard.
      const isReturningUser = (() => {
        try {
          const profileRaw = localStorage.getItem('lumiere:userProfile');
          if (profileRaw) {
            const prof = JSON.parse(profileRaw) || {};
            if (
              (Array.isArray(prof.primaryConcerns) && prof.primaryConcerns.length) ||
              (Array.isArray(prof.goals) && prof.goals.length) ||
              prof.skinType || prof.barrierScale || prof.sunReactivity
            ) return true;
          }
          const photoRaw = localStorage.getItem('lumiere:mainPhotoByDate');
          if (photoRaw && photoRaw !== '{}') return true;
          // Any saved products / logs / regimenLogs also imply returning user.
          for (const k of ['lumiere:products', 'lumiere:logs', 'lumiere:regimenLogs']) {
            const v = localStorage.getItem(k);
            if (v && v !== '[]' && v !== '{}') return true;
          }
        } catch (_) {}
        return false;
      })();
      const raw = localStorage.getItem('lumiere:onboardingState');
      if (raw) {
        const parsed = JSON.parse(raw) || {};
        // === STALE LOCAL STAGE HEAL (Jun 1 2026 per Jenni) ===
        // Old logic returned parsed.stage as-is. Symptom: a stale local
        // onboardingState with stage='context' (or any mid-wizard stage)
        // flashed the wizard for a returning user before cloud could
        // resolve. Heal to 'done' when the browser shows clear signs of
        // a returning user. Explicit Replay still works because it
        // resets state through updateOnboarding, not localStorage.
        if (parsed.stage !== 'done' && isReturningUser) {
          return { ...DEFAULT_ONBOARDING_STATE, ...parsed, stage: 'done', skipped: true };
        }
        return { ...DEFAULT_ONBOARDING_STATE, ...parsed };
      }
      // No onboarding state saved — fall back to the returning-user
      // probe above. New users with nothing saved fall through to the
      // welcome screen.
      if (isReturningUser) return { ...DEFAULT_ONBOARDING_STATE, stage: 'done', skipped: true };
      return DEFAULT_ONBOARDING_STATE;
    } catch { return DEFAULT_ONBOARDING_STATE; }
  });
  useEffect(() => {
    try { localStorage.setItem('lumiere:onboardingState', JSON.stringify(onboardingState)); } catch {}
  }, [onboardingState]);
  const updateOnboarding = (patch) => setOnboardingState(prev => ({ ...prev, ...patch }));
  // === ONBOARDING PHOTO CHIP WATCHER (May 2026) ===
  // After Step 2 saves a photo and kicks retryLogAnalysis, the log's
  // metricSnapshot eventually populates. Watch for it and surface 2–3
  // "first-read" chips — the metrics most distinct from neutral.
  // Editorial copy, doctor-framing-safe ("reads calm" / "barrier
  // holding"). If analyzing flag flips false without a snapshot
  // (failure path), clear the analyzing badge silently.
  useEffect(() => {
    if (!onboardingState.photoLogId || !onboardingState.photoAnalyzing) return;
    const log = (logs || []).find(l => l.id === onboardingState.photoLogId);
    if (!log) return;
    if (log.analyzing) return; // still working
    // Analysis settled. Try to pull a snapshot.
    const snap = log.metricSnapshot || (log.aiAnalysis ? parseSkinMetrics(log.aiAnalysis) : null);
    if (!snap) {
      // Failed or empty — clear analyzing badge silently, no chips.
      updateOnboarding({ photoAnalyzing: false, photoChips: null });
      return;
    }
    // Rank metrics by distinctness from neutral. Each metric maps to a
    // word; "neutral" words are filtered out. Top 3 wins surface.
    const NEUTRAL = new Set(['Balanced', 'Steady', 'Even', 'Holding', 'Settled', 'Few']);
    const KIND = {
      redness: 'Redness',
      hydration: 'Hydration',
      texture: 'Texture',
      breakouts: 'Breakouts',
      barrier: 'Barrier',
      sensitivity: 'Sensitivity',
    };
    const titleCase = (w) => w ? String(w).charAt(0).toUpperCase() + String(w).slice(1).toLowerCase() : null;
    const candidates = [];
    Object.keys(KIND).forEach(k => {
      const word = titleCase(snap[k]);
      if (!word) return;
      const isNeutral = NEUTRAL.has(word);
      candidates.push({ kind: KIND[k], word, isNeutral });
    });
    // Prefer non-neutral chips; backfill with neutral only if needed.
    const distinct = candidates.filter(c => !c.isNeutral).slice(0, 3);
    const filled = distinct.length >= 3
      ? distinct
      : [...distinct, ...candidates.filter(c => c.isNeutral)].slice(0, 3);
    updateOnboarding({ photoAnalyzing: false, photoChips: filled.length ? filled : null });
  }, [logs, onboardingState.photoLogId, onboardingState.photoAnalyzing]);
  // === CAMERA DESTINATION FLAG (May 2026 — onboarding photo first-read) ===
  // Set before opening the shared CameraCaptureModal so the capture
  // handler can branch:
  //   'normal'     → existing path (checkInDetailsQueue → CheckInDetailsModal)
  //   'onboarding' → minimal save (date+photo only), kick analysis, surface
  //                  metric chips inline on onboarding Step 2.
  // Reset to 'normal' immediately after each capture so subsequent
  // photos go through the daily check-in details flow.
  const [cameraDestination, setCameraDestination] = useState('normal');
  // === ADAPTIVE HOME — SAMPLE ROUTINE PREVIEW ===
  // Holds the SAMPLE_ROUTINES entry currently shown in the preview
  // modal (or null if closed). Triggered from the Sample Routine card
  // and the three Explore Sample Routines cards on the empty-state Home.
  const [sampleRoutinePreview, setSampleRoutinePreview] = useState(null);
  const [showProfileModal, setShowProfileModal] = useState(false);
  // === Score explainer (June 2026) ===
  // Opened from: cover delta line, cover kebab "How your score works",
  // ProfileModal Settings link. First-time auto-open uses the same flag.
  const [showScoreExplainer, setShowScoreExplainer] = useState(false);
  // First-time inline card flag — persists in localStorage so we only
  // auto-show it once per device. Cleared by tapping "Got it" or the X.
  const [scoreExplainerSeen, setScoreExplainerSeenRaw] = useState(() => {
    try { return localStorage.getItem('lumiere:scoreExplainerSeen') === '1'; }
    catch { return true; }  // err-on-the-side: don't repeatedly show if storage is broken
  });
  const setScoreExplainerSeen = (v) => {
    setScoreExplainerSeenRaw(v);
    try { localStorage.setItem('lumiere:scoreExplainerSeen', v ? '1' : '0'); } catch {}
  };
  // Sunday Digest modal (May 2026 — roadmap item 2). Opened from the
  // hamburger menu. Pre-renders the current week's digest and offers a
  // one-tap .ics calendar export with the digest body embedded.
  const [showSundayDigest, setShowSundayDigest] = useState(false);
  // === TRAVEL MODE (June 2026 per Jenni — Phase 1) ===
  // Modal open flag — opened from "Used something else? → Going traveling"
  // entry or from tapping the cover banner when travel.active. Modal
  // edits userProfile.travel directly.
  const [showTravelSetupModal, setShowTravelSetupModal] = useState(false);
  // Welcome-back prompt — fired by the auto-flip-off effect when today
  // crosses travel.endDate. Shows a top banner asking how the trip went;
  // auto-dismisses after 12s. Persists a "seen" flag so we don't re-prompt
  // on subsequent App opens once the user dismisses.
  const [welcomeBackPrompt, setWelcomeBackPrompt] = useState(null);
  useEffect(() => {
    if (!welcomeBackPrompt) return;
    const t = setTimeout(() => setWelcomeBackPrompt(null), 12000);
    return () => clearTimeout(t);
  }, [welcomeBackPrompt]);
  // Auto-flip-off effect — runs whenever userProfile.travel changes.
  // When today > endDate and travel.active is still true, flip active
  // to false and fire the welcome-back prompt once (unless already shown
  // for this trip via localStorage key).
  useEffect(() => {
    const tr = userProfile?.travel;
    if (!tr || !tr.active || !tr.endDate) return;
    const today = localDateISO();
    if (today <= tr.endDate) return;
    const seenKey = `lumiere:travelWelcomeBackSeen:${tr.startDate}_${tr.endDate}`;
    let alreadySeen = false;
    try { alreadySeen = localStorage.getItem(seenKey) === '1'; } catch {}
    // Flip travel.active off in userProfile.
    setUserProfile(prev => ({ ...prev, travel: { ...(prev.travel || {}), active: false } }));
    saveData('userProfile', { ...userProfile, travel: { ...(userProfile.travel || {}), active: false } }).catch(() => {});
    if (!alreadySeen) {
      setWelcomeBackPrompt({
        destination: tr.destinationLabel || 'your trip',
        endedAt: tr.endDate,
        seenKey,
      });
    }
  }, [userProfile?.travel?.active, userProfile?.travel?.endDate]);
  // === Auto-flip-ON effect (June 2026 Phase 2.5) ===
  // Mirror of the auto-flip-off effect above. When today >= startDate AND
  // travel.active is still false AND a packing list exists, flip active
  // to true automatically. Lets the user pre-pack a trip days in advance
  // and have travel mode turn on automatically on the morning of departure.
  // Guarded by:
  //   - Skip if active is already true (would be a no-op)
  //   - Skip if no packing list (premature — let the user set it up first)
  //   - Skip if today is past endDate (don't flip on then immediately off)
  useEffect(() => {
    const tr = userProfile?.travel;
    if (!tr || tr.active) return;
    if (!tr.startDate || !tr.endDate) return;
    if (!Array.isArray(tr.products) || tr.products.length === 0) return;
    const today = localDateISO();
    if (today < tr.startDate) return;
    if (today > tr.endDate) return;
    setUserProfile(prev => ({ ...prev, travel: { ...(prev.travel || {}), active: true } }));
    saveData('userProfile', { ...userProfile, travel: { ...(userProfile.travel || {}), active: true } }).catch(() => {});
    try { toast(`Travel mode on · ${tr.destinationLabel || 'safe travels'} ✈`, 'success'); } catch (_) {}
  }, [userProfile?.travel?.active, userProfile?.travel?.startDate, userProfile?.travel?.endDate, userProfile?.travel?.products?.length]);
  // === PROFILEMODAL WIZARD STATE — lifted to App level ===
  // ProfileModal was extracted (Phase 4, May 2026) to src/components/
  // ProfileModal.jsx, which fixed the underlying remount cascade. We keep
  // the wizard state lifted up to App for now so re-opening the modal
  // resumes mid-flow (per-step auto-save still writes to userProfile too).
  // A future cleanup can move this state inside the extracted component
  // once we're confident no other surface needs to read it.
  // (Proper fix is to extract ProfileModal to module scope, but that's a larger
  // refactor — lifting state is the surgical, low-risk version.)
  const [profileWizardStep, setProfileWizardStep] = useState(0);
  // === EAGER SEED (May 2026 fix) ===
  // Was `useState(null)` with a lazy useEffect seed inside ProfileModal.
  // That introduced a window where the first click would call
  // setProfileForm(prev => ({...prev, ...}) but `prev` was the lazy seed
  // result (defaults) — the seed effect could fire AFTER the click,
  // clobbering the user's first selection. Eager seed makes the form
  // always an object so clicks update directly. Resets to fresh defaults
  // when the modal closes (see effect below).
  const [profileWizardForm, setProfileWizardForm] = useState(() => ({ ...DEFAULT_USER_PROFILE, ...(typeof userProfile === 'object' && userProfile ? userProfile : {}) }));
  // === PROFILE AI SUMMARY ===
  // The < 50-word impact analysis generated after the user saves their
  // profile. Shown inline at the final step + persists in userProfile so
  // future opens of the modal can surface the previous summary.
  const [profileAiSummary, setProfileAiSummary] = useState(null);
  const [profileSummaryLoading, setProfileSummaryLoading] = useState(false);
  const [profileTonePhoto, setProfileTonePhoto] = useState(null);
  const [profileTonePhotoSource, setProfileTonePhotoSource] = useState(null);
  const [profileToneSuggestion, setProfileToneSuggestion] = useState(null);
  const [profileToneSuggesting, setProfileToneSuggesting] = useState(false);
  const [profileToneError, setProfileToneError] = useState(null);
  // Reset wizard state every time the modal closes — keeps a re-open clean
  // (next session starts from saved userProfile, not a stale draft) and
  // prevents the Monk tone effect from re-firing with old state.
  useEffect(() => {
    if (showProfileModal) return;
    setProfileWizardStep(0);
    // Seed fresh on close so next open starts from saved userProfile
    // (not the stale draft from the last session).
    setProfileWizardForm({ ...DEFAULT_USER_PROFILE, ...(typeof userProfile === 'object' && userProfile ? userProfile : {}) });
    setProfileTonePhoto(null);
    setProfileTonePhotoSource(null);
    setProfileToneSuggestion(null);
    setProfileToneSuggesting(false);
    setProfileToneError(null);
  }, [showProfileModal]);
  // === SEED-ON-OPEN (May 2026 bug fix — Skin Profile clicks dead) ===
  // Symptom Jenni reported: opening the Skin Profile from the hamburger
  // menu showed the wizard but tapping answers did nothing. Root cause:
  // profileWizardForm is a single useState lazy-init'd at App mount with
  // whatever userProfile was at that moment. For cloud users, userProfile
  // hydrates LATER via loadFromSupabase — by then the form state is
  // already locked to the initial default. Tapping update() mutated that
  // stale shape, but the rendered active-state check (profileForm.foo === id)
  // could read against an object whose shape didn't include the key path
  // (or was a frozen reference), making the UI look like nothing happened.
  // Fix: when the modal opens, re-seed the wizard form from the LATEST
  // userProfile so the form always starts from a fresh shape that includes
  // every default key. Step index resets to 0 if requested via opener;
  // otherwise preserves whatever step the opener set (e.g. Refine's
  // 'Update goals' jumps straight to step 1).
  useEffect(() => {
    if (!showProfileModal) return;
    setProfileWizardForm({ ...DEFAULT_USER_PROFILE, ...(typeof userProfile === 'object' && userProfile ? userProfile : {}) });
  }, [showProfileModal]);
  // Sensitivities: ingredients/products user reacts badly to. Used in AI photo + product analysis.
  const [sensitivities, setSensitivities] = useState([]);
  // Daily regimen check-ins. One entry per date keyed by YYYY-MM-DD. Holds AM/PM product completion, devices, lifestyle.
  const [regimenLogs, setRegimenLogs] = useState([]);
  // Cover-page inline AI routine — built right from the cover, persists.
  const [coverRoutine, setCoverRoutine] = useState('');
  const [coverRoutineLoading, setCoverRoutineLoading] = useState(false);
  const [pearlExpanded, setPearlExpanded] = useState(false);
  const [coverAnalysisExpanded, setCoverAnalysisExpanded] = useState(false);
  // Tracks WHICH log is currently being retried — drives the "Analyzing…" state on the
  // cover button. Decoupled from log.analyzing (which was getting stuck across sessions).
  const [retryingLogId, setRetryingLogId] = useState(null);
  // Bumping this token triggers an auto-rebuild of the cover Recommended routine.
  // Wired to: regimen check-in submission, new skin-log save.
  const [coverRoutineRebuildToken, setCoverRoutineRebuildToken] = useState(0);
  // Ref points at the latest dashboard buildCoverRoutine() so we can call it from outside the IIFE
  // (which is where the function is currently defined). The dashboard render assigns it on each render.
  const buildCoverRoutineRef = useRef(null);
  const [showCheckInModal, setShowCheckInModal] = useState(false);
  // === RITUAL DATE NAVIGATION ===
  // ritualViewDate — which day's regimen the cover & regimen pages display.
  // Defaults to today; user can scrub backward (or forward) to view + edit
  // prior days. Also drives which date the CheckInModal edits when opened
  // from those surfaces. Stored as YYYY-MM-DD string.
  const [ritualViewDate, setRitualViewDate] = useState(() => localDateISO());
  // User-selected concerns being addressed (Ritual tab top). Merged with auto-detected at routine time.
  const [userConcerns, setUserConcerns] = useState([]);
  // Home devices owned (May 2026, derm pass) — LED mask, microneedling,
  // microcurrent, etc. Stored as an array of ids matching COMMON_DEVICES.
  // Asked in Build Step 5 so the routine can later incorporate device
  // cadence (microneedling = recovery night after, LED = daily-safe, etc.)
  const [homeDevices, setHomeDevices] = useState([]);
  const [toasts, setToasts] = useState([]);
  const [patternInsight, setPatternInsight] = useState(null);
  const [loadingPattern, setLoadingPattern] = useState(false);

  // === DASHBOARD COVER STATE ===
  // For Today summary is AI-generated and cached in localStorage by date+user
  const [forTodayText, setForTodayText] = useState('');
  const [forTodayLoading, setForTodayLoading] = useState(false);
  // Bumping this nonce forces the For Today AI text to regenerate.
  const [forTodayRefreshNonce, setForTodayRefreshNonce] = useState(0);
  // Floating launcher state
  const [showLauncher, setShowLauncher] = useState(false);
  // === INLINE LAUNCHER CHAT ===
  // When user asks a free-form question via the floating chat bubble,
  // we hold the conversation INSIDE the launcher modal instead of
  // navigating them to the Counsel tab. messages = [{role,content}].
  // Cleared when launcher closes (fresh thread each open).
  const [launcherMessages, setLauncherMessages] = useState([]);
  const [launcherChatLoading, setLauncherChatLoading] = useState(false);
  useEffect(() => {
    if (!showLauncher) {
      // Reset chat on close so re-opening starts fresh
      setLauncherMessages([]);
      setLauncherChatLoading(false);
    }
  }, [showLauncher]);
  const [launcherInput, setLauncherInput] = useState('');
  const [launcherLoading, setLauncherLoading] = useState(false);
  // Today's Regimen popup
  const [showTodaysRegimen, setShowTodaysRegimen] = useState(false);
  const [sampleRegimenConcern, setSampleRegimenConcern] = useState('redness');

  // Toast helper
  // Dedupe registry — keyed by message text, value is timestamp. Same toast
  // within 2s is silently dropped (kills "Build routine" / "Saved" stacks of
  // 20 from re-render loops).
  // === GLOBAL SUCCESS RATE LIMIT (May 2026 per Jenni) ===
  // Symptom: a single user save fired 3–4 different success toasts
  // ("Photo logged", "Analysis ready", "Added to AM routine",
  // "Procedure logged today", etc.) stacking into the corner. Per-msg
  // dedupe didn't catch them because each message string was different.
  // Now: any NEW success/info toast within 1500ms of the last
  // success/info is silently dropped. Errors always fire. This collapses
  // the multi-box stack into a single confirmation per user action.
  const toastDedupeRef = useRef({});
  const lastSuccessAtRef = useRef(0);
  const toast = (msg, type = 'success') => {
    const now = Date.now();
    // Per-message dedupe (same message twice within 2s → drop)
    const last = toastDedupeRef.current[msg];
    if (last && now - last < 2000) return;
    toastDedupeRef.current[msg] = now;
    // Global success/info rate limit — collapse chains into one box.
    if (type !== 'error' && type !== 'warning') {
      if (now - lastSuccessAtRef.current < 1500) return;
      lastSuccessAtRef.current = now;
    }
    const id = now + Math.random();
    setToasts(prev => [...prev, { id, msg, type }]);
    setTimeout(() => setToasts(prev => prev.filter(t => t.id !== id)), 4500);
  };

  // Cmd/Ctrl + K to open search
  useEffect(() => {
    const handler = (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        setShowSearch(true);
      }
      if (e.key === 'Escape') {
        setShowSearch(false);
      }
    };
    window.addEventListener('keydown', handler);
    return () => window.removeEventListener('keydown', handler);
  }, []);

  const [showLogModal, setShowLogModal] = useState(false);
  // Phase 2 logging-friction (May 2026): tapping Check In on the cover
  // opens the camera DIRECTLY (no form first). On capture, write a
  // minimal log + show a toast with an action to add details. Drops
  // friction from ~5 taps to 2.
  const [showCheckInCamera, setShowCheckInCamera] = useState(false);
  // Hidden file input for the "Upload photo" pill on the home cover.
  // Lets the user skip the camera modal entirely and go straight to
  // the OS file picker. Multi-select supported. Same downstream
  // queue + form as the camera path.
  const homeUploadInputRef = useRef(null);
  // Camera-or-Upload chooser sheet — opens when user taps "Check in"
  // on a day that ALREADY has a photo logged. (For empty days, the
  // pill goes straight to camera + a separate Upload pill is shown.)
  const [showCheckInChooser, setShowCheckInChooser] = useState(false);
  // === USED SOMETHING ELSE? PROMPT (May 2026 — Daily Ritual Loop Tier 2 #2) ===
  // State at App scope so it survives TodayRitualModal remounts (every
  // App re-render recreates the inner modal). When open=true the inline
  // text input + "Today only / Add to shelf" buttons replace the
  // closed-state pill. Input value is the typed product name.
  const [somethingElsePromptOpen, setSomethingElsePromptOpen] = useState(false);
  const [somethingElseInput, setSomethingElseInput] = useState('');
  // === REMOVE SCOPE PROMPT (May 2026 — Daily Ritual Loop Tier 2) ===
  // When the user taps the X on a product in Today's Ritual card on Home,
  // ask them whether they want to remove it for today only or also from
  // the future routine. Shape: { product, slot } | null. Closing without
  // a choice is a soft cancel — no mutation happens.
  const [removeScopePrompt, setRemoveScopePrompt] = useState(null);
  // Reads files from the home-cover upload input and populates the
  // post-capture details queue. Mirrors the camera modal's handleUpload
  // but doesn't pass through the modal first.
  const handleHomeUpload = async (e) => {
    const files = Array.from(e.target.files || []);
    if (files.length === 0) {
      // Reset destination if user cancelled file dialog.
      setCameraDestination('normal');
      return;
    }
    // === INSTANT PREVIEW (May 29 2026 per Jenni) ===
    // Was: awaited FileReader.readAsDataURL for ALL files before
    // showing anything. On a phone camera-roll image (~4MB) that's
    // 1-3s of dead time where the user thinks the tap did nothing.
    // Now: as soon as the file is in hand, create a blob URL
    // (synchronous, microseconds) and flip the onboarding hero to
    // the "Photo saved" state immediately. FileReader still runs in
    // the background to produce the base64 dataUrl the log needs.
    if (cameraDestination === 'onboarding' && files[0]) {
      try {
        const previewBlobUrl = URL.createObjectURL(files[0]);
        setOnboardingState(prev => ({
          ...prev,
          photoProvided: true,
          photoDataUrl: previewBlobUrl,
          photoSource: 'upload',
          photoLoading: true,
        }));
      } catch (_) { /* createObjectURL failures fall through to FileReader path */ }
    }
    try {
      const shots = await Promise.all(files.map(async (f) => {
        const dataUrl = await new Promise((res, rej) => {
          const reader = new FileReader();
          reader.onload = () => res(reader.result);
          reader.onerror = () => rej(new Error('Read failed'));
          reader.readAsDataURL(f);
        });
        const originalCapturedAt = f.lastModified ? new Date(f.lastModified).toISOString() : null;
        // Home/check-in uploads are today's reading even when the user picks
        // an older camera-roll photo. Historical imports preserve file dates
        // through PhotoImportQueue instead.
        const capturedAt = new Date().toISOString();
        return { dataUrl, capturedAt, originalCapturedAt, source: 'upload' };
      }));
      // === ONBOARDING PATH ===
      // Mirrors the onCapture branch in CameraCaptureModal — save first
      // shot as a log, kick analysis, surface chips inline on Step 2.
      if (cameraDestination === 'onboarding') {
        const apiKeyOn = !!getApiKey();
        const first = shots[0];
        // === CENTRALIZED via createPhotoLogs (June 2026 refactor) ===
        // Single-shot version — same helper, just one shot in the array.
        // The helper handles log shape, analyzing flag, and the analysis
        // fire pattern.
        const { newLogs: [newLog], fireAnalysis } = createPhotoLogs({
          shots: [{
            dataUrl: first.dataUrl,
            capturedAt: first.capturedAt,
            area: 'full-face',
            source: 'upload',
          }],
          apiKeyOn,
          travel: !!(userProfile?.travel?.active),
        });
        const updated = [newLog, ...logs];
        setLogs(updated);
        saveData('logs', updated).catch(err2 => { console.warn('[onboarding upload save]', err2?.message); });
        setOnboardingState(prev => {
          // Release the blob URL we set for the instant preview (no leaks).
          if (prev.photoDataUrl && typeof prev.photoDataUrl === 'string' && prev.photoDataUrl.startsWith('blob:')) {
            try { URL.revokeObjectURL(prev.photoDataUrl); } catch (_) {}
          }
          return {
            ...prev,
            photoProvided: true,
            photoDataUrl: first.dataUrl,
            photoSource: 'upload',
            photoLogId: newLog.id,
            photoAnalyzing: apiKeyOn,
            photoChips: null,
            photoLoading: false,
          };
        });
        if (apiKeyOn) fireAnalysis(retryLogAnalysis);
        setCameraDestination('normal');
        return;
      }
      // === NORMAL PATH ===
      setCheckInDetailsQueue(shots);
      setCheckInDetailsIdx(0);
    } catch (err) {
      console.warn('Home upload failed:', err);
      toast('Could not read photos', 'error');
      setCameraDestination('normal');
    } finally {
      if (e.target) e.target.value = '';
    }
  };
  // === POST-CAPTURE DETAILS QUEUE (May 2026 — Phase 2 refinement) ===
  // After capture OR upload, we open a small details form per photo:
  // date (auto-filled from EXIF/lastModified for uploads, now for live),
  // optional rating, observational chips, optional free-text note.
  // The queue lets multi-upload step through photos one by one without
  // trapping the user — they can "Skip rest" to batch-save remaining.
  const [checkInDetailsQueue, setCheckInDetailsQueue] = useState([]); // [{ dataUrl, capturedAt }, ...]
  const [checkInDetailsIdx, setCheckInDetailsIdx] = useState(0);
  const openCheckInDetailsForLog = (log) => {
    if (!log) return;
    const shot = {
      dataUrl: log.photo || null,
      photo: log.photo || null,
      photoPath: log.photoPath || null,
      capturedAt: log.capturedAt || (log.date ? `${log.date}T12:00:00` : new Date().toISOString()),
      date: log.date || localDateISO(),
      source: log.source || 'journal_edit',
      angle: log.angle,
      area: log.area || 'full-face',
      existingLogId: log.id,
      existingLog: log,
    };
    setCheckInDetailsQueue([shot]);
    setCheckInDetailsIdx(0);
  };
  // Hoisted SkinLogModal form state — same lifecycle fix as ProductModal. SkinLogModal
  // is recreated on every App render, which can wipe local useState mid-flow (e.g. when
  // a toast fires during the photo-analyze step and the user clicks Save before the
  // modal remount completes). Keeping form state at App scope eliminates that race.
  const [skinLogForm, setSkinLogForm] = useState(null);
  const [skinLogSuggesting, setSkinLogSuggesting] = useState(false);
  const [skinLogShowCamera, setSkinLogShowCamera] = useState(false);
  // Belt-and-suspenders ref backing the form. Even if some edge case wipes React state
  // (toast race, Suspense boundary, etc.), the ref preserves the latest captured photo
  // + form fields synchronously. handleSubmit reads ref FIRST, falls back to state.
  const skinLogFormRef = useRef(null);
  // === MODAL SCROLL PRESERVATION ===
  // Modals are defined inside App (e.g. SkinLogModal, ProductModal, ProcedureModal,
  // TodayRitualModal). Each App re-render gives them a fresh function reference, so
  // React unmounts/remounts the modal subtree — which resets the scrollable .modal-card
  // div's scrollTop to 0. Result: tapping a concern chip / dragging the rating slider /
  // any setForm call jumped the screen up. We solve this by remembering the last
  // scroll position per modal key in this App-scope ref (survives the remount), then
  // restoring it via useLayoutEffect inside each modal. New modal openings reset to 0.
  const modalScrollMemo = useRef({});
  // Hook helper — each modal calls this with a unique key to get back a sentinel
  // ref. Spread the ref on a hidden <span> inside the Modal so we can find the
  // scrollable .modal-card ancestor and restore/track scrollTop.
  const useModalScrollPreserve = (key) => {
    const sentinelRef = useRef(null);
    React.useLayoutEffect(() => {
      const card = sentinelRef.current?.closest('.modal-card');
      if (!card) return;
      const stored = modalScrollMemo.current[key] ?? 0;
      if (stored > 0) card.scrollTop = stored;
      const onScroll = () => { modalScrollMemo.current[key] = card.scrollTop; };
      card.addEventListener('scroll', onScroll, { passive: true });
      return () => card.removeEventListener('scroll', onScroll);
    });
    return sentinelRef;
  };
  // === HOISTED RITUAL FORM STATE ===
  // Same fix as SkinLogModal: TodayRitualModal is defined inside App, so any
  // parent re-render (e.g. background Gemini art generation, metric backfill,
  // photo upload progress) recreates the modal function reference and wipes
  // its local useState. By keeping the form at App scope + a ref backing,
  // user product selections survive every parent re-render.
  // (Note: an older sibling — RegimenCheckInModal — used to share this
  // state. Removed in May 2026 Phase 2 cleanup; only TodayRitualModal
  // reads/writes ritualForm now.)
  const [ritualForm, setRitualForm] = useState(null);
  const ritualFormRef = useRef(null);
  // === PROMPT TO ADD A TYPED EXTRA TO THE SHELF ===
  // When the user types "Niacinamide 10%" into AM/PM extras of the regimen
  // check-in, we offer to materialize that as a real shelf product so they
  // get ingredients, AI art, and reuse on subsequent days.
  const [pendingShelfAdd, setPendingShelfAdd] = useState(null);
  const pendingShelfAddRef = useRef(null);
  // Sub-tab toggle inside the new modal — 'am' or 'pm'.
  // === AUTO PM-SWITCH AFTER 5PM ===
  // Defaults the AM/PM toggle on initial mount based on the user's local time.
  // After 5PM local → start on PM so the user lands on the evening routine
  // and gets nudged to log it. Before 5PM → AM (default morning routine).
  // This applies on BOTH Home (Atelier cover) and Regimen page because they
  // share the same ritualSlot state. Manual toggles override the auto-default
  // for the rest of the session — re-opening the app re-evaluates the time.
  //
  // Timezone: uses the browser's local time (Date.getHours() is timezone-aware
  // via the OS clock). Users in any timezone get correct behavior automatically.
  // FOLLOW-UP: add an optional explicit timezone field to the Clinical Skin
  // Profile for users who want to override (e.g. travel, force a different
  // PM cutoff). For now, browser local time covers the common case.
  const [ritualSlot, setRitualSlot] = useState(() => {
    try {
      const h = new Date().getHours();
      return h >= 17 ? 'pm' : 'am';
    } catch (_) {
      return 'am';
    }
  });
  // === BULK PHOTO UPLOAD ===
  // Lets users upload many photos at once. Each photo becomes its own log entry with a
  // user-assigned date. Default mode: all photos share one date. Per-photo mode: user
  // picks a date for each. No AI analysis runs upfront — kept fast for back-filling weeks
  // of history. User can run analysis later via the cover Analyze button.
  const [showBulkUploadModal, setShowBulkUploadModal] = useState(false);
  // === GUIDED PHOTO CAPTURE (May 2026) ===
  // 5-step face capture (front/left/right/T-zone/chin-jaw) used by
  // onboarding, daily check-in, Home. Separate state from BulkPhotoUpload
  // because the surfaces and handlers differ:
  //   - guided: one structured capture session per day, stored as logs
  //     with {angle, source:'guided_capture', capturedAt} metadata
  //   - bulk: back-fill many old photos from camera roll with date picker
  // `guidedCaptureCtx` carries the caller's intent so the completion
  // handler knows where to send the shots. Shape:
  //   { intent: 'today' | 'onboarding_baseline' | 'check_in', onDone?: fn }
  const [showGuidedCaptureModal, setShowGuidedCaptureModal] = useState(false);
  const [guidedCaptureCtx, setGuidedCaptureCtx] = useState(null);
  // === HOME UPLOAD PICKER (May 2026) ===
  // Bottom sheet on Home: Take today's photo set / Upload today's photos
  // / Import photo history. Each routes to a different modal.
  const [showHomeUploadPicker, setShowHomeUploadPicker] = useState(false);
  // === PHOTO IMPORT QUEUE (May 2026) ===
  // Replaces the older BulkPhotoUploadModal for "Import photo history".
  // Modal-style overlay with its own header + step indicator + drawer.
  const [showPhotoImportQueue, setShowPhotoImportQueue] = useState(false);
  // === GEMINI PRODUCT ART ===
  // Generates AI bottle images for both (a) the starter lineup when shelf is empty
  // and (b) the user's actual regimen products. Cached as data URIs by:
  //   - starter slug (e.g. 'sk2', 'aestura') — global STARTER_PRODUCT_PREVIEWS
  //   - 'prod-<id>' — user's own products (when they lack a real photo)
  // Tries the preview model first, falls back to the GA model name if the preview
  // 404s. Surfaces error in console + toast so failures are visible.
  const [generatedProductArt, setGeneratedProductArtState] = useState(getGeneratedProductArt());
  const [generatingProductArt, setGeneratingProductArt] = useState(false);
  // Structured last-failure slot — surfaced as an inline banner under Today's Ritual
  // when art fails. Shape: { kind, model, status, message, raw } | null.
  // kind ∈ 'auth' (key rejected) | 'model' (404 / not enabled) | 'quota' (429)
  //       | 'safety' (200 OK but no image, e.g. blocked) | 'network' (CORS/fetch fail)
  //       | 'unknown'
  const [productArtError, setProductArtError] = useState(null);
  // === PRE-WARM HANDOFF ===
  // The early <script> in <head> fires Gemini requests for the 4 starter bottles
  // before React mounts. Each finished image is written to localStorage and a
  // 'lumiere:art-updated' CustomEvent is dispatched. We listen here so the cover
  // re-renders the moment a starter image lands, even if React mounted before
  // the network call returned.
  useEffect(() => {
    const onArtUpdate = () => setGeneratedProductArtState(getGeneratedProductArt());
    window.addEventListener('lumiere:art-updated', onArtUpdate);
    // Also do a one-shot read on mount in case events fired before this listener
    // attached (race between Babel compile time and the pre-warm fetch).
    onArtUpdate();
    return () => window.removeEventListener('lumiere:art-updated', onArtUpdate);
  }, []);
  // Build a per-product art prompt from the product's category. Deliberately
  // generic — does NOT pass brand or product name to the model and does NOT
  // ask the model to reproduce real packaging. The intent is decorative
  // category-cue art (so the user can scan the lineup and tell "that's a
  // serum, that's a sunscreen") without depicting any specific brand's trade
  // dress. Brand + product name are shown as text below the image instead.
  //
  // Why this matters: asking Gemini to "reproduce label colors, brand
  // typography, distinctive graphics" of a real brand SKU could produce
  // images that infringe trade dress / trademark, especially if shared. The
  // generic-bottle approach sidesteps that entirely while still giving the
  // user a recognizable visual placeholder per product slot.
  const promptForUserProduct = (p) => {
    const cat = (p.category || '').toLowerCase().trim();
    // Map each known category to a generic bottle/tube/jar archetype with a
    // distinct color so different categories are visually distinguishable in
    // the lineup. Within a category the user relies on the text caption to
    // tell their two cleansers apart — that's a small UX cost and a big
    // legal-risk reduction.
    const archetype = ({
      cleanser:    'a soft pearl-white pump bottle with a slim cylindrical body',
      toner:       'a slim clear glass bottle with a screw cap',
      serum:       'a small amber glass dropper bottle',
      essence:     'a frosted clear glass bottle with a slim rectangular silhouette',
      ampoule:     'a silver chrome metallic ampoule bottle with a pump dispenser top',
      moisturizer: 'a soft cream-colored ceramic-look jar with a flat round lid',
      cream:       'a soft cream-colored squeeze tube with a small flip cap',
      sunscreen:   'a soft white sunscreen tube with a powder-blue cap',
      treatment:   'a small dark-glass apothecary bottle with a dropper',
      exfoliant:   'a soft taupe squeeze tube with a small flip cap',
      mask:        'a wide soft beige tub with a flat round lid',
      oil:         'an amber glass dropper bottle with a slim cylindrical body',
      other:       'a minimalist unmarked beige bottle with a screw cap',
    }[cat]) || 'a minimalist unmarked beige bottle with a screw cap';
    return `A minimalist editorial product photograph of ${archetype}, plain matte unmarked surface, on a true white paper background with a pale pink or powder-blue field accent. Diffuse natural light from upper-left, gentle soft shadow on the right. Centered, full product visible top-to-bottom, no crops. Magazine beauty aesthetic — clean, premium, scandi-meets-Japanese.

NO text, NO logos, NO brand markings, NO label graphics, NO accent stripes. Render the bare unbranded vessel only. NO extra props, NO hands, NO water droplets, NO botanical elements.`;
  };
  // Single-image fetch helper — tries multiple model names. Logs every attempt to
  // console with prefix [gemini-art] so failures are inspectable in DevTools.
  // Returns either a data-URI string OR throws an Error whose `.cause` is a
  // structured { kind, model, status, message, raw } object so the caller can
  // surface a useful diagnostic instead of a generic toast.
  //
  // Failure taxonomy:
  //   - 'auth'    — 401/403, API_KEY_INVALID, PERMISSION_DENIED. Key needs a paid
  //                 project with the Generative Language API enabled. Image gen is
  //                 NOT in the free tier as of 2026-05.
  //   - 'model'   — 404 / NOT_FOUND. Every model name in the chain has been retired
  //                 or never existed. Update the chain.
  //   - 'quota'   — 429. Free-tier or per-minute limit hit. Wait or upgrade tier.
  //   - 'safety'  — 200 OK but the response has no inlineData. Either the prompt
  //                 tripped a safety filter or `responseModalities` is being
  //                 ignored by the model. The candidate's `finishReason` tells us.
  //   - 'network' — fetch threw (CORS, DNS, offline, AdBlock). Browser console will
  //                 have the underlying TypeError.
  //   - 'unknown' — anything else.
  //
  // The chain order matters: 2.5-flash-image-preview is the canonical 2026 ID,
  // 2.5-flash-image is the GA alias (some projects only have one or the other),
  // imagen-3.0 is a paid alternative if the flash-image family is unavailable,
  // and the 2.0 names are kept as last-ditch fallbacks for legacy projects.
  const fetchGeminiImage = async (_unusedKey, prompt) => {
    // Default chain. If a model has worked before, hoist it to the front so we
    // skip the whole "try preview, try GA, try imagen, try 2.0…" tax on every
    // call. After the first successful gen this drops latency by ~2-4s.
    // Note: the `_unusedKey` arg is kept for back-compat with existing callers
    // — auth is now handled by the Supabase proxy (or BYO-key inside callGeminiProxied).
    const baseModels = [
      'gemini-2.5-flash-image-preview',
      'gemini-2.5-flash-image',
      'imagen-3.0-generate-002',
      'gemini-2.0-flash-preview-image-generation',
      'gemini-2.0-flash-exp-image-generation',
    ];
    const lastWorking = getLastWorkingGeminiModel();
    const models = lastWorking
      ? [lastWorking, ...baseModels.filter(m => m !== lastWorking)]
      : baseModels;
    let lastErr = { kind: 'unknown', model: null, status: null, message: 'all Gemini image models failed', raw: null };
    for (const model of models) {
      try {
        console.log('[gemini-art] trying', model, '· prompt:', prompt.slice(0, 80) + '…');
        // Per-attempt timeout: 45s. iOS Safari aggressively kills hung fetches
        // when the tab loses focus or the device sleeps; without an explicit
        // abort, a hung request can wedge the worker pool indefinitely.
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 45000);
        const { resp, viaProxy } = await callGeminiProxied({
          mode: 'image',
          model,
          payload: {
            contents: [{ parts: [{ text: prompt }] }],
            generationConfig: { responseModalities: ['TEXT', 'IMAGE'] },
          },
          signal: controller.signal,
        }).finally(() => clearTimeout(timeoutId));
        if (!resp.ok) {
          const errText = await resp.text();
          // Try to extract the error.message + status from the JSON body
          // (works for both Google direct and the proxy's pass-through).
          let parsed = null;
          try {
            const j = JSON.parse(errText);
            parsed = j?.error || j;
          } catch (_) {}
          const apiStatus = parsed?.status || parsed?.error || '';
          const apiMsg = parsed?.message || parsed?.detail || errText.slice(0, 200);
          let kind = 'unknown';
          // Proxy-specific: 429 with `rate_limit_exceeded` means user hit their daily cap.
          if (viaProxy && resp.status === 429) kind = 'quota';
          else if (resp.status === 401 || resp.status === 403 || /API_KEY_INVALID|PERMISSION_DENIED|API key not valid/i.test(apiStatus + ' ' + apiMsg)) kind = 'auth';
          else if (resp.status === 404 || /NOT_FOUND|is not found/i.test(apiStatus + ' ' + apiMsg)) kind = 'model';
          else if (resp.status === 429 || /RESOURCE_EXHAUSTED|quota|rate_limit/i.test(apiStatus + ' ' + apiMsg)) kind = 'quota';
          lastErr = { kind, model, status: resp.status, message: apiMsg, raw: errText.slice(0, 600) };
          console.warn(`[gemini-art] ${kind} fail:`, model, '→', resp.status, apiMsg);
          // If the cached working model failed, invalidate it so we go back to
          // probing the full chain on the next call (the Google project may have
          // had its model access revoked / preview deprecated).
          if (lastWorking && model === lastWorking) clearLastWorkingGeminiModel();
          // For auth + quota, retrying other models won't help — bail early.
          if (kind === 'auth' || kind === 'quota') break;
          continue;
        }
        const data = await resp.json();
        const candidate = data?.candidates?.[0];
        const parts = candidate?.content?.parts || [];
        const part = parts.find(pt => pt.inlineData || pt.inline_data);
        const inline = part?.inlineData || part?.inline_data;
        if (inline?.data) {
          console.log('[gemini-art] ✓', model, '→', (inline.data.length / 1024).toFixed(1), 'KB');
          // Cache so future calls hit this model directly.
          setLastWorkingGeminiModel(model);
          return `data:${inline.mimeType || inline.mime_type || 'image/png'};base64,${inline.data}`;
        }
        // 200 OK but no image. Diagnose: was it a safety block, or is the model
        // ignoring responseModalities (i.e. wrong endpoint for this model)?
        const finishReason = candidate?.finishReason || candidate?.finish_reason || 'UNKNOWN';
        const textPart = parts.find(pt => pt.text)?.text || '';
        const safetyRatings = candidate?.safetyRatings || candidate?.safety_ratings;
        const blocked = /SAFETY|BLOCKLIST|PROHIBITED/i.test(finishReason) || (safetyRatings && safetyRatings.some(r => r.blocked));
        lastErr = {
          kind: blocked ? 'safety' : 'model',
          model,
          status: 200,
          message: blocked
            ? `Blocked by safety filter (${finishReason})`
            : `Model returned text only — likely doesn't support image output. ${textPart ? '"' + textPart.slice(0, 80) + '"' : ''}`,
          raw: JSON.stringify(data).slice(0, 600),
        };
        console.warn('[gemini-art] no-image:', model, '·', lastErr.message);
      } catch (e) {
        // AbortError = our 45s timeout fired. Classify as network so the user
        // sees "Network" in the diagnostic banner instead of a vague "fetch failed".
        const isAbort = e && (e.name === 'AbortError' || /aborted/i.test(e.message || ''));
        lastErr = {
          kind: 'network',
          model,
          status: null,
          message: isAbort ? `Timed out after 45s on ${model}` : (e.message || String(e)),
          raw: null,
        };
        console.warn('[gemini-art] network/exception:', model, '·', isAbort ? 'TIMEOUT' : e.message);
      }
    }
    const err = new Error(`Gemini image gen failed: ${lastErr.kind} · ${lastErr.message}`);
    err.cause = lastErr;
    throw err;
  };
  const generateProductArtForAll = async (opts = {}) => {
    // SMOKE-TEST ESCAPE HATCH (May 2026 — Phase 2 guardrails).
    // `npm run check` loads the app in jsdom with window.__SMOKE_TEST__ = true.
    // Skip the Gemini image pipeline entirely under that flag so the check
    // doesn't burn API quota or spam the test log with 503 fallbacks.
    // Real browser runs are unaffected (window.__SMOKE_TEST__ is undefined).
    if (typeof window !== 'undefined' && window.__SMOKE_TEST__) return;
    // No key required — the Supabase proxy handles auth. We pass the user's
    // BYO key through to fetchGeminiImage if they've set one, otherwise the
    // proxy is used (subject to the 40/day image cap).
    const key = getGeminiKey();
    setGeneratingProductArt(true);
    const next = { ...getGeneratedProductArt() };
    const force = !!opts.force;
    // Build the queue — starters that aren't cached + user products in today's
    // regimen (or active shelf) that lack a real photo + lack cached art.
    const queue = [];
    for (const p of STARTER_PRODUCT_PREVIEWS) {
      if (force || !next[p.slug]) queue.push({ key: p.slug, prompt: p.prompt });
    }
    // User regimen products — pull from yesterday's submitted check-in if available,
    // otherwise from active shelf. Cap at 4 (matches the 4-slot lineup).
    const todayK = localDateISO();
    const yKey = (() => { const d = new Date(); d.setDate(d.getDate() - 1); return localDateISO(d); })();
    const todayCheckIn = (regimenLogs || []).find(r => r.date === todayK && r.submitted);
    const yCheckIn = (regimenLogs || []).find(r => r.date === yKey && r.submitted);
    const checkIn = todayCheckIn || yCheckIn;
    const usedIds = checkIn
      ? [...(checkIn.amProducts || []), ...(checkIn.pmProducts || [])]
      : (products || []).filter(p => !p.endDate).slice(0, 4).map(p => p.id);
    const usedProducts = [...new Set(usedIds)].map(id => (products || []).find(p => p.id === id)).filter(Boolean).slice(0, 4);
    for (const p of usedProducts) {
      const slot = `prod-${p.id}`;
      const hasRealPhoto = p.photo || p.photoPath;
      if (hasRealPhoto) continue;
      if (!force && next[slot]) continue;
      queue.push({ key: slot, prompt: promptForUserProduct(p) });
    }
    if (queue.length === 0) {
      setGeneratingProductArt(false);
      return;
    }
    // === PARALLEL EXECUTION WITH BOUNDED CONCURRENCY ===
    // Old loop ran serially (4 starters × ~5s each = 20s). With concurrency=4
    // the same queue completes in ~5-7s wall-clock since Gemini handles the
    // requests in parallel server-side. Cap at 4 so we don't spam the API or
    // get rate-limited (free tier has per-minute quotas).
    let success = 0;
    let failures = 0;
    let lastFail = null;
    let aborted = false;
    const CONCURRENCY = 4;
    const runOne = async (job) => {
      if (aborted) return;
      try {
        const dataUri = await fetchGeminiImage(key, job.prompt);
        next[job.key] = dataUri;
        success++;
        // Persist incrementally so partial progress survives a tab close.
        // The setState here triggers a single re-render per completion which
        // is what makes the bottles "pop in" one at a time as they finish.
        setGeneratedProductArt(next);
        setGeneratedProductArtState({ ...next });
      } catch (e) {
        failures++;
        lastFail = e.cause || { kind: 'unknown', message: e.message };
        console.error('[gemini-art] failed for', job.key, '·', lastFail.kind, '·', lastFail.message);
        // For auth/quota, signal the worker pool to stop launching new jobs —
        // every remaining product would hit the same wall.
        if (lastFail.kind === 'auth' || lastFail.kind === 'quota') aborted = true;
      }
    };
    // Worker-pool pattern: pull jobs off a shared queue from N parallel workers.
    // Cleaner than slicing the queue into chunks because slow jobs don't block
    // the next chunk — workers just grab the next available job.
    const queueCopy = [...queue];
    const workers = Array(Math.min(CONCURRENCY, queueCopy.length)).fill(null).map(async () => {
      while (queueCopy.length > 0 && !aborted) {
        const job = queueCopy.shift();
        if (job) await runOne(job);
      }
    });
    await Promise.all(workers);
    setGeneratingProductArt(false);
    // === GEMINI WORK STAYS SILENT ===
    // Per Jenni: no notifications about Gemini work — bottle generation,
    // quota, errors. The art appears or doesn't; the user shouldn't be
    // pinged about background AI activity. We still log to console for
    // debugging and keep `productArtError` state for inline UI affordances.
    if (success > 0 && failures === 0) {
      setProductArtError(null);
    } else if (success > 0) {
      setProductArtError(lastFail);
    } else {
      setProductArtError(lastFail);
      console.warn('[product-art]', lastFail?.kind || 'failed', lastFail);
    }
  };
  // Auto-fire on first mount if any expected slot is empty. Re-fires whenever
  // products or regimen change, so newly-added products get their art generated.
  // Content-based signature (not just .length) — adding a product to an existing
  // regimen mutates contents without changing length, and we still need to re-paint.
  const lastArtSyncRef = useRef('');
  // Build a stable string signature of (today/yesterday's check-in product ids +
  // brand+name strings of all products) so any meaningful change re-triggers art gen.
  const productArtSig = (() => {
    const todayK = localDateISO();
    const yKey = (() => { const d = new Date(); d.setDate(d.getDate() - 1); return localDateISO(d); })();
    const checkIn = (regimenLogs || []).find(r => (r.date === todayK || r.date === yKey) && r.submitted);
    const checkInIds = checkIn ? [...(checkIn.amProducts || []), ...(checkIn.pmProducts || [])].join(',') : '';
    const productFingerprints = (products || [])
      .filter(p => !p.endDate)
      .map(p => `${p.id}:${(p.brand||'').trim()}|${(p.name||'').trim()}`)
      .join(';');
    return `${checkInIds}::${productFingerprints}`;
  })();
  useEffect(() => {
    // Proxy works without a user key, so we no longer gate art-gen on getGeminiKey().
    const cached = getGeneratedProductArt();
    // Build a signature of what we expect to have — starter slugs + user product ids.
    const todayK = localDateISO();
    const yKey = (() => { const d = new Date(); d.setDate(d.getDate() - 1); return localDateISO(d); })();
    const checkIn = (regimenLogs || []).find(r => (r.date === todayK || r.date === yKey) && r.submitted);
    const usedIds = checkIn
      ? [...(checkIn.amProducts || []), ...(checkIn.pmProducts || [])]
      : (products || []).filter(p => !p.endDate).slice(0, 4).map(p => p.id);
    const expected = [
      ...STARTER_PRODUCT_PREVIEWS.map(p => p.slug),
      ...[...new Set(usedIds)].map(id => `prod-${id}`),
    ];
    const sig = expected.join('|') + '#' + productArtSig;
    // Only re-run if the expected set or product content changed (avoids loops).
    if (sig === lastArtSyncRef.current) return;
    lastArtSyncRef.current = sig;
    const missing = expected.some(k => !cached[k]);
    // Product art is intentionally text/icon-only now: no background AI
    // bottle generation and no cached synthetic product imagery in routine UI.
    if (missing) return;
  }, [productArtSig]);

  // === AI SUGGEST (opt-in) STATE ===
  // Moved up here so the useEffect below (RITUAL · AI SUGGEST FETCH) can
  // reference these in its dependency array without hitting TDZ.
  // Shape:
  //   ritualSuggestSheet: null | { dateISO, source: 'today' | 'day' }
  //   ritualSuggestion:   null | { am:[{name, productId|null, why}], pm:[...], rationale }
  //   ritualSuggestSelected: Set of "am-<idx>" / "pm-<idx>" keys currently checked
  const [ritualSuggestSheet, setRitualSuggestSheet] = useState(null);
  const [ritualSuggestion, setRitualSuggestion] = useState(null);
  const [ritualSuggestSelected, setRitualSuggestSelected] = useState(() => new Set());
  const [ritualSuggestLoading, setRitualSuggestLoading] = useState(false);
  const [ritualSuggestError, setRitualSuggestError] = useState('');
  // Token bumped each time we want to (re-)trigger an AI suggestion fetch.
  const [ritualSuggestToken, setRitualSuggestToken] = useState(0);
  // Track which sheet+token pair we've already fetched so the effect doesn't
  // refire on every unrelated render.
  const lastRitualSuggestKeyRef = useRef('');

  // === RITUAL · AI SUGGEST FETCH ===
  // Fires when the suggest sheet opens (with a fresh dateISO) or when the user
  // hits Re-roll (which bumps ritualSuggestToken). Single source of truth for
  // the network call — keeps it out of the render path.
  useEffect(() => {
    if (!ritualSuggestSheet) return;
    const key = `${ritualSuggestSheet.dateISO}#${ritualSuggestToken}`;
    if (key === lastRitualSuggestKeyRef.current) return;
    lastRitualSuggestKeyRef.current = key;
    if (!getApiKey()) {
      setRitualSuggestError('Set your Anthropic API key first.');
      setShowApiKeyModal(true);
      return;
    }
    let cancelled = false;
    (async () => {
      setRitualSuggestion(null);
      setRitualSuggestSelected(new Set());
      setRitualSuggestError('');
      setRitualSuggestLoading(true);
      try {
        const dateISO = ritualSuggestSheet.dateISO;
        const date = new Date(dateISO + 'T00:00:00');
        const shelfBlock = (products || [])
          .filter(p => !p.endDate)
          .map(p => `- ${p.name}${p.brand ? ' (' + p.brand + ')' : ''}${p.activeIngredients ? ' [' + p.activeIngredients + ']' : ''}${p.category ? ' · ' + p.category : ''} {id:${p.id}}`)
          .join('\n') || '(empty shelf)';
        const concernsText = (userConcerns && userConcerns.length > 0) ? userConcerns.join(', ') : 'general maintenance';
        const sensText = (sensitivities || []).map(s => s.trigger || s.name || s).filter(Boolean).join(', ') || 'none reported';
        const recentLog = (logs || [])[0];
        const recentBlock = recentLog ? `Last skin log: ${recentLog.date}, ${recentLog.area}, ${recentLog.rating}/10${recentLog.concerns?.length ? ' · concerns: ' + recentLog.concerns.join(', ') : ''}` : 'No recent skin logs.';
        const dayLabel = date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
        const prompt = `You are an educational, dermatology-informed skincare advisor designing a focused AM and PM skincare plan for ${dayLabel} (this is informational guidance, not a medical diagnosis). Output ONLY valid JSON with no preamble or trailing prose.

USER CONCERNS: ${concernsText}
SENSITIVITIES (avoid these): ${sensText}
${recentBlock}

USER'S SHELF (use these IDs when proposing a product they already own):
${shelfBlock}

Rules:
- Propose 3–6 AM steps and 3–6 PM steps. Order them in the correct application sequence (cleanser → treatment → moisturizer → SPF for AM; cleanser → treatment → moisturizer for PM).
- For each step, prefer a product from the shelf when one fits. If a true gap exists, propose a generic category (e.g. "Niacinamide serum 5–10%") with productId set to null.
- Do NOT propose anything that conflicts with the listed sensitivities.
- Each "why" is 3–8 words, evidence-grade in voice ([A]/[B]/[C] when relevant), no marketing fluff.

Return JSON in EXACTLY this shape (no markdown fences, no commentary):
{
  "rationale": "one sentence on the overall logic, max 25 words",
  "am": [{"name":"…", "productId": <id or null>, "category":"cleanser|treatment|moisturizer|spf", "why":"…"}],
  "pm": [{"name":"…", "productId": <id or null>, "category":"cleanser|treatment|moisturizer", "why":"…"}]
}`;
        const text = await callClaude(prompt, '', null, { model: 'claude-sonnet-4-6', maxTokens: 1500 });
        if (cancelled) return;
        const jsonMatch = text.match(/\{[\s\S]*\}/);
        if (!jsonMatch) throw new Error('AI did not return JSON. Got: ' + text.slice(0, 120));
        const parsed = JSON.parse(jsonMatch[0]);
        if (!Array.isArray(parsed.am) || !Array.isArray(parsed.pm)) throw new Error('Malformed plan: missing am/pm arrays');
        setRitualSuggestion(parsed);
        // Suggestions start UNSELECTED — user has to tap "Select" on each
        // one they want. (Previously pre-checked everything which made
        // "Add to ritual" feel automatic instead of curated.)
        setRitualSuggestSelected(new Set());
      } catch (e) {
        if (cancelled) return;
        console.error('[ritual-suggest] failed:', e);
        setRitualSuggestError(e.message || 'Suggestion failed');
      }
      if (!cancelled) setRitualSuggestLoading(false);
    })();
    return () => { cancelled = true; };
  }, [ritualSuggestSheet, ritualSuggestToken]);

  // === SHELF · AUTO-ANALYZE ON EXPAND ===
  // First time the user expands a product card on the Shelf, auto-fire the AI
  // === SHELF · AUTO-ANALYZE ON EXPAND moved further down to fix TDZ.
  //     This effect references expandedShelfProductId / productAssessment /
  //     assessingProduct, all of which are declared ~100 lines later in App.
  //     Like the AI-Suggest useEffect, the dep array is evaluated synchronously
  //     during App() body, so any reference here would throw TDZ on browsers
  //     using React's production build. Moved to right after those useState
  //     declarations — see below. ===

  // === POST-SAVE ACTION BANNER ===
  // After a SkinLog save, surface a brief banner with smart pills inviting the user
  // to log a procedure or start a product on the same day. Suppressed for items they
  // already logged inline via the modal's "Also today" chip rail. Auto-dismisses after
  // ~12 seconds; user can also dismiss manually. Shape: { date, suggestProcedure,
  // suggestProductStart } | null.
  const [postSaveSuggestion, setPostSaveSuggestion] = useState(null);
  React.useEffect(() => {
    if (!postSaveSuggestion) return;
    const t = setTimeout(() => setPostSaveSuggestion(null), 12000);
    return () => clearTimeout(t);
  }, [postSaveSuggestion]);
  // === USE-TODAY PROMPT (May 2026) ===
  // After a new product is saved from a non-routine context (Cover
  // "+ Product" pill, Check-in bridge "+ New product"), surface a quiet
  // banner asking if the user wants to slot it into today's AM or PM.
  // Today's-regimen "+ New Product" path is EXEMPT — that flow already
  // auto-slots into the active tab via productModalRegimenContext, so
  // re-asking would be friction. Shape: { product: {id,name,...} } | null.
  const [useTodayPrompt, setUseTodayPrompt] = useState(null);
  // === PROMOTE-TO-ROUTINE BANNER (May 2026 per Jenni) ===
  // Fires after a NEW product (or batch of products from brand search) is
  // saved into today's regimenLog via the "Used something else? → Started
  // a new product" path on the Home cover. The product(s) are already
  // logged for today; this banner asks whether the user wants them in
  // their weekly routine permanently. Tap → set cadence + useTimes and
  // route them to Regimen → today edit so they can see it land. Dismiss
  // → no-op (the day's log keeps it as a one-off).
  // Shape: { productIds: number[], productNames: string[], slot: 'am'|'pm' }
  //   (single-product callers pass arrays of length 1).
  const [promoteToRoutinePrompt, setPromoteToRoutinePrompt] = useState(null);
  // === PROCEDURE-REBUILD PROMPT (June 2026 per Jenni) ===
  // After a user logs a procedure (microneedling / peel / facial / etc.),
  // surface a small top banner asking "Rebuild your routine around this?"
  // Tap [Yes, refine] routes to Regimen → Refine with a procedure-aware
  // intent (post-procedure care needs different actives, gentler cadence).
  // Auto-dismisses after 8s same as the promote-to-routine banner.
  const [procedureRebuildPrompt, setProcedureRebuildPrompt] = useState(null);
  useEffect(() => {
    if (!procedureRebuildPrompt) return;
    const t = setTimeout(() => setProcedureRebuildPrompt(null), 8000);
    return () => clearTimeout(t);
  }, [procedureRebuildPrompt]);
  useEffect(() => {
    if (!promoteToRoutinePrompt) return;
    const t = setTimeout(() => setPromoteToRoutinePrompt(null), 8000);
    return () => clearTimeout(t);
  }, [promoteToRoutinePrompt]);
  React.useEffect(() => {
    if (!useTodayPrompt) return;
    const t = setTimeout(() => setUseTodayPrompt(null), 8000);
    return () => clearTimeout(t);
  }, [useTodayPrompt]);
  // === DAILY COVER PICK ===
  // The cover/timeline default to a full-face photo for the day. If the user only logged
  // non-full-face shots (cheek, T-zone), they can manually pick which photo represents
  // that day. dailyCoverPick is { [YYYY-MM-DD]: logId } — sparse map, only for overrides.
  const [dailyCoverPick, setDailyCoverPick] = useState({});
  const [showCoverPickerForDate, setShowCoverPickerForDate] = useState(null); // null or YYYY-MM-DD
  const [showProductModal, setShowProductModal] = useState(false);
  const [editingProductId, setEditingProductId] = useState(null);
  // Brief sage-tinted "Saved ✓" flash on the ProductModal save pill after a
  // successful create-mode add. Modal stays open for multi-add, so the pill
  // morphs in place: SAVE TO SHELF → SAVED ✓ → SAVE TO SHELF (~1.4s window).
  // Per Jenni (May 2026): the toast wasn't enough confirmation that scan /
  // search-by-name / search-by-brand had actually committed the product.
  const [productSaveFlash, setProductSaveFlash] = useState(false);
  // === USED-SOMETHING-ELSE bottom sheet (May 2026 Home redesign) ===
  // Today-only addition sheet, opened from the cover Ritual card's
  // secondary CTA. Shape: { open, slot, date } | null.
  //   open  — boolean toggle
  //   slot  — 'am' | 'pm' (which slot the addition lands in)
  //   date  — viewDate the user is on (so a scrubbed prior-day card still
  //           targets the right log)
  // Important: "Used something else?" = today-only. "Edit routine" =
  // future plan. Keep separate per Jenni's spec.
  const [usedSomethingElseSheet, setUsedSomethingElseSheet] = useState(null);
  const [usedSomethingElseInput, setUsedSomethingElseInput] = useState('');
  const [usedSomethingElseKind, setUsedSomethingElseKind] = useState(null); // 'supplement' | 'note' | null
  // === ADD-DEVICE picker sheet (May 2026, Refine) ===
  // Replaces the generic ProductModal route for the "Add a device" tile.
  // Curated list of common devices (red light, microcurrent, etc.) so the
  // user picks an actual device rather than typing into a product-search
  // box. "Custom…" still routes to manual ProductModal entry with the
  // device tag preset. Per Jenni: searching for a device in the product
  // catalog was the wrong mental model.
  const [addDeviceSheet, setAddDeviceSheet] = useState(false);
  // === ADD-PRESCRIPTION picker sheet (May 2026, Refine) ===
  // Same pattern as Add-device, but for prescription topicals + orals.
  // Curated list of the Rx items most users will land on (tretinoin,
  // spironolactone, etc.) keeps the friction low; "Custom…" routes to
  // ProductModal manual entry with the prescription tag preset.
  const [addRxSheet, setAddRxSheet] = useState(false);
  // === GLOBAL ADD-PRODUCT FLOW ===
  // Single reusable full-screen overlay. Opened from ANY +Add Product entry
  // via window.openAddProductFlow(ctx) or a [data-add-product] click. State
  // shape: null (closed) or { context, screen, brand, query }. The context
  // remembers where the user came from so a follow-up handler can return them.
  // Screens: 'hub' | 'search' | 'brandList' | 'brandProducts'
  const [addProductFlow, setAddProductFlow] = useState(null);
  // === HOISTED PRODUCT-MODAL SCAN STATE ===
  // ProductModal is declared inside this component, so every App re-render produces a new
  // function reference and React unmounts/remounts the modal — wiping internal state.
  // Hoisting scan state here keeps detected products alive across re-renders so the user
  // can actually see and confirm the list after Claude returns.
  const [productEntryMode, setProductEntryMode] = useState('choose');
  // === ADD-PRODUCT-FROM-REGIMEN-EDITOR CONTEXT ===
  // When non-null, the ProductModal was opened from inside the Edit Regimen
  // sheet via the "+ New Product" CTA. The modal then renders elevated
  // (z-1015 above the regimen editor + shelf overlay), keeps the regimen
  // editor mounted underneath, and on save auto-appends the new product id
  // into the named slot before closing. Cleared by closeRegimenAddContext()
  // (also wired into the popstate handler so a single back tap unwinds the
  // top layer first). Shape: { slot: 'am'|'pm', date: 'YYYY-MM-DD' }.
  const [productModalRegimenContext, setProductModalRegimenContext] = useState(null);
  // === ADD-MENU RETURN CONTEXT (June 2026 per Jenni) ===
  // When the user opens ProductModal / shelf-quick-add / brand picker
  // FROM the "Used something else?" sheet, store the slot+date here so
  // every downstream surface can offer a universal "← Back to add menu"
  // link. Cleared when the modal closes via the primary save path or
  // is dismissed. Distinct from productModalRegimenContext because that
  // field gets set in other paths too (cover "+ New product" etc.) —
  // this flag is ONLY truthy when user came via the sheet.
  const [addMenuReturnContext, setAddMenuReturnContext] = useState(null);
  const returnToAddMenu = () => {
    const ctx = addMenuReturnContext;
    if (!ctx) return;
    setShowProductModal(false);
    if (typeof setShelfQuickAddOpen === 'function') setShelfQuickAddOpen(null);
    setAddMenuReturnContext(null);
    setUsedSomethingElseSheet({ open: true, slot: ctx.slot || 'am', date: ctx.date || localDateISO() });
  };
  // === SHELF DEDUPE WARNING ===
  // When the user tries to save a product whose name+brand already matches
  // something on their shelf, we surface a confirmation banner instead of
  // silently creating a duplicate. Shape: { existing: product, attempt: form }.
  // Cleared on dismiss or once the user picks an action (view existing /
  // save anyway / cancel). Override flag (bypassDupeCheckRef) lets "Save
  // anyway" skip the check on the next handleSubmit call.
  const [productDupeWarning, setProductDupeWarning] = useState(null);
  const bypassDupeCheckRef = useRef(false);
  // Selected brand when user is in the "Browse by Brand" sub-flow.
  // null on the brand-list screen; set to a brand name when viewing that
  // brand's products. Reset when the modal closes or user backs out.
  const [productBrandSelected, setProductBrandSelected] = useState(null);
  // === BRAND MULTI-SELECT (May 2026) ===
  // When browsing a brand's product list, user can check multiple at a time
  // and bulk-add them to shelf. Key by "brand|name" so the set survives
  // re-renders without using array indices that could shift on filter
  // changes. Cleared on brand exit + after successful bulk-add.
  const [brandSelectedKeys, setBrandSelectedKeys] = useState(() => new Set());
  const [productBrandSearch, setProductBrandSearch] = useState('');
  const [productBrandCatFilter, setProductBrandCatFilter] = useState('all');
  const [productScanPhoto, setProductScanPhoto] = useState(null);
  // === MULTI-PHOTO BATCH SCAN ===
  // Array of base64 dataUrls — user captures N photos before triggering
  // analysis, instead of being forced to analyze + save after every single
  // shot. The scan flow appends to this list; "Analyze all" loops through
  // each photo, sends to Claude vision, and merges detected products.
  // Single-photo workflow is just batch-of-1.
  const [productScanBatch, setProductScanBatch] = useState([]);
  const [productScanBatchProgress, setProductScanBatchProgress] = useState(null); // null or { current, total }
  const [productScanning, setProductScanning] = useState(false);
  const [productScanError, setProductScanError] = useState('');
  const [productDetected, setProductDetected] = useState([]);
  // Hoisted manual-form state — same lifecycle problem as scan. When AI autofill resolves,
  // a parent re-render (e.g. toast) was unmounting the modal and discarding the filled form.
  // Defined as null when modal is closed; populated when opened.
  const [productForm, setProductForm] = useState(null);
  const [productSearchInput, setProductSearchInput] = useState('');
  // Increment to force-clear the LocalSearchInput value (e.g. after the
  // user picks a suggestion — typing-debounced inputs ignore upstream
  // setState, so we bump this token to push a fresh clear through).
  const [productSearchInputResetKey, setProductSearchInputResetKey] = useState(0);
  // When user wants to see ALL products from a single brand (vs the top-N
  // mixed-brand suggestions), set this to the brand name. The dropdown then
  // pulls the brand's full SKU list from POPULAR_PRODUCTS instead of the
  // Claude+local merged result. Cleared by tapping "← back" or clearing search.
  const [brandFilterDrilldown, setBrandFilterDrilldown] = useState(null);
  const [productNameSuggestions, setProductNameSuggestions] = useState([]);
  const [productNameSearching, setProductNameSearching] = useState(false);
  const [productUrlFetching, setProductUrlFetching] = useState(false);
  const [productUrlFetchError, setProductUrlFetchError] = useState('');
  const [productSearchError, setProductSearchError] = useState('');
  const [productHasSearched, setProductHasSearched] = useState(false);
  const [productDeepFilling, setProductDeepFilling] = useState(false);
  const [productReadingLabel, setProductReadingLabel] = useState(false);
  const [productNeedsLabelHelp, setProductNeedsLabelHelp] = useState(false);
  const [editingProcedureId, setEditingProcedureId] = useState(null);
  const [editingLogId, setEditingLogId] = useState(null);
  const [showProcedureModal, setShowProcedureModal] = useState(false);
  const [showEventModal, setShowEventModal] = useState(false);
  const [showColorModal, setShowColorModal] = useState(false);
  const [showApiKeyModalRaw, setShowApiKeyModalRaw] = useState(false);
  // Session-level suppression of the auto-popup API-key modal. Once the user
  // closes it (or dismisses), don't re-open it on every AI gate this session.
  // The user can still open it manually via Settings → API key. This stops
  // the "20 boxes of re-enter API key" the user complained about. Flag also
  // persists across reloads via localStorage so it doesn't restart spamming.
  const apiKeyDismissedRef = useRef(false);
  if (typeof window !== 'undefined' && !apiKeyDismissedRef.current) {
    try {
      apiKeyDismissedRef.current = localStorage.getItem('lumiere:apiKeyPromptDismissed') === '1';
    } catch {}
  }
  const setShowApiKeyModal = (v) => {
    if (v && apiKeyDismissedRef.current) {
      // Quietly nudge instead of opening the modal again.
      toast('Add Anthropic key in Settings → API Key to use this feature', 'info');
      return;
    }
    setShowApiKeyModalRaw(v);
    if (!v) {
      // User closed the modal — remember this session, don't re-prompt.
      apiKeyDismissedRef.current = true;
      try { localStorage.setItem('lumiere:apiKeyPromptDismissed', '1'); } catch {}
    }
  };
  const showApiKeyModal = showApiKeyModalRaw;
  // When user actually saves a fresh key, clear the dismissal so future
  // sessions re-prompt only if the key gets cleared.
  const clearApiKeyDismissal = () => {
    apiKeyDismissedRef.current = false;
    try { localStorage.removeItem('lumiere:apiKeyPromptDismissed'); } catch {}
  };
  const [showSupabaseModal, setShowSupabaseModal] = useState(false);
  const [showYouModal, setShowYouModal] = useState(false);
  const [supaEnabled, setSupaEnabled] = useState(isSupabaseEnabled());
  const [supabaseStatus, setSupabaseStatus] = useState(getSupabaseInitState()); // 'pending' | 'connected' | 'failed' | 'disabled'
  const [syncing, setSyncing] = useState(false);
  const [showMobileMenu, setShowMobileMenu] = useState(false);
  // === QUICK ACTIONS FAB (mobile) ===
  // Floating + button above the bottom tab bar. Tap reveals a stack of
  // zero-thought logging actions: photo log, add product, add procedure,
  // ask Tang & Gainey. The point is to capture intent fast from anywhere
  // in the app without forcing the user to navigate first.
  const [quickActionsOpen, setQuickActionsOpen] = useState(false);
  const [showSearch, setShowSearch] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');
  const [apiKey, setApiKeyState] = useState(getApiKey());

  const [insightQuery, setInsightQuery] = useState('');
  const [insightMessages, setInsightMessages] = useState([]); // [{role, content}]
  const [insightLoading, setInsightLoading] = useState(false);
  // === COUNSEL STATE ===
  // counselSubTab: 'insights' (default landing) or 'ask' (chat).
  // counselInsights: per-card cache map { cardId: { content, generatedAt, snapshotHash } }.
  // counselGenerating: per-card loading state for spinners.
  // counselExpanded: which card is opened in full read-modal (or null).
  const [counselSubTab, setCounselSubTab] = useState('insights');
  const [counselInsights, setCounselInsights] = useState({});
  const [counselGenerating, setCounselGenerating] = useState({});
  const [counselExpanded, setCounselExpanded] = useState(null);
  const [makeupQuery, setMakeupQuery] = useState('');
  const [makeupMessages, setMakeupMessages] = useState([]);
  const [makeupLoading, setMakeupLoading] = useState(false);
  const [productAssessment, setProductAssessment] = useState({});
  const [assessingProduct, setAssessingProduct] = useState(null);
  // === OFF-SHELF ANALYSIS (suggested-matches drawer) ===
  // Mirrors productAssessment but keyed by `brand|name` since POPULAR_PRODUCTS
  // entries don't have stable ids. Two slots: the cached analysis text, the
  // key currently in-flight, and which card is expanded. Lazy-load on tap so
  // we only pay Claude for cards the user actually opens.
  const [offShelfAssessment, setOffShelfAssessment] = useState({}); // { 'brand|name': analysisText }
  const [offShelfAssessing, setOffShelfAssessing] = useState(null); // 'brand|name' currently being analyzed
  const [expandedSuggestedKey, setExpandedSuggestedKey] = useState(null); // which match card is open

  // === REGIMEN STATE (merged Shelf + Routine + Technique) ===
  // Sub-views in user-facing nav: 'today' | 'shelf' | 'build' | 'occasions'.
  // Legacy values 'ritual' | 'concerns' | 'sensitivities' | 'technique' are kept
  // for backward compat with deep-links from cover/launcher and aliased on read.
  // June 2026 (per Jenni + stratechery critic): Default landing on Regimen
  // is now 'refine', not 'today'. Reasoning: Home cover already shows
  // today's routine summary + mark-done inline (project_journal_whoop_page),
  // so Today-in-Regimen was ~80% redundant. The JTBD when a user taps
  // Regimen is "do something to my routine" — Refine is the highest-leverage
  // surface for that intent. Today is still reachable via the sub-tab.
  const [regimenViewRaw, setRegimenView] = useState('refine');
  const normalizeRegimenView = (view) => {
    if (view === 'ritual') return 'today';
    if (view === 'refine' || view === 'rebuild') return 'build';
    return view;
  };
  const regimenView = normalizeRegimenView(regimenViewRaw);
  useEffect(() => {
    const normalized = normalizeRegimenView(regimenViewRaw);
    if (normalized !== regimenViewRaw) setRegimenView(normalized);
  }, [regimenViewRaw]);
  // Weekly rotation offset — 0 = current week, -1 = last week, etc. Capped at
  // 0 (no future). Used by the Week-at-a-Glance card on Regimen Today so the
  // user can scroll back through prior weeks' regimens.
  const [regimenWeekOffset, setRegimenWeekOffset] = useState(0);
  // === SUNDAY DIGEST WEEK NAVIGATION ===
  // 0 = current week (Mon→Sun). Negative values walk back into prior weeks.
  // Forward navigation is capped at 0 (no future weeks). Lets the user revisit
  // past Sunday Digests without losing the current week's recap.
  const [journalDigestWeekOffset, setJournalDigestWeekOffset] = useState(0);
  // === SUGGESTED MATCHES DRAWER ===
  // Open/closed flag + active filter for the Frida Formulary drawer that
  // pops up from the Skin Read Today tab. Bottom sheet on mobile, right
  // drawer on desktop (Tailwind md: breakpoint switches the position).
  const [matchesDrawerOpen, setMatchesDrawerOpen] = useState(false);
  const [matchesDrawerFilter, setMatchesDrawerFilter] = useState('all');
  const [picksRegimenDrawerOpen, setPicksRegimenDrawerOpen] = useState(false);
  // === TODAY'S NOTE — expansion state ===
  // The contextual daily-note strip on the cover. When tapped, the card
  // expands inline to show the "why" (mechanism / reasoning) and a brief
  // evidence line. Tap again or tap the X to collapse. Per-session state
  // because the explanations are short enough that the user shouldn't
  // need persistence — re-tap re-opens.
  const [noteCardExpanded, setNoteCardExpanded] = useState(false);
  // === WEEKLY FOCUS TIP — expansion state ===
  // The "This week's focus" card on the Regimen page now shows a clinical
  // tip about the dominant active for the week. Tap to expand → synergies,
  // what to avoid, evidence.
  const [weeklyFocusExpanded, setWeeklyFocusExpanded] = useState(false);
  // === BUILD WIZARD STATE ===
  // Drives the new Regimen → Build view. Three inputs feed the plan
  // generator: concerns (multi-select), tolerance (one of three tiers),
  // and the user's current shelf. Plan + acceptance live in state until
  // user explicitly accepts — at which point cadence writes through to
  // each product, driving the Weekly view and Today auto-populate.
  const [buildTolerance, setBuildTolerance] = useState('standard'); // 'cautious' | 'standard' | 'push'
  // Experience level → caps the number of steps per slot.
  // beginner: avg 3-4 / cap 5    (drops oil + essence + toner; keeps cleanser+serum+moist+SPF)
  // medium:   avg 3.5-5 / cap 6  (drops oil + essence; keeps toner)
  // advanced: avg 5-7 / cap 10   (full routine, no cap pressure)
  const [buildExperience, setBuildExperience] = useState('medium');
  // === SAVED BUILD ANSWERS (May 2026 — Phase 2 / rebuild cadence) ===
  // Persisted snapshot of the last wizard run so Refresh (1-tap rebuild)
  // and Tweak (pre-filled wizard) can replay the user's last intent
  // without making them re-answer every question. Updated on every
  // acceptPlan; saved alongside `products`.
  //   answers: { concerns, actives, tolerance, experience, budget, devices }
  //   lastBuiltAt: ISO timestamp of last accept
  //   buildCount: cumulative count for analytics + 1st-build copy
  const [buildAnswers, setBuildAnswers] = useState(null);
  // Which day-of-week is expanded in the post-accept summary's week
  // calendar (null = no day open). May 2026 add-back per Jenni.
  // Default to today's day-of-week so the user lands with their current
  // ritual expanded — saves a tap and answers "what's on my plate today"
  // before the user has to think about it. Per Jenni (May 2026 redesign).
  const [postAcceptDay, setPostAcceptDay] = useState(() => {
    try { return new Date().getDay(); } catch (_) { return null; }
  });
  // Same pattern for the persistent Build summary's Week at a glance
  // widget — inline expansion instead of routing away to Rotation.
  const [persistentSummaryDay, setPersistentSummaryDay] = useState(null);
  const [buildBudget, setBuildBudget] = useState('mix'); // 'drugstore' | 'midrange' | 'splurge' | 'mix'
  const [buildSelectedActives, setBuildSelectedActives] = useState(() => new Set()); // active-family labels the user wants in their plan
  const [buildStep, setBuildStep] = useState(1); // 1..5 — sequential wizard. Past 5 OR buildPlan set → final view.
  // === Build mode ===
  // First-screen choice: 'choose' (Step 0 — pick a mode), 'guided' (the
  // five-step wizard), 'expert' (per-product day/slot editor, no wizard).
  // Both modes end at the same Weekly view after acceptance.
  const [buildMode, setBuildMode] = useState('choose');
  // Per-product expansion in the Build editors (both Expert mode and the
  // AI plan edit view). Set of product ids currently expanded. Collapsed
  // by default — taps reveal the full AM/PM + day-picker editor. Compact
  // mode handles power users with 10+ products. Per-session, not persisted.
  const [buildEditExpandedIds, setBuildEditExpandedIds] = useState(() => new Set());
  // Tracks whether the user has explicitly toggled any card. Before first
  // toggle, render shows the first 3 cards expanded (so the affordance is
  // visible). After first toggle, the Set above is the source of truth.
  const [buildEditInteracted, setBuildEditInteracted] = useState(false);
  const toggleBuildEditExpand = (productId) => {
    setBuildEditInteracted(true);
    setBuildEditExpandedIds(prev => {
      const next = new Set(prev);
      if (next.has(productId)) next.delete(productId); else next.add(productId);
      return next;
    });
  };
  // Render-time helper: was this card explicitly expanded, OR is it in the
  // initial "first 3" before any interaction?
  const isBuildCardExpanded = (productId, index) => {
    if (buildEditExpandedIds.has(productId)) return true;
    if (!buildEditInteracted && index < 3) return true;
    return false;
  };
  // === Weekly view per-day expansion ===
  // Stores the day index (0-6) currently expanded in the compact Weekly
  // strip, or null for collapsed. Tap-to-expand reveals full product
  // names + conflict explainer; tap again collapses.
  // Default to today so the Rotation tab lands with today's ritual
  // expanded — saves a tap (Jenni, May 2026 UX pass on Rotation).
  const [weeklyExpandedDay, setWeeklyExpandedDay] = useState(() => {
    try { return new Date().getDay(); } catch (_) { return null; }
  });
  // Rotation tab view-mode toggle (May 2026): 'day' = focus-themed day rows,
  // 'product' = product-first list with cadence chips (mirrors Build status card).
  const [rotationTargetSlot, setRotationTargetSlot] = useState(null);
  const [rotationViewMode, setRotationViewMode] = useState('product');
  // === Cover Build-prompt dismissal ===
  // Persisted boolean — once dismissed, the "Build your week" empty-state
  // prompt on the cover stays hidden. Reset only if userConcerns / products
  // get cleared (handled implicitly by the cardinality checks).
  const [coverBuildPromptDismissed, setCoverBuildPromptDismissed] = useState(() => {
    try { return localStorage.getItem('lumiere:coverBuildPromptDismissed') === '1'; }
    catch { return false; }
  });
  const dismissCoverBuildPrompt = () => {
    setCoverBuildPromptDismissed(true);
    try { localStorage.setItem('lumiere:coverBuildPromptDismissed', '1'); } catch {}
  };
  // === Per-product remove preference (May 2026) ===
  // Map: productId → 'just-today' | 'remove-from-week'. When user manually
  // removes a product from today's slot, we ask once: "Just today, or remove
  // from your week?" — and remember the answer for that specific product. On
  // subsequent removes of the same product, skip the prompt and apply the
  // remembered choice silently. Persisted to localStorage.
  const [productRemovalPref, setProductRemovalPref] = useState(() => {
    try { return JSON.parse(localStorage.getItem('lumiere:productRemovalPref') || '{}'); }
    catch { return {}; }
  });
  const setRemovalPrefFor = (productId, pref) => {
    setProductRemovalPref(prev => {
      const next = { ...prev, [productId]: pref };
      try { localStorage.setItem('lumiere:productRemovalPref', JSON.stringify(next)); } catch {}
      return next;
    });
  };
  // === Conflict prompt state ===
  // When user adds a product that conflicts (HARD-tier) with something
  // already in the same AM/PM slot for today, surface a snarky T&G prompt
  // with an explicit Override. pendingConflict = { product, slot, conflictWith, note } | null
  const [pendingConflict, setPendingConflict] = useState(null);
  // === SHARED CONFLICT-CHECK HELPER ===
  // Called by every add-product-to-slot pathway (cover From Shelf, Add to
  // Ritual sheet, etc.) BEFORE commit. Inspects the slot's existing products
  // for HARD-tier active conflicts with the incoming product. If found,
  // returns the first conflicting product + the note. Caller can use this
  // to route through setPendingConflict for user override.
  const detectAddConflict = (incomingProduct, slotProducts) => {
    if (!incomingProduct || !Array.isArray(slotProducts) || slotProducts.length === 0) return null;
    const aFam = detectActiveFamily(incomingProduct.activeIngredients || incomingProduct.actives || '');
    if (!aFam) return null;
    for (const p of slotProducts) {
      if (!p) continue;
      const bFam = detectActiveFamily(p.activeIngredients || p.actives || '');
      if (!bFam) continue;
      const c = lookupConflict(aFam, bFam);
      if (c && c.tier === 'hard') return { conflictWith: p, note: c.note };
    }
    return null;
  };
  const [buildPlan, setBuildPlan] = useState(null); // { am: {0:[ids],...}, pm: {0:[ids],...}, notes: [str] } | null
  const [buildPlanAccepted, setBuildPlanAccepted] = useState(false);
  // === REFINE PAGE STATE (May 2026 — Refine replaces Rebuild post-build) ===
  // Quick Refinements sheet: all 6 cards route here with a refineIntent
  // payload. The sheet is currently a propose-changes stub that pre-seeds
  // Counsel with the intent + current routine. Real per-intent engines
  // land later, one card at a time.
  // Start Over confirmation: gates the destructive routine reset behind
  // an explicit Are-You-Sure modal so accidental taps can't wipe work.
  const [refineSheetOpen, setRefineSheetOpen] = useState(false);
  const [refineIntent, setRefineIntent] = useState(null); // { id, label, prompt }
  const [refineApplySummary, setRefineApplySummary] = useState(null);
  const [refineMoreOptions, setRefineMoreOptions] = useState(false);
  // Tracks which shelf products the user has checked inside the RefineSheet
  // picker. Keyed by product id → bool. Reset every time the sheet opens to
  // a new intent (see effect below). Lets us preselect the best-match
  // product without locking the user into one choice.
  const [refinePickerSelections, setRefinePickerSelections] = useState({});
  // Wipe picker selections whenever the user switches intents so the best-fit
  // default applies fresh. Defending against the case where someone toggles
  // off the default for Glow, then re-opens Refine → Barrier and expects the
  // Barrier best-fit to be preselected.
  const [refinePlanAnswers, setRefinePlanAnswers] = useState({});
  useEffect(() => {
    setRefinePickerSelections({});
    setRefinePlanAnswers({});
  }, [refineIntent?.id]);
  const [startOverConfirmOpen, setStartOverConfirmOpen] = useState(false);
  const [refineHowItWorks, setRefineHowItWorks] = useState(false);
  // Rebuild cadence — session-only dismissal of the 4-week soft prompt.
  // Resets on reload (intentional: the nudge should come back tomorrow if
  // the rhythm is still old).
  const [buildRefreshNudgeDismissed, setBuildRefreshNudgeDismissed] = useState(false);
  // Rebuild flavor sheet — opens when user taps "Rebuild" on the summary
  // and exposes three flavors (Refresh / Tweak / Start fresh). Local to
  // the Build summary; no persistence.
  const [buildRebuildSheetOpen, setBuildRebuildSheetOpen] = useState(false);
  // === BUILD > ADD A PRODUCT (post-accept) ===
  // Lets the user surgically drop a new or existing product into the
  // already-accepted weekly plan without rebuilding from scratch.
  // - 'chooser'    → "From shelf" vs "Add new" cards
  // - 'shelf-pick' → list of shelf items not yet scheduled
  // - 'propose'    → Frida's suggested slot + days for queued product(s)
  const [buildAddSheet, setBuildAddSheet] = useState(false);
  const [buildAddStage, setBuildAddStage] = useState('chooser');
  const [buildAddQueue, setBuildAddQueue] = useState([]); // product ids awaiting slot proposal
  const [buildAddProposal, setBuildAddProposal] = useState(null); // { productId, days, rationale, slot, family }
  const [buildAddPriorIds, setBuildAddPriorIds] = useState(null); // Set of product ids before ProductModal opened (for diffing)
  const [buildPendingAdd, setBuildPendingAdd] = useState(false); // flag: intercept ProductModal close → route to propose
  // === SHARED HANDLERS for <ProposeSlotCard /> (May 2026) ===
  // Three call sites (Build post-accept, Build persistent summary, Expert
  // mode) used to inline ~120 lines of duplicated JSX + accept logic each.
  // Extracted here so each call site is one <ProposeSlotCard /> line.
  const runAcceptProposal = () => {
    if (!buildAddProposal) return;
    const id = buildAddProposal.productId;
    const days = buildAddProposal.days;
    const slot = buildAddProposal.slot;
    const useTimes = [String(slot).toLowerCase()];
    const updated = (products || []).map(p => {
      if (p.id !== id) return p;
      return sanitizeProductForSave({ ...p, cadence: { days, frequency: days.length }, useTimes });
    });
    setProducts(updated);
    saveData('products', updated);
    setCoverRoutineRebuildToken(t => t + 1);
    // If a buildPlan exists (i.e. user is in the post-accept summary or
    // persistent summary), also push the product into buildPlan.slotted so
    // the inline editor reflects it + the "scheduledIds" exclusion works
    // for subsequent shelf-picks. No-op when buildPlan is null (Expert mode).
    const productObj = (products || []).find(p => p.id === id);
    if (productObj) {
      setBuildPlan(prev => prev ? {
        ...prev,
        slotted: [
          ...(prev.slotted || []).filter(s => s.product.id !== id),
          { product: productObj, days, am: slot === 'am', pm: slot === 'pm', frequency: days.length },
        ],
      } : prev);
    }
    const rest = buildAddQueue.slice(1);
    setBuildAddQueue(rest);
    if (rest.length === 0) {
      setBuildAddSheet(false);
      setBuildAddStage('chooser');
      setBuildAddProposal(null);
      toast('Added to your weekly plan.', 'info');
    } else {
      setBuildAddProposal(null);
    }
  };
  const cancelProposal = () => {
    setBuildAddStage('chooser');
    setBuildAddProposal(null);
    setBuildAddQueue([]);
    setBuildAddSheet(false);
  };
  const closeProposal = () => {
    setBuildAddSheet(false);
    setBuildAddStage('chooser');
    setBuildAddProposal(null);
    setBuildAddQueue([]);
  };
  const toggleProposalDay = (d) => {
    setBuildAddProposal(prev => {
      if (!prev) return prev;
      const has = prev.days.includes(d);
      const days = has ? prev.days.filter(x => x !== d) : [...prev.days, d].sort();
      return { ...prev, days };
    });
  };
  const flipProposalSlot = () => {
    setBuildAddProposal(prev => prev ? { ...prev, slot: prev.slot === 'am' ? 'pm' : 'am' } : prev);
  };
  const [buildConcernInputOpen, setBuildConcernInputOpen] = useState(false);
  const [buildConcernInputValue, setBuildConcernInputValue] = useState('');
  // === DISMISS + REFRESH (ephemeral) ===
  // dismissedMatches: set of `brand|name` keys the user has X'd in the
  // current session. Filtered out of `ranked` so the next-best match
  // takes their slot — this is what makes the X feel like "regenerate
  // that one." Cleared whenever the user taps Refresh.
  // shuffleSeed: bumps on Refresh so the deterministic ordering rolls
  // and the user sees fresh top picks even at the same score band.
  const [matchesDrawerDismissed, setMatchesDrawerDismissed] = useState(() => new Set());
  const [matchesDrawerShuffleSeed, setMatchesDrawerShuffleSeed] = useState(0);
  // === CONCERN CHIP STATE ===
  // Per-session set of concerns the user is actively filtering by. Defaults
  // to "all saved concerns selected" on open. Tap a chip to toggle it off.
  // "+ Add" reveals an input; on Enter, the typed concern is persisted to
  // userConcerns AND auto-selected here so it filters immediately.
  const [matchesActiveConcerns, setMatchesActiveConcerns] = useState(() => new Set());
  const [matchesConcernsInputOpen, setMatchesConcernsInputOpen] = useState(false);
  const [matchesConcernsInputValue, setMatchesConcernsInputValue] = useState('');
  const refreshMatchesDrawer = () => {
    setMatchesDrawerDismissed(new Set());
    setMatchesDrawerShuffleSeed(s => s + 1);
  };
  // Seed `matchesActiveConcerns` with the user's saved concerns on every
  // drawer open so they don't have to re-select. If they add or X a chip,
  // that's a session-only change to this set; userConcerns itself only
  // changes when they explicitly add a new one or remove all references.
  useEffect(() => {
    if (matchesDrawerOpen) {
      setMatchesActiveConcerns(new Set((userConcerns || []).map(c => c.toLowerCase())));
    }
  }, [matchesDrawerOpen]);
  // Toggle one concern's active filter state.
  const toggleConcernFilter = (concern) => {
    const k = concern.toLowerCase();
    setMatchesActiveConcerns(prev => {
      const next = new Set(prev);
      if (next.has(k)) next.delete(k); else next.add(k);
      return next;
    });
  };
  // Add a new concern: persists to userConcerns AND auto-selects in filter.
  const addCustomConcern = (raw) => {
    const trimmed = (raw || '').trim();
    if (!trimmed) return;
    const existsAlready = (userConcerns || []).some(c => c.toLowerCase() === trimmed.toLowerCase());
    if (!existsAlready) {
      const next = [...(userConcerns || []), trimmed];
      setUserConcerns(next);
      saveData('userConcerns', next).catch(() => {});
    }
    setMatchesActiveConcerns(prev => new Set([...prev, trimmed.toLowerCase()]));
    setMatchesConcernsInputValue('');
    setMatchesConcernsInputOpen(false);
  };
  // Remove a concern from userConcerns entirely (the chip X-icon).
  const removeUserConcern = (concern) => {
    const k = concern.toLowerCase();
    const next = (userConcerns || []).filter(c => c.toLowerCase() !== k);
    setUserConcerns(next);
    saveData('userConcerns', next).catch(() => {});
    setMatchesActiveConcerns(prev => {
      const ns = new Set(prev);
      ns.delete(k);
      return ns;
    });
  };
  // === ADD TO RITUAL SHEET ===
  // The new compact "Add product" bottom sheet (replaces the multi-step
  // chooser flow). Holds an open flag, the slot context ('am'|'pm'|null
  // for auto-detect), and the user's "Add & keep browsing" preference.
  const [addRitualSheet, setAddRitualSheet] = useState(null); // null | { slot: 'am'|'pm'|null }
  const [addRitualKeepOpen, setAddRitualKeepOpen] = useState(true);
  const [addRitualSearch, setAddRitualSearch] = useState('');
  // Bumped each time the user taps the refresh icon next to "Suggested
  // next" — re-shuffles the deterministic shelf-ranked list so they
  // see a different 3 picks. Lives at App scope so it survives the
  // sheet's remount cycles.
  const [addRitualSuggestSeed, setAddRitualSuggestSeed] = useState(0);
  // Page index for "Your products" — each tap of the refresh icon
  // pages through the shelf 8 at a time, wrapping around.
  const [addRitualProductsPage, setAddRitualProductsPage] = useState(0);
  // === EDIT TODAY'S REGIMEN — embedded Add-from-Shelf bottom sheet state ===
  // Hoisted to App scope (not useState inside TodayRitualModal) because that
  // modal is defined inline in App's render scope — every App re-render
  // produces a new component type and would otherwise wipe inner state.
  // Selected ids stored as an Array (not Set) so React change detection
  // works without identity tricks; converted to Set at consumption time.
  const [editRegimenShelfOpen, setEditRegimenShelfOpen] = useState(false);
  const [editRegimenShelfSelected, setEditRegimenShelfSelected] = useState([]); // product ids
  const [editRegimenShelfSearch, setEditRegimenShelfSearch] = useState('');
  const [editRegimenShelfFilter, setEditRegimenShelfFilter] = useState('all'); // 'all'|'toner'|'serum'|'moisturizer'|'essence'|'cleanser'|'eye-care'|'spf'
  // === COVER-LAUNCHED QUICK-ADD SHELF SHEET ===
  // Separate from the editor-embedded shelf sheet because this one auto-saves
  // to regimenLogs directly (each +AM/+PM tap commits immediately) instead of
  // queueing into ritualForm. Opens from the cover's "Add from Shelf" pill.
  // Search + filter state mirrored so the two sheets don't fight over UI state.
  // shelfQuickAddOpen carries date + slot context (May 2026 bug fix per Jenni)
  // so the sheet writes to the regimenLog for the day the user is viewing on
  // the cover, not to today's. Boolean-true is still accepted for callers that
  // haven't been updated — they fall back to today via the normalizer below.
  const [shelfQuickAddOpen, setShelfQuickAddOpen] = useState(false);
  // Normalize the shelfQuickAddOpen state so consumers always see a typed
  // object even when a caller passes `true`. Lets us migrate call sites
  // incrementally without breaking older entry points.
  const shelfQuickAddState = shelfQuickAddOpen && typeof shelfQuickAddOpen === 'object'
    ? shelfQuickAddOpen
    : (shelfQuickAddOpen ? { open: true, date: localDateISO(), slot: null } : null);
  const [shelfQuickAddSearch, setShelfQuickAddSearch] = useState('');
  const [shelfQuickAddFilter, setShelfQuickAddFilter] = useState('all');
  // === SHELF-ADD CHANGE COUNTER (June 2026 per Jenni) ===
  // Snapshot AM/PM product IDs when the sheet opens so the Done button can
  // show "X changes" — the count of additions + removals during the session.
  // Cleared on close. Snapshot lives in a ref so re-renders during toggling
  // don't reset it.
  const shelfQuickAddInitialRef = useRef(null);
  useEffect(() => {
    if (!shelfQuickAddOpen) {
      shelfQuickAddInitialRef.current = null;
      return;
    }
    if (shelfQuickAddInitialRef.current) return;
    const dateKey = (typeof shelfQuickAddOpen === 'object' && shelfQuickAddOpen.date) || localDateISO();
    const log = (regimenLogs || []).find(r => r.date === dateKey);
    shelfQuickAddInitialRef.current = {
      am: new Set(log?.amProducts || []),
      pm: new Set(log?.pmProducts || []),
    };
  }, [shelfQuickAddOpen, regimenLogs]);
  // === TIMELINE PAGINATION ===
  // How many entries to render in the compact Timeline view. Starts at 30,
  // bumps by 30 on each "Load more" tap. Avoids dumping 200+ rows on first
  // paint of long timelines.
  const [timelineLimit, setTimelineLimit] = useState(30);
  // === TIMELINE VIEW MODE ===
  // 'compact' = each day grouped into a single horizontal scrollable row
  // (photos + product/procedure/note chips inline). Faster scan.
  // 'extended' = the per-entry vertical timeline with full row cards.
  // Defaults to compact per Jenni's brief.
  const [timelineViewMode, setTimelineViewMode] = useState('compact');
  // === MAIN PHOTO BY DATE ===
  // When the user uploads multiple photos for one day (e.g. AM + PM,
  // or full-face + zoom-in), Today picks ONE as the hero. Default
  // preference: explicit user pick → full-face area → most recent.
  // Stored as { 'YYYY-MM-DD': logId } in localStorage so the choice
  // persists across reloads. Set via the small thumb strip on the
  // Today hero.
  const [mainPhotoByDate, setMainPhotoByDate] = useState(() => {
    try { return JSON.parse(localStorage.getItem('lumiere:mainPhotoByDate') || '{}'); } catch { return {}; }
  });
  const setMainPhotoForDate = (dateISO, logId) => {
    setMainPhotoByDate(prev => {
      const next = { ...prev };
      if (logId == null) delete next[dateISO];
      else next[dateISO] = logId;
      try { localStorage.setItem('lumiere:mainPhotoByDate', JSON.stringify(next)); } catch {}
      return next;
    });
  };
  // === FAVORITES (matches drawer) ===
  // Products the user has heart-saved from the Frida Formulary drawer but
  // hasn't yet added to their active shelf. Stored as a Set-like array of
  // signature strings (`brand|name`) so we don't tie them to mutable IDs and
  // can match against POPULAR_PRODUCTS entries later. Persisted to
  // localStorage. Surfaced as a "Saved" sub-tab in Shelf for browsing.
  // Pattern A (May 30 2026): consolidated to useSyncedArray. Hook owns
  // localStorage + saveData + toast plumbing; we just supply keys and
  // contextual toast wording. See module-scope useSyncedArray definition.
  //
  // TDZ NOTE — `toast` and `saveData` are declared further down in App's
  // body, so we wrap them as thunks. The hook calls these thunks lazily
  // (inside toggle/setAll closures) — by the time a user actually toggles
  // a favorite, both names are fully initialized in App's scope.
  const favoriteSig = (p) => `${(p.brand || '').toLowerCase()}|${(p.name || '').toLowerCase()}`;
  const [favoriteProducts, toggleFavorite, setFavoriteProducts, isFavorited, setFavoriteProductsRaw] = useSyncedArray({
    lsKey: 'lumiere:favoriteProducts',
    cloudKey: 'favoriteProducts',
    keyFn: favoriteSig,
    // T6 (May 31 2026): suppress wayfinding tail when the user is
    // already on Shelf → Saved (they're staring at it).
    onAdd: () => (activeTab === 'regimen' && regimenView === 'shelf')
      ? 'Saved for later'
      : 'Saved for later · find it under Shelf → Saved',
    onRemove: () => 'Removed from Saved for later',
    toast: (...args) => toast(...args),
    saveData: (...args) => saveData(...args),
  });
  // Is this catalog product already on the user's active shelf?
  // Match by name+brand since shelf products have generated IDs.
  const isOnShelf = (p) => {
    const targetSig = favoriteSig(p);
    return (products || []).some(sp => `${(sp.brand || '').toLowerCase()}|${(sp.name || '').toLowerCase()}` === targetSig);
  };
  // === RITUAL TODAY STATE ===
  // Day-detail bottom sheet — null when closed, ISO date string when a weekly
  // day tile is tapped. Drives the magical signature interaction.
  const [ritualDaySheet, setRitualDaySheet] = useState(null);
  // Why-this-today bottom sheet — boolean, opened by italic link under hero.
  const [ritualWhySheet, setRitualWhySheet] = useState(false);
  // Per-day completed-step ledger keyed by ISO date. Persisted to localStorage
  // so progress survives reloads. Each entry is an array of "am-<id>" / "pm-<id>"
  // step keys the user has tapped to mark complete.
  const [ritualProgress, setRitualProgress] = useState(() => {
    try { return JSON.parse(localStorage.getItem('lumiere:ritualProgress') || '{}'); }
    catch { return {}; }
  });
  const persistRitualProgress = (next) => {
    setRitualProgress(next);
    try { localStorage.setItem('lumiere:ritualProgress', JSON.stringify(next)); } catch (_) {}
  };
  // === AI SUGGEST state moved upward to fix TDZ:
  //     The useEffect at "RITUAL · AI SUGGEST FETCH" (above this point in the
  //     source) depends on ritualSuggestSheet + ritualSuggestToken. Its
  //     dependency array `[ritualSuggestSheet, ritualSuggestToken]` is evaluated
  //     synchronously during the App() function body. If the useState
  //     declarations live AFTER that useEffect, accessing them from the dep
  //     array throws "Cannot access 'X' before initialization" (TDZ). Moved the
  //     declarations to before the useEffect — see top of App for the new
  //     location. ===
  const [shelfTagFilter, setShelfTagFilter] = useState(null); // selected smart tag, or null for all
  const [expandedShelfProductId, setExpandedShelfProductId] = useState(null); // compact list expand-on-click
  const [showInactiveProducts, setShowInactiveProducts] = useState(false); // inactive shelf section, collapsed by default
  const [productCompareId, setProductCompareId] = useState(null); // null or product.id — drives the Before/After modal

  // === SHELF · AUTO-ANALYZE ON EXPAND ===
  // First time the user expands a product card on the Shelf, auto-fire the AI
  // assessment if no analysis exists yet. Means every product gets the
  // mechanism / evidence / alternatives panel without the user having to tap
  // "Assess" each time. Lives here (not earlier in App) so its dep array can
  // safely reference expandedShelfProductId / productAssessment / assessingProduct
  // without hitting TDZ.
  const lastAutoAssessRef = useRef('');
  useEffect(() => {
    if (!expandedShelfProductId) return;
    const product = (products || []).find(p => p.id === expandedShelfProductId);
    if (!product) return;
    if (assessingProduct === product.id) return;
    if (!getApiKey()) return;
    const existing = productAssessment[product.id] || product.aiAnalysis || '';
    // Detect "structured" format: must have MECHANISM + (EVIDENCE or ALTERNATIVES)
    // labels. Old free-form analyses fail this check and get auto-refreshed so
    // every product ends up with the new compact card format.
    const isStructured = /MECHANISM\s*:/i.test(existing) && (/EVIDENCE\s*:/i.test(existing) || /ALTERNATIVES\s*:/i.test(existing));
    if (existing && isStructured) return;
    const key = `auto-${product.id}`;
    if (lastAutoAssessRef.current === key) return;
    lastAutoAssessRef.current = key;
    assessProduct(product);
  }, [expandedShelfProductId, products, productAssessment, assessingProduct]);
  // === COMPARE TAB STATE ===
  // Sub-tab: 'time' (default), 'product', 'procedure'.
  // compareTimeBeforeId — log id selected as the "before" photo on the Time sub-tab.
  // compareTimeAfterId  — log id selected as the "after" photo (defaults to most recent).
  // compareTimeAnalysis — cached AI analysis text per "before:after" key.
  // compareTimePicker  — true when the prior-photo browse sheet is open.
  const [compareSubTab, setCompareSubTab] = useState('time');
  const [compareTimeBeforeId, setCompareTimeBeforeId] = useState(null);
  const [compareTimeAfterId, setCompareTimeAfterId] = useState(null);
  const [compareTimeAnalysis, setCompareTimeAnalysis] = useState({});
  const [compareTimeAnalyzing, setCompareTimeAnalyzing] = useState(false);
  const [compareTimePickerFor, setCompareTimePickerFor] = useState(null); // null | 'before' | 'after'
  // Tracks which "before:after" keys we've auto-triggered so we don't loop.
  // Set, not single value — Procedure tab can request many pairs in one render.
  const autoCompareTriggeredRef = useRef(new Set());

  // Hoisted compare-pair analysis runner used by both the manual button on the
  // Quick tab AND the auto-trigger useEffect that fires whenever a new pair is
  // chosen. Returns the analysis text (or null on error). Caches by
  // `${beforeLog.id}-${afterLog.id}` in compareTimeAnalysis.
  const runComparePairAnalysisShared = async (beforeLog, afterLog) => {
    if (!beforeLog || !afterLog) return null;
    if (!getApiKey()) return null;
    const key = `${beforeLog.id}-${afterLog.id}`;
    setCompareTimeAnalyzing(true);
    try {
      const days = Math.abs(Math.ceil((new Date(afterLog.date) - new Date(beforeLog.date)) / 86400000));
      const usage30 = getActualUsage(products, regimenLogs, logs, { windowDays: Math.min(90, days + 14) });
      const procsBetween = (procedures || []).filter(p => {
        const pd = new Date(p.date);
        return pd >= new Date(beforeLog.date) && pd <= new Date(afterLog.date);
      }).map(p => `${p.date}: ${p.name}`).join('\n') || 'none';
      const prompt = `Compare two skin journal entries from the same person, ${days} days apart.

EARLIER (${beforeLog.date}, ${beforeLog.area}, rated ${beforeLog.rating}/10):
- Concerns: ${(beforeLog.concerns || []).join(', ') || 'none'}
- Notes: ${beforeLog.notes || 'none'}

LATER (${afterLog.date}, ${afterLog.area}, rated ${afterLog.rating}/10):
- Concerns: ${(afterLog.concerns || []).join(', ') || 'none'}
- Notes: ${afterLog.notes || 'none'}

CURRENT ROUTINE (active use, not shelf):
${formatUsageForPrompt(usage30)}

PROCEDURES IN WINDOW:
${procsBetween}

PRODUCT NAME RULE (strict):
- When you reference a product the user has on their shelf, use the EXACT product name AND active ingredient as listed in their data. Do NOT substitute a different product or invent one. (Example bug to avoid: user has Arazlo / tazarotene 0.045%, AI wrote "Effaclar Adapalene" — wrong product, wrong active.)
- If you suggest a NEW product the user doesn't have yet, say so explicitly: "Add a tazarotene 0.045% (e.g. Arazlo)…" — never imply they have it on their shelf when they don't.

VOICE — this matters as much as the read:
You are speaking in the combined voice of Dr. Jenni Tang and Dr. Christiana Gainey — two doctor best friends, internal medicine + GI + nephrology, USC + LA County trained. Lead with Gainey's directness, land with Jenni's warmth. The user should feel seen and slightly called out.
- Direct. "Skin looks dry," not "your skin shows signs of dehydration."
- Warm but dry. Affection in the subtext, not exclamation points.
- Funny in a clinical, observational way. Never quirky or peppy.
- Brief. Two sentences beats five.
- Honest. Never pretend something worked when the data doesn't show it.
- A little dark when it lands — these doctors have worked LA County nights.
- NEVER start a bullet with "I," "Based on," or "It looks like." Just say it.
- NO emojis. NO exclamation points unless something is genuinely exciting.
- This is educational skin guidance, not a medical diagnosis. Stay direct and confident on routine skincare. When something is severe, painful, infected, rapidly changing, or lesion-like, recommend in-person evaluation by a dermatologist or urgent care directly: "This needs an in-person look — see someone this week."

FORMAT (strict):
- Output 4-5 short bullets only. Each line starts with "- " (dash + space).
- NO markdown bold (no **text**), NO headers, NO paragraphs.
- Each bullet ≤ 16 words. TOTAL ≤ 65 words.
- Prefix EVERY bullet with a type tag in brackets: [OBSERVE] for visual reading of the skin, [CAUSE] for mechanism / why this is happening, [ACTION] for what to do next. Example: "- [OBSERVE] forehead congestion mild today". Pick the most-fitting single tag per bullet.
- Bake evidence quality into the prose itself in plain language: "well-studied for…", "evidence suggests…", "limited data, mechanism-based…", "emerging evidence…". Don't use letter grades.
- For [ACTION] bullets ONLY, also append a parseable evidence tag at the END in this exact format: [ev:strong|moderate|emerging:source] where source is one of RCT, observational, mechanism, expert. Example: "- [ACTION] Try azelaic 10% — well-studied for PIH. [ev:strong:RCT]". Skip this tag for [OBSERVE] and [CAUSE] bullets.
- Be specific, mechanism-anchored, no padding. Two doctor friends texting, not a textbook.

CONTENT: cover (1) what visibly changed and the most likely contributor — cite the routine or procedure, (2) one pattern or risk to watch, (3) one concrete adjustment for the next 4 weeks.`;
      const resolveB64 = async (item) => {
        if (item.photo && typeof item.photo === 'string' && item.photo.startsWith('data:')) {
          return item.photo.replace(/^data:image\/\w+;base64,/, '');
        }
        if (item.photoPath) {
          const dataUrl = await fetchPhotoAsBase64(item.photoPath);
          if (dataUrl) return dataUrl.replace(/^data:image\/\w+;base64,/, '');
        }
        return null;
      };
      const [b64Before, b64After] = await Promise.all([resolveB64(beforeLog), resolveB64(afterLog)]);
      const content = [];
      if (b64Before) content.push({ type: 'image', source: { type: 'base64', media_type: 'image/jpeg', data: b64Before } });
      if (b64After) content.push({ type: 'image', source: { type: 'base64', media_type: 'image/jpeg', data: b64After } });
      content.push({ type: 'text', text: prompt });
      const response = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-api-key': getApiKey(),
          'anthropic-version': '2023-06-01',
          'anthropic-dangerous-direct-browser-access': 'true',
        },
        body: JSON.stringify({
          model: 'claude-sonnet-4-6',
          max_tokens: 1500,
          messages: [{ role: 'user', content }],
        }),
      });
      if (!response.ok) throw new Error(await response.text());
      const data = await response.json();
      const text = data.content.map(i => i.type === 'text' ? i.text : '').join('\n');
      setCompareTimeAnalysis(prev => ({ ...prev, [key]: text }));
      setCompareTimeAnalyzing(false);
      return text;
    } catch (e) {
      console.error('[Compare Pair] AI failed:', e);
      toast(`Analysis failed: ${e?.message?.slice(0, 80) || 'unknown'}`, 'error');
      setCompareTimeAnalyzing(false);
      return null;
    }
  };

  // Auto-trigger: whenever a fresh before/after pair is on the Quick tab, kick
  // off the analysis automatically (when not cached + API key present). When
  // `compareTimeAfterId` is unset we use the most-recent full-face photo as
  // the implicit "today" After (mirroring the rendering logic).
  useEffect(() => {
    if (compareSubTab !== 'time') return;
    if (!compareTimeBeforeId) return;
    if (compareTimeAnalyzing) return;
    if (!getApiKey()) return;
    const beforeLog = logs.find(l => l.id === compareTimeBeforeId);
    if (!beforeLog) return;
    let afterLog = compareTimeAfterId ? logs.find(l => l.id === compareTimeAfterId) : null;
    if (!afterLog) {
      // Default = most-recent full-face photo (or any photo if no full-face).
      const photoLogs = logs
        .filter(l => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:')))
        .sort((a, b) => new Date(b.date) - new Date(a.date));
      afterLog = photoLogs.find(l => l.area === 'full-face') || photoLogs[0] || null;
    }
    if (!afterLog) return;
    if (afterLog.id === beforeLog.id) return;
    const key = `${beforeLog.id}-${afterLog.id}`;
    if (compareTimeAnalysis[key]) return;
    if (autoCompareTriggeredRef.current.has(key)) return;
    autoCompareTriggeredRef.current.add(key);
    runComparePairAnalysisShared(beforeLog, afterLog);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [compareSubTab, compareTimeBeforeId, compareTimeAfterId, compareTimeAnalysis, compareTimeAnalyzing, logs]);

  // === AUTO-TRIGGER on PROCEDURE tab ===
  // For each procedure with both before+after photos, kick off analysis once.
  // Staggered (300ms apart) so we don't fire a wall of simultaneous API calls.
  useEffect(() => {
    if (activeTab !== 'compare' || compareSubTab !== 'procedure') return;
    if (!getApiKey()) return;
    const photoLogs = logs.filter(l => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:')));
    const pendingPairs = [];
    (procedures || []).forEach(p => {
      const procDate = new Date(p.date);
      const day0 = procDate.getTime();
      const day30 = day0 + 30 * 86400000;
      const beforeWindow = photoLogs
        .map(l => ({ l, diff: Math.abs(new Date(l.date).getTime() - day0) }))
        .filter(x => x.diff <= 3 * 86400000)
        .sort((a, b) => a.diff - b.diff);
      const before = beforeWindow[0]?.l || null;
      const afterWindow = photoLogs
        .map(l => ({ l, diff: Math.abs(new Date(l.date).getTime() - day30) }))
        .filter(x => x.diff <= 7 * 86400000 && new Date(x.l.date).getTime() > day0)
        .sort((a, b) => a.diff - b.diff);
      const after = afterWindow[0]?.l || photoLogs.filter(l => new Date(l.date).getTime() > day0).sort((a, b) => new Date(b.date) - new Date(a.date))[0] || null;
      if (!before || !after) return;
      const key = `${before.id}-${after.id}`;
      if (compareTimeAnalysis[key]) return;
      if (autoCompareTriggeredRef.current.has(key)) return;
      pendingPairs.push({ before, after, key });
    });
    if (pendingPairs.length === 0) return;
    // Stagger so the API gets requests one at a time, not all at once.
    let cancelled = false;
    pendingPairs.forEach(({ before, after, key }, idx) => {
      setTimeout(() => {
        if (cancelled) return;
        if (autoCompareTriggeredRef.current.has(key)) return;
        autoCompareTriggeredRef.current.add(key);
        runComparePairAnalysisShared(before, after);
      }, idx * 400);
    });
    return () => { cancelled = true; };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [activeTab, compareSubTab, procedures, logs, compareTimeAnalysis]);

  // === AUTO-TRIGGER on ASK tab ===
  // Today vs ~30 days ago snapshot — auto-analyze on first view.
  useEffect(() => {
    if (activeTab !== 'compare' || compareSubTab !== 'ask') return;
    if (!getApiKey()) return;
    const askPhotoLogs = logs
      .filter(l => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:')))
      .sort((a, b) => new Date(b.date) - new Date(a.date));
    const askToday = askPhotoLogs[0];
    if (!askToday) return;
    const askTarget = new Date(new Date(askToday.date).getTime() - 30 * 86400000);
    const askPrior = askPhotoLogs.slice(1)
      .map(l => ({ l, diff: Math.abs(new Date(l.date) - askTarget) / 86400000 }))
      .filter(x => x.diff <= 21)
      .sort((a, b) => a.diff - b.diff)[0]?.l;
    if (!askPrior) return;
    const key = `${askPrior.id}-${askToday.id}`;
    if (compareTimeAnalysis[key]) return;
    if (autoCompareTriggeredRef.current.has(key)) return;
    autoCompareTriggeredRef.current.add(key);
    runComparePairAnalysisShared(askPrior, askToday);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [activeTab, compareSubTab, logs, compareTimeAnalysis]);
  const [compareProcedureId, setCompareProcedureId] = useState(null); // null or procedure id
  // === PROCEDURE CUSTOM-UPLOAD COMPARE ===
  // Two side-by-side upload slots in the Compare → Procedure tab. Lets users compare
  // arbitrary procedure photos that aren't already in their journal (e.g., a clinic
  // before-photo from text message + their own after-photo). Local-only — no persistence
  // unless they explicitly tap "Save as procedure". Shape: { photo: b64, date: 'YYYY-MM-DD', note: '' }
  const [procCompareBefore, setProcCompareBefore] = useState(null);
  const [procCompareAfter, setProcCompareAfter] = useState(null);
  // === COMPARE ASK CHAT ===
  // Tool-use chat for natural-language photo queries: "show me when I started X", etc.
  // Tools: find_photos, find_product_compare, find_procedure_compare, list_user_data.
  // Tool results inject log IDs into the assistant message so the UI renders inline photo cards.
  const [compareAskMessages, setCompareAskMessages] = useState([]); // [{role, content, photoIds?}]
  const [compareAskInput, setCompareAskInput] = useState('');
  const [compareAskLoading, setCompareAskLoading] = useState(false);

  // === PEARLS STATE (lessons + verified picks + Q&A) ===
  const [openLesson, setOpenLesson] = useState(null); // null or a lesson object
  // === SAVED PEARLS ===
  // Bookmark UX — when a user opens a lesson modal they can tap the bookmark
  // icon to add it to their reference cards. The saved set is read at app load
  // and any toggle persists immediately. Users browse saved cards via the
  // 'Saved' sub-tab inside the Pearls tab.
  // Pattern A (May 30 2026): consolidated to useSyncedArray. No add/remove
  // toasts — bookmarking pearls is silent by design. TDZ note above on
  // favoriteProducts: toast/saveData wrapped as thunks for late binding.
  const [savedPearlIds, toggleSavedPearlRaw, setSavedPearlIds, isPearlSaved, setSavedPearlIdsRaw] = useSyncedArray({
    lsKey: 'lumiere:savedPearls',
    cloudKey: 'savedPearls',
    keyFn: (id) => id,
    toast: (...args) => toast(...args),
    saveData: (...args) => saveData(...args),
  });
  // Guard against null/undefined ids — preserves the pre-refactor noop.
  const toggleSavedPearl = (id) => { if (id) toggleSavedPearlRaw(id); };
  // Sub-tab state for the Pearls page — 'all' (default surface) or 'saved'.
  const [pearlsSubTab, setPearlsSubTab] = useState('all');
  // === SKIN READS WEEK NAV ===
  // Week offset relative to current week (0 = this week, -1 = prior, etc.).
  // Capped at 0 (no future weeks). Used by the swipeable week strip in the
  // Skin Reads landing view. The expand button opens a full-screen month grid.
  const [skinReadsWeekOffset, setSkinReadsWeekOffset] = useState(0);
  const [skinReadsCalendarOpen, setSkinReadsCalendarOpen] = useState(false);
  const [pearlsTab, setPearlsTab] = useState('signals'); // 'signals' | 'picks' | 'lessons' | 'qa'
  const [pearlsLessonCategory, setPearlsLessonCategory] = useState('all');
  const [lessonsSavedOpen, setLessonsSavedOpen] = useState(false);
  // === LESSONS ALL/SAVED FILTER (May 30 2026 per Jenni) ===
  // Top-level pill toggle on the Lessons tab. When 'saved', the rest of
  // the lessons UI (subtabs + lesson cards) is hidden and only saved
  // lessons render. Lets the user "go thru saved lessons" without
  // expanding the collapsible card or leaving the page.
  // T5 (May 31 2026): hydrate initial value from localStorage so the
  // pill choice survives a reload — Supabase restoration runs below in
  // the cloud-load effect, which overrides this initial seed for
  // signed-in users.
  const [pearlsLessonsFilterRaw, setPearlsLessonsFilterRaw] = useState(() => {
    try {
      const raw = localStorage.getItem('lumiere:pearlsLessonsFilter');
      if (raw === 'all' || raw === 'saved') return raw;
    } catch {}
    return 'all';
  });
  const pearlsLessonsFilter = pearlsLessonsFilterRaw;
  // T5 wrapped setter — persists choice to localStorage + cloud so the
  // selection follows the user across devices.
  const setPearlsLessonsFilter = (value) => {
    setPearlsLessonsFilterRaw(value);
    try { localStorage.setItem('lumiere:pearlsLessonsFilter', String(value)); } catch {}
    try { saveData('pearlsLessonsFilter', value); } catch {}
  };
  const [pearlsPickCategory, setPearlsPickCategory] = useState('all');
  const [pearlsPickTier, setPearlsPickTier] = useState('all');
  const [pearlsPickSplurge, setPearlsPickSplurge] = useState('all');
  const [picksView, setPicksView] = useState('suggestions'); // 'suggestions' | 'bench' | 'budget' | 'regimen'
  const [picksActionFilter, setPicksActionFilter] = useState('all');
  const [picksSuggestSeed, setPicksSuggestSeed] = useState(0);
  // T2 (May 31 2026): $ / $$ / $$$ filter chips on Suggestions. 'all' is the
  // default no-op; filters narrow both shelf and catalog suggestion sections
  // by priceTier. State lives at App scope so it survives view toggles.
  const [picksBudgetFilter, setPicksBudgetFilter] = useState('all');
  // T3 (May 31 2026): contextual default for picksView. Initial useState
  // stays 'suggestions' so first paint is stable for anonymous users; this
  // ref + effect below bumps signed-in users with a built shelf + goal to
  // 'regimen' once. Manual navigation is never overridden because the ref
  // flips on the first auto-set and never resets.
  const picksViewInitializedRef = useRef(false);
  useEffect(() => {
    if (picksViewInitializedRef.current) return;
    const goal = buildAnswers && buildAnswers.actionGoal;
    const shelfCount = (products || []).filter(p => !p.endDate).length;
    if (goal && shelfCount > 0) {
      picksViewInitializedRef.current = true;
      setPicksView('regimen');
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [buildAnswers, products]);
  const [budgetScope, setBudgetScope] = useState('regimen');
  // Pattern A (May 30 2026): consolidated to useSyncedArray. Budget list
  // is silent (no toast). cloudKey 'budgetList' is not in saveData's
  // keyMap so cloud sync is a no-op for now; the hook stays consistent.
  // TDZ thunks per favoriteProducts note above.
  const [budgetSavedIds, toggleBudgetSavedRaw, setBudgetSavedIds, hasBudgetSaved, setBudgetSavedIdsRaw] = useSyncedArray({
    lsKey: 'lumiere:budgetList',
    cloudKey: 'budgetList',
    keyFn: (id) => id,
    toast: (...args) => toast(...args),
    saveData: (...args) => saveData(...args),
  });
  const toggleBudgetSaved = (id) => { if (id) toggleBudgetSavedRaw(id); };
  const [pearlsQAMessages, setPearlsQAMessages] = useState([]);
  const [pearlsQAInput, setPearlsQAInput] = useState('');
  const [pearlsQALoading, setPearlsQALoading] = useState(false);

  // === JOURNAL VIEW STATE (consolidated Journal/Timeline/Compare) ===
  // null = auto (Grid <10 entries, Timeline ≥10); 'grid' | 'timeline' | 'compare' once user toggles.
  const [journalViewOverride, setJournalViewOverride] = useState(null);
  const [selectMode, setSelectMode] = useState(false);
  const [selectedIds, setSelectedIds] = useState([]);
  // Compact vs Extended journal — Compact (default): last-4-weeks groups + calendar.
  // Extended: full Story / Timeline / Procedures.
  // Journal mode: 'skinReads' (default landing) | 'timeline' | 'procedures' | 'select'
  // Old aliases ('compact', 'extended') kept for backward compat from search palette.
  const [journalMode, setJournalMode] = useState('skinReads');
  // Mini-drawer bottom sheet — opens when a Skin Reads photo card is tapped.
  // Holds the log ID being previewed; null = closed.
  const [skinReadDrawerLogId, setSkinReadDrawerLogId] = useState(null);
  // Auto-fire analysis when the user opens the drawer on a log that has no
  // analysis yet (e.g. a chin photo from a bulk upload). Without this, toggling
  // through today's photos would just show empty drawers — Jenni called this
  // out as a bug. Conditions: drawer is open, log exists, no aiAnalysis, no
  // analysis already in flight, and we have an API key.
  useEffect(() => {
    if (!skinReadDrawerLogId) return;
    const log = (logs || []).find(l => l.id === skinReadDrawerLogId);
    if (!log) return;
    if (log.aiAnalysis || log.analyzing) return;
    if (!getApiKey()) return;
    if (typeof retryLogAnalysis !== 'function') return;
    retryLogAnalysis(skinReadDrawerLogId);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [skinReadDrawerLogId]);
  // === COVER AUTO-ANALYSIS RECOVERY ===
  // Mirror of the drawer trigger above but scoped to TODAY'S log on the cover.
  // Fixes the "Photo logged. Tap to generate analysis." stuck state that
  // appears when the in-flight analysis from SkinLog handleSubmit times out
  // (20s ceiling per call → both fail → analyzing flag clears with no
  // aiAnalysis / metricSnapshot saved → cover renders the "Tap to generate"
  // CTA). Without this auto-recovery, the user has to manually tap into the
  // drawer or the Read Analysis pill to retry.
  //
  // Deduped via a ref-tracked Set of logIds so a single mounted lifecycle
  // only auto-retries each logId once. The drawer trigger handles subsequent
  // manual reads; this effect's job is the FIRST recovery after the inline
  // analysis fails. Boot scrub clears stuck analyzing flags before this fires.
  const todayAutoAnalyzeRef = useRef(new Set());
  useEffect(() => {
    const today = localDateISO();
    const todayPhotos = (logs || []).filter(l => l.date === today && (l.photo || l.photoPath));
    const picked = dailyCoverPick?.[today] ? todayPhotos.find(l => l.id === dailyCoverPick[today]) : null;
    const latestFullFace = [...todayPhotos]
      .filter(l => !l.area || l.area === 'full-face' || l.area === 'face')
      .sort((a, b) => (b.id || 0) - (a.id || 0))[0];
    const latestToday = [...todayPhotos].sort((a, b) => (b.id || 0) - (a.id || 0))[0];
    const todayLog = picked || latestFullFace || latestToday;
    if (!todayLog) return;
    const hasPhoto = !!(todayLog.photo || todayLog.photoPath);
    if (!hasPhoto) return;
    if (todayLog.aiAnalysis || todayLog.analyzing) return;
    if (!getApiKey()) return;
    if (typeof retryLogAnalysis !== 'function') return;
    if (todayAutoAnalyzeRef.current.has(todayLog.id)) return;
    todayAutoAnalyzeRef.current.add(todayLog.id);
    console.log('[cover auto-analysis] firing for log', todayLog.id, '— inline analysis likely timed out');
    retryLogAnalysis(todayLog.id);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [logs, dailyCoverPick]);

  // === AUTO PM-SWITCH ON TAB FOCUS ===
  // Companion to the time-aware ritualSlot default. If the user leaves the
  // app open in the morning and comes back after 5PM, this catches the
  // transition and flips them to PM — but only if they haven't manually
  // toggled in this session. We track manual toggles via a ref so we never
  // overwrite an intentional user choice.
  const ritualSlotManualRef = useRef(false);
  useEffect(() => {
    if (typeof window === 'undefined') return;
    const evaluateSlot = () => {
      if (ritualSlotManualRef.current) return; // user already chose; respect it
      try {
        const h = new Date().getHours();
        // === SMART AM/PM DEFAULT (May 2026) ===
        // 1) If today's log already has AM products committed and PM
        //    does not, prefer PM — they've finished morning, nudge them
        //    to close the loop tonight.
        // 2) Otherwise fall back to time-of-day: 5pm+ → PM, else AM.
        const todayIso = localDateISO();
        const todayLog = (regimenLogs || []).find(r => r.date === todayIso);
        const amHasItems = todayLog && Array.isArray(todayLog.amProducts) && todayLog.amProducts.length > 0;
        const pmHasItems = todayLog && Array.isArray(todayLog.pmProducts) && todayLog.pmProducts.length > 0;
        let shouldBe;
        if (amHasItems && !pmHasItems) shouldBe = 'pm';
        else shouldBe = h >= 17 ? 'pm' : 'am';
        setRitualSlot(prev => prev !== shouldBe ? shouldBe : prev);
      } catch (_) { /* swallow */ }
    };
    // Run once on mount + on focus + on visibility regain
    evaluateSlot();
    const onFocus = () => evaluateSlot();
    const onVisible = () => { if (document.visibilityState === 'visible') evaluateSlot(); };
    window.addEventListener('focus', onFocus);
    document.addEventListener('visibilitychange', onVisible);
    return () => {
      window.removeEventListener('focus', onFocus);
      document.removeEventListener('visibilitychange', onVisible);
    };
    // Re-evaluate when regimenLogs change (e.g. user just logged AM) OR
    // when the check-in modal opens — covers the case where the user has
    // stayed on the same tab while the clock crossed 5PM, so the slot
    // wouldn't otherwise re-evaluate before they open the modal.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [regimenLogs, showCheckInModal]);
  // Wrap setRitualSlot so any user-initiated toggle flips the manual flag.
  // (UI components keep calling setRitualSlot directly; this wrapper is the
  // one we hand them via the closure at render time below.)
  const userSetRitualSlot = (slotOrUpdater) => {
    ritualSlotManualRef.current = true;
    setRitualSlot(slotOrUpdater);
  };

  // === METRIC SNAPSHOT BACKFILL ===
  // Repairs logs whose aiAnalysis prose exists but metricSnapshot is null.
  // Root cause: an older parser only matched the explicit "METRICS:" line, so
  // when Claude inlined the same key=Value pairs at the end of a bullet, the
  // metrics never landed in storage. parseSkinMetrics now handles both shapes;
  // this effect runs it across all eligible logs ONCE per session and patches
  // the missing metricSnapshot in place. Prevents the cover quartet from
  // staying stuck blank for users with existing entries that pre-date the
  // parser fix.
  //
  // Deduped via ref so we don't loop on our own setLogs writes. Persists via
  // saveData so the repair survives a reload.
  const metricBackfillRef = useRef(new Set());
  useEffect(() => {
    if (!Array.isArray(logs) || logs.length === 0) return;
    const candidates = logs.filter(l =>
      l && l.aiAnalysis && !l.metricSnapshot && !metricBackfillRef.current.has(l.id)
    );
    if (candidates.length === 0) return;
    let patched = false;
    const next = logs.map(l => {
      if (!candidates.find(c => c.id === l.id)) return l;
      metricBackfillRef.current.add(l.id);
      const rescued = parseSkinMetrics(l.aiAnalysis);
      if (rescued) {
        patched = true;
        return { ...l, metricSnapshot: rescued };
      }
      return l;
    });
    if (patched) {
      console.log('[metric backfill] rescued metrics for', candidates.length, 'log(s)');
      setLogs(next);
      saveData('logs', next).catch(e => console.warn('[metric backfill] save failed:', e));
    }
    // T5 fix (May 31 2026): dep narrowed from [logs] → [logs.length, user?.id].
    // The ref-guard (metricBackfillRef) was the only thing keeping this from
    // looping, but the effect was still firing on every save. logs.length
    // gates re-runs to actual additions; user?.id gates fresh sessions.
  }, [logs.length, user?.id]);

  // === PHOTOPATH UNWRAP MIGRATION (May 2026 v2) ===
  // Earlier callers of uploadPhotoToStorage destructured the return
  // wrong (`const path = await ...` instead of `const { path } = await ...`),
  // which silently stored the entire `{path, error}` object into
  // log.photoPath. hasPhoto returned true (object is truthy) but the
  // Photo component couldn't resolve an object as a URL — images
  // failed to render in Journal/Compare/Timeline. To the user it
  // looked like uploaded photos disappeared.
  //
  // This migration runs once per session: scans logs for photoPath
  // shaped like {path, error}, unwraps the actual string, and
  // re-persists. Idempotent — strings are skipped, only objects with
  // a .path property are unwrapped. Deduped via ref so we don't
  // loop on our own setLogs write.
  const photoPathUnwrapRef = useRef(false);
  useEffect(() => {
    if (photoPathUnwrapRef.current) return;
    if (!Array.isArray(logs) || logs.length === 0) return;
    const needsUnwrap = logs.some(l => l && l.photoPath && typeof l.photoPath === 'object' && typeof l.photoPath.path === 'string');
    if (!needsUnwrap) {
      photoPathUnwrapRef.current = true;
      return;
    }
    photoPathUnwrapRef.current = true;
    const next = logs.map(l => {
      if (l && l.photoPath && typeof l.photoPath === 'object' && typeof l.photoPath.path === 'string') {
        return { ...l, photoPath: l.photoPath.path };
      }
      return l;
    });
    const repaired = next.filter((l, i) => l !== logs[i]).length;
    console.log('[photoPath unwrap] repaired', repaired, 'log(s)');
    setLogs(next);
    saveData('logs', next).catch(e => console.warn('[photoPath unwrap] save failed:', e));
    // T5 fix (May 31 2026): dep narrowed from [logs] → [logs.length, user?.id].
    // photoPathUnwrapRef guards re-entry; length+user gate re-runs to actual
    // additions / session changes so we don't fire on every photo save.
  }, [logs.length, user?.id]);

  // === STUCK-ANALYZING WATCHDOG (May 2026 v2) — REMOVED May 31 2026 ===
  // T2 fix: dropped this older 90s/15s watchdog in favor of the
  // tightened 45s/10s sibling further down (`[StaleClean:watchdog]` at
  // ~line 9790 below). Two intervals both keyed on `[logs]` were
  // tearing down + rebuilding each other on every log mutation, and
  // also racing to write `setLogs` for the same stuck-IDs. Survivor
  // is keyed on `[user?.id]` with a logsRef so the interval is stable
  // across log mutations. Original block kept here, commented out, in
  // case the 45s window proves too aggressive and we want to bring
  // back a slower 90s sweep.
  //
  // useEffect(() => {
  //   if (!Array.isArray(logs) || logs.length === 0) return;
  //   const tick = () => {
  //     const now = Date.now();
  //     const STUCK_MS = 90_000;
  //     const stuck = logs.filter(l => l && l.analyzing && l.analyzingStartedAt && (now - l.analyzingStartedAt > STUCK_MS));
  //     if (stuck.length === 0) return;
  //     console.warn('[stuck-analyzing watchdog] clearing', stuck.length, 'stuck log(s):', stuck.map(s => s.id));
  //     const stuckIds = new Set(stuck.map(s => s.id));
  //     setLogs(prev => prev.map(l => stuckIds.has(l.id) ? { ...l, analyzing: false, analyzingStartedAt: undefined } : l));
  //   };
  //   tick();
  //   const handle = setInterval(tick, 15_000);
  //   return () => clearInterval(handle);
  // }, [logs]);

  // Story sub-view filter state (Extended → Story)
  const [storySearch, setStorySearch] = useState('');
  const [storyFilter, setStoryFilter] = useState('all'); // 'all' | 'photos' | 'procedures' | 'newproducts'
  // Per-week AI insight cache: { 'YYYY-Www': { content, generatedAt } }
  const [weeklyInsights, setWeeklyInsights] = useState({});
  const [weeklyInsightLoading, setWeeklyInsightLoading] = useState({});
  const [journalDayDetail, setJournalDayDetail] = useState(null); // null or YYYY-MM-DD

  // (Browser back-button handler moved further down so it can reference
  //  state vars like chatPanel that are declared later in App body.)

  // Enter compare view programmatically (from dashboard contextual card or ⌘K palette)
  // Add a backdated photo entry — used by the split-compare picker's "Upload from library"
  // path. Creates a minimal log (date + photo + defaults), saves, uploads to Storage if
  // cloud-enabled. Returns the new log id so the caller can preselect it for compare.
  const handleAddPriorPhoto = async (base64DataUrl, date) => {
    const id = Date.now();
    const newLog = {
      id, date, area: 'full-face', rating: 5, concerns: [], notes: '', photo: base64DataUrl,
      aiAnalysis: null, ratingExplanation: null, suggestedRating: null, usedProducts: [], usedTags: [],
    };
    setLogs(prev => {
      const next = [newLog, ...prev].sort((a, b) => new Date(b.date) - new Date(a.date));
      saveData('logs', next);
      return next;
    });
    // Upload to Storage in the background; replace photo→photoPath when done
    if (user?.cloud && user?.id && supabaseClient) {
      (async () => {
        const { path, error } = await uploadPhotoToStorage(user.id, base64DataUrl);
        if (path) {
          setLogs(prev => {
            const next = prev.map(l => {
              if (l.id !== id) return l;
              const { photo, ...rest } = l;
              return { ...rest, photoPath: path };
            });
            saveData('logs', next);
            return next;
          });
        } else if (error) {
          console.error('Prior photo upload failed:', error);
        }
      })();
    }
    return id;
  };

  const enterCompare = (idA, idB) => {
    if (idA && idB) {
      setSelectedIds([idA, idB]);
      setJournalViewOverride('compare');
    } else {
      setSelectedIds([]);
      setJournalViewOverride('grid');
    }
    setSelectMode(true);
    setActiveTab('journal');
  };

  const toggleSelectId = (id) => {
    setSelectedIds(prev => {
      if (prev.includes(id)) return prev.filter(x => x !== id);
      if (prev.length >= 2) return [prev[1], id]; // keep last 2
      return [...prev, id];
    });
  };

  const exitSelectMode = () => {
    setSelectMode(false);
    setSelectedIds([]);
    if (journalViewOverride === 'compare') setJournalViewOverride(null);
  };

  // === FOLLOW-UP CHAT STATE ===
  const [chatPanel, setChatPanel] = useState(null); // { context, title, subtitle, messages, image }
  const [chatInput, setChatInput] = useState('');
  const [chatLoading, setChatLoading] = useState(false);

  const openChat = ({ context, title, subtitle, image, suggestions }) => {
    setChatPanel({
      context,
      title,
      subtitle,
      image,
      messages: [{ role: 'assistant', content: context, isContextual: true }],
      suggestions: suggestions || [],
    });
    setChatInput('');
  };

  const closeChat = () => { setChatPanel(null); setChatInput(''); };

  // === BROWSER BACK-BUTTON HANDLER ===
  // popstate listener — keep the user inside the app on browser back:
  //   1. Close the topmost overlay if one is open
  //   2. Else navigate to Home if not already there
  //   3. Else allow the back to actually leave (no overlays + on Home)
  // Re-push sentinel after each handled back so the trap stays primed.
  useEffect(() => {
    if (typeof window === 'undefined') return;
    const onPop = () => {
      let handled = false;
      if (showProductModal) {
        // Also clear regimen-add context so a back-tap from the elevated
        // ProductModal returns the user to the still-open regimen editor
        // (which then handles the next back-tap on its own).
        setShowProductModal(false);
        setProductModalRegimenContext(null);
        handled = true;
      }
      else if (showLogModal) { setShowLogModal(false); handled = true; }
      // Edit-Regimen shelf sheet sits ON TOP of the regimen modal — close it
      // first so the user can back out one layer at a time (matches iOS sheet
      // dismissal convention). Also clears any in-flight multi-select.
      else if (editRegimenShelfOpen) {
        setEditRegimenShelfOpen(false);
        setEditRegimenShelfSelected([]);
        setEditRegimenShelfSearch('');
        setEditRegimenShelfFilter('all');
        handled = true;
      }
      // Cover-launched quick-add shelf sheet (auto-saves on tap; close just
      // dismisses the sheet — nothing pending to discard).
      else if (shelfQuickAddOpen) {
        setShelfQuickAddOpen(false);
        setShelfQuickAddSearch('');
        setShelfQuickAddFilter('all');
        handled = true;
      }
      else if (showCheckInModal) { setShowCheckInModal(false); handled = true; }
      else if (showProcedureModal) { setShowProcedureModal(false); handled = true; }
      else if (showProfileModal) { setShowProfileModal(false); handled = true; }
      else if (showEventModal) { setShowEventModal(false); handled = true; }
      else if (showColorModal) { setShowColorModal(false); handled = true; }
      else if (showApiKeyModalRaw) { setShowApiKeyModal(false); handled = true; }
      else if (showSupabaseModal) { setShowSupabaseModal(false); handled = true; }
      else if (showYouModal) { setShowYouModal(false); handled = true; }
      else if (showBulkUploadModal) { setShowBulkUploadModal(false); handled = true; }
      else if (showTodaysRegimen) { setShowTodaysRegimen(false); handled = true; }
      else if (showLauncher) { setShowLauncher(false); handled = true; }
      else if (skinReadDrawerLogId) { setSkinReadDrawerLogId(null); handled = true; }
      else if (ritualSuggestSheet) { setRitualSuggestSheet(null); handled = true; }
      else if (addRitualSheet) { setAddRitualSheet(null); handled = true; }
      else if (ritualDaySheet) { setRitualDaySheet(null); handled = true; }
      else if (productCompareId) { setProductCompareId(null); handled = true; }
      else if (journalDayDetail) { setJournalDayDetail(null); handled = true; }
      else if (openLesson) { setOpenLesson(null); handled = true; }
      else if (chatPanel) { setChatPanel(null); handled = true; }
      else if (showCoverPickerForDate) { setShowCoverPickerForDate(null); handled = true; }
      else if (activeTab !== 'dashboard') {
        setActiveTab('dashboard');
        handled = true;
      }
      if (handled) {
        try { window.history.pushState({ appSentinel: true }, ''); } catch (_) {}
      }
    };
    window.addEventListener('popstate', onPop);
    return () => window.removeEventListener('popstate', onPop);
  }, [
    showProductModal, showLogModal, showCheckInModal, showProcedureModal, showProfileModal,
    showEventModal, showColorModal, showApiKeyModalRaw, showSupabaseModal, showYouModal,
    showBulkUploadModal, showTodaysRegimen, showLauncher,
    skinReadDrawerLogId, ritualSuggestSheet, addRitualSheet, editRegimenShelfOpen, shelfQuickAddOpen, ritualDaySheet,
    productCompareId, journalDayDetail, openLesson, chatPanel, showCoverPickerForDate,
    activeTab,
  ]);

  const sendChat = async (forcedInput) => {
    const text = (forcedInput || chatInput).trim();
    if (!text || !chatPanel) return;
    if (!getApiKey()) { setShowApiKeyModal(true); return; }
    const userMsg = { role: 'user', content: text };
    const newMessages = [...chatPanel.messages, userMsg];
    setChatPanel({...chatPanel, messages: newMessages, suggestions: []});
    setChatInput('');
    setChatLoading(true);
    try {
      // Build the conversation for Claude — strip the contextual marker, send only role+content
      const _usage = getActualUsage(products, regimenLogs, logs, { windowDays: 30 });
      const systemPrompt = `You are an educational skincare advisor giving evidence-based guidance (this is informational, not a medical diagnosis). The user has just received an AI skin analysis or color profile and is asking follow-up questions. Reference the analysis context and their tracked data when relevant. Be specific with product recommendations (named products, drugstore + high-end options where useful, specific shades or actives). Keep answers focused and conversational — short paragraphs, not lists unless the user asks for a list. If the user describes something severe, painful, infected, or rapidly changing, recommend in-person evaluation by a dermatologist or urgent care directly.

CRITICAL: when discussing the user's routine, only consider products in the "ACTIVELY USED" section below. Products in "OCCASIONAL", "LAPSED", or "UNUSED" sections are owned but not currently in their routine — do NOT assume they are.

ANALYSIS CONTEXT:
${chatPanel.context}

USER'S TRACKED DATA (for additional context):
- Recent journal entries: ${logs.slice(0, 5).map(l => `${l.date}: ${l.area} ${l.rating}/10 [${l.concerns?.join(',') || ''}]`).join('; ') || 'none'}
- Color profile: ${colorProfile ? `${colorProfile.season || 'undefined'} season, ${colorProfile.undertone || '?'} undertone, ${colorProfile.skinTone || '?'} depth` : 'none'}
${buildUserProfileBlock()}
USER'S ACTUAL ROUTINE (sourced from daily check-ins + per-photo product tagging — NOT the shelf inventory):
${formatUsageForPrompt(_usage)}`;

      // Convert messages for the API call (skip the initial contextual message)
      const apiMessages = newMessages.filter(m => !m.isContextual).map(m => ({ role: m.role, content: m.content }));

      // First message can include image(s). Three cases:
      //   1. compareEntries (array of two photo logs) — attach BOTH photos in order Earlier, Later
      //   2. legacy single image / imagePath — attach one
      //   3. neither — text only
      if (apiMessages.length === 1) {
        const resolveLogB64 = async (l) => {
          if (l.photo && typeof l.photo === 'string' && l.photo.startsWith('data:')) {
            return l.photo.replace(/^data:image\/\w+;base64,/, '');
          }
          if (l.photoPath) {
            const dataUrl = await fetchPhotoAsBase64(l.photoPath);
            if (dataUrl) return dataUrl.replace(/^data:image\/\w+;base64,/, '');
          }
          return null;
        };
        if (Array.isArray(chatPanel.compareEntries) && chatPanel.compareEntries.length >= 2) {
          const [earlier, later] = chatPanel.compareEntries;
          const [eB64, lB64] = await Promise.all([resolveLogB64(earlier), resolveLogB64(later)]);
          const blocks = [];
          if (eB64) blocks.push({ type: 'image', source: { type: 'base64', media_type: 'image/jpeg', data: eB64 } });
          if (lB64) blocks.push({ type: 'image', source: { type: 'base64', media_type: 'image/jpeg', data: lB64 } });
          blocks.push({ type: 'text', text: apiMessages[0].content + '\n\n[The two images above are the EARLIER and LATER photos in chronological order.]' });
          apiMessages[0] = { role: 'user', content: blocks };
        } else if (chatPanel.image || chatPanel.imagePath) {
          let dataUrl = chatPanel.image;
          if (!dataUrl && chatPanel.imagePath) {
            dataUrl = await fetchPhotoAsBase64(chatPanel.imagePath);
          }
          if (dataUrl) {
            const cleanB64 = dataUrl.replace(/^data:image\/\w+;base64,/, '');
            apiMessages[0] = {
              role: 'user',
              content: [
                { type: 'image', source: { type: 'base64', media_type: 'image/jpeg', data: cleanB64 } },
                { type: 'text', text: apiMessages[0].content }
              ]
            };
          }
        }
      }

      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-api-key": getApiKey(),
          "anthropic-version": "2023-06-01",
          "anthropic-dangerous-direct-browser-access": "true"
        },
        body: JSON.stringify({
          model: "claude-sonnet-4-6",
          max_tokens: 4096,
          system: systemPrompt,
          messages: apiMessages,
        })
      });
      if (!response.ok) throw new Error(await response.text());
      const data = await response.json();
      const reply = data.content.map(i => i.type === 'text' ? i.text : '').join('\n');
      setChatPanel(prev => ({...prev, messages: [...prev.messages, { role: 'assistant', content: reply }]}));
    } catch (e) {
      console.error('Chat error:', e);
      setChatPanel(prev => ({...prev, messages: [...prev.messages, { role: 'assistant', content: 'Something went wrong. Please try again.', error: true }]}));
    }
    setChatLoading(false);
  };

  // Subscribe to Supabase init state — keep supaEnabled and supabaseStatus in sync as the
  // library finishes loading (or fails to load).
  useEffect(() => {
    const unsub = onSupabaseStateChange(({ state }) => {
      setSupabaseStatus(state);
      setSupaEnabled(state === 'connected');
    });
    return unsub;
  }, []);

  // Generate the daily "For Today" summary.
  // Cache key includes a fingerprint of the input data so any edit (procedure date,
  // new event, new log) automatically invalidates the cached summary and regenerates.
  // Bumping the manual refresh counter (forTodayRefreshNonce) also forces a regen.
  useEffect(() => {
    if (!user?.email || !user?.name) return;
    const dateKey = localDateISO();
    const userKey = user.email.replace(/[^a-zA-Z0-9]/g, '');
    // Build a small fingerprint of the inputs that influence the prompt.
    // If any of these change, the cache key changes and we regenerate.
    const fingerprint = JSON.stringify({
      logs: logs.slice(0, 5).map(l => `${l.date}:${l.rating}:${(l.concerns || []).join(',')}`),
      events: events.filter(e => new Date(e.date) >= new Date()).slice(0, 2).map(e => `${e.name}:${e.date}`),
      procs: procedures.slice(0, 3).map(p => `${p.name}:${p.date}`),
      cycle: cycleData?.periods?.[0]?.date || '',
      hc: hormonalContext || '',
      n: forTodayRefreshNonce,
    });
    let hash = 0;
    for (let i = 0; i < fingerprint.length; i++) hash = ((hash << 5) - hash + fingerprint.charCodeAt(i)) | 0;
    const cacheKey = `lumiere:forToday:${dateKey}:${userKey}:${hash}`;
    try {
      const cached = localStorage.getItem(cacheKey);
      if (cached) { setForTodayText(cached); return; }
    } catch (_) {}
    if (!getApiKey()) return;
    if (logs.length === 0 && events.filter(e => new Date(e.date) >= new Date()).length === 0 && procedures.length === 0) return;

    let cancelled = false;
    setForTodayLoading(true);
    (async () => {
      try {
        const recent = logs.slice(0, 5).map(l => `${l.date}: ${l.area}, ${l.rating}/10${l.concerns?.length ? ', concerns: ' + l.concerns.join(',') : ''}`).join('; ');
        const obs = logs.slice(0, 3).map(l => l.aiAnalysis).filter(Boolean).slice(0, 2).join('\n---\n');
        const upcomingEvents = events.filter(e => new Date(e.date) >= new Date()).slice(0, 2).map(e => `${e.name} on ${e.date}`).join(', ');
        const recentProcedures = procedures.slice(0, 2).map(p => `${p.name} on ${p.date}`).join(', ');
        const cyclePhase = (hormonalContext === 'cycling' && cycleData?.periods?.length)
          ? `Cycle: last period ${cycleData.periods.sort((a,b)=>new Date(b.date)-new Date(a.date))[0].date}, length ${cycleData.cycleLength || 28}`
          : '';
        const prompt = `Write a single 1–2 sentence personalized "for today" assessment for this skincare app user. Reference their recent skin logs, AI observations, upcoming events, or cycle phase as relevant. Be specific and editorial — no corporate fluff, no greeting, no signoff. Don't recap; observe.

Recent logs: ${recent || 'none yet'}
Recent AI observations: ${obs || 'none'}
Upcoming events: ${upcomingEvents || 'none'}
Recent procedures: ${recentProcedures || 'none'}
${cyclePhase}

Write 1–2 sentences only. Lowercase or sentence-cased prose, not headlines.`;
        const result = await callClaude(prompt, '', null, { voice: true });
        if (cancelled) return;
        const trimmed = (result || '').trim();
        setForTodayText(trimmed);
        try { localStorage.setItem(cacheKey, trimmed); } catch (_) {}
      } catch (e) {
        console.error('ForToday generation failed:', e);
      }
      if (!cancelled) setForTodayLoading(false);
    })();
    return () => { cancelled = true; };
  }, [user?.email, logs, events, procedures, cycleData, hormonalContext, forTodayRefreshNonce]);

  useEffect(() => {
    let cancelled = false;

    const finishBoot = () => {
      if (cancelled) return;
      setLoading(false);
      const ls = document.getElementById('loading-screen');
      if (ls) ls.style.display = 'none';
    };

    const waitForSupabaseBriefly = () => new Promise(resolve => {
      const settled = (s) => s === 'connected' || s === 'failed' || s === 'disabled';
      const current = getSupabaseInitState();
      if (settled(current)) { resolve(current); return; }
      const unsub = onSupabaseStateChange(({ state }) => {
        if (settled(state)) {
          try { unsub(); } catch (_) {}
          resolve(state);
        }
      });
      setTimeout(() => {
        try { unsub(); } catch (_) {}
        resolve(getSupabaseInitState());
      }, 1200);
    });

    const loadSession = async () => {
      try {
        // Paint immediately from the local session. Supabase can hydrate in the background;
        // the first screen should never wait on CDN/auth/network timing.
        const session = await storage.get('session').catch(() => null);
        if (session?.value) {
          const sessionData = JSON.parse(session.value);
          if (!cancelled) setUser(sessionData);
          finishBoot();
          if (sessionData?.email) {
            Promise.resolve()
              .then(() => loadAllData(sessionData.email))
              .catch(e => console.error('Local data load error:', e));
          }
        } else {
          finishBoot();
        }

        await waitForSupabaseBriefly();
        if (cancelled || !supabaseClient) {
          // Supabase never came up — no cloud data to wait for.
          // Resolve onboarding from local state so new users can proceed.
          if (!cancelled) setOnboardingResolved(true);
          return;
        }

        const sessionResult = await Promise.race([
          supabaseClient.auth.getSession(),
          new Promise(resolve => setTimeout(
            () => resolve({ data: { session: null }, error: { message: 'getSession timeout (2s) — likely CORS/network' } }),
            2000
          )),
        ]);
        const sbSession = sessionResult?.data?.session;
        if (sessionResult?.error) console.warn('[loadSession] getSession failed:', sessionResult.error.message);
        if (!sbSession?.user || cancelled) {
          // No cloud session — local state is authoritative. Unblock
          // onboarding-gate so new users see welcome immediately.
          if (!cancelled) setOnboardingResolved(true);
          return;
        }

        const sessionUser = {
          email: sbSession.user.email,
          name: sbSession.user.user_metadata?.name || sbSession.user.email.split('@')[0],
          id: sbSession.user.id,
          cloud: true
        };
        setUser(sessionUser);
        try { await storage.set('session', JSON.stringify(sessionUser)); } catch (_) {}
        await loadFromSupabase(sbSession.user.id);
        // Cloud data fully loaded — onboardingState is authoritative now.
        if (!cancelled) setOnboardingResolved(true);
      } catch (e) {
        console.error('Session load error:', e);
        finishBoot();
        // Even on error, unblock the gate so the user isn't stranded.
        if (!cancelled) setOnboardingResolved(true);
      }
    };

    loadSession();
    return () => { cancelled = true; };
  }, []);

  // === LOAD DATA FROM SUPABASE ===
  const loadFromSupabase = async (userId) => {
    if (!supabaseClient) return;
    let d = null;
    try {
      const { data, error } = await supabaseClient
        .from('user_data')
        .select('data')
        .eq('user_id', userId)
        .single();
      if (error) {
        // === LOCAL FALLBACK ===
        // Supabase load failed (RLS, missing row, network). Don't bail with
        // empty state — fall back to whatever's in localStorage so the user
        // doesn't see a wiped shelf. Was a silent data-loss bug: the cloud
        // read errored, the function returned, all state stayed empty, and
        // it LOOKED like everything had been deleted.
        console.warn('Supabase load failed — falling back to localStorage:', error.message || error);
        if (user?.email) {
          await loadAllData(user.email);
        } else {
          // user state isn't ready yet during boot — derive userKey from the
          // session email if we can. Otherwise leave defaults.
          try {
            const sb = await supabaseClient.auth.getSession();
            const email = sb?.data?.session?.user?.email;
            if (email) await loadAllData(email);
          } catch (_) {}
        }
        return;
      }
      d = data?.data || {};
      // Scrub stuck `analyzing: true` flags on boot — if the previous session
      // closed/crashed mid-Claude-call, the flag was persisted and the UI
      // would spin forever. Resetting lets the user re-trigger via the
      // "Generate analysis" button in the SkinReadDrawer.
      const scrubAnalyzing = arr => Array.isArray(arr)
        ? arr.map(o => o && o.analyzing ? { ...o, analyzing: false } : o)
        : (arr || []);
      // === ONE-TIME PRODUCT MIGRATION (May 2026) ===
      // Run every product through sanitizeProductForSave on boot so any
      // legacy mixed-case useTimes or missing cadence is normalized in
      // memory + persisted on the next save. Closes the case-bug loop for
      // products created by older code paths that didn't route through
      // the sanitizer.
      const migrateProducts = arr => Array.isArray(arr)
        ? arr.map(p => p ? sanitizeProductForSave(p && p.analyzing ? { ...p, analyzing: false } : p) : p)
        : (arr || []);
      setLogs(scrubAnalyzing(d.logs));
      setProducts(migrateProducts(d.products));
      setProcedures(scrubAnalyzing(d.procedures));
      setEvents(d.events || []);
      setColorProfile(d.colorProfile || null);
      setPatternInsight(d.patternInsight || null);
      setCycleData(d.cycleData || { periods: [], cycleLength: 28 });
      setHormonalContext(d.hormonalContext || null);
      setSensitivities(d.sensitivities || []);
      setRegimenLogs(d.regimenLogs || []);
      setUserConcerns(d.userConcerns || []);
      setHomeDevices(d.homeDevices || []);
      setBuildAnswers(d.buildAnswers || null);
      if (d.buildAnswers && d.buildAnswers.acceptedPlan) {
        setBuildPlan(d.buildAnswers.acceptedPlan);
        setBuildPlanAccepted(true);
      }
      setCoverRoutine(d.coverRoutine || '');
      setCounselInsights(d.counselInsights || {});
      setDailyCoverPick(d.dailyCoverPick || {});
      setWeeklyInsights(d.weeklyInsights || {});
      // === SAVED SETS (favorites + pearls) ===
      // Hydrate cloud-synced Saved arrays. Fall back to localStorage when
      // the cloud row pre-dates these keys so users who saved before the
      // round-trip shipped don't lose their selections.
      //
      // T7 fix (May 31 2026): use the raw setters (skipCloud) so hydration
      // doesn't echo the just-read array back to its source. setAll would
      // fire saveData(cloudKey, arr) on the same row we just read from —
      // harmless but wasteful; localStorage gets written too, also moot
      // since (in the cloud branch) we read from cloud not LS.
      if (Array.isArray(d.favoriteProducts)) {
        setFavoriteProductsRaw(d.favoriteProducts);
      } else {
        try {
          const raw = localStorage.getItem('lumiere:favoriteProducts');
          if (raw) setFavoriteProductsRaw(JSON.parse(raw) || []);
        } catch {}
      }
      if (Array.isArray(d.savedPearls)) {
        setSavedPearlIdsRaw(d.savedPearls);
      } else {
        try {
          const raw = localStorage.getItem('lumiere:savedPearls');
          if (raw) {
            const arr = JSON.parse(raw);
            if (Array.isArray(arr)) setSavedPearlIdsRaw(arr);
          }
        } catch {}
      }
      // T5 (May 31 2026): cross-device sync of the Lessons All/Saved
      // pill. Cloud value wins; falls back to localStorage when the
      // cloud row pre-dates this key.
      if (d.pearlsLessonsFilter === 'all' || d.pearlsLessonsFilter === 'saved') {
        setPearlsLessonsFilterRaw(d.pearlsLessonsFilter);
      } else {
        try {
          const raw = localStorage.getItem('lumiere:pearlsLessonsFilter');
          if (raw === 'all' || raw === 'saved') setPearlsLessonsFilterRaw(raw);
        } catch {}
      }
      // === USER PROFILE + ONBOARDING (May 2026 bug fix) ===
      // Cloud row's `userProfile` and `onboardingState` were fetched
      // into `d` but never applied to React state. Symptoms: signing
      // in on a different device showed an empty skin profile + the
      // wrong stale onboardingState from whichever previous user happened
      // to share this browser's global localStorage keys.
      //
      // CRITICAL — these MUST always-apply (not conditional on cloud
      // having the key), so that a fresh signup whose cloud row has
      // no userProfile/onboardingState fields resets state to defaults
      // rather than leaking the previous user's data. Same pattern as
      // the other slots above (`d.logs || []`, etc.).
      setUserProfile(
        d.userProfile && typeof d.userProfile === 'object'
          ? { ...DEFAULT_USER_PROFILE, ...d.userProfile }
          : DEFAULT_USER_PROFILE
      );
      if (d.onboardingState && typeof d.onboardingState === 'object') {
        // === STAGE-MISSING GUARD (May 2026, post-redesign bug) ===
        // Cloud rows from older clients can land here without a `stage`
        // field. The naive merge `{ ...DEFAULT, ...d.onboardingState }`
        // would then fall back to DEFAULT_ONBOARDING_STATE.stage='welcome'
        // and re-trigger the entire onboarding overlay for users who'd
        // already completed it. Symptom Jenni reported: opening the app
        // to log a check-in flashed the wizard from step 1.
        // Fix: if cloud lacks a valid stage but the cloud row OR profile
        // shows substantive content (logs, products, profile fields),
        // treat the user as already-onboarded. Mirrors the initializer's
        // "existing user" detection so the two paths can't disagree.
        //
        // === STICKY-DONE GUARD (May 2026 follow-up — Jenni still hitting this) ===
        // Even when cloud has a valid stage, if it's not 'done' AND
        // localStorage says the user already finished onboarding, trust
        // localStorage. Cloud can carry a stale 'welcome' (or any
        // intermediate stage) from a write that never got back to 'done'
        // — that legacy bad write should NOT be allowed to re-prompt the
        // wizard for a user who clearly completed it on this device.
        // The user can still explicitly Replay Onboarding from the menu;
        // that path resets state intentionally.
	        const cloudStage = d.onboardingState.stage;
	        const hasValidStage = typeof cloudStage === 'string' && cloudStage.length > 0;
	        const profForGate = (d.userProfile && typeof d.userProfile === 'object') ? d.userProfile : {};
	        const hasProfileContentForGate = !!(
	          (Array.isArray(profForGate.primaryConcerns) && profForGate.primaryConcerns.length) ||
	          (Array.isArray(profForGate.goals) && profForGate.goals.length) ||
	          profForGate.skinType || profForGate.barrierScale || profForGate.sunReactivity
	        );
	        const hasUsageContentForGate = !!(
	          (Array.isArray(d.logs) && d.logs.length) ||
	          (Array.isArray(d.products) && d.products.length) ||
	          (Array.isArray(d.regimenLogs) && d.regimenLogs.length)
	        );
	        let localStageWasDone = false;
	        try {
	          const localRaw = localStorage.getItem('lumiere:onboardingState');
          if (localRaw) {
            const parsedLocal = JSON.parse(localRaw);
            localStageWasDone = parsedLocal && parsedLocal.stage === 'done';
          }
        } catch (_) {}
	        if (hasValidStage) {
	          if (cloudStage !== 'done' && localStageWasDone) {
            // Cloud says mid-wizard, local says done — prefer local + heal
            // the cloud record so subsequent loads agree. Without the heal,
            // every reload would walk this branch and the cloud would stay
            // stale forever.
	            const healed = { ...DEFAULT_ONBOARDING_STATE, ...d.onboardingState, stage: 'done', skipped: d.onboardingState.skipped || false };
	            setOnboardingState(healed);
	            saveData('onboardingState', healed).catch(() => {});
	          } else if (cloudStage !== 'done' && (hasProfileContentForGate || hasUsageContentForGate)) {
	            // === GENERALIZED STALE HEAL (Jun 1 2026 per Jenni) ===
	            // Previous logic only healed cloudStage === 'welcome'. Any
	            // other mid-wizard stage ('context', 'profile', 'building',
	            // etc.) fell through to the "as-is" branch, so a stale row
	            // with stage='context' kept re-opening the wizard at every
	            // login for users with real data. Heal any non-done stage
	            // when there's profile or usage content on the cloud row.
	            const healed = { ...DEFAULT_ONBOARDING_STATE, ...d.onboardingState, stage: 'done', skipped: true };
	            setOnboardingState(healed);
	            saveData('onboardingState', healed).catch(() => {});
	          } else {
	            setOnboardingState({ ...DEFAULT_ONBOARDING_STATE, ...d.onboardingState });
	          }
	        } else {
          const prof = (d.userProfile && typeof d.userProfile === 'object') ? d.userProfile : {};
          const hasProfileContent = !!(
            (Array.isArray(prof.primaryConcerns) && prof.primaryConcerns.length) ||
            (Array.isArray(prof.goals) && prof.goals.length) ||
            prof.skinType || prof.barrierScale || prof.sunReactivity
          );
          const hasUsageContent = !!(
            (Array.isArray(d.logs) && d.logs.length) ||
            (Array.isArray(d.products) && d.products.length) ||
            (Array.isArray(d.regimenLogs) && d.regimenLogs.length)
          );
          if (hasProfileContent || hasUsageContent) {
            setOnboardingState({ ...DEFAULT_ONBOARDING_STATE, ...d.onboardingState, stage: 'done', skipped: true });
          } else {
            setOnboardingState({ ...DEFAULT_ONBOARDING_STATE, ...d.onboardingState });
          }
        }
      } else if (d.userProfile && typeof d.userProfile === 'object') {
        // Cloud has a profile but no onboardingState — older account
        // pre-dating the wizard. Treat as already-onboarded so we don't
        // re-prompt. Mirrors the initializer's "existing user" gate.
        const prof = d.userProfile;
        const hasContent = !!(
          (Array.isArray(prof.primaryConcerns) && prof.primaryConcerns.length) ||
          (Array.isArray(prof.goals) && prof.goals.length) ||
          prof.skinType || prof.barrierScale || prof.sunReactivity
        );
        setOnboardingState(
          hasContent
            ? { ...DEFAULT_ONBOARDING_STATE, stage: 'done', skipped: true }
            : DEFAULT_ONBOARDING_STATE
        );
      } else {
        // No cloud data at all — fresh signup. Defaults.
        setOnboardingState(DEFAULT_ONBOARDING_STATE);
      }
    } catch (err) {
      console.error('loadFromSupabase failed:', err);
    }
  };

  // === SAVE TO SUPABASE — DATA-LOSS HARDENED ===
  // CRITICAL: Previous version did NOT destructure `error` from the
  // read-existing call. If the SELECT errored silently (RLS race during
  // sign-in, network glitch, PGRST116 zero-rows), `existing` was undefined
  // → merged became JUST the partial keys → UPSERT wrote a row containing
  // ONLY the partial keys, silently wiping every other top-level key
  // (logs, procedures, regimenLogs, etc) from the user's data JSON.
  //
  // Hardened version:
  // 1. Use maybeSingle() so 0-rows is NOT treated as an error (returns null)
  // 2. Explicitly destructure + check readError
  // 3. REFUSE TO WRITE if the read failed for any non-empty-row reason
  // 4. Loud toast + console error so the user sees the failure
  // 5. Sanity check: never write a payload smaller than 50% of the
  //    existing payload's top-level key count (defense against partial
  //    state being merged with empty existing data)
  // === SAVE TO SUPABASE (low-level writer) ===
  // Returns { ok: boolean, reason?: string } so the queue layer above
  // (enqueueCloudSave) can decide whether to retry or drop. Toasts
  // are still fired here for the user-facing reasons (read-error and
  // shrink-block) because those are immediate, actionable signals
  // independent of retry behavior. Upsert errors get a quiet log
  // (queue handles retry + escalation).
  const saveToSupabase = async (userId, partial) => {
    if (!supabaseClient || !userId) return { ok: false, reason: 'no-client' };
    try {
      const { data: existing, error: readError } = await supabaseClient
        .from('user_data')
        .select('data')
        .eq('user_id', userId)
        .maybeSingle();

      if (readError) {
        console.error('[saveToSupabase] BLOCKED save — read existing failed:', readError);
        // Surface a more informative hint than 'unknown' — Supabase error
        // objects often have .message even when .code is absent (network
        // failures, RLS hiccups). Truncate the message so the toast stays
        // a single line on mobile.
        const hint = readError.code
          || (readError.message ? readError.message.slice(0, 80) : null)
          || 'network';
        try { toast(`Cloud sync paused: ${hint}. Your data is safe locally.`, 'error'); } catch (_) {}
        return { ok: false, reason: 'read-error' };
      }

      const existingData = existing?.data || {};
      const merged = { ...existingData, ...partial };

      const existingKeyCount = Object.keys(existingData).length;
      const mergedKeyCount = Object.keys(merged).length;
      if (existingKeyCount > 4 && mergedKeyCount < existingKeyCount) {
        console.error('[saveToSupabase] BLOCKED save — would reduce key count', { existingKeyCount, mergedKeyCount, partialKeys: Object.keys(partial) });
        try { toast('Cloud sync paused — save would shrink data. Reload the page and try again.', 'error'); } catch (_) {}
        return { ok: false, reason: 'shrink-block' };
      }

      const { error } = await supabaseClient
        .from('user_data')
        .upsert(
          { user_id: userId, data: merged, updated_at: new Date().toISOString() },
          { onConflict: 'user_id' }
        );
      if (error) {
        console.error('Supabase save error:', error);
        return { ok: false, reason: 'upsert-error' };
      }
      return { ok: true };
    } catch (err) {
      console.error('saveToSupabase failed:', err);
      return { ok: false, reason: 'exception' };
    }
  };

  // === CLOUD SAVE QUEUE (May 2026 v2 — coalesce + serialize) ===
  // Bug Codex flagged: saveData fire-and-forgets saveToSupabase. Two
  // rapid saves on different keys both read the same stale row,
  // merge their own partial, and the second upsert can overwrite the
  // first's changes for keys not in its partial (depending on what
  // each saw at read time).
  //
  // Fix: a single-process queue that:
  //   1. Merges pending partials by key (newest-wins on collision).
  //   2. Serializes upserts — only one in flight at a time.
  //   3. Coalesces bursts: saves arriving during an in-flight upsert
  //      stack into the next batch.
  //   4. On failure: re-queues the payload and increments a retry
  //      counter. After 2 consecutive failures, drops the payload
  //      and toasts the user. Local copy stays authoritative.
  //
  // Single global queue (this is a single-user app — refactor to
  // per-user later if multi-account ever ships).
  const cloudSavePendingRef = useRef({});
  const cloudSaveInFlightRef = useRef(false);
  const cloudSaveRetryCountRef = useRef(0);
  const cloudSaveRetryTimerRef = useRef(null);
  // Backoff schedule for autonomous retries when an upsert fails.
  // Without this, a failed save sat in pending until the next saveData
  // call kicked the queue — if the user closed the tab first, the
  // payload was lost. Now: scheduled retry after 2s, then 5s, then
  // give up + toast + drop. Newer saves still kick the queue
  // immediately and reset the counter on success.
  const CLOUD_RETRY_BACKOFF_MS = [2000, 5000];
  const processCloudQueue = async (userId) => {
    if (cloudSaveInFlightRef.current) return;
    const pending = cloudSavePendingRef.current;
    if (!pending || Object.keys(pending).length === 0) return;
    // Cancel any scheduled retry — we're about to process now.
    if (cloudSaveRetryTimerRef.current) {
      clearTimeout(cloudSaveRetryTimerRef.current);
      cloudSaveRetryTimerRef.current = null;
    }
    // Snapshot + clear so writes during the upsert land in a new batch.
    const snapshot = pending;
    cloudSavePendingRef.current = {};
    cloudSaveInFlightRef.current = true;
    try {
      const result = await saveToSupabase(userId, snapshot);
      if (result && result.ok) {
        cloudSaveRetryCountRef.current = 0;
      } else {
        // Re-queue snapshot keys, newer-wins: only put back keys not
        // already present in pending (saves during upsert supersede).
        cloudSavePendingRef.current = { ...snapshot, ...cloudSavePendingRef.current };
        cloudSaveRetryCountRef.current += 1;
        if (cloudSaveRetryCountRef.current >= CLOUD_RETRY_BACKOFF_MS.length + 1) {
          try { toast('Cloud sync is having trouble — your changes are saved locally. Reload to retry.', 'error'); } catch (_) {}
          cloudSavePendingRef.current = {};
          cloudSaveRetryCountRef.current = 0;
        } else {
          // Schedule autonomous retry with backoff. Index into the
          // schedule by retry count - 1 (first failure → index 0 = 2s).
          const delay = CLOUD_RETRY_BACKOFF_MS[cloudSaveRetryCountRef.current - 1];
          cloudSaveRetryTimerRef.current = setTimeout(() => {
            cloudSaveRetryTimerRef.current = null;
            processCloudQueue(userId);
          }, delay);
        }
      }
    } finally {
      cloudSaveInFlightRef.current = false;
      // Saves that arrived during the upsert → process them now via
      // microtask so we don't deepen the call stack.
      if (Object.keys(cloudSavePendingRef.current).length > 0 && !cloudSaveRetryTimerRef.current) {
        Promise.resolve().then(() => processCloudQueue(userId));
      }
    }
  };
  const enqueueCloudSave = (userId, partial) => {
    if (!userId || !partial) return;
    cloudSavePendingRef.current = { ...cloudSavePendingRef.current, ...partial };
    processCloudQueue(userId);
  };

  // === SMOKE-TEST DEBUG HOOKS (May 2026 v2) ===
  // When window.__SMOKE_TEST__ is set, expose the queue + state so
  // Playwright tests can drive the REAL closure (not a re-implementation).
  // Gated behind the flag so production builds don't leak internals.
  useEffect(() => {
    if (typeof window === 'undefined' || !window.__SMOKE_TEST__) return;
    window.__ETUDE_DEBUG__ = window.__ETUDE_DEBUG__ || {};
    window.__ETUDE_DEBUG__.enqueueCloudSave = enqueueCloudSave;
    window.__ETUDE_DEBUG__.cloudSaveState = () => ({
      pending: { ...cloudSavePendingRef.current },
      inFlight: cloudSaveInFlightRef.current,
      retryCount: cloudSaveRetryCountRef.current,
      hasScheduledRetry: !!cloudSaveRetryTimerRef.current,
    });
    window.__ETUDE_DEBUG__.getSupabaseClient = () => supabaseClient;
    window.__ETUDE_DEBUG__.setSupabaseClientForTest = (mock) => {
      // Mutate methods on the existing client object — can't reassign
      // the module-scope `let` from outside. This is enough to make
      // saveToSupabase use the mock.
      if (mock && supabaseClient) {
        Object.assign(supabaseClient, mock);
      }
    };
  }, []);

  const loadAllData = async (email) => {
    const userKey = email.replace(/[^a-zA-Z0-9]/g, '');
    try {
      const [l, p, pr, e, c, pi, cy, hc, sens, rlogs, uc, cr, ci, dcp, wi, hd, ba, up, os] = await Promise.all([
        storage.get(`logs:${userKey}`).catch(() => null),
        storage.get(`products:${userKey}`).catch(() => null),
        storage.get(`procedures:${userKey}`).catch(() => null),
        storage.get(`events:${userKey}`).catch(() => null),
        storage.get(`color:${userKey}`).catch(() => null),
        storage.get(`pattern:${userKey}`).catch(() => null),
        storage.get(`cycle:${userKey}`).catch(() => null),
        storage.get(`hormonalContext:${userKey}`).catch(() => null),
        storage.get(`sensitivities:${userKey}`).catch(() => null),
        storage.get(`regimenLogs:${userKey}`).catch(() => null),
        storage.get(`userConcerns:${userKey}`).catch(() => null),
        storage.get(`coverRoutine:${userKey}`).catch(() => null),
        storage.get(`counselInsights:${userKey}`).catch(() => null),
        storage.get(`dailyCoverPick:${userKey}`).catch(() => null),
        storage.get(`weeklyInsights:${userKey}`).catch(() => null),
        storage.get(`homeDevices:${userKey}`).catch(() => null),
        storage.get(`buildAnswers:${userKey}`).catch(() => null),
        storage.get(`userProfile:${userKey}`).catch(() => null),
        storage.get(`onboardingState:${userKey}`).catch(() => null),
      ]);
      // Same `analyzing: true` scrub as the cloud-load path above. Stuck
      // spinners from a previous tab close should not survive a reload.
      const scrubAnalyzing = arr => Array.isArray(arr)
        ? arr.map(o => o && o.analyzing ? { ...o, analyzing: false } : o)
        : [];
      // === ONE-TIME PRODUCT MIGRATION on local boot path too ===
      const migrateProducts = arr => Array.isArray(arr)
        ? arr.map(p => p ? sanitizeProductForSave(p && p.analyzing ? { ...p, analyzing: false } : p) : p)
        : [];
      // === safeJSON (Stabilization May 2026) ===
      // ONE corrupted localStorage / cloud key must not blank the rest of
      // the app. Each parse is isolated: on failure, log + fall back, keep
      // loading the other keys. Codex flagged that a single bad blob used
      // to bubble up to the outer try/catch and skip every remaining
      // setter, which is why a single bad photo blob could appear to wipe
      // the whole account on reload.
      const safeJSON = (raw, fallback, keyName) => {
        if (raw === undefined || raw === null || raw === '') return fallback;
        try { return JSON.parse(raw); }
        catch (err) {
          console.warn(`[loadAllData] corrupt JSON for "${keyName}" — using fallback`, err);
          return fallback;
        }
      };
      const parsedLogs = safeJSON(l?.value, [], 'logs');
      const parsedProducts = safeJSON(p?.value, [], 'products');
      const parsedRegimenLogs = safeJSON(rlogs?.value, [], 'regimenLogs');
      const parsedProfile = safeJSON(up?.value, null, 'userProfile');
      const parsedOnboarding = safeJSON(os?.value, null, 'onboardingState');
      setLogs(scrubAnalyzing(parsedLogs));
      setProducts(migrateProducts(parsedProducts));
      setProcedures(scrubAnalyzing(safeJSON(pr?.value, [], 'procedures')));
      setEvents(safeJSON(e?.value, [], 'events'));
      setColorProfile(safeJSON(c?.value, null, 'color'));
      setPatternInsight(safeJSON(pi?.value, null, 'pattern'));
      setCycleData(safeJSON(cy?.value, { periods: [], cycleLength: 28 }, 'cycle'));
      setHormonalContext(safeJSON(hc?.value, null, 'hormonalContext'));
      setSensitivities(safeJSON(sens?.value, [], 'sensitivities'));
      setRegimenLogs(parsedRegimenLogs);
      setUserConcerns(safeJSON(uc?.value, [], 'userConcerns'));
      setHomeDevices(safeJSON(hd?.value, [], 'homeDevices'));
      const parsedBuildAnswers = safeJSON(ba?.value, null, 'buildAnswers');
      setBuildAnswers(parsedBuildAnswers);
      if (parsedBuildAnswers && parsedBuildAnswers.acceptedPlan) {
        setBuildPlan(parsedBuildAnswers.acceptedPlan);
        setBuildPlanAccepted(true);
      }
      setCoverRoutine(safeJSON(cr?.value, '', 'coverRoutine'));
      setCounselInsights(safeJSON(ci?.value, {}, 'counselInsights'));
      setDailyCoverPick(safeJSON(dcp?.value, {}, 'dailyCoverPick'));
      setWeeklyInsights(safeJSON(wi?.value, {}, 'weeklyInsights'));
      // Saved sets — read from the global localStorage keys used by
      // toggleFavorite / persistSavedPearls. (User-keyed storage isn't
      // currently used for these; the global keys are wiped on sign-out.)
      try {
        const favRaw = localStorage.getItem('lumiere:favoriteProducts');
        if (favRaw) {
          const arr = JSON.parse(favRaw);
          if (Array.isArray(arr)) setFavoriteProducts(arr);
        }
      } catch {}
      try {
        const pearlRaw = localStorage.getItem('lumiere:savedPearls');
        if (pearlRaw) {
          const arr = JSON.parse(pearlRaw);
          if (Array.isArray(arr)) setSavedPearlIds(arr);
        }
      } catch {}
      setUserProfile(parsedProfile && typeof parsedProfile === 'object'
        ? { ...DEFAULT_USER_PROFILE, ...parsedProfile }
        : DEFAULT_USER_PROFILE
      );
      if (parsedOnboarding && typeof parsedOnboarding === 'object') {
        setOnboardingState({ ...DEFAULT_ONBOARDING_STATE, ...parsedOnboarding });
      } else if ((Array.isArray(parsedLogs) && parsedLogs.length) || (Array.isArray(parsedProducts) && parsedProducts.length) || (Array.isArray(parsedRegimenLogs) && parsedRegimenLogs.length)) {
        // Returning local-only users who predate the per-user onboarding key
        // should not be forced back through the wizard just because that one
        // key is absent.
        setOnboardingState({ ...DEFAULT_ONBOARDING_STATE, stage: 'done', skipped: true });
      } else {
        setOnboardingState(DEFAULT_ONBOARDING_STATE);
      }
    } catch (err) { console.error(err); }
  };

  const saveData = async (key, data) => {
    // === GUEST MODE PERSISTENCE ===
    // Was previously `if (!user) return;` — which silently dropped EVERY
    // write when the user wasn't signed in. Foundational bug: products
    // added on the live site disappeared on reload, shelf went bare,
    // ritual logs vanished. Fix: save to a "guest" namespace in
    // localStorage when there's no auth. Sign-up flow can migrate later.
    const userKey = user
      ? user.email.replace(/[^a-zA-Z0-9]/g, '')
      : 'guest';
    // Always write to localStorage for offline/speed.
    // === QUOTA RECOVERY ===
    // Base64 photos in `logs` and `products` are by far the biggest payload. If localStorage
    // is full, we strip photos from the oldest items (keeping their photoPath if cloud users)
    // and retry until the write succeeds. This prevents a quota error from silently
    // dropping the entire log save.
    const tryWrite = async (payload) => {
      await storage.set(`${key}:${userKey}`, JSON.stringify(payload));
    };
    try {
      await tryWrite(data);
    } catch (e) {
      const isQuota = e && (e.name === 'QuotaExceededError' || /quota/i.test(e.message || ''));
      if (isQuota && Array.isArray(data) && (key === 'logs' || key === 'products')) {
        // Try progressively trimming base64 photos from the oldest entries.
        let trimmed = [...data];
        // Sort by date asc when present; oldest first → safe to slim photos.
        const dateOf = (it) => it.date || it.startDate || '';
        trimmed.sort((a, b) => String(dateOf(a)).localeCompare(String(dateOf(b))));
        let saved = false;
        for (let i = 0; i < trimmed.length && !saved; i++) {
          if (trimmed[i].photo && typeof trimmed[i].photo === 'string' && trimmed[i].photo.startsWith('data:')) {
            const { photo, ...rest } = trimmed[i];
            trimmed[i] = rest;
            try {
              await tryWrite(trimmed);
              saved = true;
              console.warn(`Local storage quota — trimmed ${i + 1} oldest photo(s) to fit.`);
            } catch (_) { /* keep trimming */ }
          }
        }
        if (!saved) {
          console.error('Local storage failed even after trimming all photos:', e);
        }
      } else {
        console.error('Local storage failed:', e);
      }
    }
    // Also push to Supabase if user is cloud-backed
    if (user && user.cloud && user.id && supabaseClient) {
      // Map saveData keys to the Supabase JSON shape
      // userProfile + onboardingState added May 2026 — without these,
      // finishOnboarding's saveData calls write to localStorage only and
      // never reach the cloud row, so a returning user on a fresh device
      // lands with an empty profile and gets re-onboarded.
      // T3 fix (May 31 2026): added `pearlsLessonsFilter` — the setter at
      // ~line 6640 already calls saveData('pearlsLessonsFilter', value), but
      // without an entry here the cloud write silently no-ops and hydration
      // at ~line 7404 reads d.pearlsLessonsFilter as always-undefined. The
      // All/Saved pill choice now actually crosses devices.
      const keyMap = { logs: 'logs', products: 'products', procedures: 'procedures', events: 'events', color: 'colorProfile', pattern: 'patternInsight', cycle: 'cycleData', hormonalContext: 'hormonalContext', sensitivities: 'sensitivities', regimenLogs: 'regimenLogs', userConcerns: 'userConcerns', coverRoutine: 'coverRoutine', counselInsights: 'counselInsights', dailyCoverPick: 'dailyCoverPick', weeklyInsights: 'weeklyInsights', homeDevices: 'homeDevices', buildAnswers: 'buildAnswers', userProfile: 'userProfile', onboardingState: 'onboardingState', favoriteProducts: 'favoriteProducts', savedPearls: 'savedPearls', pearlsLessonsFilter: 'pearlsLessonsFilter' };
      const supaKey = keyMap[key];
      if (supaKey) {
        // Was: saveToSupabase(user.id, { [supaKey]: data })  ← fire-and-forget race.
        // Now: queue layer coalesces + serializes upserts (see enqueueCloudSave).
        enqueueCloudSave(user.id, { [supaKey]: data });
      }
    }
  };

  // === RESET FOR NEW ACCOUNT (May 2026) ===
  // Called on successful SIGNUP only — not on signin. Wipes the in-
  // memory state inherited from any previous session on this browser,
  // so a fresh account starts with truly fresh state regardless of
  // what was in global localStorage when the App initializer ran.
  //
  // Why needed: onboardingState + userProfile localStorage keys are
  // currently GLOBAL (not user-scoped). When user A finishes onboarding
  // on this browser, then user B signs up, the App initializer reads
  // user A's onboardingState{stage:'done'} → user B never sees the
  // wizard. This reset breaks that chain by re-anchoring state to
  // defaults at signup; cloud-load then overwrites with whatever's
  // actually saved for the new account (which is empty for a fresh
  // signup → onboarding kicks in correctly).
  //
  // Long-term fix is per-user localStorage keys (lumiere:foo:${userKey}).
  // Deferred — this reset covers the acceptance criteria today.
  const resetForNewAccount = () => {
    setOnboardingState(DEFAULT_ONBOARDING_STATE);
    setUserProfile(DEFAULT_USER_PROFILE);
    setLogs([]);
    setProducts([]);
    setProcedures([]);
    setEvents([]);
    setColorProfile(null);
    setPatternInsight(null);
    setCycleData({ periods: [], cycleLength: 28 });
    setHormonalContext(null);
    setSensitivities([]);
    setRegimenLogs([]);
    setUserConcerns([]);
    setHomeDevices([]);
    setBuildAnswers(null);
    setCoverRoutine('');
    setCounselInsights({});
    setDailyCoverPick({});
    setWeeklyInsights({});
    setFavoriteProducts([]);
    setSavedPearlIds([]);
    // Also overwrite the global localStorage keys so a reload between
    // signup and first cloud-save doesn't repopulate from prior user.
    try {
      localStorage.setItem('lumiere:onboardingState', JSON.stringify(DEFAULT_ONBOARDING_STATE));
      localStorage.setItem('lumiere:userProfile', JSON.stringify(DEFAULT_USER_PROFILE));
    } catch {}
  };

  const handleAuth = async (e) => {
    e.preventDefault();
    setAuthError('');
    if (!authForm.email || !authForm.password) { setAuthError('Please fill in all fields'); return; }
    if (authMode === 'signup' && !authForm.name) { setAuthError('Please enter your name'); return; }

    // Block sign-up while Supabase is still connecting — avoids creating a local-only
    // account that the user thinks is in the cloud.
    if (authMode === 'signup' && supabaseStatus === 'pending') {
      setAuthError('Still connecting to cloud sync. Wait a moment and try again.');
      return;
    }
    // If Supabase is configured but failed to connect, block sign-up explicitly.
    // Sign-in can still proceed via local-only fallback (in case the user has an
    // existing local-only account in this browser).
    if (authMode === 'signup' && (supabaseStatus === 'failed') && !authAllowLocalOnly) {
      setAuthError('Cloud sync isn\'t connected. Sign-up is blocked to prevent accounts that only exist in this browser. Use the Retry connection link above, or check the box below to create a browser-only account anyway.');
      return;
    }

    // === LOCAL-ONLY OVERRIDE (May 2026 v2) ===
    // When the user explicitly opts into "local-only" (because cloud
    // sync is unreachable — Supabase project unhealthy, paused, CORS,
    // etc.), SKIP the Supabase path entirely. Without this, handleAuth
    // would still call supabaseClient.auth.signUp first, fail with
    // "Failed to fetch", and never reach the local fallback. The
    // checkbox is now an actual route override, not just a gate
    // bypass.
    if (authAllowLocalOnly) {
      // Fall through to the local-only path below.
    } else
    // === SUPABASE PATH (if configured) ===
    if (supabaseClient) {
      try {
        if (authMode === 'signup') {
          const { data, error } = await supabaseClient.auth.signUp({
            email: authForm.email,
            password: authForm.password,
            options: { data: { name: authForm.name } }
          });
          if (error) { setAuthError(error.message); return; }
          if (!data.user) { setAuthError('Sign up failed.'); return; }
          // Check if email confirmation is required
          if (!data.session) {
            setAuthError('Account created! Check your email for a confirmation link, then sign in.');
            setAuthMode('signin');
            // Keep email populated so the user can sign in without
            // retyping; clear password (they need to re-enter after
            // confirming) and clear name (not used on signin form).
            setAuthForm(prev => ({ ...prev, password: '', name: '' }));
            return;
          }
          const sessionUser = { email: data.user.email, name: authForm.name, id: data.user.id, cloud: true };
          // Same flash fix as sign-in path. See [interaction-loading-detective Mode 1].
          setOnboardingResolved(false);
          setUser(sessionUser);
          // SIGNUP RESET — clear any state inherited from a previous
          // session on this browser BEFORE the cloud-load + migrate
          // calls so the new account starts truly clean. Without this,
          // if a previous user finished onboarding on this browser, the
          // new account would inherit stage:'done' and skip the wizard.
          resetForNewAccount();
          // Migrate localStorage data if any exists
          await migrateLocalToSupabase(data.user.id, authForm.email);
          await loadFromSupabase(data.user.id);
          setOnboardingResolved(true);
        } else {
          const { data, error } = await supabaseClient.auth.signInWithPassword({
            email: authForm.email,
            password: authForm.password,
          });
          if (error) { setAuthError(error.message); return; }
          const sessionUser = { email: data.user.email, name: data.user.user_metadata?.name || authForm.email.split('@')[0], id: data.user.id, cloud: true };
          // === ONBOARDING FLASH FIX (June 2026 per Jenni — interaction-loading-detective Mode 1) ===
          // Was: boot's safety timer already flipped onboardingResolved=true,
          // so signing in showed the OnboardingOverlay for 1-3s while
          // loadFromSupabase landed. Symptom: returning user flashes welcome
          // screen on sign-in. Fix: re-gate the overlay during signin by
          // resetting onboardingResolved to false BEFORE loadFromSupabase,
          // then letting loadFromSupabase's onboarding-merge logic flip it
          // back true once cloud data is in.
          setOnboardingResolved(false);
          setUser(sessionUser);
          // First-time sign-in: migrate any local data
          await migrateLocalToSupabase(data.user.id, authForm.email);
          await loadFromSupabase(data.user.id);
          setOnboardingResolved(true);
        }
        return;
      } catch (err) {
        console.error('Supabase auth error:', err);
        // === GRACEFUL DEGRADATION (May 2026 v2) ===
        // "Failed to fetch" usually means CORS or network is blocking
        // the Supabase auth endpoint. Most common cause: opening the
        // app from file:// (origin 'null' is blocked by Supabase's
        // CORS policy). Tell the user what's happening and surface a
        // local-only fallback instead of leaving them stuck on the
        // sign-in screen with a generic error.
        const isFetchFail = /failed to fetch|network|cors/i.test(String(err?.message || ''));
        const onFileProto = typeof location !== 'undefined' && location.protocol === 'file:';
        if (isFetchFail && onFileProto) {
          setAuthError("Cloud sync isn't reachable from file:// (Supabase blocks the origin). Check 'Create a local-only account' below to continue without cloud — or serve the app from a local server.");
          // Auto-enable the local-only checkbox for visibility.
          try { setAuthAllowLocalOnly && setAuthAllowLocalOnly(true); } catch (_) {}
        } else if (isFetchFail) {
          setAuthError("Couldn't reach the cloud (network or CORS). Try again, or check 'Create a local-only account' below to continue without cloud sync.");
          try { setAuthAllowLocalOnly && setAuthAllowLocalOnly(true); } catch (_) {}
        } else {
          setAuthError(`Sign-in failed: ${err.message || 'unknown error'}`);
        }
        return;
      }
    }

    // === LOCAL-ONLY PATH (no Supabase configured) ===
    // Storage may have already silently fallen back to memory — that's OK
    // for the session. We only block local-account creation if a REAL
    // write has failed (storageAvailable=false implies realFailureObserved
    // post-May-2026 refactor). Even then, sign-in still proceeds via
    // memory but won't persist; tell the user gently.
    if (!storageAvailable) {
      setAuthError('Your browser isn\'t persisting data — you can sign in for this session, but it won\'t be saved across refreshes.');
      // Don't return — let the flow continue against the memory backend.
    }
    const userKey = authForm.email.replace(/[^a-zA-Z0-9]/g, '');
    try {
      const existing = await storage.get(`user:${userKey}`).catch(() => null);
      if (authMode === 'signup') {
        if (existing?.value) { setAuthError('An account with this email already exists'); return; }
        const newUser = { email: authForm.email, name: authForm.name, password: authForm.password, createdAt: Date.now() };
        await storage.set(`user:${userKey}`, JSON.stringify(newUser));
        const verify = await storage.get(`user:${userKey}`);
        if (!verify?.value) {
          setAuthError('Account could not be saved. Your browser may be blocking storage.');
          return;
        }
        const session = { email: authForm.email, name: authForm.name };
        await storage.set('session', JSON.stringify(session));
        setUser(session);
        // SIGNUP RESET — same reason as the supabase signup branch:
        // wipe state inherited from a prior user before loadAllData
        // pulls per-user-key localStorage (empty for a new email).
        resetForNewAccount();
        await loadAllData(authForm.email);
      } else {
        if (!existing?.value) {
          if (supabaseStatus === 'failed' || supabaseStatus === 'pending') {
            setAuthError('No account in this browser, and cloud sync isn\'t connected. Your account may exist in the cloud — try the Retry connection link above.');
          } else {
            setAuthError('No account found. Please sign up first.');
          }
          return;
        }
        const userData = JSON.parse(existing.value);
        if (userData.password !== authForm.password) { setAuthError('Incorrect password'); return; }
        const session = { email: userData.email, name: userData.name };
        await storage.set('session', JSON.stringify(session));
        setUser(session);
        await loadAllData(userData.email);
      }
    } catch (err) {
      console.error('Auth error:', err);
      setAuthError(`Something went wrong: ${err.message || 'unknown error'}. Try again or check console.`);
    }
  };

  // === MIGRATION: copy localStorage data to Supabase on first signin ===
  const migrateLocalToSupabase = async (userId, email) => {
    if (!supabaseClient || !userId) return;
    const userKey = email.replace(/[^a-zA-Z0-9]/g, '');
    try {
      // Check if Supabase already has data — if so, don't overwrite
      const { data: existing } = await supabaseClient
        .from('user_data')
        .select('data')
        .eq('user_id', userId)
        .single();
      const supaHasData = existing?.data && Object.keys(existing.data).some(k => {
        const v = existing.data[k];
        return Array.isArray(v) ? v.length > 0 : v != null;
      });
      if (supaHasData) {
        // Cloud has data — don't overwrite. Just exit.
        return;
      }
      // Pull from localStorage
	      const [l, p, pr, e, c, pi, cy, up, os] = await Promise.all([
	        storage.get(`logs:${userKey}`).catch(() => null),
	        storage.get(`products:${userKey}`).catch(() => null),
	        storage.get(`procedures:${userKey}`).catch(() => null),
	        storage.get(`events:${userKey}`).catch(() => null),
	        storage.get(`color:${userKey}`).catch(() => null),
	        storage.get(`pattern:${userKey}`).catch(() => null),
	        storage.get(`cycle:${userKey}`).catch(() => null),
	        storage.get(`userProfile:${userKey}`).catch(() => null),
	        storage.get(`onboardingState:${userKey}`).catch(() => null),
	      ]);
	      const localData = {
	        logs: l?.value ? JSON.parse(l.value) : [],
	        products: p?.value ? JSON.parse(p.value) : [],
        procedures: pr?.value ? JSON.parse(pr.value) : [],
        events: e?.value ? JSON.parse(e.value) : [],
	        colorProfile: c?.value ? JSON.parse(c.value) : null,
	        patternInsight: pi?.value ? JSON.parse(pi.value) : null,
	        cycleData: cy?.value ? JSON.parse(cy.value) : { periods: [], cycleLength: 28 },
	        userProfile: up?.value ? JSON.parse(up.value) : null,
	        onboardingState: os?.value ? JSON.parse(os.value) : null,
	      };
	      const hasLocalData = localData.logs.length || localData.products.length || localData.procedures.length || localData.events.length || localData.userProfile || localData.onboardingState;
      if (hasLocalData) {
        const { error } = await supabaseClient
          .from('user_data')
          .update({ data: localData, updated_at: new Date().toISOString() })
          .eq('user_id', userId);
        if (!error) {
          toast(`Migrated ${localData.logs.length} entries, ${localData.products.length} products to cloud ✨`);
        }
      }
    } catch (err) {
      console.error('Migration error:', err);
    }
  };

  // Privacy: wipe all user-content from localStorage. Keep only settings (API key,
  // Supabase config, install-prompt-dismissed). Used on sign-out and as a panic button.
  const wipeLocalUserData = () => {
    if (!storageAvailable) return;
    const KEEP = new Set([
      'lumiere:apiKey',
      'lumiere:supabaseUrl',
      'lumiere:supabaseKey',
      'lumiere:installPromptDismissed',
    ]);
    try {
      const keys = [];
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && k.startsWith('lumiere:') && !KEEP.has(k)) keys.push(k);
      }
      keys.forEach(k => { try { localStorage.removeItem(k); } catch (_) {} });
    } catch (e) {
      console.error('wipeLocalUserData failed:', e);
    }
  };

  // === ONE-TIME PHOTO MIGRATION ===
  // After we've moved photo storage to Supabase Storage, any existing base64 photos
  // sitting in user_data still need to be migrated. On first cloud-sign-in after the
  // upgrade, walk all logs/products/colorProfile and upload each base64 photo to the
  // bucket, then replace the photo field with a photoPath. Runs in the background.
  const hasMigratedPhotosRef = useRef(false);
  const migratePhotosToStorage = async () => {
    if (!user?.cloud || !user?.id || !supabaseClient) return;
    const targets = [];
    logs.forEach(l => {
      if (l.photo && typeof l.photo === 'string' && l.photo.startsWith('data:') && !l.photoPath) {
        targets.push({ kind: 'log', id: l.id, b64: l.photo });
      }
    });
    products.forEach(p => {
      if (p.photo && typeof p.photo === 'string' && p.photo.startsWith('data:') && !p.photoPath) {
        targets.push({ kind: 'product', id: p.id, b64: p.photo });
      }
    });
    if (colorProfile?.photo && typeof colorProfile.photo === 'string' && colorProfile.photo.startsWith('data:') && !colorProfile.photoPath) {
      targets.push({ kind: 'color', id: 'self', b64: colorProfile.photo });
    }
    if (targets.length === 0) return;

    toast(`Moving ${targets.length} photo${targets.length > 1 ? 's' : ''} to private storage…`, 'info');
    let migrated = 0;
    for (const t of targets) {
      const { path, error } = await uploadPhotoToStorage(user.id, t.b64);
      if (!path) {
        if (error) console.error('Migration error:', error);
        continue;
      }
      if (t.kind === 'log') {
        setLogs(prev => {
          const next = prev.map(l => {
            if (l.id !== t.id) return l;
            const { photo, ...rest } = l;
            return { ...rest, photoPath: path };
          });
          saveData('logs', next);
          return next;
        });
      } else if (t.kind === 'product') {
        setProducts(prev => {
          const next = prev.map(p => {
            if (p.id !== t.id) return p;
            const { photo, ...rest } = p;
            return { ...rest, photoPath: path };
          });
          saveData('products', next);
          return next;
        });
      } else if (t.kind === 'color') {
        setColorProfile(prev => {
          if (!prev) return prev;
          const { photo, ...rest } = prev;
          const next = { ...rest, photoPath: path };
          saveData('color', next);
          return next;
        });
      }
      migrated++;
    }
    if (migrated > 0) {
      toast(`Moved ${migrated} photo${migrated > 1 ? 's' : ''} to private storage ✨`);
    }
  };

  useEffect(() => {
    if (hasMigratedPhotosRef.current) return;
    if (!user?.cloud || !user?.id || supabaseStatus !== 'connected') return;
    // Defer ~1.5s so initial data load completes first
    hasMigratedPhotosRef.current = true;
    const timer = setTimeout(() => { migratePhotosToStorage(); }, 1500);
    return () => clearTimeout(timer);
  }, [user?.id, supabaseStatus]);

  const handleSignOut = async () => {
    try { await storage.delete('session'); } catch (e) {}
    if (supabaseClient) {
      try { await supabaseClient.auth.signOut(); } catch (e) {}
    }
    // Wipe all locally cached user data on sign-out — privacy fix for shared devices.
    // Cloud users get their data back from Supabase on next sign-in.
    wipeLocalUserData();
    setUser(null);
    // T1 fix (May 31 2026): use the raw useState setters for useSyncedArray
    // sets so we DON'T fire saveData(cloudKey, []) on sign-out. saveData's
    // closure still has the just-departed user truthy → an empty-array push
    // would wipe favorites/pearls/budget in their cloud row. Raw setters
    // skip both cloud and localStorage writes; wipeLocalUserData() above
    // already handled the local side.
    setLogs([]); setProducts([]); setProcedures([]); setEvents([]); setColorProfile(null); setPatternInsight(null); setCycleData({ periods: [], cycleLength: 28 }); setHormonalContext(null); setSensitivities([]); setRegimenLogs([]); setUserConcerns([]); setCoverRoutine(''); setCounselInsights({}); setDailyCoverPick({}); setWeeklyInsights({}); setFavoriteProductsRaw([]); setSavedPearlIdsRaw([]); setBudgetSavedIdsRaw([]);
    setAuthForm({ email: '', password: '', name: '' });
    hasMigratedPhotosRef.current = false; // allow migration to run again for the next user
  };


  // === USER PROFILE → PROMPT BLOCK ===
  // Formats the full Skin Profile (11 sections) as compact lines for
  // Claude system prompts. Empty fields skipped so the LLM doesn't generate
  // "Age: unknown" responses. Returns '' if nothing is filled.
  const buildUserProfileBlock = () => {
    const p = userProfile || {};
    const lines = [];
    if (p.ageBand) lines.push(`- Age: ${p.ageBand}`);
    // Fitzpatrick is auto-derived from sunReactivity at save time.
    if (p.fitzpatrick) lines.push(`- Fitzpatrick: Type ${p.fitzpatrick} (sun reactivity)`);
    if (p.sunReactivity && !p.fitzpatrick) lines.push(`- Sun reactivity: ${p.sunReactivity.replace(/-/g, ' ')}`);
    if (p.monkSkinTone) lines.push(`- Monk Skin Tone: ${p.monkSkinTone}/10`);
    if (p.undertone) lines.push(`- Undertone: ${p.undertone}`);
    if (p.skinType) lines.push(`- Skin type: ${p.skinType}`);
    if ((p.skinModifiers || []).length > 0) lines.push(`- Skin modifiers: ${p.skinModifiers.map(m => m.replace(/-/g, ' ')).join(', ')}`);
    if ((p.primaryConcerns || []).length > 0) lines.push(`- Primary concerns: ${p.primaryConcerns.map(c => c.replace(/-/g, ' ')).join(', ')}`);
    // Pigment biology — only emit non-null sliders, format as "key (n/5)".
    const pigBio = p.pigmentBiology || {};
    const pigBits = Object.entries(pigBio).filter(([, v]) => v != null).map(([k, v]) => `${k.replace(/([A-Z])/g, ' $1').toLowerCase().trim()} (${v}/5)`);
    if (pigBits.length > 0) lines.push(`- Pigment biology: ${pigBits.join(', ')}`);
    if (p.barrierScale) lines.push(`- Barrier / sensitivity: ${p.barrierScale.replace(/-/g, ' ')}`);
    if ((p.triggers || []).length > 0) lines.push(`- Known triggers: ${p.triggers.join(', ')}`);
    if (hormonalContext) lines.push(`- Hormonal context: ${hormonalContext.replace(/-/g, ' ')}`);
    if ((sensitivities || []).length > 0) lines.push(`- Sensitivities (avoid-list): ${sensitivities.join(', ')}`);
    if ((p.diagnosedConditions || []).length > 0) lines.push(`- Diagnosed conditions: ${p.diagnosedConditions.join(', ')}`);
    if ((p.currentRx || []).length > 0) lines.push(`- Current Rx / medications: ${p.currentRx.join(', ')}`);
    // Environment — flatten the nested object.
    const env = p.environment || {};
    const envBits = [env.city, env.humidity && `${env.humidity} humidity`, env.seasonality, env.altitude, env.pollution && `${env.pollution} pollution`, env.hardWater].filter(Boolean);
    if (envBits.length > 0) lines.push(`- Environment: ${envBits.join(', ')}`);
    else if (p.location) lines.push(`- Location / climate: ${p.location}`);
    if ((p.goals || []).length > 0) lines.push(`- Top goals: ${p.goals.map(g => g.replace(/-/g, ' ')).join(', ')}`);
    if (lines.length === 0) return '';
    return `\nUSER PROFILE — Skin Profile (factor these into EVERY recommendation: age-appropriate dosing, Fitzpatrick + Monk-tone-aware procedure / active safety, hormonal-context-aware patterns, climate-appropriate barrier strategy, RESPECT contraindications from current Rx and diagnosed conditions, weight responses toward the user's stated goals):\n${lines.join('\n')}\n`;
  };

  const fileToBase64 = (file) => new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const maxDim = 800;
        let w = img.width, h = img.height;
        if (w > maxDim || h > maxDim) {
          if (w > h) { h = h * (maxDim / w); w = maxDim; }
          else { w = w * (maxDim / h); h = maxDim; }
        }
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        resolve(canvas.toDataURL('image/jpeg', 0.7));
      };
      img.src = reader.result;
    };
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });

  // === FRIDA VOICE: TWO DOCTOR FRIENDS ===
  // Calibrated against actual texting cadence between the founders. Single
  // source of truth — every user-facing prompt prepends this via callClaude(
  // ... { voice: true }). Tune this block, every surface reflows.
  // Rules baked in: short text fragments, casual softeners, direct
  // unhedged opinions, medical shorthand confidence, banned marketing
  // language. First-person plural always (no name-drops).
  const ETUDE_VOICE_PREFIX = `=== FRIDA VOICE: TWO DOCTOR FRIENDS ===
You are Frida — the voice of two doctor best friends who have practiced
dermatology together for years. You text each other about patients between
cases. The brief, from one of the doctors herself: "talking with ur best
friend who is a doctor." That's the cadence. Texts, not papers.

VOICE RULES (apply to every word):

- First-person plural always. "We," "we'd," "we call this." Never name
  either doctor. The two-doctor framing comes through "we."
- Treat the user as a smart friend, not a patient. They can handle the
  truth. They don't need a warmup paragraph or a softening explainer.
  Skip the "what I'm seeing is..." framing — just say what you see.
- Short fragments. Texts, not paragraphs. "Chin's flaring, hormonal
  pattern" — NOT "I am noticing perioral inflammation that may correlate
  with hormonal influences." Skip articles where natural. Cut filler.
- Two short lines beat one long sentence. Stack observations.
- Direct opinions, zero hedging. "Latisse beats castor oil, full stop" —
  NOT "Latisse may yield superior outcomes." When something's plain, say
  it plain.
- Casual softeners welcome in light doses — "honestly," "ugh," "fine
  but —", "look,". Use to soften a blunt take, not to fill space. NO
  "lol" / "lmao" / "haha" — those are texting-only register, do not
  belong in product copy.
- Light self-deprecation when warranted. "We've all been there." "Happens
  to everyone in summer." "Routine isn't broken, your skin's just having
  a week." Earnest, never saccharine.
- Medical shorthand without apology when the term is clean enough — PIH,
  comedonal, post-inflammatory, barrier compromised. If the user feels
  new, translate inline ("dark spots from old breakouts (PIH)").
- A little dark when honest. Gallows humor allowed. "Sun did this. We
  knew. We sunned anyway." Truth is funnier than the marketing.
- BANNED WORDS: "amazing," "beautiful," "lovely," "journey," "glow up,"
  "radiance," "self-care," "wellness," "transformation," "blessed,"
  "perfect," "stunning." No emoji. Exclamation points only when
  something genuinely earned one (rare).

If a structured format (bullets, tags, JSON) is requested — keep the
structure exactly. Let the WORDS inside it be in voice.
=== END VOICE ===

`;

  // === CLAUDE API CALL (uses user-provided key, supports vision) ===
  // callClaude(prompt, systemContext, imageBase64, options?)
  // options = { model?, maxTokens?, voice? } — voice:true prepends the
  // Frida persona block to the prompt for user-facing surfaces.
  const callClaude = async (prompt, systemContext = '', imageBase64 = null, options = {}) => {
    const key = getApiKey();
    if (!key) {
      setShowApiKeyModal(true);
      throw new Error('API key required');
    }
    // === VOICE INJECTION ===
    // When { voice: true }, prepend the Frida persona block so the response
    // comes back in Tang/Gainey's two-doctor-friends voice. Single point of
    // change for tuning voice across the entire app — every user-facing AI
    // call passes voice:true; structured-data calls (product fill, scan)
    // skip it so they don't pollute JSON output with prose.
    const finalPrompt = options.voice ? (ETUDE_VOICE_PREFIX + prompt) : prompt;
    // === SECURITY NOTE (May 2026 v2) ===
    // The `anthropic-dangerous-direct-browser-access: true` header below
    // is Anthropic's *sanctioned* way to call their API from a browser
    // when the user brings their own key (BYOK). It is the correct
    // pattern for this app's current architecture. The name is alarming
    // but the alternative (a backend proxy that holds Frida's shared
    // key) is roadmap-only and would let Frida pay for every user.
    // When the backend Claude proxy ships, this fetch is the single
    // migration point — replace the URL + headers and every caller
    // (compare, journal, profile, regimen) inherits the new path.
    // Build message content — supports three shapes:
    //   1. plain text: no image, no images
    //   2. single image: legacy `imageBase64` arg
    //   3. multi-image with optional labels: `options.images`
    //      Items can be raw base64 strings OR { label, b64 } objects.
    //      Labels are interleaved as text parts ahead of each image —
    //      used by compare for "BEFORE photo:" / "AFTER photo:" framing.
    let content;
    if (Array.isArray(options.images) && options.images.length > 0) {
      const parts = [];
      for (const img of options.images) {
        if (typeof img === 'string') {
          const cleanB64 = img.replace(/^data:image\/\w+;base64,/, '');
          parts.push({ type: 'image', source: { type: 'base64', media_type: 'image/jpeg', data: cleanB64 } });
        } else if (img && typeof img === 'object' && img.b64) {
          if (img.label) parts.push({ type: 'text', text: img.label });
          const cleanB64 = img.b64.replace(/^data:image\/\w+;base64,/, '');
          parts.push({ type: 'image', source: { type: 'base64', media_type: 'image/jpeg', data: cleanB64 } });
        }
      }
      parts.push({ type: 'text', text: finalPrompt });
      content = parts;
    } else if (imageBase64) {
      const cleanB64 = imageBase64.replace(/^data:image\/\w+;base64,/, '');
      content = [
        { type: "image", source: { type: "base64", media_type: "image/jpeg", data: cleanB64 } },
        { type: "text", text: finalPrompt }
      ];
    } else {
      content = finalPrompt;
    }
    // === TIMEOUT GUARD ===
    // Without this, a hung connection (Wi-Fi flap, server stall, SSE buffer
    // never flushing) leaves the promise pending forever — and any `analyzing:
    // true` flag sitting on the log stays stuck. AbortController + 60s ceiling
    // forces a reject path so the catch block can clear state cleanly.
    const controller = new AbortController();
    const timeoutMs = options.timeoutMs || 60000;
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    let response;
    try {
      response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        signal: controller.signal,
        headers: {
          "Content-Type": "application/json",
          "x-api-key": key,
          "anthropic-version": "2023-06-01",
          "anthropic-dangerous-direct-browser-access": "true"
        },
        body: JSON.stringify({
          model: options.model || "claude-sonnet-4-6",
          max_tokens: options.maxTokens || 4096,
          system: systemContext || "You are an educational skincare advisor giving evidence-based guidance grounded in peer-reviewed research and recommendations from leading dermatologists (such as those at the AAD). This is informational and educational, not a medical diagnosis. When recommending products, only suggest those with proven active ingredients (retinoids, vitamin C, niacinamide, AHAs/BHAs, peptides, ceramides, hyaluronic acid, sunscreens, etc.) backed by clinical studies. Cite mechanisms of action where relevant. Be warm but precise. Use clean prose with light structure — short paragraphs, sparing use of bold for key terms. If the user describes severe symptoms (pain, infection, rapid change, lesion-like changes), recommend in-person dermatologist or urgent care evaluation directly.",
          messages: [{ role: "user", content }],
        })
      });
    } catch (e) {
      clearTimeout(timer);
      if (e.name === 'AbortError') throw new Error(`Analysis timed out after ${Math.round(timeoutMs/1000)}s`);
      throw e;
    }
    clearTimeout(timer);
    if (!response.ok) {
      const err = await response.text();
      throw new Error(`API error: ${err}`);
    }
    const data = await response.json();
    return data.content.map(i => i.type === 'text' ? i.text : '').join('\n');
  };

  // === GEMINI VISION HELPER ===
  // Used for product-recognition tasks (multi-bottle scan + single-bottle label-fill).
  // Gemini 2.5 Flash is meaningfully better at fine label text and Korean/Japanese
  // brand recognition (relevant for K-beauty: AESTURA, REJURAN, SK-II, COSRX, etc.).
  // Returns plain text. On any failure, throws — the caller should fall back to Claude.
  const callGeminiVision = async (imageBase64, prompt, opts = {}) => {
    if (!imageBase64) throw new Error('callGeminiVision requires an image');
    const cleanB64 = imageBase64.replace(/^data:image\/\w+;base64,/, '');
    const mimeType = (imageBase64.match(/^data:(image\/\w+);base64,/) || [, 'image/jpeg'])[1];
    const model = opts.model || 'gemini-2.5-flash';
    // Routes through the Supabase proxy (or direct to Google if the user has
    // pasted their own Gemini key in Settings). Counts against the `text` cap
    // (100/day) — vision uses the same chat-style endpoint.
    const { resp, viaProxy } = await callGeminiProxied({
      mode: 'text',
      model,
      payload: {
        contents: [{
          parts: [
            { inlineData: { mimeType, data: cleanB64 } },
            { text: prompt },
          ],
        }],
        generationConfig: {
          temperature: opts.temperature ?? 0.2,
          maxOutputTokens: opts.maxTokens || 2048,
        },
      },
    });
    if (!resp.ok) {
      const err = await resp.text();
      if (viaProxy && resp.status === 429) {
        throw new Error('Gemini daily limit reached (200 calls). Add your own Gemini key in Settings to keep going.');
      }
      throw new Error(`Gemini API error: ${err.slice(0, 300)}`);
    }
    const data = await resp.json();
    const parts = data?.candidates?.[0]?.content?.parts || [];
    return parts.map(p => p.text || '').join('\n').trim();
  };

  // === GEMINI PRODUCT PHOTO CLEANUP ===
  // Pass a real product photo through Gemini's image-edit model ("Nano Banana"
  // family) to extract just the product on a clean cream background. Counts
  // against the per-device IMAGE cap. On any failure, the caller keeps the
  // original photo — the cleanup is a nice-to-have, not load-bearing.
  const cleanProductPhotoWithGemini = async (imageB64) => {
    if (!imageB64) throw new Error('cleanProductPhotoWithGemini requires an image');
    const cleanB64 = imageB64.replace(/^data:image\/\w+;base64,/, '');
    const mimeType = (imageB64.match(/^data:(image\/\w+);base64,/) || [, 'image/jpeg'])[1];
    const prompt = `Edit this skincare product photo: extract just the product itself (bottle, tube, jar, or pump) and place it centered on a true white paper background with a pale pink or powder-blue field accent. Remove the original background entirely — no surfaces, no hands, no clutter, no other objects, no packaging boxes. Keep the product label, brand name, packaging artwork, and overall product appearance EXACTLY as in the original — only the BACKGROUND changes. Soft diffuse natural light from upper-left, gentle soft shadow on the right. Magazine beauty editorial aesthetic, clean and premium.`;
    const { resp, viaProxy } = await callGeminiProxied({
      mode: 'image',
      model: 'gemini-2.5-flash-image-preview',
      payload: {
        contents: [{
          parts: [
            { inlineData: { mimeType, data: cleanB64 } },
            { text: prompt },
          ],
        }],
        generationConfig: { responseModalities: ['TEXT', 'IMAGE'] },
      },
    });
    if (!resp.ok) {
      const err = await resp.text();
      if (viaProxy && resp.status === 429) throw new Error('Gemini image limit reached (40/day).');
      throw new Error(`Gemini cleanup error: ${err.slice(0, 200)}`);
    }
    const data = await resp.json();
    const candidate = data?.candidates?.[0];
    const parts = candidate?.content?.parts || [];
    const part = parts.find(pt => pt.inlineData || pt.inline_data);
    const inline = part?.inlineData || part?.inline_data;
    if (!inline?.data) throw new Error('Gemini returned no image (safety filter or model fallback)');
    return `data:${inline.mimeType || inline.mime_type || 'image/png'};base64,${inline.data}`;
  };

  // === GEMINI 2.5 PRO METRIC EXTRACTOR (June 2026 per Jenni) ===
  // Was Claude Haiku 4.5. Swapped to Gemini 2.5 Pro for visual fine-detail:
  // gradations in erythema / PIH / micro-texture that Haiku reads as one
  // bucket. Native-multimodal model — vision is the primary modality, not
  // a bolted-on add. Critically, this is the SAME structured-JSON contract
  // as before, so every downstream consumer (cover quartet, MetricTrends,
  // baseline math) keeps working unchanged.
  //
  // Returns the metricSnapshot object or null on any failure. Caller is
  // expected to fall back to a Haiku JSON re-parse if null is returned.
  // === SENSITIVITY DROPPED (June 2026 per Jenni) ===
  // Sensitivity is a felt-sense / reactive state — stinging, tingling,
  // burning on application. AI photos see visible-sensitivity-markers
  // (telangiectasia, perilesional flush) but not the underlying
  // reactivity. Methodologically muddy as an OUTCOME domain. Moved to
  // user-self-report only (the existing `sensitivity` chip in
  // OBSERVATION_CHIPS_BASE). Legacy logs that already have a
  // sensitivity field stay readable; new logs simply won't have one.
  const GEMINI_METRIC_PROMPT = `Look at this skincare progress photo and rate the visible skin. Reply with ONLY this JSON, no prose, no code fences, no markdown:
{"redness":"<Clear|Low|Mild|Moderate|High>","hydration":"<Plump|Good|Balanced|Dry|Parched>","texture":"<Smooth|Even|Uneven|Rough|Bumpy>","breakouts":"<Clear|Few|Some|Many|Severe>","barrier":"<Strong|Steady|Holding|Compromised|Stripped>"}
Pick the SINGLE most accurate level per metric. Use the exact capitalized word. Output ONLY the JSON object.`;
  const METRIC_KEYS = ['redness', 'hydration', 'texture', 'breakouts', 'barrier'];
  const extractMetricsWithGemini = async (photoB64) => {
    if (!photoB64) return null;
    try {
      const raw = await callGeminiVision(photoB64, GEMINI_METRIC_PROMPT, {
        model: 'gemini-2.5-pro',
        temperature: 0.1,
        maxTokens: 220,
      });
      const cleaned = String(raw || '').replace(/```(?:json)?/gi, '').trim();
      const start = cleaned.indexOf('{');
      const end = cleaned.lastIndexOf('}');
      if (start === -1 || end === -1) return null;
      const snap = JSON.parse(cleaned.slice(start, end + 1));
      // Validate: must have at least 4 of the 6 keys as strings.
      const hits = METRIC_KEYS.filter(k => typeof snap[k] === 'string' && snap[k].length > 0);
      if (hits.length < 4) return null;
      return snap;
    } catch (e) {
      console.warn('[gemini-metrics] failed, caller should fall back:', e?.message);
      return null;
    }
  };

  // === LEGACY PHOTO JOURNAL MODAL ===
  // ⚠️ DO NOT COPY THIS AS A TEMPLATE FOR NEW CHECK-IN WORK.
  //
  // SkinLogModal is the *photo-anchored journal entry* surface — it writes
  // to `logs` (the dated-photo history that powers Compare / Journal /
  // PhotoTimeline), NOT to `regimenLogs`. It still uses the OLD 1-10
  // rating slider (see line ~9555) for backward compatibility with the
  // thousands of historical photo logs already stored at that scale.
  //
  // ============================================================
  // CHECK-IN ENTRY-POINT MANIFEST (Phase 3B, May 2026)
  // ============================================================
  // Three distinct surfaces are conflated under "check-in" in the
  // codebase. Every contributor should match an entry point to the
  // correct row here BEFORE wiring up new UI:
  //
  //   1. CheckInDetailsModal (1-5)  — src/components/CheckInDetailsModal.jsx
  //      Mount: rendered when `checkInDetailsQueue` is non-empty.
  //      Reach: guided capture + bulk upload (`setShowBulkUploadModal(true)`)
  //             populate the queue. NEVER mount this directly elsewhere.
  //      Use for: NEW daily check-ins with photo. THIS IS CANONICAL.
  //
  //   2. SkinLogModal (1-10)        — this function. ⚠️ LEGACY.
  //      Mount: `{showLogModal && <SkinLogModal />}`.
  //      Reach (today, behavior preserved — DO NOT REROUTE WITHOUT
  //      explicit migration design):
  //        - Editing prior log: setEditingLogId(id); setShowLogModal(true)
  //          [Journal entry edit row, PhotoTimeline onEditLog]   ← KEEP (legacy data is 1-10)
  //        - Inline procedure follow-up save                     ← KEEP (writes to logs)
  //        - "Log today's skin" command launcher (Cmd-K)         ← MIGRATE-LATER target
  //        - Journal page "Log today's" / "Take today's photo"
  //          empty-state pills                                   ← MIGRATE-LATER target
  //        - Compare page "Log a photo" pill / empty state       ← MIGRATE-LATER target
  //        - Profile reminders ("How is X doing?" TodayReminder) ← MIGRATE-LATER target
  //      Use for: legacy edit only. NEW intents flagged
  //      "MIGRATE-LATER" should eventually route through (1).
  //
  //   3. TodayRitualModal (no rating) — separate flow entirely.
  //      Mount: `{showCheckInModal && <TodayRitualModal />}`.
  //      Reach: `setShowCheckInModal(true)` from cover, Regimen
  //             Today, etc.
  //      Use for: Edit today's AM/PM regimen (which products were
  //             used). NOT a skin check-in, despite the state name
  //             `showCheckInModal`. Has no rating UI at all.
  //
  // Migration path for the MIGRATE-LATER row (deferred — own phase):
  //   New "Log today's skin" entries → setGuidedCaptureCtx({ intent: 'check_in' })
  //   + setShowGuidedCaptureModal(true) → checkInDetailsQueue
  //   → CheckInDetailsModal (1-5).
  //   Legacy edit entries continue to use SkinLogModal until all
  //   historical 1-10 logs are normalized via normalizeRatingTo5.
  //
  // The audit grep that produced this manifest:
  //   grep -nE 'setShowLogModal\(true\)|setShowCheckInModal\(true\)|setShowCheckInCamera\(true\)|setShowBulkUploadModal\(true\)|checkInDetailsQueue'
  // Re-run when adding new surfaces and update the rows above.
  // === SkinLogModal — extracted to src/components/SkinLogModal.jsx (Wave 5.2 — May 2026) ===
  // The ~1027-line inline definition was lifted out so this file stays readable.
  // App-scope state + setters are passed as explicit props at the render site.
  // The check_build "Extracted modal rendered propless" + "Extracted components
  // have all needed App-scope names bridged via props" guards will fail loudly
  // if anyone re-inlines or drops props here.


  // === ProductModal — extracted to src/components/ProductModal.jsx (Wave 5.1 — May 2026) ===
  // The ~2300-line impl + useMemo wrapper were lifted out so this file stays readable.
  // At module scope the component has stable identity by default, so the old
  // productModalImplRef + useMemo wrapper workaround is unnecessary — plain props.
  // App-scope state + setters are passed as explicit props at the render site.
  // check_build guards will fail if anyone re-inlines or drops props here.

  // === PROCEDURE MODAL ===

  // === REMOVED: RegimenCheckInModal (May 2026 Phase 2 cleanup) ===
  // This was the *old* daily regimen check-in modal — pre-redesign,
  // pre-TodayRitualModal. It was never mounted in the current build
  // (no <RegimenCheckInModal /> anywhere), but the 400-line definition
  // was still sitting in the file, copy-pastable by accident and
  // pretending to be a legitimate flow. Deleted to make TodayRitualModal
  // the unambiguous canonical edit-today surface. If you need the old
  // copy or product-row layout, pull from git history.

  // === TODAY'S RITUAL MODAL (May 2026 Edit-Regimen redesign) ===
  // Cleaner sheet matching Jenni's spec:
  //   - Header: "Edit today" + Save✓ + X (provided by Modal wrapper)
  //   - AM/PM segmented toggle
  //   - Compact numbered rows (no done/check circles): #/bottle/name+type/X
  //   - Two CTAs: [+ Add from Shelf] filled / [+ New Product] outline
  //   - Routine shortcuts: Repeat / Reorder / Clear AM-or-PM
  //   - Why-this-order block REMOVED entirely
  // Embeds an Add-from-Shelf bottom sheet (state at App scope) that overlays
  // the edit sheet for multi-select adds. Closing the shelf returns the user
  // to the still-open regimen sheet so they can keep editing or Save.
  // === TodayRitualModal — extracted to src/components/TodayRitualModal.jsx (Wave 5.3 — May 2026) ===
  // The 720-line inline definition was lifted out so this file stays readable.
  // App-scope state + setters are passed as explicit props at the render site.
  // The check_build "Extracted modal rendered propless" + "Extracted components
  // have all needed App-scope names bridged via props" guards will fail loudly
  // if anyone re-inlines or drops props here.

  // === EVENT MODAL ===

  // === COLOR MODAL ===

  // === API KEY MODAL ===

  // === SUPABASE CONFIG MODAL ===

  // === TODAY'S REGIMEN MODAL ===
  // Shows the user's AM/PM regimen for TODAY only — pulled from the built
  // weekly rotation, NOT every product on the shelf. If no log + no built
  // pattern, surfaces empty state so the user knows to build first.
  // BUG FIX May 2026: previous filter (`p.frequency !== 'pm-only'`) showed
  // EVERY active product unless explicitly tagged pm-only — so a user with
  // 18 products on shelf saw all 18 in their AM list. New filter respects
  // cadence.days for today's DoW + useTimes per slot.
  const TodaysRegimenModal = () => {
    const activeProducts = products.filter(p => !p.endDate);
    const todayDOW = new Date().getDay();
    const todayKey = localDateISO();
    const todayLog = (regimenLogs || []).find(r => r.date === todayKey);
    const productById = Object.fromEntries(activeProducts.map(p => [p.id, p]));
    // Source priority: today's log → built pattern → empty.
    let amProducts, pmProducts;
    if (todayLog) {
      amProducts = (todayLog.amProducts || []).map(id => productById[id]).filter(Boolean);
      pmProducts = (todayLog.pmProducts || []).map(id => productById[id]).filter(Boolean);
    } else if (userHasBuiltPattern(products)) {
      const pat = getProductsForTodayFromPattern(activeProducts, todayDOW);
      amProducts = pat.am;
      pmProducts = pat.pm;
    } else {
      amProducts = [];
      pmProducts = [];
    }
    const hasProducts = amProducts.length > 0 || pmProducts.length > 0;

    // Sample regimens by primary concern — category-level recommendations
    const samples = {
      redness: {
        label: 'Redness / sensitive',
        am: ['Gentle non-foaming cleanser', 'Niacinamide 5%', 'Ceramide moisturizer', 'Mineral SPF 30+ (zinc oxide)'],
        pm: ['Gentle cleanser', 'Centella or beta-glucan calming layer', 'Ceramide moisturizer'],
        note: 'Avoid retinoids and acids during active flare. Reintroduce slowly once skin is calm.',
      },
      dryness: {
        label: 'Dryness',
        am: ['Cream cleanser', 'Hyaluronic acid serum (apply to damp skin)', 'Ceramide-rich moisturizer', 'Mineral SPF 30+'],
        pm: ['Cream cleanser', 'Squalane or oil-based emollient', 'Ceramide moisturizer + occlusive (slugging) for severe dryness'],
        note: 'Reduce hot showers and over-cleansing. Humidifier in low-humidity environments helps more than another product.',
      },
      acne: {
        label: 'Active breakouts',
        am: ['Salicylic acid 2% wash (60-second contact)', 'Niacinamide 5%', 'Lightweight moisturizer', 'Non-comedogenic SPF 30+'],
        pm: ['Salicylic acid wash or gentle cleanser', 'Adapalene 0.1% (or tretinoin if Rx)', 'Light moisturizer'],
        note: 'BPO 2.5% wash 2–3x/week if inflammatory acne. Cortisone injection for stubborn cysts beats any spot treatment.',
      },
      hyperpigmentation: {
        label: 'Dark spots / melasma',
        am: ['Gentle cleanser', 'Vitamin C 15–20%', 'Niacinamide 5%', 'Ceramide moisturizer', 'Tinted mineral SPF (iron oxides for visible-light protection)'],
        pm: ['Gentle cleanser', 'Tranexamic acid 3–5% or alpha arbutin 2%', 'Retinoid (tretinoin or adapalene)', 'Ceramide moisturizer'],
        note: 'Tinted SPF is non-negotiable — visible light drives melasma; untinted SPF doesn\'t block it.',
      },
      antiaging: {
        label: 'Fine lines / photoaging',
        am: ['Gentle cleanser', 'Vitamin C 15–20% (L-ascorbic acid + E + ferulic)', 'Ceramide moisturizer', 'Broad-spectrum SPF 30+'],
        pm: ['Gentle cleanser', 'Tretinoin 0.025–0.05% or adapalene 0.1% (build tolerance gradually)', 'Ceramide-rich moisturizer'],
        note: 'Consistency dominates intensity. Daily sunscreen + nightly retinoid + vitamin C in AM is the four-pillar stack.',
      },
    };
    const concernOpts = Object.keys(samples);
    const active = samples[sampleRegimenConcern] || samples.redness;

    return (
      <Modal eyebrow="Check-in" title="Today's regimen" onClose={() => setShowTodaysRegimen(false)}>
        {hasProducts ? (
          <div className="space-y-6">
            <p className="text-sm font-light italic" style={{color:'var(--ink-soft)'}}>Your active products, organized for AM and PM. Use this as your daily reference.</p>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <div className="flex items-center gap-2 mb-3"><Icon name="Sun" size={14} /><div className="text-[10px] tracking-[0.3em] uppercase" style={{color:'var(--ink-soft)'}}>Morning</div></div>
                {amProducts.length === 0 ? (
                  <p className="text-sm font-light italic" style={{color:'var(--ink-soft)'}}>No AM products yet.</p>
                ) : (
                  <ol className="space-y-2 text-sm" style={{color:'var(--ink)'}}>
                    {amProducts.map((p, i) => (
                      <li key={p.id} className="flex gap-3">
                        <span className="text-[10px] tracking-[0.2em] uppercase mt-1.5 flex-shrink-0" style={{color:'var(--ink-soft)'}}>{i + 1}</span>
                        <div>
                          <div className="font-serif italic text-base" style={{color:'var(--ink)'}}>{p.brand || p.name}</div>
                          {p.brand && p.name && p.brand !== p.name && (
                            <div className="text-[11px]" style={{color:'var(--ink-soft)'}}>{p.name}</div>
                          )}
                          <div className="text-xs font-light" style={{color:'var(--ink-soft)'}}>{p.category}{p.activeIngredients ? ` · ${p.activeIngredients}` : ''}</div>
                        </div>
                      </li>
                    ))}
                  </ol>
                )}
              </div>
              <div>
                <div className="flex items-center gap-2 mb-3"><Icon name="Moon" size={14} /><div className="text-[10px] tracking-[0.3em] uppercase" style={{color:'var(--ink-soft)'}}>Evening</div></div>
                {pmProducts.length === 0 ? (
                  <p className="text-sm font-light italic" style={{color:'var(--ink-soft)'}}>No PM products yet.</p>
                ) : (
                  <ol className="space-y-2 text-sm" style={{color:'var(--ink)'}}>
                    {pmProducts.map((p, i) => (
                      <li key={p.id} className="flex gap-3">
                        <span className="text-[10px] tracking-[0.2em] uppercase mt-1.5 flex-shrink-0" style={{color:'var(--ink-soft)'}}>{i + 1}</span>
                        <div>
                          <div className="font-serif italic text-base" style={{color:'var(--ink)'}}>{p.brand || p.name}</div>
                          {p.brand && p.name && p.brand !== p.name && (
                            <div className="text-[11px]" style={{color:'var(--ink-soft)'}}>{p.name}</div>
                          )}
                          <div className="text-xs font-light" style={{color:'var(--ink-soft)'}}>{p.category}{p.activeIngredients ? ` · ${p.activeIngredients}` : ''}</div>
                        </div>
                      </li>
                    ))}
                  </ol>
                )}
              </div>
            </div>
            <div className="pt-4 border-t flex flex-wrap gap-3 items-center justify-between" style={{borderColor: 'var(--line)'}}>
              <p className="text-xs font-light italic" style={{color:'var(--ink-soft)'}}>Want a tailored AI-ordered routine?</p>
              <button onClick={() => { setShowTodaysRegimen(false); setActiveTab('regimen'); setRegimenView('today'); }} className="text-[10px] tracking-[0.2em] uppercase italic flex items-center gap-1" style={{color:'var(--ink)', borderBottom:'1px dotted var(--ink)'}}>
                Build full routine <Icon name="ArrowRight" size={11} />
              </button>
            </div>
          </div>
        ) : (
          <div className="space-y-5">
            <p className="text-sm font-light italic" style={{color:'var(--ink-soft)'}}>You haven't added products to your shelf yet. Pick a primary concern below to see a defensible category-level starter routine, or add your real products and we'll build around those.</p>
            <div className="flex flex-wrap gap-2">
              {concernOpts.map(c => (
                <button key={c} onClick={() => setSampleRegimenConcern(c)} className="text-[11px] tracking-[0.15em] uppercase px-3 py-1.5 border transition" style={{
                  background: sampleRegimenConcern === c ? 'var(--ink)' : 'transparent',
                  color: sampleRegimenConcern === c ? 'var(--cream)' : 'var(--ink-soft)',
                  borderColor: sampleRegimenConcern === c ? 'var(--ink)' : 'var(--line)'
                }}>{samples[c].label}</button>
              ))}
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
              <div>
                <div className="flex items-center gap-2 mb-3"><Icon name="Sun" size={14} /><div className="text-[10px] tracking-[0.3em] uppercase" style={{color:'var(--ink-soft)'}}>Morning</div></div>
                <ol className="space-y-2.5 text-sm" style={{color:'var(--ink)'}}>
                  {active.am.map((step, i) => (
                    <li key={i} className="flex gap-3">
                      <span className="text-[10px] tracking-[0.2em] uppercase mt-1.5 flex-shrink-0" style={{color:'var(--ink-soft)'}}>{i + 1}</span>
                      <span className="font-serif italic text-base leading-snug">{step}</span>
                    </li>
                  ))}
                </ol>
              </div>
              <div>
                <div className="flex items-center gap-2 mb-3"><Icon name="Moon" size={14} /><div className="text-[10px] tracking-[0.3em] uppercase" style={{color:'var(--ink-soft)'}}>Evening</div></div>
                <ol className="space-y-2.5 text-sm" style={{color:'var(--ink)'}}>
                  {active.pm.map((step, i) => (
                    <li key={i} className="flex gap-3">
                      <span className="text-[10px] tracking-[0.2em] uppercase mt-1.5 flex-shrink-0" style={{color:'var(--ink-soft)'}}>{i + 1}</span>
                      <span className="font-serif italic text-base leading-snug">{step}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
            <div className="border-l-2 pl-4 py-1" style={{borderColor:'var(--ink)'}}>
              <p className="text-xs font-light italic leading-relaxed" style={{color:'var(--ink)'}}>{active.note}</p>
            </div>
            <button onClick={() => { setShowTodaysRegimen(false); setShowProductModal(true); }} className="w-full py-3 tracking-[0.2em] text-[10px] uppercase transition" style={{background:'var(--ink)', color:'var(--cream)'}}>Add your first product</button>
          </div>
        )}
      </Modal>
    );
  };

  // === YOU MODAL (profile — hormonal context, cycle data, color profile) ===
  // (Clinical Skin Profile wizard moved May 2026 to
  // src/components/ProfileModal.jsx — props are passed explicitly from the
  // render call below so the extracted component has no hidden coupling to
  // App scope. Lifted wizard state still lives in App for now to keep the
  // diff minimal; future cleanup can move it inside ProfileModal.)
  // (Removed leftover wizard comment block — see ProfileModal.jsx header)
  // (Comments below describe the original inline wizard; left in place
  // briefly to ease search, will be deleted in a follow-up pass.)
  // Every value persists to localStorage and threads into Counsel + every
  // photo analysis as system context.

  const YouModal = () => {
    const contextOptions = [
      { id: 'cycling', label: 'Menstrual cycle', desc: 'Shows cycle tracker and luteal-phase guidance.' },
      { id: 'post-menopausal', label: 'Post-menopausal', desc: 'Surfaces perimenopause and HRT lessons; hides cycle features.' },
      { id: 'androgen-pattern', label: 'Testosterone-pattern', desc: 'Surfaces androgen-driven skin lessons; hides cycle features.' },
      { id: 'pregnancy', label: 'Pregnancy / breastfeeding', desc: 'Gates contraindicated actives, surfaces pregnancy-safe stack.' },
      { id: 'hormone-therapy', label: 'On hormone therapy', desc: 'Flexible — surfaces relevant lessons by direction.' },
      { id: 'unspecified', label: 'Prefer not to say', desc: 'No filtering applied. All content surfaces.' },
    ];
    const setContext = async (id) => {
      setHormonalContext(id);
      await saveData('hormonalContext', id);
    };
    return (
      <Modal eyebrow="Profile" title="You" onClose={() => setShowYouModal(false)}>
        <div className="space-y-6">
          {/* Skin profile shortcut — opens the full demographic editor (age,
              Fitzpatrick, Monk skin tone, type, conditions, Rx, location)
              that threads into every AI recommendation. */}
          <button
            onClick={() => { setShowYouModal(false); setShowProfileModal(true); }}
            className="w-full flex items-center justify-between gap-3 px-4 py-3 border rounded-sm transition hover:bg-[var(--cream-deep)]"
            style={{borderColor: 'var(--line)', background:'var(--cream)'}}
          >
            <div className="text-left">
              <div className="text-[10px] tracking-[0.22em] uppercase" style={{color:'var(--accent)'}}>Skin Profile</div>
              <div className="text-[12px] italic mt-0.5" style={{color:'var(--ink-soft)'}}>
                {[
                  userProfile.ageBand && `Age ${userProfile.ageBand}`,
                  userProfile.fitzpatrick && `Fitz ${userProfile.fitzpatrick}`,
                  userProfile.monkSkinTone && `MST ${userProfile.monkSkinTone}`,
                  userProfile.skinType && userProfile.skinType,
                  (userProfile.diagnosedConditions?.length || 0) > 0 && `${userProfile.diagnosedConditions.length} condition${userProfile.diagnosedConditions.length === 1 ? '' : 's'}`,
                  (userProfile.currentRx?.length || 0) > 0 && `${userProfile.currentRx.length} Rx`,
                  userProfile.location && userProfile.location,
                ].filter(Boolean).join(' · ') || 'Add age, skin tone, conditions, Rx — feeds every AI read'}
              </div>
            </div>
            <Icon name="ChevronRight" size={14} style={{color:'var(--ink-soft)'}} />
          </button>

          <div>
            <div className="text-[10px] tracking-[0.25em] uppercase mb-2" style={{color:'var(--ink-soft)'}}>Hormonal Context</div>
            <p className="text-xs font-light italic mb-3 leading-relaxed" style={{color:'var(--ink-soft)'}}>This shapes which lessons surface, whether the cycle tracker shows, and how the AI tailors recommendations. The relevant variable for skin is the hormonal milieu, not identity — so trans users on HRT, post-menopausal users, and pregnant users get treated by their actual physiology rather than by an assigned category. Change anytime.</p>
            <div className="space-y-2">
              {contextOptions.map(opt => (
                <button key={opt.id} onClick={() => setContext(opt.id)} className="w-full p-3 text-left border transition" style={{
                  background: hormonalContext === opt.id ? 'var(--ink)' : 'var(--cream-deep)',
                  color: hormonalContext === opt.id ? 'var(--cream)' : 'var(--ink)',
                  borderColor: hormonalContext === opt.id ? 'var(--ink)' : 'var(--line)'
                }}>
                  <div className="text-sm font-medium">{opt.label}</div>
                  <div className="text-xs font-light mt-0.5" style={{opacity: 0.85}}>{opt.desc}</div>
                </button>
              ))}
            </div>
          </div>

          {hormonalContext === 'cycling' && (
            <div className="pt-5 border-t" style={{borderColor: 'var(--line)'}}>
              <div className="text-[10px] tracking-[0.25em] uppercase mb-3" style={{color:'var(--ink-soft)'}}>Cycle Data</div>
              <CycleTracker cycleData={cycleData} setCycleData={setCycleData} saveData={saveData} logs={logs} toast={toast} compact={true} />
            </div>
          )}

          <div className="pt-5 border-t" style={{borderColor: 'var(--line)'}}>
            <div className="flex justify-between items-start mb-2 gap-3 flex-wrap">
              <div>
                <div className="text-[10px] tracking-[0.25em] uppercase" style={{color:'var(--ink-soft)'}}>Color Profile</div>
                {colorProfile?.season || colorProfile?.undertone ? (
                  <p className="text-sm font-light italic mt-1" style={{color:'var(--ink)'}}>
                    {colorProfile.season ? colorProfile.season.replace(/-/g, ' ') : 'Season not set'}
                    {colorProfile.undertone && ` · ${colorProfile.undertone} undertone`}
                  </p>
                ) : (
                  <p className="text-sm font-light italic mt-1" style={{color:'var(--ink-soft)'}}>Not yet analyzed.</p>
                )}
              </div>
              <button onClick={() => { setShowYouModal(false); setShowColorModal(true); }} className="text-[10px] tracking-[0.2em] uppercase italic flex-shrink-0" style={{color:'var(--ink)', borderBottom:'1px dotted var(--ink)'}}>Edit</button>
            </div>
          </div>
        </div>
      </Modal>
    );
  };

  // === SEARCH MODAL (Cmd+K) ===
  const SearchModal = () => {
    const inputRef = useRef();
    useEffect(() => { setTimeout(() => inputRef.current?.focus(), 50); }, []);
    const q = searchQuery.toLowerCase().trim();

    // Action commands (verbs, not nouns) — surfaced at top of palette
    const allCommands = [
      {
        id: 'compare',
        label: 'Compare two entries',
        hint: 'Pick any two journal entries side by side',
        icon: 'Eye',
        keywords: ['compare', 'vs', 'versus', 'side by side', 'progress', 'difference'],
        run: () => { enterCompare(); setShowSearch(false); setSearchQuery(''); },
        available: logs.length >= 2,
      },
    ];
    const commands = allCommands.filter(c => c.available && (!q || c.keywords.some(k => k.includes(q) || q.includes(k)) || c.label.toLowerCase().includes(q)));

    const matches = q ? [
      ...logs.filter(l => l.notes?.toLowerCase().includes(q) || l.area.includes(q) || l.concerns?.some(c => c.toLowerCase().includes(q)) || l.aiAnalysis?.toLowerCase().includes(q)).slice(0, 5).map(l => ({ ...l, _type: 'journal', _label: `${l.date} · ${l.area} · ${l.rating}/10`, _icon: 'Calendar' })),
      ...products.filter(p => p.name?.toLowerCase().includes(q) || p.brand?.toLowerCase().includes(q) || p.activeIngredients?.toLowerCase().includes(q) || p.aiAnalysis?.toLowerCase().includes(q)).slice(0, 5).map(p => ({ ...p, _type: 'product', _label: `${p.brand || ''} · ${p.category}`, _icon: 'Package' })),
      ...procedures.filter(p => p.name?.toLowerCase().includes(q) || p.type.includes(q) || p.notes?.toLowerCase().includes(q) || p.results?.toLowerCase().includes(q)).slice(0, 5).map(p => ({ ...p, _type: 'procedure', _label: `${p.date} · ${p.type}`, _icon: 'Activity' })),
      ...events.filter(e => e.name?.toLowerCase().includes(q) || e.notes?.toLowerCase().includes(q)).slice(0, 5).map(e => ({ ...e, _type: 'event', _label: `${e.date} · ${e.priority} priority`, _icon: 'Star' })),
    ] : [];

    const goToTab = (type) => {
      const map = { journal: 'journal', product: 'regimen', procedure: 'procedures', event: 'events' };
      setActiveTab(map[type]);
      if (type === 'product') setRegimenView('shelf');
      setShowSearch(false);
      setSearchQuery('');
    };

    const totalResults = commands.length + matches.length;

    return (
      <div className="fixed inset-0 z-50 flex items-start justify-center p-4 pt-24" style={{background:'rgba(28,25,23,0.5)', backdropFilter:'blur(4px)'}} onClick={() => setShowSearch(false)}>
        <div onClick={e => e.stopPropagation()} className="rounded-lg max-w-2xl w-full overflow-hidden shadow-2xl" style={{background:'var(--cream)'}}>
          <div className="flex items-center gap-3 px-5 py-4 border-b" style={{borderColor: 'var(--line)'}}>
            <Icon name="Search" size={18} className="" />
            <input autoCapitalize="off" autoCorrect="off" spellCheck={false} ref={inputRef} value={searchQuery} onChange={e => setSearchQuery(e.target.value)} placeholder="Search journal, products, procedures, occasions…" className="flex-1 bg-transparent border-none outline-none text-base font-light italic" style={{color:'var(--ink)'}} />
            <kbd className="text-[10px] tracking-wider px-2 py-1 border rounded" style={{borderColor: 'var(--line)', color:'var(--ink-soft)'}}>ESC</kbd>
          </div>
          <div className="max-h-[60vh] overflow-y-auto">
            {/* Action commands — always at the top when available */}
            {commands.length > 0 && (
              <>
                <div className="px-5 pt-4 pb-2 text-[9px] tracking-[0.3em] uppercase" style={{color:'var(--ink-soft)'}}>Actions</div>
                {commands.map(c => (
                  <button key={c.id} onClick={c.run} className="w-full px-5 py-3 flex items-center gap-3 text-left transition border-b hover:opacity-80" style={{borderColor: 'var(--line)'}}>
                    <div className="w-8 h-8 rounded-sm flex items-center justify-center flex-shrink-0" style={{background:'var(--ink)', color:'var(--cream)'}}>
                      <Icon name={c.icon} size={14} />
                    </div>
                    <div className="flex-1 min-w-0">
                      <div className="font-serif italic text-base truncate" style={{color:'var(--ink)'}}>{c.label}</div>
                      <div className="text-[10px] tracking-[0.15em] uppercase mt-0.5 truncate" style={{color:'var(--ink-soft)'}}>{c.hint}</div>
                    </div>
                    <Icon name="ArrowUpRight" size={12} className="flex-shrink-0" />
                  </button>
                ))}
                {q && matches.length > 0 && (
                  <div className="px-5 pt-4 pb-2 text-[9px] tracking-[0.3em] uppercase" style={{color:'var(--ink-soft)'}}>Results</div>
                )}
              </>
            )}
            {!q && (
              <div className="p-8 text-center">
                <Icon name="Search" size={28} className="mx-auto mb-3 opacity-40" />
                <div className="text-sm font-light italic" style={{color:'var(--ink-soft)'}}>Start typing to search across everything…</div>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-2 mt-6">
                  {[
                    {q:'acne', icon:'AlertCircle'}, {q:'retinol', icon:'Beaker'},
                    {q:'microneedling', icon:'Activity'}, {q:'forehead', icon:'User'}
                  ].map(s => (
                    <button key={s.q} onClick={() => setSearchQuery(s.q)} className="text-[10px] tracking-[0.15em] uppercase border p-2 transition" style={{borderColor: 'var(--line)', color:'var(--ink-soft)'}}>{s.q}</button>
                  ))}
                </div>
              </div>
            )}
            {q && totalResults === 0 && (
              <div className="p-8 text-center font-light italic text-sm" style={{color:'var(--ink-soft)'}}>No matches found.</div>
            )}
            {matches.map((m, i) => (
              <button key={`${m._type}-${m.id}`} onClick={() => goToTab(m._type)} className="w-full px-5 py-3 flex items-center gap-3 text-left transition border-b hover:opacity-80" style={{borderColor: 'var(--line)'}}>
                <div className="w-8 h-8 rounded-sm flex items-center justify-center flex-shrink-0" style={{background:'var(--cream-deep)', color:'var(--ink)'}}>
                  <Icon name={m._icon} size={14} />
                </div>
                <div className="flex-1 min-w-0">
                  <div className="font-serif italic text-base truncate" style={{color:'var(--ink)'}}>{m.name || m.notes?.slice(0, 60) || `${m.area} entry`}</div>
                  <div className="text-[10px] tracking-[0.15em] uppercase mt-0.5 truncate" style={{color:'var(--ink-soft)'}}>{m._type} · {m._label}</div>
                </div>
                <Icon name="ArrowUpRight" size={12} className="flex-shrink-0" />
              </button>
            ))}
          </div>
          <div className="px-5 py-2 text-[9px] tracking-[0.2em] uppercase border-t flex justify-between" style={{borderColor: 'var(--line)', color:'var(--ink-soft)'}}>
            <span>{totalResults} {totalResults === 1 ? 'result' : 'results'}</span>
            <span>⌘K to open · ESC to close</span>
          </div>
        </div>
      </div>
    );
  };

  // === HANDLERS ===
  const handleInsight = async (forcedQuery) => {
    const query = (forcedQuery || insightQuery).trim();
    if (!query) return;
    if (!getApiKey()) { setShowApiKeyModal(true); return; }

    const userMsg = { role: 'user', content: query };
    const newMessages = [...insightMessages, userMsg];
    setInsightMessages(newMessages);
    setInsightQuery('');
    setInsightLoading(true);

    try {
      const skinHistory = logs.slice(0, 30).map(l => `${l.date} | ${l.area} | ${l.rating}/10 | ${l.concerns?.join(',') || '-'} | ${l.notes || ''}`).join('\n');
      // Counsel must reason about ACTUAL routine, not shelf inventory. The shelf is what the
      // user owns; the check-ins + photo-tagged products are what they actually apply.
      // A "what's likely irritating you" question is meaningless if the answer pulls from
      // the unused half of the shelf. We surface lapsed/unused items separately so the AI
      // can still reference them when relevant ("you bought niacinamide but never used it").
      const usage30 = getActualUsage(products, regimenLogs, logs, { windowDays: 30 });
      const procList = procedures.map(p => `${p.date}: ${p.name} (${p.type}) — results: ${p.results || 'n/a'}`).join('\n');
      const cycleContext = cycleData?.periods?.length ? `\n\nCycle data: Last period started ${cycleData.periods[0].date}. Cycle length: ${cycleData.cycleLength || 28} days.` : '';
      const sensList = (sensitivities || []).join(', ') || 'none recorded';

      // Safety preamble — detects sensitive topics in the user's query
      // and layers mandatory caveats on top of the derm voice. See
      // buildSafetyPreamble + SAFETY_TRIGGERS at module scope.
      const safetyPreamble = buildSafetyPreamble(insightQuery);
      const systemPrompt = `${safetyPreamble}You are an educational skincare advisor with dermatology training, grounded in peer-reviewed dermatology literature and the published guidelines of major bodies (AAD, BAD, EADV). You also draw on the practice patterns of leading evidence-based educators when their guidance is well-supported: Dr. Sam Ellis, Dr. Shereene Idriss, Dr. Mona Gohara, Dr. Hadley King, Dr. Andrea Suarez (Dr Dray). This is informational and educational, not a medical diagnosis. You help one specific user with their tracked skin data.

VOICE
- Magazine register, not clinical bullet-list. Editorial Vogue with the rigor of an UpToDate entry.
- Conversational paragraphs. Use bullets only when the user explicitly asks for a list or when listing 4+ specific products/ingredients.
- This is educational skin guidance, not a diagnosis. Stay confident on well-established skincare science — retinoids, SPF, common actives, layering, cadence. When something is severe, painful, infected, rapidly changing, or lesion-like, recommend in-person evaluation by a dermatologist or urgent care explicitly. Acknowledge limits when data is genuinely thin: "with only 6 entries, this is provisional."
- Direct: name the product, the active, the dose, the timing.

EVIDENCE GRADING
When you make a clinical claim, append an evidence grade in brackets if the claim is non-obvious. Use a GRADE-style scale:
- [A] strong RCT evidence + AAD/BAD-recommended (retinoids for photoaging/acne, SPF, AHAs)
- [B] consistent observational/mechanistic evidence (niacinamide for barrier, vitamin C for pigmentation)
- [C] limited evidence, mechanistic plausibility (peptides, exotic actives)
- [expert opinion: name] when the claim leans on a specific clinician's framing — cite them: "as Dr. Sam Ellis frequently emphasizes…"
Don't grade trivial claims like "use sunscreen daily." Grade where the user might want to know how strong the evidence is.

MECHANISM ANCHORING
When recommending an active or explaining a phenomenon, briefly anchor in pathophysiology — one sentence is plenty. "Retinoids accelerate keratinocyte turnover and downregulate AP-1 signaling, which is why both the acne and photoaging effects emerge from the same molecule." This is what separates Counsel from a wellness influencer.

CITATION HOOKS
The app surfaces inline lesson cards when certain ingredients/topics appear in your text. So when relevant, USE the natural names of these ingredients/topics — the chips will auto-render. Worth mentioning: retinol, retinaldehyde, tretinoin, adapalene, niacinamide, vitamin C, AHA/BHA/PHA, salicylic acid, glycolic acid, azelaic acid, ceramides, hyaluronic acid, peptides, sunscreen / SPF, double cleansing, gut-skin axis, hormonal acne, post-procedure care.

CRITICAL CONSTRAINT — ACTUAL vs SHELF
The user OWNS many products but is NOT using all of them. The ACTIVELY USED section below is what's genuinely in their current routine, sourced from daily check-ins + per-photo tagging. Products in OCCASIONAL / LAPSED / UNUSED are owned but not in the working routine — do NOT analyze them as if they are.
- "What's irritating me" / "what's working" / "audit my routine" → reason ONLY from ACTIVELY USED.
- "Should I add X?" / "what should I add?" → may reference owned-but-unused items first ("you already own X but haven't used it in 22 days — start there before buying"). Then suggest new picks if there's a real gap.
- Never assume a shelf product is in their routine.

CYCLE
If hormonal context is "cycling" and cycle data is provided, factor in phase explicitly when relevant: late luteal sebum surge, menstrual barrier sensitivity, follicular tolerance window. Don't force cycle context into every answer — only when asked or when the rating pattern obviously aligns with a phase.

USER'S TRACKED DATA
${buildUserProfileBlock()}
Recent journal entries (last 30):
${skinHistory || 'No entries yet.'}

User-reported sensitivities (avoid-list): ${sensList}

USER'S ACTUAL ROUTINE (last 30 days, from check-ins + photo logs — NOT shelf inventory):
${formatUsageForPrompt(usage30)}

Procedures:
${procList || 'None.'}${cycleContext}`;

      // Model fallback chain — if Sonnet 4.6 isn't available on this key,
      // step down to Sonnet 4.5 dated, then Haiku 4.5 (known working for
      // skin analysis). Each error is surfaced verbatim so the user sees
      // WHY it failed instead of a silent blank.
      const MODEL_CHAIN = ['claude-sonnet-4-5-20250929', 'claude-haiku-4-5-20251001', 'claude-sonnet-4-6'];
      let response = null;
      let lastErr = null;
      let usedModel = null;
      for (const model of MODEL_CHAIN) {
        try {
          console.log('[Counsel] trying model:', model);
          const resp = await fetch("https://api.anthropic.com/v1/messages", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "x-api-key": getApiKey(),
              "anthropic-version": "2023-06-01",
              "anthropic-dangerous-direct-browser-access": "true"
            },
            body: JSON.stringify({
              model,
              max_tokens: 4096,
              system: systemPrompt,
              messages: newMessages.map(m => ({ role: m.role, content: m.content })),
            })
          });
          if (resp.ok) {
            response = resp;
            usedModel = model;
            break;
          }
          // Capture the error for diagnostics, then try next model.
          const errText = await resp.text();
          lastErr = `${model} → HTTP ${resp.status}: ${errText.slice(0, 200)}`;
          console.warn('[Counsel] model failed:', lastErr);
        } catch (e) {
          lastErr = `${model} → network error: ${e.message}`;
          console.warn('[Counsel] model network error:', lastErr);
        }
      }
      if (!response) {
        throw new Error(lastErr || 'All model attempts failed');
      }
      console.log('[Counsel] succeeded with model:', usedModel);
      const data = await response.json();
      const reply = (data.content || []).map(i => i.type === 'text' ? i.text : '').join('\n').trim();
      if (!reply) {
        throw new Error('API returned empty response — check that your key has access to ' + usedModel);
      }
      setInsightMessages(prev => [...prev, { role: 'assistant', content: reply }]);
    } catch (e) {
      console.error('[Counsel] FAILED:', e);
      // Surface the actual error so the user can see what to fix instead of a
      // generic "try again" message that doesn't help at all.
      const detail = e?.message?.slice(0, 300) || 'Unknown error';
      const friendly = /401|invalid_api_key|authentication/i.test(detail)
        ? 'Your Anthropic API key was rejected. Open Settings → API Key and paste a fresh sk-ant-… key from console.anthropic.com.'
        : /404|not_found_error|model/i.test(detail)
        ? `The Claude model isn't available on your key. Tried: ${detail}`
        : /429|rate_limit/i.test(detail)
        ? 'Anthropic rate-limited this key. Wait a minute and try again.'
        : /CORS|fetch|NetworkError/i.test(detail)
        ? 'Network error reaching Anthropic. Check the connection or any browser extensions blocking api.anthropic.com.'
        : `Error: ${detail}`;
      setInsightMessages(prev => [...prev, { role: 'assistant', content: friendly, error: true }]);
    }
    setInsightLoading(false);
  };

  const clearInsightChat = () => {
    setInsightMessages([]);
    setInsightQuery('');
  };

  // === FLOATING LAUNCHER routing ===
  // Free-text routing: only EXPLICIT app-action commands ("log today", "add product") trigger
  // app navigation. Everything else goes straight to Counsel as a chat question.
  // No more fuzzy lesson matching — typing "centella" or any ingredient name now routes to a
  // real Q&A with Claude instead of opening a static lesson modal.
  const handleLauncherSubmit = async (rawInput) => {
    const q = (rawInput || launcherInput).trim();
    if (!q) return;
    const lower = q.toLowerCase();
    setLauncherInput('');

    // Tight, explicit app-action matches only — these CLOSE the launcher
    // and navigate. Everything else becomes a chat that stays INSIDE the
    // launcher (no navigation away).
    if (/^(log|log today|new entry|skin log|today)$/.test(lower)) {
      setShowLauncher(false); setShowCheckInChooser(true); return;
    }
    if (/^(add (a )?product|new product|track (a )?product)$/.test(lower)) {
      setShowLauncher(false); setShowProductModal(true); return;
    }
    if (/^(build (my )?(routine|regimen)|optimize (my )?routine|generate (my )?routine)$/.test(lower)) {
      setShowLauncher(false); setActiveTab('regimen'); setRegimenView('today'); return;
    }
    if (/^(compare|compare photos|then and now)$/.test(lower)) {
      setShowLauncher(false);
      if (logs.length >= 2) enterCompare();
      else setActiveTab('journal');
      return;
    }
    if (/^(my journal|view (the )?(journal|assessment)|see entries|assessment)$/.test(lower)) {
      setShowLauncher(false); setActiveTab('journal'); return;
    }

    // === INLINE CHAT ===
    // Per Jenni: floating chat should NOT navigate to Counsel. Hold the
    // conversation in the launcher itself. We append a user message,
    // call Claude with profile + recent-skin context, then append the
    // assistant reply. Multi-turn: the user can keep asking follow-ups.
    if (!getApiKey()) {
      setLauncherMessages(prev => [
        ...prev,
        { role: 'user', content: q },
        { role: 'assistant', content: '⚙️ Add your Anthropic API key in the key icon (top right) to chat.' },
      ]);
      return;
    }
    const newMsgs = [...launcherMessages, { role: 'user', content: q }];
    setLauncherMessages(newMsgs);
    setLauncherChatLoading(true);
    try {
      // Build a small profile + recent-context preamble. Keeps the
      // launcher chat responsive without dragging in the heavy Counsel
      // history threads.
      const profileBlock = (typeof buildUserProfileBlock === 'function')
        ? buildUserProfileBlock(userProfile || {})
        : '';
      const recent = (logs || []).slice(0, 3).map(l => `- ${l.date}: ${(l.area || 'face').replace(/-/g, ' ')} ${l.rating != null ? l.rating + '/10' : ''}${l.notes ? ' · ' + l.notes.slice(0, 80) : ''}`).join('\n') || 'no recent skin logs';
      // Safety preamble — apply across the floating chat too. User's
      // current question (text) drives topic detection.
      const launcherSafety = buildSafetyPreamble(text);
      const system = `${launcherSafety}You are Frida — an educational, dermatology-informed skincare advisor speaking inside a quick floating chat. Be concise (≤120 words), editorial, helpful. This is informational, not a diagnosis — if the user describes something severe (pain, infection, rapid change, lesion-like), recommend in-person evaluation by a dermatologist or urgent care. Anchor in the user's data when relevant.\n\nUSER PROFILE:\n${profileBlock || '(no clinical profile yet)'}\n\nRECENT SKIN LOGS:\n${recent}`;
      const history = newMsgs.map(m => `${m.role === 'user' ? 'USER' : 'ASSISTANT'}: ${m.content}`).join('\n\n');
      const reply = await callClaude(history, system, null, { model: 'claude-haiku-4-5-20251001', maxTokens: 500, voice: true });
      setLauncherMessages(prev => [...prev, { role: 'assistant', content: reply || 'Sorry — could you ask that another way?' }]);
    } catch (e) {
      setLauncherMessages(prev => [...prev, { role: 'assistant', content: `Couldn't reach Frida: ${(e?.message || 'unknown error').slice(0, 120)}` }]);
    } finally {
      setLauncherChatLoading(false);
    }
  };

  // === PEARLS Q&A — general dermatology teaching, no personal context ===
  const handlePearlsQA = async (forcedQuery) => {
    const query = (forcedQuery || pearlsQAInput).trim();
    if (!query) return;
    if (!getApiKey()) { setShowApiKeyModal(true); return; }

    const userMsg = { role: 'user', content: query };
    const newMessages = [...pearlsQAMessages, userMsg];
    setPearlsQAMessages(newMessages);
    setPearlsQAInput('');
    setPearlsQALoading(true);

    try {
      const lessonTitles = LESSONS.map(l => `- ${l.title}: ${l.excerpt}`).join('\n');
      // Safety preamble — apply to Pearls Q&A too. User's question
      // drives topic detection.
      const pearlsSafety = buildSafetyPreamble(query);
      const systemPrompt = `${pearlsSafety}You are an educational skincare advisor answering general teaching questions about skincare science (informational, not medical diagnosis). Keep answers strictly evidence-based, grounded in peer-reviewed research and AAD/dermatology society guidelines. State the level of evidence (strong/moderate/limited) when claims are contested. Cite mechanisms of action where they clarify the answer. For severe symptoms (pain, infection, rapid change, lesion-like), recommend in-person dermatologist or urgent care evaluation.

This is a teaching mode, NOT personal advice. Do not give product recommendations tailored to a specific person — refer the user to "Counsel" if they want personalized guidance. Do not invent citations. If the question is outside dermatology or beyond reliable evidence, say so.

For reference, the app already has these in-house lessons (do not contradict them, and prefer pointing to them when relevant):
${lessonTitles}

Use clean prose, short paragraphs, sparing bold for key terms.`;

      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-api-key": getApiKey(), "anthropic-version": "2023-06-01", "anthropic-dangerous-direct-browser-access": "true" },
        body: JSON.stringify({
          model: "claude-sonnet-4-6",
          max_tokens: 4096,
          system: systemPrompt,
          messages: newMessages.map(m => ({ role: m.role, content: m.content })),
        })
      });
      if (!response.ok) throw new Error(await response.text());
      const data = await response.json();
      const reply = data.content.map(i => i.type === 'text' ? i.text : '').join('\n');
      setPearlsQAMessages([...newMessages, { role: 'assistant', content: reply }]);
    } catch (e) {
      setPearlsQAMessages([...newMessages, { role: 'assistant', content: 'Unable to answer right now. Try again.', error: true }]);
    }
    setPearlsQALoading(false);
  };

  const clearPearlsQA = () => {
    setPearlsQAMessages([]);
    setPearlsQAInput('');
  };

  const handleMakeup = async (forcedQuery) => {
    const query = (forcedQuery || makeupQuery).trim();
    if (!query) return;
    if (!getApiKey()) { setShowApiKeyModal(true); return; }

    const userMsg = { role: 'user', content: query };
    const newMessages = [...makeupMessages, userMsg];
    setMakeupMessages(newMessages);
    setMakeupQuery('');
    setMakeupLoading(true);

    try {
      let colorContext = 'No color analysis on file.';
      if (colorProfile) {
        const userInfo = `User self-reported: Season: ${colorProfile.season || 'unknown'}, Skin tone: ${colorProfile.skinTone || 'unknown'}, Undertone: ${colorProfile.undertone || 'unknown'}, Eye: ${colorProfile.eyeColor || 'unknown'}, Hair: ${colorProfile.hairColor || 'unknown'}.`;
        const aiInfo = colorProfile.aiAnalysis ? `\n\nAI-verified analysis from photo:\n${colorProfile.aiAnalysis.fullText}` : '';
        colorContext = userInfo + aiInfo;
      }

      const systemPrompt = `You are a professional makeup artist trained in seasonal color analysis (12-season system). Give evidence-based, specific recommendations. Suggest named drugstore and high-end products where helpful. Be concrete about hex/color families. If there's both a self-reported and AI-verified color analysis and they differ, weigh the AI photo analysis more heavily but acknowledge any discrepancy briefly. Keep responses focused but complete — don't artificially shorten if depth is warranted.

USER'S COLOR PROFILE:
${colorContext}`;

      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-api-key": getApiKey(),
          "anthropic-version": "2023-06-01",
          "anthropic-dangerous-direct-browser-access": "true"
        },
        body: JSON.stringify({
          model: "claude-sonnet-4-6",
          max_tokens: 4096,
          system: systemPrompt,
          messages: newMessages.map(m => ({ role: m.role, content: m.content })),
        })
      });
      if (!response.ok) throw new Error(await response.text());
      const data = await response.json();
      const reply = data.content.map(i => i.type === 'text' ? i.text : '').join('\n');
      setMakeupMessages(prev => [...prev, { role: 'assistant', content: reply }]);
    } catch (e) {
      console.error('Makeup error:', e);
      setMakeupMessages(prev => [...prev, { role: 'assistant', content: 'Unable to generate response. Please try again.', error: true }]);
    }
    setMakeupLoading(false);
  };

  const clearMakeupChat = () => {
    setMakeupMessages([]);
    setMakeupQuery('');
  };

  // === DEEP PRODUCT ANALYSIS ===
  // Acts as a pharmacist + dermatologist combo. Returns sectioned output:
  // MECHANISM (what the actives do biochemically), EVIDENCE (clinical research/trials),
  // REVIEWS (what derms / science-backed reviewers say), CONFLICTS (interactions w/ other
  // active products), ALTERNATIVES (one cheaper + one similar-or-higher with rationale).
  // The structure is parsed by the shelf-card renderer for sectioned display.
  const assessProduct = async (product, opts = {}) => {
    if (!getApiKey()) { setShowApiKeyModal(true); return; }
    setAssessingProduct(product.id);
    try {
      // Conflict check should reflect ACTUAL use — not shelf inventory.
      const _uAssess = getActualUsage(products, regimenLogs, logs, { windowDays: 30 });
      const otherActives = _uAssess.actuallyUsed.filter(u => u.product.id !== product.id).length > 0
        ? _uAssess.actuallyUsed.filter(u => u.product.id !== product.id).map(u => `${u.product.name}: ${u.product.activeIngredients || 'unknown'} (used ${u.amCount}× AM, ${u.pmCount}× PM in last 30d)`).join('; ')
        : 'no other products in active use';
      // diversitySeed lets the user regenerate alternatives and get genuinely different
      // suggestions instead of the same two products on every run.
      const diversitySeed = opts.diversitySeed || '';
      const diversityNote = diversitySeed
        ? `\n\nDIVERSITY INSTRUCTION: This is a re-roll — DO NOT repeat any of these previously suggested alternatives: ${diversitySeed}. Pick fresh alternatives this round.`
        : '';
      const prompt = `You are an educational skincare advisor with dermatology and pharmacology training. Brief a colleague on this product. Lean on actual clinical data. This is informational, not a medical diagnosis.

Product: ${product.name} by ${product.brand || 'unknown brand'}
Category: ${product.category || 'unknown'}
Active Ingredients: ${product.activeIngredients || 'identify from product name'}
Main Ingredients: ${product.mainIngredients || 'not listed'}
Frequency: ${product.frequency || 'unknown'}
User notes: ${product.notes || 'none'}

User's other ACTUALLY USED active products: ${otherActives}${diversityNote}

CRITICAL OUTPUT RULES — read carefully and enforce strictly:
• Use "MECHANISM:" "EVIDENCE:" "ALTERNATIVES:" as line-start labels — exactly these three sections, nothing else.
• HARD WORD CAP: MECHANISM ≤ 30 words. EVIDENCE ≤ 30 words. Count your words. If you exceed, rewrite shorter — do not output more than 30 words per section under any circumstance. Brevity matters more than completeness; the user can ask for detail later.
• ONE SENTENCE MAX per section. No multi-paragraph essays. No bullet points inside MECHANISM or EVIDENCE.
• Do NOT mention alternatives, cheaper options, or other product names in MECHANISM or EVIDENCE — those two sections are about THIS product only. All alternative recommendations live ONLY inside the ALTERNATIVES block.
• Do NOT use markdown bold (**text**), italics, or section sub-headers. Plain prose only inside each section.
• Do not add headings, dashes, or extra commentary outside the format.

Format response EXACTLY as:

MECHANISM: [ONE sentence, max 30 words. Pathway-level: what the actives DO biochemically (e.g. "tyrosinase inhibition", "MMP suppression"). Cite [A]/[B]/[C] grade. Reject any output longer than 30 words.]

EVIDENCE: [ONE sentence, max 30 words. Best clinical trial for this active at this %: design + effect size. Honest if evidence is thin or in-vitro only. Reject any output longer than 30 words.]

ALTERNATIVES:
1. CHEAPER | [Brand + product name] | ~$[USD] | [matching active(s)] | [≤12 words why it's a defensible swap]
2. SIMILAR-OR-HIGHER | [Brand + product name] | ~$[USD] | [matching active(s)] | [≤12 words why it's a defensible swap]`;
      const result = await callClaude(prompt, '', null, { voice: true });
      setProductAssessment({...productAssessment, [product.id]: result});
      // Also persist to the product itself
      const updated = products.map(p => p.id === product.id ? { ...p, aiAnalysis: result } : p);
      setProducts(updated);
      await saveData('products', updated);
    } catch (e) {
      if (!e.message.includes('API key')) setProductAssessment({...productAssessment, [product.id]: 'Unable to assess. Try again.'});
    }
    setAssessingProduct(null);
  };

  // === OFF-SHELF ASSESSOR ===
  // Parallel to assessProduct but for items NOT on the user's shelf (the
  // suggested-matches drawer pulls from POPULAR_PRODUCTS, which have no id).
  // Uses `brand|name` as the cache key so re-tapping the same card is
  // instant. Same Claude prompt + MECHANISM/EVIDENCE/ALTERNATIVES contract
  // as the shelf path — the renderer in the drawer card can re-use the
  // shelf row's parser without modification.
  const offShelfKey = (p) => `${(p?.brand || '').toLowerCase()}|${(p?.name || '').toLowerCase()}`;
  const assessOffShelfProduct = async (p) => {
    if (!getApiKey()) { setShowApiKeyModal(true); return; }
    const key = offShelfKey(p);
    if (!key || key === '|') return;
    // Already cached or already running — bail
    if (offShelfAssessment[key]) return;
    if (offShelfAssessing === key) return;
    setOffShelfAssessing(key);
    try {
      const prompt = `You are an educational skincare advisor with dermatology and pharmacology training. Brief a colleague on this product. Lean on actual clinical data. This is informational, not a medical diagnosis.

Product: ${p.name} by ${p.brand || 'unknown brand'}
Category: ${p.category || 'unknown'}
Active Ingredients: ${p.actives || p.activeIngredients || 'identify from product name'}
Main Ingredients: ${p.main || p.mainIngredients || 'not listed'}

CRITICAL OUTPUT RULES — read carefully and enforce strictly:
• Use "MECHANISM:" "EVIDENCE:" "ALTERNATIVES:" as line-start labels — exactly these three sections, nothing else.
• HARD WORD CAP: MECHANISM ≤ 30 words. EVIDENCE ≤ 30 words. Count your words. If you exceed, rewrite shorter — do not output more than 30 words per section under any circumstance. Brevity matters more than completeness; the user can ask for detail later.
• ONE SENTENCE MAX per section. No multi-paragraph essays. No bullet points inside MECHANISM or EVIDENCE.
• Do NOT mention alternatives, cheaper options, or other product names in MECHANISM or EVIDENCE — those two sections are about THIS product only. All alternative recommendations live ONLY inside the ALTERNATIVES block.
• Do NOT use markdown bold (**text**), italics, or section sub-headers. Plain prose only inside each section.
• Do not add headings, dashes, or extra commentary outside the format.

Format response EXACTLY as:

MECHANISM: [ONE sentence, max 30 words. Pathway-level: what the actives DO biochemically (e.g. "tyrosinase inhibition", "MMP suppression"). Cite [A]/[B]/[C] grade. Reject any output longer than 30 words.]

EVIDENCE: [ONE sentence, max 30 words. Best clinical trial for this active at this %: design + effect size. Honest if evidence is thin or in-vitro only. Reject any output longer than 30 words.]

ALTERNATIVES:
1. CHEAPER | [Brand + product name] | ~$[USD] | [matching active(s)] | [≤12 words why it's a defensible swap]
2. SIMILAR-OR-HIGHER | [Brand + product name] | ~$[USD] | [matching active(s)] | [≤12 words why it's a defensible swap]`;
      const result = await callClaude(prompt, '', null, { voice: true });
      setOffShelfAssessment(prev => ({ ...prev, [key]: result }));
    } catch (e) {
      if (!e.message?.includes('API key')) {
        setOffShelfAssessment(prev => ({ ...prev, [key]: 'Unable to assess. Try again.' }));
      }
    }
    setOffShelfAssessing(null);
  };

  // Re-roll just the alternatives, keeping the existing analysis. Captures the names of
  // the two current alternatives and instructs the AI not to suggest them again.
  const regenerateProductAlternatives = async (product) => {
    if (!getApiKey()) { setShowApiKeyModal(true); return; }
    const existing = productAssessment[product.id] || product.aiAnalysis || '';
    // Mine product names from the existing ALTERNATIVES section so the diversity
    // instruction is concrete: extract the field after `| ` between the price column
    // and the active(s) column, falling back to the entire alt line if the regex misses.
    const altLines = (existing.match(/^\s*[12]\.\s*(?:CHEAPER|SIMILAR-OR-HIGHER)\s*\|\s*([^|]+)\|/gmi) || [])
      .map(l => l.replace(/^\s*[12]\.\s*(?:CHEAPER|SIMILAR-OR-HIGHER)\s*\|\s*/i, '').replace(/\|.*$/, '').trim())
      .filter(Boolean);
    await assessProduct(product, { diversitySeed: altLines.join(' / ') || 'previous attempt' });
    toast('Fresh alternatives ✨');
  };

  const deleteLog = async (id) => { const u = logs.filter(l => l.id !== id); setLogs(u); await saveData('logs', u); };
  const deleteProduct = async (id) => {
    const u = products.filter(p => p.id !== id);
    setProducts(u);
    await saveData('products', u);
    // Inputs to AI recommendations changed → trigger reactive regen.
    setCoverRoutineRebuildToken(t => t + 1);
  };
  const deleteProcedure = async (id) => { const u = procedures.filter(p => p.id !== id); setProcedures(u); await saveData('procedures', u); };
  const updateProcedure = async (id, updates) => {
    const u = procedures.map(p => p.id === id ? { ...p, ...updates } : p);
    setProcedures(u);
    await saveData('procedures', u);
  };
  const deleteEvent = async (id) => { const u = events.filter(e => e.id !== id); setEvents(u); await saveData('events', u); };

  // === STYLES (inline tag substitutions) ===
  const styledInput = {
    background: 'rgba(255, 250, 243, 0.96)',
    borderColor: 'rgba(90, 51, 38, 0.34)',
    color: 'var(--ink)',
    boxShadow: 'inset 0 0 0 1px rgba(135, 72, 50, 0.08)'
  };
  const styledPrimaryBtn = { background: 'linear-gradient(135deg, #3A281F, #2A1E19)', color: 'var(--cream)' };

  // === STATS ===
  const avgRating = logs.length ? (logs.reduce((s, l) => s + +l.rating, 0) / logs.length).toFixed(1) : '—';
  const recent7 = logs.slice(0, 7);
  const recent7Avg = recent7.length ? (recent7.reduce((s, l) => s + +l.rating, 0) / recent7.length).toFixed(1) : '—';
  const trend = logs.length >= 14 ? (() => {
    const last7 = logs.slice(0, 7).reduce((s, l) => s + +l.rating, 0) / 7;
    const prev7 = logs.slice(7, 14).reduce((s, l) => s + +l.rating, 0) / 7;
    return (last7 - prev7).toFixed(1);
  })() : null;

  // Streak calculation: consecutive days of active use, working backward from today.
  // "Active use" = any log, regimen check-in, or procedure logged on that date.
  // Today is included if there's any activity OR if it's the start of a new day after a streak.
  const calcStreak = () => {
    const dates = new Set([
      ...logs.map(l => l.date),
      ...(regimenLogs || []).map(r => r.date),
      ...(procedures || []).map(p => p.date),
    ]);
    if (dates.size === 0) return 0;
    let streak = 0;
    let d = new Date();
    while (dates.has(localDateISO(d))) {
      streak++;
      d.setDate(d.getDate() - 1);
    }
    return streak;
  };
  const streak = calcStreak();
  const todayStr = localDateISO();
  const loggedToday = logs.some(l => l.date === todayStr);

  // === INITIALIZE SKIN LOG FORM WHEN MODAL OPENS ===
  // Seeds skinLogForm from editingLog or fresh defaults. Reset to null in onClose.
  // Ref is kept in sync with state so handleSubmit always has a valid object to read.
  useEffect(() => {
    if (!showLogModal) return;
    if (skinLogForm) return; // already seeded
    let seed;
    if (editingLogId) {
      const l = logs.find(ll => ll.id === editingLogId);
      if (l) {
        seed = {
          date: l.date,
          area: l.area || 'full-face',
          rating: l.rating || 5,
          notes: l.notes || '',
          concerns: l.concerns || [],
          photo: l.photo || null,
          photoPath: l.photoPath || null,
          ratingExplanation: l.ratingExplanation || null,
          suggestedRating: l.suggestedRating || null,
          usedProducts: l.usedProducts || [],
          usedTags: l.usedTags || [],
        };
      }
    } else {
      seed = {
        date: localDateISO(),
        area: 'full-face', rating: 5, notes: '', concerns: [], photo: null,
        ratingExplanation: null, suggestedRating: null,
        usedProducts: [], usedTags: [],
      };
    }
    if (seed) {
      skinLogFormRef.current = seed;
      setSkinLogForm(seed);
    }
  }, [showLogModal, editingLogId]);

  // === INITIALIZE PRODUCT FORM WHEN MODAL OPENS ===
  // ProductModal recreates each App render, which would wipe local form state.
  // We now keep form state at App scope; this effect seeds it the first time the
  // modal opens (or when switching into edit mode).
  // === Defensive reset when ProductModal closes ===
  // Even if the close handler didn't run cleanly (e.g. user tapped backdrop
  // mid-keyboard, browser navigation, etc.), re-opening should ALWAYS land
  // on the hub stage. This guarantees the next open isn't stuck in manual /
  // brand / scan from a previous session.
  useEffect(() => {
    if (showProductModal) return;
    setProductEntryMode('choose');
    setProductBrandSelected(null);
    setProductBrandSearch('');
    setProductBrandCatFilter('all');
  }, [showProductModal]);

  // === BUILD > ADD A PRODUCT — intercept ProductModal close ===
  // When the user came in via the "Add new" path in the Build add-product
  // sheet, we want to route any newly-added products into the slot proposer
  // (suggestScheduleDays + buildSmartRationale) instead of just landing them
  // on the shelf cold. Diffs product ids captured before the modal opened.
  useEffect(() => {
    if (showProductModal) return;
    if (!buildPendingAdd) return;
    const prior = buildAddPriorIds || new Set();
    const newIds = (products || []).filter(p => !prior.has(p.id)).map(p => p.id);
    setBuildPendingAdd(false);
    setBuildAddPriorIds(null);
    if (newIds.length === 0) {
      // User closed ProductModal without saving — just clear pending state.
      // Do NOT open the inline sheet (chooser stage has no UI now, would
      // render an empty box with only a Close button).
      setBuildAddSheet(false);
      setBuildAddStage('chooser');
      setBuildAddProposal(null);
      setBuildAddQueue([]);
      return;
    }
    setBuildAddQueue(newIds);
    setBuildAddStage('propose');
    setBuildAddSheet(true);
  }, [showProductModal]);

  // === BUILD > ADD A PRODUCT — auto-compute proposal when queue head changes ===
  useEffect(() => {
    if (buildAddStage !== 'propose') return;
    if (!buildAddQueue || buildAddQueue.length === 0) return;
    const head = buildAddQueue[0];
    if (buildAddProposal && buildAddProposal.productId === head) return;
    const product = (products || []).find(p => p.id === head);
    if (!product) {
      // Skip stale id
      setBuildAddQueue(q => q.slice(1));
      return;
    }
    // Build the existing pattern from all OTHER active products
    const existingPattern = {};
    for (let d = 0; d < 7; d++) existingPattern[d] = [];
    for (const p of (products || [])) {
      if (!p || p.id === product.id || p.endDate) continue;
      const fam = detectActiveFamily(p.activeIngredients || '');
      if (!fam) continue;
      const days = productCadenceDays(p);
      for (const d of days) {
        if (!existingPattern[d].includes(fam)) existingPattern[d].push(fam);
      }
    }
    const fam = detectActiveFamily(product.activeIngredients || '');
    // Family → default frequency
    const freq = (() => {
      if (!fam) return 7;
      if (['spf','niacinamide','ceramide','panthenol','centella','humectant'].includes(fam)) return 7;
      if (['retinoid','aha','bha'].includes(fam)) return 3;
      if (fam === 'vitc') return 5;
      return 3;
    })();
    const result = suggestScheduleDays({ newActiveFamily: fam, frequency: freq, existingPattern });
    // Family → AM/PM slot bias
    const slot = (fam === 'spf' || fam === 'vitc') ? 'am'
               : (fam === 'retinoid' || fam === 'aha' || fam === 'bha') ? 'pm'
               : 'pm';
    setBuildAddProposal({ productId: head, days: result.days, rationale: result.explanation, slot, family: fam });
  }, [buildAddStage, buildAddQueue, products]);

  useEffect(() => {
    if (!showProductModal) return;
    if (productForm) return; // already populated
    if (editingProductId) {
      const p = products.find(pp => pp.id === editingProductId);
      if (p) {
        setProductForm({
          name: p.name || '',
          brand: p.brand || '',
          category: p.category || 'serum',
          startDate: p.startDate || '',
          endDate: p.endDate || '',
          activeIngredients: p.activeIngredients || '',
          mainIngredients: p.mainIngredients || '',
          tags: p.tags || [],
          concerns: p.concerns || [],
          useDays: p.useDays || [0,1,2,3,4,5,6],
          useTimes: p.useTimes || ['am','pm'],
          frequency: p.frequency || 'daily',
          notes: p.notes || '',
          photo: p.photo || null,
          photoPath: p.photoPath || null,
          status: p.status || 'active',
        });
      }
    } else {
      setProductForm({
        name: '', brand: '', category: 'serum', startDate: '',
        endDate: '', activeIngredients: '', mainIngredients: '', tags: [], concerns: [],
        // useTimes starts EMPTY so the user must intentionally tap Morning
        // or Evening for new products (no silent auto-pick).
        useDays: [0,1,2,3,4,5,6], useTimes: [],
        frequency: 'daily', notes: '', photo: null, status: 'active'
      });
    }
  }, [showProductModal, editingProductId]);

  // === AUTO-REBUILD COVER ROUTINE ===
  // Watches the rebuild token. When bumped (by modal submit / new photo log), if a routine
  // was previously built, regenerate it against the latest evidence. Skipped on initial mount
  // so it doesn't fire when state hydrates from storage.
  const skipFirstCoverRebuildRef = useRef(true);
  useEffect(() => {
    if (skipFirstCoverRebuildRef.current) {
      skipFirstCoverRebuildRef.current = false;
      return;
    }
    if (!coverRoutine) return; // only refresh if user has built one
    if (!buildCoverRoutineRef.current) return; // dashboard hasn't rendered yet
    // T4 fix (May 31 2026): pass a fresh snapshot of the inputs so the
    // closure inside buildCoverRoutine (captured at HomeDashboard's last
    // render) can't go stale when the user edits these fields while
    // looking at a non-Home tab. The dashboard might not have re-rendered
    // since the edits, so its closure would still hold the old arrays.
    buildCoverRoutineRef.current({ products, userConcerns, sensitivities, userProfile });
  }, [coverRoutineRebuildToken]);

  // === STALE-INPUT INVALIDATION FOR COVER ROUTINE ===
  // The Cover Recommended + Suggested Matches read from userConcerns,
  // favoriteProducts, sensitivities, and high-signal userProfile fields.
  // Without these effects, changing those inputs left the cover surface
  // frozen on its previous build. Bump the rebuild token so the watcher
  // above (which respects the skipFirstCoverRebuildRef gate on initial
  // mount) regenerates downstream.
  //
  // COVERAGE POLICY (May 30 2026 — Pattern B): each field that the
  // buildCoverRoutine prompt reads MUST have either a useEffect here OR
  // every setter call site must wrap through useTrackedSetter. We prefer
  // the useEffect approach because it catches setter call sites that
  // bypass the wrapper (e.g. Supabase hydration, sign-out resets, modal
  // forms) without requiring discipline at every new call site.
  // Bug #11 fix (May 2026): array-typed deps thrash a paid Claude
  // call. setUserProfile(prev => ({...prev})) (and equivalent spreads
  // on userConcerns / favoriteProducts / sensitivities) return new
  // array references even when contents are identical, which used to
  // bump the rebuild token and re-trigger buildCoverRoutine on every
  // unrelated profile spread. Compare by JSON content signature so
  // identical content is a no-op.
  const userConcernsSig = useMemo(
    () => JSON.stringify(userConcerns || []),
    [userConcerns]
  );
  const favoriteProductsSig = useMemo(
    () => JSON.stringify(favoriteProducts || []),
    [favoriteProducts]
  );
  const sensitivitiesSig = useMemo(
    () => JSON.stringify(sensitivities || []),
    [sensitivities]
  );
  const currentRxSig = useMemo(
    () => JSON.stringify(userProfile?.currentRx || []),
    [userProfile?.currentRx]
  );
  // T6 fix (May 31 2026): four separate token-bumping useEffects were each
  // firing setCoverRoutineRebuildToken(v => v + 1) independently. A single
  // profile save that touched (e.g.) barrierScale + currentRx fired two of
  // them in one tick → token bumped twice → the watcher at ~line 9685 ran
  // twice → two paid Claude calls for one logical change. Coalesced into a
  // single combined-sig + single useEffect so multiple signal changes in
  // the same render collapse to one bump.
  //
  // Sensitivities (allergens, intolerances, rosacea/eczema flags) directly
  // change which actives the routine can recommend — bump on any change.
  //
  // userProfile is wide (~30 fields) and many edits are cosmetic (display
  // name, theme). Bump ONLY when high-signal fields the prompt reads
  // actually change — barrierScale, pregnancyStatus, currentRx (Rx list),
  // and hormonalContext. Watching the whole object would thrash the
  // dashboard on every wizard keystroke.
  const coverRoutineRebuildSig = useMemo(
    () => `${userConcernsSig}|${favoriteProductsSig}|${sensitivitiesSig}|${currentRxSig}|${userProfile?.barrierScale ?? ''}|${userProfile?.pregnancyStatus ?? ''}|${userProfile?.hormonalContext ?? ''}`,
    [userConcernsSig, favoriteProductsSig, sensitivitiesSig, currentRxSig, userProfile?.barrierScale, userProfile?.pregnancyStatus, userProfile?.hormonalContext]
  );
  useEffect(() => {
    setCoverRoutineRebuildToken(v => v + 1);
  }, [coverRoutineRebuildSig]);

  // === STALE ANALYZING CLEANUP ===
  // Two-pronged self-heal:
  // (1) On boot, clear any analyzing:true flags loaded from storage — these
  //     are guaranteed stale (a real in-flight call wouldn't survive a reload).
  // (2) Per-log freshness watchdog: each in-flight analysis is tagged with
  //     `analyzingStartedAt` timestamp. A 30s interval scans for any flag
  //     older than 120s and forces it to false. This catches hung connections,
  //     swallowed errors, or browser-suspend-while-tab-was-backgrounded states
  //     that callClaude's AbortController didn't clean up.
  const staleCleanedRef = useRef(false);
  useEffect(() => {
    if (staleCleanedRef.current) return;
    if (!user || !Array.isArray(logs) || logs.length === 0) return;
    staleCleanedRef.current = true;
    const stale = logs.filter(l => l.analyzing);
    if (stale.length === 0) return;
    console.log('[StaleClean:boot] clearing analyzing flag on', stale.length, 'logs:', stale.map(l => l.id));
    setLogs(prev => {
      const next = prev.map(l => l.analyzing ? { ...l, analyzing: false, analyzingStartedAt: undefined } : l);
      saveData('logs', next);
      return next;
    });
  }, [user?.id, logs.length]);
  // Recurring watchdog — runs every 10s while the app is open. Tightened
  // from 30s so a stuck spinner unsticks within seconds, not minutes.
  // T2 fix (May 31 2026): keyed on `[user?.id]` instead of `[logs]` so the
  // interval is stable across log mutations (was tearing down + rebuilding
  // on every save, and racing the older 90s sibling above). Fresh logs are
  // read through a ref synced every render.
  const watchdogLogsRef = useRef(logs);
  useEffect(() => { watchdogLogsRef.current = logs; }, [logs]);
  useEffect(() => {
    const id = setInterval(() => {
      const now = Date.now();
      // Watchdog window dropped from 120s → 45s. The per-call timeout in
      // callClaude is 20s now, so a complete analysis (2 parallel calls)
      // should never legitimately take more than ~25s. If a log still has
      // analyzing:true after 45s, something escaped the try/catch — force
      // it clear so the spinner unsticks.
      const currentLogs = watchdogLogsRef.current || [];
      const stuck = currentLogs.filter(l => l.analyzing && l.analyzingStartedAt && (now - l.analyzingStartedAt) > 45000);
      if (stuck.length === 0) return;
      console.warn('[StaleClean:watchdog] forcing analyzing=false on', stuck.length, 'logs older than 45s');
      setLogs(prev => {
        const next = prev.map(l => stuck.find(s => s.id === l.id) ? { ...l, analyzing: false, analyzingStartedAt: undefined } : l);
        saveData('logs', next);
        return next;
      });
    }, 10000);
    return () => clearInterval(id);
  }, [user?.id]);

  // === BACKFILL metric snapshots for any log missing them ===
  // Catches:
  //   (a) Legacy logs from before the structured-metrics prompt landed
  //   (b) Fresh logs whose parallel analysis returned bullets but the
  //       metrics call failed for any reason (network, timeout, etc.)
  // Per-log attempt set prevents infinite retry loops if Haiku can't
  // produce a valid snapshot for a particular photo. Each log gets
  // at most 1 backfill attempt per session.
  const metricBackfillTriedRef = useRef(new Set());
  useEffect(() => {
    if (!getApiKey()) return;
    if (!Array.isArray(logs) || logs.length === 0) return;
    const targets = logs
      .filter(l => (l.photo || l.photoPath) && !l.metricSnapshot && !l.analyzing)
      .filter(l => !metricBackfillTriedRef.current.has(l.id))
      .slice(0, 3); // cap to most recent 3 per pass — avoids quota burn
    if (targets.length === 0) return;
    targets.forEach(l => metricBackfillTriedRef.current.add(l.id));
    (async () => {
      for (const l of targets) {
        try {
          let photoB64 = l.photo;
          if (!photoB64 && l.photoPath) photoB64 = await fetchPhotoAsBase64(l.photoPath);
          if (!photoB64) continue;
          // Gemini 2.5 Pro first (better visual fine-detail). Haiku JSON-only fallback
          // if Gemini fails or returns invalid JSON. Both write the same metricSnapshot
          // shape so downstream consumers don't care which model ran.
          let snap = await extractMetricsWithGemini(photoB64);
          if (!snap) {
            const snapPrompt = `Look at this skincare progress photo and rate the visible skin. Reply with ONLY this JSON, no prose, no code fences:
{"redness":"<Clear|Low|Mild|Moderate|High>","hydration":"<Plump|Good|Balanced|Dry|Parched>","texture":"<Smooth|Even|Uneven|Rough|Bumpy>","breakouts":"<Clear|Few|Some|Many|Severe>","barrier":"<Strong|Steady|Holding|Compromised|Stripped>"}
Pick the single most accurate level per metric. Use the exact capitalized word.`;
            const snapRaw = await callClaude(snapPrompt, '', photoB64, { model: 'claude-haiku-4-5-20251001', maxTokens: 200 });
            const cleaned = snapRaw.replace(/```(?:json)?/g, '').trim();
            const start = cleaned.indexOf('{');
            const end = cleaned.lastIndexOf('}');
            if (start === -1 || end === -1) continue;
            snap = JSON.parse(cleaned.slice(start, end + 1));
          }
          if (!snap) continue;
          setLogs(prev => {
            const next = prev.map(x => x.id === l.id ? { ...x, metricSnapshot: snap } : x);
            saveData('logs', next);
            return next;
          });
        } catch (e) {
          console.warn('[metric-backfill] log', l.id, e.message);
        }
      }
    })();
  }, [user?.id, logs.length]);

  // === RETRY LOG AI ANALYSIS ===
  // Re-runs the per-photo journal analysis when the original background call failed (or when
  // the user wants a fresh take). Verbose logging + loud error toasts so silent failures
  // never look like the UI is hung.
  const retryLogAnalysis = async (logId, logHint = null) => {
    console.log('[retryLogAnalysis] called for logId:', logId);
    if (!getApiKey()) {
      toast('Set your API key first to run analysis', 'error');
      setShowApiKeyModal(true);
      // Clear the analyzing flag so the cover spinner doesn't hang. Without
      // this the user sees "Reading your skin..." forever after a save when
      // no API key is set. (Pre-fix the early-return left analyzing stuck.)
      setLogs(prev => prev.map(l => l.id === logId ? { ...l, analyzing: false, analyzingStartedAt: undefined } : l));
      return;
    }
    // === STALE-CLOSURE FIX (May 2026 per Jenni) ===
    // Symptom: photo upload → "Reading your skin..." spins forever +
    // "Log not found" toast. Root cause: saveLogFromForm calls
    // setLogs(updated) then immediately fires retryLogAnalysis(log.id).
    // retryLogAnalysis was defined in the previous render so its `logs`
    // closure does NOT include the just-added log — `find` returns
    // undefined, early-returns without clearing the `analyzing:true` flag
    // the save stamped on the log. Fix: accept an optional logHint so
    // callers can pass the freshly-created log object, AND clear the
    // analyzing flag on every early-return path.
    const log = logHint || logs.find(l => l.id === logId);
    if (!log) {
      console.warn('[retryLogAnalysis] log not found:', logId);
      toast('Log not found — try refreshing', 'error');
      setLogs(prev => prev.map(l => l.id === logId ? { ...l, analyzing: false, analyzingStartedAt: undefined } : l));
      return;
    }
    console.log('[retryLogAnalysis] log:', { id: log.id, date: log.date, area: log.area, hasPhoto: !!log.photo, hasPath: !!log.photoPath });
    // Track which log is being retried via local UI state (decoupled from log.analyzing,
    // which was getting stuck in storage across failed background calls).
    setRetryingLogId(logId);
    // Tag the log with analyzing flag + start timestamp so the recurring
    // watchdog can self-heal if this call hangs beyond 120s.
    setLogs(prev => prev.map(l => l.id === logId ? { ...l, analyzing: true, analyzingStartedAt: Date.now() } : l));
    try {
      // Resolve photo to base64 FIRST so we know whether vision is possible.
      let photoB64 = log.photo;
      if (!photoB64 && log.photoPath) {
        console.log('[retryLogAnalysis] fetching from Storage path:', log.photoPath);
        photoB64 = await fetchPhotoAsBase64(log.photoPath);
        console.log('[retryLogAnalysis] fetched:', !!photoB64);
      }
      if (!photoB64) {
        console.warn('[retryLogAnalysis] no photo data — running text-only analysis');
      }

      // === TIGHTENED WINDOW + EXPLICIT-ONLY (May 2026 per Jenni) ===
      // Was 30 days. The 30-day breadth meant products the user stopped
      // touching weeks ago kept showing up as "active routine" in the
      // analysis. 7 days matches the "ACTIVELY USED" definition's
      // recency floor and aligns with what most users would call
      // "what I'm doing right now." Pattern detection + Counsel
      // insights keep 30-day windows because those surfaces are
      // explicitly about trends, not today's read.
      const usage7 = getActualUsage(products, regimenLogs, logs, { windowDays: 7 });
      const recentContext = logs.filter(l => l.id !== logId).slice(0, 5)
        .map(l => `${l.date}: ${l.area} ${l.rating}/10 [${l.concerns?.join(',') || ''}]`).join('; ') || 'no prior entries';
      const todaysProductDetail = (log.usedProducts || []).map(uid => {
        const p = products.find(pp => pp.id === uid);
        if (!p) return null;
        return `• ${p.name} (${p.brand || '—'}, ${p.category}) — actives: ${p.activeIngredients || 'unknown'}`;
      }).filter(Boolean).join('\n') || 'none recorded';
      const prompt = `Analyze this skin journal entry.

FORMAT (strict):
- Output 3-4 short bullets only. Each line starts with "- " (dash + space).
- NO markdown bold (no **text**), NO headers, NO paragraphs.
- Each bullet ≤ 15 words. TOTAL ≤ 50 words.
- Prefix EVERY bullet with a type tag in brackets: [OBSERVE] for visual reading of the skin, [CAUSE] for mechanism / why this is happening, [ACTION] for what to do next. Example: "- [OBSERVE] forehead congestion mild today". Pick the most-fitting single tag per bullet.
- Bake evidence quality into the prose itself in plain language: "well-studied for…", "evidence suggests…", "limited data, mechanism-based…", "emerging evidence…". Don't use letter grades.
- For [ACTION] bullets ONLY, also append a parseable evidence tag at the END in this exact format: [ev:strong|moderate|emerging:source] where source is one of RCT, observational, mechanism, expert. Example: "- [ACTION] Try azelaic 10% — well-studied for PIH. [ev:strong:RCT]". Skip this tag for [OBSERVE] and [CAUSE] bullets.
- Be specific and mechanism-anchored. No fluff, no preamble, no signoff.

CONTENT: one pattern OR likely cause, plus one concrete actionable suggestion.

Entry: ${log.date} · ${log.area} · ${log.rating}/10
Concerns: ${log.concerns?.join(', ') || 'none'}
Notes: ${log.notes || 'none'}
${photoB64 ? '- Photo provided (analyze visible skin condition).' : '- No photo available — base on metadata + concerns + notes only.'}

Today's tagged products:
${todaysProductDetail}

User's actual routine (last 7 days — recent, explicit-only):
${formatUsageForPrompt(usage7, { activeOnly: true })}

STRICT RULES:
- The "ACTIVELY USED" list above is the ONLY product set you may attribute today's skin state to. Do not pull from memory, do not infer products beyond this list.
- If a product is in "SCHEDULED BUT UNVERIFIED," DO NOT claim it's causing or affecting anything. Treat it as planned but unconfirmed.
- If "ACTIVELY USED" is empty, do not invent a routine — say the user hasn't logged recent explicit use and analyze the photo alone.

Recent context: ${recentContext}

After the bullets, on TWO SEPARATE FINAL LINES (not bullets, no dashes), append:
METRICS: redness=<Clear|Low|Mild|Moderate|High>, hydration=<Plump|Good|Balanced|Dry|Parched>, texture=<Smooth|Even|Uneven|Rough|Bumpy>, breakouts=<Clear|Few|Some|Many|Severe>
REGION: <Full Face|R Cheek|L Cheek|Forehead|T-zone|Chin|Nose|Jaw|Hairline|Neck|Back|Body|Other>

Pick the SINGLE most accurate word per METRIC based on what's actually visible. Pick ONE REGION based on what's framed (Full Face when whole face is shown; Other when off-face/specific spot). Capitalize as shown. Do not skip either line.`;

      console.log('[retryLogAnalysis] calling Claude (prose) + Gemini (metrics) in parallel');
      // === HYBRID READ (June 2026 per Jenni) ===
      // Claude writes the prose (voice + interpretation + ACTIVELY-USED
      // grounding). Gemini 2.5 Pro extracts the structured metricSnapshot
      // (better visual fine-detail). Run in parallel — Gemini's call
      // hides behind the Claude latency we'd be paying anyway. If Gemini
      // fails or returns null, we fall back to parseSkinMetrics on the
      // Claude output (which still includes the METRICS: line).
      const [result, geminiSnap] = await Promise.all([
        callClaude(prompt, '', photoB64 || null, { voice: true }),
        photoB64 ? extractMetricsWithGemini(photoB64) : Promise.resolve(null),
      ]);
      console.log('[retryLogAnalysis] result length:', result?.length || 0, 'gemini snap:', !!geminiSnap);
      if (!result || !String(result).trim()) {
        throw new Error('Empty response from analysis');
      }
      // Prefer Gemini for the structured snapshot; fall back to parsing
      // Claude's METRICS: line. Also parse REGION from Claude output (May
      // 2026) so each log carries the body region the photo shows —
      // used by Journal/Compare to label photos without slot prescription.
      const metricSnapshot = geminiSnap || parseSkinMetrics(result);
      const region = parseSkinRegion(result);
      const cleanProse = stripAnalysisStructuredLines(result);
      setLogs(prev => {
        const next = prev.map(l => l.id === logId ? {
          ...l,
          aiAnalysis: cleanProse,
          metricSnapshot: metricSnapshot || l.metricSnapshot,
          region: region || l.region || null,
          analyzing: false,
          analyzingStartedAt: undefined,
        } : l);
        saveData('logs', next);
        return next;
      });
      toast('Analysis ready ✨');
    } catch (e) {
      console.error('[retryLogAnalysis] FAILED:', e);
      setLogs(prev => {
        const next = prev.map(l => l.id === logId ? { ...l, analyzing: false, analyzingStartedAt: undefined } : l);
        saveData('logs', next);
        return next;
      });
      const msg = e?.message?.slice(0, 200) || 'Unknown error';
      toast(`Analysis failed: ${msg}`, 'error');
    }
    setRetryingLogId(null);
  };

  // === PATTERN DETECTION ===
  const generatePatternInsight = async () => {
    if (!getApiKey()) { setShowApiKeyModal(true); return; }
    setLoadingPattern(true);
    try {
      const recent = logs.slice(0, 30).map(l => `${l.date} | ${l.area} | ${l.rating}/10 | ${l.concerns?.join(',') || '-'} | ${l.notes || ''}`).join('\n');
      // Pattern detection must reason from ACTUAL routine. The product timeline (start/stop dates)
      // can mislead — a product "started" months ago might be untouched for weeks.
      const _patternUsage = getActualUsage(products, regimenLogs, logs, { windowDays: 30 });
      const procTimeline = procedures.map(p => `${p.date}: ${p.name}`).join('; ');
      const prompt = `Analyze this person's skin tracking data and identify 3-4 meaningful patterns. Look for:
- Correlations between products ACTUALLY USED (from check-ins) and skin scores
- Concern patterns (does acne flare in specific areas? cyclically?)
- Procedure impact on subsequent ratings
- Any notable upward/downward trends
- Possible triggers based on noted concerns

CRITICAL: only correlate with products in the ACTIVELY USED section below. Products in LAPSED/UNUSED are owned but not in current use — do NOT claim they're causing or improving anything currently.

Recent journal entries:
${recent}

USER'S ACTUAL ROUTINE (from check-ins + photo logs, last 30 days):
${formatUsageForPrompt(_patternUsage)}

Procedure timeline:
${procTimeline || 'No procedures logged'}

Format as 3-4 distinct observations, each starting with a bold pattern name and a sentence of evidence-based interpretation. Be specific (cite dates, scores, products) — not generic. End with one concrete suggestion based on the strongest pattern.`;
      const result = await callClaude(prompt, '', null, { voice: true });
      const insight = { content: result, generatedAt: Date.now(), entryCount: logs.length };
      setPatternInsight(insight);
      const userKey = user.email.replace(/[^a-zA-Z0-9]/g, '');
      await storage.set(`pattern:${userKey}`, JSON.stringify(insight));
      toast('Pattern analysis complete ✨');
    } catch (e) {
      toast('Pattern analysis failed', 'error');
    }
    setLoadingPattern(false);
  };

  // === COUNSEL — INSIGHTS GENERATION ===
  // Each card has its own focused prompt + data slice. They share a common system frame
  // (board-certified derm voice, evidence-graded, AAD/BAD anchored, named experts) defined
  // once below. The actual-usage helper grounds them all in real behavior, not shelf.
  const counselSystemFrame = () => {
    const usage30 = getActualUsage(products, regimenLogs, logs, { windowDays: 30 });
    const sensList = (sensitivities || []).join(', ') || 'none recorded';
    const cycleContext = (hormonalContext === 'cycling' && cycleData?.periods?.length)
      ? `\nCycle: last period ${cycleData.periods.sort((a,b)=>new Date(b.date)-new Date(a.date))[0].date}, length ${cycleData.cycleLength || 28} days.`
      : (hormonalContext ? `\nHormonal context: ${hormonalContext}` : '');
    return {
      voice: `You are an educational skincare advisor with dermatology training, grounded in peer-reviewed dermatology literature and the guidelines of major bodies (AAD, BAD, EADV). You also draw on the practice patterns of leading evidence-based educators when their framing is well-supported: Dr. Sam Ellis, Dr. Shereene Idriss, Dr. Mona Gohara, Dr. Hadley King, Dr. Andrea Suarez. This is informational and educational, not a medical diagnosis.

VOICE — magazine register, editorial Vogue with UpToDate rigor. Conversational paragraphs. No bullet lists unless naming 4+ specific products. Direct: name product, active, dose, timing. This is educational skin guidance, not a diagnosis — when symptoms are severe, painful, infected, rapidly changing, or lesion-like, recommend an in-person dermatologist or urgent care visit explicitly.

EVIDENCE GRADING — append a GRADE-style tag in brackets to non-obvious clinical claims:
[A] strong RCT + AAD/BAD-recommended · [B] consistent observational/mechanistic · [C] limited but plausible · [expert opinion: name] when it leans on a specific clinician's framing.
Don't grade obvious claims like daily SPF.

MECHANISM ANCHORING — one sentence of pathophysiology when recommending an active. ("Retinoids accelerate keratinocyte turnover and downregulate AP-1, which is why both the acne and photoaging effects emerge from the same molecule.") This separates a real read from a wellness summary.

CITATION HOOKS — when naturally relevant, use the canonical names: retinol, retinaldehyde, tretinoin, adapalene, niacinamide, vitamin C, AHA/BHA/PHA, salicylic acid, glycolic acid, azelaic acid, ceramides, hyaluronic acid, peptides, sunscreen/SPF, double cleansing, gut-skin axis, hormonal acne. Inline lesson chips auto-render.

CRITICAL — only reason from ACTIVELY USED in the routine block below. Products in LAPSED / UNUSED are owned but not in the working routine — do NOT recommend or analyze them as if in use, except when explicitly suggesting they pick something off the shelf.${buildUserProfileBlock()}`,
      usageBlock: formatUsageForPrompt(usage30),
      sensList,
      cycleContext,
    };
  };
  const handleGenerateCounselInsight = async (cardId) => {
    if (!getApiKey()) { setShowApiKeyModal(true); return; }
    setCounselGenerating(prev => ({ ...prev, [cardId]: true }));
    try {
      const frame = counselSystemFrame();
      const skinHistory14 = logs.slice(0, 14).map(l => `${l.date} | ${l.area} | ${l.rating}/10 | ${l.concerns?.join(',') || '-'} | ${l.notes || ''}`).join('\n') || 'No entries.';
      const skinHistory30 = logs.slice(0, 30).map(l => `${l.date} | ${l.rating}/10 | concerns: ${l.concerns?.join(',') || '-'}`).join('\n') || 'No entries.';
      const procList = procedures.slice(0, 5).map(p => `${p.date}: ${p.name} (${p.type})`).join('\n') || 'None recent.';
      const concernCounts = {};
      logs.slice(0, 30).forEach(l => (l.concerns || []).forEach(c => { concernCounts[c] = (concernCounts[c] || 0) + 1; }));
      const topConcerns = Object.entries(concernCounts).sort((a,b)=>b[1]-a[1]).slice(0,5).map(([c,n]) => `${c} (${n})`).join(', ') || 'no recurring concerns';

      let prompt;
      let maxTokens = 1200;
      switch (cardId) {
        case 'trajectory': {
          const ratings = logs.slice(0, 30).map(l => l.rating).filter(r => r != null);
          const avg14 = ratings.slice(0, 14).reduce((s,r)=>s+r,0) / Math.max(1, Math.min(14, ratings.length));
          const avg30 = ratings.reduce((s,r)=>s+r,0) / Math.max(1, ratings.length);
          prompt = `${frame.voice}

Write a SKIN TRAJECTORY analysis for the last 30 days. Address: (1) overall slope — improving, holding, or worsening? Quote specific dates and ratings. (2) Identify ONE turning point if it exists, and what changed around it (new product start in ACTIVE USE, procedure, lifestyle). (3) State the most recent 14-day average vs the prior 14-day average. Keep it 3-5 short paragraphs, magazine voice — not a clinical bullet list.

CURRENT MOMENT:
Most recent 14-day avg rating: ${avg14.toFixed(1)} / 10
Prior period avg: ${avg30.toFixed(1)} / 10
Top recurring concerns: ${topConcerns}

JOURNAL (last 14, most recent first):
${skinHistory14}

USER'S ACTUAL ROUTINE (last 30d):
${frame.usageBlock}

Procedures (recent):
${procList}${frame.cycleContext}`;
          break;
        }
        case 'productPerformance': {
          // Simple co-occurrence: for each actively-used product, average the rating of days it was used vs days it wasn't.
          const usage30 = getActualUsage(products, regimenLogs, logs, { windowDays: 30 });
          const corr = usage30.actuallyUsed.map(u => {
            const idsOnUsed = new Set();
            (regimenLogs || []).forEach(r => {
              if ((r.amProducts || []).includes(u.product.id) || (r.pmProducts || []).includes(u.product.id)) idsOnUsed.add(r.date);
            });
            const onDaysRatings = logs.filter(l => idsOnUsed.has(l.date)).map(l => l.rating).filter(r => r != null);
            const offDaysRatings = logs.filter(l => !idsOnUsed.has(l.date)).map(l => l.rating).filter(r => r != null);
            const onAvg = onDaysRatings.length ? (onDaysRatings.reduce((s,r)=>s+r,0)/onDaysRatings.length) : null;
            const offAvg = offDaysRatings.length ? (offDaysRatings.reduce((s,r)=>s+r,0)/offDaysRatings.length) : null;
            return { name: u.product.name, actives: u.product.activeIngredients || 'no actives', daysUsed: idsOnUsed.size, onAvg, offAvg, delta: (onAvg && offAvg) ? (onAvg - offAvg) : null };
          });
          const corrBlock = corr.length > 0
            ? corr.map(c => `• ${c.name} (${c.actives}) — used ${c.daysUsed} days; avg rating on use-days ${c.onAvg?.toFixed(1) ?? 'n/a'} vs off-days ${c.offAvg?.toFixed(1) ?? 'n/a'}${c.delta != null ? ` (Δ ${c.delta >= 0 ? '+' : ''}${c.delta.toFixed(1)})` : ''}`).join('\n')
            : 'No co-occurrence data — log a few check-ins first.';
          const photoCount = logs.filter(l => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:'))).length;
          const deepGate = photoCount < 30
            ? `\n\nNote: simple co-occurrence only. Lag-adjusted "deep" analysis unlocks at 30 photo entries (currently ${photoCount}). Acknowledge this limit briefly at the end.`
            : '';
          prompt = `${frame.voice}

Analyze PRODUCT PERFORMANCE based on simple co-occurrence with skin ratings. For each actively-used product, you have the average rating on days it was used vs days it wasn't. Identify (1) the strongest positive correlation, (2) any concerning negative correlation — flag with a "WORTH WATCHING" inline tag, (3) products that look neutral (used >2 weeks with no apparent shift). Be honest: a small N is not a signal. Don't over-claim.${deepGate}

CO-OCCURRENCE DATA (last 30 days):
${corrBlock}

USER-REPORTED SENSITIVITIES (avoid-list): ${frame.sensList}

USER'S ACTUAL ROUTINE:
${frame.usageBlock}`;
          break;
        }
        case 'concernPatterns': {
          prompt = `${frame.voice}

Identify CONCERN PATTERNS over the last 30 days. Address: (1) the user's top 3 recurring concerns and frequency. (2) WHEN do they tend to flare — cycle phase if cycling, days following a procedure, after introducing/stopping a specific product, or other patterns visible in the data. (3) ONE evidence-based predictive heuristic: "expect X to flare around Y because Z." Magazine voice, 3-4 short paragraphs, specific dates and product names.

TOP RECURRING CONCERNS (last 30d): ${topConcerns}

JOURNAL (last 30):
${skinHistory30}

USER'S ACTUAL ROUTINE:
${frame.usageBlock}

Procedures:
${procList}${frame.cycleContext}`;
          break;
        }
        case 'routineAudit': {
          prompt = `${frame.voice}

Run a ROUTINE AUDIT on the user's ACTIVELY USED products only. Address: (1) coverage — does the routine include the AAD/BAD-recommended core (gentle cleanser, moisturizer, SPF AM, retinoid PM if appropriate)? Name the gaps. (2) redundancies — two products doing the same job (e.g., two niacinamide serums). (3) conflicts — actives that shouldn't be layered, frequency mismatches with the user's sensitivity profile. (4) evidence grade of each active in use — A (retinoids, SPF, AHA), B (niacinamide, vitamin C), C (peptides, exotic actives). End with the SINGLE highest-leverage adjustment (add, drop, or reorder).

USER-REPORTED SENSITIVITIES: ${frame.sensList}

USER'S ACTUAL ROUTINE:
${frame.usageBlock}${frame.cycleContext}`;
          break;
        }
        case 'cycleMap': {
          if (hormonalContext !== 'cycling') {
            // Shouldn't be hit because card is hidden — but guard anyway.
            setCounselGenerating(prev => ({ ...prev, [cardId]: false }));
            return;
          }
          prompt = `${frame.voice}

Build a CYCLE MAP from the user's ratings + concerns over the last 30+ days, anchored to their cycle data. Address: (1) average rating in each phase (menstrual, follicular, ovulatory, early luteal, late luteal) — only quote phases where you have data. (2) the most affected phase — what's the typical rating delta vs follicular peak? (3) one phase-specific actionable adjustment grounded in mechanism (e.g., "late luteal sebum surge — front-load BHA Days 21-26"). Use named experts where their guidance supports the call. Magazine voice.

JOURNAL (last 30):
${skinHistory30}

USER'S ACTUAL ROUTINE:
${frame.usageBlock}${frame.cycleContext}`;
          break;
        }
        case 'whatsNext': {
          prompt = `${frame.voice}

Write a WHAT'S NEXT 30-day forecast. Three short paragraphs: (1) given the trajectory, what's the realistic 30-day outlook — improving, plateauing, regressing? Be honest. (2) what to watch for — one specific signal that would mean things are off-track. (3) ONE concrete, evidence-graded suggested move (add, drop, change frequency, or do a procedure follow-up) with the mechanism in one sentence and the evidence grade. No more than three paragraphs total. Magazine voice — no bullet lists.

JOURNAL (last 14):
${skinHistory14}

USER-REPORTED SENSITIVITIES: ${frame.sensList}

USER'S ACTUAL ROUTINE:
${frame.usageBlock}

Procedures:
${procList}${frame.cycleContext}`;
          break;
        }
        default:
          throw new Error(`Unknown insight card: ${cardId}`);
      }
      const result = await callClaude(prompt, '', null, { maxTokens, voice: true });
      const next = { ...counselInsights, [cardId]: { content: result, generatedAt: Date.now(), entryCount: logs.length } };
      setCounselInsights(next);
      await saveData('counselInsights', next);
    } catch (e) {
      console.error('[Counsel] insight generation failed:', cardId, e);
      toast(`Couldn't generate ${cardId} — try again`, 'error');
    }
    setCounselGenerating(prev => ({ ...prev, [cardId]: false }));
  };
  // Push the card content into a fresh Ask thread as context, then switch to Ask tab.
  const discussInsightInAsk = (cardId) => {
    const c = counselInsights[cardId];
    if (!c) return;
    setInsightMessages([
      { role: 'user', content: `[Discussing my ${cardId} insight]` },
      { role: 'assistant', content: c.content },
    ]);
    setCounselSubTab('ask');
  };

  // === COMPARE ASK — TOOL EXECUTOR ===
  // Runs a tool call invoked by the Compare → Ask chat. Returns a string the model can read,
  // plus an array of log IDs that the UI should render as photo cards inline.
  const executeCompareTool = (name, input) => {
    const _hasPhoto = (l) => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:'));
    const fmtLog = (l) => `id=${l.id} ${l.date} ${(l.area || 'full-face').replace(/-/g, ' ')} rating=${l.rating}/10`;
    try {
      switch (name) {
        case 'list_user_data': {
          const usage = getActualUsage(products, regimenLogs, logs, { windowDays: 30 });
          const activeNames = usage.actuallyUsed.map(u => u.product.name).join(', ') || 'none';
          const lapsedNames = usage.lapsed.map(u => u.product.name).join(', ') || 'none';
          const procNames = (procedures || []).map(p => `${p.name} (${p.date})`).join('; ') || 'none';
          const recentConcerns = [...new Set(logs.slice(0, 15).flatMap(l => l.concerns || []))].slice(0, 8).join(', ') || 'none';
          const photoCount = logs.filter(_hasPhoto).length;
          const text = `Active products (last 30d): ${activeNames}\nLapsed (>14d): ${lapsedNames}\nProcedures: ${procNames}\nRecent concerns: ${recentConcerns}\nTotal photos in journal: ${photoCount}`;
          return { text, photoIds: [] };
        }
        case 'find_photos': {
          const { start_date, end_date, area, limit = 5 } = input;
          let results = logs.filter(l => l.date >= start_date && l.date <= end_date && _hasPhoto(l));
          if (area) results = results.filter(l => l.area === area);
          results.sort((a, b) => new Date(b.date) - new Date(a.date));
          results = results.slice(0, limit);
          if (results.length === 0) return { text: `No photos between ${start_date} and ${end_date}${area ? ' for area ' + area : ''}.`, photoIds: [] };
          return { text: results.map(fmtLog).join('\n'), photoIds: results.map(l => l.id) };
        }
        case 'find_product_compare': {
          const { product_name } = input;
          const product = (products || []).find(p => p.name?.toLowerCase().includes(String(product_name).toLowerCase()));
          if (!product) return { text: `No product matching "${product_name}".`, photoIds: [] };
          const a = findProductCompareAnchors(product, products, regimenLogs, logs);
          if (!a.startDate) return { text: `${product.name}: no usage logged yet — needs daily check-in tags or photo-tag use to compute anchor.`, photoIds: [] };
          const ids = [a.anchorPhotoLog, a.latestPhotoLog].filter(Boolean).map(l => l.id);
          if (!a.hasEnoughData) return { text: `${product.name}: started ${a.startDate} (${a.daysActive}d ago), ${a.photoCount} photos. ${a.reasonShort}`, photoIds: ids };
          return { text: `${product.name}: started ${a.startDate}, ${a.daysActive}d of use, ${a.photoCount} photos in window. Anchor: ${fmtLog(a.anchorPhotoLog)}. Latest: ${fmtLog(a.latestPhotoLog)}.`, photoIds: ids };
        }
        case 'find_procedure_compare': {
          const { procedure_name } = input;
          const proc = (procedures || []).find(p => p.name?.toLowerCase().includes(String(procedure_name).toLowerCase()));
          if (!proc) return { text: `No procedure matching "${procedure_name}".`, photoIds: [] };
          const procDate = new Date(proc.date);
          const before = [...logs].filter(l => _hasPhoto(l) && new Date(l.date) <= procDate).sort((a, b) => Math.abs(new Date(a.date) - procDate) - Math.abs(new Date(b.date) - procDate))[0];
          const after = [...logs].filter(l => _hasPhoto(l) && new Date(l.date) > procDate).sort((a, b) => new Date(b.date) - new Date(a.date))[0];
          const ids = [before, after].filter(Boolean).map(l => l.id);
          const beforeStr = before ? `before=${fmtLog(before)}` : 'no photo before';
          const afterStr = after ? `after=${fmtLog(after)}` : 'no photo after';
          return { text: `${proc.name} on ${proc.date}. ${beforeStr}. ${afterStr}.`, photoIds: ids };
        }
        default:
          return { text: `Unknown tool: ${name}`, photoIds: [] };
      }
    } catch (e) {
      console.error('[CompareAsk] tool exec failed:', name, e);
      return { text: `Tool error: ${e?.message || 'unknown'}`, photoIds: [] };
    }
  };

  // === COMPARE ASK — CHAT HANDLER ===
  // Tool-use loop: calls Anthropic API with tool definitions, executes any tool_use blocks
  // locally, feeds tool_result back. When the model returns a final text response, we stash
  // the union of all photoIds returned by tool calls onto the assistant message so the UI
  // can render inline photo cards.
  const handleCompareAsk = async (forced) => {
    const text = (forced || compareAskInput).trim();
    if (!text) return;
    if (!getApiKey()) { setShowApiKeyModal(true); return; }
    const userMsg = { role: 'user', content: text };
    const newMessages = [...compareAskMessages, userMsg];
    setCompareAskMessages(newMessages);
    setCompareAskInput('');
    setCompareAskLoading(true);

    const tools = [
      {
        name: 'list_user_data',
        description: "Get a summary of the user's data: active products in their routine, lapsed products, recent procedures, recent concerns, total photo count. Call this FIRST when the user references something by name to ground yourself in what's actually on file.",
        input_schema: { type: 'object', properties: {}, required: [] },
      },
      {
        name: 'find_photos',
        description: 'Find photo logs in a date range. Returns matching log IDs that the UI will render as inline photo cards. Use ISO dates YYYY-MM-DD.',
        input_schema: {
          type: 'object',
          properties: {
            start_date: { type: 'string', description: 'YYYY-MM-DD inclusive' },
            end_date: { type: 'string', description: 'YYYY-MM-DD inclusive' },
            area: { type: 'string', description: 'Optional area filter: full-face, cheeks, forehead, chin, nose-tzone, neck, body, back' },
            limit: { type: 'number', description: 'Max results, default 5' },
          },
          required: ['start_date', 'end_date'],
        },
      },
      {
        name: 'find_product_compare',
        description: 'Get the start anchor and latest photos for a specific product. Returns IDs the UI renders as a before/after pair. Pass partial product name match.',
        input_schema: {
          type: 'object',
          properties: { product_name: { type: 'string', description: 'Product name (case-insensitive partial match)' } },
          required: ['product_name'],
        },
      },
      {
        name: 'find_procedure_compare',
        description: 'Get before/after photo anchors for a logged procedure. Returns IDs for the closest photo before the procedure and the most recent photo after.',
        input_schema: {
          type: 'object',
          properties: { procedure_name: { type: 'string', description: 'Procedure name (case-insensitive partial match)' } },
          required: ['procedure_name'],
        },
      },
    ];

    const todayISO = localDateISO();
    // Safety preamble for journal-aware prompt — concat all user messages
    // so triggers fire even on later turns.
    const journalUserText = (newMessages || []).filter(m => m.role === 'user').map(m => typeof m.content === 'string' ? m.content : '').join(' ');
    const journalSafety = buildSafetyPreamble(journalUserText);
    const systemPrompt = `${journalSafety}You are an educational, dermatology-informed skincare advisor helping the user explore their skin journal (informational, not diagnostic). Today is ${todayISO}. The user has photos, daily regimen check-ins, products on shelf, procedures, concerns, and AI analyses on file. If the user describes something severe (pain, infection, rapid change, lesion-like), recommend an in-person dermatologist or urgent care visit directly.

Use the tools to find the right photos before answering — the UI renders any log IDs you retrieve as inline before/after cards. When the user asks "show me when I started X" or "compare before and after my procedure," call the right tool and let the cards do the visual work. Your text response should be short, observational, magazine-register — comment on what's visible/different rather than restating the dates. Use evidence-grade brackets [A]/[B]/[C] for non-obvious clinical claims. Anchor in mechanism when relevant.

If the user references something not in their data ("started retinol 6 weeks ago" but no retinol on shelf), say so honestly and suggest they log it.`;

    // Build the API messages array. We mutate this through tool-use rounds.
    const apiMessages = [];
    for (const m of newMessages) {
      if (typeof m.content === 'string') {
        apiMessages.push({ role: m.role, content: m.content });
      }
    }

    const allPhotoIds = [];
    let finalText = '';
    let safetyLoops = 0;
    try {
      while (safetyLoops < 5) {
        safetyLoops++;
        const resp = await fetch('https://api.anthropic.com/v1/messages', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-api-key': getApiKey(),
            'anthropic-version': '2023-06-01',
            'anthropic-dangerous-direct-browser-access': 'true',
          },
          body: JSON.stringify({
            model: 'claude-sonnet-4-6',
            max_tokens: 1500,
            system: systemPrompt,
            tools,
            messages: apiMessages,
          }),
        });
        if (!resp.ok) {
          const errText = await resp.text();
          throw new Error(errText.slice(0, 300));
        }
        const data = await resp.json();
        const content = data.content || [];
        const textBlocks = content.filter(b => b.type === 'text').map(b => b.text);
        const toolUses = content.filter(b => b.type === 'tool_use');
        if (toolUses.length === 0) {
          finalText = textBlocks.join('\n').trim() || 'No reply.';
          break;
        }
        // Append assistant turn (preserving the full content for tool_use_id correlation)
        apiMessages.push({ role: 'assistant', content });
        // Run tools and append results
        const toolResults = [];
        for (const tu of toolUses) {
          const result = executeCompareTool(tu.name, tu.input || {});
          if (Array.isArray(result.photoIds)) allPhotoIds.push(...result.photoIds);
          toolResults.push({ type: 'tool_result', tool_use_id: tu.id, content: result.text });
        }
        apiMessages.push({ role: 'user', content: toolResults });
      }
      // Dedupe photo IDs preserving order
      const seen = new Set();
      const uniquePhotoIds = allPhotoIds.filter(id => seen.has(id) ? false : (seen.add(id), true));
      setCompareAskMessages(prev => [...prev, { role: 'assistant', content: finalText, photoIds: uniquePhotoIds }]);
    } catch (e) {
      console.error('[CompareAsk] failed:', e);
      setCompareAskMessages(prev => [...prev, { role: 'assistant', content: `Couldn't run that — ${e?.message?.slice(0, 200) || 'unknown error'}`, error: true }]);
    }
    setCompareAskLoading(false);
  };

  // === EXPORT TO PDF ===
  const exportToPDF = async () => {
    const w = window.open('', '_blank');
    if (!w) { toast('Pop-ups blocked — allow them to export', 'error'); return; }
    // === HTML ESCAPE (May 2026 security fix) ===
    // Every user/AI-derived string interpolated into the export must
    // pass through this helper. Previously notes, AI analyses, product
    // names, and procedure notes were written directly into
    // document.write — a journal entry containing <script> or img
    // onerror payloads would execute in the export window. Escape now
    // closes that hole. Static labels and our own template chrome stay
    // raw; only USER-DERIVED VALUES get esc()-wrapped.
    const esc = (v) => {
      if (v == null) return '';
      return String(v)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    };
    const stylesheet = `
      <style>
        @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@300;400&display=swap');
        body { font-family: 'Inter', sans-serif; color: #2a2520; padding: 40px; max-width: 800px; margin: 0 auto; background: #f5f0e8; }
        h1, h2, h3 { font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 500; color: #2a2520; }
        h1 { font-size: 36px; margin-bottom: 4px; }
        h2 { font-size: 24px; margin-top: 32px; padding-bottom: 8px; border-bottom: 1px solid #d8cfbf; }
        h3 { font-size: 18px; margin-top: 16px; margin-bottom: 4px; }
        .meta { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #786a5e; }
        .entry { padding: 12px 0; border-bottom: 1px solid #ede4d3; }
        .rating { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 24px; }
        .concern { display: inline-block; font-size: 10px; padding: 2px 8px; background: #ede4d3; border-radius: 12px; margin-right: 4px; }
        .observation { font-size: 12px; color: #786a5e; padding: 8px; background: #ede4d3; margin-top: 8px; font-style: italic; }
        img { max-width: 200px; border-radius: 4px; margin: 8px 0; }
        @media print { body { background: white; } }
      </style>
    `;
    const journalSection = logs.slice(0, 50).map(l => `
      <div class="entry">
        <div style="display:flex; justify-content:space-between; align-items:flex-start;">
          <div>
            <div class="meta">${esc((l.area || '').replace(/-/g, ' '))}</div>
            <div style="font-family:'Cormorant Garamond',serif; font-style:italic; font-size:18px;">${esc(new Date(l.date).toLocaleDateString('en-US', { weekday:'long', month:'long', day:'numeric', year:'numeric' }))}</div>
          </div>
          <div class="rating">${esc(l.rating)}/10</div>
        </div>
        ${l.concerns?.length ? `<div style="margin:6px 0;">${l.concerns.map(c => `<span class="concern">${esc(c)}</span>`).join('')}</div>` : ''}
        ${l.notes ? `<div style="font-size:13px; font-style:italic; color:#786a5e;">"${esc(l.notes)}"</div>` : ''}
        ${l.aiAnalysis ? `<div class="observation"><strong>Observation:</strong> ${esc(l.aiAnalysis)}</div>` : ''}
      </div>
    `).join('');
    const productSection = products.map(p => `
      <div class="entry">
        <div class="meta">${esc(p.brand || 'Unknown')} · ${esc(p.category)}</div>
        <div style="font-family:'Cormorant Garamond',serif; font-style:italic; font-size:18px;">${esc(p.name)}</div>
        <div style="font-size:12px; color:#786a5e;">${esc(p.activeIngredients || 'No actives listed')} · ${esc((p.frequency || '').replace(/-/g, ' '))} · ${esc(p.startDate)}${p.endDate ? ` to ${esc(p.endDate)}` : ' to present'}</div>
        ${p.aiAnalysis ? `<div class="observation">${esc(p.aiAnalysis)}</div>` : ''}
      </div>
    `).join('');
    const procSection = procedures.map(p => `
      <div class="entry">
        <div class="meta">${esc((p.type || '').replace(/-/g, ' '))} · ${esc(new Date(p.date).toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' }))}</div>
        <h3>${esc(p.name)}</h3>
        ${p.provider ? `<div style="font-size:12px; color:#786a5e;">Provider: ${esc(p.provider)}${p.cost ? ` · ${esc(p.cost)}` : ''}</div>` : ''}
        ${p.notes ? `<div style="font-size:13px; margin-top:4px;">${esc(p.notes)}</div>` : ''}
        ${p.results ? `<div style="font-size:13px; font-style:italic; margin-top:4px;"><strong>Results:</strong> ${esc(p.results)}</div>` : ''}
      </div>
    `).join('');
    w.document.write(`
      <!DOCTYPE html><html><head><title>Frida — Skin Diary Export</title>${stylesheet}</head><body>
      <div class="meta">Frida — A Personal Skin Diary</div>
      <h1>${esc(user.name)}'s Skin Journal</h1>
      <div style="font-size:12px; color:#786a5e; margin-top:4px;">Generated ${esc(new Date().toLocaleDateString('en-US', { weekday:'long', month:'long', day:'numeric', year:'numeric' }))} · ${logs.length} entries · ${products.length} products · ${procedures.length} procedures</div>
      ${patternInsight ? `<div style="margin:24px 0; padding:16px; background:#ede4d3; border-left:3px solid #2a2520;"><div class="meta">Pattern Analysis</div><div style="margin-top:8px; white-space:pre-wrap; font-size:13px;">${esc(patternInsight.content)}</div></div>` : ''}
      ${logs.length ? `<h2>Journal Entries</h2>${journalSection}` : ''}
      ${products.length ? `<h2>Products</h2>${productSection}` : ''}
      ${procedures.length ? `<h2>Procedures</h2>${procSection}` : ''}
      <div style="margin-top:48px; text-align:center; font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:#786a5e;">— end of journal —</div>
      <script>window.onload = () => setTimeout(() => window.print(), 500);<\/script>
      </body></html>
    `);
    w.document.close();
    toast('Opening printable journal — choose "Save as PDF"', 'info');
  };

  // iOS install prompt detection
  const [showInstallPrompt, setShowInstallPrompt] = useState(false);
  const [isIOSWeb, setIsIOSWeb] = useState(false);
  useEffect(() => {
    // Detect iOS Safari (not standalone mode)
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
    const isStandalone = window.navigator.standalone === true || window.matchMedia('(display-mode: standalone)').matches;
    const dismissed = localStorage.getItem('lumiere:installPromptDismissed');
    setIsIOSWeb(isIOS && !isStandalone);
    if (isIOS && !isStandalone && !dismissed) {
      // Show after a brief delay so it doesn't pop immediately
      const t = setTimeout(() => setShowInstallPrompt(true), 2500);
      return () => clearTimeout(t);
    }
  }, []);

  // === REGIMEN DRAWER BRIDGE (May 30 2026 per Jenni) ===
  // Publishes the current day's ritual + concerns + action goal to
  // window.__etudeRegimen so the right-edge drawer (defined at the
  // bottom of index.html, OUTSIDE the runtime block) can render real
  // data instead of demo. Also exposes window.__etudeOpenAdd(slot) so
  // the drawer's empty-slot "+ add cleanser" CTAs can open the
  // existing add-product modal with the correct AM/PM context.
  useEffect(() => {
    try {
      const todayIso = (typeof localDateISO === 'function') ? localDateISO() : new Date().toISOString().slice(0, 10);
      // Reuse the canonical resolver — handles submitted/draft/shelf-default/empty.
      const ritual = (typeof getRitualForDate === 'function')
        ? getRitualForDate(todayIso, regimenLogs, products)
        : { amProducts: [], pmProducts: [] };
      const toDrawer = (p) => ({
        type: (typeof normalizeProductCategory === 'function')
          ? (normalizeProductCategory(p.category) === 'treatment' ? 'serum' : normalizeProductCategory(p.category))
          : String(p.category || 'other').toLowerCase(),
        brand: p.brand || '',
        name: p.name || '',
        actives: p.activeIngredients || p.actives || ''
      });
      const goal = (buildAnswers && buildAnswers.actionGoal) ? buildAnswers.actionGoal : 'BARRIER';
      // Full active shelf (not just today's ritual) — drawer now acts as
      // a shelf browser with a category filter, not a per-day routine view.
      const activeShelf = (Array.isArray(products) ? products : []).filter(p => p && !p.endDate);
      // === SAVED PICKS RESOLUTION ===
      // favoriteProducts is an array of "brand|name" signature strings.
      // Resolve each to a full product object (looking in the user's shelf
      // first, then POPULAR_PRODUCTS catalog). Drawer's "Saved" chip
      // filters to this list.
      const savedSigs = Array.isArray(favoriteProducts) ? favoriteProducts : [];
      const catalog = (typeof POPULAR_PRODUCTS !== 'undefined' && Array.isArray(POPULAR_PRODUCTS)) ? POPULAR_PRODUCTS : [];
      const savedShelf = savedSigs.map(sig => {
        const match = [...activeShelf, ...catalog].find(p => (typeof favoriteSig === 'function' ? favoriteSig(p) : '') === sig);
        return match ? toDrawer(match) : null;
      }).filter(Boolean);
      window.__etudeRegimen = {
        am: (ritual.amProducts || []).map(toDrawer),  // kept for Insights inline comp
        pm: (ritual.pmProducts || []).map(toDrawer),
        shelf: activeShelf.map(toDrawer),
        savedShelf: savedShelf,
        concerns: Array.isArray(userConcerns) ? userConcerns : [],
        actionGoal: goal,
        activeTab: activeTab,
        // The UI "Insights" tab is internally activeTab === 'pearls'.
        // Expose pearlsTab + picksView + regimenView so the drawer can
        // scope to specific surfaces (Insights→Picks→Regimen and
        // Regimen→Shelf are the only two where it should appear).
        pearlsTab: (typeof pearlsTab !== 'undefined' ? pearlsTab : null),
        picksView: (typeof picksView !== 'undefined' ? picksView : null),
        regimenView: (typeof regimenView !== 'undefined' ? regimenView : null),
        buildPlan: (buildPlan && (buildPlan.am || buildPlan.pm)) ? buildPlan : null,
        source: ritual.source || null
      };
      window.dispatchEvent(new Event('etude:regimenUpdate'));
    } catch (e) {
      console.warn('[etudeRegimen bridge]', e);
    }
  }, [regimenLogs, products, userConcerns, buildAnswers, buildPlan, activeTab, pearlsTab, picksView, regimenView, favoriteProducts]);

  // Lets the drawer's "+ add cleanser" empty-slot buttons open the
  // existing add-product modal pre-scoped to AM or PM, today.
  useEffect(() => {
    window.__etudeOpenAdd = (slot) => {
      try {
        const d = (typeof localDateISO === 'function') ? localDateISO() : new Date().toISOString().slice(0, 10);
        setProductModalRegimenContext({ slot: slot === 'pm' ? 'pm' : 'am', date: d });
        setShowProductModal(true);
      } catch (e) { console.warn('[etudeOpenAdd]', e); }
    };
    return () => { try { delete window.__etudeOpenAdd; } catch (_) {} };
  }, []);

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center" style={{ background: 'var(--cream)', color: 'var(--ink)' }}>
        <div className="text-center px-6">
          <div className="font-serif text-4xl leading-none" style={{ color: 'var(--accent)' }}>Frida</div>
          <div className="mt-4 text-[10px] uppercase tracking-[0.3em]" style={{ color: 'var(--ink-soft)' }}>opening your study</div>
        </div>
      </div>
    );
  }

  // === AUTH SCREEN ===
  if (!user) {
    return (
      <div className="min-h-screen" style={{ background: 'var(--cream)' }}>
        <header
          className="sticky top-0 z-20"
          style={{
            background: 'rgba(255,255,255,0.94)',
            borderBottom: '1px solid var(--accent)',
            backdropFilter: 'blur(10px)',
          }}
        >
          <div className="max-w-7xl mx-auto px-5 md:px-6 h-[92px] flex items-center justify-center text-center relative">
            <div>
              <div className="text-[28px] md:text-[32px] tracking-[0.26em] uppercase leading-none" style={{color:'var(--accent)', fontWeight:850}}>Frida</div>
              <div className="mt-2 text-[11px] md:text-[12px] leading-none" style={{color:'var(--ink-soft)', fontWeight:650, letterSpacing:'0.01em'}}>Get to know your skin</div>
            </div>
            <button
              type="button"
              onClick={() => setShowSupabaseModal(true)}
              className="hidden sm:inline-flex absolute right-5 md:right-6 items-center gap-2 rounded-full border px-3 py-2 text-[9px] tracking-[0.16em] uppercase transition hover:bg-[var(--surface-selected-soft)]"
              style={{borderColor:'var(--line)', color:'var(--ink-soft)', background:'var(--cream)', fontWeight:700}}
            >
              <Icon name={supabaseStatus === 'connected' ? 'Cloud' : 'CloudOff'} size={12} />
              {supabaseStatus === 'connected' ? 'Cloud sync' : 'Sync setup'}
            </button>
          </div>
        </header>

        <main className="max-w-md mx-auto px-5 py-8 md:py-12">
          <div className="mb-5">
            <div className="text-[10px] tracking-[0.32em] uppercase mb-1" style={{color:'var(--ink-soft)', fontWeight:700}}>Account</div>
            <h1 className="text-[28px] md:text-[32px] leading-[1.05]" style={{color:'var(--ink)', fontWeight:750, letterSpacing:'-0.03em'}}>
              {authMode === 'signin' ? 'Welcome back.' : 'Begin your study.'}
            </h1>
            <p className="text-[12px] leading-snug mt-2" style={{color:'var(--ink-soft)'}}>
              {authMode === 'signin'
                ? 'Sign in to continue your journal, regimen, and insights.'
                : 'Create an account, then we’ll build the first routine from your shelf.'}
            </p>
          </div>

          <section className="rounded-[18px] border overflow-hidden" style={{background:'var(--cream-deep)', borderColor: 'var(--line)'}}>
            <div className="p-3 border-b" style={{borderColor: 'var(--line)'}}>
              <div className="grid grid-cols-2 gap-1 rounded-full border p-1" style={{background:'var(--cream)', borderColor: 'var(--line)'}}>
                {[
                  { id: 'signin', label: 'Sign in' },
                  { id: 'signup', label: 'Create' },
                ].map(mode => (
                  <button
                    key={mode.id}
                    type="button"
                    onClick={() => { setAuthMode(mode.id); setAuthError(''); }}
                    className="rounded-full px-3 py-2 text-[10px] tracking-[0.16em] uppercase transition"
                    style={{
                      background: authMode === mode.id ? 'var(--surface-selected-soft)' : 'transparent',
                      color: authMode === mode.id ? 'var(--accent)' : 'var(--ink-soft)',
                      fontWeight: 750,
                    }}
                  >
                    {mode.label}
                  </button>
                ))}
              </div>
            </div>

            <div className="p-5 md:p-6">
              {!storageAvailable && (
                <div className="mb-4 rounded-[12px] p-3 text-[11px] leading-snug flex items-start gap-2" style={{background:'var(--cream)', border: '1px solid var(--line)', color:'var(--ink-soft)'}}>
                  <Icon name="Info" size={14} />
                  <div>You're signed in for this session only — your browser isn't persisting storage. Cloud sync still works.</div>
                </div>
              )}

              {storageAvailable && isIOSWeb && (
                <div className="mb-4 rounded-[12px] p-3 text-[11px] leading-snug flex items-start gap-2" style={{background:'var(--cream)', border: '1px solid var(--line)', color:'var(--ink-soft)'}}>
                  <Icon name="Info" size={14} />
                  <div>iOS Safari clears web app data after 7 days. <button type="button" onClick={() => setShowInstallPrompt(true)} className="underline" style={{color:'var(--accent)', fontWeight:700}}>Add Frida to your home screen</button> to keep your account permanently.</div>
                </div>
              )}

              {supabaseStatus === 'connected' && (
                <div className="mb-4 rounded-[12px] p-3 text-[11px] leading-snug flex items-start gap-2" style={{background:'var(--status-info-bg)', border:'1px solid rgba(134,202,231,0.52)', color:'var(--status-info-fg)'}}>
                  <Icon name="Cloud" size={14} />
                  <div>Your account syncs across all devices automatically.</div>
                </div>
              )}

              {supabaseStatus === 'pending' && (
                <div className="mb-4 rounded-[12px] p-3 text-[11px] leading-snug flex items-start gap-2 pulse-soft" style={{background:'var(--cream)', border: '1px solid var(--line)', color:'var(--ink-soft)'}}>
                  <Icon name="Loader2" size={14} className="spin" />
                  <div>Connecting to cloud sync…</div>
                </div>
              )}

              {(supabaseStatus === 'failed' || supabaseStatus === 'disabled') && (
                <div className="mb-4 rounded-[12px] p-3 text-[11px] leading-snug flex items-start gap-2" style={{background:'var(--surface-selected-soft)', border:'1px solid rgba(229,60,45,0.24)', color:'var(--ink-soft)'}}>
                  <Icon name="CloudOff" size={14} style={{color:'var(--accent)'}} />
                  <div className="flex-1">
                    <div style={{color:'var(--ink)', fontWeight:700}}>Cloud sync isn't connected.</div>
                    <div>Account will live only in this browser until you reconnect.</div>
                    <button type="button" onClick={() => { retrySupabaseInit(); }} className="mt-2 text-[9px] tracking-[0.16em] uppercase underline" style={{color:'var(--accent)', fontWeight:750}}>Retry connection</button>
                  </div>
                </div>
              )}

              <form onSubmit={handleAuth} className="space-y-4">
                {authMode === 'signup' && (
                  <Field label="Name"><input autoFocus autoCapitalize="words" autoCorrect="off" spellCheck={false} type="text" value={authForm.name} onChange={e => setAuthForm({...authForm, name: e.target.value})} className={inputCls} style={{...styledInput, borderRadius: 12, background:'var(--cream)'}} /></Field>
                )}
                <Field label="Email"><input autoFocus={authMode === 'signin'} autoCapitalize="off" autoCorrect="off" spellCheck={false} type="email" inputMode="email" value={authForm.email} onChange={e => setAuthForm({...authForm, email: e.target.value})} className={inputCls} style={{...styledInput, borderRadius: 12, background:'var(--cream)'}} /></Field>
                <Field label="Password">
                  <div style={{position: 'relative'}}>
                    <input
                      autoCapitalize="off"
                      autoCorrect="off"
                      spellCheck={false}
                      type={showAuthPassword ? 'text' : 'password'}
                      value={authForm.password}
                      onChange={e => setAuthForm({...authForm, password: e.target.value})}
                      className={inputCls}
                      style={{...styledInput, paddingRight: 60, borderRadius: 12, background:'var(--cream)'}}
                    />
                    <button
                      type="button"
                      onClick={() => setShowAuthPassword(v => !v)}
                      className="absolute transition hover:opacity-100"
                      style={{
                        right: 2,
                        top: '50%',
                        transform: 'translateY(-50%)',
                        padding: '6px 10px',
                        background: 'transparent',
                        color: 'var(--ink-soft)',
                        fontSize: 10,
                        fontWeight: 700,
                        letterSpacing: '0.14em',
                        textTransform: 'uppercase',
                        cursor: 'pointer',
                        opacity: 0.75,
                      }}
                      aria-label={showAuthPassword ? 'Hide password' : 'Show password'}
                    >{showAuthPassword ? 'Hide' : 'Show'}</button>
                  </div>
                </Field>

                {authError && (
                  <div className="rounded-[12px] p-3 text-[11px] leading-snug flex items-start gap-2" style={{background:'var(--surface-selected-soft)', border:'1px solid rgba(229,60,45,0.24)', color:'var(--accent)'}}>
                    <Icon name="AlertCircle" size={13} />
                    <div>{authError}</div>
                  </div>
                )}

                {authMode === 'signup' && supabaseStatus === 'failed' && (
                  <label className="flex items-start gap-2 text-[11px] leading-snug cursor-pointer rounded-[12px] border p-3" style={{color:'var(--ink-soft)', borderColor: 'var(--line)', background:'var(--cream)'}}>
                    <input type="checkbox" checked={authAllowLocalOnly} onChange={e => setAuthAllowLocalOnly(e.target.checked)} className="mt-0.5" />
                    <span>I understand this account will only exist in this browser. It won't sync to other devices, and clearing browser data will delete it.</span>
                  </label>
                )}

                <button
                  type="submit"
                  disabled={authMode === 'signup' && supabaseStatus === 'pending'}
                  className="w-full rounded-full py-3 px-5 text-[10px] tracking-[0.18em] uppercase transition disabled:opacity-50"
                  style={{background:'var(--accent)', color:'#fff', border:'1px solid var(--accent)', fontWeight:800, cursor:(authMode === 'signup' && supabaseStatus === 'pending') ? 'not-allowed' : 'pointer'}}
                >
                  {authMode === 'signin' ? 'Sign in' : 'Create account'}
                </button>
              </form>
            </div>
          </section>

          <div className="mt-5 text-center text-[10px] tracking-[0.14em] uppercase" style={{color:'var(--ink-soft)'}}>
            {supabaseStatus === 'connected' ? 'Synced across all your devices' : supabaseStatus === 'pending' ? 'Establishing connection…' : 'Device-only until cloud sync connects'}
          </div>
        </main>
        {showSupabaseModal && (
          <SupabaseModal
            user={user}
            setUser={setUser}
            supaEnabled={supaEnabled}
            setShowSupabaseModal={setShowSupabaseModal}
            setLogs={setLogs}
            setProducts={setProducts}
            setProcedures={setProcedures}
            setEvents={setEvents}
            setColorProfile={setColorProfile}
            setPatternInsight={setPatternInsight}
            setCycleData={setCycleData}
            setHormonalContext={setHormonalContext}
            setSensitivities={setSensitivities}
            setRegimenLogs={setRegimenLogs}
            setUserConcerns={setUserConcerns}
            setCoverRoutine={setCoverRoutine}
            setCounselInsights={setCounselInsights}
            setDailyCoverPick={setDailyCoverPick}
            setWeeklyInsights={setWeeklyInsights}
            toast={toast}
          />
        )}
      </div>
    );
  }

  // === MAIN APP ===
  const tabs = [
    // === LABEL: Check-in (May 29 2026 per Jenni) ===
    // Was "Atelier" — too design-coded for the main daily surface.
    // "Check-in" matches the brand verb used throughout the eyebrow
    // status row, the empty-state CTA, and the user's mental model
    // of why they open the app. Tab id stays 'dashboard' so deep
    // links + analytics don't break.
    { id: 'dashboard', label: 'Check-in', icon: 'Heart' },
    // Regimen sits second per Jenni's nav order — Atelier is the daily home
    // (cover ritual + check-in), Regimen is the deeper edit/build surface
    // for the same ritual, so they belong adjacent.
    { id: 'regimen', label: 'Regimen', icon: 'Layers' },
    // === NAV ORDER SWAP (May 29 2026 per Jenni) ===
    // Journal moved BEFORE Compare. Mental model: record → reflect →
    // analyze → discover. Journal is the source of truth (history);
    // Compare is one lens on that source ("now that I see what
    // happened, let me compare two points"). Frequency curve also
    // tracks: Atelier/Regimen daily, Journal weekly, Compare
    // situational, Insights periodic.
    { id: 'journal', label: 'Journal', icon: 'Sparkles' },
    { id: 'compare', label: 'Compare', icon: 'Eye' },
    // Counsel + Pearls were two separate tabs; per Jenni they're now
    // merged. The 'pearls' tab id remains the canonical landing — its
    // existing sub-tabs (Lessons / Q&A / Saved) already handle the
    // educational surface; Counsel chat is folded in as a new sub-tab.
    // Internal id stays 'pearls' so deep links survive; user-facing
    // label becomes "Counsel" since that's what users invoke it for.
    // Insights = the merged surface for Pearls + Counsel + Recs + Color.
    // Internal id stays 'pearls' so deep links / sub-tab routing survives.
    // User-facing label is "Insights" because that's what the tab IS now —
    // a place for evidence-based notes, conversations, recs, and color.
    { id: 'pearls', label: 'Insights', icon: 'Sparkles' },
    { id: 'about', label: 'About', icon: 'Users' },
  ];

  return (
    <div className="min-h-screen" style={{ background: 'var(--cream)' }}>
      {/* === ONBOARDING OVERLAY (May 2026 — 10-step flow) ===
          Renders full-bleed on top of all app chrome when stage !== 'done'.
          Self-contained: state, step transitions, AI generation, and
          completion handlers all live in this IIFE. Steps share a
          floating-card shell so visual consistency comes from one place.
          On finish, collected data writes into:
            - userConcerns (from goals + skinConditions)
            - userProfile.primaryConcerns, goals, barrierScale,
              diagnosedConditions, currentRx, timeZone
            - products (from shelf step, if user added any)
            - regimenLogs unaffected (logs are user history, not onboarding)

          === PHASE 3E ONBOARDING UX RULE (May 2026) ===
          Onboarding is a SKIPPABLE FIRST DRAFT of the Living Skin Profile,
          not a one-time diagnosis. Maintain these invariants on edits:
            1. Every step after Welcome must render the header (back arrow
               + progress bar). Welcome itself hides the header by design.
            2. Every optional step has a Skip path. Header "Skip" covers
               photo/goals/experience/tolerance/clinical/shelf. Steps with
               disabled Next (experience, tolerance) ALSO surface inline
               "Skip for now" below the disabled Next so users don't feel
               trapped.
            3. Skipping leaves the corresponding o.* field EMPTY. The
               finishOnboarding spread uses `|| existing` fallbacks so
               skipped fields never overwrite the user's profile with
               guessed defaults. Verify this on any new step you add.
            4. "Not sure" is a valid answer where it makes sense (tolerance
               has 'unsure'). Don't force a binary choice.
            5. The final screen (first-routine) frames the deliverable as
               a FIRST DRAFT with "refine anytime" copy. Future writeback
               from app-observed patterns (Phase 3H+) must NOT overwrite
               user-entered fields without explicit confirmation.
          A regression in any of these is a real bug — the previous
          onboarding had a back-arrow that didn't work and gated Next
          buttons that made users think they had to pick, both fixed in
          Phase 3E. Don't reintroduce. */}
      {onboardingResolved && onboardingState.stage !== 'done' && (
        <OnboardingOverlay
          onboardingState={onboardingState}
          updateOnboarding={updateOnboarding}
          userProfile={userProfile}
          setUserProfile={setUserProfile}
          userConcerns={userConcerns}
          setUserConcerns={setUserConcerns}
          products={products}
          setProducts={setProducts}
          homeDevices={homeDevices}
          logs={logs}
          regimenLogs={regimenLogs}
          setRegimenLogs={setRegimenLogs}
          homeUploadInputRef={homeUploadInputRef}
          setCameraDestination={setCameraDestination}
          setShowGuidedCaptureModal={setShowGuidedCaptureModal}
          setGuidedCaptureCtx={setGuidedCaptureCtx}
          setShowProductModal={setShowProductModal}
          setCoverRoutineRebuildToken={setCoverRoutineRebuildToken}
          saveData={saveData}
          toast={toast}
          setProductEntryMode={setProductEntryMode}
          retryLogAnalysis={retryLogAnalysis}
          setApiKeyState={setApiKeyState}
          setLogs={setLogs}
          user={user}
          uploadPhotoToStorage={uploadPhotoToStorage}
          setShowPhotoImportQueue={setShowPhotoImportQueue}
          fileToBase64={fileToBase64}
          setActiveTab={setActiveTab}
          setRegimenView={setRegimenView}
        />
      )}
      <header className="border-b sticky top-0 z-30" style={{background:'rgba(255,255,255,0.96)', backdropFilter:'blur(8px)', borderColor:'var(--border-mid)'}}>
        <div className="max-w-7xl mx-auto px-6 py-1.5 flex justify-between items-center">
          <div className="flex items-center gap-8 min-w-0">
            {/* Compact: just Frida. The 'Est. 2026 · Tang & Gainey' line lives in the global footer. */}
            <div className="font-serif text-base italic leading-none" style={{color:'var(--ink)'}}>Frida</div>
          </div>
          <div className="flex items-center gap-0.5 md:gap-2">
            <button onClick={() => setShowSearch(true)} className="p-1.5 transition hidden md:inline-flex" style={{color:'var(--ink-soft)'}} title="Search (⌘K)">
              <Icon name="Search" size={14} />
            </button>
            {/* === TRAVEL TOGGLE (June 2026 per Jenni — Phase 1) ===
                Airplane icon in the header chrome. State-aware:
                  active=false → outlined ink-soft, tap opens TravelSetupModal
                  active=true → filled accent-blue + days-remaining badge,
                                 tap opens TravelSetupModal in edit mode
                Header position chosen over check-in adjacency because
                travel mode is a CURRENT STATE (visible across every tab),
                not a daily action. Cover banner reinforces state where
                routine swap matters most. */}
            {(() => {
              const tr = userProfile?.travel || null;
              const isTravelActive = !!(tr && tr.active);
              // Days remaining (inclusive of today) — only when active.
              let daysRemaining = null;
              if (isTravelActive && tr.endDate) {
                try {
                  const today = new Date(localDateISO() + 'T00:00:00').getTime();
                  const end = new Date(tr.endDate + 'T00:00:00').getTime();
                  const ms = end - today;
                  daysRemaining = Math.max(0, Math.ceil(ms / (1000 * 60 * 60 * 24)) + 1);
                } catch (_) { daysRemaining = null; }
              }
              const titleText = isTravelActive
                ? `Travel mode on${tr?.destinationLabel ? ' · ' + tr.destinationLabel : ''}${daysRemaining != null ? ' · ' + daysRemaining + 'd left' : ''}`
                : 'Going traveling? Set up travel mode';
              return (
                <button
                  onClick={() => setShowTravelSetupModal(true)}
                  className="p-1.5 transition inline-flex items-center gap-1"
                  style={{
                    color: isTravelActive ? 'var(--accent-blue)' : 'var(--ink-soft)',
                    fontWeight: isTravelActive ? 600 : 400,
                  }}
                  title={titleText}
                  aria-label={titleText}
                  aria-pressed={isTravelActive}
                >
                  <Icon name="Plane" size={14} />
                  {isTravelActive && daysRemaining != null && (
                    <span className="text-[9px] font-semibold" style={{letterSpacing:'0.04em'}}>{daysRemaining}d</span>
                  )}
                </button>
              );
            })()}
            <button onClick={() => setShowApiKeyModal(true)} className="p-1.5 transition" style={{color: apiKey ? 'var(--accent-blue)' : 'var(--accent)'}} title={apiKey ? 'API key set' : 'Set API key for AI features'}>
              <Icon name="Key" size={14} />
            </button>
            <div className="text-right hidden sm:block">
              <div className="text-[8px] tracking-[0.2em] uppercase" style={{color:'var(--ink-soft)'}}>Logged in</div>
              <div className="text-xs font-serif italic leading-tight" style={{color:'var(--ink)'}}>{user.name}{user.cloud && <span className="ml-1" style={{color:'var(--accent-blue)'}} title="Cloud synced">·</span>}</div>
            </div>
            <button onClick={handleSignOut} className="p-1.5 transition hidden md:inline-flex" style={{color:'var(--ink-soft)'}} title="Sign out"><Icon name="LogOut" size={14} /></button>
            {/* Skin Profile header shortcut intentionally stays hidden
                for now (May 2026). The hamburger / menu owns this deeper
                setup flow so the compact header remains focused on daily
                use. The setShowProfileModal API is wired and ProfileModal
                lives at src/components/ProfileModal.jsx — restoring the
                header entry later is a 5-line revert. */}
            {/* Hamburger — opens sidebar with Profile, Cloud sync, sections, account */}
            <button onClick={() => setShowMobileMenu(true)} className="p-1.5 transition" style={{color:'var(--ink-soft)'}} title="Menu" aria-label="Open menu">
              <Icon name="Menu" size={16} />
            </button>
          </div>
        </div>

        <div className="max-w-7xl mx-auto px-6 overflow-x-auto hidden md:block">
          <div className="flex gap-1 -mb-px">
            {tabs.map(t => (
              <button key={t.id} onClick={() => openTopLevelTab(t.id)} className="flex items-center gap-2 px-4 py-3 text-[11px] tracking-[0.15em] uppercase whitespace-nowrap border-b-2 transition" style={{
                borderBottomColor: activeTab === t.id ? 'var(--accent)' : 'transparent',
                color: activeTab === t.id ? 'var(--ink)' : 'var(--ink-soft)'
              }}>
                <Icon name={t.icon} size={13} />
                {t.label}
              </button>
            ))}
          </div>
        </div>
      </header>

      <main className="max-w-7xl mx-auto px-6 py-4 md:py-6 pb-32 md:pb-10">

        {activeTab === 'dashboard' && (
          <HomeDashboard
            activeTab={activeTab}
            user={user}
            userProfile={userProfile}
            userConcerns={userConcerns}
            onboardingState={onboardingState}
            logs={logs}
            products={products}
            procedures={procedures}
            events={events}
            regimenLogs={regimenLogs}
            setRegimenLogs={setRegimenLogs}
            buildPlan={buildPlan}
            buildPlanAccepted={buildPlanAccepted}
            coverRoutine={coverRoutine}
            setCoverRoutine={setCoverRoutine}
            cycleData={cycleData}
            hormonalContext={hormonalContext}
            sensitivities={sensitivities}
            homeDevices={homeDevices}
            generatedProductArt={{}}
            dailyCoverPick={dailyCoverPick}
            todayStr={todayStr}
            ritualSlot={ritualSlot}
            ritualViewDate={ritualViewDate}
            setRitualViewDate={setRitualViewDate}
            setRitualSlot={userSetRitualSlot}
            setShowCheckInModal={setShowCheckInModal}
            setShowCheckInChooser={setShowCheckInChooser}
            setShowCheckInCamera={setShowCheckInCamera}
            setShowHomeUploadPicker={setShowHomeUploadPicker}
            setShowGuidedCaptureModal={setShowGuidedCaptureModal}
            setGuidedCaptureCtx={setGuidedCaptureCtx}
            setShowProductModal={setShowProductModal}
            setEditingProductId={setEditingProductId}
            setProductForm={setProductForm}
            setShowApiKeyModal={setShowApiKeyModal}
            setActiveTab={setActiveTab}
            setJournalViewOverride={setJournalViewOverride}
            setJournalMode={setJournalMode}
            setRegimenView={setRegimenView}
            setCoverRoutineRebuildToken={setCoverRoutineRebuildToken}
            homeUploadInputRef={homeUploadInputRef}
            retryLogAnalysis={retryLogAnalysis}
            callClaude={callClaude}
            saveData={saveData}
            toast={toast}
            setSkinReadDrawerLogId={setSkinReadDrawerLogId}
            buildCoverRoutineRef={buildCoverRoutineRef}
            coverRoutineLoading={coverRoutineLoading}
            setCoverRoutineLoading={setCoverRoutineLoading}
            coverBuildPromptDismissed={coverBuildPromptDismissed}
            dismissCoverBuildPrompt={dismissCoverBuildPrompt}
            noteCardExpanded={noteCardExpanded}
            setNoteCardExpanded={setNoteCardExpanded}
            setSampleRoutinePreview={setSampleRoutinePreview}
            setJournalDayDetail={setJournalDayDetail}
            setOpenLesson={setOpenLesson}
            setRemoveScopePrompt={setRemoveScopePrompt}
            setUsedSomethingElseSheet={setUsedSomethingElseSheet}
            setShowProcedureModal={setShowProcedureModal}
            setShowScoreExplainer={setShowScoreExplainer}
            scoreExplainerSeen={scoreExplainerSeen}
            setScoreExplainerSeen={setScoreExplainerSeen}
            setUserProfile={setUserProfile}
            setShowTravelSetupModal={setShowTravelSetupModal}
          />
        )}

        {activeTab === 'journal' && (
          <JournalView
            activeTab={activeTab}
            logs={logs}
            products={products}
            procedures={procedures}
            regimenLogs={regimenLogs}
            weeklyInsights={weeklyInsights}
            dailyCoverPick={dailyCoverPick}
            journalViewOverride={journalViewOverride}
            setJournalViewOverride={setJournalViewOverride}
            selectMode={selectMode}
            setSelectMode={setSelectMode}
            selectedIds={selectedIds}
            setSelectedIds={setSelectedIds}
            journalMode={journalMode}
            setJournalMode={setJournalMode}
            setShowLogModal={setShowLogModal}
            setEditingLogId={setEditingLogId}
            openCheckInDetailsForLog={openCheckInDetailsForLog}
            setShowProcedureModal={setShowProcedureModal}
            setEditingProcedureId={setEditingProcedureId}
            setShowApiKeyModal={setShowApiKeyModal}
            setShowHomeUploadPicker={setShowHomeUploadPicker}
            setShowCheckInChooser={setShowCheckInChooser}
            setShowPhotoImportQueue={setShowPhotoImportQueue}
            setSkinReadDrawerLogId={setSkinReadDrawerLogId}
            setCompareTimeBeforeId={setCompareTimeBeforeId}
            setCompareTimeAfterId={setCompareTimeAfterId}
            setOpenLesson={setOpenLesson}
            setProductCompareId={setProductCompareId}
            setActiveTab={setActiveTab}
