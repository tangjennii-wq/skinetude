

const { useState, useEffect, useRef, useMemo, useCallback } = React;

// === useTrackedSetter (May 30 2026 — Pattern B coverage policy) ===
// Wraps a React setter so it ALSO bumps a "rebuild token" — used to
// trigger downstream regeneration (cover routine, Suggested Matches,
// etc.) on every mutation that the AI prompt reads. Forgotten bumps
// were a recurring regression class — this wrapper prevents them.
//
//   const setTrackedConcerns = useTrackedSetter(setUserConcerns, bumpCoverToken);
//   setTrackedConcerns([...concerns, 'redness']);   // bumps automatically
//
// Use anywhere a state setter mutates a field that `buildCoverRoutine`'s
// prompt depends on (concerns, sensitivities, profile, products, regimenLogs).
// In practice we lean on companion useEffects watching the field for the
// same effect (and one useEffect catches every call site, including ones
// that bypass the wrapper) — keep this hook around as the explicit-call
// option when callers want belt-and-suspenders coverage.
const useTrackedSetter = (setter, bumpFn) => {
  return useCallback((arg) => {
    setter(arg);
    try { bumpFn && bumpFn(); } catch (_) {}
  }, [setter, bumpFn]);
};

// === ICON HELPER (uses lucide) ===
// Renders lucide icons declaratively from their descriptor tree instead of via
// imperative DOM mutation. Old approach used useEffect + ref to inject the SVG
// AFTER mount — that was racy on mobile (sometimes the effect didn't fire on
// the bottom nav, leaving labels with no icons). The descriptor format is
// ["svg", attrs, children[]] where children is also descriptor tuples — we
// just walk the tree with React.createElement.
const renderLucideNode = (node, key) => {
  if (!Array.isArray(node)) return null;
  const [tag, attrs, children] = node;
  // Lucide attrs use kebab-case (stroke-width, stroke-linecap). Convert to
  // React's camelCase props for the SVG attributes that need it.
  const reactAttrs = { key };
  for (const k in attrs) {
    if (k === 'stroke-width') reactAttrs.strokeWidth = attrs[k];
    else if (k === 'stroke-linecap') reactAttrs.strokeLinecap = attrs[k];
    else if (k === 'stroke-linejoin') reactAttrs.strokeLinejoin = attrs[k];
    else if (k === 'fill-rule') reactAttrs.fillRule = attrs[k];
    else if (k === 'clip-rule') reactAttrs.clipRule = attrs[k];
    else reactAttrs[k] = attrs[k];
  }
  const kids = Array.isArray(children) ? children.map((c, i) => renderLucideNode(c, i)) : null;
  return React.createElement(tag, reactAttrs, kids);
};
const Icon = ({ name, size = 16, className = '', style = {}, ...props }) => {
  const desc = (window.lucide && (window.lucide.icons[name] || window.lucide.icons.Circle)) || null;
  if (!desc) return <span className={`inline-flex ${className}`} style={{ width: size, height: size, ...style }} {...props} />;
  // Override the default 24x24 with the requested size.
  const [tag, attrs, children] = desc;
  const sized = [tag, { ...attrs, width: size, height: size }, children];
  return (
    <span className={`inline-flex ${className}`} style={{ width: size, height: size, ...style }} {...props}>
      {renderLucideNode(sized, 'icon')}
    </span>
  );
};

// === STABLE COMPONENTS (defined OUTSIDE App so they don't re-mount on every keystroke) ===
const inputCls = "w-full px-3 py-2.5 border rounded-md text-sm focus:outline-none transition font-light";
const primaryBtn = "w-full py-3 tracking-widest text-xs uppercase transition";

const Field = ({ label, children }) => (
  <div>
    <label className="block text-[10px] uppercase tracking-[0.15em] mb-2 font-medium" style={{color:'var(--ink-soft)'}}>{label}</label>
    {children}
  </div>
);

// Renders an image from either a Supabase Storage path (preferred) or a legacy base64
// data URL (during migration). Resolves signed URLs lazily and caches them. Falls back
// to the renderFallback function when there's no source.
const Photo = ({ item, src: srcProp, className = '', style, alt = '', onClick, renderFallback }) => {
  let path = null;
  let legacyDataUrl = null;
  if (typeof srcProp === 'string') {
    if (srcProp.startsWith('data:')) legacyDataUrl = srcProp;
    else path = srcProp;
  } else if (item) {
    const r = _resolvePhotoSource(item);
    path = r.path;
    legacyDataUrl = r.legacyDataUrl;
  }
  const [signedUrl, setSignedUrl] = useState(null);
  useEffect(() => {
    let cancelled = false;
    setSignedUrl(null);
    if (path) {
      getSignedPhotoUrl(path).then(url => { if (!cancelled) setSignedUrl(url); });
    }
    return () => { cancelled = true; };
  }, [path]);
  const displaySrc = legacyDataUrl || signedUrl;
  if (!displaySrc) return renderFallback ? renderFallback() : null;
  return <img src={displaySrc} alt={alt} className={className} style={style} onClick={onClick} />;
};

// === useSyncedArray (May 30 2026 — Pattern A consolidation) ===
// Single source of truth for "saved" arrays (favorites, saved pearls,
// budget list, etc.) that previously each rolled their own
// localStorage + saveData + toast pattern. Stores via both
// localStorage (offline fallback) and saveData (cross-device).
// Caller provides toast wording so each set can stay editorial.
//
//   const [items, toggle, setItems, has] = useSyncedArray({
//     lsKey: 'lumiere:favoriteProducts',
//     cloudKey: 'favoriteProducts',
//     keyFn: (item) => item,                // for sig-based sets
//     onAdd: (item) => 'Saved for later',
//     onRemove: (item) => 'Removed from Saved',
//   });
//
// NOTE on TDZ — `saveData` and `toast` are declared later in App's body
// than where this hook is called (favorites/pearls/budget are wired up
// at the top of App, but saveData lives ~1500 lines down). Pass these
// as getter functions (e.g. `getSaveData: () => saveData`) OR rely on
// the hand-rolled `toastRef`/`saveDataRef` pattern that's already
// elsewhere. We accept both: if `saveData`/`toast` is a function whose
// `.length === 0` it's treated as a getter; otherwise it's called
// directly. Simpler: callers should pass refs like
// `saveData: (...a) => saveData(...a)` so the lookup is deferred.
//
// Returns: [arr, toggle, setAll, has(sigOrItem), setItemsRaw]
// setItemsRaw — raw useState setter; skips cloud + localStorage writes.
// Use ONLY for sign-out wipe (T1 fix May 31 2026) and hydration paths
// (T7 fix) where the source we read from must not be echoed back.
const useSyncedArray = ({ lsKey, cloudKey, keyFn = (x) => x, onAdd, onRemove, toast, saveData }) => {
  const [items, setItems] = useState(() => {
    try { return JSON.parse(localStorage.getItem(lsKey) || '[]'); } catch { return []; }
  });
  const has = (sigOrItem) => {
    const sig = keyFn(sigOrItem);
    return items.includes(sig);
  };
  const setAll = (next) => {
    setItems(next);
    try { localStorage.setItem(lsKey, JSON.stringify(next)); } catch (_) {}
    try { saveData && saveData(cloudKey, next); } catch (_) {}
  };
  const toggle = (item) => {
    const sig = keyFn(item);
    setItems(prev => {
      const wasInSet = prev.includes(sig);
      const next = wasInSet ? prev.filter(s => s !== sig) : [...prev, sig];
      try { localStorage.setItem(lsKey, JSON.stringify(next)); } catch (_) {}
      try { saveData && saveData(cloudKey, next); } catch (_) {}
      try {
        if (wasInSet && onRemove && toast) toast(onRemove(item), 'info');
        else if (!wasInSet && onAdd && toast) toast(onAdd(item), 'info');
      } catch (e) { console.warn('[useSyncedArray toast]', e); }
      return next;
    });
  };
  return [items, toggle, setAll, has, setItems];
};


// === EDITORIAL PRIMITIVES ===
// Small set of reusable building blocks that encode the cover's editorial language
// (eyebrow → serif italic display → ink-soft body, terracotta accent links, cream-deep
// rounded-[20px] section cards). Used across Journal, Compare, Pearls, Counsel, and the
// modal layer so the design stays cohesive without copy-pasting Tailwind class strings.
//
// Why a small set: each primitive captures ONE pattern (typography label / page header /
// section card / italic action link). Composing them keeps page code readable.

// Tracked uppercase eyebrow label — used above titles, as section labels inside cards,
// and as group dividers in lists. Default ink-soft so it whispers, not shouts.
const Eyebrow = ({ children, className = '', style = {}, tone = 'soft', size = 'sm' }) => {
  const color = tone === 'accent' ? 'var(--accent)' : tone === 'ink' ? 'var(--ink)' : 'var(--ink-soft)';
  const sizing = size === 'lg' ? 'text-[11px] tracking-[0.32em]' : 'text-[10px] tracking-[0.3em]';
  return (
    <div className={`${sizing} uppercase ${className}`} style={{color, ...style}}>{children}</div>
  );
};

// Page-level editorial header — eyebrow on top, serif-italic display title, optional
// ink-soft body line, optional terracotta italic action link on the right (no heavy
// black pill — the cover language is a quiet italic CTA). Replaces SectionHeader for
// pages we want to feel editorial; SectionHeader stays available for deeper utility tabs.
const EditorialPageHeader = ({ eyebrow, title, body, action, actionLabel, actionIcon = 'ArrowRight' }) => {
  // When the page action is a "Plus" (i.e. an add CTA like + Product),
  // render it as a proper terracotta-outlined pill button with leading icon
  // — uniform across every section so it reads as the standard add affordance.
  // Other actionIcons stay as the quieter italic text-link (e.g. ArrowRight).
  const isAddCta = actionIcon === 'Plus';
  return (
    <header className="mb-2.5 md:mb-3">
      {eyebrow && <Eyebrow size="lg" className="mb-0.5 md:mb-0.5">{eyebrow}</Eyebrow>}
      <div className="flex items-end justify-between gap-2 md:gap-3 flex-wrap">
        <h1 className="font-serif italic text-[23px] md:text-[28px] leading-[1.05] tracking-tight" style={{color:'var(--ink)'}}>
          {title}
        </h1>
        {action && actionLabel && (
          isAddCta ? (
            <button
              onClick={action}
              className="text-[9px] md:text-[10px] tracking-[0.18em] md:tracking-[0.2em] uppercase rounded-full px-3 py-1.5 md:px-3.5 flex items-center gap-1.5 transition hover:opacity-90 border mb-0.5 md:mb-1 cursor-pointer"
              style={{borderColor: 'var(--line)', color:'var(--accent)', background:'transparent', cursor:'pointer'}}
              title={`Add ${actionLabel.toLowerCase()}`}
            >
              <Icon name="Plus" size={11} /> {actionLabel}
            </button>
          ) : (
            <button
              onClick={action}
              className="text-[10.5px] tracking-[0.18em] uppercase italic flex items-center gap-1 transition hover:opacity-70 pb-1.5"
              style={{color:'var(--accent)'}}
            >
              {actionLabel} <Icon name={actionIcon} size={11} />
            </button>
          )
        )}
      </div>
      {body && (
        <p className="text-[11px] md:text-[11px] leading-snug md:leading-relaxed mt-0.5 md:mt-1" style={{color:'var(--ink-soft)'}}>{body}</p>
      )}
    </header>
  );
};

// Editorial section card — rounded-[20px] cream-deep panel with line border. Optional
// eyebrow + title strip at the top so card-internal headings stay consistent. Pass
// `pad="tight"` for denser content (modals, compact lists) or `pad="none"` to take
// over padding entirely (e.g., a card whose body is its own custom layout).
// === InsightsReadRow (Jun 1 2026 per Jenni — unified Reads panel) ===
// Flush row used inside the Insights Watch+Reads panel. No per-row
// border or background — the parent panel owns the chrome; rows are
// separated by hairline dividers (parent uses divide-y). Pattern:
//   eyebrow · title              chevron
//   (expanded body)
// Action tiles (Overlap with action) route on click; non-action tiles
// toggle expand. Caution state shows a small gold dot before the
// eyebrow instead of recoloring the whole tile background.
const InsightsReadRow = ({ tile }) => {
  // June 2026 (Tier B): tile.defaultExpanded lets a tile show its body
  // without requiring a tap. Used for the Ingredient tile now that it's
  // the only remaining Reads tile — the supporting copy IS the point.
  const [expanded, setExpanded] = React.useState(!!tile.defaultExpanded);
  const isAction = !!tile.action;
  const handleClick = () => { if (isAction) tile.action(); else setExpanded(v => !v); };
  return (
    <li>
      <button
        type="button"
        onClick={handleClick}
        className="w-full text-left flex items-start justify-between gap-3 px-4 py-3 transition hover:bg-[var(--cream)]"
        style={{cursor:'pointer'}}
        aria-expanded={isAction ? undefined : expanded}
      >
        <div className="min-w-0 flex-1">
          <div className="flex items-center gap-1.5 text-[9px] tracking-[0.22em] uppercase mb-1" style={{color:'var(--ink-soft)', fontWeight:650}}>
            {tile.caution && <span className="w-1.5 h-1.5 rounded-full" style={{background:'var(--gold)'}} />}
            <span>{tile.label}</span>
          </div>
          <div className="text-[12.5px] leading-snug capitalize" style={{color:'var(--ink)', fontWeight:650}}>{tile.title}</div>
          {expanded && tile.body && (
            <div className="text-[10.5px] mt-1.5 leading-snug" style={{color:'var(--ink-soft)'}}>{tile.body}</div>
          )}
        </div>
        <Icon name={isAction ? 'ChevronRight' : (expanded ? 'ChevronUp' : 'ChevronDown')} size={13} style={{color:'var(--ink-soft)', marginTop:3, flexShrink: 0}} />
      </button>
    </li>
  );
};

// === CompactSignalTile (May 30 v3 per Jenni) ===
// Collapsed-by-default row for Journal Signals tab. Major signal as
// title/preview; tap to expand body. Action tiles route on click.
const CompactSignalTile = ({ tile }) => {
  const [expanded, setExpanded] = React.useState(false);
  const isAction = !!tile.action;
  const handleClick = () => { if (isAction) tile.action(); else setExpanded(v => !v); };
  return (
    <button
      type="button"
      onClick={handleClick}
      className="rounded-[14px] border p-3 text-left w-full transition hover:border-[var(--accent)]"
      style={{background: tile.bg, borderColor: 'var(--line)', cursor: 'pointer'}}
      aria-expanded={isAction ? undefined : expanded}
    >
      <div className="flex items-start justify-between gap-2">
        <div className="min-w-0 flex-1">
          <div className="text-[9px] tracking-[0.2em] uppercase mb-1" style={{color:'var(--ink-soft)', fontWeight:650}}>{tile.label}</div>
          <div className="text-[13px] leading-tight capitalize" style={{color:'var(--ink)', fontWeight:700}}>{tile.title}</div>
          {(expanded || isAction === false) && tile.body && (expanded || !tile.body) ? null : null}
          {expanded && (
            <div className="text-[10.5px] mt-1.5 leading-snug" style={{color:'var(--ink-soft)'}}>{tile.body}</div>
          )}
        </div>
        <Icon name={isAction ? 'ChevronRight' : (expanded ? 'ChevronUp' : 'ChevronDown')} size={13} style={{color:'var(--ink-soft)', marginTop:2, flexShrink: 0}} />
      </div>
    </button>
  );
};

const EditorialCard = ({ children, eyebrow, title, action, actionLabel, actionIcon = 'ArrowRight', pad = 'normal', className = '', style = {} }) => {
  const padCls = pad === 'tight' ? 'px-4 py-4 md:px-5 md:py-5' : pad === 'none' ? '' : 'px-5 py-5 md:px-6 md:py-6';
  return (
    <section
      className={`rounded-[20px] relative ${padCls} ${className}`}
      style={{background:'var(--cream-deep)', border: '1.5px solid var(--accent)', boxShadow: '0 1px 2px rgba(229,60,45,0.06), 0 8px 22px rgba(229,60,45,0.06)', ...style}}
    >
      {(eyebrow || title || actionLabel) && (
        <div className="flex items-center justify-between gap-3 mb-3">
          <div className="min-w-0">
            {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
            {title && (
              <h2 className="font-serif italic text-[20px] md:text-[24px] leading-[1.15] mt-0.5" style={{color:'var(--ink)'}}>
                {title}
              </h2>
            )}
          </div>
          {action && actionLabel && (
            <button
              onClick={action}
              className="text-[10px] tracking-[0.18em] uppercase italic flex items-center gap-1 transition hover:opacity-70 flex-shrink-0"
              style={{color:'var(--accent)'}}
            >
              {actionLabel} <Icon name={actionIcon} size={11} />
            </button>
          )}
        </div>
      )}
      {children}
    </section>
  );
};

// Italic uppercase action link — the terracotta editorial CTA pattern. Use everywhere
// an action wants to whisper rather than shout. For loud CTAs (primary submit, "Log
// ritual") keep using the cover's pill button pattern directly.
const AccentLink = ({ children, onClick, icon, iconAfter = 'ArrowRight', tone = 'accent', size = 'sm', className = '', ...rest }) => {
  const color = tone === 'soft' ? 'var(--ink-soft)' : tone === 'ink' ? 'var(--ink)' : 'var(--accent)';
  const sizing = size === 'lg' ? 'text-[11px] tracking-[0.2em]' : 'text-[10.5px] tracking-[0.18em]';
  return (
    <button
      onClick={onClick}
      className={`${sizing} uppercase italic flex items-center gap-1 transition hover:opacity-70 ${className}`}
      style={{color}}
      {...rest}
    >
      {icon && <Icon name={icon} size={11} />}
      {children}
      {iconAfter && <Icon name={iconAfter} size={11} />}
    </button>
  );
};

// Editorial pill button — the loud-CTA cousin of AccentLink. Two tones: 'accent'
// (terracotta on cream — primary), 'ghost' (cream + line border — subdued). Used for
// "Log ritual", "Same as yesterday", modal Save buttons, etc.
const EditorialPill = ({ children, onClick, icon, tone = 'accent', disabled = false, className = '', ...rest }) => {
  const styles = tone === 'ghost'
    ? {background:'var(--cream)', color:'var(--ink)', border: '1px solid var(--line)'}
    : tone === 'ink'
      ? {background:'var(--ink)', color:'var(--cream)'}
      : {background:'var(--accent)', color:'var(--cream)'};
  return (
    <button
      onClick={onClick}
      disabled={disabled}
      className={`rounded-full px-4 py-2 text-[10.5px] tracking-[0.18em] uppercase flex items-center gap-1.5 transition hover:opacity-90 disabled:opacity-50 ${className}`}
      style={styles}
      {...rest}
    >
      {icon && <Icon name={icon} size={11} />}
      {children}
    </button>
  );
};

// Editorial sub-tab toggle — replaces the bordered rectangle/Underline-style tab rows
// scattered around the app. Cream-deep track with rounded pill highlights. Pass `tabs`
// as [{id, label, icon?}] and the controlled value/onChange.
// EditorialSubTabs — pill-row sub-nav.
// Sizing rules tuned so the full label ALWAYS shows in one row on mobile,
// even at 4+ tabs (the most cramped case: e.g. Today/Shelf/Build/Occasions
// or Skin Reads/Timeline/Procedures/Select). To accomplish this:
//   - tracking, padding, font, and gap all step down when tabs.length >= 4
//   - icons hide on mobile when the row is crowded (>=4 tabs)
//   - whitespace-nowrap + no `truncate` so we never ellipsis a word
const EditorialSubTabs = ({ tabs, value, onChange, className = '' }) => {
  const crowded = tabs.length >= 4;
  // Two density tiers — generous (≤3 tabs) vs. compact (≥4 tabs).
  const fontCls = crowded ? 'text-[9.5px]' : 'text-[10.5px]';
  const trackCls = crowded ? 'tracking-[0.12em]' : 'tracking-[0.18em]';
  const padCls = crowded ? 'py-2 px-1.5' : 'py-2 px-3';
  const gapCls = crowded ? 'gap-1' : 'gap-1.5';
  const tabTone = () => ({ bg: 'var(--surface-selected)', fg: 'var(--accent)' });
  return (
    <div className={`rounded-full flex p-1 gap-1 ${className}`} style={{background:'var(--cream-deep)', border: '1px solid var(--line)'}}>
      {tabs.map(t => {
        const active = value === t.id;
        const tone = tabTone(t.id);
        return (
          <button
            key={t.id}
            type="button"
            onClick={() => onChange(t.id)}
            className={`flex-1 rounded-full ${padCls} flex items-center justify-center ${gapCls} transition min-w-0`}
            style={{
              background: active ? tone.bg : 'transparent',
              color: active ? tone.fg : 'var(--ink-soft)',
              boxShadow: 'none',
            }}
          >
            {t.icon && (
              // Icon hides on mobile when crowded so the label keeps its room.
              <Icon
                name={t.icon}
                size={12}
                className={crowded ? 'hidden md:inline-block' : ''}
                style={{color: active ? tone.fg : 'var(--ink-soft)'}}
              />
            )}
            <span className={`${fontCls} ${trackCls} uppercase whitespace-nowrap`}>{t.label}</span>
          </button>
        );
      })}
    </div>
  );
};

// =====================================================================
// CompareMetricInfographic — shared metric quartet (redness, hydration,
// texture, breakouts) showing before→after deltas as arrows + % change,
// mirroring the Cover page's Skin Snapshot card. Used everywhere on the
// Compare tab so each tab's analysis surfaces the same visual language.
//
// Props:
//   before, after — log entries with optional `metricSnapshot` { redness,
//                   hydration, texture, breakouts } level words.
//   ratingDelta   — if provided, also shows a Rating tile on the left.
//
// Renders as a 4-tile grid (or 5-tile if ratingDelta present), each tile
// showing the LATER level word + arrow + % change. Falls back gracefully
// when one or both snapshots are missing.
// =====================================================================
const COMPARE_SCORE_MAP = {
  redness:    { Clear: 100, Low: 80, Mild: 55, Moderate: 30, High: 10 },
  hydration:  { Plump: 100, Good: 80, Balanced: 55, Dry: 30, Parched: 10 },
  texture:    { Smooth: 100, Even: 80, Uneven: 55, Rough: 30, Bumpy: 10 },
  breakouts:  { Clear: 100, Few: 75, Some: 50, Many: 25, Severe: 10 },
  // AI now scores these directly (was previously math-derived from redness × texture).
  barrier:    { Strong: 100, Steady: 80, Holding: 55, Compromised: 30, Stripped: 10 },
  sensitivity:{ Calm: 100, Settled: 80, Tender: 55, Reactive: 30, Inflamed: 10 },
};
const COMPARE_METRIC_KIND = { redness: 'neg', hydration: 'pos', texture: 'pos', breakouts: 'neg', barrier: 'pos', sensitivity: 'pos' };
const compareTitleCase = (w) => w ? w.charAt(0).toUpperCase() + w.slice(1).toLowerCase() : null;
const compareNormalizeWord = (key, raw) => {
  if (!raw) return null;
  const tc = compareTitleCase(String(raw).trim());
  return COMPARE_SCORE_MAP[key] && tc in COMPARE_SCORE_MAP[key] ? tc : null;
};

// === AI SCORE HELPERS ===
// Single source of truth for the AI-derived /10 score that the cover, the
// Skin Read drawer, the Journal timeline, the Compare page, and the product
// impact tiles all show. Averages the 6 metricSnapshot values via SCORE_MAP
// (0-100) then divides by 10.
//
// aiScoreFromLog(log)   → number 0-100 (or null if no snapshot)
// aiScoreOut10(log)     → "8.4" string (or null)
// displayScore(log)     → { ai: "8.4"|null, user: "5.0"|null, primary: string }
//   primary = the score to show as the main number on a card. Prefers AI
//             when available, falls back to user self-rating.
// === REWIRED TO COMPOSITE INDEX v1 (June 2026 per Jenni) ===
// Was: unweighted mean of 6 categorical domains via COMPARE_SCORE_MAP.
// Now: thin wrapper around computeCompositeScore (from compositeIndex.js)
// so every existing surface — cover quartet, MetricTrends grid, Compare
// page, Journal timeline, product impact tiles — picks up the new
// blended math (50% AI photo + 30% noticed chips + 20% felt-sense rating)
// + goal-weighting + sensitivity-removed model invisibly. Back-compat
// preserved: the function signature is unchanged. The `goal` argument
// is optional; callers that pass userProfile?.actionGoal get goal-
// weighted scores, callers that don't get the neutral MAINTENANCE weights.
const aiScoreFromLog = (log, goal) => {
  if (!log) return null;
  // Fast path: legacy logs with metricSnapshot but no rating/chips still
  // resolve via computeCompositeScore — it handles input-mode fallback.
  const result = computeCompositeScore(log, goal);
  return result.composite;
};
const aiScoreOut10 = (log, goal) => {
  const v = aiScoreFromLog(log, goal);
  return v != null ? (v / 10).toFixed(1) : null;
};
// displayScore — same back-compat shape (ai/user/primary) so all callers
// keep working. Additionally exposes the composite mode + warning so
// surfaces can show the "AI photo only — add a rating + chips for a
// fuller read" hint when relevant.
const displayScore = (log, goal) => {
  const ai = aiScoreOut10(log, goal);
  const user = log?.rating != null ? Number(log.rating).toFixed(1) : null;
  const { mode, warning } = computeCompositeScore(log, goal);
  return { ai, user, primary: ai ?? user ?? null, mode, warning };
};

// === COMPARE SHARE-IMAGE GENERATOR ===
// Renders a 1080×1350 (Instagram portrait) PNG of a Compare result —
// before/after photos side-by-side with AI score badges, days-apart caption,
// metric deltas in a strip, and the Frida wordmark watermark. Used by the
// Compare Quick share button. Returns a canvas; caller turns it into a blob
// for share/download.
//
// generateCompareShareCanvas({ beforeUrl, afterUrl, beforeScore, afterScore,
//                               daysApart, beforeDate, afterDate, metricDeltas })
//   beforeUrl / afterUrl: data URLs (post-fetch)
//   beforeScore / afterScore: "8.4" string or null
//   metricDeltas: [{ label, dir, color }] sized array (3 rows recommended)
const generateCompareShareCanvas = async ({
  beforeUrl, afterUrl,
  beforeScore = null, afterScore = null,
  daysApart = null,
  beforeDate = '', afterDate = '',
  metricDeltas = [],
} = {}) => {
  const W = 1080, H = 1350;
  const canvas = document.createElement('canvas');
  canvas.width = W; canvas.height = H;
  const ctx = canvas.getContext('2d');
  // Cream background to match app palette.
  ctx.fillStyle = '#f5f0e8'; ctx.fillRect(0, 0, W, H);
  // Helper — load image as Promise.
  const loadImg = (src) => new Promise((res) => {
    if (!src) return res(null);
    const img = new Image();
    img.onload = () => res(img);
    img.onerror = () => res(null);
    img.src = src;
  });
  const [bImg, aImg] = await Promise.all([loadImg(beforeUrl), loadImg(afterUrl)]);
  // Header — eyebrow + title.
  ctx.fillStyle = '#9c9080';
  ctx.font = '600 26px -apple-system, system-ui, sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText('FRIDA · COMPARE', W / 2, 90);
  ctx.fillStyle = '#2a2520';
  ctx.font = 'italic 56px Georgia, serif';
  if (daysApart != null) ctx.fillText(`${daysApart} ${daysApart === 1 ? 'day' : 'days'} apart`, W / 2, 160);
  // Photo squares — two side-by-side, each 480x480, gap 30, centered.
  const photoSize = 480;
  const gap = 30;
  const totalW = photoSize * 2 + gap;
  const startX = (W - totalW) / 2;
  const photoY = 220;
  const drawPhotoTile = (img, x, label, score, date) => {
    // Border / cream-deep frame.
    ctx.strokeStyle = '#d4cfc3'; ctx.lineWidth = 2;
    ctx.fillStyle = '#ebe5d8';
    ctx.beginPath();
    ctx.roundRect ? ctx.roundRect(x, photoY, photoSize, photoSize, 24) : ctx.rect(x, photoY, photoSize, photoSize);
    ctx.fill(); ctx.stroke();
    // Photo (cover-fit).
    if (img) {
      ctx.save();
      ctx.beginPath();
      ctx.roundRect ? ctx.roundRect(x, photoY, photoSize, photoSize, 24) : ctx.rect(x, photoY, photoSize, photoSize);
      ctx.clip();
      const ratio = Math.max(photoSize / img.width, photoSize / img.height);
      const dw = img.width * ratio, dh = img.height * ratio;
      ctx.drawImage(img, x + (photoSize - dw) / 2, photoY + (photoSize - dh) / 2, dw, dh);
      ctx.restore();
    } else {
      // Fallback — score as big serif italic.
      ctx.fillStyle = '#9c9080';
      ctx.font = 'italic 140px Georgia, serif';
      ctx.textAlign = 'center';
      ctx.fillText(score || '—', x + photoSize / 2, photoY + photoSize / 2 + 50);
    }
    // Label badge — "Before" / "After" top-left of the photo.
    ctx.fillStyle = 'rgba(245,240,232,0.94)';
    const badgeW = 140, badgeH = 44;
    ctx.beginPath();
    ctx.roundRect ? ctx.roundRect(x + 16, photoY + 16, badgeW, badgeH, 8) : ctx.rect(x + 16, photoY + 16, badgeW, badgeH);
    ctx.fill();
    ctx.fillStyle = '#2a2520';
    ctx.font = '600 18px -apple-system, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(label.toUpperCase(), x + 16 + badgeW / 2, photoY + 16 + badgeH / 2 + 6);
    // Score + date footer
    ctx.fillStyle = '#2a2520';
    ctx.textAlign = 'center';
    ctx.font = 'italic 32px Georgia, serif';
    if (score) {
      ctx.fillStyle = '#c2622a';
      ctx.fillText(`✦ ${score}`, x + photoSize / 2, photoY + photoSize + 56);
      ctx.fillStyle = '#9c9080';
      ctx.font = '20px -apple-system, sans-serif';
      ctx.fillText(date, x + photoSize / 2, photoY + photoSize + 90);
    } else {
      ctx.fillStyle = '#9c9080';
      ctx.font = '22px -apple-system, sans-serif';
      ctx.fillText(date, x + photoSize / 2, photoY + photoSize + 56);
    }
  };
  drawPhotoTile(bImg, startX, 'Before', beforeScore, beforeDate);
  drawPhotoTile(aImg, startX + photoSize + gap, 'After', afterScore, afterDate);
  // Metric deltas strip (optional). Up to 4 chips, centered under photos.
  if (metricDeltas && metricDeltas.length > 0) {
    const chipsY = photoY + photoSize + 150;
    const chipW = 200, chipH = 70, chipGap = 16;
    const chipsTotal = metricDeltas.length * chipW + (metricDeltas.length - 1) * chipGap;
    const chipsStart = (W - chipsTotal) / 2;
    metricDeltas.forEach((m, i) => {
      const cx = chipsStart + i * (chipW + chipGap);
      ctx.fillStyle = '#fbf7ee';
      ctx.strokeStyle = '#d4cfc3';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.roundRect ? ctx.roundRect(cx, chipsY, chipW, chipH, 14) : ctx.rect(cx, chipsY, chipW, chipH);
      ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#9c9080';
      ctx.font = '600 14px -apple-system, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(m.label.toUpperCase(), cx + chipW / 2, chipsY + 24);
      ctx.fillStyle = m.color || '#2a2520';
      ctx.font = 'italic 24px Georgia, serif';
      ctx.fillText(m.dir || '—', cx + chipW / 2, chipsY + 54);
    });
  }
  // Watermark — "Frida" italic serif bottom-center.
  ctx.fillStyle = '#9c9080';
  ctx.font = 'italic 36px Georgia, serif';
  ctx.textAlign = 'center';
  ctx.fillText('Frida', W / 2, H - 50);
  return canvas;
};

// === ICS GENERATOR ===
// Builds an iCalendar (RFC 5545) file for a recurring weekly Sunday Digest
// reminder. Handed to the browser as a download — Apple Calendar, Google
// Calendar, Outlook all consume the same format. No third-party dependency.
//
// downloadIcsReminder({ title, description, hour, minute })
//   - title: event title shown in the user's calendar
//   - description: longer description / link
//   - hour/minute: local time of day for the recurring reminder
//
// Anchors the first occurrence on the next upcoming Sunday at the given
// time, then RRULE:FREQ=WEEKLY recurs every Sunday forever.
const downloadIcsReminder = ({ title = 'Frida · Sunday Digest', description = 'Your weekly skin read.', hour = 9, minute = 0 } = {}) => {
  // Compute next Sunday at the requested time, in local time.
  const now = new Date();
  const target = new Date(now);
  const daysUntilSunday = (7 - now.getDay()) % 7 || 7; // 0=Sunday → next Sunday
  target.setDate(now.getDate() + daysUntilSunday);
  target.setHours(hour, minute, 0, 0);
  const pad2 = (n) => String(n).padStart(2, '0');
  const fmt = (d) => `${d.getFullYear()}${pad2(d.getMonth() + 1)}${pad2(d.getDate())}T${pad2(d.getHours())}${pad2(d.getMinutes())}00`;
  const dtstart = fmt(target);
  const end = new Date(target.getTime() + 30 * 60 * 1000); // 30 min event
  const dtend = fmt(end);
  const stamp = fmt(new Date());
  const uid = `etude-sunday-${target.getTime()}@etude.app`;
  // Note: TZID omitted — using floating local time so the event lands at
  // 9:00 AM in whatever timezone the user opens the calendar in.
  const ics = [
    'BEGIN:VCALENDAR',
    'VERSION:2.0',
    'PRODID:-//Frida//Sunday Digest//EN',
    'CALSCALE:GREGORIAN',
    'METHOD:PUBLISH',
    'BEGIN:VEVENT',
    `UID:${uid}`,
    `DTSTAMP:${stamp}`,
    `DTSTART:${dtstart}`,
    `DTEND:${dtend}`,
    `SUMMARY:${title}`,
    `DESCRIPTION:${description.replace(/\n/g, '\\n')}`,
    'RRULE:FREQ=WEEKLY;BYDAY=SU',
    'BEGIN:VALARM',
    'ACTION:DISPLAY',
    'DESCRIPTION:Reminder',
    'TRIGGER:-PT5M',
    'END:VALARM',
    'END:VEVENT',
    'END:VCALENDAR',
  ].join('\r\n');
  // Trigger download via blob.
  if (typeof window === 'undefined') return;
  const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'etude-sunday-digest.ics';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(url), 1000);
};

// === EXPORT-AS-JPG HELPER ===
// Wraps html2canvas (loaded via CDN in index.html) to render a DOM node to
// a JPG and trigger a download. Used by the Export buttons on the Compare
// card, Today's Regimen, Today's Analysis drawer, and Cover hero.
//
// `node` — the DOM element to capture (caller passes a ref.current).
// `filename` — output filename without extension (e.g. "etude-regimen-today").
// `opts.bg` — background color injected so the JPG isn't transparent (defaults
//   to cream so it matches the editorial palette out of context).
// `opts.scale` — render scale (2 = retina-quality without ballooning size).
//
// Returns a Promise that resolves to the data URL on success or rejects on
// error. Caller usually wires a toast for both paths.
const exportNodeAsJpg = async (node, filename = 'etude-export', opts = {}) => {
  if (!node) throw new Error('No element to export');
  if (typeof window === 'undefined' || typeof window.html2canvas !== 'function') {
    throw new Error('Export library not loaded yet — give it a moment and try again');
  }
  const { bg = '#FCFBF8', scale = 2, title = 'Frida check-in' } = opts;
  // Render — `useCORS` so cross-origin images (Supabase Storage photos) draw
  // instead of going blank; `backgroundColor` paints behind transparent zones.
  const canvas = await window.html2canvas(node, {
    backgroundColor: bg,
    scale,
    useCORS: true,
    allowTaint: false,
    logging: false,
    // Capture above-the-fold scrollable content too — height: scrollHeight
    // catches the full card even when the user has scrolled.
    windowWidth: document.documentElement.scrollWidth,
    windowHeight: document.documentElement.scrollHeight,
  });
  const dateStamp = new Date().toISOString().slice(0,10);
  const fullFilename = `${filename}-${dateStamp}.jpg`;
  // === WEB SHARE API FIRST (May 2026 per Jenni — camera-roll + IG/Twitter) ===
  // iOS 15+ Safari supports navigator.canShare({ files }). When true, the
  // system share sheet opens with EVERY install app that accepts images:
  //   - Photos ("Save Image" → camera roll)
  //   - Instagram (Stories + DM + post)
  //   - X / Twitter
  //   - Messages / Mail / AirDrop / Notes
  //   - Any third-party app declaring image/* support
  // So this single upgrade covers Jenni's "save to camera roll" ask AND the
  // future "export to Instagram / Twitter" ask — no per-app integration
  // required. Falls back to classic anchor download on browsers without
  // file-share support (most desktop browsers, older mobile).
  try {
    const blob = await new Promise((resolve, reject) => {
      canvas.toBlob(b => b ? resolve(b) : reject(new Error('toBlob failed')), 'image/jpeg', 0.94);
    });
    const file = new File([blob], fullFilename, { type: 'image/jpeg' });
    if (typeof navigator !== 'undefined' && typeof navigator.canShare === 'function' && typeof navigator.share === 'function' && navigator.canShare({ files: [file] })) {
      try {
        await navigator.share({ files: [file], title });
        return null; // success via share sheet
      } catch (shareErr) {
        // User dismissed share sheet — silent return. Any other error → fall
        // through to anchor download so the export still completes.
        if (shareErr && shareErr.name === 'AbortError') return null;
        console.warn('[exportNodeAsJpg] share failed, falling back to download:', shareErr);
      }
    }
  } catch (e) {
    console.warn('[exportNodeAsJpg] toBlob/share failed, falling back to download:', e);
  }
  // Fallback: classic anchor-download path (desktop, older browsers).
  const dataUrl = canvas.toDataURL('image/jpeg', 0.94);
  const a = document.createElement('a');
  a.href = dataUrl;
  a.download = fullFilename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  return dataUrl;
};


// === SKIN-READ SHARE CARD BUILDER (May 2026 per Jenni) ===
// Renders an off-screen, purpose-built share image for the Skin Read
// drawer. The live drawer was being captured directly before, which
// included scrollbars, close buttons, and other chrome. This builder
// produces a clean, social-friendly card with just the data.
//
// Two modes:
//   'quick' → photo + score + 4 metric chips. Social-friendly,
//             shareable to Instagram Story / Twitter without
//             exposing private analysis text.
//   'full'  → adds the AI analysis bullets below. Designed for
//             journaling or private sharing.
//
// Caller is responsible for mounting + un-mounting the returned
// element. Element is positioned offscreen via fixed + left:-9999px
// so it never flashes visibly.
const buildSkinReadShareCard = ({ mode, log, snap, scoreOut10, dateLabel, photoUrl, analysisText }) => {
  const wrap = document.createElement('div');
  wrap.style.cssText = [
    'position:fixed', 'left:-9999px', 'top:0',
    'width:420px', 'padding:32px 28px',
    'background:#FFFFFF',
    'font-family:Figtree,Inter,sans-serif',
    'color:#2A2520',
    'box-sizing:border-box',
  ].join(';');
  const esc = (s) => String(s || '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
  const titleCase = (w) => w ? String(w).charAt(0).toUpperCase() + String(w).slice(1).toLowerCase() : '—';
  const header = `
    <div style="font-size:10px; letter-spacing:0.32em; text-transform:uppercase; color:#E53C2D; font-weight:600; margin-bottom:6px;">Frida · Skin Read</div>
    <div style="font-size:11px; color:#635852; margin-bottom:18px;">${esc(dateLabel)}</div>
  `;
  const photoBlock = photoUrl ? `
    <div style="position:relative; margin-bottom:18px;">
      <img src="${esc(photoUrl)}" crossorigin="anonymous" style="display:block; width:100%; aspect-ratio:1; object-fit:cover; border-radius:24px;" />
      ${scoreOut10 != null ? `<div style="position:absolute; right:12px; bottom:12px; background:rgba(255,255,255,0.96); border:1px solid rgba(229,60,45,0.18); border-radius:16px; padding:6px 12px; text-align:center; min-width:54px;">
        <div style="font-size:22px; color:#E53C2D; font-weight:700; line-height:1;">${esc(scoreOut10)}</div>
        <div style="font-size:8px; color:#E53C2D; font-weight:500; letter-spacing:0.02em; margin-top:2px;">today</div>
      </div>` : ''}
    </div>
  ` : '';
  const metrics = ['hydration','barrier','redness','breakouts'];
  const chipsBlock = `<div style="display:flex; gap:6px; margin-bottom:${mode === 'full' ? '18px' : '0'};">
    ${metrics.map(k => `
      <div style="flex:1; background:#FFFFFF; border:1px solid rgba(229,60,45,0.16); border-radius:12px; padding:10px 6px; text-align:center; min-width:0;">
        <div style="font-size:8px; letter-spacing:0.18em; text-transform:uppercase; color:#635852; font-weight:600; margin-bottom:4px;">${esc(k)}</div>
        <div style="font-size:12px; color:#2A2520; font-weight:600;">${esc(titleCase(snap?.[k]))}</div>
      </div>
    `).join('')}
  </div>`;
  const analysisBlock = (mode === 'full' && analysisText) ? `
    <div style="background:#FFFFFF; border:1px solid rgba(229,60,45,0.16); border-radius:14px; padding:16px;">
      <div style="font-size:9px; letter-spacing:0.26em; text-transform:uppercase; color:#E53C2D; font-weight:600; margin-bottom:10px;">Frida analysis</div>
      <div style="font-size:12px; line-height:1.55; color:#2A2520; white-space:pre-wrap; word-break:break-word;">${esc(analysisText)}</div>
    </div>
  ` : '';
  const watermark = `<div style="margin-top:18px; font-size:9px; letter-spacing:0.22em; text-transform:uppercase; color:#9C8F86; text-align:center;">Frida · a study in your skin</div>`;
  wrap.innerHTML = header + photoBlock + chipsBlock + analysisBlock + watermark;
  return wrap;
};

// =====================================================================
// === DEFENSIVE PRIMITIVES — single source of truth for recurring bugs ==
// =====================================================================
//
// Four reusable helpers that address the four most-repeated bug patterns
// in this codebase. Use these EVERYWHERE instead of inlining the pattern,
// so future bugs of these shapes become structurally impossible.
//
//   1. getRitualForDate     → consistent ritual lookup w/ shelf fallback
//   2. StableTextInput      → typing-freeze-proof text input
//   3. callClaudeGuarded    → AI hang-proof Claude wrapper (used in App)
//   4. (useModalScrollPreserve already exists at App scope)

// === 1. getRitualForDate ===
// Returns {amProducts, pmProducts, source, raw} for a given date.
//   source: 'submitted' (formally submitted regimen log)
//         | 'draft' (regimen log exists but not submitted)
//         | 'shelf-default' (no log; fall back to product.useTimes)
//         | 'empty' (no log AND no shelf defaults — first-run user)
// USE THIS EVERYWHERE a surface needs to display "what's the ritual for
// date X" — cover, regimen, day sheet, edit modal, sunday digest. One
// fallback chain instead of three different inline implementations.
const getRitualForDate = (date, regimenLogs = [], products = []) => {
  const activeShelf = (products || []).filter(p => !p.endDate);
  const productById = Object.fromEntries(activeShelf.map(p => [p.id, p]));
  const submitted = (regimenLogs || []).find(r => r.date === date && r.submitted);
  const draft = !submitted ? (regimenLogs || []).find(r => r.date === date) : null;
  const sourceLog = submitted || draft;
  if (sourceLog) {
    return {
      amProducts: (sourceLog.amProducts || []).map(id => productById[id]).filter(Boolean),
      pmProducts: (sourceLog.pmProducts || []).map(id => productById[id]).filter(Boolean),
      source: submitted ? 'submitted' : 'draft',
      raw: sourceLog,
    };
  }
  // === MAY 2026 BUG FIX — built-pattern gate ===
  // Previously: if no log existed for `date`, this returned every product
  // whose useTimes matched AM/PM. For users who hadn't built a routine
  // yet (no cadence set on any product), that dumped the whole shelf into
  // Today's display — 18+ products showing as "your AM routine."
  //
  // New behavior:
  //   - If the user HAS built a weekly pattern (any product has non-default
  //     cadence), derive AM/PM from that pattern for the target weekday.
  //   - If the user has NOT built yet → return EMPTY. The UI shows a
  //     "build a routine to get started" empty state instead of pretending
  //     the shelf-default is the plan.
  //   - User can still manually add products to a day via the editor; that
  //     creates a draft log which takes priority on the next read.
  if (!userHasBuiltPattern(activeShelf)) {
    return { amProducts: [], pmProducts: [], source: 'empty', raw: null };
  }
  const targetDow = (() => {
    try { return new Date(date + 'T00:00:00').getDay(); }
    catch { return new Date().getDay(); }
  })();
  const onTargetDay = (p) => productCadenceDays(p).includes(targetDow);
  const amDefaults = activeShelf.filter(p => onTargetDay(p) && productInAM(p));
  const pmDefaults = activeShelf.filter(p => onTargetDay(p) && productInPM(p));
  return {
    amProducts: amDefaults,
    pmProducts: pmDefaults,
    source: (amDefaults.length || pmDefaults.length) ? 'pattern' : 'empty',
    raw: null,
  };
};

// === 2. StableTextInput ===
// The typing-freeze-proof text input primitive. ALWAYS use this for any
// text input that lives inside an App-defined component. Owns its own
// state internally (module scope, won't unmount on App re-render),
// debounces the commit to parent state by default. Same API surface as
// LocalSearchInput but with a clearer name + enforced contract.
//
// Props:
//   initial      — seed value (uncontrolled — set once on mount)
//   onCommit(v)  — called after debounceMs of no typing
//   onSubmit(v)  — called on Enter
//   debounceMs   — default 140
//   resetKey     — bump to force clear (e.g., after submit)
//   placeholder, className, style — passthroughs
//
// DO NOT pass `value` + `onChange` from App state — that defeats the
// whole point. If you need to display a value that can change externally,
// bump `resetKey` to push the new initial in.
const StableTextInput = React.memo(function StableTextInput({
  initial = '', onCommit, onSubmit, debounceMs = 140, resetKey,
  placeholder, className = '', style = {},
  autoCapitalize = 'off', autoCorrect = 'off', spellCheck = false,
  inputMode, type = 'text',
}) {
  const [val, setVal] = React.useState(initial);
  const timerRef = React.useRef(null);
  React.useEffect(() => {
    if (resetKey === undefined) return;
    setVal(initial);
  }, [resetKey]);
  const handleChange = (e) => {
    const v = e.target.value;
    setVal(v);
    if (onCommit) {
      if (timerRef.current) clearTimeout(timerRef.current);
      timerRef.current = setTimeout(() => onCommit(v), debounceMs);
    }
  };
  const handleKey = (e) => {
    if (onSubmit && e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      if (timerRef.current) clearTimeout(timerRef.current);
      if (onCommit) onCommit(val);
      onSubmit(val, () => setVal(''));
    }
  };
  React.useEffect(() => () => { if (timerRef.current) clearTimeout(timerRef.current); }, []);
  return React.createElement('input', {
    type, value: val,
    onChange: handleChange, onKeyDown: handleKey,
    placeholder, className, style,
    autoCapitalize, autoCorrect, spellCheck, inputMode,
  });
});

// === 3. callClaudeGuarded ===
// Wraps a callClaude(...) call with a hard timeout + auto-clear of a
// tracked analyzing flag. ALWAYS resolves or rejects within timeoutMs,
// no matter what — never leaves a spinner stuck. Use the App-scope
// helper inside App() that closes over callClaude (since callClaude
// itself is App-scope). This module-level version is a Promise.race
// utility that any caller can use against any async function.
//
//   const result = await withTimeout(callClaudePromise, 20000, 'analysis');
//
// On timeout, throws Error('Timeout: <label> exceeded <ms>ms') — the
// caller's catch block can clear the analyzing flag.
const withTimeout = (promise, timeoutMs, label = 'call') => {
  let timer;
  const timeoutPromise = new Promise((_, reject) => {
    timer = setTimeout(() => reject(new Error(`Timeout: ${label} exceeded ${timeoutMs}ms`)), timeoutMs);
  });
  return Promise.race([
    promise.then((v) => { clearTimeout(timer); return v; }, (e) => { clearTimeout(timer); throw e; }),
    timeoutPromise,
  ]);
};

// === STABLE TEXT INPUT (typing-jerk fix) ===
// Many of our modals are defined inside App() — every App re-render creates a new
// function reference, which makes React see a "new component type" and unmount/remount
// the whole modal subtree. Controlled inputs (`value={form.x}` + `onChange → setForm`)
// lose focus on every keystroke under that pattern, producing the visible jerkiness.
// This component lives at module scope (stable identity) and uses an UNCONTROLLED
// input internally — only `defaultValue` is React-controlled, the DOM owns ongoing
// edits. `onChange` writes to a ref/state outside React's render cycle. `onBlur` and
// the parent's commit are how the value gets persisted. Cursor position is preserved
// because the underlying <input> DOM node is never unmounted.
//
// Usage: <StableInput value={form.notes} onChange={(v) => setForm({...form, notes: v})}
//                     placeholder="..." className="..." style={{...}} />
// The component re-syncs `defaultValue` ONLY when `resetKey` changes (e.g. switching
// records). It will NOT re-sync when value changes externally — that's intentional
// (otherwise you'd reintroduce the jerk on every parent setState).
// === LOCAL SEARCH INPUT — owns its own typing state ===
// For inputs whose parent modal/sheet is defined inside App() (so the parent
// re-mounts on every App re-render). Using App-scope state here would cause
// the modal to recreate on every keystroke, unmounting the input and dropping
// focus → "one letter at a time" typing. By keeping the input value INSIDE
// this module-scope component, the parent doesn't need to re-render between
// keystrokes. Only the filtered results render in the parent, via a ref-based
// callback that doesn't trigger React state updates upstream.
//
// Usage:
//   <LocalSearchInput
//     placeholder="Search…"
//     onChange={(v) => filterRef.current = v}      // synchronous, no React update
//     onCommit={(v) => setSomeAppState(v)}         // optional, fires on debounce
//     debounceMs={100}                              // default 100ms
//   />
// The component re-renders ONLY on its own state changes — parent stays still.
const LocalSearchInput = React.memo(function LocalSearchInput({
  placeholder, className, style, autoFocus, initial = '', resetKey,
  onChange, onCommit, onSubmit, debounceMs = 100, as = 'input', rows,
}) {
  const [val, setVal] = React.useState(initial);
  const timerRef = React.useRef(null);
  // Optional external reset — caller bumps resetKey to force clear (e.g.
  // after the user picks a suggestion and we want the search field empty).
  React.useEffect(() => {
    if (resetKey === undefined) return;
    setVal(initial);
  }, [resetKey]);
  const handleChange = (e) => {
    const v = e.target.value;
    setVal(v);
    if (onChange) onChange(v);  // synchronous — write to a ref, no React state
    if (onCommit) {
      if (timerRef.current) clearTimeout(timerRef.current);
      timerRef.current = setTimeout(() => onCommit(v), debounceMs);
    }
  };
  const handleKey = (e) => {
    if (onSubmit && e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      // Flush pending debounced commit before submitting
      if (timerRef.current) { clearTimeout(timerRef.current); }
      if (onCommit) onCommit(val);
      onSubmit(val, () => setVal(''));
    }
  };
  React.useEffect(() => () => { if (timerRef.current) clearTimeout(timerRef.current); }, []);
  const props = {
    value: val,
    onChange: handleChange,
    onKeyDown: handleKey,
    placeholder,
    className,
    style,
    autoCapitalize: 'off',
    autoCorrect: 'off',
    spellCheck: false,
    autoFocus,
  };
  if (as === 'textarea') return React.createElement('textarea', { ...props, rows: rows || 2 });
  return React.createElement('input', { ...props, type: 'text' });
});

// === CHAT INPUT BOX (module scope) ===
// Same lifecycle fix as BrandPicker: owns its own input state so each
// keystroke renders only the textarea instead of the whole Counsel surface.
// Calls onSend(text, reset) on Enter or send-button. reset() clears input.
const ChatInputBox = React.memo(function ChatInputBox({ onSend, disabled, placeholder }) {
  const [val, setVal] = React.useState('');
  const reset = React.useCallback(() => setVal(''), []);
  const send = () => {
    const t = (val || '').trim();
    if (!t || disabled) return;
    onSend(t, reset);
  };
  return (
    <>
      <div className="flex items-end gap-2">
        <textarea
          autoCapitalize="off" autoCorrect="off" spellCheck={false}
          value={val}
          onChange={(e) => setVal(e.target.value)}
          onKeyDown={(e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); } }}
          placeholder={placeholder || 'Type a question…'}
          rows="2"
          className="flex-1 px-3 py-2 border rounded-md text-xs font-light resize-none"
          style={{background:'var(--cream-deep)', borderColor: 'var(--line)', color:'var(--ink)', minHeight:'48px', maxHeight:'48px'}}
        />
        <button
          onClick={send}
          disabled={!val.trim() || disabled}
          className="p-2 rounded-md transition disabled:opacity-40"
          style={{background:'var(--ink)', color:'var(--cream)'}}
        >
          <Icon name="ArrowUp" size={14} />
        </button>
      </div>
      <div className="text-[9px] tracking-[0.15em] uppercase mt-1.5" style={{color:'var(--ink-soft)'}}>
        Enter to send · Shift+Enter for new line
      </div>
    </>
  );
});


// === CardHeader (Phase 1 primitive) ===
// Editorial section eyebrow + optional headline. Standardizes the
// uppercase-eyebrow + bold-headline pattern used across cards.
// (Named CardHeader to avoid collision with the existing page-level
// SectionHeader component used elsewhere.)
// Pass align='center' for centered, 'left' for default left-aligned.
const CardHeader = ({ eyebrow, title, eyebrowColor, align = 'left', titleSize, marginBottom = T.space.lg }) => (
  <div style={{ textAlign: align, marginBottom }}>
    {eyebrow && (
      <div style={{
        fontSize: T.fontSize.eyebrow,
        letterSpacing: T.tracking.eyebrow,
        textTransform: 'uppercase',
        fontWeight: T.weight.medium,
        color: eyebrowColor || 'var(--ink-soft)',
        marginBottom: title ? T.space.sm : 0,
      }}>{eyebrow}</div>
    )}
    {title && (
      <h3 style={{
        fontSize: titleSize || T.fontSize.cardTitle,
        lineHeight: 1.1,
        letterSpacing: '-0.018em',
        fontWeight: T.weight.bold,
        color: 'var(--ink)',
        margin: 0,
      }}>{title}</h3>
    )}
  </div>
);



// === RatingPills (Phase 1 primitive) ===
// 1-5 connected pill rail with numbered pills + optional word labels
// under positions 1/3/5. Selection clears on tap-same. Used in the
// check-in modal's "Overall skin today" section.
const RATING_5_LABELS = { 1: 'Struggling', 3: 'Okay', 5: 'Glowing' };

// === ActionCard (Phase 2 primitive) ===
// Tappable card with icon + title + sub. Two layouts:
//   direction='vertical'   — icon stacked above title+sub (used by
//                            "Also today?" Procedure/Product/Supplement
//                            cards, Where-to-start tiles, Sample
//                            Routines tiles)
//   direction='horizontal' — icon-left + title+sub block + optional
//                            chevron right (used by Refine page Evolve
//                            list rows)
// Variants: 'plain' (cream-deep bg + line border) or 'accent' (soft red tint).
const ActionCard = ({
  icon, iconColor, iconBg, title, sub,
  onClick, direction = 'vertical', variant = 'plain',
  showChevron, badge, disabled = false,
  ...rest
}) => {
  const isVertical = direction === 'vertical';
  const chevron = showChevron !== undefined ? showChevron : !isVertical;
  const variantStyles = {
    plain: {
      background: 'var(--cream-deep)',
      border: '1px solid var(--line)',
    },
    accent: {
      background: 'rgba(229,60,45,0.06)',
      border: '1px solid rgba(229,60,45,0.18)',
    },
  };
  return (
    <button
      type="button"
      onClick={onClick}
      disabled={disabled}
      className="text-left transition hover:bg-[var(--cream-deep)] disabled:opacity-50 disabled:cursor-not-allowed"
      style={{
        ...variantStyles[variant],
        borderRadius: T.radius.md,
        padding: isVertical ? '12px 14px 10px' : '12px 14px',
        cursor: disabled ? 'not-allowed' : 'pointer',
        display: isVertical ? 'flex' : 'flex',
        flexDirection: isVertical ? 'column' : 'row',
        alignItems: isVertical ? 'flex-start' : 'center',
        gap: isVertical ? 6 : 12,
        minHeight: isVertical ? 110 : undefined,
      }}
      {...rest}
    >
      {icon && (
        <span
          className="inline-flex items-center justify-center flex-shrink-0"
          style={{
            width: isVertical ? 30 : 30,
            height: isVertical ? 30 : 30,
            borderRadius: '50%',
            background: iconBg || 'rgba(229,60,45,0.08)',
            border: '1px solid rgba(229,60,45,0.16)',
          }}
        >
          <Icon name={icon} size={13} style={{ color: iconColor || 'var(--accent)' }} />
        </span>
      )}
      <span className="min-w-0 flex-1">
        <span style={{
          display: 'block',
          fontSize: 13,
          color: 'var(--ink)',
          fontWeight: T.weight.semibold,
          letterSpacing: '-0.008em',
          lineHeight: 1.2,
        }}>{title}</span>
        {sub && (
          <span style={{
            display: 'block',
            fontSize: 11.5,
            lineHeight: 1.35,
            color: 'var(--ink-soft)',
            marginTop: 2,
          }}>{sub}</span>
        )}
        {badge && (
          <span style={{
            display: 'inline-block',
            marginTop: 4,
            fontSize: 9.5,
            letterSpacing: '0.18em',
            textTransform: 'uppercase',
            fontWeight: T.weight.semibold,
            color: 'var(--accent)',
          }}>{badge}</span>
        )}
      </span>
      {chevron && !isVertical && (
        <Icon name="ChevronRight" size={13} style={{ color: 'var(--ink-soft)', flexShrink: 0 }} />
      )}
    </button>
  );
};



// === MOVED to src/resolvers/resolveContextSummary.js (PR 4) ===


// ============================================================================
// === parseSkinMetrics — DO NOT TIGHTLY COUPLE TO UI / DESIGN ================
// ============================================================================
// CRITICAL: this helper is the single source of truth for extracting the six
// per-photo skin metrics (redness/hydration/texture/breakouts/barrier/sensitivity)
// from a Claude analysis response. The cover snapshot card AND the SkinRead
// drawer both depend on the resulting metricSnapshot to display the dotted-
// quartet, the trend sparkline, and the AI rating chip.
//
// JENNI's RECURRING BUG: design refactors keep accidentally erasing the metrics
// rendering on the cover. The historical root cause was a brittle parser that
// ONLY recognized "METRICS: key=Value, key=Value..." on a dedicated line. When
// Claude (especially Haiku under temperature noise) inlined the same key=Value
// pairs at the end of a bullet, the regex missed them and metricSnapshot stayed
// null — leaving the cover stuck on "Photo logged. Tap to generate analysis."
//
// THIS PARSER IS DEFENSIVE — keep it that way:
//   1. First tries the explicit METRICS: line (preferred path).
//   2. Falls back to scanning the WHOLE response for key=Value patterns.
//   3. Returns the first occurrence per key so duplicates don't clobber.
//   4. Returns null only if BOTH paths find nothing — never a partial object
//      that would render as a half-empty snapshot.
//
// Used by:
//   - SkinLog handleSubmit inline analysis (handleSubmit's allSettled block)
//   - retryLogAnalysis (cover auto-recovery + drawer manual retry)
//   - any future analysis path that produces the same prompt format
//
// If you're moving / renaming / refactoring — leave this function in place
// and keep its callers wired. Removing it WILL break the cover quartet.
// === MOVED to src/resolvers/parseSkinMetrics.js (PR 1) ===
// SKIN_METRIC_KEYS, SKIN_REGION_VALUES, parseSkinRegion,
// stripAnalysisStructuredLines, parseSkinMetrics — all concatenated
// from src/ by build_current.js before this sidecar.

// === SHELF DEDUPE HELPERS ===
// Used by the ProductModal save path to warn before creating a duplicate
// product. Catches exact matches, near-duplicates (Levenshtein distance ≤ 2
// on normalized name + same brand), and substring containment ("C-Firma"
// vs "C-Firma Fresh Serum"). Returns the EXISTING shelf product or null.
const normalizeProductString = (s) =>
  (s || '')
    .toLowerCase()
    .replace(/[^\p{L}\p{N}\s]+/gu, ' ')
    .replace(/\s+/g, ' ')
    .trim();
const levenshtein = (a, b) => {
  if (a === b) return 0;
  if (!a.length) return b.length;
  if (!b.length) return a.length;
  if (Math.abs(a.length - b.length) > 6) return Math.max(a.length, b.length); // cheap early-out
  const m = a.length, n = b.length;
  let prev = new Array(n + 1);
  for (let j = 0; j <= n; j++) prev[j] = j;
  for (let i = 1; i <= m; i++) {
    const curr = [i];
    for (let j = 1; j <= n; j++) {
      curr[j] = a[i - 1] === b[j - 1]
        ? prev[j - 1]
        : 1 + Math.min(prev[j], curr[j - 1], prev[j - 1]);
    }
    prev = curr;
  }
  return prev[n];
};
// === ACTIVE + PERCENT PARSER ===
// Splits "Niacinamide 10%, Hyaluronic Acid, Vitamin C 15%" into structured
// pairs. Used by both the duplicate detector (functional clinical match)
// and any future logic that reasons about strength.
const parseActivesWithPct = (str) => {
  if (!str) return [];
  return String(str).split(/[,;]/).map(part => {
    const s = part.trim().toLowerCase();
    if (!s) return null;
    const pctMatch = s.match(/\b(\d+(?:\.\d+)?)\s*%/);
    const pct = pctMatch ? parseFloat(pctMatch[1]) : null;
    const name = s.replace(/\b\d+(?:\.\d+)?\s*%/g, '').trim();
    return name ? { name, pct } : null;
  }).filter(Boolean);
};
// Primary active = highest-pct entry if any have pct, else first listed.
// The "primary" is what we compare across products for clinical dupe checks.
const primaryActive = (actives) => {
  if (!actives || actives.length === 0) return null;
  const withPct = actives.filter(a => a.pct != null);
  if (withPct.length > 0) return withPct.sort((a, b) => b.pct - a.pct)[0];
  return actives[0];
};
// Normalize raw category strings into broad buckets so "10% Niacinamide
// Booster" (serum-tier) doesn't collide with "Niacinamide eye cream."
const normalizeProductCategory = (cat) => {
  const c = String(cat || '').toLowerCase();
  if (c.includes('serum') || c.includes('ampoule') || c.includes('booster')) return 'serum';
  if (c.includes('cream') || c.includes('moisturizer') || c.includes('lotion') || c.includes('balm')) return 'moisturizer';
  if (c.includes('cleanser') || c.includes('wash') || c.includes('foam')) return 'cleanser';
  if (c.includes('toner') || c.includes('essence')) return 'toner';
  if (c.includes('sunscreen') || c.includes('spf')) return 'spf';
  if (c.includes('mask')) return 'mask';
  if (c.includes('eye')) return 'eye';
  if (c.includes('treatment') || c.includes('spot')) return 'treatment';
  if (c.includes('oil')) return 'oil';
  return c || 'other';
};

// === FUNCTIONAL DUPLICATE CHECK (May 2026) ===
// Returns true when two products are clinically the same product:
//   • same primary active (normalized — "niacinamide" matches "niacinamide")
//   • same percentage (±1%) — different strengths are different products
//   • same broad category — 10% niacinamide serum ≠ 10% niacinamide eye cream
//
// Per Jenni's rule: strength is part of the product's identity. 5% / 10% /
// 20% niacinamide are clinically distinct (well-tolerated dose / multi-active
// dose / spot treatment), so they shouldn't flag as duplicates. Only flag
// when active AND dose AND category collide.
const isFunctionalDuplicate = (form, p) => {
  if (!form || !p) return false;
  if (p.endDate) return false; // ignore retired
  const formActives = parseActivesWithPct(form.activeIngredients);
  const pActives = parseActivesWithPct(p.activeIngredients);
  const formPrim = primaryActive(formActives);
  const pPrim = primaryActive(pActives);
  if (!formPrim || !pPrim) return false;
  // Active name must match (substring tolerant for "vitamin c" vs "ascorbic acid"
  // we'd need a synonym map; for now exact-after-lowercase is the conservative call).
  if (formPrim.name !== pPrim.name) return false;
  // Category must match (avoids flagging serum vs eye cream of same active+pct).
  if (normalizeProductCategory(form.category) !== normalizeProductCategory(p.category)) return false;
  // Percent comparison:
  //   • both unspecified  → match (same active + category, no strength signal)
  //   • one specified     → DIFFERENT (conservative — could be different strengths)
  //   • both specified    → match within ±1%
  if (formPrim.pct == null && pPrim.pct == null) return true;
  if (formPrim.pct == null || pPrim.pct == null) return false;
  return Math.abs(formPrim.pct - pPrim.pct) <= 1;
};

// Returns either { product, reason: 'same-name' | 'same-active-strength' }
// or null. The two reasons let the warning copy differentiate "literally the
// same product" vs "functionally equivalent product."
const findSimilarShelfProduct = (form, products) => {
  if (!form || !Array.isArray(products) || products.length === 0) return null;
  const nName = normalizeProductString(form.name);
  const nBrand = normalizeProductString(form.brand);
  // === PASS 1: same-name detection ===
  if (nName || nBrand) {
    for (const p of products) {
      if (p.endDate) continue;
      const pName = normalizeProductString(p.name);
      const pBrand = normalizeProductString(p.brand);
      if (nName && pName === nName && (!nBrand || !pBrand || nBrand === pBrand)) return { product: p, reason: 'same-name' };
      if (nName && pName && nName.length >= 4 && pName.length >= 4 &&
          (nName.includes(pName) || pName.includes(nName)) &&
          (!nBrand || !pBrand || nBrand === pBrand)) return { product: p, reason: 'same-name' };
      if (nName && pName && nBrand && nBrand === pBrand) {
        const d = levenshtein(nName, pName);
        if (d <= 2 && Math.min(nName.length, pName.length) >= 6) return { product: p, reason: 'same-name' };
      }
    }
  }
  // === PASS 2: functional clinical duplicate ===
  // Same active + same pct (±1) + same category — different product name
  // and brand but doing the exact same job at the exact same dose.
  for (const p of products) {
    if (isFunctionalDuplicate(form, p)) return { product: p, reason: 'same-active-strength' };
  }
  return null;
};

// ============================================================================
// === WEEKLY SCHEDULING ENGINE (May 2026) ====================================
// ============================================================================
// Rule-based system that decides which days of the week an active should be
// scheduled on, given its frequency and the user's existing pattern. No API
// calls — pure JS deterministic logic. The conflict library encodes
// well-established dermatology pairings (retinoid+AHA same night = bad,
// niacinamide+vit C = fine despite the myth, etc.).

// Active-family detection — maps raw active ingredient strings to a small
// set of canonical families used by the conflict graph. Order matters:
// more specific patterns first (e.g. retinoids before generic "vitamin").
const detectActiveFamily = (activeStr) => {
  const s = String(activeStr || '').toLowerCase();
  if (!s) return null;
  if (/retinol|tretinoin|retinaldehyde|adapalene|tazarotene|trifarotene|granactive/.test(s)) return 'retinoid';
  if (/bakuchiol/.test(s)) return 'bakuchiol'; // retinoid-mimetic, different conflict profile
  if (/salicylic|bha\b/.test(s)) return 'bha';
  if (/glycolic|lactic|mandelic|aha\b|alpha[-\s]?hydroxy/.test(s)) return 'aha';
  if (/gluconolactone|pha\b/.test(s)) return 'pha';
  if (/benzoyl/.test(s)) return 'bpo';
  if (/azelaic/.test(s)) return 'azelaic';
  if (/ascorbic|ascorbyl|ascorbate|vitamin\s*c|c.?ferulic/.test(s)) return 'vitc';
  if (/niacinamide|vitamin\s*b3/.test(s)) return 'niacinamide';
  if (/alpha\s*arbutin|arbutin/.test(s)) return 'arbutin';
  if (/tranexamic/.test(s)) return 'tranexamic';
  if (/kojic/.test(s)) return 'kojic';
  if (/peptide|matrixyl|argireline/.test(s)) return 'peptide';
  if (/ceramide/.test(s)) return 'ceramide';
  if (/centella|cica|madecassoside/.test(s)) return 'centella';
  if (/panthenol|provitamin\s*b5/.test(s)) return 'panthenol';
  if (/hyaluronic|sodium\s*hyaluronate/.test(s)) return 'humectant';
  if (/squalane/.test(s)) return 'emollient';
  if (/sunscreen|spf|zinc\s*ox|titanium\s*diox/.test(s)) return 'spf';
  return null;
};

// === CONFLICT LIBRARY ===
// Symmetric pairings. Tier:
//   'hard'     = never schedule same night/routine
//   'soft'     = avoid if possible, not catastrophic
//   'friendly' = preferred together (boost scheduling probability)
// `note` explains the rule in one line for tooltip/explanation copy.
const ACTIVE_CONFLICTS = [
  // HARD — barrier-compromising stacks
  { a: 'retinoid', b: 'aha', tier: 'hard', note: 'Retinoid + AHA same night compounds irritation. Alternate.' },
  { a: 'retinoid', b: 'bha', tier: 'hard', note: 'Retinoid + BHA same night compounds irritation. Alternate.' },
  { a: 'retinoid', b: 'bpo', tier: 'hard', note: 'Benzoyl peroxide deactivates most retinoids. Use on different days.' },
  { a: 'aha', b: 'bha', tier: 'hard', note: 'Double exfoliation same night thins the barrier fast.' },
  { a: 'vitc', b: 'bpo', tier: 'hard', note: 'BPO oxidizes vitamin C on contact. Space by 30+ min or split AM/PM.' },
  // SOFT — minor stability or sensitivity notes. NOT warnings.
  // These are commonly stacked combos that work fine for most people; the
  // note is a one-time subtle heads-up, not a conflict flag. The Weekly view
  // intentionally does NOT surface soft-tier as warnings (only HARD does).
  { a: 'retinoid', b: 'vitc', tier: 'soft', note: 'Common combo — many use them together daily. Splitting AM (C) / PM (retinoid) gives marginally more stability, but stacking is fine for most. Watch for increased sensitivity when first adding either.' },
  { a: 'peptide', b: 'aha', tier: 'soft', note: 'Mild stability nuance: some peptides degrade in acidic environments. Space by 15 min if you want to be precise — most users don\'t notice a difference.' },
  { a: 'peptide', b: 'bha', tier: 'soft', note: 'Mild stability nuance: some peptides degrade in acidic environments. Space by 15 min if you want to be precise — most users don\'t notice a difference.' },
  // FRIENDLY — clinically preferred together
  { a: 'niacinamide', b: 'vitc', tier: 'friendly', note: "Stacks fine despite the internet's myth — both contribute to brightness." },
  { a: 'niacinamide', b: 'retinoid', tier: 'friendly', note: 'Niacinamide calms retinoid irritation. Stack same night.' },
  { a: 'ceramide', b: 'retinoid', tier: 'friendly', note: 'Ceramides rebuild what retinoid strips. Use as the recovery layer.' },
  { a: 'vitc', b: 'spf', tier: 'friendly', note: 'Vit C extends sunscreen UV protection. AM stack.' },
];

// Symmetric lookup: returns the conflict entry for two families, or null.
const lookupConflict = (famA, famB) => {
  if (!famA || !famB || famA === famB) return null;
  for (const c of ACTIVE_CONFLICTS) {
    if ((c.a === famA && c.b === famB) || (c.a === famB && c.b === famA)) return c;
  }
  return null;
};

// === ACTIVE SYNERGIES (May 2026 — derm-evidence pass) ===
//
// Positive pairings — actives that work synergistically. Used to surface
// "Synergies in your week" callouts in Rotation + flag same-day pairings
// in the Why-this-routine notes. UNLIKE ACTIVE_CONFLICTS, synergies do
// NOT influence scheduling — they're purely informational. The conflict
// logic still governs HARD spacing (retinoid + AHA never same night).
//
// Each entry:
//   pair: alphabetically-sorted [familyA, familyB] for stable lookup
//   boost: short tag (collagen | barrier | tolerance | pigment | etc.)
//   timing: 'same-slot' (both in same AM/PM) | 'either' (anywhere in week)
//   note: one-line derm-evidence rationale for UI surfacing
//
// Reviewed against: derm consensus on stacking, SkinCeuticals antioxidant
// cascade research (vit C+E+ferulic), Ellis-aligned barrier-first guidance,
// well-tolerated brightening combos (azelaic+niacinamide, tranexamic+
// niacinamide). Conflicts that already exist in ACTIVE_CONFLICTS aren't
// re-listed here.
const ACTIVE_SYNERGIES = [
  // === Antioxidant + photoprotection ===
  { pair: ['spf','vitc'],         boost: 'photoprotection', timing: 'same-slot', note: 'Vit C extends UV protection. AM stack.' },
  // === Collagen-building cluster ===
  { pair: ['niacinamide','peptide'], boost: 'collagen', timing: 'either',   note: 'Niacinamide supports ceramide synthesis; peptides cue fibroblasts — collagen-building pair.' },
  { pair: ['peptide','vitc'],       boost: 'collagen', timing: 'either',   note: 'Vit C is required cofactor for collagen synthesis — peptides give it more to build with.' },
  { pair: ['peptide','retinoid'],   boost: 'collagen', timing: 'either',   note: 'Retinoid + peptides: parallel collagen pathways.' },
  // === Barrier support during actives ===
  { pair: ['ceramide','retinoid'],  boost: 'barrier',   timing: 'same-slot', note: 'Ceramides rebuild what retinoids turn over. Stack them.' },
  { pair: ['aha','ceramide'],       boost: 'barrier',   timing: 'same-slot', note: 'Ceramides replace barrier lipids stripped by AHA.' },
  { pair: ['bha','ceramide'],       boost: 'barrier',   timing: 'same-slot', note: 'Ceramides replenish barrier after BHA exfoliation.' },
  { pair: ['panthenol','retinoid'], boost: 'barrier',   timing: 'same-slot', note: 'Panthenol soothes retinoid-related dryness and redness.' },
  // === Irritation tolerance mitigation ===
  { pair: ['niacinamide','retinoid'], boost: 'tolerance', timing: 'same-slot', note: 'Niacinamide reduces retinoid irritation. Stack PM.' },
  { pair: ['centella','retinoid'],    boost: 'tolerance', timing: 'same-slot', note: 'Centella calms retinoid-stressed skin.' },
  // === Pigment / brightening cluster ===
  { pair: ['azelaic','niacinamide'],   boost: 'pigment', timing: 'either', note: 'Brightening + anti-inflammatory — strong post-inflammatory hyperpigmentation pair.' },
  { pair: ['niacinamide','tranexamic'], boost: 'pigment', timing: 'either', note: 'Tranexamic acid + niacinamide for melasma + PIH.' },
  { pair: ['tranexamic','vitc'],       boost: 'pigment', timing: 'either', note: 'Two complementary brightening pathways.' },
  { pair: ['arbutin','niacinamide'],   boost: 'pigment', timing: 'either', note: 'Arbutin (tyrosinase inhibition) + niacinamide (melanosome transfer) = brightening duo.' },
  { pair: ['arbutin','vitc'],          boost: 'pigment', timing: 'either', note: 'Vit C + arbutin: multi-step pigment intervention.' },
  { pair: ['azelaic','vitc'],          boost: 'pigment', timing: 'either', note: 'Azelaic + Vit C: melanin inhibition from two angles.' },
  // === Oil-control / acne ===
  { pair: ['bha','niacinamide'],   boost: 'oil-control', timing: 'either', note: 'BHA decongests pores; niacinamide regulates sebum.' },
  { pair: ['azelaic','bha'],       boost: 'acne',        timing: 'either', note: 'Anti-microbial + decongestion — solid acne pair.' },
  { pair: ['bpo','niacinamide'],   boost: 'acne',        timing: 'same-slot', note: 'BPO kills C. acnes; niacinamide calms the inflammation.' },
  // === Hydration cluster ===
  { pair: ['ceramide','humectant'],  boost: 'hydration', timing: 'same-slot', note: 'Humectants pull water in; ceramides seal it. Layer humectant, then ceramide.' },
  { pair: ['humectant','panthenol'], boost: 'hydration', timing: 'either',    note: 'Both humectant — complementary hydration.' },
  // === Gentle anti-aging ===
  { pair: ['bakuchiol','niacinamide'], boost: 'gentle-aging', timing: 'either', note: 'Bakuchiol (gentle retinoid alt) + niacinamide barrier support — well-tolerated anti-aging.' },
  { pair: ['bakuchiol','peptide'],     boost: 'gentle-aging', timing: 'either', note: 'Bakuchiol + peptides: gentle anti-aging combo.' },
];

// === REFINE INTENT → OPTIMAL ACTIVE FAMILIES (May 2026 — slice 6) ===
//
// Maps each Refine Quick Refinement intent to an ordered list of active
// families known to push that outcome. Used by the RefineSheet picker to
// score user-shelf products and surface the top 3 matches — best match
// preselected — instead of routing the user into AI prose.
//
// Order matters: families earlier in the list = stronger fit for that
// intent. If a user's shelf contains NO product from the top-priority
// family for an intent, the picker surfaces curated alternatives from
// REFINE_CURATED_ALTERNATIVES (cap 2-3).
//
// Intents without a clean family map (simplify / travel) are absent on
// purpose — those route to the Counsel-only fallback.
const REFINE_INTENT_FAMILIES = {
  hydration:  ['humectant', 'ceramide', 'panthenol', 'centella', 'niacinamide'],
  acne:       ['bha', 'azelaic', 'bpo', 'retinoid', 'niacinamide'],
  pigment:    ['vitc', 'azelaic', 'tranexamic', 'arbutin', 'niacinamide'],
  texture:    ['aha', 'bha', 'retinoid', 'azelaic', 'bakuchiol'],
  glow:       ['vitc', 'aha', 'azelaic', 'niacinamide', 'arbutin', 'tranexamic'],
  irritation: ['centella', 'panthenol', 'ceramide', 'niacinamide', 'humectant'],
  recovery:   ['ceramide', 'panthenol', 'centella', 'niacinamide', 'humectant'],
  barrier:    ['ceramide', 'niacinamide', 'panthenol', 'centella', 'humectant'],
  climate:    ['humectant', 'ceramide', 'panthenol', 'spf'],
  // Simplify + Travel intentionally absent — no clean family map.
};

