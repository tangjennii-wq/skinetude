    const close = () => { setShowBulkUploadModal(false); };

    const handleSave = async () => {
      if (items.length === 0) { toast('Pick some photos first', 'error'); return; }
      setSaving(true);
      try {
        const newEntries = items.map((it, i) => ({
          id: Date.now() + i,
