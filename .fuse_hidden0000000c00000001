                        {prodCached ? (
                          <>
                            <div className="text-sm md:text-base font-light leading-relaxed whitespace-pre-line" style={{color:'var(--ink)'}}>{withPearls(formatAnalysisText(prodCached), setOpenLesson)}</div>
