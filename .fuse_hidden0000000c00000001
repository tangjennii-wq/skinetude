                        <span className="text-[10px] tracking-[0.3em] uppercase" style={{color:'var(--ink)'}}>This Week</span>
                        <span className="font-serif italic text-[12px]" style={{color:'var(--ink-soft)'}}>{weekStartLabel} – {weekEndLabel}</span>
                      </div>
                      <button
