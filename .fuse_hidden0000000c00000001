                              line2 = "Steady from last time. Consistency's quietly working.";
                            }
                          }
                          return (
                            <p className="text-[12.5px] leading-snug font-light mb-2" style={{color:'var(--ink)'}}>
                              {line1}<br />
                              <span style={{color:'var(--ink-soft)'}}>{line2}</span>
                            </p>
                          );
                        })()}
                        {profileIncomplete && (
                          <button
                            onClick={() => setShowProfileModal(true)}
                            className="mb-3 inline-flex items-center gap-1.5 transition hover:opacity-80 cursor-pointer"
                            style={{color:'var(--accent)', cursor:'pointer'}}
                            title="Personalize your profile"
                          >
                            <Icon name="Sparkles" size={12} />
                            <span className="text-[13px]" style={{fontWeight:600}}>Personalize your profile</span>
                            <Icon name="ArrowRight" size={12} />
                          </button>
                        )}
                        {hasTodayPhoto && todayAvg != null ? (
                          <div className="flex flex-col">
                            <div className="flex items-baseline gap-1">
                              <div className="leading-none" style={{color:'var(--ink)', fontSize:'26px', fontWeight:700, letterSpacing:'-0.022em'}}>{(todayAvg / 10).toFixed(1)}</div>
                              <div className="leading-none text-[12px]" style={{color:'var(--ink-soft)'}}>/10</div>
                            </div>
                            <div className="text-[8.5px] tracking-[0.28em] uppercase mt-1" style={{color:'var(--ink-soft)', fontWeight:600}}>Skin Read</div>
                            {todayLog?.rating != null && (
                              <div className="text-[10px] mt-0.5" style={{color:'var(--ink-soft)', opacity: 0.7}}>
                                you read: {Number(todayLog.rating).toFixed(1)}
                              </div>
                            )}
                          </div>
                        ) : null}
                      </div>
                    </div>
                    {/* === Metric grid — 2-line editorial pair ===
                        Two columns × two rows: Redness · Hydration / Texture
                        · Breakouts. Labels in quiet sans, descriptors in
                        italic serif (per ChatGPT spec). Replaces the wider
                        4-column tile strip which felt clinical. */}
                    {hasTodayPhoto && !todaySnap && !getApiKey() && (
                      <button
                        onClick={() => setShowApiKeyModal(true)}
                        className="w-full mt-4 mb-1 text-left text-[11px] italic px-3 py-2 rounded-[10px] flex items-center gap-2 transition hover:opacity-80"
                        style={{background:'var(--cream)', border:'1px dashed var(--accent)', color:'var(--accent)'}}
                      >
                        <Icon name="Key" size={11} />
                        <span>Set your Anthropic API key to generate skin metrics →</span>
                      </button>
                    )}
                    {hasTodayPhoto && !todaySnap && getApiKey() && todayLog?.analyzing && (
                      <div className="mt-4 mb-1 text-[11px] italic px-3 py-2 rounded-[10px] flex items-center gap-2" style={{background:'var(--cream)', border:'1px solid var(--line)', color:'var(--ink-soft)'}}>
                        <Icon name="Loader2" size={11} className="spin" />
                        <span>Reading your skin…</span>
                      </div>
                    )}
                    {/* "Tap to read this photo" pill button removed — analysis now
                        auto-fires on every photo upload, and a useEffect (see
                        retryLogAnalysis on mount handler) auto-retries any log
                        that's missing a metricSnapshot when the user lands on
                        the cover. No manual tap required. */}
                    {hasTodayPhoto && todaySnap && (
                      <div className="mt-3 pt-3 border-t" style={{borderColor:'var(--line)'}}>
                        <div className="flex items-stretch justify-between gap-1">
                          {metricSpec.map((m, i) => (
                            <React.Fragment key={m.label}>
                              {i > 0 && (
                                <div className="flex items-center" style={{color:'var(--line)'}}>·</div>
                              )}
                              <div className="flex-1 flex flex-col items-center text-center min-w-0">
                                <span className="text-[10px] tracking-wide" style={{color:'var(--ink-soft)'}}>{m.label}</span>
                                <span className="text-[14px] md:text-[16px] mt-0.5 leading-tight truncate w-full" style={{color: m.level ? 'var(--ink)' : 'var(--ink-soft)', fontWeight:500}}>{(m.level || '—').toLowerCase()}</span>
                              </div>
                            </React.Fragment>
                          ))}
                        </div>
                      </div>
                    )}
                    {/* === DELTA BAND — "since last reading" ===
                        Sits beneath the metric quartet. Three states:
                          1. has prior + has changes → render delta chips
                          2. has prior + no changes  → "Steady — nothing shifted."
                          3. no prior (first log)    → "First reading. Log again tomorrow to surface what shifts."
                        Always renders when we have a snapshot — passive
                        teaching + change-recognition shouldn't be a
                        ghost surface. */}
                    {hasTodayPhoto && todaySnap && (
                      <div className="mt-3 pt-3 border-t" style={{borderColor:'var(--line)'}}>
                        <div className="text-[8.5px] tracking-[0.28em] uppercase mb-2" style={{color:'var(--ink-soft)', fontWeight:600}}>Since last reading</div>
                        {deltaChips.length > 0 ? (
                          <div className="flex flex-wrap gap-1.5">
                            {deltaChips.map(d => (
                              <div
                                key={d.label}
                                className="inline-flex items-center gap-1 px-2 py-1 rounded-full"
                                style={{
                                  background: d.improved ? 'rgba(138, 155, 126, 0.12)' : 'rgba(201, 138, 138, 0.10)',
                                  color: d.improved ? 'var(--sage)' : 'var(--rose)',
                                  border: '1px solid ' + (d.improved ? 'rgba(138, 155, 126, 0.30)' : 'rgba(201, 138, 138, 0.28)'),
                                }}
                              >
                                <Icon name={d.dir === 'up' ? 'ArrowUpRight' : 'ArrowDownRight'} size={10} />
                                <span className="text-[10px]" style={{fontWeight:500}}>{d.label}</span>
                                <span className="text-[10px]" style={{opacity:0.75}}>{(d.from || '').toLowerCase()} → {(d.to || '').toLowerCase()}</span>
