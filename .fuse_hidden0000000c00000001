// Defensive cleanup applied at render time to any AI analysis text. Handles
// older cached analyses that still use the legacy paragraph + **bold** format
// the prompts used to ask for. Specifically:
//   - strips **bold** markdown
//   - normalizes various bullet glyphs (•, ·, *) to "- "
//   - drops the trailing METRICS: line (parsed elsewhere, never displayed)
//   - drops the trailing SUSPECT: line (handled separately if surfaced)
//   - tightens spacing so the bullet block renders cleanly with whitespace-pre-line
const formatAnalysisText = (s) => {
  if (!s || typeof s !== 'string') return '';
  return s
    .replace(/\*\*/g, '')
    .replace(/^\s*[•·*]\s+/gm, '- ')
    .replace(/\n?\s*METRICS:.*$/im, '')
    .replace(/\n?\s*SUSPECT:.*$/im, '')
    // Strip evidence grades [A]/[B]/[C] and "[expert opinion: X]" — Jenni
    // found them noisy and confusing. The grades stay in the AI's reasoning
    // but never surface as visible UI clutter. Also strip the new
    // [ev:level:source] machine tag so it can't leak into displays that
    // bypass the TaggedAnalysisBullets renderer (the EvidenceDot consumes
    // it from parseTaggedBullet directly).
    .replace(/\s*\[[A-C]\]\s*/g, ' ')
    .replace(/\s*\[expert opinion[^\]]*\]\s*/gi, ' ')
    .replace(/\s*\[ev:[a-z]+:[a-z]+\]\s*/gi, ' ')
    .replace(/[ \t]{2,}/g, ' ')
    .replace(/\n{3,}/g, '\n\n')
    .trim();
};

// Parse one analysis line into a typed bullet for the new icon-tagged
// renderer. Returns { type: 'observe'|'cause'|'action'|'plain', text }.
// Recognizes [OBSERVE]/[CAUSE]/[ACTION] tags from the new prompt format.
// Unknown/missing tags fall through as 'plain' so legacy responses still
// render cleanly.
const parseTaggedBullet = (line) => {
  const stripped = line.replace(/^[\s•·*-]+/, '').trim();
  const m = stripped.match(/^\[(OBSERVE|CAUSE|ACTION|MECHANISM|DO|READ)\]\s*/i);
  // Pull the trailing [ev:level:source] tag if present; strip it from
  // display text. Format: [ev:strong:RCT] | [ev:moderate:observational]
  // | [ev:emerging:mechanism] | [ev:emerging:expert].
  const evMatch = stripped.match(/\[ev:(strong|moderate|emerging):(rct|observational|mechanism|expert)\]\s*$/i);
  const evidence = evMatch ? { level: evMatch[1].toLowerCase(), source: evMatch[2].toLowerCase() } : null;
  const noEv = (s) => s.replace(/\s*\[ev:[a-z]+:[a-z]+\]\s*$/i, '').trim();
  if (!m) return { type: 'plain', text: noEv(stripped), evidence };
  const tag = m[1].toUpperCase();
  const text = noEv(stripped.slice(m[0].length));
  if (tag === 'OBSERVE' || tag === 'READ') return { type: 'observe', text, evidence };
  if (tag === 'CAUSE' || tag === 'MECHANISM') return { type: 'cause', text, evidence };
  if (tag === 'ACTION' || tag === 'DO') return { type: 'action', text, evidence };
  return { type: 'plain', text, evidence };
};

// === EVIDENCE DOT ===
// Three filled/hollow dots representing strength: ●●● strong, ●●○ moderate,
// ●○○ emerging. Tap to reveal a small tooltip with the source.
