        const reg = (regimenLogs || []).find(r => r.date === iso);
        const procs = (procedures || []).filter(p => p.date === iso);
        const newProds = (products || []).filter(p => p.startDate === iso);
        const fmt = new Date(iso).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
        const close = () => setJournalDayDetail(null);
        return (
          <Modal title={fmt} onClose={close}>
            <div className="space-y-5">
