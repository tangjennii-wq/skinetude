                      // Touch-swipe handler — fingers right (negative deltaX) = prev week.
                      let touchStartX = null;
                      const onTouchStart = (e) => { touchStartX = e.touches[0]?.clientX ?? null; };
                      const onTouchEnd = (e) => {
