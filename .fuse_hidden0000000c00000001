  // === DAILY REGIMEN CHECK-IN MODAL ===
  // Separate from photo log. Lets the user mark which AM/PM products they actually used,
  // which devices (red light, gua sha, etc.), and lifestyle (sleep, supplements, hydration).
  // One entry per date, keyed by YYYY-MM-DD.
  const RegimenCheckInModal = () => {
    // === DATE-AWARE ===
    // Edits the regimen for whichever date is in ritualViewDate (defaults
    // to today, but user can scrub backward via the cover/regimen scrubber
    // to fix yesterday's log).
    const today = localDateISO();
    const targetDate = ritualViewDate || today;
    const isEditingPrior = targetDate !== today;
    const existing = regimenLogs.find(r => r.date === targetDate);
    const activeProductsList = products.filter(p => !p.endDate);
    // === DATE + SLOT DERIVATION (May 2026 fix) ===
    // Today's defaults must respect BOTH useTimes AND cadence.days for the
    // current weekday — otherwise a Mon-only product appears on Tues, and a
    // PM-only product appears in AM. Uses normalizers to avoid case bugs.
    const targetDow = (() => {
      try { return new Date(targetDate + 'T00:00:00').getDay(); }
      catch { return new Date().getDay(); }
    })();
    const productScheduledOnDow = (p) => {
      const days = productCadenceDays(p);
      return days.includes(targetDow);
    };
    const amProducts = activeProductsList.filter(p => productScheduledOnDow(p) && productInAM(p));
    const pmProducts = activeProductsList.filter(p => productScheduledOnDow(p) && productInPM(p));
    const [form, setForm] = useState(existing ? { ...existing } : {
      date: targetDate,
      amProducts: [],
      pmProducts: [],
      amExtras: [],
      pmExtras: [],
      devices: [],
      sleep: '',
      supplements: [],
      hydration: false,
      sunscreenReapply: false,
      notes: ''
    });
    const [amExtraInput, setAmExtraInput] = useState('');
    const [pmExtraInput, setPmExtraInput] = useState('');
    const [supplementInput, setSupplementInput] = useState('');
    // Scroll preservation across App-induced remounts.
    const scrollSentinelRef = useModalScrollPreserve('checkIn');

    const toggle = (key, value) => setForm(prev => {
      const arr = prev[key] || [];
      return { ...prev, [key]: arr.includes(value) ? arr.filter(x => x !== value) : [...arr, value] };
    });
    const addExtra = (key, val, setter) => {
      const v = val.trim();
      if (!v) return;
      setForm(prev => ({ ...prev, [key]: [...(prev[key] || []), v] }));
      setter('');
      // Only the AM/PM regimen extras represent real products. Supplements stay
      // as text-only. After adding, prompt the user to add it to the shelf as a
      // proper product so it gets ingredients/category/AI art and is reusable.
      if ((key === 'amExtras' || key === 'pmExtras') && !pendingShelfAddRef.current) {
        pendingShelfAddRef.current = { name: v, slot: key === 'amExtras' ? 'am' : 'pm' };
        setPendingShelfAdd({ name: v, slot: key === 'amExtras' ? 'am' : 'pm' });
      }
    };
    const removeExtra = (key, val) => setForm(prev => ({ ...prev, [key]: (prev[key] || []).filter(x => x !== val) }));

    // Hand-drawn-style line SVGs per device. 24×24 viewBox, currentColor stroke so they
    // inherit the chip's text color (cream when active, ink-soft when inactive).
    const deviceIcon = (id) => {
      const common = { width: 22, height: 22, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', strokeWidth: 1.4, strokeLinecap: 'round', strokeLinejoin: 'round' };
      switch (id) {
        case 'red-light':
          // Floor LED panel — square with grid of dots
          return (<svg {...common}><rect x="4" y="4" width="16" height="16" rx="1.5" /><circle cx="9" cy="9" r="0.6" fill="currentColor" /><circle cx="15" cy="9" r="0.6" fill="currentColor" /><circle cx="9" cy="15" r="0.6" fill="currentColor" /><circle cx="15" cy="15" r="0.6" fill="currentColor" /><circle cx="12" cy="12" r="0.6" fill="currentColor" /></svg>);
        case 'led-mask':
          // Face mask silhouette with eye cutouts
          return (<svg {...common}><path d="M5 9c0-2 2-4 7-4s7 2 7 4v4c0 4-3 7-7 7s-7-3-7-7z" /><ellipse cx="9" cy="11" rx="1.4" ry="0.9" /><ellipse cx="15" cy="11" rx="1.4" ry="0.9" /></svg>);
        case 'gua-sha':
          // Heart-ish flat stone shape
          return (<svg {...common}><path d="M4 12c0-4 3-6 6-5 1 0.3 2 1 2 2 0-1 1-1.7 2-2 3-1 6 1 6 5 0 4-8 8-8 8s-8-4-8-8z" /></svg>);
        case 'ice-roller':
          // Cylindrical roller head + handle
          return (<svg {...common}><circle cx="8" cy="9" r="4" /><line x1="11" y1="11" x2="20" y2="20" /></svg>);
        case 'jade-roller':
          // Two stones on a handle
          return (<svg {...common}><ellipse cx="6" cy="8" rx="3" ry="2" /><line x1="9" y1="10" x2="17" y2="18" /><ellipse cx="19" cy="20" rx="2" ry="1.4" /></svg>);
        case 'derma-roller':
          // Roller cylinder with tiny needles
          return (<svg {...common}><ellipse cx="8" cy="9" rx="4" ry="2.5" /><line x1="6" y1="6.5" x2="6" y2="5" /><line x1="8" y1="6.3" x2="8" y2="4.7" /><line x1="10" y1="6.5" x2="10" y2="5" /><line x1="11" y1="11" x2="20" y2="20" /></svg>);
        case 'high-frequency':
          // Wand with electricity arc at tip
          return (<svg {...common}><line x1="4" y1="20" x2="14" y2="10" /><circle cx="16" cy="8" r="2.2" /><path d="M19 4l1 -1M20 7h2M17 4v-2" /></svg>);
        case 'microcurrent':
          // Two prongs with wave
          return (<svg {...common}><path d="M7 6v6c0 2 1.5 4 4 4M17 6v6c0 2-1.5 4-4 4" /><path d="M9 19c0.7-0.5 1.4-0.5 2 0c0.7 0.5 1.4 0.5 2 0" /><line x1="7" y1="4" x2="7" y2="6" /><line x1="17" y1="4" x2="17" y2="6" /></svg>);
        default:
          return null;
      }
    };
    const DEVICES = [
      { id: 'red-light', label: 'Red light / LED panel' },
      { id: 'led-mask', label: 'LED mask' },
      { id: 'gua-sha', label: 'Gua sha' },
      { id: 'ice-roller', label: 'Ice roller' },
      { id: 'jade-roller', label: 'Jade roller' },
      { id: 'derma-roller', label: 'Derma roller' },
      { id: 'high-frequency', label: 'High-frequency wand' },
      { id: 'microcurrent', label: 'Microcurrent' },
    ];

    const handleSubmit = async () => {
      const id = existing?.id || Date.now();
      // Stamp `submitted: true` so the cover + Ritual know to narrow Today's view to ONLY the
      // products the user just confirmed. Tap-to-toggle on the cover does NOT set this flag,
      // so casual incremental marking doesn't collapse the routine display.
      const submittedForm = { ...form, id, date: targetDate, submitted: true, submittedAt: Date.now() };
      const next = existing
        ? regimenLogs.map(r => r.date === targetDate ? { ...r, ...submittedForm } : r)
        : [submittedForm, ...regimenLogs];
      setRegimenLogs(next);
      await saveData('regimenLogs', next);
      // NOTE: startDate is now PURELY manual. We do NOT auto-stamp on check-in. The default
      // assumption is "the user has been using this product for a while" — startDate is set
      // only when the user explicitly taps "Started today" in the product modal. This way
      // the cover/timeline don't claim a 6-week-old habit just started this morning.
      // Trigger cover Recommended rebuild — fresh routine reflects what user just confirmed they used.
      setCoverRoutineRebuildToken(t => t + 1);
      setShowCheckInModal(false);
      toast(existing ? 'Check-in updated' : 'Check-in saved ✨');
    };

    // Every section starts collapsed — user expands the parts they want to edit.
    // Cleanliness contract: edit modals never overwhelm; sections opt-in.
    const [amOpen, setAmOpen] = useState(false);
    const [pmOpen, setPmOpen] = useState(false);
    const [devicesOpen, setDevicesOpen] = useState(false);
    const [lifestyleOpen, setLifestyleOpen] = useState(false);
    return (
      <Modal compact onClose={() => { setShowCheckInModal(false); modalScrollMemo.current.checkIn = 0; setRitualViewDate(localDateISO()); }} title={(() => {
        // Title reflects WHICH day is being edited. Today / yesterday / fmt
        // helps the user know they're correcting a prior log, not today's.
        const yKey = (() => { const d = new Date(); d.setDate(d.getDate() - 1); return localDateISO(d); })();
        const dayLabel = targetDate === today ? 'Today'
          : targetDate === yKey ? 'Yesterday'
          : new Date(targetDate + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
        return existing ? `Edit ${dayLabel}'s regimen` : `${dayLabel}'s regimen check-in`;
      })()}>
        <span ref={scrollSentinelRef} aria-hidden="true" style={{display:'none'}} />
        <div className="space-y-2">
          {/* === ADD-TO-SHELF PROMPT ===
              Surfaces right after the user types a new product into AM/PM
              extras. Offering Yes opens the global Add Product modal pre-filled
              with the typed name + slot tag so the typeahead can find the SKU
              and the user keeps it as a real shelf product on subsequent days. */}
          {pendingShelfAdd && (
            <div className="rounded-sm border px-3 py-2 flex items-center gap-2 text-[11px]" style={{background:'var(--accent-soft)', borderColor:'var(--accent)', color:'var(--ink)'}}>
              <Icon name="Sparkles" size={12} style={{color:'var(--accent)', flexShrink:0}} />
              <div className="flex-1 min-w-0">
                <span className="italic">Add </span>
                <span className="font-serif italic">"{pendingShelfAdd.name}"</span>
                <span className="italic"> to your shelf?</span>
              </div>
              <button
                onClick={() => {
                  // Pre-fill the product modal with the typed name + slot.
                  setProductForm(prev => ({
                    ...(prev || {
                      name: '', brand: '', category: 'serum', startDate: '', endDate: '',
                      activeIngredients: '', mainIngredients: '', tags: [], concerns: [],
                      useDays: [0,1,2,3,4,5,6], useTimes: [],
                      frequency: 'daily', notes: '', photo: null, photoPath: null, status: 'active'
                    }),
                    name: pendingShelfAdd.name,
                    useTimes: [pendingShelfAdd.slot],
                  }));
                  // Also seed the search input so typeahead instantly looks up the typed name.
                  setProductSearchInput(pendingShelfAdd.name);
                  setShowCheckInModal(false);
                  setShowProductModal(true);
                  setPendingShelfAdd(null);
                  pendingShelfAddRef.current = null;
                }}
                className="px-2.5 py-1 text-[10px] tracking-[0.15em] uppercase italic transition hover:opacity-90"
                style={{background:'var(--accent)', color:'var(--cream)', flexShrink:0}}
              >
                Yes, add
              </button>
              <button
                onClick={() => { setPendingShelfAdd(null); pendingShelfAddRef.current = null; }}
                className="text-[9px] tracking-[0.15em] uppercase italic px-1 transition hover:opacity-70"
                style={{color:'var(--ink-soft)', flexShrink:0}}
                aria-label="Dismiss"
              >
                ×
              </button>
            </div>
          )}

          {/* AM ROUTINE — collapsible */}
          <div className="border rounded-sm" style={{borderColor:'var(--line)'}}>
            <button
              type="button"
              onClick={() => setAmOpen(v => !v)}
              className="w-full flex items-center justify-between gap-2 px-2.5 py-2 text-left transition"
              style={{background: amOpen ? 'var(--cream-deep)' : 'transparent'}}
            >
              <span className="text-[9px] uppercase tracking-[0.25em] flex items-center gap-1.5" style={{color:'var(--ink-soft)'}}>
                <Icon name="Sun" size={10} /> Morning
                {form.amProducts.length + form.amExtras.length > 0 && (
                  <span className="font-serif italic text-[10px] normal-case tracking-normal" style={{color:'var(--accent)'}}>{form.amProducts.length + form.amExtras.length} done</span>
                )}
              </span>
              <Icon name={amOpen ? 'ChevronUp' : 'ChevronDown'} size={11} style={{color:'var(--ink-soft)'}} />
            </button>
            {amOpen && (
              <div className="px-2.5 pb-2 pt-1 border-t" style={{borderColor:'var(--line)'}}>
                {amProducts.length === 0 && form.amExtras.length === 0 ? (
                  <p className="text-[11px] italic" style={{color:'var(--ink-soft)'}}>No AM products on shelf — add one below.</p>
                ) : (
                  <div className="grid grid-cols-1 gap-0.5">
                    {amProducts.map(p => {
                      const checked = form.amProducts.includes(p.id);
                      return (
                        <button key={p.id} type="button" onClick={() => toggle('amProducts', p.id)} className="flex items-center gap-2 px-1.5 py-1 text-left transition" style={{background: checked ? 'var(--accent-soft)' : 'transparent'}}>
                          <span className="w-4 h-4 border rounded-sm flex items-center justify-center flex-shrink-0" style={{borderColor: checked ? 'var(--accent)' : 'var(--line)', background: checked ? 'var(--accent)' : 'transparent'}}>
                            {checked && <Icon name="Check" size={10} style={{color:'var(--cream)'}} />}
                          </span>
                          <span className="text-[11px] flex-1 min-w-0 truncate" style={{color:'var(--ink)'}}>{p.brand || p.name}</span>
                          <span className="text-[9px] tracking-[0.15em] uppercase" style={{color:'var(--ink-soft)'}}>{p.category}</span>
                        </button>
                      );
                    })}
                    {form.amExtras.map(name => (
                      <div key={name} className="flex items-center gap-2 px-1.5 py-1" style={{background: 'var(--accent-soft)'}}>
                        <span className="w-4 h-4 rounded-sm flex items-center justify-center flex-shrink-0" style={{background:'var(--accent)'}}>
                          <Icon name="Check" size={10} style={{color:'var(--cream)'}} />
                        </span>
                        <span className="text-[11px] flex-1 italic" style={{color:'var(--ink)'}}>{name}</span>
                        <button onClick={() => removeExtra('amExtras', name)} className="text-[9px] tracking-widest uppercase" style={{color:'var(--ink-soft)'}}>×</button>
                      </div>
                    ))}
                  </div>
                )}
                <div className="flex gap-1 mt-1.5">
                  <input autoCapitalize="off" autoCorrect="off" spellCheck={false} value={amExtraInput} onChange={e => setAmExtraInput(e.target.value)} onKeyDown={e => { if (e.key === 'Enter') { e.preventDefault(); addExtra('amExtras', amExtraInput, setAmExtraInput); } }} placeholder="+ Add a product not on shelf" className={inputCls + ' !py-1 !text-[10px] flex-1'} />
                  <button onClick={() => addExtra('amExtras', amExtraInput, setAmExtraInput)} disabled={!amExtraInput.trim()} className="px-2 text-[9px] tracking-[0.15em] uppercase border disabled:opacity-40" style={{borderColor:'var(--line)', color:'var(--ink-soft)'}}>Add</button>
                </div>
              </div>
            )}
          </div>

          {/* PM ROUTINE — collapsible */}
          <div className="border rounded-sm" style={{borderColor:'var(--line)'}}>
            <button
              type="button"
              onClick={() => setPmOpen(v => !v)}
              className="w-full flex items-center justify-between gap-2 px-2.5 py-2 text-left transition"
              style={{background: pmOpen ? 'var(--cream-deep)' : 'transparent'}}
            >
              <span className="text-[9px] uppercase tracking-[0.25em] flex items-center gap-1.5" style={{color:'var(--ink-soft)'}}>
                <Icon name="Moon" size={10} /> Evening
                {form.pmProducts.length + form.pmExtras.length > 0 && (
                  <span className="font-serif italic text-[10px] normal-case tracking-normal" style={{color:'var(--accent)'}}>{form.pmProducts.length + form.pmExtras.length} done</span>
                )}
              </span>
              <Icon name={pmOpen ? 'ChevronUp' : 'ChevronDown'} size={11} style={{color:'var(--ink-soft)'}} />
            </button>
            {pmOpen && (
              <div className="px-2.5 pb-2 pt-1 border-t" style={{borderColor:'var(--line)'}}>
                {pmProducts.length === 0 && form.pmExtras.length === 0 ? (
                  <p className="text-[11px] italic" style={{color:'var(--ink-soft)'}}>No PM products on shelf — add one below.</p>
                ) : (
                  <div className="grid grid-cols-1 gap-0.5">
                    {pmProducts.map(p => {
                      const checked = form.pmProducts.includes(p.id);
                      return (
                        <button key={p.id} type="button" onClick={() => toggle('pmProducts', p.id)} className="flex items-center gap-2 px-1.5 py-1 text-left transition" style={{background: checked ? 'var(--accent-soft)' : 'transparent'}}>
                          <span className="w-4 h-4 border rounded-sm flex items-center justify-center flex-shrink-0" style={{borderColor: checked ? 'var(--accent)' : 'var(--line)', background: checked ? 'var(--accent)' : 'transparent'}}>
                            {checked && <Icon name="Check" size={10} style={{color:'var(--cream)'}} />}
                          </span>
                          <span className="text-[11px] flex-1 min-w-0 truncate" style={{color:'var(--ink)'}}>{p.brand || p.name}</span>
                          <span className="text-[9px] tracking-[0.15em] uppercase" style={{color:'var(--ink-soft)'}}>{p.category}</span>
                        </button>
                      );
                    })}
                    {form.pmExtras.map(name => (
                      <div key={name} className="flex items-center gap-2 px-1.5 py-1" style={{background: 'var(--accent-soft)'}}>
                        <span className="w-4 h-4 rounded-sm flex items-center justify-center flex-shrink-0" style={{background:'var(--accent)'}}>
                          <Icon name="Check" size={10} style={{color:'var(--cream)'}} />
                        </span>
                        <span className="text-[11px] flex-1 italic" style={{color:'var(--ink)'}}>{name}</span>
                        <button onClick={() => removeExtra('pmExtras', name)} className="text-[9px] tracking-widest uppercase" style={{color:'var(--ink-soft)'}}>×</button>
                      </div>
                    ))}
                  </div>
                )}
                <div className="flex gap-1 mt-1.5">
                  <input autoCapitalize="off" autoCorrect="off" spellCheck={false} value={pmExtraInput} onChange={e => setPmExtraInput(e.target.value)} onKeyDown={e => { if (e.key === 'Enter') { e.preventDefault(); addExtra('pmExtras', pmExtraInput, setPmExtraInput); } }} placeholder="+ Add a product not on shelf" className={inputCls + ' !py-1 !text-[10px] flex-1'} />
                  <button onClick={() => addExtra('pmExtras', pmExtraInput, setPmExtraInput)} disabled={!pmExtraInput.trim()} className="px-2 text-[9px] tracking-[0.15em] uppercase border disabled:opacity-40" style={{borderColor:'var(--line)', color:'var(--ink-soft)'}}>Add</button>
                </div>
              </div>
            )}
          </div>

          {/* DEVICES — collapsible with line-drawing icons per device */}
          <div className="border rounded-sm" style={{borderColor:'var(--line)'}}>
            <button
              type="button"
              onClick={() => setDevicesOpen(v => !v)}
              className="w-full flex items-center justify-between gap-2 px-2.5 py-2 text-left transition"
              style={{background: devicesOpen ? 'var(--cream-deep)' : 'transparent'}}
            >
              <span className="text-[9px] uppercase tracking-[0.25em] flex items-center gap-1.5" style={{color:'var(--ink-soft)'}}>
                Devices &amp; tools
                {(form.devices || []).length > 0 && (
                  <span className="font-serif italic text-[10px] normal-case tracking-normal" style={{color:'var(--accent)'}}>{form.devices.length} used</span>
                )}
              </span>
              <Icon name={devicesOpen ? 'ChevronUp' : 'ChevronDown'} size={11} style={{color:'var(--ink-soft)'}} />
            </button>
            {devicesOpen && (
              <div className="px-2.5 pb-2 pt-1 border-t" style={{borderColor:'var(--line)'}}>
                <div className="flex flex-wrap gap-1.5">
                  {DEVICES.map(d => {
                    const active = (form.devices || []).includes(d.id);
                    return (
                      <button key={d.id} type="button" onClick={() => toggle('devices', d.id)} className="text-[10px] tracking-[0.05em] px-2 py-1 border rounded-full transition flex items-center gap-1.5" style={{
                        borderColor: active ? 'var(--accent)' : 'var(--line)',
                        background: active ? 'var(--accent)' : 'var(--cream)',
                        color: active ? 'var(--cream)' : 'var(--ink-soft)'
                      }}>
                        {deviceIcon(d.id)}
                        {d.label}
                      </button>
                    );
                  })}
                </div>
              </div>
            )}
          </div>

          {/* LIFESTYLE — collapsible (sleep + hydration + supplements) */}
          <div className="border rounded-sm" style={{borderColor:'var(--line)'}}>
            <button
              type="button"
              onClick={() => setLifestyleOpen(v => !v)}
              className="w-full flex items-center justify-between gap-2 px-2.5 py-2 text-left transition"
              style={{background: lifestyleOpen ? 'var(--cream-deep)' : 'transparent'}}
            >
              <span className="text-[9px] uppercase tracking-[0.25em] flex items-center gap-1.5" style={{color:'var(--ink-soft)'}}>
                Lifestyle
                {(form.sleep || form.hydration || form.sunscreenReapply || (form.supplements || []).length > 0) && (
                  <span className="font-serif italic text-[10px] normal-case tracking-normal" style={{color:'var(--accent)'}}>tracked</span>
                )}
              </span>
              <Icon name={lifestyleOpen ? 'ChevronUp' : 'ChevronDown'} size={11} style={{color:'var(--ink-soft)'}} />
            </button>
            {lifestyleOpen && (
              <div className="px-2.5 pb-2 pt-1 border-t" style={{borderColor:'var(--line)'}}>
                <div className="grid grid-cols-2 gap-2 mb-2">
                  <div>
                    <div className="text-[8px] tracking-[0.2em] uppercase mb-0.5" style={{color:'var(--ink-soft)'}}>Sleep (hrs)</div>
                    <input type="number" step="0.5" min="0" max="14" value={form.sleep} onChange={e => setForm({...form, sleep: e.target.value})} placeholder="7.5" className={inputCls + ' !py-1 !text-[10px]'} />
                  </div>
                  <div className="flex flex-col gap-1 justify-end">
                    <button type="button" onClick={() => setForm({...form, hydration: !form.hydration})} className="text-[10px] tracking-[0.1em] uppercase px-2 py-1 border rounded-sm transition" style={{
                      borderColor: form.hydration ? 'var(--accent)' : 'var(--line)',
                      background: form.hydration ? 'var(--accent)' : 'var(--cream)',
                      color: form.hydration ? 'var(--cream)' : 'var(--ink-soft)'
                    }}>{form.hydration ? '✓ Hydration met' : 'Hydration (8+ glasses)'}</button>
                    <button type="button" onClick={() => setForm({...form, sunscreenReapply: !form.sunscreenReapply})} className="text-[10px] tracking-[0.1em] uppercase px-2 py-1 border rounded-sm transition" style={{
                      borderColor: form.sunscreenReapply ? 'var(--accent)' : 'var(--line)',
                      background: form.sunscreenReapply ? 'var(--accent)' : 'var(--cream)',
                      color: form.sunscreenReapply ? 'var(--cream)' : 'var(--ink-soft)'
                    }}>{form.sunscreenReapply ? '✓ SPF reapplied' : 'SPF reapplied'}</button>
                  </div>
                </div>
                <div>
                  <div className="text-[8px] tracking-[0.2em] uppercase mb-0.5" style={{color:'var(--ink-soft)'}}>Supplements taken</div>
                  <div className="flex gap-1 mb-1">
                    <input autoCapitalize="off" autoCorrect="off" spellCheck={false} value={supplementInput} onChange={e => setSupplementInput(e.target.value)} onKeyDown={e => { if (e.key === 'Enter') { e.preventDefault(); addExtra('supplements', supplementInput, setSupplementInput); } }} placeholder="e.g. Omega-3, Vit D, Zinc" className={inputCls + ' !py-1 !text-[10px] flex-1'} />
                    <button onClick={() => addExtra('supplements', supplementInput, setSupplementInput)} disabled={!supplementInput.trim()} className="px-2 text-[9px] tracking-[0.15em] uppercase border disabled:opacity-40" style={{borderColor:'var(--line)', color:'var(--ink-soft)'}}>Add</button>
                  </div>
                  {form.supplements.length > 0 && (
                    <div className="flex flex-wrap gap-1">
                      {form.supplements.map(s => (
                        <span key={s} className="text-[10px] px-2 py-0.5 border rounded-full inline-flex items-center gap-1" style={{borderColor:'var(--accent)', color:'var(--accent)'}}>
                          {s}
                          <button onClick={() => removeExtra('supplements', s)} className="opacity-60 hover:opacity-100"><Icon name="X" size={9} /></button>
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>

          {/* NOTES */}
          <StableInput resetKey="regimen-checkin" value={form.notes} onChange={(v) => setForm({...form, notes: v})} placeholder="Notes (optional)" className={inputCls + ' text-xs'} />

          <button onClick={handleSubmit} className="w-full py-2 tracking-[0.2em] text-[10px] uppercase transition" style={{background:'var(--ink)', color:'var(--cream)'}}>
            {existing ? 'Update check-in' : 'Save check-in'}
          </button>
        </div>
      </Modal>
    );
  };

  // === TODAY'S RITUAL MODAL (May 2026 Edit-Regimen redesign) ===
  // Cleaner sheet matching Jenni's spec:
  //   - Header: "Edit today" + Save✓ + X (provided by Modal wrapper)
  //   - AM/PM segmented toggle
  //   - Compact numbered rows (no done/check circles): #/bottle/name+type/X
  //   - Two CTAs: [+ Add from Shelf] filled / [+ New Product] outline
  //   - Routine shortcuts: Repeat / Reorder / Clear AM-or-PM
  //   - Why-this-order block REMOVED entirely
  // Embeds an Add-from-Shelf bottom sheet (state at App scope) that overlays
  // the edit sheet for multi-select adds. Closing the shelf returns the user
  // to the still-open regimen sheet so they can keep editing or Save.
  const TodayRitualModal = () => {
    // === DATE-AWARE ===
    // Edits whichever day's regimen the user is viewing (via cover or
    // regimen scrubber). Defaults to today. When opened on a prior day,
    // the modal title + save target both follow the viewed date.
    const today = localDateISO();
    const targetDate = ritualViewDate || today;
    const isEditingToday = targetDate === today;
    const existing = (regimenLogs || []).find(r => r.date === targetDate);
    const yKey = (() => { const d = new Date(); d.setDate(d.getDate() - 1); return localDateISO(d); })();
    const yesterdayCheckIn = (regimenLogs || []).find(r => r.date === yKey && r.submitted);
    const activeProductsList = (products || []).filter(p => !p.endDate);
    // === FORM SEED ===
    // If an existing regimen log for the target date exists → use its
    // BUG FIX (May 2026): used to seed the form with shelf products whose
    // useTimes include AM/PM. Jenni called that out — useTimes is a generic
    // "typically AM/PM" tag, not an implicit daily roster. The Edit modal
    // now starts EMPTY on a never-logged day, matching the cover and Regimen
    // page behavior. User explicitly adds via Repeat / From Shelf.
    const formSeed = existing ? {
      date: targetDate,
      amProducts: [...(existing.amProducts || [])],
      pmProducts: [...(existing.pmProducts || [])],
      amDone: [...(existing.amDone || existing.amProducts || [])],
      pmDone: [...(existing.pmDone || existing.pmProducts || [])],
      notes: existing.notes || '',
    } : {
      date: targetDate,
      amProducts: [],
      pmProducts: [],
      amDone: [],
      pmDone: [],
      notes: '',
    };
    const form = ritualFormRef.current || ritualForm || formSeed;
    const setForm = (updater) => {
      const base = ritualFormRef.current || ritualForm || formSeed;
      const next = typeof updater === 'function' ? updater(base) : updater;
      ritualFormRef.current = next;
      setRitualForm(next);
    };

    const slot = ritualSlot; // 'am' | 'pm'
    const slotKey = slot === 'am' ? 'amProducts' : 'pmProducts';
    const doneKey = slot === 'am' ? 'amDone' : 'pmDone';
    const slotIds = form[slotKey] || [];
    const slotProducts = slotIds.map(id => activeProductsList.find(p => p.id === id)).filter(Boolean);

    // Toggle a product's "done" checkmark — doesn't add/remove from the routine, just
    // marks completion. Only available once a product is in the slot.
    const toggleDone = (productId) => {
      setForm(f => {
        const arr = f[doneKey] || [];
        const next = arr.includes(productId) ? arr.filter(x => x !== productId) : [...arr, productId];
        return { ...f, [doneKey]: next };
      });
    };
    // Add a product to the current slot. Picker is the product modal — when a product
    // is added there it gets useTimes set, but here we want to add to a SPECIFIC slot
    // regardless. We use a simple inline picker built from active shelf products.
    const [addPickerOpen, setAddPickerOpen] = useState(false);
    const addProductToSlot = (productId) => {
      setForm(f => {
        if ((f[slotKey] || []).includes(productId)) return f;
        return { ...f, [slotKey]: [...(f[slotKey] || []), productId] };
      });
      setAddPickerOpen(false);
    };
    const removeProductFromSlot = (productId) => {
      setForm(f => ({
        ...f,
        [slotKey]: (f[slotKey] || []).filter(x => x !== productId),
        [doneKey]: (f[doneKey] || []).filter(x => x !== productId),
      }));
    };
    // Reorder via a basic up/down nudge (keeps mobile-friendly tap targets — full drag
    // is overkill for routines that are usually 3-7 items).
    const moveStep = (productId, dir) => {
      setForm(f => {
        const arr = [...(f[slotKey] || [])];
        const idx = arr.indexOf(productId);
        if (idx === -1) return f;
        const newIdx = idx + dir;
        if (newIdx < 0 || newIdx >= arr.length) return f;
        const tmp = arr[idx]; arr[idx] = arr[newIdx]; arr[newIdx] = tmp;
        return { ...f, [slotKey]: arr };
      });
    };
    const [reorderMode, setReorderMode] = useState(false);

    // === Routine actions ===
    const repeatYesterday = () => {
      if (!yesterdayCheckIn) { toast('Nothing logged yesterday — nothing to copy', 'error'); return; }
      setForm(f => ({
        ...f,
        amProducts: [...(yesterdayCheckIn.amProducts || [])],
        pmProducts: [...(yesterdayCheckIn.pmProducts || [])],
        amDone: [...(yesterdayCheckIn.amProducts || [])],
        pmDone: [...(yesterdayCheckIn.pmProducts || [])],
      }));
      toast('Pulled in yesterday\'s routine', 'info');
    };
    const clearSlot = () => {
      setForm(f => ({ ...f, [slotKey]: [], [doneKey]: [] }));
    };

    // === Save handler — writes regimenLogs with submitted: true ===
    const handleSubmit = async () => {
      const safeForm = ritualFormRef.current || form;
      const id = existing?.id || Date.now();
      const submitted = {
        ...safeForm,
        id,
        date: targetDate,
        submitted: true,
        submittedAt: Date.now(),
      };
      const next = existing
        ? regimenLogs.map(r => r.date === targetDate ? { ...r, ...submitted } : r)
        : [submitted, ...regimenLogs];
      // CLOSE FAST: state update + close synchronously so the cover reflects the routine
      // immediately. Persist + Gemini art generation kick off in the background.
      setRegimenLogs(next);
      setCoverRoutineRebuildToken(t => t + 1);
      setShowCheckInModal(false);
      setRitualForm(null);
      ritualFormRef.current = null;
      setReorderMode(false);
      setAddPickerOpen(false);
      toast(existing ? 'Ritual updated ✨' : 'Ritual saved ✨');
      // Background persistence
      saveData('regimenLogs', next).catch(e => {
        console.error('[ritual] saveData failed:', e);
        toast(`Save error: ${e?.message || 'unknown'}`, 'error');
      });
      // === Explicitly trigger Gemini art generation for NEW user products ===
      // The auto-effect can miss when only the regimen contents change (length stays
      // same) — this ensures every save kicks off art for any product that lacks it.
      setTimeout(() => {
        // Reset the sync ref so generation is allowed to fire even if the previous
        // attempt failed and the sig didn't change.
        lastArtSyncRef.current = '';
        generateProductArtForAll();
      }, 150);
    };

    // === Add-from-Shelf bottom sheet helpers (state at App scope) ===
    // Open / close the embedded shelf picker. Open syncs CURRENT slot selections
    // are blank (multi-select fresh each time); Close clears local state.
    const openShelfSheet = () => {
      setEditRegimenShelfSelected([]);
      setEditRegimenShelfSearch('');
      setEditRegimenShelfFilter('all');
      setEditRegimenShelfOpen(true);
    };
    const closeShelfSheet = () => {
      setEditRegimenShelfOpen(false);
      setEditRegimenShelfSelected([]);
      setEditRegimenShelfSearch('');
      setEditRegimenShelfFilter('all');
    };
    // Append ALL currently-selected shelf products into the active slot.
    // Dedup against existing slot ids so taps in the shelf sheet never insert
    // duplicate steps. Closes only the shelf sheet — regimen editor stays open.
    const commitShelfSelection = () => {
      if (editRegimenShelfSelected.length === 0) return;
      const slotKeyNow = ritualSlot === 'am' ? 'amProducts' : 'pmProducts';
      setForm(f => {
        const current = f[slotKeyNow] || [];
        const additions = editRegimenShelfSelected.filter(id => !current.includes(id));
        if (additions.length === 0) return f;
        return { ...f, [slotKeyNow]: [...current, ...additions] };
      });
      closeShelfSheet();
      toast(`Added ${editRegimenShelfSelected.length} to ${ritualSlot.toUpperCase()} routine`, 'success');
    };
    // Shelf items the user can pick from — exclude those already in the slot,
    // apply search + filter chip locally. Sorted by brand for predictable order.
    const shelfFilterToCategory = {
      all: null,
      toner: ['toner'],
      serum: ['serum'],
      moisturizer: ['moisturizer', 'cream'],
      essence: ['essence'],
      cleanser: ['cleanser', 'wash'],
      'eye-care': ['eye'],
      spf: ['spf', 'sunscreen'],
    };
    const shelfSheetProducts = (() => {
      const q = editRegimenShelfSearch.trim().toLowerCase();
      const matchKeys = shelfFilterToCategory[editRegimenShelfFilter];
      return activeProductsList
        .filter(p => !slotIds.includes(p.id))
        .filter(p => {
          if (!matchKeys) return true;
          const cat = (p.category || '').toLowerCase();
          return matchKeys.some(k => cat.includes(k));
        })
        .filter(p => {
          if (!q) return true;
          return (p.brand || '').toLowerCase().includes(q) || (p.name || '').toLowerCase().includes(q);
        })
        .sort((a, b) => (a.brand || a.name || '').localeCompare(b.brand || b.name || ''));
    })();

    return (
      <>
      <Modal compact onClose={() => {
        // If the shelf sheet is open, the popstate handler will close it first.
        // This path only fires when the regimen editor itself is closing.
        setShowCheckInModal(false);
        setRitualForm(null);
        ritualFormRef.current = null;
        setReorderMode(false);
        setAddPickerOpen(false);
        closeShelfSheet();
      }} title={(() => {
        // Title reflects which day is being edited. Compact form per spec —
        // "Edit today" / "Edit yesterday" / "Edit [date]". The word "regimen"
        // is implicit from context (we're in the regimen editor).
        if (isEditingToday) return "Edit today";
        if (targetDate === yKey) return "Edit yesterday";
        return "Edit " + new Date(targetDate + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
      })()} actionLabel="Save" action={handleSubmit}>
        <div className="space-y-4">
          {/* === AM / PM toggle ===
               Pill-style segmented control. Active tab = cream pill on cream-deep track. */}
          <div className="rounded-full flex p-1 gap-1" style={{background:'var(--cream-deep)', border:'1px solid var(--line)'}}>
            {[
              { id: 'am', label: 'AM routine', icon: 'Sun' },
              { id: 'pm', label: 'PM routine', icon: 'Moon' },
            ].map(t => {
              const active = ritualSlot === t.id;
              return (
                <button
                  key={t.id}
                  type="button"
                  onClick={() => setRitualSlot(t.id)}
                  className="flex-1 rounded-full py-2 px-3 flex items-center justify-center gap-1.5 transition"
                  style={{
                    background: active ? 'var(--cream)' : 'transparent',
                    color: active ? 'var(--ink)' : 'var(--ink-soft)',
                    boxShadow: active ? '0 1px 3px rgba(0,0,0,0.05)' : 'none',
                  }}
                >
                  <Icon name={t.icon} size={12} style={{color: active ? 'var(--accent)' : 'var(--ink-soft)'}} />
                  <span className="text-[11px] tracking-[0.18em] uppercase">{t.label}</span>
                </button>
              );
            })}
          </div>

          {/* === Compact numbered product list ===
               Per spec: number / bottle / product name+type / X remove.
               NO done/check circles. Reorder mode keeps up/down arrows. */}
          {slotProducts.length === 0 ? (
            <div className="rounded-[14px] p-6 text-center" style={{background:'var(--cream-deep)', border:'1px dashed var(--line)'}}>
              <div className="font-serif italic text-[15px] mb-1" style={{color:'var(--ink)'}}>
                {slot === 'am' ? 'Stepping out bare? Brave.' : 'Going to bed bare? Bolder.'}
              </div>
              <div className="text-[11px]" style={{color:'var(--ink-soft)'}}>
                {slot === 'am' ? 'Even SPF beats nothing.' : 'At least wash the day off.'} Pull from your shelf or add something new.
              </div>
            </div>
          ) : (
            <div className="space-y-1">
              {slotProducts.map((p, i) => {
                const art = generatedProductArt && generatedProductArt[`prod-${p.id}`];
                const hasRealPhoto = p.photo || p.photoPath;
                return (
                  <div key={p.id} className="regimen-row">
                    {/* Step number */}
                    <div className="font-serif italic text-[14px] text-center" style={{color:'var(--ink-soft)'}}>{i + 1}</div>
                    {/* Bottle thumbnail */}
                    <div className="h-12 flex items-end justify-center overflow-hidden">
                      {hasRealPhoto ? (
                        <Photo item={p} alt={p.name} className="h-full w-auto max-w-full object-contain"
                          renderFallback={() => art ? <img src={art} alt={p.name} className="h-full w-auto max-w-full object-contain" /> : <DashedBottleOutline />}
                        />
                      ) : art ? (
                        <img src={art} alt={p.name} className="h-full w-auto max-w-full object-contain" />
                      ) : (
                        <DashedBottleOutline />
                      )}
                    </div>
                    {/* Name + type */}
                    <div className="min-w-0">
