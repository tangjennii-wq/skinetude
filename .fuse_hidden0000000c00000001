          if (!productBrandSelected) {
            // === Brand list screen ===
            // Counts/list computed once. Filtering happens INSIDE BrandPicker
            // (a module-scope component) using its own local state — keeps
            // typing smooth because the parent ProductModal doesn't recreate
            // on each keystroke.
            const counts = {};
            (POPULAR_PRODUCTS || []).forEach(p => { if (p.brand) counts[p.brand] = (counts[p.brand] || 0) + 1; });
            const brands = Object.keys(counts).sort((a, b) => counts[b] - counts[a]);
