                      { test: /retinol|tretinoin|retinaldehyde|adapalene|trifarotene|tazarotene|granactive/i, label: 'Retinol' },
                      { test: /ascorbic|ascorbyl|ascorbate|vitamin\s*c|c.?ferulic/i, label: 'Vitamin C' },
                      { test: /niacinamide/i, label: 'Niacinamide' },
                      { test: /salicylic/i, label: 'Salicylic' },
                      { test: /glycolic/i, label: 'Glycolic' },
                      { test: /lactic/i, label: 'Lactic' },
                      { test: /mandelic/i, label: 'Mandelic' },
                      { test: /azelaic/i, label: 'Azelaic' },
                      { test: /benzoyl/i, label: 'Benzoyl P.' },
                      { test: /alpha\s*arbutin|arbutin/i, label: 'Arbutin' },
                      { test: /tranexamic/i, label: 'Tranexamic' },
                      { test: /kojic/i, label: 'Kojic' },
                      { test: /panthenol|provitamin\s*b5/i, label: 'Panthenol' },
                      { test: /ceramide/i, label: 'Ceramides' },
                      { test: /centella|cica|madecassoside/i, label: 'Centella' },
                      { test: /peptide/i, label: 'Peptides' },
                      { test: /bakuchiol/i, label: 'Bakuchiol' },
                      { test: /resveratrol/i, label: 'Resveratrol' },
                      { test: /hyaluronic/i, label: 'Hyaluronic' },
                      { test: /squalane/i, label: 'Squalane' },
