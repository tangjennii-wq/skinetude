          const objects = [];
          let depth = 0, startIdx = -1;
          for (let i = 0; i < cleaned.length; i++) {
            const c = cleaned[i];
            if (c === '{') {
              if (depth === 0) startIdx = i;
              depth++;
            } else if (c === '}') {
              depth--;
              if (depth === 0 && startIdx !== -1) {
                try {
                  const obj = JSON.parse(cleaned.slice(startIdx, i + 1));
                  if (obj && typeof obj === 'object') objects.push(obj);
                } catch (_) {}
                startIdx = -1;
