    recent.forEach(l => (l.concerns || []).forEach(c => { tagCounts[c] = (tagCounts[c] || 0) + 1; }));
    const topTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]).slice(0, 4).map(([c]) => c);
