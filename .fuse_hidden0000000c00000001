// Fetch a stored photo as base64 (data URL). Used by AI vision flows that need to send
// the image to Anthropic. Hits the signed URL, downloads bytes, encodes.
const fetchPhotoAsBase64 = async (path) => {
  if (!path) return null;
  const url = await getSignedPhotoUrl(path);
  if (!url) return null;
  try {
    const resp = await fetch(url);
    if (!resp.ok) return null;
    const blob = await resp.blob();
    return await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onloadend = () => resolve(reader.result);
      reader.onerror = reject;
      reader.readAsDataURL(blob);
    });
  } catch (e) {
    console.error('fetchPhotoAsBase64 failed:', e);
    return null;
  }
};

// Resolve a log/product/etc to whatever it has — new photoPath takes priority over
// legacy base64 in the photo field. Returns { path, legacyDataUrl }.
const _resolvePhotoSource = (item) => {
  if (!item) return { path: null, legacyDataUrl: null };
  const path = item.photoPath || null;
  const photoStr = typeof item.photo === 'string' ? item.photo : null;
  const legacyDataUrl = (photoStr && photoStr.startsWith('data:')) ? photoStr : null;
  return { path, legacyDataUrl };
};

// === PHOTO CAP & ANCHOR CLEANUP ===
// When a user passes 365 photos, we keep one "anchor" photo per year-month — the
// highest-rated photo that month — so year-over-year comparison stays possible. Beyond
// the anchors, we trim oldest non-anchor photos until back at the cap.
//
// Returns { toDeletePaths, updatedLogs, trimmed }. Does NOT mutate; the caller is
// responsible for deleting from Storage and persisting the updated logs.
const computePhotoCleanup = (logs) => {
  const withPhotos = logs.filter(l => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:')));
  if (withPhotos.length <= PHOTO_CAP_PER_USER) {
    return { toDeletePaths: [], updatedLogs: logs, trimmed: 0 };
  }
  // Anchor per year-month: highest-rated photo. Ties go to the latest in the month.
  const anchorByMonth = new Map();
  withPhotos.forEach(l => {
    const key = new Date(l.date).toISOString().slice(0, 7);
    const cur = anchorByMonth.get(key);
    if (!cur || +l.rating > +cur.rating || (+l.rating === +cur.rating && new Date(l.date) > new Date(cur.date))) {
      anchorByMonth.set(key, l);
    }
  });
  const anchorIds = new Set([...anchorByMonth.values()].map(l => l.id));
  // Walk oldest-first; mark non-anchors for deletion until we're back at the cap.
  const sortedAsc = [...withPhotos].sort((a, b) => new Date(a.date) - new Date(b.date));
  const toDelete = [];
  let remaining = withPhotos.length;
  for (const log of sortedAsc) {
    if (remaining <= PHOTO_CAP_PER_USER) break;
    if (anchorIds.has(log.id)) continue;
    toDelete.push(log);
    remaining--;
  }
  const deleteIds = new Set(toDelete.map(l => l.id));
  const toDeletePaths = toDelete.map(l => l.photoPath).filter(Boolean);
  // Strip photo + photoPath from the deleted entries (the log itself stays — only the
  // photo reference is removed, so notes/rating/concerns survive).
  const updatedLogs = logs.map(l => {
    if (!deleteIds.has(l.id)) return l;
    const { photo, photoPath, ...rest } = l;
    return rest;
  });
  return { toDeletePaths, updatedLogs, trimmed: toDelete.length };
};

// === ACTUAL USAGE — what the user is genuinely doing, not just what's on the shelf ===
//
// The shelf is *inventory* (products owned). The check-in (regimenLogs) and per-photo
// usedProducts list capture *behavior* (products actually applied). Every AI prompt that
// describes "your routine" must use this — passing the full shelf misleads the AI into
// assuming products the user owns but has stopped using are still in play, producing
// wrong analysis ("X may be irritating you" when X hasn't been used in 30 days).
//
// Returns:
//   {
//     actuallyUsed: [{ product, amCount, pmCount, onLogs, totalDays, lastDate, daysSinceLast, status: 'active' }],
//     occasional:   [...status: 'occasional' — used 1× in last 14d but not recently],
//     lapsed:       [...status: 'lapsed' — owned, used in window before but not in last 14d],
//     unused:       [...status: 'unused' — owned but never used in window],
//     all:          [...full list],
//   }
//
// `windowDays` defaults to 30. Set to 14 for tighter "what are they on right now."
const getActualUsage = (products, regimenLogs, photoLogs, opts = {}) => {
  const windowDays = opts.windowDays || 30;
  const cutoff = Date.now() - windowDays * 86400000;
  const usage = new Map();
  (products || []).forEach(p => {
    if (p.endDate) return; // explicitly retired — not a candidate
    usage.set(p.id, {
      product: p,
      amCount: 0,
      pmCount: 0,
      onLogs: 0,
      totalDays: 0,
      lastDate: null,
    });
  });
  (regimenLogs || []).forEach(r => {
    if (!r.date) return;
    if (new Date(r.date).getTime() < cutoff) return;
    const usedToday = new Set();
    (r.amProducts || []).forEach(id => {
      const u = usage.get(id);
      if (u) { u.amCount++; usedToday.add(id); if (!u.lastDate || r.date > u.lastDate) u.lastDate = r.date; }
    });
    (r.pmProducts || []).forEach(id => {
      const u = usage.get(id);
      if (u) { u.pmCount++; usedToday.add(id); if (!u.lastDate || r.date > u.lastDate) u.lastDate = r.date; }
    });
    usedToday.forEach(id => { const u = usage.get(id); if (u) u.totalDays++; });
  });
  (photoLogs || []).forEach(l => {
    if (!l.date) return;
    if (new Date(l.date).getTime() < cutoff) return;
    (l.usedProducts || []).forEach(id => {
      const u = usage.get(id);
      if (u) { u.onLogs++; if (!u.lastDate || l.date > u.lastDate) u.lastDate = l.date; }
    });
  });
  const today = new Date();
  const enriched = [];
  usage.forEach(u => {
    const usedAtAll = u.amCount + u.pmCount + u.onLogs > 0;
    const daysSinceLast = u.lastDate ? Math.floor((today - new Date(u.lastDate)) / 86400000) : Infinity;
    let status;
    if (!usedAtAll) status = 'unused';
    else if (daysSinceLast > 14) status = 'lapsed';
    else if (daysSinceLast > 7 || u.totalDays < 3) status = 'occasional';
    else status = 'active';
    enriched.push({ ...u, daysSinceLast, status });
  });
  return {
    actuallyUsed: enriched.filter(e => e.status === 'active'),
    occasional:   enriched.filter(e => e.status === 'occasional'),
    lapsed:       enriched.filter(e => e.status === 'lapsed'),
    unused:       enriched.filter(e => e.status === 'unused'),
    all: enriched,
  };
};

// Format the usage object as a structured prompt block. Every AI prompt that describes
// "the user's routine" should use this — the explicit categorization (active vs lapsed
// vs unused) prevents the model from assuming everything on the shelf is in play.
const formatUsageForPrompt = (usage) => {
  const lines = [];
  if (usage.actuallyUsed.length > 0) {
    lines.push('ACTIVELY USED (last 7-14 days, from check-ins + photo logs — these are what they\'re ACTUALLY ON):');
    usage.actuallyUsed.forEach(u => {
      const p = u.product;
      const freq = `${u.amCount}× AM, ${u.pmCount}× PM${u.onLogs > 0 ? `, ${u.onLogs}× tagged on photo entry` : ''}`;
      lines.push(`• ${p.name}${p.brand ? ` (${p.brand})` : ''} — ${p.activeIngredients || 'no actives listed'} [${freq}]`);
    });
  } else {
    lines.push('ACTIVELY USED: nothing recorded in recent check-ins. The user has products on their shelf but is NOT logging actual use. Do NOT assume any product is in their routine.');
  }
  if (usage.occasional.length > 0) {
    lines.push('\nOCCASIONAL / IRREGULAR (used 1-2× recently — treat as part-time, not core routine):');
    usage.occasional.forEach(u => lines.push(`• ${u.product.name} — ${u.product.activeIngredients || 'no actives listed'} (${u.totalDays} day${u.totalDays === 1 ? '' : 's'} in window)`));
  }
  if (usage.lapsed.length > 0) {
    lines.push('\nOWNED but LAPSED (>14 days since last use — DO NOT include in current-routine analysis. Only mention if relevant to "why aren\'t they using X" or "have they tried X"):');
    usage.lapsed.forEach(u => lines.push(`• ${u.product.name} (last used ${u.daysSinceLast}d ago)`));
  }
  if (usage.unused.length > 0) {
    const names = usage.unused.map(u => u.product.name).join(', ');
    lines.push(`\nOWNED but NEVER USED in window (sitting on shelf — DO NOT assume in routine): ${names}`);
  }
  return lines.join('\n');
};

// === PRODUCT COMPARE ANCHORS ===
// Computes "before & after" anchors for a single product. The start anchor is the EARLIEST
// of three signals: (1) product.startDate (explicit user opt-in), (2) first regimenLog
// where this product is checked off, (3) first photo log where this product is tagged.
// This way a long-running staple still gets a reasonable anchor even if the user never
// flipped "Started today" — we infer from real behavior.
//
// Photo selection is LOOSE — we want any full-face photo since the start anchor, not only
// photos on days the product was applied. The question being answered is "has my skin
// changed since I started X?", which is properly answered by time-spaced photos regardless
// of single-day usage. Falls back to non-full-face if no full-face exists.
//
// Returns:
//   {
//     startDate: 'YYYY-MM-DD' | null,
//     startSource: 'explicit' | 'regimen' | 'photo-tag' | null,
//     anchorPhotoLog: log | null,   // closest full-face on/after startDate
//     latestPhotoLog: log | null,   // most recent full-face since startDate
//     daysActive: number | null,
//     photoCount: number,           // photos in window
//     hasEnoughData: boolean,       // ≥14 days span AND ≥2 photos
//     reasonShort: string,          // 'Need 14+ days and 2 photos' if not ready
//   }
const _hasPhotoForCompare = (l) => l.photoPath || (typeof l.photo === 'string' && l.photo.startsWith('data:'));
const findProductCompareAnchors = (product, products, regimenLogs, photoLogs) => {
  if (!product) return { startDate: null, startSource: null, anchorPhotoLog: null, latestPhotoLog: null, daysActive: null, photoCount: 0, hasEnoughData: false, reasonShort: 'No product' };
  // Signal 1 — explicit startDate
  let earliest = product.startDate || null;
  let source = product.startDate ? 'explicit' : null;
  // Signal 2 — first regimenLog mentioning this product
  const fromRegimen = (regimenLogs || [])
    .filter(r => (r.amProducts || []).includes(product.id) || (r.pmProducts || []).includes(product.id))
    .map(r => r.date)
    .sort()[0];
  if (fromRegimen && (!earliest || fromRegimen < earliest)) {
    earliest = fromRegimen;
    source = 'regimen';
  }
  // Signal 3 — first photo log tagging this product
  const fromPhotoTag = (photoLogs || [])
    .filter(l => (l.usedProducts || []).includes(product.id))
    .map(l => l.date)
    .sort()[0];
  if (fromPhotoTag && (!earliest || fromPhotoTag < earliest)) {
    earliest = fromPhotoTag;
    source = 'photo-tag';
  }
  if (!earliest) {
    return { startDate: null, startSource: null, anchorPhotoLog: null, latestPhotoLog: null, daysActive: null, photoCount: 0, hasEnoughData: false, reasonShort: 'No usage logged yet — check it off in your daily regimen first.' };
  }
  // Photo windowing: anchor = first full-face photo on/after start, latest = most recent.
  // Falls back to non-full-face if no full-face exists in the window.
  const since = (photoLogs || []).filter(l => l.date >= earliest && _hasPhotoForCompare(l));
  const sinceFullFace = since.filter(l => l.area === 'full-face');
  const candidatePool = sinceFullFace.length >= 2 ? sinceFullFace : since;
  const sortedAsc = [...candidatePool].sort((a, b) => {
    if (a.date !== b.date) return a.date.localeCompare(b.date);
    return (a.id || 0) - (b.id || 0);
  });
  const sortedDesc = [...candidatePool].sort((a, b) => {
    if (a.date !== b.date) return b.date.localeCompare(a.date);
    return (b.id || 0) - (a.id || 0);
  });
  const anchorPhotoLog = sortedAsc[0] || null;
  const latestPhotoLog = sortedDesc[0] || null;
  const sameLog = anchorPhotoLog && latestPhotoLog && anchorPhotoLog.id === latestPhotoLog.id;
  const photoCount = candidatePool.length;
  const daysActive = Math.floor((Date.now() - new Date(earliest).getTime()) / 86400000);
  const hasEnoughData = !sameLog && daysActive >= 14 && photoCount >= 2;
  const reasonShort = hasEnoughData ? '' :
    daysActive < 14 ? `Need 14+ days · you're at ${daysActive}.` :
    photoCount < 2 ? `Need 2+ photos since starting · you're at ${photoCount}.` :
    sameLog ? 'Need 2 distinct photos in the window.' :
    'Not enough data yet.';
  return { startDate: earliest, startSource: source, anchorPhotoLog, latestPhotoLog, daysActive, photoCount, hasEnoughData, reasonShort };
};

