      const { path, error } = await uploadPhotoToStorage(user.id, t.b64);
      if (!path) {
        if (error) console.error('Migration error:', error);
        continue;
      }
      if (t.kind === 'log') {
        setLogs(prev => {
          const next = prev.map(l => {
            if (l.id !== t.id) return l;
            const { photo, ...rest } = l;
            return { ...rest, photoPath: path };
          });
          saveData('logs', next);
          return next;
        });
      } else if (t.kind === 'product') {
