  // and the 2.0 names are kept as last-ditch fallbacks for legacy projects.
  const fetchGeminiImage = async (_unusedKey, prompt) => {
    // Default chain. If a model has worked before, hoist it to the front so we
    // skip the whole "try preview, try GA, try imagen, try 2.0…" tax on every
    // call. After the first successful gen this drops latency by ~2-4s.
    // Note: the `_unusedKey` arg is kept for back-compat with existing callers
    // — auth is now handled by the Supabase proxy (or BYO-key inside callGeminiProxied).
    const baseModels = [
      'gemini-2.5-flash-image-preview',
      'gemini-2.5-flash-image',
      'imagen-3.0-generate-002',
      'gemini-2.0-flash-preview-image-generation',
      'gemini-2.0-flash-exp-image-generation',
    ];
    const lastWorking = getLastWorkingGeminiModel();
    const models = lastWorking
      ? [lastWorking, ...baseModels.filter(m => m !== lastWorking)]
      : baseModels;
    let lastErr = { kind: 'unknown', model: null, status: null, message: 'all Gemini image models failed', raw: null };
    for (const model of models) {
      try {
        console.log('[gemini-art] trying', model, '· prompt:', prompt.slice(0, 80) + '…');
        // Per-attempt timeout: 45s. iOS Safari aggressively kills hung fetches
        // when the tab loses focus or the device sleeps; without an explicit
        // abort, a hung request can wedge the worker pool indefinitely.
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 45000);
        const { resp, viaProxy } = await callGeminiProxied({
          mode: 'image',
          model,
          payload: {
            contents: [{ parts: [{ text: prompt }] }],
            generationConfig: { responseModalities: ['TEXT', 'IMAGE'] },
          },
          signal: controller.signal,
        }).finally(() => clearTimeout(timeoutId));
        if (!resp.ok) {
          const errText = await resp.text();
          // Try to extract the error.message + status from the JSON body
          // (works for both Google direct and the proxy's pass-through).
          let parsed = null;
          try {
            const j = JSON.parse(errText);
            parsed = j?.error || j;
          } catch (_) {}
          const apiStatus = parsed?.status || parsed?.error || '';
          const apiMsg = parsed?.message || parsed?.detail || errText.slice(0, 200);
          let kind = 'unknown';
          // Proxy-specific: 429 with `rate_limit_exceeded` means user hit their daily cap.
          if (viaProxy && resp.status === 429) kind = 'quota';
          else if (resp.status === 401 || resp.status === 403 || /API_KEY_INVALID|PERMISSION_DENIED|API key not valid/i.test(apiStatus + ' ' + apiMsg)) kind = 'auth';
          else if (resp.status === 404 || /NOT_FOUND|is not found/i.test(apiStatus + ' ' + apiMsg)) kind = 'model';
          else if (resp.status === 429 || /RESOURCE_EXHAUSTED|quota|rate_limit/i.test(apiStatus + ' ' + apiMsg)) kind = 'quota';
          lastErr = { kind, model, status: resp.status, message: apiMsg, raw: errText.slice(0, 600) };
          console.warn(`[gemini-art] ${kind} fail:`, model, '→', resp.status, apiMsg);
          // If the cached working model failed, invalidate it so we go back to
          // probing the full chain on the next call (the Google project may have
          // had its model access revoked / preview deprecated).
          if (lastWorking && model === lastWorking) clearLastWorkingGeminiModel();
          // For auth + quota, retrying other models won't help — bail early.
          if (kind === 'auth' || kind === 'quota') break;
          continue;
        }
        const data = await resp.json();
        const candidate = data?.candidates?.[0];
        const parts = candidate?.content?.parts || [];
        const part = parts.find(pt => pt.inlineData || pt.inline_data);
        const inline = part?.inlineData || part?.inline_data;
        if (inline?.data) {
          console.log('[gemini-art] ✓', model, '→', (inline.data.length / 1024).toFixed(1), 'KB');
          // Cache so future calls hit this model directly.
          setLastWorkingGeminiModel(model);
          return `data:${inline.mimeType || inline.mime_type || 'image/png'};base64,${inline.data}`;
        }
        // 200 OK but no image. Diagnose: was it a safety block, or is the model
        // ignoring responseModalities (i.e. wrong endpoint for this model)?
        const finishReason = candidate?.finishReason || candidate?.finish_reason || 'UNKNOWN';
        const textPart = parts.find(pt => pt.text)?.text || '';
        const safetyRatings = candidate?.safetyRatings || candidate?.safety_ratings;
        const blocked = /SAFETY|BLOCKLIST|PROHIBITED/i.test(finishReason) || (safetyRatings && safetyRatings.some(r => r.blocked));
        lastErr = {
          kind: blocked ? 'safety' : 'model',
          model,
          status: 200,
          message: blocked
            ? `Blocked by safety filter (${finishReason})`
            : `Model returned text only — likely doesn't support image output. ${textPart ? '"' + textPart.slice(0, 80) + '"' : ''}`,
          raw: JSON.stringify(data).slice(0, 600),
        };
        console.warn('[gemini-art] no-image:', model, '·', lastErr.message);
      } catch (e) {
        // AbortError = our 45s timeout fired. Classify as network so the user
        // sees "Network" in the diagnostic banner instead of a vague "fetch failed".
        const isAbort = e && (e.name === 'AbortError' || /aborted/i.test(e.message || ''));
        lastErr = {
          kind: 'network',
          model,
          status: null,
          message: isAbort ? `Timed out after 45s on ${model}` : (e.message || String(e)),
          raw: null,
        };
        console.warn('[gemini-art] network/exception:', model, '·', isAbort ? 'TIMEOUT' : e.message);
      }
    }
    const err = new Error(`Gemini image gen failed: ${lastErr.kind} · ${lastErr.message}`);
    err.cause = lastErr;
    throw err;
  };
  const generateProductArtForAll = async (opts = {}) => {
    // No key required — the Supabase proxy handles auth. We pass the user's
    // BYO key through to fetchGeminiImage if they've set one, otherwise the
    // proxy is used (subject to the 40/day image cap).
    const key = getGeminiKey();
    setGeneratingProductArt(true);
    const next = { ...getGeneratedProductArt() };
    const force = !!opts.force;
    // Build the queue — starters that aren't cached + user products in today's
    // regimen (or active shelf) that lack a real photo + lack cached art.
    const queue = [];
    for (const p of STARTER_PRODUCT_PREVIEWS) {
      if (force || !next[p.slug]) queue.push({ key: p.slug, prompt: p.prompt });
    }
    // User regimen products — pull from yesterday's submitted check-in if available,
    // otherwise from active shelf. Cap at 4 (matches the 4-slot lineup).
    const todayK = localDateISO();
    const yKey = (() => { const d = new Date(); d.setDate(d.getDate() - 1); return localDateISO(d); })();
    const todayCheckIn = (regimenLogs || []).find(r => r.date === todayK && r.submitted);
    const yCheckIn = (regimenLogs || []).find(r => r.date === yKey && r.submitted);
    const checkIn = todayCheckIn || yCheckIn;
    const usedIds = checkIn
      ? [...(checkIn.amProducts || []), ...(checkIn.pmProducts || [])]
      : (products || []).filter(p => !p.endDate).slice(0, 4).map(p => p.id);
    const usedProducts = [...new Set(usedIds)].map(id => (products || []).find(p => p.id === id)).filter(Boolean).slice(0, 4);
    for (const p of usedProducts) {
      const slot = `prod-${p.id}`;
      const hasRealPhoto = p.photo || p.photoPath;
      if (hasRealPhoto) continue;
      if (!force && next[slot]) continue;
      queue.push({ key: slot, prompt: promptForUserProduct(p) });
    }
    if (queue.length === 0) {
      setGeneratingProductArt(false);
      return;
    }
    // === PARALLEL EXECUTION WITH BOUNDED CONCURRENCY ===
    // Old loop ran serially (4 starters × ~5s each = 20s). With concurrency=4
    // the same queue completes in ~5-7s wall-clock since Gemini handles the
    // requests in parallel server-side. Cap at 4 so we don't spam the API or
    // get rate-limited (free tier has per-minute quotas).
    let success = 0;
    let failures = 0;
    let lastFail = null;
    let aborted = false;
    const CONCURRENCY = 4;
    const runOne = async (job) => {
      if (aborted) return;
      try {
        const dataUri = await fetchGeminiImage(key, job.prompt);
        next[job.key] = dataUri;
        success++;
        // Persist incrementally so partial progress survives a tab close.
        // The setState here triggers a single re-render per completion which
        // is what makes the bottles "pop in" one at a time as they finish.
        setGeneratedProductArt(next);
        setGeneratedProductArtState({ ...next });
      } catch (e) {
        failures++;
        lastFail = e.cause || { kind: 'unknown', message: e.message };
        console.error('[gemini-art] failed for', job.key, '·', lastFail.kind, '·', lastFail.message);
        // For auth/quota, signal the worker pool to stop launching new jobs —
        // every remaining product would hit the same wall.
        if (lastFail.kind === 'auth' || lastFail.kind === 'quota') aborted = true;
      }
    };
    // Worker-pool pattern: pull jobs off a shared queue from N parallel workers.
    // Cleaner than slicing the queue into chunks because slow jobs don't block
    // the next chunk — workers just grab the next available job.
    const queueCopy = [...queue];
    const workers = Array(Math.min(CONCURRENCY, queueCopy.length)).fill(null).map(async () => {
      while (queueCopy.length > 0 && !aborted) {
        const job = queueCopy.shift();
        if (job) await runOne(job);
      }
    });
    await Promise.all(workers);
    setGeneratingProductArt(false);
    // === GEMINI WORK STAYS SILENT ===
    // Per Jenni: no notifications about Gemini work — bottle generation,
    // quota, errors. The art appears or doesn't; the user shouldn't be
    // pinged about background AI activity. We still log to console for
    // debugging and keep `productArtError` state for inline UI affordances.
    if (success > 0 && failures === 0) {
      setProductArtError(null);
    } else if (success > 0) {
      setProductArtError(lastFail);
    } else {
      setProductArtError(lastFail);
      console.warn('[product-art]', lastFail?.kind || 'failed', lastFail);
    }
  };
