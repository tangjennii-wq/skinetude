// === TAGGED ANALYSIS RENDERER ===
// Each bullet → a row with a CONTEXT-AWARE icon (Droplet for cleanse,
// Sun for SPF, Moon for retinoid PM, Heart for moisturize, etc.) plus a
// type label (Observe / Why / Try). The icon picks itself based on
// keywords in the bullet text — water drop for cleansers, sun for SPF,
// etc. Falls back to a generic icon per type if nothing matches.
//
// Why context-aware: "label each type of observation and advice" —
// Jenni wants the icon to TELL you what the recommendation is at a
// glance. Generic Eye/Activity/Sparkles wasn't doing that work.
const pickContextIcon = (text, type) => {
  const t = (text || '').toLowerCase();
  // Action-specific contextual icons — the most informative
  if (type === 'action') {
    if (/cleanse|cleanser|wash|double cleanse|micellar/.test(t)) return 'Droplet';
    if (/sunscreen|spf|sun ?protection|reapply.*sun/.test(t)) return 'Sun';
    if (/retinoid|retinol|tretinoin|adapalene|retinaldehyde|differin|granactive/.test(t)) return 'Moon';
    if (/moisturiz|moisturis|hydrat|barrier cream|ceramide/.test(t)) return 'Heart';
    if (/exfoliat|aha|bha|glycolic|salicylic|lactic|mandelic|enzyme|peel/.test(t)) return 'Layers';
    if (/serum|essence|ampoule|treatment/.test(t)) return 'Beaker';
    if (/mask|sheet mask|clay/.test(t)) return 'Square';
    if (/spot ?treat|benzoyl|acne treat/.test(t)) return 'Target';
    if (/oil|squalane/.test(t)) return 'Droplets';
    if (/vitamin c|ascorbic|brighten/.test(t)) return 'Sparkles';
    if (/niacinamide/.test(t)) return 'Shield';
    if (/sleep|rest|recover/.test(t)) return 'Cloud';
    if (/hydrate|water|drink/.test(t)) return 'Droplet';
    if (/spf reapply|reapply/.test(t)) return 'RotateCcw';
    if (/wait|space|alternate|every other/.test(t)) return 'Clock';
    if (/stop|pause|hold|skip/.test(t)) return 'Pause';
    if (/add|introduce|start/.test(t)) return 'Plus';
    return 'Sparkles';
  }
  // Observe = a reading of the skin
  if (type === 'observe') {
    if (/redness|flush|inflam/.test(t)) return 'Flame';
    if (/dry|parched|dehydrat/.test(t)) return 'Droplet';
    if (/oil|sebum|shine|congest/.test(t)) return 'Circle';
    if (/breakout|pimple|acne|pustule|comedone/.test(t)) return 'Target';
    if (/texture|smooth|rough/.test(t)) return 'Layers';
    if (/barrier|sensitive|reactive/.test(t)) return 'Shield';
    return 'Eye';
  }
  // Cause / why / mechanism
  if (type === 'cause') {
    return 'Activity';
  }
  return null;
};
const TaggedAnalysisBullets = ({ text, onOpen, IconComponent, withPearlsFn }) => {
  if (!text || typeof text !== 'string') return null;
  const lines = text.split(/\n+/).map(l => l.trim()).filter(Boolean);
  const intro = [];
  const bullets = [];
  let inBullets = false;
  lines.forEach(l => {
    const isBullet = /^[-•·*]\s+/.test(l) || /^\[(OBSERVE|CAUSE|ACTION|MECHANISM|DO|READ)\]/i.test(l);
    if (isBullet) { inBullets = true; bullets.push(parseTaggedBullet(l)); }
    else if (!inBullets) intro.push(l);
    else bullets.push({ type: 'plain', text: l });
  });
  const TYPE_META = {
    observe: { label: 'Observe', color: 'var(--ink-soft)' },
    cause:   { label: 'Why',     color: 'var(--sage,#8a9b7e)' },
    action:  { label: 'Try',     color: 'var(--accent)' },
    plain:   { label: '',        color: 'var(--ink-soft)' },
  };
  const renderInline = (s) => withPearlsFn && onOpen ? withPearlsFn(s, onOpen) : s;
  return (
    <div>
      {intro.length > 0 && (
        <p className="font-serif italic text-[13px] leading-relaxed mb-3" style={{color:'var(--ink)'}}>
          {renderInline(intro.join(' '))}
        </p>
      )}
      <div className="space-y-2.5">
        {bullets.map((b, i) => {
          const meta = TYPE_META[b.type] || TYPE_META.plain;
          const iconName = b.type !== 'plain' ? pickContextIcon(b.text, b.type) : null;
          return (
            <div key={i} className="flex items-start gap-2.5">
              {iconName && IconComponent && (
                <div className="flex flex-col items-center pt-0.5 flex-shrink-0" style={{width:'36px'}}>
                  <div className="w-7 h-7 rounded-full flex items-center justify-center" style={{background:'var(--cream)', border:'1px solid ' + meta.color, color: meta.color}}>
                    <IconComponent name={iconName} size={12} />
                  </div>
                  <span className="text-[7px] tracking-[0.18em] uppercase mt-1" style={{color: meta.color}}>{meta.label}</span>
                </div>
              )}
              <div className="flex-1 min-w-0 font-serif italic text-[13px] leading-relaxed pt-0.5" style={{color:'var(--ink)'}}>
                {renderInline(b.text)}
                {b.evidence && b.type === 'action' && (
                  <EvidenceDot evidence={b.evidence} IconComponent={IconComponent} />
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
};

// Walk an AI response string, find lesson trigger words (case-insensitive,
// whole-word, longest-match-wins), wrap each lesson's FIRST hit only,
// return mixed array of strings + JSX safe to render directly.
const withPearls = (text, onOpen) => {
  if (!text || typeof text !== 'string' || !onOpen) return text;

  const wrapped = new Set(); // lesson ids already wrapped (one underline per lesson per block)
  const out = [];
  const lower = text.toLowerCase();
  const isWordChar = (c) => !!c && /[a-z0-9]/i.test(c);

  let cursor = 0;
  let key = 0;
  while (cursor < text.length) {
    let best = null;
    for (const item of PEARL_INDEX) {
      if (wrapped.has(item.lesson.id)) continue;
      let pos = cursor;
      while (pos < lower.length) {
        const idx = lower.indexOf(item.trigger, pos);
        if (idx < 0) break;
        const before = idx === 0 ? '' : text[idx - 1];
        const after = text[idx + item.trigger.length] || '';
        if (!isWordChar(before) && !isWordChar(after)) {
          if (!best || idx < best.idx) {
            best = { idx, lesson: item.lesson, length: item.trigger.length };
          }
          break;
        }
        pos = idx + 1;
      }
    }
    if (!best) {
      out.push(text.slice(cursor));
      break;
    }
    if (best.idx > cursor) out.push(text.slice(cursor, best.idx));
    out.push(
      <PearlTrigger key={key++} lesson={best.lesson} onOpen={onOpen}>
        {text.slice(best.idx, best.idx + best.length)}
      </PearlTrigger>
    );
    wrapped.add(best.lesson.id);
    cursor = best.idx + best.length;
  }
  return out;
};

