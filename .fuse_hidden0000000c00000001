                      // Barrier — panthenol
                      gate: () => !hasActive(/panthenol|provitamin\s*b5/),
                      ingredient: 'Panthenol',
                      body: "Have you heard of panthenol? Pro-vitamin B5 — boring on the label, quietly excellent.",
