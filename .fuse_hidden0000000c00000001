                        ) : priorSnap ? (
                          <p className="text-[11px] leading-snug" style={{color:'var(--ink-soft)', fontWeight:400}}>
                            Steady. Nothing shifted from last reading.
                          </p>
                        ) : (
                          <p className="text-[11px] leading-snug" style={{color:'var(--ink-soft)', fontWeight:400}}>
                            First reading. Log again tomorrow and we'll surface what shifted.
                          </p>
