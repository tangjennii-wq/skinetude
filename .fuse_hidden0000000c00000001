                      if (!d.log) return;
                      const slotProds = [...(d.amProducts || []), ...(d.pmProducts || [])];
                      const seen = new Set();
                      slotProds.forEach(p => {
                        const hay = `${p.activeIngredients || p.actives || ''} ${p.name || ''}`;
                        ACTIVE_KEYS.forEach(k => {
                          if (k.test.test(hay) && !seen.has(`${d.iso}-${k.label}`)) {
                            // count one use per day per active (so 2 vit-C products on Mon = 1 use, not 2)
                            seen.add(`${d.iso}-${k.label}`);
                            activeCounts[k.label] = (activeCounts[k.label] || 0) + 1;
                          }
                        });
                      });
                    });
