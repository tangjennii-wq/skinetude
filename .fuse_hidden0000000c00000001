            <div className="text-[9px] uppercase tracking-[0.22em]" style={{color:'var(--ink-soft)'}}>Time of day</div>
            <div className="grid grid-cols-2 gap-1.5">
              {[
                { key: 'am', label: 'AM', icon: 'Sun' },
                { key: 'pm', label: 'PM', icon: 'Moon' },
