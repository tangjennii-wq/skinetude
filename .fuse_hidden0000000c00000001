                  })} className="w-8 h-8 text-[11px] font-medium rounded-full transition flex items-center justify-center cursor-pointer" style={{
                    borderWidth: '1px', borderStyle: 'solid',
                    borderColor: active ? 'var(--accent)' : 'var(--line)',
