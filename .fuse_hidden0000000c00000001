                                    <path d="M12 21 L12 9" stroke="#9ca888" strokeWidth="1.4" strokeLinecap="round"/>
                                    <path d="M12 13 C8 11, 7 8, 9 6 C12 7, 13 9, 12 13 Z" fill="#9ca888" fillOpacity="0.6"/>
                                  </svg>
                                </div>
