              {(() => {
                const sugActive = cadenceMatchesSuggested(form.useDays, form.useTimes, form.category, form.activeIngredients);
                const allDaysSelected = ((form.useDays || []).length === 7) && (form.useTimes || []).length === 2;
                return (
                  <>
                    <button
