                            <div className="text-[9px] tracking-[0.22em] uppercase pt-2 pb-1 text-center font-medium" style={{color: d.isToday ? 'var(--accent)' : 'var(--ink-soft)'}}>
                              {d.isToday ? 'TODAY' : d.name}
