      .from(PHOTO_BUCKET)
      .list(userId, { limit: 1000 });
    if (error) { console.error('Storage stats error:', error); return { bytes: 0, count: 0 }; }
    const bytes = (data || []).reduce((s, f) => s + (f.metadata?.size || 0), 0);
    return { bytes, count: (data || []).length };
  } catch (e) {
    console.error('getUserStorageStats failed:', e);
    return { bytes: 0, count: 0 };
