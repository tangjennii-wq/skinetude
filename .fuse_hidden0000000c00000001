          const next = prev.map(p => {
            if (p.id !== t.id) return p;
            const { photo, ...rest } = p;
            return { ...rest, photoPath: path };
          });
          saveData('products', next);
          return next;
        });
      } else if (t.kind === 'color') {
        setColorProfile(prev => {
          if (!prev) return prev;
          const { photo, ...rest } = prev;
          const next = { ...rest, photoPath: path };
          saveData('color', next);
          return next;
        });
      }
