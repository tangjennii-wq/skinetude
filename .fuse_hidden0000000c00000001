                        return {
                          iso,
                          name: ['M','T','W','T','F','S','S'][i],
                          fullName: ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'][i],
                          dateNum: d.getDate(),
                          isToday: d.getTime() === tdy.getTime(),
