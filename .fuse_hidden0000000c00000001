      // Reset the input so picking the same file again will retrigger.
      if (fileRef.current) fileRef.current.value = '';
    };

    const updateItem = (idx, patch) => {
      setItems(prev => prev.map((it, i) => i === idx ? { ...it, ...patch } : it));
