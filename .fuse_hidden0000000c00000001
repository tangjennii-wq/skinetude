              name: p.name || '',
              brand: p.brand || '',
              category: p.category || 'serum',
              startDate: '',
              endDate: '',
              activeIngredients: p.actives || '',
              mainIngredients: p.main || '',
              tags: p.tags || [],
              concerns: p.concerns || [],
              useDays: [0,1,2,3,4,5,6],
              useTimes: [],
              frequency: 'daily',
              notes: '',
              photo: null,
              photoPath: null,
              status: 'active',
