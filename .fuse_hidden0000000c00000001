              {isEditing && (
                <div>
                  <div className="text-[10px] uppercase tracking-[0.25em] mb-1" style={{color:'var(--ink-soft)'}}>Stopped</div>
                  <input type="date" value={form.endDate || ''} onChange={e => setForm({...form, endDate: e.target.value})} className={inputCls + ' !text-xs'} />
