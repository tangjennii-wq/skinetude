// Resilient Supabase initialization.
// The supabase-js CDN script may not be ready when this script first runs (slow network,
// blocking extensions, intermittent CDN). We poll for window.supabase up to ~5s, mark the
// status reactively, and let any UI subscribed via onSupabaseStateChange react to changes.
//
// State machine: 'pending' → 'connected' or 'failed' or 'disabled' (no creds configured).
let supabaseClient = null;
let supabaseInitState = 'pending';
let supabaseInitListeners = [];

const _notifySupabaseListeners = () => {
  const snapshot = { state: supabaseInitState, client: supabaseClient };
  supabaseInitListeners.forEach(fn => { try { fn(snapshot); } catch (_) {} });
};

const onSupabaseStateChange = (fn) => {
  supabaseInitListeners.push(fn);
  // Fire immediately with current state so subscribers don't miss the initial value
  try { fn({ state: supabaseInitState, client: supabaseClient }); } catch (_) {}
  return () => { supabaseInitListeners = supabaseInitListeners.filter(f => f !== fn); };
};

const _attemptSupabaseInit = () => {
  if (supabaseClient) return true;
  const { url, anonKey } = getSupabaseConfig();
  if (!url || !anonKey) {
    if (supabaseInitState !== 'disabled') {
      supabaseInitState = 'disabled';
      _notifySupabaseListeners();
    }
    return false;
  }
  if (!window.supabase || !window.supabase.createClient) return false; // library not yet loaded
  try {
    supabaseClient = window.supabase.createClient(url, anonKey, {
      auth: { persistSession: true, autoRefreshToken: true }
    });
    supabaseInitState = 'connected';
    _notifySupabaseListeners();
    return true;
  } catch (e) {
    console.error('Supabase init failed:', e);
    supabaseInitState = 'failed';
    _notifySupabaseListeners();
    return false;
  }
};

// Try once now; if it doesn't take, poll for the library to load.
if (!_attemptSupabaseInit() && supabaseInitState === 'pending') {
  let attempts = 0;
  const POLL_MS = 100;
  const MAX_ATTEMPTS = 50; // 5 seconds total
  const pollId = setInterval(() => {
    attempts++;
    if (_attemptSupabaseInit()) {
      clearInterval(pollId);
    } else if (attempts >= MAX_ATTEMPTS) {
      clearInterval(pollId);
      if (supabaseInitState === 'pending') {
        supabaseInitState = 'failed';
        _notifySupabaseListeners();
      }
    }
  }, POLL_MS);
}

// Manual retry — used by the "Retry connection" button if init fails.
const retrySupabaseInit = () => {
  if (supabaseClient) return true;
