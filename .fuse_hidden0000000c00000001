  // products or regimen change, so newly-added products get their art generated.
  // Content-based signature (not just .length) — adding a product to an existing
  // regimen mutates contents without changing length, and we still need to re-paint.
  const lastArtSyncRef = useRef('');
  // Build a stable string signature of (today/yesterday's check-in product ids +
  // brand+name strings of all products) so any meaningful change re-triggers art gen.
  const productArtSig = (() => {
    const todayK = localDateISO();
