                      the ◀ ▶ arrows in the header. The "This week's focus"
                      footer + a NEW actives chip row both reflect the
                      currently SELECTED week (not always the live week). */}
                  {(() => {
                    // Infer "this week's focus" from logged regimens for the
                    // selected week. Aggregates most-mentioned theme; falls back
                    // to a generic phrase when nothing is logged yet.
                    const themeCounts = {};
                    weekDays.forEach(d => {
                      if (d.log) themeCounts[d.theme] = (themeCounts[d.theme] || 0) + 1;
                    });
                    const sortedThemes = Object.entries(themeCounts).sort((a, b) => b[1] - a[1]);
